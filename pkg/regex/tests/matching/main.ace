import fmt
import mem
import regex
import str

/* Writes spans as `start-end` separated by spaces, `-` for an unset group. */
render(spans: []regex.Span, out: mut []char): usize {
    at: usize = 0

    for i: usize, span: regex.Span in spans {
        if i > 0 {
            out[at] = ' '
            at += 1
        }

        if span.start == regex.UNSET {
            out[at] = '-'
            at += 1
            continue
        }
        n: usize, ok: bool = str.format(mut out[at..out.len], span.start)
        at += n
        out[at] = '-'
        at += 1
        n, ok = str.format(mut out[at..out.len], span.end)
        at += n
    }
    return at
}

compile(pattern: string): regex.Regex {
    re: regex.Regex, err: Error = regex.Regex.compile(pattern)
    if err != null {
        fmt.print(pattern)
        fmt.print(": ")
        fmt.println(err.message)
    }

    return re
}

report(pattern: string, text: string, got: string, want: string) {
    fmt.print(pattern)
    fmt.print(" on \"")
    fmt.print(text)
    fmt.print("\": got ")
    fmt.print(got)
    fmt.print(", want ")
    fmt.println(want)
}

/* The match starting at `from` or later, as rendered spans; `none` for no
 * match.
 */
found(pattern: string, text: string, from: usize, want: string): int {
    re: regex.Regex = compile(pattern)
    defer mut re.wipe()
    buffer: [64]u8
    got: string = "none"

    if mut re.find(text, from) {
        spans: [1]regex.Span = [re.span(0)]
        got = string(buffer[0..render(spans[0..1], mut buffer[0..64])])
    }

    if !mem.equal(got, want) {
        report(pattern, text, got, want)
        return 1
    }
    return 0
}

/* The first match's groups 0 to 3, rendered; groups past the last are unset. */
groups(pattern: string, text: string, want: string): int {
    re: regex.Regex = compile(pattern)
    defer mut re.wipe()
    buffer: [128]u8
    got: string = "none"

    if mut re.find(text, 0) {
        spans: [4]regex.Span = [re.span(0), re.span(1), re.span(2), re.span(3)]
        got = string(buffer[0..render(spans[0..4], mut buffer[0..128])])
    }

    if !mem.equal(got, want) {
        report(pattern, text, got, want)
        return 1
    }
    return 0
}

/* Every match `next` visits, which steps past empty matches. */
every(pattern: string, text: string, want: string): int {
    re: regex.Regex = compile(pattern)
    defer mut re.wipe()
    storage: [16]regex.Span
    spans: mut []regex.Span = mut storage[0..16]
    count: usize = 0
    at: usize = 0

    for count < 16 && mut re.next(text, mut at) {
        spans[count] = re.span(0)
        count += 1
    }
    buffer: [256]u8
    got: string = string(buffer[0..render(spans[0..count], mut buffer[0..256])])

    if !mem.equal(got, want) {
        report(pattern, text, got, want)
        return 1
    }
    return 0
}

basics(): int {
    bad: int = 0
    bad += found("abc", "xxabcxx", 0, "2-5")
    bad += found("abc", "abd", 0, "none")
    bad += found("a", "", 0, "none")
    bad += found("x*", "", 0, "0-0")
    bad += found("a*", "baaa", 0, "0-0")
    bad += found("a+", "baaab", 0, "1-4")
    bad += found("a+?", "baaab", 0, "1-2")
    bad += found("a{2,4}", "aaaaa", 0, "0-4")
    bad += found("a{2,4}?", "aaaaa", 0, "0-2")
    bad += found("[0-9]+", "ab123c", 0, "2-5")
    bad += found(".", "\n\nz", 0, "2-3")
    bad += found("\\d+-\\d+", "tel 12-345", 0, "4-10")
    bad += found("[^a-c]+", "abxyc", 0, "2-4")
    return bad
}

/* Leftmost wins first; among matches at one start, the preferred branch. */
priority(): int {
    bad: int = 0
    bad += found("a|ab", "ab", 0, "0-1")
    bad += found("ab|a", "ab", 0, "0-2")
    bad += found("b|ab", "xab", 0, "1-3")
    bad += found("(a|ab)(c|bcd)", "abcd", 0, "0-4")
    bad += found("a*?b", "aab", 0, "0-3")
    return bad
}

/* Assertions see the whole text, not the text from `from` on. */
anchors(): int {
    bad: int = 0
    bad += found("^a", "ab", 0, "0-1")
    bad += found("^a", "ba", 0, "none")
    bad += found("^b", "ab", 1, "none")
    bad += found("a$", "aba", 0, "2-3")
    bad += found("a$", "ab", 0, "none")
    bad += found("$", "abc", 0, "3-3")
    bad += found("\\bfoo\\b", "a foo b", 0, "2-5")
    bad += found("\\bfoo\\b", "afoo", 0, "none")
    bad += found("\\Boo", "foo", 0, "1-3")
    bad += found("\\bb", "ab", 1, "none")
    bad += found("a", "aXa", 1, "2-3")
    bad += found("a", "aXa", 3, "none")
    bad += found("a", "aXa", 4, "none")
    bad += found("cat|dog", "xxdog", 0, "2-5")
    bad += found("ab", "aaab", 0, "2-4")
    bad += found("ab", "abxab", 1, "3-5")
    return bad
}

captures(): int {
    bad: int = 0
    bad += groups("(a)|(b)", "b", "0-1 - 0-1 -")
    bad += groups("(a|b)*", "ab", "0-2 1-2 - -")
    bad += groups("(\\d+)-(\\d+)", "x 12-345", "2-8 2-4 5-8 -")
    bad += groups("(a)(b)?", "a", "0-1 0-1 - -")
    bad += groups("(a+?)(a*)", "aaa", "0-3 0-1 1-3 -")
    bad += groups("((a)b)+", "abab", "0-4 2-4 2-3 -")
    bad += groups("(?:x(y))+", "xyxy", "0-4 3-4 - -")
    bad += groups("(a)(b)(c)(d)", "abcd", "0-4 0-1 1-2 2-3")
    bad += groups("(a)", "b", "none")
    bad += groups("(a*)*", "b", "0-0 - - -")
    return bad
}

iteration(): int {
    bad: int = 0
    bad += every("a*", "baaa", "0-0 1-4 4-4")
    bad += every("\\d+", "a1b22c333", "1-2 3-5 6-9")
    bad += every("x", "abc", "")
    bad += every("", "ab", "0-0 1-1 2-2")
    return bad
}

/* Patterns that take exponential time under backtracking finish here. */
linear(): int {
    bad: int = 0
    storage: [100000]u8
    text: mut []u8 = mut storage[0..100000]

    for i: usize in 0 .. 100000 { text[i] = 'a' }
    bad += found("(a*)*b", string(text[0..100000]), 0, "none")
    bad += found("(a|aa)*c", string(text[0..100000]), 0, "none")
    bad += found("(a*)*", "b", 0, "0-0")
    return bad
}

surface(): int {
    bad: int = 0
    re: regex.Regex = compile("(a)(?:b)(c)")
    defer mut re.wipe()
    if re.groups() != 2 {
        fmt.println("(a)(?:b)(c) should have 2 groups")
        bad += 1
    }

    if !mut re.match("xxabcx") || mut re.match("xxabx") {
        fmt.println("match disagrees with (a)(?:b)(c)")
        bad += 1
    }

    if mut re.find("xxabcx", 0) && (!mem.equal(re.group(0), "abc") || !mem.equal(re.group(2), "c")) {
        fmt.println("group should read abc and c from xxabcx")
        bad += 1
    }

    if re.group(3) != null || re.span(3).start != regex.UNSET {
        fmt.println("a group past the last should be unset")
        bad += 1
    }

    if mut re.match("xxabcx") && re.group(0) != null {
        fmt.println("match should record no match for group")
        bad += 1
    }

    if mut re.find("xxabx", 0) || re.group(0) != null {
        fmt.println("a failed find should leave no match for group")
        bad += 1
    }
    q: regex.Regex, err: Error = regex.Regex.compile("a(")
    mut q.wipe()

    if err != regex.ParseErr.missing_paren {
        fmt.println("a( should fail with missing_paren")
        bad += 1
    }
    q, err = regex.Regex.compile("((a{1000}){1000}){1000}")
    mut q.wipe()

    if err != regex.CompileErr.too_large {
        fmt.println("nested counts should fail with too_large")
        bad += 1
    }
    return bad
}

/* `count` agrees with `next`, empty matches included, and `group` of an
 * unset group is null while an empty group is an empty non-null view.
 */
counting(): int {
    bad: int = 0
    re: regex.Regex = compile("(x)?(y*)")
    defer mut re.wipe()

    if mut re.count("zxyz") != 4 {
        fmt.println("(x)?(y*) should match 4 times in zxyz")
        bad += 1
    }

    if !mut re.find("z", 0) || re.group(1) != null || re.group(2) == null || re.group(2).len != 0 {
        fmt.println("(x)?(y*) on z should leave group 1 null and group 2 empty")
        bad += 1
    }
    digits: regex.Regex = compile("\\d+")
    defer mut digits.wipe()

    if mut digits.count("a1b22c333") != 3 || mut digits.count("") != 0 {
        fmt.println("\\d+ counts should be 3 and 0")
        bad += 1
    }
    return bad
}

main(): int {
    bad: int = basics() + priority() + anchors() + captures() + iteration() + linear() + surface() + counting()
    if bad != 0 { return 1 }

    return 0
}
