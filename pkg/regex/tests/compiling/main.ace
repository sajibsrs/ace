import fmt
import mem
import regex

/* Parses and compiles `pattern`, returning the program or printing why not. */
compile(pattern: string): (regex.Program, Error) {
    s: regex.Syntax, err: Error, at: usize = regex.Syntax::parse(pattern)
    defer mut s.wipe()
    if err != null {
        return blank(regex.Program), err
    }

    p: regex.Program, cerr: Error = regex.Program::compile(s)
    return p, cerr
}

/* Compares the program's dump with `want`, printing both on a mismatch. */
program(pattern: string, want: string): int {
    p: regex.Program, err: Error = compile(pattern)
    defer mut p.wipe()
    if err != null {
        fmt.print(pattern)
        fmt.print(": ")
        fmt.println(err.message)
        return 1
    }

    buffer: [1024]u8
    n: usize, ok: bool = p.format(mut buffer[0..1024])
    if !ok || !mem.equal(buffer[0..n], want) {
        fmt.print(pattern)
        fmt.println(": got")
        fmt.print(string(buffer[0..n]))
        fmt.println("want")
        fmt.print(want)
        return 1
    }

    return 0
}

fails(pattern: string, want: Error): int {
    p: regex.Program, err: Error = compile(pattern)
    defer mut p.wipe()
    if err != want {
        fmt.print(pattern)
        fmt.print(": got ")
        fmt.print(err.name)
        fmt.print(", want ")
        fmt.println(want.name)
        return 1
    }

    return 0
}

basics(): int {
    bad: int = 0
    bad += program("", "0 save 0\n1 save 1\n2 match\n")
    bad += program("a", "0 save 0\n1 byte a\n2 save 1\n3 match\n")
    bad += program("^\\b.[x]\\B$", "0 save 0\n1 bol\n2 wb\n3 any\n4 class 0\n5 nwb\n6 eol\n7 save 1\n8 match\n")
    bad += program(
        "a|b|c",
        "0 save 0\n1 split 2 4\n2 byte a\n3 jmp 8\n4 split 5 7\n5 byte b\n6 jmp 8\n7 byte c\n8 save 1\n9 match\n",
    )
    bad += program(
        "(?:ab)|(c)",
        "0 save 0\n1 split 2 5\n2 byte a\n3 byte b\n4 jmp 8\n5 save 2\n6 byte c\n7 save 3\n8 save 1\n9 match\n",
    )
    return bad
}

repetition(): int {
    bad: int = 0
    bad += program("(a)*", "0 save 0\n1 split 2 6\n2 save 2\n3 byte a\n4 save 3\n5 jmp 1\n6 save 1\n7 match\n")
    bad += program("a*?", "0 save 0\n1 split 4 2\n2 byte a\n3 jmp 1\n4 save 1\n5 match\n")
    bad += program("a+", "0 save 0\n1 byte a\n2 split 1 3\n3 save 1\n4 match\n")
    bad += program("a+?", "0 save 0\n1 byte a\n2 split 3 1\n3 save 1\n4 match\n")
    bad += program("a?", "0 save 0\n1 split 2 3\n2 byte a\n3 save 1\n4 match\n")
    bad += program("a??", "0 save 0\n1 split 3 2\n2 byte a\n3 save 1\n4 match\n")
    bad += program(
        "a{2,4}",
        "0 save 0\n1 byte a\n2 byte a\n3 split 4 7\n4 byte a\n5 split 6 7\n6 byte a\n7 save 1\n8 match\n",
    )
    bad += program("a{2,}", "0 save 0\n1 byte a\n2 byte a\n3 split 2 4\n4 save 1\n5 match\n")
    bad += program("a{0}", "0 save 0\n1 save 1\n2 match\n")
    bad += program("(?:(?:(?:){1000}){1000}){1000}", "0 save 0\n1 save 1\n2 match\n")
    return bad
}

limits(): int {
    bad: int = 0
    bad += fails("(?:a{1000}){66}", regex.CompileErr.too_large)
    bad += fails("((a{1000}){1000}){1000}", regex.CompileErr.too_large)
    p: regex.Program, err: Error = compile("(?:a{1000}){65}")
    defer mut p.wipe()
    if err != null || p.insts.len != 65003 {
        fmt.println("(?:a{1000}){65} should compile to 65003 instructions")
        bad += 1
    }

    q: regex.Program, qerr: Error = compile("(a)(b(c))")
    defer mut q.wipe()
    if qerr != null || q.slots != 8 {
        fmt.println("(a)(b(c)) should have 8 capture slots")
        bad += 1
    }

    return bad
}

main(): int {
    bad: int = basics() + repetition() + limits()
    if bad != 0 {
        return 1
    }

    return 0
}
