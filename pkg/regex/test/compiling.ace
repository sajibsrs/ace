import test
import regex: "../mod.ace"

/* Parses and compiles `pattern`. */
compile(pattern: string): (regex.Program, Error) {
    s: regex.Syntax, err: Error = regex.Syntax.parse(pattern)
    defer s.wipe()
    if err != null { return blank(regex.Program), err }

    p: regex.Program, cerr: Error = regex.Program.compile(s)
    return p, cerr
}

/* Compares the program's dump with `want`. */
program(t: *test.T, pattern: string, want: string, file: string, line: int) {
    p: regex.Program, err: Error = compile(pattern)
    defer p.wipe()
    if err != null {
        t.fail(err.message, file, line)
        return
    }
    buffer: [1024]u8
    n: usize, ok: bool = p.format(buffer[0..1024])
    t.equal(ok, true, file, line)
    t.equal(string(buffer[0..n]), want, file, line)
}

fails(t: *test.T, pattern: string, want: Error, file: string, line: int) {
    p: regex.Program, err: Error = compile(pattern)
    defer p.wipe()
    if err != want {
        t.equal(err.message, want.message, file, line)
        t.fail("wrong error", file, line)
    }
}

pub basics(t: *test.T) {
    program(t, "", "0 save 0\n1 save 1\n2 match\n", @file, @line)
    program(t, "a", "0 save 0\n1 byte a\n2 save 1\n3 match\n", @file, @line)
    program(t, "^\\b.[x]\\B$", "0 save 0\n1 bol\n2 wb\n3 any\n4 class 0\n5 nwb\n6 eol\n7 save 1\n8 match\n", @file, @line)
    program(
        t,
        "a|b|c",
        "0 save 0\n1 split 2 4\n2 byte a\n3 jmp 8\n4 split 5 7\n5 byte b\n6 jmp 8\n7 byte c\n8 save 1\n9 match\n",
        @file,
        @line,
    )
    program(
        t,
        "(?:ab)|(c)",
        "0 save 0\n1 split 2 5\n2 byte a\n3 byte b\n4 jmp 8\n5 save 2\n6 byte c\n7 save 3\n8 save 1\n9 match\n",
        @file,
        @line,
    )
}

pub repetition(t: *test.T) {
    program(t, "(a)*", "0 save 0\n1 split 2 6\n2 save 2\n3 byte a\n4 save 3\n5 jmp 1\n6 save 1\n7 match\n", @file, @line)
    program(t, "a*?", "0 save 0\n1 split 4 2\n2 byte a\n3 jmp 1\n4 save 1\n5 match\n", @file, @line)
    program(t, "a+", "0 save 0\n1 byte a\n2 split 1 3\n3 save 1\n4 match\n", @file, @line)
    program(t, "a+?", "0 save 0\n1 byte a\n2 split 3 1\n3 save 1\n4 match\n", @file, @line)
    program(t, "a?", "0 save 0\n1 split 2 3\n2 byte a\n3 save 1\n4 match\n", @file, @line)
    program(t, "a??", "0 save 0\n1 split 3 2\n2 byte a\n3 save 1\n4 match\n", @file, @line)
    program(
        t,
        "a{2,4}",
        "0 save 0\n1 byte a\n2 byte a\n3 split 4 7\n4 byte a\n5 split 6 7\n6 byte a\n7 save 1\n8 match\n",
        @file,
        @line,
    )
    program(t, "a{2,}", "0 save 0\n1 byte a\n2 byte a\n3 split 2 4\n4 save 1\n5 match\n", @file, @line)
    program(t, "a{0}", "0 save 0\n1 save 1\n2 match\n", @file, @line)
    program(t, "(?:(?:(?:){1000}){1000}){1000}", "0 save 0\n1 save 1\n2 match\n", @file, @line)
}

pub limits(t: *test.T) {
    fails(t, "(?:a{1000}){66}", regex.CompileErr.too_large, @file, @line)
    fails(t, "((a{1000}){1000}){1000}", regex.CompileErr.too_large, @file, @line)
    p: regex.Program, err: Error = compile("(?:a{1000}){65}")
    defer p.wipe()
    if t.equal(err == null, true, @file, @line) { t.equal(p.insts.len, 65003, @file, @line) }

    q: regex.Program, qerr: Error = compile("(a)(b(c))")
    defer q.wipe()
    if t.equal(qerr == null, true, @file, @line) { t.equal(usize(q.slots), 8, @file, @line) }
}
