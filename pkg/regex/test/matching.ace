import str
import test
import regex: "../mod.ace"

/* Writes spans as `start-end` separated by spaces, `-` for an unset group. */
render(spans: []regex.Span, out: []char): usize {
    at: usize = 0

    for i: usize, span: regex.Span in spans {
        if i > 0 {
            out[at] = ' '
            at += 1
        }

        if span.start == regex.UNSET {
            out[at] = '-'
            at += 1
            continue
        }
        n: usize, ok: bool = str.format(out[at..out.len], span.start)
        at += n
        out[at] = '-'
        at += 1
        n, ok = str.format(out[at..out.len], span.end)
        at += n
    }
    return at
}

/* Compiles `pattern`, failing the test when it does not compile. */
compile(t: *test.T, pattern: string, file: string, line: int): regex.Regex {
    re: regex.Regex, err: Error = regex.Regex.compile(pattern)
    if err != null { t.fail(err.message, file, line) }

    return re
}

/* The match starting at `from` or later, as rendered spans; `none` for no
 * match.
 */
found(t: *test.T, pattern: string, text: string, from: usize, want: string, file: string, line: int) {
    re: regex.Regex = compile(t, pattern, file, line)
    defer re.wipe()
    buffer: [64]u8
    got: string = "none"

    if re.find(text, from) {
        spans: [1]regex.Span = [re.span(0)]
        got = string(buffer[0..render(spans[0..1], buffer[0..64])])
    }
    t.equal(got, want, file, line)
}

/* The first match's groups 0 to 3, rendered; groups past the last are unset. */
groups(t: *test.T, pattern: string, text: string, want: string, file: string, line: int) {
    re: regex.Regex = compile(t, pattern, file, line)
    defer re.wipe()
    buffer: [128]u8
    got: string = "none"

    if re.find(text, 0) {
        spans: [4]regex.Span = [re.span(0), re.span(1), re.span(2), re.span(3)]
        got = string(buffer[0..render(spans[0..4], buffer[0..128])])
    }
    t.equal(got, want, file, line)
}

/* Every match `next` visits, which steps past empty matches. */
every(t: *test.T, pattern: string, text: string, want: string, file: string, line: int) {
    re: regex.Regex = compile(t, pattern, file, line)
    defer re.wipe()
    storage: [16]regex.Span
    spans: []regex.Span = storage[0..16]
    count: usize = 0
    at: usize = 0

    for count < 16 && re.next(text, &at) {
        spans[count] = re.span(0)
        count += 1
    }
    buffer: [256]u8
    t.equal(string(buffer[0..render(spans[0..count], buffer[0..256])]), want, file, line)
}

pub basics(t: *test.T) {
    found(t, "abc", "xxabcxx", 0, "2-5", @file, @line)
    found(t, "abc", "abd", 0, "none", @file, @line)
    found(t, "a", "", 0, "none", @file, @line)
    found(t, "x*", "", 0, "0-0", @file, @line)
    found(t, "a*", "baaa", 0, "0-0", @file, @line)
    found(t, "a+", "baaab", 0, "1-4", @file, @line)
    found(t, "a+?", "baaab", 0, "1-2", @file, @line)
    found(t, "a{2,4}", "aaaaa", 0, "0-4", @file, @line)
    found(t, "a{2,4}?", "aaaaa", 0, "0-2", @file, @line)
    found(t, "[0-9]+", "ab123c", 0, "2-5", @file, @line)
    found(t, ".", "\n\nz", 0, "2-3", @file, @line)
    found(t, "\\d+-\\d+", "tel 12-345", 0, "4-10", @file, @line)
    found(t, "[^a-c]+", "abxyc", 0, "2-4", @file, @line)
}

/* Leftmost wins first; among matches at one start, the preferred branch. */
pub priority(t: *test.T) {
    found(t, "a|ab", "ab", 0, "0-1", @file, @line)
    found(t, "ab|a", "ab", 0, "0-2", @file, @line)
    found(t, "b|ab", "xab", 0, "1-3", @file, @line)
    found(t, "(a|ab)(c|bcd)", "abcd", 0, "0-4", @file, @line)
    found(t, "a*?b", "aab", 0, "0-3", @file, @line)
}

/* Assertions see the whole text, not the text from `from` on. */
pub anchors(t: *test.T) {
    found(t, "^a", "ab", 0, "0-1", @file, @line)
    found(t, "^a", "ba", 0, "none", @file, @line)
    found(t, "^b", "ab", 1, "none", @file, @line)
    found(t, "a$", "aba", 0, "2-3", @file, @line)
    found(t, "a$", "ab", 0, "none", @file, @line)
    found(t, "$", "abc", 0, "3-3", @file, @line)
    found(t, "\\bfoo\\b", "a foo b", 0, "2-5", @file, @line)
    found(t, "\\bfoo\\b", "afoo", 0, "none", @file, @line)
    found(t, "\\Boo", "foo", 0, "1-3", @file, @line)
    found(t, "\\bb", "ab", 1, "none", @file, @line)
    found(t, "a", "aXa", 1, "2-3", @file, @line)
    found(t, "a", "aXa", 3, "none", @file, @line)
    found(t, "a", "aXa", 4, "none", @file, @line)
    found(t, "cat|dog", "xxdog", 0, "2-5", @file, @line)
    found(t, "ab", "aaab", 0, "2-4", @file, @line)
    found(t, "ab", "abxab", 1, "3-5", @file, @line)
}

pub captures(t: *test.T) {
    groups(t, "(a)|(b)", "b", "0-1 - 0-1 -", @file, @line)
    groups(t, "(a|b)*", "ab", "0-2 1-2 - -", @file, @line)
    groups(t, "(\\d+)-(\\d+)", "x 12-345", "2-8 2-4 5-8 -", @file, @line)
    groups(t, "(a)(b)?", "a", "0-1 0-1 - -", @file, @line)
    groups(t, "(a+?)(a*)", "aaa", "0-3 0-1 1-3 -", @file, @line)
    groups(t, "((a)b)+", "abab", "0-4 2-4 2-3 -", @file, @line)
    groups(t, "(?:x(y))+", "xyxy", "0-4 3-4 - -", @file, @line)
    groups(t, "(a)(b)(c)(d)", "abcd", "0-4 0-1 1-2 2-3", @file, @line)
    groups(t, "(a)", "b", "none", @file, @line)
    groups(t, "(a*)*", "b", "0-0 - - -", @file, @line)
}

pub iteration(t: *test.T) {
    every(t, "a*", "baaa", "0-0 1-4 4-4", @file, @line)
    every(t, "\\d+", "a1b22c333", "1-2 3-5 6-9", @file, @line)
    every(t, "x", "abc", "", @file, @line)
    every(t, "", "ab", "0-0 1-1 2-2", @file, @line)
}

/* Patterns that take exponential time under backtracking finish here. */
pub linear(t: *test.T) {
    storage: [100000]u8
    text: []u8 = storage[0..100000]

    for i: usize in 0 .. 100000 { text[i] = 'a' }
    found(t, "(a*)*b", string(text[0..100000]), 0, "none", @file, @line)
    found(t, "(a|aa)*c", string(text[0..100000]), 0, "none", @file, @line)
    found(t, "(a*)*", "b", 0, "0-0", @file, @line)
}

pub surface(t: *test.T) {
    re: regex.Regex = compile(t, "(a)(?:b)(c)", @file, @line)
    defer re.wipe()
    t.equal(usize(re.groups()), 2, @file, @line)
    t.equal(re.match("xxabcx"), true, @file, @line)
    t.equal(re.match("xxabx"), false, @file, @line)

    if t.equal(re.find("xxabcx", 0), true, @file, @line) {
        t.equal(re.group(0), "abc", @file, @line)
        t.equal(re.group(2), "c", @file, @line)
    }
    /* A group past the last is unset. */
    t.equal(re.group(3) == null, true, @file, @line)
    t.equal(re.span(3).start == regex.UNSET, true, @file, @line)

    /* `match` records no match for `group`, nor does a failed `find`. */
    re.match("xxabcx")
    t.equal(re.group(0) == null, true, @file, @line)
    t.equal(re.find("xxabx", 0), false, @file, @line)
    t.equal(re.group(0) == null, true, @file, @line)

    q: regex.Regex, err: Error = regex.Regex.compile("a(")
    q.wipe()
    t.equal(err == regex.ParseErr.missing_paren, true, @file, @line)

    q, err = regex.Regex.compile("((a{1000}){1000}){1000}")
    q.wipe()
    t.equal(err == regex.CompileErr.too_large, true, @file, @line)
}

/* `count` agrees with `next`, empty matches included, and `group` of an
 * unset group is null while an empty group is an empty non-null view.
 */
pub counting(t: *test.T) {
    re: regex.Regex = compile(t, "(x)?(y*)", @file, @line)
    defer re.wipe()
    t.equal(re.count("zxyz"), 4, @file, @line)

    if t.equal(re.find("z", 0), true, @file, @line) {
        t.equal(re.group(1) == null, true, @file, @line)
        t.equal(re.group(2) != null, true, @file, @line)
        t.equal(re.group(2).len, 0, @file, @line)
    }
    digits: regex.Regex = compile(t, "\\d+", @file, @line)
    defer digits.wipe()
    t.equal(digits.count("a1b22c333"), 3, @file, @line)
    t.equal(digits.count(""), 0, @file, @line)
}
