/* Regular-expression syntax: a recursive-descent parser from pattern text to
 * a flat syntax tree. Matching is byte-oriented: a pattern is a byte string
 * and every node matches bytes, never decoded code points.
 *
 * Nodes live in one array and name their children by index, so a tree is a
 * few allocations however large it is, and one `wipe` frees it.
 * Concatenation and alternation are n-ary, their children a contiguous run of
 * `children`, which keeps tree depth bounded by group nesting rather than by
 * pattern length.
 */

import array
import ascii
import fmt
import str
import output: "./output.ace"

pub ParseErr: error {
    1: missing_paren = "missing closing parenthesis",
    2: unexpected_paren = "unexpected closing parenthesis",
    3: missing_operand = "repetition operator has no operand",
    4: invalid_repeat = "invalid repetition count",
    5: invalid_range = "invalid character class range",
    6: unterminated_class = "unterminated character class",
    7: invalid_escape = "invalid escape sequence",
    8: depth = "nesting depth exceeded",
    9: allocation = "allocation failed",
}

/* Recursion guard: the most groups that may nest, bounding stack depth on
 * adversarial input rather than risking overflow.
 */
MAX_DEPTH: usize = 512

/* The largest count `{m,n}` admits. Compilation expands a counted repetition
 * by copying its operand, so the bound caps program size.
 */
MAX_REPEAT: uint = 1000

/* A repetition's `max` when it has no upper bound. */
pub UNBOUNDED: const u32 = 0xFFFFFFFF

/* A set of bytes: bit `b % 64` of word `b / 64` is set when byte `b` is a
 * member.
 */
pub Class: struct {
    pub bits: [4]u64,
}

/* A parenthesized group. `index` is its capture number, counted from 1 in
 * order of the opening parentheses; 0 marks a non-capturing `(?:...)`.
 */
pub Group: struct {
    pub index: u32,
    pub child: u32,
}

/* `child` repeated `min` through `max` times, `max` being `UNBOUNDED` for no
 * upper bound. A greedy repetition prefers more iterations, a lazy one fewer.
 */
pub Repeat: struct {
    pub child: u32,
    pub min: u32,
    pub max: u32,
    pub greedy: bool,
}

/* `count` consecutive entries of `Syntax.children`, starting at `first`. */
pub List: struct {
    pub first: u32,
    pub count: u32,
}

pub Node: union {
    empty,
    any,
    bol,
    eol,
    word,
    not_word,
    byte: u8,
    class: u32,
    group: Group,
    repeat: Repeat,
    concat: List,
    alt: List,
}

/* A parsed pattern. `root` indexes `nodes`, a `class` node indexes `classes`,
 * and `groups` is the number of capturing groups. The canonical zero value
 * holds no storage.
 */
pub Syntax: struct {
    pub nodes: array.Array[Node],
    pub children: array.Array[u32],
    pub classes: array.Array[Class],
    pub root: u32,
    pub groups: u32,
}

/* One parse in progress. `stack` holds finished children until the
 * concatenation or alternation that owns them closes.
 */
Parser: struct {
    nodes: array.Array[Node],
    children: array.Array[u32],
    classes: array.Array[Class],
    stack: array.Array[u32],
    text: string = "",
    at: usize,
    groups: u32,
}

/* Canonical text for one tree. */
Writer: struct {
    syntax: Syntax,
    out: output.Output,
}

/* Adds every byte from `lo` through `hi`, inclusive, one mask per word the
 * range touches: `span + 1` ones shifted to the range's first bit. The mask
 * is built by shifting all-ones right, since a 64-bit run would need the
 * out-of-range shift `1 << 64`.
 */
Class.add_range(self, lo: u8, hi: u8) {
    for word: usize in usize(lo >> 6) .. usize(hi >> 6) + 1 {
        first: usize = 0
        last: usize = 63

        if word == usize(lo >> 6) { first = usize(lo & 63) }

        if word == usize(hi >> 6) { last = usize(hi & 63) }
        self.bits[word] |= (~u64(0) >> u64(63 - (last - first))) << u64(first)
    }
}

/* Adds every member of `other`. */
Class.add(self, other: Class) {
    for i: usize in 0 .. 4 { self.bits[i] |= other.bits[i] }
}

/* Replaces the set with every byte it did not hold. */
Class.negate(self) {
    for i: usize in 0 .. 4 { self.bits[i] = ~self.bits[i] }
}

pub inline Class.has(self, byte: u8): bool {
    return ((self.bits[usize(byte >> 6)] >> u64(byte & 63)) & 1) != 0
}

/* The class a Perl escape letter names: `d` digits, `w` word bytes
 * `[0-9A-Za-z_]`, `s` whitespace `[\t\n\f\r ]`, and each uppercase letter the
 * complement of its lowercase one. Any other letter returns false.
 */
perl_class(letter: u8): (Class, bool) {
    set: Class = blank(Class)

    switch ascii.lower(letter) {
        'd' {
            set.add_range('0', '9')
        }
        'w' {
            set.add_range('0', '9')
            set.add_range('A', 'Z')
            set.add_range('a', 'z')
            set.add_range('_', '_')
        }
        's' {
            set.add_range('\t', '\n')
            set.add_range('\x0C', '\r')
            set.add_range(' ', ' ')
        }
        default {
            return set, false
        }
    }

    if 'A' <= letter <= 'Z' { set.negate() }
    return set, true
}

is_quantifier(c: u8): bool {
    return c == '*' || c == '+' || c == '?' || c == '{'
}

/* Parses the complete pattern. The tree owns its storage; release it with
 * `wipe`. A failed parse holds no storage.
 */
pub Syntax.parse(pattern: string): (Syntax, Error) {
    diag: fmt.Buffer = fmt.Buffer.init(null)
    syntax: Syntax, err: Error = Syntax.parse(pattern, &diag)
    return syntax, err
}

/* `parse`, appending the failure's context to `diag` innermost-first: the
 * error at line:column, then each enclosing class or group by its opening
 * delimiter. An unclosed group or class is reported at its opening delimiter,
 * an invalid repetition count at its `{`, and an invalid escape at its
 * backslash.
 */
pub Syntax.parse(pattern: string, diag: *fmt.Buffer): (Syntax, Error) {
    p: Parser = Parser {
        nodes = array.Array[Node] {},
        children = array.Array[u32] {},
        classes = array.Array[Class] {},
        stack = array.Array[u32] {},
        text = pattern,
        at = 0,
        groups = 0,
    }
    defer p.stack.wipe()
    root: u32, err: Error = p.parse_alt(0, diag)
    if err == null && p.at < p.text.len { err = p.fail(diag, ParseErr.unexpected_paren) }
    if err != null {
        p.nodes.wipe()
        p.children.wipe()
        p.classes.wipe()
        return blank(Syntax), err
    }

    syntax: Syntax = Syntax {
        nodes = p.nodes,
        children = p.children,
        classes = p.classes,
        root = root,
        groups = p.groups,
    }
    return syntax, null
}

/* Releases the tree and leaves it empty. */
pub Syntax.wipe(self) {
    self.nodes.wipe()
    self.children.wipe()
    self.classes.wipe()
    self.root = 0
    self.groups = 0
}

/* Writes the tree as canonical text, for tests and diagnostics: `cat{...}`,
 * `alt{...}`, `lit{a}`, `cc{a-z _}`, `cap1{...}`, `grp{...}`, `star{...}`,
 * `plus{...}`, `que{...}`, `rep{2,5 ...}`, `dot{}`, `bol{}`, `eol{}`, `wb{}`,
 * `nwb{}`, and `emp{}`. A lazy repetition adds `?` after its name. Bytes
 * outside printable ASCII, and the bytes `{`, `}`, `\`, and `-`, print as
 * `\xHH`. Returns the length written and true, or zero and false when
 * `destination` is too small.
 */
pub Syntax.format(self, destination: []char): (usize, bool) {
    w: Writer = Writer {
        syntax = self,
        out = output.Output.init(destination),
    }
    w.node(self.root)
    n: usize, ok: bool = w.out.finish()
    return n, ok
}

/* Appends one node and returns its index. */
Parser.add(self, node: Node): (u32, Error) {
    index: u32 = u32(self.nodes.len)
    err: Error = self.nodes.push(node)
    if err != null { return 0, ParseErr.allocation }

    return index, null
}

Parser.add_class(self, set: Class): (u32, Error) {
    index: u32 = u32(self.classes.len)
    err: Error = self.classes.push(set)
    if err != null { return 0, ParseErr.allocation }

    result: u32, add_err: Error = self.add(Node.class(index))
    return result, add_err
}

/* Folds the children pushed since `base` into one alternation or
 * concatenation node. A single child stands for itself and none is the empty
 * node.
 */
Parser.collect(self, base: usize, alternate: bool): (u32, Error) {
    count: usize = self.stack.len - base

    if count == 0 {
        result: u32, err: Error = self.add(Node.empty)
        return result, err
    }

    if count == 1 {
        only: u32 = self.stack.get(base)
        self.stack.truncate(base)
        return only, null
    }
    first: u32 = u32(self.children.len)

    for i: usize in base .. self.stack.len {
        err: Error = self.children.push(self.stack.get(i))
        if err != null { return 0, ParseErr.allocation }
    }
    self.stack.truncate(base)
    list: List = List {
        first = first,
        count = u32(count),
    }

    if alternate {
        result: u32, err: Error = self.add(Node.alt(list))
        return result, err
    }
    result: u32, err: Error = self.add(Node.concat(list))
    return result, err
}

/* The 1-based line and column of byte `at` in the pattern. */
Parser.position(const self, at: usize): (usize, usize) {
    line: usize = 1
    start: usize = 0

    for i: usize in 0 .. at {
        if self.text[i] == '\n' {
            line += 1
            start = i + 1
        }
    }
    return line, at - start + 1
}

/* Appends "`err`'s message at line:column" for the current offset to `diag`
 * and returns `err`; null passes through, so a helper's result can be
 * returned through it. The position is counted only on the failure path.
 */
Parser.fail(self, diag: *fmt.Buffer, err: Error): Error {
    if err == null { return null }
    line: usize, column: usize = self.position(self.at)
    diag.printf("%s at %d:%d\n", err.message, int(line), int(column))
    return err
}

/* `fail`, then the class opened at `open` as enclosing context. */
Parser.in_class(self, diag: *fmt.Buffer, err: Error, open: usize): Error {
    self.fail(diag, err)
    line: usize, column: usize = self.position(open)
    diag.printf("in class at %d:%d\n", int(line), int(column))
    return err
}

/* alternation := concatenation ('|' concatenation)* */
Parser.parse_alt(self, depth: usize, diag: *fmt.Buffer): (u32, Error) {
    base: usize = self.stack.len

    for {
        branch: u32, err: Error = self.parse_concat(depth, diag)
        if err != null { return 0, err }

        err = self.stack.push(branch)
        if err != null { return 0, self.fail(diag, ParseErr.allocation) }

        if self.at == self.text.len || self.text[self.at] != '|' { break }
        self.at += 1
    }
    result: u32, err: Error = self.collect(base, true)
    return result, self.fail(diag, err)
}

/* concatenation := repetition*, ending before '|', ')', or the end */
Parser.parse_concat(self, depth: usize, diag: *fmt.Buffer): (u32, Error) {
    base: usize = self.stack.len

    for self.at < self.text.len && self.text[self.at] != '|' && self.text[self.at] != ')' {
        item: u32, err: Error = self.parse_repeat(depth, diag)
        if err != null { return 0, err }

        err = self.stack.push(item)
        if err != null { return 0, self.fail(diag, ParseErr.allocation) }
    }
    result: u32, err: Error = self.collect(base, false)
    return result, self.fail(diag, err)
}

/* repetition := atom [quantifier ['?']]. A second quantifier is rejected
 * rather than read as a repetition of a repetition.
 */
Parser.parse_repeat(self, depth: usize, diag: *fmt.Buffer): (u32, Error) {
    if is_quantifier(self.text[self.at]) { return 0, self.fail(diag, ParseErr.missing_operand) }
    atom: u32, err: Error = self.parse_atom(depth, diag)
    if err != null { return 0, err }

    if self.at == self.text.len || !is_quantifier(self.text[self.at]) { return atom, null }
    min: u32, max: u32, count_err: Error = self.parse_quantifier()
    if count_err != null { return 0, self.fail(diag, count_err) }

    greedy: bool = true

    if self.at < self.text.len && self.text[self.at] == '?' {
        greedy = false
        self.at += 1
    }

    if self.at < self.text.len && is_quantifier(self.text[self.at]) { return 0, self.fail(diag, ParseErr.missing_operand) }
    result: u32, add_err: Error = self.add(Node.repeat(Repeat {
        child = atom,
        min = min,
        max = max,
        greedy = greedy,
    }))
    return result, self.fail(diag, add_err)
}

/* quantifier := '*' | '+' | '?' | '{' count [',' [count]] '}' */
Parser.parse_quantifier(self): (u32, u32, Error) {
    c: u8 = self.text[self.at]
    self.at += 1

    switch c {
        '*' { return 0, UNBOUNDED, null }
        '+' { return 1, UNBOUNDED, null }
        '?' { return 0, 1, null }
        default {}
    }
    open: usize = self.at - 1
    min: u32, ok: bool = self.parse_count()
    max: u32 = min

    if ok && self.at < self.text.len && self.text[self.at] == ',' {
        self.at += 1
        max = UNBOUNDED

        if self.at < self.text.len && self.text[self.at] != '}' { max, ok = self.parse_count() }
    }

    if !ok || self.at == self.text.len || self.text[self.at] != '}' || max < min {
        self.at = open
        return 0, 0, ParseErr.invalid_repeat
    }
    self.at += 1
    return min, max, null
}

/* A decimal count of at most MAX_REPEAT. */
Parser.parse_count(self): (u32, bool) {
    start: usize = self.at

    for self.at < self.text.len && '0' <= self.text[self.at] <= '9' { self.at += 1 }
    value: uint, ok: bool = str.parse[uint](self.text[start..self.at])
    if !ok || value > MAX_REPEAT { return 0, false }

    return u32(value), true
}

/* atom := group | class | '.' | '^' | '$' | escape | byte */
Parser.parse_atom(self, depth: usize, diag: *fmt.Buffer): (u32, Error) {
    c: u8 = self.text[self.at]

    switch c {
        '(' {
            result: u32, err: Error = self.parse_group(depth, diag)
            return result, err
        }
        '[' {
            result: u32, err: Error = self.parse_class(diag)
            return result, err
        }
        '.' {
            self.at += 1
            result: u32, err: Error = self.add(Node.any)
            return result, self.fail(diag, err)
        }
        '^' {
            self.at += 1
            result: u32, err: Error = self.add(Node.bol)
            return result, self.fail(diag, err)
        }
        '$' {
            self.at += 1
            result: u32, err: Error = self.add(Node.eol)
            return result, self.fail(diag, err)
        }
        '\\' {
            result: u32, err: Error = self.parse_escape(diag)
            return result, err
        }
        default {}
    }
    self.at += 1
    result: u32, err: Error = self.add(Node.byte(c))
    return result, self.fail(diag, err)
}

/* group := '(' ['?:'] alternation ')' */
Parser.parse_group(self, depth: usize, diag: *fmt.Buffer): (u32, Error) {
    if depth >= MAX_DEPTH { return 0, self.fail(diag, ParseErr.depth) }
    open: usize = self.at
    self.at += 1
    index: u32 = 0

    if str.has(self.text[self.at..], "?:", false) {
        self.at += 2
    } else {
        self.groups += 1
        index = self.groups
    }
    child: u32, err: Error = self.parse_alt(depth + 1, diag)
    if err != null {
        line: usize, column: usize = self.position(open)
        diag.printf("in group at %d:%d\n", int(line), int(column))
        return 0, err
    }

    if self.at == self.text.len {
        self.at = open
        return 0, self.fail(diag, ParseErr.missing_paren)
    }
    self.at += 1
    result: u32, add_err: Error = self.add(Node.group(Group {
        index = index,
        child = child,
    }))
    return result, self.fail(diag, add_err)
}

/* An escape outside a class: `\b` and `\B` are word-boundary assertions and
 * every other escape is a class item.
 */
Parser.parse_escape(self, diag: *fmt.Buffer): (u32, Error) {
    if self.at + 1 < self.text.len && self.text[self.at + 1] == 'b' {
        self.at += 2
        result: u32, err: Error = self.add(Node.word)
        return result, self.fail(diag, err)
    }

    if self.at + 1 < self.text.len && self.text[self.at + 1] == 'B' {
        self.at += 2
        result: u32, err: Error = self.add(Node.not_word)
        return result, self.fail(diag, err)
    }
    byte: u8, set: Class, is_set: bool, err: Error = self.parse_item()
    if err != null { return 0, self.fail(diag, err) }
    if is_set {
        result: u32, add_err: Error = self.add_class(set)
        return result, self.fail(diag, add_err)
    }

    result: u32, add_err: Error = self.add(Node.byte(byte))
    return result, self.fail(diag, add_err)
}

/* class := '[' ['^'] (item ['-' item])* ']'. A '-' first or last is a
 * literal; `]` must be escaped.
 */
Parser.parse_class(self, diag: *fmt.Buffer): (u32, Error) {
    open: usize = self.at
    self.at += 1
    negated: bool = false

    if self.at < self.text.len && self.text[self.at] == '^' {
        negated = true
        self.at += 1
    }
    members: Class = blank(Class)

    for {
        if self.at == self.text.len {
            self.at = open
            return 0, self.fail(diag, ParseErr.unterminated_class)
        }

        if self.text[self.at] == ']' {
            self.at += 1
            break
        }
        start: usize = self.at
        lo: u8, set: Class, is_set: bool, err: Error = self.parse_item()
        if err != null { return 0, self.in_class(diag, err, open) }
        if is_set {
            members.add(set)
            continue
        }

        hi: u8 = lo

        if self.at + 1 < self.text.len && self.text[self.at] == '-' && self.text[self.at + 1] != ']' {
            self.at += 1
            hi, set, is_set, err = self.parse_item()
            if err != null { return 0, self.in_class(diag, err, open) }
            if is_set || hi < lo {
                self.at = start
                return 0, self.in_class(diag, ParseErr.invalid_range, open)
            }
        }
        members.add_range(lo, hi)
    }

    if negated { members.negate() }
    result: u32, err: Error = self.add_class(members)
    return result, self.fail(diag, err)
}

/* One byte or one Perl class, plain or escaped. Returns the byte, or the
 * class with true. An invalid escape reports the offset of its backslash.
 */
Parser.parse_item(self): (u8, Class, bool, Error) {
    c: u8 = self.text[self.at]
    self.at += 1

    if c != '\\' { return c, blank(Class), false, null }
    start: usize = self.at - 1

    if self.at == self.text.len {
        self.at = start
        return 0, blank(Class), false, ParseErr.invalid_escape
    }
    letter: u8 = self.text[self.at]
    self.at += 1
    set: Class, ok: bool = perl_class(letter)
    if ok { return 0, set, true, null }

    switch letter {
        'n' { return '\n', blank(Class), false, null }
        't' { return '\t', blank(Class), false, null }
        'r' { return '\r', blank(Class), false, null }
        'x' {
            if self.at + 2 <= self.text.len {
                value: uint, hex: bool = str.parse[uint](self.text[self.at..self.at + 2], u8(16))
                if hex {
                    self.at += 2
                    return u8(value), blank(Class), false, null
                }
            }
        }
        '\\', '.', '+', '*', '?', '(', ')', '|', '[', ']', '{', '}', '^', '$', '-' {
            return letter, blank(Class), false, null
        }
        default {}
    }
    self.at = start
    return 0, blank(Class), false, ParseErr.invalid_escape
}

/* Members as maximal runs: `a`, or `a-c` for a run of two or more. */
Writer.class(self, set: Class) {
    self.out.text("cc{")
    first: bool = true
    at: uint = 0

    for at < 256 {
        if !set.has(u8(at)) {
            at += 1
            continue
        }
        lo: uint = at

        for at < 256 && set.has(u8(at)) { at += 1 }

        if !first { self.out.put(' ') }
        first = false
        self.out.byte(u8(lo))

        if at - 1 > lo {
            self.out.put('-')
            self.out.byte(u8(at - 1))
        }
    }
    self.out.put('}')
}

Writer.list(self, name: string, list: List) {
    self.out.text(name)
    self.out.put('{')

    for i: u32 in 0 .. list.count {
        if i > 0 { self.out.put(' ') }
        self.node(self.syntax.children.get(usize(list.first + i)))
    }
    self.out.put('}')
}

Writer.repeat(self, r: Repeat) {
    counted: bool = false

    if r.min == 0 && r.max == UNBOUNDED {
        self.out.text("star")
    } else if r.min == 1 && r.max == UNBOUNDED {
        self.out.text("plus")
    } else if r.min == 0 && r.max == 1 {
        self.out.text("que")
    } else {
        self.out.text("rep")
        counted = true
    }

    if !r.greedy { self.out.put('?') }
    self.out.put('{')

    if counted {
        self.out.number(r.min)

        if r.max != r.min {
            self.out.put(',')

            if r.max != UNBOUNDED { self.out.number(r.max) }
        }
        self.out.put(' ')
    }
    self.node(r.child)
    self.out.put('}')
}

Writer.node(self, index: u32) {
    node: Node = self.syntax.nodes.get(usize(index))

    switch node {
        Node.empty { self.out.text("emp{}") }
        Node.any { self.out.text("dot{}") }
        Node.bol { self.out.text("bol{}") }
        Node.eol { self.out.text("eol{}") }
        Node.word { self.out.text("wb{}") }
        Node.not_word { self.out.text("nwb{}") }
        Node.byte(byte: u8) {
            self.out.text("lit{")
            self.out.byte(byte)
            self.out.put('}')
        }
        Node.class(class: u32) {
            self.class(self.syntax.classes.get(usize(class)))
        }
        Node.group(group: Group) {
            if group.index == 0 {
                self.out.text("grp")
            } else {
                self.out.text("cap")
                self.out.number(group.index)
            }
            self.out.put('{')
            self.node(group.child)
            self.out.put('}')
        }
        Node.repeat(r: Repeat) { self.repeat(r) }
        Node.concat(list: List) { self.list("cat", list) }
        Node.alt(list: List) { self.list("alt", list) }
    }
}
