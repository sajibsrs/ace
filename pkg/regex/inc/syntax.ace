/* Regular-expression syntax: a recursive-descent parser from pattern text to
 * a flat syntax tree. Matching is byte-oriented: a pattern is a byte string
 * and every node matches bytes, never decoded code points.
 *
 * Nodes live in one array and name their children by index, so a tree is a
 * few allocations however large it is, and one `wipe` frees it.
 * Concatenation and alternation are n-ary, their children a contiguous run of
 * `children`, which keeps tree depth bounded by group nesting rather than by
 * pattern length.
 */

import array
import ascii
import str
import output: "./output.ace"

pub ParseErr: error {
    1: missing_paren = "missing closing parenthesis"
    2: unexpected_paren = "unexpected closing parenthesis"
    3: missing_operand = "repetition operator has no operand"
    4: invalid_repeat = "invalid repetition count"
    5: invalid_range = "invalid character class range"
    6: unterminated_class = "unterminated character class"
    7: invalid_escape = "invalid escape sequence"
    8: depth = "nesting depth exceeded"
    9: allocation = "allocation failed"
}

/* Recursion guard: the most groups that may nest, bounding stack depth on
 * adversarial input rather than risking overflow.
 */
MAX_DEPTH: usize = 512

/* The largest count `{m,n}` admits. Compilation expands a counted repetition
 * by copying its operand, so the bound caps program size.
 */
MAX_REPEAT: uint = 1000

/* A repetition's `max` when it has no upper bound. */
pub UNBOUNDED: const u32 = 0xFFFFFFFF

/* A set of bytes: bit `b % 64` of word `b / 64` is set when byte `b` is a
 * member.
 */
pub Class: struct {
    bits: [4]u64,
}

/* A parenthesized group. `index` is its capture number, counted from 1 in
 * order of the opening parentheses; 0 marks a non-capturing `(?:...)`.
 */
pub Group: struct {
    index: u32,
    child: u32,
}

/* `child` repeated `min` through `max` times, `max` being `UNBOUNDED` for no
 * upper bound. A greedy repetition prefers more iterations, a lazy one fewer.
 */
pub Repeat: struct {
    child: u32,
    min: u32,
    max: u32,
    greedy: bool,
}

/* `count` consecutive entries of `Syntax.children`, starting at `first`. */
pub List: struct {
    first: u32,
    count: u32,
}

pub Node: union {
    empty,
    any,
    bol,
    eol,
    word,
    not_word,
    byte: u8,
    class: u32,
    group: Group,
    repeat: Repeat,
    concat: List,
    alt: List,
}

/* A parsed pattern. `root` indexes `nodes`, a `class` node indexes `classes`,
 * and `groups` is the number of capturing groups. The canonical zero value
 * holds no storage.
 */
pub Syntax: struct {
    nodes: array.Array[Node],
    children: array.Array[u32],
    classes: array.Array[Class],
    root: u32,
    groups: u32,
}

/* One parse in progress. `stack` holds finished children until the
 * concatenation or alternation that owns them closes.
 */
Parser: struct {
    nodes: array.Array[Node],
    children: array.Array[u32],
    classes: array.Array[Class],
    stack: array.Array[u32],
    text: string = "",
    at: usize,
    groups: u32,
}

/* Canonical text for one tree. */
Writer: struct {
    syntax: Syntax,
    out: output.Output,
}

/* Adds every byte from `lo` through `hi`, inclusive, one mask per word the
 * range touches: `span + 1` ones shifted to the range's first bit. The mask
 * is built by shifting all-ones right, since a 64-bit run would need the
 * out-of-range shift `1 << 64`.
 */
mut Class.add_range(lo: u8, hi: u8) {
    for word: usize in usize(lo >> 6) .. usize(hi >> 6) + 1 {
        first: usize = 0
        last: usize = 63

        if word == usize(lo >> 6) {
            first = usize(lo & 63)
        }

        if word == usize(hi >> 6) {
            last = usize(hi & 63)
        }
        self.bits[word] |= (~u64(0) >> u64(63 - (last - first))) << u64(first)
    }
}

/* Adds every member of `other`. */
mut Class.add(other: Class) {
    for i: usize in 0 .. 4 {
        self.bits[i] |= other.bits[i]
    }
}

/* Replaces the set with every byte it did not hold. */
mut Class.negate() {
    for i: usize in 0 .. 4 {
        self.bits[i] = ~self.bits[i]
    }
}

pub Class.has(byte: u8): bool {
    return ((self.bits[usize(byte >> 6)] >> u64(byte & 63)) & 1) != 0
}

/* The class a Perl escape letter names: `d` digits, `w` word bytes
 * `[0-9A-Za-z_]`, `s` whitespace `[\t\n\f\r ]`, and each uppercase letter the
 * complement of its lowercase one. Any other letter returns false.
 */
perl_class(letter: u8): (Class, bool) {
    set: Class = blank(Class)

    switch ascii.to_lower(letter) {
        'd' {
            mut set.add_range('0', '9')
        }
        'w' {
            mut set.add_range('0', '9')
            mut set.add_range('A', 'Z')
            mut set.add_range('a', 'z')
            mut set.add_range('_', '_')
        }
        's' {
            mut set.add_range('\t', '\n')
            mut set.add_range('\x0C', '\r')
            mut set.add_range(' ', ' ')
        }
        default {
            return set, false
        }
    }

    if 'A' <= letter <= 'Z' {
        mut set.negate()
    }
    return set, true
}

is_quantifier(c: u8): bool {
    return c == '*' || c == '+' || c == '?' || c == '{'
}

/* Parses the complete pattern. On failure the returned offset is the byte at
 * which the error was found, except that an unclosed group or class reports
 * its opening delimiter and an invalid repetition count its `{`. A failed
 * parse holds no storage.
 */
pub Syntax::parse(pattern: string): (Syntax, Error, usize) {
    p: Parser = Parser{
        nodes = array.Array[Node]{},
        children = array.Array[u32]{},
        classes = array.Array[Class]{},
        stack = array.Array[u32]{},
        text = pattern,
        at = 0,
        groups = 0,
    }
    defer mut p.stack.wipe()
    root: u32, err: Error = mut p.parse_alt(0)
    if err == null && p.at < p.text.len {
        err = ParseErr.unexpected_paren
    }
    if err != null {
        mut p.nodes.wipe()
        mut p.children.wipe()
        mut p.classes.wipe()
        return blank(Syntax), err, p.at
    }

    return Syntax{nodes = p.nodes, children = p.children, classes = p.classes, root = root, groups = p.groups}, null, 0
}

/* Releases the tree and leaves it empty. */
pub mut Syntax.wipe() {
    mut self.nodes.wipe()
    mut self.children.wipe()
    mut self.classes.wipe()
    self.root = 0
    self.groups = 0
}

/* Writes the tree as canonical text, for tests and diagnostics: `cat{...}`,
 * `alt{...}`, `lit{a}`, `cc{a-z _}`, `cap1{...}`, `grp{...}`, `star{...}`,
 * `plus{...}`, `que{...}`, `rep{2,5 ...}`, `dot{}`, `bol{}`, `eol{}`, `wb{}`,
 * `nwb{}`, and `emp{}`. A lazy repetition adds `?` after its name. Bytes
 * outside printable ASCII, and the bytes `{`, `}`, `\`, and `-`, print as
 * `\xHH`. Returns the length written and true, or zero and false when
 * `destination` is too small.
 */
pub Syntax.format(destination: mut []char): (usize, bool) {
    w: Writer = Writer{syntax = self, out = output.Output::new(destination)}
    mut w.node(self.root)
    n: usize, ok: bool = w.out.finish()
    return n, ok
}

/* Appends one node and returns its index. */
mut Parser.add(node: Node): (u32, Error) {
    index: u32 = u32(self.nodes.len)
    err: Error = mut self.nodes.push(node)
    if err != null {
        return 0, ParseErr.allocation
    }

    return index, null
}

mut Parser.add_class(set: Class): (u32, Error) {
    index: u32 = u32(self.classes.len)
    err: Error = mut self.classes.push(set)
    if err != null {
        return 0, ParseErr.allocation
    }

    result: u32, add_err: Error = mut self.add(Node.class(index))
    return result, add_err
}

/* Folds the children pushed since `base` into one alternation or
 * concatenation node. A single child stands for itself and none is the empty
 * node.
 */
mut Parser.collect(base: usize, alternate: bool): (u32, Error) {
    count: usize = self.stack.len - base

    if count == 0 {
        result: u32, err: Error = mut self.add(Node.empty)
        return result, err
    }

    if count == 1 {
        only: u32 = self.stack.get(base)
        mut self.stack.truncate(base)
        return only, null
    }
    first: u32 = u32(self.children.len)

    for i: usize in base .. self.stack.len {
        err: Error = mut self.children.push(self.stack.get(i))
        if err != null {
            return 0, ParseErr.allocation
        }
    }
    mut self.stack.truncate(base)
    list: List = List{first = first, count = u32(count)}

    if alternate {
        result: u32, err: Error = mut self.add(Node.alt(list))
        return result, err
    }
    result: u32, err: Error = mut self.add(Node.concat(list))
    return result, err
}

/* alternation := concatenation ('|' concatenation)* */
mut Parser.parse_alt(depth: usize): (u32, Error) {
    base: usize = self.stack.len

    for {
        branch: u32, err: Error = mut self.parse_concat(depth)
        if err != null {
            return 0, err
        }

        err = mut self.stack.push(branch)
        if err != null {
            return 0, ParseErr.allocation
        }

        if self.at == self.text.len || self.text[self.at] != '|' {
            break
        }
        self.at += 1
    }
    result: u32, err: Error = mut self.collect(base, true)
    return result, err
}

/* concatenation := repetition*, ending before '|', ')', or the end */
mut Parser.parse_concat(depth: usize): (u32, Error) {
    base: usize = self.stack.len

    for self.at < self.text.len && self.text[self.at] != '|' && self.text[self.at] != ')' {
        item: u32, err: Error = mut self.parse_repeat(depth)
        if err != null {
            return 0, err
        }

        err = mut self.stack.push(item)
        if err != null {
            return 0, ParseErr.allocation
        }
    }
    result: u32, err: Error = mut self.collect(base, false)
    return result, err
}

/* repetition := atom [quantifier ['?']]. A second quantifier is rejected
 * rather than read as a repetition of a repetition.
 */
mut Parser.parse_repeat(depth: usize): (u32, Error) {
    if is_quantifier(self.text[self.at]) {
        return 0, ParseErr.missing_operand
    }
    atom: u32, err: Error = mut self.parse_atom(depth)
    if err != null {
        return 0, err
    }

    if self.at == self.text.len || !is_quantifier(self.text[self.at]) {
        return atom, null
    }
    min: u32, max: u32, count_err: Error = mut self.parse_quantifier()
    if count_err != null {
        return 0, count_err
    }

    greedy: bool = true

    if self.at < self.text.len && self.text[self.at] == '?' {
        greedy = false
        self.at += 1
    }

    if self.at < self.text.len && is_quantifier(self.text[self.at]) {
        return 0, ParseErr.missing_operand
    }
    result: u32, add_err: Error = mut self.add(Node.repeat(Repeat{child = atom, min = min, max = max, greedy = greedy}))
    return result, add_err
}

/* quantifier := '*' | '+' | '?' | '{' count [',' [count]] '}' */
mut Parser.parse_quantifier(): (u32, u32, Error) {
    c: u8 = self.text[self.at]
    self.at += 1

    switch c {
        '*' { return 0, UNBOUNDED, null }
        '+' { return 1, UNBOUNDED, null }
        '?' { return 0, 1, null }
        default {}
    }
    open: usize = self.at - 1
    min: u32, ok: bool = mut self.parse_count()
    max: u32 = min

    if ok && self.at < self.text.len && self.text[self.at] == ',' {
        self.at += 1
        max = UNBOUNDED

        if self.at < self.text.len && self.text[self.at] != '}' {
            max, ok = mut self.parse_count()
        }
    }

    if !ok || self.at == self.text.len || self.text[self.at] != '}' || max < min {
        self.at = open
        return 0, 0, ParseErr.invalid_repeat
    }
    self.at += 1
    return min, max, null
}

/* A decimal count of at most MAX_REPEAT. */
mut Parser.parse_count(): (u32, bool) {
    start: usize = self.at

    for self.at < self.text.len && '0' <= self.text[self.at] <= '9' {
        self.at += 1
    }
    value: uint, ok: bool = str.parse[uint](self.text[start..self.at])
    if !ok || value > MAX_REPEAT {
        return 0, false
    }

    return u32(value), true
}

/* atom := group | class | '.' | '^' | '$' | escape | byte */
mut Parser.parse_atom(depth: usize): (u32, Error) {
    c: u8 = self.text[self.at]

    switch c {
        '(' {
            result: u32, err: Error = mut self.parse_group(depth)
            return result, err
        }
        '[' {
            result: u32, err: Error = mut self.parse_class()
            return result, err
        }
        '.' {
            self.at += 1
            result: u32, err: Error = mut self.add(Node.any)
            return result, err
        }
        '^' {
            self.at += 1
            result: u32, err: Error = mut self.add(Node.bol)
            return result, err
        }
        '$' {
            self.at += 1
            result: u32, err: Error = mut self.add(Node.eol)
            return result, err
        }
        '\\' {
            result: u32, err: Error = mut self.parse_escape()
            return result, err
        }
        default {}
    }
    self.at += 1
    result: u32, err: Error = mut self.add(Node.byte(c))
    return result, err
}

/* group := '(' ['?:'] alternation ')' */
mut Parser.parse_group(depth: usize): (u32, Error) {
    if depth >= MAX_DEPTH {
        return 0, ParseErr.depth
    }
    open: usize = self.at
    self.at += 1
    index: u32 = 0

    if str.has(self.text[self.at..], "?:", false) {
        self.at += 2
    } else {
        self.groups += 1
        index = self.groups
    }
    child: u32, err: Error = mut self.parse_alt(depth + 1)
    if err != null {
        return 0, err
    }

    if self.at == self.text.len {
        self.at = open
        return 0, ParseErr.missing_paren
    }
    self.at += 1
    result: u32, add_err: Error = mut self.add(Node.group(Group{index = index, child = child}))
    return result, add_err
}

/* An escape outside a class: `\b` and `\B` are word-boundary assertions and
 * every other escape is a class item.
 */
mut Parser.parse_escape(): (u32, Error) {
    if self.at + 1 < self.text.len && self.text[self.at + 1] == 'b' {
        self.at += 2
        result: u32, err: Error = mut self.add(Node.word)
        return result, err
    }

    if self.at + 1 < self.text.len && self.text[self.at + 1] == 'B' {
        self.at += 2
        result: u32, err: Error = mut self.add(Node.not_word)
        return result, err
    }
    byte: u8, set: Class, is_set: bool, err: Error = mut self.parse_item()
    if err != null {
        return 0, err
    }
    if is_set {
        result: u32, add_err: Error = mut self.add_class(set)
        return result, add_err
    }

    result: u32, add_err: Error = mut self.add(Node.byte(byte))
    return result, add_err
}

/* class := '[' ['^'] (item ['-' item])* ']'. A '-' first or last is a
 * literal; `]` must be escaped.
 */
mut Parser.parse_class(): (u32, Error) {
    open: usize = self.at
    self.at += 1
    negated: bool = false

    if self.at < self.text.len && self.text[self.at] == '^' {
        negated = true
        self.at += 1
    }
    members: Class = blank(Class)

    for {
        if self.at == self.text.len {
            self.at = open
            return 0, ParseErr.unterminated_class
        }

        if self.text[self.at] == ']' {
            self.at += 1
            break
        }
        start: usize = self.at
        lo: u8, set: Class, is_set: bool, err: Error = mut self.parse_item()
        if err != null {
            return 0, err
        }
        if is_set {
            mut members.add(set)
            continue
        }

        hi: u8 = lo

        if self.at + 1 < self.text.len && self.text[self.at] == '-' && self.text[self.at + 1] != ']' {
            self.at += 1
            hi, set, is_set, err = mut self.parse_item()
            if err != null {
                return 0, err
            }
            if is_set || hi < lo {
                self.at = start
                return 0, ParseErr.invalid_range
            }
        }
        mut members.add_range(lo, hi)
    }

    if negated {
        mut members.negate()
    }
    result: u32, err: Error = mut self.add_class(members)
    return result, err
}

/* One byte or one Perl class, plain or escaped. Returns the byte, or the
 * class with true. An invalid escape reports the offset of its backslash.
 */
mut Parser.parse_item(): (u8, Class, bool, Error) {
    c: u8 = self.text[self.at]
    self.at += 1

    if c != '\\' {
        return c, blank(Class), false, null
    }
    start: usize = self.at - 1

    if self.at == self.text.len {
        self.at = start
        return 0, blank(Class), false, ParseErr.invalid_escape
    }
    letter: u8 = self.text[self.at]
    self.at += 1
    set: Class, ok: bool = perl_class(letter)
    if ok {
        return 0, set, true, null
    }

    switch letter {
        'n' { return '\n', blank(Class), false, null }
        't' { return '\t', blank(Class), false, null }
        'r' { return '\r', blank(Class), false, null }
        'x' {
            if self.at + 2 <= self.text.len {
                value: uint, hex: bool = str.parse[uint](self.text[self.at..self.at + 2], u8(16))
                if hex {
                    self.at += 2
                    return u8(value), blank(Class), false, null
                }
            }
        }
        '\\', '.', '+', '*', '?', '(', ')', '|', '[', ']', '{', '}', '^', '$', '-' {
            return letter, blank(Class), false, null
        }
        default {}
    }
    self.at = start
    return 0, blank(Class), false, ParseErr.invalid_escape
}

/* Members as maximal runs: `a`, or `a-c` for a run of two or more. */
mut Writer.class(set: Class) {
    mut self.out.text("cc{")
    first: bool = true
    at: uint = 0

    for at < 256 {
        if !set.has(u8(at)) {
            at += 1
            continue
        }
        lo: uint = at

        for at < 256 && set.has(u8(at)) {
            at += 1
        }

        if !first {
            mut self.out.put(' ')
        }
        first = false
        mut self.out.byte(u8(lo))

        if at - 1 > lo {
            mut self.out.put('-')
            mut self.out.byte(u8(at - 1))
        }
    }
    mut self.out.put('}')
}

mut Writer.list(name: string, list: List) {
    mut self.out.text(name)
    mut self.out.put('{')

    for i: u32 in 0 .. list.count {
        if i > 0 {
            mut self.out.put(' ')
        }
        mut self.node(self.syntax.children.get(usize(list.first + i)))
    }
    mut self.out.put('}')
}

mut Writer.repeat(r: Repeat) {
    counted: bool = false

    if r.min == 0 && r.max == UNBOUNDED {
        mut self.out.text("star")
    } else if r.min == 1 && r.max == UNBOUNDED {
        mut self.out.text("plus")
    } else if r.min == 0 && r.max == 1 {
        mut self.out.text("que")
    } else {
        mut self.out.text("rep")
        counted = true
    }

    if !r.greedy {
        mut self.out.put('?')
    }
    mut self.out.put('{')

    if counted {
        mut self.out.number(r.min)

        if r.max != r.min {
            mut self.out.put(',')

            if r.max != UNBOUNDED {
                mut self.out.number(r.max)
            }
        }
        mut self.out.put(' ')
    }
    mut self.node(r.child)
    mut self.out.put('}')
}

mut Writer.node(index: u32) {
    node: Node = self.syntax.nodes.get(usize(index))

    switch node {
        Node.empty { mut self.out.text("emp{}") }
        Node.any { mut self.out.text("dot{}") }
        Node.bol { mut self.out.text("bol{}") }
        Node.eol { mut self.out.text("eol{}") }
        Node.word { mut self.out.text("wb{}") }
        Node.not_word { mut self.out.text("nwb{}") }
        Node.byte(byte: u8) {
            mut self.out.text("lit{")
            mut self.out.byte(byte)
            mut self.out.put('}')
        }
        Node.class(class: u32) {
            mut self.class(self.syntax.classes.get(usize(class)))
        }
        Node.group(group: Group) {
            if group.index == 0 {
                mut self.out.text("grp")
            } else {
                mut self.out.text("cap")
                mut self.out.number(group.index)
            }
            mut self.out.put('{')
            mut self.node(group.child)
            mut self.out.put('}')
        }
        Node.repeat(r: Repeat) { mut self.repeat(r) }
        Node.concat(list: List) { mut self.list("cat", list) }
        Node.alt(list: List) { mut self.list("alt", list) }
    }
}
