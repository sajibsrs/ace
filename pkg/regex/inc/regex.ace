/* A compiled pattern together with the scratch state its searches reuse.
 * Searches take the complete text and a start position rather than a
 * subslice, so `^`, `$`, and `\b` see the text's true ends and the bytes
 * around the start. Searching mutates the scratch state, so every search
 * method takes `mut self`; none allocates or fails.
 */

import matcher: "./matcher.ace"
import program: "./program.ace"
import syntax: "./syntax.ace"

Matcher: type = matcher.Matcher
Program: type = program.Program
Syntax: type = syntax.Syntax

UNSET: const usize = matcher.UNSET

/* The bytes `text[start..end]` of a match or group. Both ends are `UNSET`
 * for a group that took no part in the match.
 */
pub Span: struct {
    start: usize,
    end: usize,
}

/* The convenience layer over the public core: a compiled `Program` with the
 * `Matcher` its searches reuse, plus the last successful search, which
 * `group` and `span` read back.
 */
pub Regex: struct {
    code: Program,
    run: Matcher,
    text: string = null,
    found: bool = false,
}

/* Parses and compiles `pattern`. The error is a `ParseErr` or a
 * `CompileErr`; `Syntax::parse` reports the pattern offset of a `ParseErr`.
 */
pub Regex::new(pattern: string): (Regex, Error) {
    tree: Syntax, err: Error, at: usize = Syntax::parse(pattern)
    defer mut tree.wipe()
    if err != null { return blank(Regex), err }

    code: Program, code_err: Error = Program::compile(tree)
    if code_err != null { return blank(Regex), code_err }

    run: Matcher, run_err: Error = Matcher::new(code)
    if run_err != null {
        mut code.wipe()
        return blank(Regex), run_err
    }

    return Regex{code = code, run = run}, null
}

pub mut Regex.wipe() {
    mut self.code.wipe()
    mut self.run.wipe()
    self.text = null
    self.found = false
}

/* The number of capturing groups, not counting the whole match. */
pub Regex.groups(): u32 { return self.code.slots / 2 - 1 }

/* Whether the pattern matches anywhere in `text`. It stops at the first match
 * any thread reaches, so it records no match for `group` and `span`.
 */
pub mut Regex.match(text: string): bool {
    self.found = false
    return mut self.run.run(self.code, text, 0, true)
}

/* Finds the leftmost-first match that starts at byte `after` or later and
 * records it for `group` and `span`.
 */
pub mut Regex.find(text: string, after: usize): bool {
    self.text = text
    self.found = mut self.run.run(self.code, text, after, false)
    return self.found
}

/* Finds the next match from `at`, as `find` does, and moves `at` past it:
 * to its end, or one byte further after an empty match, so a loop over
 * `next` visits every match once and ends.
 */
pub mut Regex.next(text: string, mut at: usize): bool {
    if !mut self.find(text, at) { return false }
    at = self.run.best[1]
    if at == self.run.best[0] { at += 1 }
    return true
}

/* The number of matches `next` visits in `text`. */
pub mut Regex.count(text: string): usize {
    total: usize = 0
    at: usize = 0
    for mut self.next(text, mut at) { total += 1 }
    return total
}

/* Group `k` of the last match found, 0 being the whole match: its bytes
 * `start..end`, both `UNSET` when the group took no part, `k` exceeds
 * `groups()`, or the last search found nothing.
 */
pub Regex.span(k: u32): Span {
    if !self.found || k > self.groups() { return Span{start = UNSET, end = UNSET} }
    return Span{start = self.run.best[2 * usize(k)], end = self.run.best[2 * usize(k) + 1]}
}

/* The text of `span(k)`: a view into the searched text, valid while that text
 * is, and null when the group is unset.
 */
pub Regex.group(k: u32): string {
    span: Span = self.span(k)
    if span.start == UNSET { return null }

    return self.text[span.start..span.end]
}
