import fmt
import json
import mem

/* Parses `text` and compares the failure's context with `want`. */
check(text: string, want: string): bool {
    doc: json.Json = json.Json.new()
    defer mut doc.wipe()
    storage: [256]u8
    diag: fmt.Buffer = fmt.Buffer.init(mut storage[..])
    err: Error = mut doc.parse(text, mut diag)

    if err == null || mem.equal(diag.text(), want) { return err != null }
    fmt.print(diag.text())
    return false
}

main(): int {
    if !check("{\"items\": [1, 2,\n  {\"a\": tru}]}", "invalid literal at 2:9\nin key \"a\"\nin array element 2\nin key \"items\"\n") { return 1 }

    if !check("{\"items\": [1 2]}", "expected ',' or ']' at 1:14\nin key \"items\"\n") { return 2 }

    if !check("[\"\\q\"]", "invalid string escape at 1:3\nin array element 0\n") { return 3 }

    if !check("{\"a\" 1}", "expected ':' at 1:6\n") { return 4 }

    if !check("1 2", "expected end of input at 1:3\n") { return 5 }

    if !check("[\n  \"open", "unterminated string at 2:3\nin array element 0\n") { return 7 }

    if !check("{", "expected a string key at 1:2\n") { return 8 }

    small: [12]u8
    diag: fmt.Buffer = fmt.Buffer.init(mut small[..])
    p: json.Parser = json.Parser.new()
    defer mut p.wipe()
    v: json.Value, err: Error = mut p.parse("[[[x]]]", mut diag)

    if err != json.ParseErr.unexpected_token || !mem.equal(diag.text(), "expected a v") || diag.dropped() == 0 { return 6 }
    return 0
}
