import json
import mem
import str

same(text: string, err: Error, expected: string): bool {
    if err != null { return false }
    return str.compare(text, expected) == 0
}

fields(): int {
    f: json.Formatter = json.Formatter.new()
    defer f.wipe()
    count: usize = 128
    f.object()
    f.field("level", "info")
    f.field("status", 200)
    f.field("delta", 0 - 3)
    f.field("size", uint(7))
    f.field("len", count)
    f.field("ratio", 0.5)
    f.field("ok", true)
    f.key("parent")
    f.none()
    f.end()
    text: string, err: Error = f.finish()
    expected: string = "{\"level\":\"info\",\"status\":200,\"delta\":-3,\"size\":7,\"len\":128,\"ratio\":0.5,\"ok\":true,\"parent\":null}"

    if !same(text, err, expected) { return 1 }
    return 0
}

nesting(): int {
    f: json.Formatter = json.Formatter.new()
    defer f.wipe()
    f.object()
    f.key("tags")
    f.array()
    f.value("a")
    f.value("b")
    f.array()
    f.end()
    f.object()
    f.end()
    f.end()
    f.field("n", 1)
    f.end()
    text: string, err: Error = f.finish()

    if !same(text, err, "{\"tags\":[\"a\",\"b\",[],{}],\"n\":1}") { return 11 }
    return 0
}

scalar_root(): int {
    f: json.Formatter = json.Formatter.new()
    defer f.wipe()
    f.value(1.0e21)
    text: string, err: Error = f.finish()

    if !same(text, err, "1e21") { return 21 }
    return 0
}

/* A parsed tree written back through the formatter reproduces its text. */
tree(): int {
    text: string = "{\"a\":[1,2.5,true,null],\"b\":{\"c\":\"d\"},\"e\":[]}"
    p: json.Parser = json.Parser.new()
    defer p.wipe()
    root: json.Value, perr: Error = p.parse(text)
    if perr != null { return 31 }

    f: json.Formatter = json.Formatter.new()
    defer f.wipe()
    f.value(root)
    out: string, err: Error = f.finish()

    if !same(out, err, text) { return 32 }
    return 0
}

escapes(): int {
    f: json.Formatter = json.Formatter.new()
    defer f.wipe()
    f.value("q\"b\\n\nt\tc\x01é")
    text: string, err: Error = f.finish()

    if !same(text, err, "\"q\\\"b\\\\n\\nt\\tc\\u0001é\"") { return 41 }
    return 0
}

failures(): int {
    nan: f64 = 0.0 / 0.0
    err: Error
    text: string

    f: json.Formatter = json.Formatter.new()
    defer f.wipe()
    f.value(nan)
    text, err = f.finish()
    if err != json.FormatErr.number { return 52 }

    f.reset()
    f.object()
    f.value(1)
    text, err = f.finish()
    if err != json.FormatErr.structure { return 53 }

    f.reset()
    f.array()
    f.key("k")
    text, err = f.finish()
    if err != json.FormatErr.structure { return 54 }

    f.reset()
    f.value(1)
    f.value(2)
    text, err = f.finish()
    if err != json.FormatErr.structure { return 55 }

    f.reset()
    f.array()
    text, err = f.finish()
    if err != json.FormatErr.structure { return 56 }

    f.reset()
    f.end()
    text, err = f.finish()
    if err != json.FormatErr.structure { return 57 }

    f.reset()
    text, err = f.finish()
    if err != json.FormatErr.structure { return 58 }

    f.reset()
    f.object()
    f.key("k")
    f.end()
    text, err = f.finish()
    if err != json.FormatErr.structure { return 59 }

    f.reset()
    for 0 .. 513 { f.array() }
    text, err = f.finish()
    if err != json.FormatErr.depth { return 60 }

    /* The first error sticks: a later structure failure does not replace it. */
    f.reset()
    f.value(nan)
    f.value("again")
    text, err = f.finish()
    if err != json.FormatErr.number { return 61 }

    return 0
}

/* Output far past the first allocation, checked by parsing it back. */
growth(): int {
    f: json.Formatter = json.Formatter.new()
    defer f.wipe()
    f.array()

    for i: int in 0 .. 5000 {
        f.object()
        f.field("id", i)
        f.field("name", "record")
        f.end()
    }
    f.end()
    text: string, err: Error = f.finish()
    if err != null || text.len < 100000 { return 71 }

    p: json.Parser = json.Parser.new()
    defer p.wipe()
    root: json.Value, perr: Error = p.parse(text)
    if perr != null { return 72 }

    switch root {
        json.Value.array(items: []json.Value) {
            if items.len != 5000 { return 73 }

            switch items[4999] {
                json.Value.object(pairs: []json.Pair) {
                    switch pairs[0].value {
                        json.Value.number(n: f64) {
                            if n != 4999.0 { return 74 }
                        }
                        default { return 75 }
                    }
                }
                default { return 76 }
            }
        }
        default { return 77 }
    }
    return 0
}

/* One formatter writes many documents in turn: each `reset` keeps the buffer,
 * and a second document without one is rejected.
 */
reuse(): int {
    f: json.Formatter = json.Formatter.new()
    defer f.wipe()
    text: string
    err: Error

    for i: int in 0 .. 3 {
        f.object()
        f.field("n", i)
        f.end()
        text, err = f.finish()
        expected: string = "{\"n\":0}"

        if i == 1 { expected = "{\"n\":1}" }
        if i == 2 { expected = "{\"n\":2}" }
        if !same(text, err, expected) { return 81 }
        f.reset()
    }
    f.value(1)
    f.value(2)
    text, err = f.finish()
    if err != json.FormatErr.structure { return 82 }

    return 0
}

/* Runtime-shaped data: the number of records and their values are computed. */
runtime(): int {
    f: json.Formatter = json.Formatter.new()
    defer f.wipe()
    count: int = 4
    f.array()

    for i: int in 0 .. count {
        f.object()
        f.field("id", i)
        f.field("square", i * i)
        f.field("even", i % 2 == 0)
        f.end()
    }
    f.end()
    text: string, err: Error = f.finish()
    expected: string = "[{\"id\":0,\"square\":0,\"even\":true},{\"id\":1,\"square\":1,\"even\":false},{\"id\":2,\"square\":4,\"even\":true},{\"id\":3,\"square\":9,\"even\":false}]"

    if !same(text, err, expected) { return 91 }
    return 0
}

main(): int {
    result: int = fields()
    if result != 0 { return result }

    result = nesting()
    if result != 0 { return result }

    result = scalar_root()
    if result != 0 { return result }

    result = tree()
    if result != 0 { return result }

    result = failures()
    if result != 0 { return result }

    result = growth()
    if result != 0 { return result }

    result = reuse()
    if result != 0 { return result }

    result = runtime()
    if result != 0 { return result }

    return escapes()
}
