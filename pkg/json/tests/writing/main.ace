import json
import str

same(output: []u8, n: usize, err: Error, expected: string): bool {
    if err != null {
        return false
    }
    return str.compare(string(output[0..n]), expected) == 0
}

fields(): int {
    buf: [128]u8
    w: json.Writer = json.writer(mut buf[..])
    mut w.object()
    mut w.field("level", "info")
    mut w.field("status", 200)
    mut w.field("delta", 0 - 3)
    mut w.field("size", uint(7))
    mut w.field("len", buf.len)
    mut w.field("ratio", 0.5)
    mut w.field("ok", true)
    mut w.key("parent")
    mut w.none()
    mut w.end()
    n: usize, err: Error = w.finish()
    expected: string = "{\"level\":\"info\",\"status\":200,\"delta\":-3,\"size\":7,\"len\":128,\"ratio\":0.5,\"ok\":true,\"parent\":null}"

    if !same(buf[..], n, err, expected) {
        return 1
    }
    return 0
}

nesting(): int {
    buf: [128]u8
    w: json.Writer = json.writer(mut buf[..])
    mut w.object()
    mut w.key("tags")
    mut w.array()
    mut w.value("a")
    mut w.value("b")
    mut w.array()
    mut w.end()
    mut w.object()
    mut w.end()
    mut w.end()
    mut w.field("n", 1)
    mut w.end()
    n: usize, err: Error = w.finish()

    if !same(buf[..], n, err, "{\"tags\":[\"a\",\"b\",[],{}],\"n\":1}") {
        return 11
    }
    return 0
}

scalar_root(): int {
    buf: [16]u8
    w: json.Writer = json.writer(mut buf[..])
    mut w.value(1.0e21)
    n: usize, err: Error = w.finish()

    if !same(buf[..], n, err, "1e21") {
        return 21
    }
    return 0
}

tree(): int {
    text: string = "{\"a\":[1,2.5,true,null],\"b\":{\"c\":\"d\"},\"e\":[]}"
    root: json.Json, perr: Error = json.parse(text)
    defer json.wipe(root)

    if perr != null {
        return 31
    }
    buf: [64]u8
    n: usize, err: Error = json.format(root, mut buf[..])

    if !same(buf[..], n, err, text) {
        return 32
    }
    return 0
}

escapes(): int {
    buf: [64]u8
    w: json.Writer = json.writer(mut buf[..])
    mut w.value("q\"b\\n\nt\tc\x01é")
    n: usize, err: Error = w.finish()

    if !same(buf[..], n, err, "\"q\\\"b\\\\n\\nt\\tc\\u0001é\"") {
        return 41
    }
    return 0
}

failures(): int {
    buf: [64]u8
    small: [4]u8
    nan: f64 = 0.0 / 0.0
    n: usize
    err: Error

    w: json.Writer = json.writer(mut small[..])
    mut w.value("toolong")
    n, err = w.finish()
    if err != json.FormatErr.capacity { return 51 }

    w = json.writer(mut buf[..])
    mut w.value(nan)
    n, err = w.finish()
    if err != json.FormatErr.number { return 52 }

    w = json.writer(mut buf[..])
    mut w.object()
    mut w.value(1)
    n, err = w.finish()
    if err != json.FormatErr.structure { return 53 }

    w = json.writer(mut buf[..])
    mut w.array()
    mut w.key("k")
    n, err = w.finish()
    if err != json.FormatErr.structure { return 54 }

    w = json.writer(mut buf[..])
    mut w.value(1)
    mut w.value(2)
    n, err = w.finish()
    if err != json.FormatErr.structure { return 55 }

    w = json.writer(mut buf[..])
    mut w.array()
    n, err = w.finish()
    if err != json.FormatErr.structure { return 56 }

    w = json.writer(mut buf[..])
    mut w.end()
    n, err = w.finish()
    if err != json.FormatErr.structure { return 57 }

    w = json.writer(mut buf[..])
    n, err = w.finish()
    if err != json.FormatErr.structure { return 58 }

    w = json.writer(mut buf[..])
    mut w.object()
    mut w.key("k")
    mut w.end()
    n, err = w.finish()
    if err != json.FormatErr.structure { return 59 }

    deep: [1100]u8
    w = json.writer(mut deep[..])
    for i: int in 0 .. 513 {
        mut w.array()
    }
    n, err = w.finish()
    if err != json.FormatErr.depth { return 60 }

    /* The first error sticks: a later capacity failure does not replace it. */
    w = json.writer(mut small[..])
    mut w.value(nan)
    mut w.value("toolong")
    n, err = w.finish()
    if err != json.FormatErr.number || n != 0 { return 61 }
    return 0
}

main(): int {
    result: int = fields()
    if result != 0 { return result }
    result = nesting()
    if result != 0 { return result }
    result = scalar_root()
    if result != 0 { return result }
    result = tree()
    if result != 0 { return result }
    result = failures()
    if result != 0 { return result }
    return escapes()
}
