import json
import str

same(output: []u8, n: usize, err: Error, expected: string): bool {
    if err != null {
        return false
    }
    return str.compare(string(output[0..n]), expected) == 0
}

/* Parses `text`, formats the tree, and checks the output equals `expected`. */
round(text: string, expected: string): bool {
    p: json.Parser = json.parser_new()
    defer json.parser_wipe(mut p)
    root: json.Json, perr: Error = mut p.parse(text)

    if perr != null {
        return false
    }
    buf: [128]u8
    n: usize, err: Error = json.format(root, mut buf[..])
    return same(buf[..], n, err, expected)
}

fields(): int {
    text: string = "{\"level\":\"info\",\"status\":200,\"delta\":-3,\"ratio\":0.5,\"ok\":true,\"parent\":null}"

    if !round(text, text) {
        return 1
    }
    return 0
}

nesting(): int {
    text: string = "{\"tags\":[\"a\",\"b\",[],{}],\"n\":1}"

    if !round(text, text) {
        return 11
    }
    return 0
}

scalar_root(): int {
    buf: [16]u8
    n: usize
    err: Error
    n, err = json.format(json.Json.number(1.0e21), mut buf[..])

    if !same(buf[..], n, err, "1e21") {
        return 21
    }
    n, err = json.format(json.Json.none, mut buf[..])

    if !same(buf[..], n, err, "null") {
        return 22
    }
    n, err = json.format(json.Json.bool(false), mut buf[..])

    if !same(buf[..], n, err, "false") {
        return 23
    }
    return 0
}

tree(): int {
    text: string = "{\"a\":[1,2.5,true,null],\"b\":{\"c\":\"d\"},\"e\":[]}"

    if !round(text, text) {
        return 31
    }
    return 0
}

escapes(): int {
    buf: [64]u8
    value: json.Json = json.Json.string("q\"b\\n\nt\tc\x01é")
    n: usize, err: Error = json.format(value, mut buf[..])

    if !same(buf[..], n, err, "\"q\\\"b\\\\n\\nt\\tc\\u0001é\"") {
        return 41
    }
    return 0
}

failures(): int {
    small: [4]u8
    buf: [64]u8
    nan: f64 = 0.0 / 0.0
    n: usize
    err: Error

    n, err = json.format(json.Json.string("toolong"), mut small[..])
    if err != json.FormatErr.capacity { return 51 }

    n, err = json.format(json.Json.number(nan), mut buf[..])
    if err != json.FormatErr.number { return 52 }

    /* A capacity failure inside a nested container still reports capacity. */
    p: json.Parser = json.parser_new()
    defer json.parser_wipe(mut p)
    root: json.Json, perr: Error = mut p.parse("[[1,2,3],[4,5,6]]")

    if perr != null {
        return 53
    }
    n, err = json.format(root, mut small[..])
    if err != json.FormatErr.capacity || n != 0 { return 54 }
    return 0
}

/* A tree 513 arrays deep, one past the parser's own limit, built by hand. */
depth(): int {
    levels: [513][1]json.Json
    deep: [2000]u8
    n: usize
    err: Error
    levels[512][0] = json.Json.none

    for i: usize in 0 .. 512 {
        level: usize = 511 - i
        levels[level][0] = json.Json.array(levels[level + 1][..])
    }
    n, err = json.format(json.Json.array(levels[0][..]), mut deep[..])
    if err != json.FormatErr.depth { return 61 }
    return 0
}

main(): int {
    result: int = fields()
    if result != 0 { return result }
    result = nesting()
    if result != 0 { return result }
    result = scalar_root()
    if result != 0 { return result }
    result = tree()
    if result != 0 { return result }
    result = failures()
    if result != 0 { return result }
    result = depth()
    if result != 0 { return result }
    return escapes()
}
