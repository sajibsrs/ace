/* json — a whole-document JSON value model, RFC 8259 parser, and formatter. */

import jsonval: "./inc/value.ace"
import parsing: "./inc/parsing.ace"
import writing: "./inc/writing.ace"

pub Json: type = jsonval.Json
pub Pair: type = jsonval.Pair
pub JsonErr: type = jsonval.JsonErr
pub FormatErr: type = writing.FormatErr

pub parse(text: string): (Json, Error) {
    result: Json, err: Error = parsing.parse(text)
    return result, err
}

pub wipe(v: Json) {
    jsonval.wipe(v)
}

pub format(value: Json, output: mut []u8): (usize, Error) {
    n: usize, err: Error = writing.format(value, output)
    return n, err
}
