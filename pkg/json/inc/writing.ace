/* Whole-document JSON output. A Formatter emits compact RFC 8259 text call by
 * call into a buffer it owns and grows, with no intermediate tree. The first
 * failure is kept and every later call is a no-op, so a sequence of writes
 * needs one error check, at finish.
 */

import mem
import str
import value: "./value.ace"

Value: type = value.Value
Pair: type = value.Pair

pub FormatErr: error {
    1: allocation = "allocation failed",
    2: depth = "nesting depth exceeded",
    3: number = "number is not finite",
    4: structure = "calls do not form exactly one JSON value",
}

/* The most containers that may be open at once, matching the parser. */
MAX_DEPTH: usize = 512

/* The first allocation, so a small document does not regrow several times. */
MIN_BUFFER: usize = 256

/* The longest spelling of any number `str.format` writes: an f64 in shortest
 * form or a 64-bit integer with its sign.
 */
NUMBER_MAX: usize = 32

/* An open container needs only its kind: closing a child proves its parent
 * already holds a member, so just the innermost container tracks whether it
 * is still empty. `objects` holds one bit per level (MAX_DEPTH / 8 bytes);
 * a set bit marks an object, a clear bit an array.
 *
 * A Formatter holds one document at a time. The text `finish` returns is
 * borrowed from the buffer and is valid until `reset` or `wipe`;
 * `reset` starts the next document and keeps the buffer.
 */
pub Formatter: struct {
    buffer: []u8 = null,
    at: usize,
    depth: usize,
    objects: [64]u8,
    empty: bool,
    keyed: bool,
    done: bool,
    err: Error,
}

pub Formatter.new(): Formatter {
    return Formatter {
        at = 0,
        depth = 0,
        objects = [0 : 64],
        empty = false,
        keyed = false,
        done = false,
        err = null,
    }
}

/* Releases the buffer. Call once no text from `finish` is still in use. */
pub Formatter.wipe(self) {
    mem.release[u8](&self.buffer)
    self.at = 0
    self.depth = 0
    self.empty = false
    self.keyed = false
    self.done = false
    self.err = null
}

/* Discards the current document and its error, keeping the buffer for the
 * next one. Text from `finish` is invalid afterwards.
 */
pub Formatter.reset(self) {
    self.at = 0
    self.depth = 0
    self.empty = false
    self.keyed = false
    self.done = false
    self.err = null
}

/* Returns the text of the one complete value written, or the first error. The
 * text is borrowed from the formatter.
 */
pub Formatter.finish(self): (string, Error) {
    if self.err != null { return "", self.err }

    if self.depth != 0 || !self.done { return "", FormatErr.structure }
    return string(self.buffer[0..self.at]), null
}

pub Formatter.object(self) {
    self.open(true)
}

pub Formatter.array(self) {
    self.open(false)
}

/* Closes the innermost open container, whichever kind it is. */
pub Formatter.end(self) {
    if self.err != null { return }

    if self.depth == 0 || self.keyed {
        self.fail(FormatErr.structure)
        return
    }

    if self.inside_object() {
        self.put('}')
    } else {
        self.put(']')
    }
    self.depth -= 1
    self.empty = false
    self.close_value()
}

pub Formatter.key(self, name: string) {
    if self.err != null { return }

    if self.depth == 0 || !self.inside_object() || self.keyed {
        self.fail(FormatErr.structure)
        return
    }

    if !self.empty { self.put(',') }
    self.empty = false
    self.quote(name)
    self.put(':')
    self.keyed = true
}

pub Formatter.none(self) {
    ok: bool = self.open_value()
    if !ok { return }

    self.put("null")
    self.close_value()
}

pub Formatter.value(self, flag: bool) {
    ok: bool = self.open_value()
    if !ok { return }

    if flag {
        self.put("true")
    } else {
        self.put("false")
    }
    self.close_value()
}

pub Formatter.value(self, number: int) {
    ok: bool = self.open_number()
    if !ok { return }

    n: usize, fit: bool = str.format(self.buffer[self.at..], number)
    self.advance(n, fit)
}

pub Formatter.value(self, number: uint) {
    ok: bool = self.open_number()
    if !ok { return }

    n: usize, fit: bool = str.format(self.buffer[self.at..], number)
    self.advance(n, fit)
}

pub Formatter.value(self, number: usize) {
    ok: bool = self.open_number()
    if !ok { return }

    n: usize, fit: bool = str.format(self.buffer[self.at..], number)
    self.advance(n, fit)
}

/* NaN and the infinities have no JSON spelling and are rejected. */
pub Formatter.value(self, number: f64) {
    zero: f64 = 0.0

    if self.err == null && (number != number || number - number != zero) {
        self.fail(FormatErr.number)
        return
    }
    ok: bool = self.open_number()
    if !ok { return }

    n: usize, fit: bool = str.format(self.buffer[self.at..], number)
    self.advance(n, fit)
}

pub Formatter.value(self, text: string) {
    ok: bool = self.open_value()
    if !ok { return }

    self.quote(text)
    self.close_value()
}

/* Writes a whole value tree through the same rules as the scalar calls. */
pub Formatter.value(self, tree: Value) {
    switch tree {
        Value.none {
            self.none()
        }
        Value.bool(flag: bool) {
            self.value(flag)
        }
        Value.number(number: f64) {
            self.value(number)
        }
        Value.string(text: string) {
            self.value(text)
        }
        Value.array(items: []Value) {
            self.array()

            for i: usize in 0 .. items.len {
                if self.err != null { return }
                self.value(items[i])
            }
            self.end()
        }
        Value.object(pairs: []Pair) {
            self.object()

            for i: usize in 0 .. pairs.len {
                if self.err != null { return }
                self.key(pairs[i].key)
                self.value(pairs[i].value)
            }
            self.end()
        }
    }
}

pub Formatter.field(self, name: string, flag: bool) {
    self.key(name)
    self.value(flag)
}

pub Formatter.field(self, name: string, number: int) {
    self.key(name)
    self.value(number)
}

pub Formatter.field(self, name: string, number: uint) {
    self.key(name)
    self.value(number)
}

pub Formatter.field(self, name: string, number: usize) {
    self.key(name)
    self.value(number)
}

pub Formatter.field(self, name: string, number: f64) {
    self.key(name)
    self.value(number)
}

pub Formatter.field(self, name: string, text: string) {
    self.key(name)
    self.value(text)
}

pub Formatter.field(self, name: string, tree: Value) {
    self.key(name)
    self.value(tree)
}

inline Formatter.fail(self, err: Error) {
    if self.err == null { self.err = err }
}

inline Formatter.inside_object(self): bool {
    level: usize = self.depth - 1
    mask: u8 = u8(1) << u8(level % 8)
    return (self.objects[level / 8] & mask) != 0
}

inline Formatter.open(self, object: bool) {
    ok: bool = self.open_value()
    if !ok { return }

    if self.depth == MAX_DEPTH {
        self.fail(FormatErr.depth)
        return
    }
    level: usize = self.depth
    mask: u8 = u8(1) << u8(level % 8)

    if object {
        self.objects[level / 8] = self.objects[level / 8] | mask
        self.put('{')
    } else {
        self.objects[level / 8] = self.objects[level / 8] & ~mask
        self.put('[')
    }
    self.depth += 1
    self.empty = true
    self.keyed = false
}

/* Places the separator a value needs and reports whether one may start here:
 * once at top level, after a key inside an object, or as the next element of
 * an array.
 */
inline Formatter.open_value(self): bool {
    if self.err != null { return false }

    if self.depth == 0 {
        if self.done {
            self.fail(FormatErr.structure)
            return false
        }
        return true
    }

    if self.inside_object() {
        if !self.keyed {
            self.fail(FormatErr.structure)
            return false
        }
        self.keyed = false
        return true
    }

    if !self.empty { self.put(',') }
    self.empty = false
    return true
}

/* Opens a value and guarantees room for the longest number, so `str.format`
 * can write it in place at the cursor.
 */
inline Formatter.open_number(self): bool {
    ok: bool = self.open_value()
    if !ok { return false }

    return self.reserve(NUMBER_MAX)
}

inline Formatter.close_value(self) {
    if self.depth == 0 { self.done = true }
}

/* Accounts for a number `str.format` wrote in place at the cursor. The
 * reserved room always fits it, so `fit` is a guard, not an expected path.
 */
inline Formatter.advance(self, n: usize, fit: bool) {
    if !fit {
        self.fail(FormatErr.allocation)
        return
    }
    self.at += n
    self.close_value()
}

/* Makes room for `extra` more bytes, growing the buffer geometrically. */
inline Formatter.reserve(self, extra: usize): bool {
    need: usize = self.at + extra

    if need <= self.buffer.len { return true }

    if need < MIN_BUFFER { need = MIN_BUFFER }
    grown: []u8, ok: bool = mem.grow[u8](self.buffer, need)
    if !ok {
        self.fail(FormatErr.allocation)
        return false
    }

    self.buffer = grown
    return true
}

/* Writes text as a quoted JSON string, copying unescaped runs whole. */
Formatter.quote(self, text: string) {
    self.put('"')
    spelling: [6]u8
    start: usize = 0

    for i: usize in 0 .. text.len {
        n: usize = escape(text[i], spelling[..])
        if n != 0 {
            self.put(text[start..i])
            self.put(spelling[0..n])
            start = i + 1
        }
    }
    self.put(text[start..text.len])
    self.put('"')
}

/* Writes the JSON escape for `byte` into `spelling` and returns its length,
 * or returns 0 when the byte is written as itself.
 */
inline escape(byte: u8, spelling: []u8): usize {
    short: u8 = 0

    if byte == '"' || byte == '\\' {
        short = byte
    } else if byte == 8 {
        short = 'b'
    } else if byte == 12 {
        short = 'f'
    } else if byte == 10 {
        short = 'n'
    } else if byte == 13 {
        short = 'r'
    } else if byte == 9 {
        short = 't'
    } else if byte >= 32 {
        return 0
    }
    spelling[0] = '\\'

    if short != 0 {
        spelling[1] = short
        return 2
    }
    hex: string = "0123456789abcdef"
    spelling[1] = 'u'
    spelling[2] = '0'
    spelling[3] = '0'
    spelling[4] = hex[byte / 16]
    spelling[5] = hex[byte % 16]
    return 6
}

inline Formatter.put(self, byte: u8) {
    if self.err != null { return }
    ok: bool = self.reserve(1)
    if !ok { return }

    self.buffer[self.at] = byte
    self.at += 1
}

inline Formatter.put(self, text: string) {
    if self.err != null { return }
    ok: bool = self.reserve(text.len)
    if !ok { return }

    mem.copy(self.buffer[self.at..self.at + text.len], text)
    self.at += text.len
}
