/* JSON output into caller-owned storage. `format` writes one value tree as
 * compact RFC 8259 text, with no allocation. Each helper takes the write
 * offset and returns the new one, so the first error unwinds the recursion
 * without any shared state.
 */

import mem
import str
import jsonval: "./value.ace"

Json: type = jsonval.Json
Pair: type = jsonval.Pair

pub FormatErr: error {
    1: capacity = "output storage is too small"
    2: depth = "nesting depth exceeded"
    3: number = "number is not finite"
}

/* The most containers that may be open at once, matching the parser. */
MAX_DEPTH: usize = 512

/* Serializes a complete value tree into caller-owned storage and returns the
 * byte count. After an error the contents of the output storage are
 * unspecified.
 */
pub format(value: Json, output: mut []u8): (usize, Error) {
    n: usize, err: Error = emit(value, output, 0, 0)

    if err != null {
        return 0, err
    }
    return n, null
}

/* Writes `value` at `at`, with `depth` containers already open around it. */
emit(value: Json, output: mut []u8, at: usize, depth: usize): (usize, Error) {
    pos: usize = at
    err: Error = null

    switch value {
        Json.none {
            pos, err = put(output, pos, "null")
        }
        Json.bool(flag: bool) {
            if flag {
                pos, err = put(output, pos, "true")
            } else {
                pos, err = put(output, pos, "false")
            }
        }
        Json.number(number: f64) {
            pos, err = write_number(output, pos, number)
        }
        Json.string(text: string) {
            pos, err = quote(output, pos, text)
        }
        Json.array(items: []Json) {
            if depth == MAX_DEPTH {
                return pos, FormatErr.depth
            }
            pos, err = put(output, pos, '[')

            if err != null {
                return pos, err
            }

            for i: usize in 0 .. items.len {
                if i != 0 {
                    pos, err = put(output, pos, ',')

                    if err != null {
                        return pos, err
                    }
                }
                pos, err = emit(items[i], output, pos, depth + 1)

                if err != null {
                    return pos, err
                }
            }
            pos, err = put(output, pos, ']')
        }
        Json.object(pairs: []Pair) {
            if depth == MAX_DEPTH {
                return pos, FormatErr.depth
            }
            pos, err = put(output, pos, '{')

            if err != null {
                return pos, err
            }

            for i: usize in 0 .. pairs.len {
                if i != 0 {
                    pos, err = put(output, pos, ',')

                    if err != null {
                        return pos, err
                    }
                }
                pos, err = quote(output, pos, pairs[i].key)

                if err != null {
                    return pos, err
                }
                pos, err = put(output, pos, ':')

                if err != null {
                    return pos, err
                }
                pos, err = emit(pairs[i].value, output, pos, depth + 1)

                if err != null {
                    return pos, err
                }
            }
            pos, err = put(output, pos, '}')
        }
    }
    return pos, err
}

/* NaN and the infinities have no JSON spelling and are rejected. */
write_number(output: mut []u8, at: usize, number: f64): (usize, Error) {
    zero: f64 = 0.0

    if number != number || number - number != zero {
        return at, FormatErr.number
    }
    n: usize, fit: bool = str.format(output[at..], number)

    if !fit {
        return at, FormatErr.capacity
    }
    return at + n, null
}

/* Writes text as a quoted JSON string, copying unescaped runs whole. */
quote(output: mut []u8, at: usize, text: string): (usize, Error) {
    pos: usize
    err: Error
    pos, err = put(output, at, '"')

    if err != null {
        return pos, err
    }
    spelling: [6]u8
    start: usize = 0

    for i: usize in 0 .. text.len {
        n: usize = escape(text[i], mut spelling[..])

        if n != 0 {
            pos, err = put(output, pos, text[start..i])

            if err != null {
                return pos, err
            }
            pos, err = put(output, pos, spelling[0..n])

            if err != null {
                return pos, err
            }
            start = i + 1
        }
    }
    pos, err = put(output, pos, text[start..text.len])

    if err != null {
        return pos, err
    }
    pos, err = put(output, pos, '"')
    return pos, err
}

/* Writes the JSON escape for `byte` into `spelling` and returns its length,
 * or returns 0 when the byte is written as itself.
 */
escape(byte: u8, spelling: mut []u8): usize {
    short: u8 = 0

    if byte == '"' || byte == '\\' {
        short = byte
    } else if byte == 8 {
        short = 'b'
    } else if byte == 12 {
        short = 'f'
    } else if byte == 10 {
        short = 'n'
    } else if byte == 13 {
        short = 'r'
    } else if byte == 9 {
        short = 't'
    } else if byte >= 32 {
        return 0
    }
    spelling[0] = '\\'

    if short != 0 {
        spelling[1] = short
        return 2
    }
    hex: string = "0123456789abcdef"
    spelling[1] = 'u'
    spelling[2] = '0'
    spelling[3] = '0'
    spelling[4] = hex[byte / 16]
    spelling[5] = hex[byte % 16]
    return 6
}

put(output: mut []u8, at: usize, byte: u8): (usize, Error) {
    if at >= output.len {
        return at, FormatErr.capacity
    }
    output[at] = byte
    return at + 1, null
}

put(output: mut []u8, at: usize, text: string): (usize, Error) {
    if text.len > output.len - at {
        return at, FormatErr.capacity
    }
    mem.copy(output[at..at + text.len], text)
    return at + text.len, null
}
