/* Whole-document recursive-descent JSON parsing (RFC 8259). Input is a
 * complete in-memory buffer, so an eager parse needs no resumable state
 * machine.
 *
 * The walk is a set of Parser methods; parse_value and parse_object/
 * parse_array call each other recursively.
 */

import array
import mem
import str
import utf8
import value: "./value.ace"

Value: type = value.Value
Pair: type = value.Pair

pub ParseErr: error {
    1: unexpected_token = "unexpected token"
    2: unterminated_string = "unterminated string literal"
    3: invalid_escape = "invalid string escape"
    4: invalid_number = "invalid number literal"
    5: depth = "nesting depth exceeded"
    6: trailing_data = "unexpected trailing data after value"
    7: empty_input = "empty input"
    8: allocation = "allocation failed"
}

/* Recursion guard: the most containers that may nest, bounding stack depth on
 * adversarial input rather than risking overflow.
 */
MAX_DEPTH: usize = 512

/* The storage one parse fills: string bytes, array elements, and object
 * members, each one block sized from the input.
 */
Block: struct {
    bytes: mut []u8 = null,
    items: mut []Value = null,
    pairs: mut []Pair = null,
}

/* Owns the storage of every tree it parses. A returned `Value` borrows from
 * the parser and is valid until `reset` or `wipe`; trees accumulate
 * until then. `blocks` holds `kept` allocated blocks, of which `count` are in
 * use since the last `reset`. `bytes`, `items`, and `pairs` are the block the
 * current parse fills, and `stack` and `pstack` hold finished children until
 * their container closes.
 */
pub Parser: struct {
    blocks: mut []Block = null,
    kept: usize,
    count: usize,
    bytes: mut []u8 = null,
    items: mut []Value = null,
    pairs: mut []Pair = null,
    bat: usize,
    iat: usize,
    pat: usize,
    stack: array.Array[Value],
    pstack: array.Array[Pair],
    text: string = "",
    at: usize,
}

pub Parser::new(): Parser {
    return Parser {
        kept = 0,
        count = 0,
        bat = 0,
        iat = 0,
        pat = 0,
        stack = array.Array[Value] {},
        pstack = array.Array[Pair] {},
        at = 0,
    }
}

/* Releases every tree the parser produced. Call once none is still in use. */
pub mut Parser.wipe() {
    for i: usize in 0 .. self.kept {
        mem.release[u8](mut self.blocks[i].bytes)
        mem.release[Value](mut self.blocks[i].items)
        mem.release[Pair](mut self.blocks[i].pairs)
    }
    mem.release[Block](mut self.blocks)
    mut self.stack.wipe()
    mut self.pstack.wipe()
    self.kept = 0
    self.count = 0
    self.bytes = null
    self.items = null
    self.pairs = null
}

/* Drops every tree the parser produced but keeps its storage, so the next
 * parses reuse the blocks that are large enough. Every `Value` from before is
 * invalid afterwards.
 */
pub mut Parser.reset() {
    self.count = 0
    self.bytes = null
    self.items = null
    self.pairs = null
    mut self.stack.clear()
    mut self.pstack.clear()
}

/* Parses the complete text as one JSON value. Trailing non-whitespace bytes
 * after the value are rejected, matching a whole-document parse rather than
 * a stream that tolerates more input after one value. A failed parse needs
 * no cleanup: whatever it allocated stays owned by the parser. On failure the
 * returned offset is the byte at which the error was found, except that an
 * unterminated string reports its opening quote; on success it is 0.
 */
pub mut Parser.parse(text: string): (Value, Error, usize) {
    self.text = text
    self.at = 0
    mut self.stack.clear()
    mut self.pstack.clear()
    mut self.skip_ws()

    if self.at == self.text.len { return Value.none, ParseErr.empty_input, self.at }
    rerr: Error = mut self.reserve()
    if rerr != null { return Value.none, rerr, self.at }

    result: Value, err: Error = mut self.parse_value(0)
    if err != null { return Value.none, err, self.at }

    mut self.skip_ws()

    if self.at != self.text.len { return Value.none, ParseErr.trailing_data, self.at }
    return result, null, 0
}

/* Takes this parse's block, reusing a kept one that is large enough, and
 * records it before anything is written, so a later failure still leaves it
 * owned by the parser. The sizes are bounds, not counts: an array element owns
 * its first byte and its trailing `,` or `]`, and an object member owns its
 * key's two quotes, its `:`, and its trailing `,` or `}`, so text of n bytes
 * holds at most n / 2 elements and n / 4 members.
 */
mut Parser.reserve(): Error {
    items: usize = self.text.len / 2 + 1
    members: usize = self.text.len / 4 + 1
    at: usize = self.count

    if at == self.kept {
        grown: mut []Block, ok: bool = mem.grow[Block](self.blocks, at + 1)
        if !ok { return ParseErr.allocation }

        self.blocks = grown
        self.blocks[at] = Block {}
        self.kept += 1
    }
    self.count += 1

    if self.blocks[at].bytes.len < self.text.len || self.blocks[at].items.len < items || self.blocks[at].pairs.len < members {
        mem.release[u8](mut self.blocks[at].bytes)
        mem.release[Value](mut self.blocks[at].items)
        mem.release[Pair](mut self.blocks[at].pairs)
        self.blocks[at].bytes = mem.alloc[u8](self.text.len)
        self.blocks[at].items = mem.alloc[Value](items)
        self.blocks[at].pairs = mem.alloc[Pair](members)

        if self.blocks[at].bytes == null || self.blocks[at].items == null || self.blocks[at].pairs == null {
            return ParseErr.allocation
        }
    }
    self.bytes = self.blocks[at].bytes
    self.items = self.blocks[at].items
    self.pairs = self.blocks[at].pairs
    self.bat = 0
    self.iat = 0
    self.pat = 0
    return null
}

inline mut Parser.skip_ws() {
    for self.at < self.text.len && is_ws(self.text[self.at]) { self.at += 1 }
}

mut Parser.parse_value(depth: usize): (Value, Error) {
    mut self.skip_ws()

    if self.at == self.text.len { return Value.none, ParseErr.unexpected_token }
    c: u8 = self.text[self.at]

    if c == '"' {
        text: string, err: Error = mut self.parse_string()
        if err != null { return Value.none, err }

        return Value.string(text), null
    }

    if c == '{' {
        result: Value, err: Error = mut self.parse_object(depth)
        return result, err
    }

    if c == '[' {
        result: Value, err: Error = mut self.parse_array(depth)
        return result, err
    }

    if c == 't' {
        if mut self.consume_literal("true") { return Value.bool(true), null }
        return Value.none, ParseErr.unexpected_token
    }

    if c == 'f' {
        if mut self.consume_literal("false") { return Value.bool(false), null }
        return Value.none, ParseErr.unexpected_token
    }

    if c == 'n' {
        if mut self.consume_literal("null") { return Value.none, null }
        return Value.none, ParseErr.unexpected_token
    }

    if c == '-' || is_digit(c) {
        result: Value, err: Error = mut self.parse_number()
        return result, err
    }
    return Value.none, ParseErr.unexpected_token
}

mut Parser.consume_literal(literal: string): bool {
    remaining: usize = self.text.len - self.at

    if remaining < literal.len { return false }

    if !mem.equal(self.text[self.at..self.at + literal.len], literal) { return false }
    self.at += literal.len
    return true
}

mut Parser.parse_number(): (Value, Error) {
    start: usize = self.at

    if self.at < self.text.len && self.text[self.at] == '-' { self.at += 1 }

    if self.at == self.text.len || !is_digit(self.text[self.at]) { return Value.none, ParseErr.invalid_number }

    if self.text[self.at] == '0' {
        self.at += 1

        if self.at < self.text.len && is_digit(self.text[self.at]) { return Value.none, ParseErr.invalid_number }
    } else {
        for self.at < self.text.len && is_digit(self.text[self.at]) { self.at += 1 }
    }

    if self.at < self.text.len && self.text[self.at] == '.' {
        self.at += 1

        if self.at == self.text.len || !is_digit(self.text[self.at]) { return Value.none, ParseErr.invalid_number }

        for self.at < self.text.len && is_digit(self.text[self.at]) { self.at += 1 }
    }

    if self.at < self.text.len && (self.text[self.at] == 'e' || self.text[self.at] == 'E') {
        self.at += 1

        if self.at < self.text.len && (self.text[self.at] == '+' || self.text[self.at] == '-') { self.at += 1 }

        if self.at == self.text.len || !is_digit(self.text[self.at]) { return Value.none, ParseErr.invalid_number }

        for self.at < self.text.len && is_digit(self.text[self.at]) { self.at += 1 }
    }
    raw: string = self.text[start..self.at]
    parsed: f64, ok: bool = str.parse[f64](raw)
    if !ok { return Value.none, ParseErr.invalid_number }

    return Value.number(parsed), null
}

mut Parser.parse_string(): (string, Error) {
    self.at += 1
    start: usize = self.at
    end: usize, closed: bool = find_string_end(self.text, start)
    if !closed {
        self.at = start - 1
        return "", ParseErr.unterminated_string
    }

    upper: usize = end - start

    if upper == 0 {
        self.at = end + 1
        return "", null
    }
    base: usize = self.bat
    used: usize, err: Error = decode_string(self.text, start, end, self.bytes[base..base + upper])
    if err != null { return "", err }

    self.at = end + 1
    self.bat = base + used
    return string(self.bytes[base..base + used]), null
}

mut Parser.parse_array(depth: usize): (Value, Error) {
    if depth >= MAX_DEPTH { return Value.none, ParseErr.depth }
    self.at += 1
    empty: mut []Value = null
    base: usize = self.stack.len
    mut self.skip_ws()

    if self.at < self.text.len && self.text[self.at] == ']' {
        self.at += 1
        return Value.array(empty), null
    }

    for {
        mut self.skip_ws()
        elem: Value, err: Error = mut self.parse_value(depth + 1)
        if err != null { return Value.none, err }

        push_err: Error = mut self.stack.push(elem)
        if push_err != null { return Value.none, ParseErr.allocation }

        mut self.skip_ws()

        if self.at == self.text.len { return Value.none, ParseErr.unexpected_token }
        c: u8 = self.text[self.at]

        if c == ',' {
            self.at += 1
            continue
        }

        if c == ']' {
            self.at += 1
            break
        }
        return Value.none, ParseErr.unexpected_token
    }
    count: usize = self.stack.len - base
    at: usize = self.iat

    for i: usize in 0 .. count { self.items[at + i] = self.stack.get(base + i) }
    self.iat = at + count
    mut self.stack.truncate(base)
    return Value.array(self.items[at..at + count]), null
}

mut Parser.parse_object(depth: usize): (Value, Error) {
    if depth >= MAX_DEPTH { return Value.none, ParseErr.depth }
    self.at += 1
    empty: mut []Pair = null
    base: usize = self.pstack.len
    mut self.skip_ws()

    if self.at < self.text.len && self.text[self.at] == '}' {
        self.at += 1
        return Value.object(empty), null
    }

    for {
        mut self.skip_ws()

        if self.at == self.text.len || self.text[self.at] != '"' { return Value.none, ParseErr.unexpected_token }
        key: string, kerr: Error = mut self.parse_string()
        if kerr != null { return Value.none, kerr }

        mut self.skip_ws()

        if self.at == self.text.len || self.text[self.at] != ':' { return Value.none, ParseErr.unexpected_token }
        self.at += 1
        mut self.skip_ws()
        elem: Value, verr: Error = mut self.parse_value(depth + 1)
        if verr != null { return Value.none, verr }

        push_err: Error = mut self.pstack.push(Pair {
            key = key,
            value = elem,
        })
        if push_err != null { return Value.none, ParseErr.allocation }

        mut self.skip_ws()

        if self.at == self.text.len { return Value.none, ParseErr.unexpected_token }
        c: u8 = self.text[self.at]

        if c == ',' {
            self.at += 1
            continue
        }

        if c == '}' {
            self.at += 1
            break
        }
        return Value.none, ParseErr.unexpected_token
    }
    count: usize = self.pstack.len - base
    at: usize = self.pat

    for i: usize in 0 .. count { self.pairs[at + i] = self.pstack.get(base + i) }
    self.pat = at + count
    mut self.pstack.truncate(base)
    return Value.object(self.pairs[at..at + count]), null
}

inline is_ws(c: u8): bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

inline is_digit(c: u8): bool {
    return c >= '0' && c <= '9'
}

hex_value(c: u8): (u32, bool) {
    if c >= '0' && c <= '9' { return u32(c - '0'), true }

    if c >= 'a' && c <= 'f' { return u32(c - 'a' + 10), true }

    if c >= 'A' && c <= 'F' { return u32(c - 'A' + 10), true }
    return 0, false
}

/* Scans from `start` (just past the opening quote) for the matching
 * unescaped closing quote. An escaped byte is always skipped as a pair, so a
 * "\u" sequence's hex digits are simply walked as ordinary bytes afterward;
 * escape *validity* is checked later, during decoding.
 */
find_string_end(text: string, start: usize): (usize, bool) {
    i: usize = start

    for i < text.len {
        c: u8 = text[i]

        if c == '"' { return i, true }

        if c == '\\' {
            i += 2
            continue
        }
        i += 1
    }
    return i, false
}

/* Decodes text[start..end] into buffer, which must be at least end - start
 * bytes (decoded output is never longer than its escaped source). Returns
 * the bytes written.
 */
decode_string(text: string, start: usize, end: usize, buffer: mut []u8): (usize, Error) {
    i: usize = start
    out: usize = 0

    for i < end {
        c: u8 = text[i]

        if c == '\\' {
            i += 1
            e: u8 = text[i]

            if e == '"' {
                buffer[out] = '"'
                out += 1
                i += 1
            } else if e == '\\' {
                buffer[out] = '\\'
                out += 1
                i += 1
            } else if e == '/' {
                buffer[out] = '/'
                out += 1
                i += 1
            } else if e == 'b' {
                buffer[out] = '\x08'
                out += 1
                i += 1
            } else if e == 'f' {
                buffer[out] = '\x0C'
                out += 1
                i += 1
            } else if e == 'n' {
                buffer[out] = '\n'
                out += 1
                i += 1
            } else if e == 'r' {
                buffer[out] = '\r'
                out += 1
                i += 1
            } else if e == 't' {
                buffer[out] = '\t'
                out += 1
                i += 1
            } else if e == 'u' {
                cp: u32, next: usize, err: Error = escape_codepoint(text, i + 1, end)
                if err != null { return 0, err }

                n: usize, fits: bool = utf8.encode(cp, mut buffer[out..])
                if !fits { return 0, ParseErr.invalid_escape }

                out += n
                i = next
            } else {
                return 0, ParseErr.invalid_escape
            }
            continue
        }

        if c < 32 { return 0, ParseErr.unexpected_token }
        buffer[out] = c
        out += 1
        i += 1
    }
    return out, null
}

/* Parses one \uXXXX escape at `pos`, combining a UTF-16 surrogate pair into
 * one codepoint when the first unit is a high surrogate. Returns the
 * codepoint and the position just past everything consumed.
 */
escape_codepoint(text: string, pos: usize, end: usize): (u32, usize, Error) {
    unit: u32, next: usize, err: Error = read_hex4(text, pos, end)
    if err != null { return 0, 0, err }
    if unit >= 0xD800 && unit <= 0xDBFF {
        if next + 2 > end || text[next] != '\\' || text[next + 1] != 'u' { return 0, 0, ParseErr.invalid_escape }
        low: u32, next2: usize, lerr: Error = read_hex4(text, next + 2, end)

        if lerr != null { return 0, 0, lerr }

        if low < 0xDC00 || low > 0xDFFF { return 0, 0, ParseErr.invalid_escape }
        cp: u32 = 0x10000 + (unit - 0xD800) * 0x400 + (low - 0xDC00)
        return cp, next2, null
    }
    if unit >= 0xDC00 && unit <= 0xDFFF { return 0, 0, ParseErr.invalid_escape }

    return unit, next, null
}

read_hex4(text: string, pos: usize, end: usize): (u32, usize, Error) {
    if pos + 4 > end { return 0, 0, ParseErr.invalid_escape }
    value: u32 = 0

    for i: usize in 0 .. 4 {
        d: u32, ok: bool = hex_value(text[pos + i])
        if !ok { return 0, 0, ParseErr.invalid_escape }

        value = value * 16 + d
    }
    return value, pos + 4, null
}
