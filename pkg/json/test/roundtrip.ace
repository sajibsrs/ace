import test
import json: "../mod.ace"

/* Parses a document, reads it, and formats it back. */
pub round_trip(t: *test.T) {
    doc: json.Json = json.Json.new()
    defer doc.wipe()
    err: Error = doc.parse(" {\"name\": \"ace\", \"tags\": [1, 2.5, true, null]} ")
    if err != null {
        t.fail("parse failed", @file, @line)
        return
    }

    switch doc.root {
        json.Value.object(pairs: []json.Pair) {
            if t.equal(pairs.len, 2, @file, @line) { t.equal(pairs[0].key, "name", @file, @line) }
        }
        default { t.fail("root: not an object", @file, @line) }
    }
    doc.value(doc.root)
    text: string, ferr: Error = doc.format()
    t.equal(ferr == null, true, @file, @line)
    t.equal(text, "{\"name\":\"ace\",\"tags\":[1,2.5,true,null]}", @file, @line)

    doc.reset()
    doc.value(doc.root)
    again: string, aerr: Error = doc.format()
    t.equal(aerr == null, true, @file, @line)
    t.equal(again, text, @file, @line)

    doc.value(doc.root)
    extra: string, xerr: Error = doc.format()
    t.equal(xerr == json.FormatErr.structure, true, @file, @line)
}

/* A failed parse returns the parse error and leaves `root` as `none`. */
pub failure(t: *test.T) {
    doc: json.Json = json.Json.new()
    defer doc.wipe()
    err: Error = doc.parse("[1, 2")
    t.equal(err == json.ParseErr.unexpected_token, true, @file, @line)

    switch doc.root {
        json.Value.none {}
        default { t.fail("root: not none", @file, @line) }
    }
}

/* A root assigned by hand writes like a parsed one. */
pub assigned(t: *test.T) {
    doc: json.Json = json.Json.new()
    defer doc.wipe()
    err: Error = doc.parse("0")
    t.equal(err == null, true, @file, @line)

    doc.root = json.Value.string("a\"b")
    doc.value(doc.root)
    text: string, ferr: Error = doc.format()
    t.equal(ferr == null, true, @file, @line)
    t.equal(text, "\"a\\\"b\"", @file, @line)
}

/* One `Json` parses document after document, each replacing the last, and a
 * failure in between leaves the next parse unaffected.
 */
pub reuse(t: *test.T) {
    doc: json.Json = json.Json.new()
    defer doc.wipe()
    texts: [4]string = ["{\"id\": \"a\"}", "{\"id\": \"bb\", \"pad\": [1, 2, 3, 4, 5, 6, 7, 8]}", "{\"id\"", "{\"id\": \"c\"}"]
    want: [4]string = ["a", "bb", null, "c"]

    for i: usize in 0 .. texts.len {
        err: Error = doc.parse(texts[i])
        t.equal(err == null, want[i] != null, @file, @line)

        if want[i] != null { t.equal(doc.string("/id"), want[i], @file, @line) }
    }
}

/* A new document writes through the forwarded calls, never its empty root. */
pub written(t: *test.T) {
    doc: json.Json = json.Json.new()
    defer doc.wipe()
    empty: string, eerr: Error = doc.format()
    t.equal(eerr == json.FormatErr.structure, true, @file, @line)

    doc.object()
    doc.field("s", "x")
    doc.field("i", -1)
    doc.field("u", uint(2))
    doc.field("z", usize(3))
    doc.field("f", 0.5)
    doc.field("b", true)
    doc.field("t", json.Value.none)
    doc.key("a")
    doc.array()
    doc.none()
    doc.value(false)
    doc.value(4)
    doc.value(uint(5))
    doc.value(usize(6))
    doc.value(1.5)
    doc.value("y")
    doc.value(json.Value.number(7.0))
    doc.end()
    doc.end()
    text: string, err: Error = doc.format()
    t.equal(err == null, true, @file, @line)
    t.equal(text, "{\"s\":\"x\",\"i\":-1,\"u\":2,\"z\":3,\"f\":0.5,\"b\":true,\"t\":null,\"a\":[null,false,4,5,6,1.5,\"y\",7]}", @file, @line)
}
