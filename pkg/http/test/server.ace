import mem
import str
import test
import http: "../mod.ace"

/* Feeds `text` to `connection` as if received from a socket. */
feed(connection: *http.ServerConnection, text: string) {
    at: usize = 0
    for at < text.len {
        room: []u8 = connection.room()
        count: usize = text.len - at
        if count > room.len { count = room.len }
        mem.copy(room[..count], text[at .. at + count])
        connection.received(count)
        at += count
    }
}

/* Answers the next request with `response`; returns the bytes and whether a
 * request was ready, marking the whole response sent.
 */
answer(connection: *http.ServerConnection, response: http.Response, out: []u8): (string, bool) {
    switch connection.next() {
        http.ServerStep.request(request: http.Request) {
            if connection.respond(request, response) != null { return "", false }

            output: []u8 = connection.output()
            mem.copy(out[..output.len], output)
            count: usize = output.len
            connection.sent(1)
            connection.sent(count - 1)
            return out[..count], true
        }
        default {
            return "", false
        }
    }
}

has(text: string, part: string): bool {
    _, found: bool = str.find(text, part)
    return found
}

version_of(text: string): (u8, bool) {
    connection: http.ServerConnection = http.ServerConnection.new(4096)
    defer connection.wipe()
    feed(&connection, text)
    switch connection.next() {
        http.ServerStep.request(request: http.Request) {
            return request.version_minor, request.keep_alive()
        }
        default {
            return u8(9), false
        }
    }
}

/* Checks the version and keep-alive of the request `text` holds. */
versions_of(t: *test.T, text: string, minor: int, keep: bool, file: string, line: int) {
    got: u8, alive: bool = version_of(text)
    if minor >= 0 { t.equal(int(got), minor, file, line) }
    t.equal(alive, keep, file, line)
}

pub versions(t: *test.T) {
    versions_of(t, "GET / HTTP/1.1\r\n\r\n", 1, true, @file, @line)
    versions_of(t, "GET / HTTP/1.0\r\n\r\n", 0, false, @file, @line)
    versions_of(t, "GET / HTTP/1.0\r\nConnection: Keep-Alive\r\n\r\n", 0, true, @file, @line)
    versions_of(t, "GET / HTTP/1.1\r\nConnection: foo, CLOSE\r\n\r\n", 1, false, @file, @line)
    versions_of(t, "GET / HTTP/1.1\r\nConnection: keep-alive\r\nConnection: close\r\n\r\n", -1, false, @file, @line)
    versions_of(t, "\r\nGET / HTTP/1.1\r\n\r\n", 1, true, @file, @line)
}

/* Pipelined requests, then a split one continuing the leftover. */
pub pipelining(t: *test.T) {
    storage: [512]u8 = [u8(0) : 512]
    hello: http.Response = http.Response { body = "hello" }
    pipe: http.ServerConnection = http.ServerConnection.new(4096)
    defer pipe.wipe()
    feed(&pipe, "GET /a HTTP/1.1\r\n\r\nPOST /b HTTP/1.1\r\nContent-Length: 2\r\n\r\nhiGET /c")
    text: string, ok: bool = answer(&pipe, hello, storage[..])
    t.equal(ok, true, @file, @line)
    t.equal(has(text, "Content-Length: 5\r\n"), true, @file, @line)
    t.equal(has(text, "\r\n\r\nhello"), true, @file, @line)
    t.equal(has(text, "Connection"), false, @file, @line)
    t.equal(pipe.persistent(), true, @file, @line)
    t.equal(pipe.idle(), false, @file, @line)

    text, ok = answer(&pipe, hello, storage[..])
    t.equal(ok, true, @file, @line)

    switch pipe.next() {
        http.ServerStep.need_input {}
        default { t.fail("not need_input", @file, @line) }
    }
    feed(&pipe, " HTTP/1.1\r\nConnection: close\r\n\r\n")
    text, ok = answer(&pipe, hello, storage[..])
    t.equal(ok, true, @file, @line)
    t.equal(has(text, "Connection: close\r\n"), true, @file, @line)
    t.equal(pipe.persistent(), false, @file, @line)
}

/* HEAD keeps the length and drops the body; 204 has neither. */
pub bodiless(t: *test.T) {
    storage: [512]u8 = [u8(0) : 512]
    hello: http.Response = http.Response { body = "hello" }
    head: http.ServerConnection = http.ServerConnection.new(4096)
    defer head.wipe()
    feed(&head, "HEAD / HTTP/1.1\r\n\r\nGET / HTTP/1.1\r\n\r\n")
    text: string, ok: bool = answer(&head, hello, storage[..])
    t.equal(ok, true, @file, @line)
    t.equal(has(text, "Content-Length: 5\r\n"), true, @file, @line)
    t.equal(has(text, "hello"), false, @file, @line)

    text, ok = answer(&head, http.Response { status = 204, body = "x" }, storage[..])
    t.equal(ok, true, @file, @line)
    t.equal(has(text, "Content-Length"), false, @file, @line)
    t.equal(head.idle(), true, @file, @line)
}

/* HTTP/1.0 keep-alive is confirmed; a handler's close wins over it. */
pub keep_alive(t: *test.T) {
    storage: [512]u8 = [u8(0) : 512]
    hello: http.Response = http.Response { body = "hello" }
    old: http.ServerConnection = http.ServerConnection.new(4096)
    defer old.wipe()
    feed(&old, "GET / HTTP/1.0\r\nConnection: keep-alive\r\n\r\n")
    text: string, ok: bool = answer(&old, hello, storage[..])
    t.equal(ok, true, @file, @line)
    t.equal(has(text, "Connection: keep-alive\r\n"), true, @file, @line)

    fields: [1]http.Header = [http.Header { name = "connection", value = "close" }]
    feed(&old, "GET / HTTP/1.1\r\n\r\n")
    text, ok = answer(&old, http.Response { headers = fields[..] }, storage[..])
    t.equal(ok, true, @file, @line)
    t.equal(has(text, "Connection: close\r\n"), true, @file, @line)
    t.equal(old.persistent(), false, @file, @line)
}

/* A handler's Transfer-Encoding is refused. */
pub refused(t: *test.T) {
    refused: http.ServerConnection = http.ServerConnection.new(4096)
    defer refused.wipe()
    feed(&refused, "GET / HTTP/1.1\r\n\r\n")
    fields: [1]http.Header = [http.Header { name = "Transfer-Encoding", value = "chunked" }]

    switch refused.next() {
        http.ServerStep.request(request: http.Request) {
            err: Error = refused.respond(request, http.Response { headers = fields[..] })
            t.equal(err == http.ServerErr.framing, true, @file, @line)
        }
        default { t.fail("no request", @file, @line) }
    }
}

/* The interim response comes once, before the body, and keeps state. */
pub expect_continue(t: *test.T) {
    storage: [512]u8 = [u8(0) : 512]
    hello: http.Response = http.Response { body = "hello" }
    expect: http.ServerConnection = http.ServerConnection.new(4096)
    defer expect.wipe()
    feed(&expect, "POST / HTTP/1.1\r\nContent-Length: 2\r\nExpect: 100-continue\r\n\r\n")

    switch expect.next() {
        http.ServerStep.send {}
        default { t.fail("not send", @file, @line) }
    }
    t.equal(string(expect.output()), "HTTP/1.1 100 Continue\r\n\r\n", @file, @line)

    expect.sent(expect.output().len)
    switch expect.next() {
        http.ServerStep.need_input {}
        default { t.fail("not need_input", @file, @line) }
    }
    feed(&expect, "hi")
    text: string, ok: bool = answer(&expect, hello, storage[..])
    t.equal(ok, true, @file, @line)
    t.equal(has(text, "200 OK"), true, @file, @line)
    t.equal(expect.persistent(), true, @file, @line)
}

/* `limit` bounds a request: the room runs out. */
pub limit(t: *test.T) {
    small: http.ServerConnection = http.ServerConnection.new(8)
    defer small.wipe()
    room: []u8 = small.room()

    for room != null {
        small.received(room.len)
        room = small.room()
    }
}
