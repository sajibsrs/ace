import test
import http: "../mod.ace"

/* http is plaintext-only: an https:// scheme is rejected with UrlErr, and a
 * DNS or connect failure surfaces as an error, not a fabricated response.
 */
pub plaintext_only(t: *test.T) {
    context: http.ClientContext = http.ClientContext.new()
    defer context.wipe()
    mismatch: http.Response, mismatch_err: Error = http.get("https://example.com/", &context)
    t.equal(mismatch_err != null && mismatch_err.domain == typeid(http.UrlErr), true, @file, @line)

    response: http.Response, err: Error = http.get("http://nonexistent.invalid/", &context)
    t.equal(err != null, true, @file, @line)
}
