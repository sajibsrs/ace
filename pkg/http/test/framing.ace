import test
import http: "../mod.ace"

new_state(): http.ResponseParser {
    return http.ResponseParser {
        input_offset = usize(0),
        line_start = usize(0),
        scan_offset = usize(0),
        line_stop = usize(0),
        line_next = usize(0),
        line_ready = false,
        header_count = usize(0),
        body_count = usize(0),
        content_length = usize(0),
        chunk_remaining = usize(0),
        version_minor = u8(0),
        status = u16(0),
        reason_start = usize(0),
        reason_count = usize(0),
        phase = http.ResponsePhase.status,
        framing = http.ResponseFraming.undecided,
        informational_count = usize(0),
    }
}

pub fragmented_length(t: *test.T) {
    state: http.ResponseParser = new_state()
    headers: [2]http.Header
    body: [8]u8 = [0 : 8]
    result: http.ResponseResult = state.parse(
        "HTTP/1.1 200 OK\r\nContent-L",
        headers[..],
        body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.progress(value: http.ResponseProgress) {
            t.equal(value.body_written, 0, @file, @line)
        }
        default { t.fail("unexpected result", @file, @line) }
    }
    result = state.parse(
        "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\na\u{E9}b",
        headers[..],
        body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.complete(response: http.Response) {
            t.equal(int(response.status), 200, @file, @line)
            t.equal(response.body, "a\u{E9}b", @file, @line)
        }
        default { t.fail("unexpected result", @file, @line) }
    }
}

pub chunked(t: *test.T) {
    state: http.ResponseParser = new_state()
    headers: [3]http.Header
    body: [16]u8 = [0 : 16]
    message: string = "HTTP/1.1 200 OK\r\nTransfer-Encoding: Chunked\r\n\r\n3;foo=bar\r\nabc\r\n2\r\nde\r\n0\r\nX-End: yes\r\n\r\n"
    result: http.ResponseResult = state.parse(message, headers[..], body[..], false, false)
    switch result {
        http.ResponseResult.complete(response: http.Response) {
            t.equal(response.body, "abcde", @file, @line)
        }
        default { t.fail("unexpected result", @file, @line) }
    }
}

pub informational_and_none(t: *test.T) {
    state: http.ResponseParser = new_state()
    headers: [2]http.Header
    body: [1]u8 = [0]
    message: string = "HTTP/1.1 103 Early Hints\r\nLink: </x>\r\n\r\nHTTP/1.1 304 Not Modified\r\nContent-Length: 99\r\n\r\n"
    result: http.ResponseResult = state.parse(message, headers[..], body[..], false, false)
    switch result {
        http.ResponseResult.complete(response: http.Response) {
            t.equal(int(response.status), 304, @file, @line)
            t.equal(response.body.len, 0, @file, @line)
            t.equal(state.informational_count, 1, @file, @line)
            t.equal(response.headers.len, 1, @file, @line)
        }
        default { t.fail("unexpected result", @file, @line) }
    }
}

pub close_body(t: *test.T) {
    state: http.ResponseParser = new_state()
    headers: [1]http.Header
    body: [8]u8 = [0 : 8]
    message: string = "HTTP/1.0 200 OK\r\n\r\nbye"
    result: http.ResponseResult = state.parse(message, headers[..], body[..], true, false)
    t.equal(state.body_count, 3, @file, @line)
    t.equal(string(body[..3]), "bye", @file, @line)
    switch result {
        http.ResponseResult.complete(response: http.Response) {
            t.equal(int(response.status), 200, @file, @line)
            t.equal(response.body, "bye", @file, @line)

            /* The response body is a view of the caller's storage. */
            body[0] = 120
            t.equal(int(response.body[0]), 120, @file, @line)
        }
        default { t.fail("unexpected result", @file, @line) }
    }
}

pub failures(t: *test.T) {
    state: http.ResponseParser = new_state()
    one_header: [2]http.Header
    no_headers: []http.Header = one_header[..0]
    body: [2]u8 = [0, 0]
    result: http.ResponseResult = state.parse(
        "HTTP/1.1 200 OK\r\nA: b\r\n\r\n",
        no_headers,
        body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.capacity(capacity_type: http.ResponseCapacity) {
            test.equal[http.ResponseCapacity](t, capacity_type, http.ResponseCapacity.headers, @file, @line)
        }
        default { t.fail("unexpected result", @file, @line) }
    }
    state = new_state()
    result = state.parse(
        "HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\nabc",
        one_header[..],
        body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.capacity(capacity_type: http.ResponseCapacity) {
            test.equal[http.ResponseCapacity](t, capacity_type, http.ResponseCapacity.body, @file, @line)
        }
        default { t.fail("unexpected result", @file, @line) }
    }
    state = new_state()
    result = state.parse(
        "HTTP/1.1 200 OK\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\nx",
        one_header[..],
        body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.framing {}
        default { t.fail("unexpected result", @file, @line) }
    }
    state = new_state()
    result = state.parse(
        "HTTP/1.1 200 OK\r\nContent-Length: 1\r\nTransfer-Encoding: chunked\r\n\r\n",
        one_header[..],
        body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.framing {}
        default { t.fail("unexpected result", @file, @line) }
    }
    state = new_state()
    result = state.parse("HTTP/1.1 xxx Bad\r\n\r\n", one_header[..], body[..], false, false)
    switch result {
        http.ResponseResult.syntax {}
        default { t.fail("unexpected result", @file, @line) }
    }
    state = new_state()
    result = state.parse(
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nz\r\n",
        one_header[..],
        body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.syntax {}
        default { t.fail("unexpected result", @file, @line) }
    }
    state = new_state()
    result = state.parse(
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n",
        one_header[..],
        body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.capacity(capacity_type: http.ResponseCapacity) {
            test.equal[http.ResponseCapacity](t, capacity_type, http.ResponseCapacity.body, @file, @line)
        }
        default { t.fail("unexpected result", @file, @line) }
    }
    state = new_state()
    result = state.parse("HTTP/1.1 101 Switching Protocols\r\n\r\n", one_header[..], body[..], false, false)
    switch result {
        http.ResponseResult.framing {}
        default { t.fail("unexpected result", @file, @line) }
    }
    state = new_state()
    result = state.parse(
        "HTTP/1.1 200 OK\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\nx",
        one_header[..1],
        body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.framing {}
        default { t.fail("unexpected result", @file, @line) }
    }
    state = new_state()
    result = state.parse(
        "HTTP/1.1 200 OK\r\nContent-Length: 1\r\nTransfer-Encoding: chunked\r\n\r\n",
        one_header[..1],
        body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.framing {}
        default { t.fail("unexpected result", @file, @line) }
    }
    state = new_state()
    result = state.parse(
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n",
        no_headers,
        body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.capacity(capacity_type: http.ResponseCapacity) {
            test.equal[http.ResponseCapacity](t, capacity_type, http.ResponseCapacity.headers, @file, @line)
        }
        default { t.fail("unexpected result", @file, @line) }
    }
    result = state.parse(
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n",
        one_header[..],
        body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.complete(response: http.Response) {}
        default { t.fail("unexpected result", @file, @line) }
    }
}

