/* Blocking, single-connection-at-a-time HTTP/1.1 server core. */

import ascii
import mem
import net
import sys
import net/tcp
import message: "./message.ace"
import parsing: "./parsing.ace"
import routing: "./router.ace"

ServerErr: error {
    1: capacity = "malformed or unresolvable endpoint",
}

Header: type = message.Header
Request: type = message.Request
Response: type = message.Response
FormatErr: type = message.FormatErr
Router: type = routing.Router
RequestParser: type = parsing.RequestParser
RequestPhase: type = parsing.RequestPhase
RequestFraming: type = parsing.RequestFraming
RequestCapacity: type = parsing.RequestCapacity
RequestResult: type = parsing.RequestResult
RequestProgress: type = parsing.RequestProgress

/* Owns the buffers a `serve` loop reads requests into and writes responses
 * from, growing each one via `mem.grow` as connections demand, plus the
 * listen backlog `serve` binds with. Buffers start empty; there is no size
 * cap.
 */
pub Context: struct {
    input: []u8 = null,
    headers: []Header = null,
    body: []u8 = null,
    output: []u8 = null,
    backlog: usize = 512,
}

pub Context.new(): Context {
    return Context {}
}

/* Releases buffer storage. Call once the context is no longer served. */
pub Context.wipe(self) {
    mem.release[u8](&self.input)
    mem.release[Header](&self.headers)
    mem.release[u8](&self.body)
    mem.release[u8](&self.output)
}

/* Reads exactly one complete request from `conn` into `context`, growing its
 * `input`/`headers`/`body` buffers via `mem.grow` as the request demands.
 * The second result is false on EOF, mid-read disconnect, allocation
 * failure, or parse failure — in every such case the caller responds to
 * nothing and just returns.
 */
read_request(conn: tcp.Conn, context: *Context): (Request, bool) {
    parser: RequestParser = RequestParser {
        phase = RequestPhase.request,
        framing = RequestFraming.undecided,
    }
    occupied: usize = 0
    parse_pending: bool = false

    for {
        if !parse_pending {
            if occupied == context.input.len {
                grown: []u8, ok: bool = mem.grow[u8](context.input, context.input.len + 1)
                if !ok { return blank(Request), false }

                context.input = grown

                /* Header and target views point into input. Reparse the
                 * retained bytes after a moving reallocation before
                 * exposing any views. */
                parser = RequestParser {
                    phase = RequestPhase.request,
                    framing = RequestFraming.undecided,
                }
            }

            received: int, recv_err: Error = tcp.receive(conn, context.input[occupied..])
            if recv_err != null {
                if recv_err.domain == typeid(net.ReceiveErr) && recv_err.code == sys.EINTR { continue }
                return blank(Request), false
            }
            if received == 0 { return blank(Request), false }

            occupied += usize(received)
        }
        parse_pending = false

        result: RequestResult = parser.parse(
            context.input[..occupied],
            context.headers[..],
            context.body[..],
            false,
        )
        switch result {
            RequestResult.complete(request: Request) {
                return request, true
            }
            RequestResult.progress(value: RequestProgress) {}
            RequestResult.capacity(capacity_type: RequestCapacity) {
                if capacity_type == RequestCapacity.headers {
                    grown: []Header, ok: bool = mem.grow[Header](context.headers, context.headers.len + 1)
                    if !ok { return blank(Request), false }

                    context.headers = grown
                } else {
                    needed: usize = parser.body_count + (occupied - parser.input_offset)
                    if parser.framing == RequestFraming.content_length {
                        needed = parser.content_length
                    } else if parser.framing == RequestFraming.chunked {
                        needed = parser.body_count + parser.chunk_remaining
                    }
                    grown: []u8, ok: bool = mem.grow[u8](context.body, needed)
                    if !ok { return blank(Request), false }

                    context.body = grown
                }
                parse_pending = true
            }
            default {
                return blank(Request), false
            }
        }
    }
}

/* Writes `response` with a synthesized `Connection: close` (a handler-
 * supplied one is dropped along with the connection either way), growing
 * `context.headers`/`context.output` via `mem.grow` as needed. A format
 * failure other than a capacity shortfall just skips the write; the caller
 * closes the connection regardless.
 */
respond_close(conn: tcp.Conn, response: Response, context: *Context) {
    for i: usize in 0 .. response.headers.len {
        if ascii.equal(response.headers[i].name, "connection", false) { return }
    }
    needed: usize = response.headers.len + 1
    if needed > context.headers.len {
        grown: []Header, ok: bool = mem.grow[Header](context.headers, needed)
        if !ok { return }

        context.headers = grown
    }
    mem.copy[Header](context.headers[0 .. response.headers.len], response.headers)
    context.headers[response.headers.len] = Header {
        name = "Connection",
        value = "close",
    }
    outgoing: Response = Response {
        version_minor = response.version_minor,
        status = response.status,
        reason = response.reason,
        headers = context.headers[..needed],
        body = response.body,
    }
    count: usize, format_err: Error = outgoing.format(context.output[..])
    for format_err == FormatErr.capacity {
        grown: []u8, ok: bool = mem.grow[u8](context.output, context.output.len + 1)
        if !ok { return }

        context.output = grown
        count, format_err = outgoing.format(context.output[..])
    }
    if format_err == null { tcp.send_all(conn, context.output[..count]) }
}

/* Accepts one connection from `listener`, reads exactly one request from it,
 * writes `router`'s response, and closes it. An accept failure just returns.
 */
serve_one(listener: tcp.Listener, router: Router, context: *Context) {
    conn: tcp.Conn, _, accept_err: Error = tcp.accept(listener)
    defer tcp.close(&conn)
    if accept_err != null { return }

    request: Request, ok: bool = read_request(conn, context)
    if !ok { return }

    respond_close(conn, router.dispatch(request), context)
}

/* Resolves and binds `endpoint` with the given listen backlog, ready for a
 * caller's `tcp.accept` loop.
 */
listen_endpoint(endpoint: string, backlog: usize): (tcp.Listener, Error) {
    address: net.Addr4, parsed: bool = net.parse4(endpoint)
    if !parsed { return tcp.Listener {}, ServerErr.capacity }

    listener: tcp.Listener, listen_err: Error = tcp.listen(address, backlog)
    return listener, listen_err
}

/* Blocking, single-connection-at-a-time HTTP/1.1 server: binds `endpoint`
 * with `context.backlog`, then serves it as `serve(listener, context, router)`
 * does. Returns only if the listener itself cannot be created.
 */
pub serve(endpoint: string, context: *Context, router: Router): Error {
    listener: tcp.Listener, listen_err: Error = listen_endpoint(endpoint, context.backlog)
    defer tcp.close(&listener)
    if listen_err != null { return listen_err }

    serve(listener, context, router)
    return null
}

/* Serves an already bound `listener` forever: accepts one connection, reads
 * exactly one request, dispatches it through `router`, writes the response,
 * and closes the connection, with no poll queue and no session table.
 * `context` owns the buffers used across every connection, growing them via
 * `mem.grow`; a per-connection failure just drops that connection. The
 * caller owns `listener`. Several threads may serve one listener, each with
 * its own `context`: the kernel hands each connection to one `accept`.
 */
pub serve(listener: tcp.Listener, context: *Context, router: Router) {
    for { serve_one(listener, router, context) }
}
