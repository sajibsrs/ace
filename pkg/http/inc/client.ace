/* Owning plaintext HTTP clients. */

import mem
import net
import message: "./message.ace"
import parsing: "./parsing.ace"
import redirection: "./redirection.ace"
import transport: "./transport.ace"

pub Response: type = message.Response
pub Storage: type = transport.Storage
pub ClientErr: type = transport.ClientErr
pub RedirectErr: type = redirection.RedirectErr
pub RedirectPolicy: type = redirection.RedirectPolicy
pub Url: type = parsing.Url
pub UrlErr: type = parsing.UrlErr

pub Context: struct {
    pub storage: []Storage,
    pub redirects: RedirectPolicy,
}

pub Context.new(): Context {
    storage: []Storage = mem.alloc[Storage](1)
    if storage == null {
        return Context {
            storage = null,
            redirects = RedirectPolicy {},
        }
    }

    storage[0] = Storage {
        addresses = null,
        output = null,
        target = null,
        input = null,
        headers = null,
        body = null,
        url = null,
    }
    return Context {
        storage = storage,
        redirects = RedirectPolicy {},
    }
}

pub Context.wipe(self) {
    if self.storage == null { return }
    mem.release[net.Addr4](&self.storage[0].addresses)
    mem.release[u8](&self.storage[0].output)
    mem.release[u8](&self.storage[0].target)
    mem.release[u8](&self.storage[0].input)
    mem.release[message.Header](&self.storage[0].headers)
    mem.release[u8](&self.storage[0].body)
    mem.release[u8](&self.storage[0].url)
    mem.release[Storage](&self.storage)
    self.redirects = RedirectPolicy {}
}

RedirectState: struct {
    current_count: usize,
    followed: usize,
}

redirect_start(url: string, storage: *Storage): (RedirectState, Error) {
    mem_url: []u8, url_ok: bool = mem.grow[u8](storage.url, url.len)
    if !url_ok {
        state: RedirectState = RedirectState {
            current_count = 0,
            followed = 0,
        }
        return state, ClientErr.allocation
    }

    storage.url = mem_url
    mem.copy(storage.url[..url.len], url)
    state: RedirectState = RedirectState {
        current_count = url.len,
        followed = 0,
    }
    return state, null
}

redirect_next(
    response: Response,
    policy: RedirectPolicy,
    state: *RedirectState,
    storage: *Storage,
): (bool, Error) {
    if !redirection.redirects(response.status) { return false, null }
    location: string = redirection.location(response)
    if location == null || location.len == 0 { return false, null }

    needed: usize = state.current_count * 2
    if needed < state.current_count { return false, ClientErr.allocation }
    with_location: usize = needed + location.len
    if with_location < needed { return false, ClientErr.allocation }
    needed = with_location + 32
    if needed < with_location { return false, ClientErr.allocation }
    larger: []u8, larger_ok: bool = mem.grow[u8](storage.url, needed)
    if !larger_ok { return false, ClientErr.allocation }

    storage.url = larger
    shifted_at: usize = storage.url.len - state.current_count
    for i: usize in 0 .. state.current_count {
        source_at: usize = state.current_count - 1 - i
        storage.url[shifted_at + source_at] = storage.url[source_at]
    }
    previous: string = storage.url[shifted_at..]
    next_count: usize, valid: bool = redirection.resolve(previous, location, storage.url[..shifted_at])
    if !valid { return false, null }

    next_secure: bool = next_count >= 8 && mem.equal(storage.url[..8], "https://")
    if next_secure { return false, UrlErr.invalid }
    if state.followed == policy.limit { return false, RedirectErr.limit }
    state.followed += 1
    state.current_count = next_count
    return true, null
}

get_redirecting(url: string, policy: RedirectPolicy, context: *Context): (Response, Error) {
    state: RedirectState, start_err: Error = redirect_start(url, &context.storage[0])
    if start_err != null { return Response {}, start_err }

    for {
        response: Response, err: Error = transport.get(
            context.storage[0].url[..state.current_count],
            &context.storage[0],
            true,
        )
        if err != null { return Response {}, err }
        follow: bool
        follow, err = redirect_next(response, policy, &state, &context.storage[0])
        if err != null { return Response {}, err }
        if !follow { return response, null }
    }
}

pub get(url: string, context: *Context): (Response, Error) {
    if context.storage == null { return Response {}, ClientErr.allocation }
    _, url_err: Error = parsing.Url.parse(url)
    if url_err != null { return Response {}, url_err }

    if context.redirects.limit == 0 {
        response: Response, err: Error = transport.get(url, &context.storage[0], true)
        return response, err
    }
    response: Response, err: Error = get_redirecting(url, context.redirects, context)
    return response, err
}
