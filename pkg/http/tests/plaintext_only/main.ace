// http is plaintext-only: an https:// scheme must be rejected with
// UrlErr.invalid, and a DNS/connect failure must surface as an error rather
// than a fabricated response. (Formerly named for isolating http's linked
// object from the removed @extern(component)/TLS mechanism, back when that
// mechanism existed; the behavior it actually exercises is the scheme
// rejection and failure-propagation checked below.)

import http

main(): int {
    context: http.ClientContext = http.client_context_new()
    mismatch: http.Response, mismatch_err: Error = http.get(
        "https://example.com/", mut context)
    if mismatch_err == null || mismatch_err.domain != typeid(http.UrlErr) {
        return int(mismatch.status) + 1
    }
    response: http.Response, err: Error = http.get(
        "http://nonexistent.invalid/", mut context)
    if err == null { return int(response.status) }
    http.client_context_wipe(mut context)
    return 0
}
