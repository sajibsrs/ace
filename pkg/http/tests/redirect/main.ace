import http
import mem
import net
import str
import sys
import net/tcp

loopback(port: u16): net.Addr4 {
    return net.Addr4 {ip = [127, 0, 0, 1], port = port}
}

read_request(connection: tcp.Conn, expected: string): Error {
    bytes: [512]u8 = [0 : 512]
    occupied: usize = 0
    for {
        count: int, err: Error = net.receive(connection.socket, mut bytes[occupied..])
        if err != null { return err }
        if count == 0 { return http.ClientErr.response }
        occupied += usize(count)
        if str.has(bytes[..occupied], "\r\n\r\n") { break }
        if occupied == bytes.len { return http.ClientErr.response }
    }
    first_end: usize = 0
    for i: usize in 0 .. occupied {
        if bytes[i] == 13 {
            first_end = i
            break
        }
    }
    prefix: [3]string = ["GET ", expected, " HTTP/1.1"]
    line: [256]u8 = [0 : 256]
    line_count: usize, fit: bool = str.concat(prefix[..], mut line[..])
    if !fit || !mem.equal(bytes[..first_end], line[..line_count]) {
        return http.ClientErr.response
    }
    return null
}

serve(listener: tcp.Listener, expected: string, response: string): Error {
    connection: tcp.Conn, _: net.Addr4, err: Error = tcp.accept(listener)
    if err != null { return err }
    err = read_request(connection, expected)
    if err == null {
        sent: usize
        sent, err = tcp.send_all(connection, response)
    }
    close_err: Error = tcp.close(mut connection)
    if err != null { return err }
    return close_err
}

client(port: u16): int {
    port_bytes: [8]u8 = [0 : 8]
    port_count: usize, ok: bool = str.format(mut port_bytes[..], uint(port))
    if !ok { return 1 }
    parts: [3]string = ["http://127.0.0.1:", port_bytes[..port_count], "/a/b/start"]
    url_bytes: [96]u8 = [0 : 96]
    url_count: usize
    url_count, ok = str.concat(parts[..], mut url_bytes[..])
    if !ok { return 2 }
    context: http.ClientContext = http.client_context_new()
    defer http.client_context_wipe(mut context)
    context.redirects = http.RedirectPolicy {limit = 10}
    response: http.Response, err: Error = http.get(
        url_bytes[..url_count], mut context)
    result: int = 0
    if err != null || response.status != 200 || !mem.equal(response.body, "done") {
        result = 3
    }
    return result
}

main(): int {
    listener: tcp.Listener, err: Error = tcp.listen(loopback(u16(0)), usize(8))
    defer tcp.close(mut listener)
    if err != null { return 10 }
    address: net.Addr4
    address, err = tcp.local(listener)
    if err != null { return 11 }

    process: sys.Process, fork_err: Error = sys.fork()
    if fork_err != null || process == -1 { return 12 }
    if process == 0 {
        tcp.close(mut listener)
        sys.exit(client(address.port))
    }

    port_bytes: [8]u8 = [0 : 8]
    port_count: usize, ok: bool = str.format(mut port_bytes[..], uint(address.port))
    location_parts: [3]string = [
        "Location: //127.0.0.1:",
        port_bytes[..port_count],
        "/scheme\r\n",
    ]
    scheme_response: [160]u8 = [0 : 160]
    scheme_prefix: string = "HTTP/1.1 307 Temporary Redirect\r\n"
    at: usize = scheme_prefix.len
    mem.copy(mut scheme_response[..at], scheme_prefix)
    location_count: usize
    location_count, ok = str.concat(location_parts[..], mut scheme_response[at..])
    if !ok { return 13 }
    at += location_count
    mem.copy(mut scheme_response[at..at + 21], "Content-Length: 0\r\n\r\n")
    at += 21

    absolute_parts: [3]string = [
        "HTTP/1.1 308 Permanent Redirect\r\nLocation: http://127.0.0.1:",
        port_bytes[..port_count],
        "/final\r\nContent-Length: 0\r\n\r\n",
    ]
    absolute_response: [192]u8 = [0 : 192]
    absolute_count: usize
    absolute_count, ok = str.concat(absolute_parts[..], mut absolute_response[..])
    if !ok { return 14 }

    err = serve(listener, "/a/b/start", "HTTP/1.1 301 Moved Permanently\r\nLocation: next\r\nContent-Length: 0\r\n\r\n")
    if err == null { err = serve(listener, "/a/b/next", "HTTP/1.1 302 Found\r\nLocation: ?q=1\r\nContent-Length: 0\r\n\r\n") }
    if err == null { err = serve(listener, "/a/b/next?q=1", "HTTP/1.1 303 See Other\r\nLocation: /root\r\nContent-Length: 0\r\n\r\n") }
    if err == null { err = serve(listener, "/root", scheme_response[..at]) }
    if err == null { err = serve(listener, "/scheme", absolute_response[..absolute_count]) }
    if err == null { err = serve(listener, "/final", "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\ndone") }

    status: sys.ProcessStatus, wait_err: Error = sys.wait(process)
    if err != null || wait_err != null || !status.exited || status.code != 0 { return 15 }
    return 0
}
