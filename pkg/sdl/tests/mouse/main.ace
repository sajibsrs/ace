/* Headless round trip: a mouse-button and a mouse-motion event are pushed
 * onto SDL's queue and polled back, proving SDL and Ace agree on their
 * layouts.
 */

import sdl

extern "c" {
    push_event(event: mut *sdl.Event): bool as "SDL_PushEvent"
}

main(): int {
    if !sdl.init(sdl.InitFlags { events = 1 }) { return 1 }
    defer sdl.quit()

    click: sdl.Event
    click.padding = [0 : 128]
    click.button.type = sdl.EventType.mouse_button_down
    click.button.window_id = 7
    click.button.button = sdl.MouseButton.right
    click.button.down = true
    click.button.clicks = 2
    click.button.x = 12.5
    click.button.y = 40.0
    if !push_event(mut &click) { return 2 }

    move: sdl.Event
    move.padding = [0 : 128]
    move.motion.type = sdl.EventType.mouse_motion
    move.motion.window_id = 7
    move.motion.state = sdl.MouseButtons { left = 1, right = 1 }
    move.motion.x = 3.0
    move.motion.y = 4.0
    move.motion.xrel = -1.5
    move.motion.yrel = 2.0
    if !push_event(mut &move) { return 2 }

    seen: int = 0
    got: sdl.Event
    for mut got.poll() {
        b: sdl.MouseButtonEvent, is_button: bool = got.mouse_button()
        m: sdl.MouseMotionEvent, is_motion: bool = got.mouse_motion()
        if is_button && is_motion { return 3 }
        if is_button {
            if b.button != sdl.MouseButton.right || !b.down || b.clicks != 2 { return 4 }
            if b.x != 12.5 || b.y != 40.0 || b.window_id != 7 { return 5 }
            seen += 1
        } else if is_motion {
            held: sdl.MouseButtons = m.state
            if held.left != 1 || held.middle != 0 || held.right != 1 { return 6 }
            if m.x != 3.0 || m.y != 4.0 || m.xrel != -1.5 || m.yrel != 2.0 { return 7 }
            seen += 1
        }
    }
    if seen != 2 { return 8 }
    return 0
}
