/* Headless shader contract: a renderer named by its driver that is not on
 * the GPU driver accepts no shader format, and a shader and render state made
 * for it fail and wipe cleanly instead of reaching SDL with a null device.
 * An unknown driver name fails creation.
 */

import sdl

extern "c" {
    set_hint(name: *u8, value: *u8): bool as "SDL_SetHint"
}

main(): int {
    // Hints are C strings, so these end in "\0" by hand.
    video: string = "SDL_VIDEO_DRIVER\0"
    dummy: string = "dummy\0"
    if !set_hint(&video[0], &dummy[0]) { return 1 }

    if !sdl.init(sdl.InitFlags { video = 1 }) { return 2 }
    defer sdl.quit()
    window: sdl.Window = sdl.Window::new("shader", 16, 16, sdl.WindowFlags {})
    defer mut window.wipe()
    if !window.ok() { return 3 }

    missing: sdl.Renderer = sdl.Renderer::new(window, "no-such-driver")
    defer mut missing.wipe()
    if missing.ok() { return 4 }

    renderer: sdl.Renderer = sdl.Renderer::new(window, "software")
    defer mut renderer.wipe()
    if !renderer.ok() { return 5 }
    if renderer.shader_formats() != blank(sdl.ShaderFormats) { return 6 }

    code: [4]u8 = [0x03, 0x02, 0x23, 0x07]
    program: sdl.Shader = sdl.Shader::new(renderer, sdl.ShaderFormats { spirv = 1 }, code[..], 1)
    defer mut program.wipe()
    if program.ok() { return 7 }

    state: sdl.RenderState = sdl.RenderState::new(renderer, program)
    defer mut state.wipe()
    if state.ok() { return 8 }

    scene: [4]f32 = [0.0 : 4]
    if state.uniforms(0, scene[..]) { return 9 }
    if !renderer.state(blank(sdl.RenderState)) { return 10 }
    return 0
}
