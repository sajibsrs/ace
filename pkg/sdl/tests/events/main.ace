/* Headless round trip: a key event written through Event.keyboard is pushed
 * onto SDL's queue and polled back, proving SDL and Ace agree on its layout.
 */

import sdl

extern "c" {
    push_event(event: mut *sdl.Event): bool = "SDL_PushEvent"
}

SCANCODE_ESCAPE: const u32 = 41
KMOD_LCTRL: const u16 = 0x0040

main(): int {
    if u32(sdl.Keycode.digit_0) != 0x30 || u32(sdl.Keycode.z) != 0x7a { return 7 }
    if sdl.Keycode('a') != sdl.Keycode.a || u32(sdl.Keycode.up) != 0x4000_0052 { return 7 }
    if !sdl.init(sdl.InitFlags { events = 1 }) { return 1 }
    defer sdl.quit()

    sent: sdl.Event
    sent.keyboard.kind = sdl.EventType.key_down
    sent.keyboard.reserved = 0
    sent.keyboard.timestamp = 0
    sent.keyboard.window_id = 7
    sent.keyboard.which = 0
    sent.keyboard.scancode = SCANCODE_ESCAPE
    sent.keyboard.key = sdl.Keycode.escape
    sent.keyboard.mod = KMOD_LCTRL
    sent.keyboard.raw = 0
    sent.keyboard.down = true
    sent.keyboard.repeat = false
    if !push_event(mut &sent) { return 2 }

    quit: sdl.Event
    quit.padding = [0 : 128]
    quit.kind = sdl.EventType.quit
    quit_key: sdl.KeyboardEvent, quit_is_key: bool = quit.keyboard()
    if quit_is_key { return 8 }

    got: sdl.Event
    for mut got.poll() {
        key: sdl.KeyboardEvent, is_key: bool = got.keyboard()
        if !is_key { continue }
        if key.key != sdl.Keycode.escape || key.scancode != SCANCODE_ESCAPE { return 3 }
        if key.window_id != 7 || key.mod != KMOD_LCTRL { return 4 }
        if !key.down || key.repeat { return 5 }
        return 0
    }
    return 6
}
