/* sdl — a minimal SDL3 binding: window, renderer, draw color, colored
 * triangle geometry, debug text, vsync, and the keyboard and quit events of a
 * classic SDL_PollEvent loop.
 *
 * Layouts, values, and signatures mirror the SDL 3.4 headers; the
 * static_asserts pin them. The manifest links SDL3 with Homebrew's
 * /opt/homebrew/lib as a path hint: used where the library is there, else
 * the linker's own search. An app overrides it with its own [[link]] path.
 */

import mem

// SDL_InitFlags: the subsystems sdl.init starts.
pub InitFlags: bits u32 { _: 5, video: 1, _: 8, events: 1, _: 17 }

// SDL_WindowFlags: window properties chosen at creation.
pub WindowFlags: bits u64 { _: 5, resizable: 1, _: 58 }

// SDL_EventType values this binding names; SDL may deliver others, which
// compare unequal to every member.
pub EventType: enum u32 {
    none,
    quit = 0x100,
    window_close_requested = 0x210,
    key_down = 0x300,
    key_up = 0x301,
}

// SDL_Keycode values this binding names. Keys produce their unshifted
// character, so any other key is still reachable: `Keycode('/')` builds
// one, and `u32(key)` gives the integer for range checks.
pub Keycode: enum u32 {
    unknown,
    backspace = 0x08,
    tab = 0x09,
    enter = 0x0d,
    escape = 0x1b,
    space = 0x20,
    digit_0 = '0',
    digit_1 = '1',
    digit_2 = '2',
    digit_3 = '3',
    digit_4 = '4',
    digit_5 = '5',
    digit_6 = '6',
    digit_7 = '7',
    digit_8 = '8',
    digit_9 = '9',
    a = 'a',
    b = 'b',
    c = 'c',
    d = 'd',
    e = 'e',
    f = 'f',
    g = 'g',
    h = 'h',
    i = 'i',
    j = 'j',
    k = 'k',
    l = 'l',
    m = 'm',
    n = 'n',
    o = 'o',
    p = 'p',
    q = 'q',
    r = 'r',
    s = 's',
    t = 't',
    u = 'u',
    v = 'v',
    w = 'w',
    x = 'x',
    y = 'y',
    z = 'z',
    right = 0x4000_004f,
    left = 0x4000_0050,
    down = 0x4000_0051,
    up = 0x4000_0052,
}

// Renderer.vsync intervals: 1 presents on every refresh, 0 never waits.
pub VSYNC_DISABLED: const i32 = 0
pub VSYNC_ADAPTIVE: const i32 = -1

// Longest text, in bytes, that Window::new and Renderer.debug_text accept.
pub TEXT_MAX: const usize = 255

// Debug text glyphs are this many render units square.
pub DEBUG_TEXT_SIZE: const f32 = 8.0

// Opaque C objects, only ever seen behind a pointer.
SDL_Window: struct {}
SDL_Renderer: struct {}
SDL_Texture: struct {}

// Handles own one C object each; a null handle means creation failed.
pub Window: struct { handle: *SDL_Window }
pub Renderer: struct { handle: *SDL_Renderer }

// A position in render pixels (SDL_FPoint).
pub Point: struct { x: f32 = 0.0, y: f32 = 0.0 }

// A color with 0..1 channels (SDL_FColor), opaque unless `a` says otherwise.
pub Color: struct { r: f32 = 0.0, g: f32 = 0.0, b: f32 = 0.0, a: f32 = 1.0 }

// A geometry vertex; the texture coordinate is unused without a texture.
pub Vertex: struct {
    position: Point = Point {},
    color: Color = Color {},
    tex_coord: Point = Point {},
}

pub QuitEvent: struct {
    kind: EventType,
    reserved: u32,
    timestamp: u64,
}

pub KeyboardEvent: struct {
    kind: EventType,
    reserved: u32,
    timestamp: u64,
    window_id: u32,
    which: u32,
    scancode: u32,
    key: Keycode,
    mod: u16,
    raw: u16,
    down: bool,
    repeat: bool,
}

// SDL_Event: a C union, written as an overlapping struct.
pub Event: struct {
    @offset(0)
    kind: EventType,

    @offset(0)
    keyboard: KeyboardEvent,

    @offset(0)
    quit: QuitEvent,

    @offset(0)
    padding: [128]u8,
}

static_assert(sizeof(QuitEvent) == 16)
static_assert(sizeof(KeyboardEvent) == 40 && alignof(KeyboardEvent) == 8)
static_assert(offsetof(KeyboardEvent, key) == 28)
static_assert(offsetof(KeyboardEvent, mod) == 32)
static_assert(offsetof(KeyboardEvent, down) == 36)
static_assert(sizeof(Event) == 128 && alignof(Event) == 8)
static_assert(sizeof(Color) == 16)
static_assert(sizeof(Vertex) == 32 && offsetof(Vertex, color) == 8)

extern "c" {
    c_init(flags: u32): bool = "SDL_Init"
    c_quit() = "SDL_Quit"
    c_get_error(): *u8 = "SDL_GetError"
    c_create_window(title: *u8, w: i32, h: i32, flags: u64): *SDL_Window = "SDL_CreateWindow"
    c_destroy_window(window: *SDL_Window) = "SDL_DestroyWindow"
    c_create_renderer(window: *SDL_Window, name: *u8): *SDL_Renderer = "SDL_CreateRenderer"
    c_destroy_renderer(renderer: *SDL_Renderer) = "SDL_DestroyRenderer"
    c_set_render_draw_color_float(renderer: *SDL_Renderer, r: f32, g: f32, b: f32, a: f32): bool = "SDL_SetRenderDrawColorFloat"
    c_get_render_draw_color_float(renderer: *SDL_Renderer, r: mut *f32, g: mut *f32, b: mut *f32, a: mut *f32): bool = "SDL_GetRenderDrawColorFloat"
    c_render_clear(renderer: *SDL_Renderer): bool = "SDL_RenderClear"
    c_render_present(renderer: *SDL_Renderer): bool = "SDL_RenderPresent"
    c_get_current_render_output_size(renderer: *SDL_Renderer, w: mut *i32, h: mut *i32): bool = "SDL_GetCurrentRenderOutputSize"
    c_render_geometry(renderer: *SDL_Renderer, texture: *SDL_Texture, vertices: *Vertex, num_vertices: i32, indices: *i32, num_indices: i32): bool = "SDL_RenderGeometry"
    c_get_ticks(): u64 = "SDL_GetTicks"
    c_get_ticks_ns(): u64 = "SDL_GetTicksNS"
    c_set_render_vsync(renderer: *SDL_Renderer, vsync: i32): bool = "SDL_SetRenderVSync"
    c_set_render_scale(renderer: *SDL_Renderer, x: f32, y: f32): bool = "SDL_SetRenderScale"
    c_render_debug_text(renderer: *SDL_Renderer, x: f32, y: f32, text: *u8): bool = "SDL_RenderDebugText"
    c_poll_event(event: mut *Event): bool = "SDL_PollEvent"
    c_delay(ms: u32) = "SDL_Delay"
}

pub init(flags: InitFlags): bool { return c_init(u32(flags)) }
pub quit() { c_quit() }
pub delay(ms: u32) { c_delay(ms) }

// Milliseconds since SDL initialization.
pub ticks(): u64 { return c_get_ticks() }

// Nanoseconds since SDL initialization.
pub ticks_ns(): u64 { return c_get_ticks_ns() }

// SDL returns NUL-terminated text; view it as a string without libc.
pub error(): string {
    p: *u8 = c_get_error()
    if p == null { return "" }
    n: usize = 0
    for *(p + n) != 0 { n += 1 }
    return string([]u8(p, n))
}

// Copy text into buf with the NUL SDL reads as its end; null when it does
// not fit.
c_text(buf: mut []u8, text: string): *u8 {
    if text.len >= buf.len { return null }
    mem.copy(mut buf[..text.len], text)
    buf[text.len] = 0
    return &buf[0]
}

// Fill this event with the next pending one; false when none is left.
pub mut Event.poll(): bool { return c_poll_event(mut &self) }

// The keyboard member, and whether kind says it holds one; false for every
// other kind, whose bytes the member would misread.
pub Event.keyboard(): (KeyboardEvent, bool) {
    return self.keyboard, self.kind == EventType.key_down || self.kind == EventType.key_up
}

// An opaque color from a 24-bit 0xRRGGBB value, e.g. 0xF44336, as written
// in CSS and design tools.
pub Color::hex(rgb: u32): Color {
    return Color {
        r = f32((rgb >> 16) & 0xFF) / 255.0,
        g = f32((rgb >> 8) & 0xFF) / 255.0,
        b = f32(rgb & 0xFF) / 255.0,
    }
}

// A title longer than TEXT_MAX bytes fails creation.
pub Window::new(title: string, w: i32, h: i32, flags: WindowFlags): Window {
    buf: [TEXT_MAX + 1]u8
    p: *u8 = c_text(mut buf[..], title)
    if p == null { return Window { handle = null } }
    return Window { handle = c_create_window(p, w, h, u64(flags)) }
}

pub Window.ok(): bool { return self.handle != null }
pub mut Window.wipe() {
    c_destroy_window(self.handle)
    self.handle = null
}

pub Renderer::new(window: Window): Renderer {
    return Renderer { handle = c_create_renderer(window.handle, null) }
}

pub Renderer.ok(): bool { return self.handle != null }
pub mut Renderer.wipe() {
    c_destroy_renderer(self.handle)
    self.handle = null
}

pub Renderer.color(color: Color): bool {
    return c_set_render_draw_color_float(self.handle, color.r, color.g, color.b, color.a)
}

pub Renderer.color(): (Color, bool) {
    c: Color
    ok: bool = c_get_render_draw_color_float(self.handle, mut &c.r, mut &c.g, mut &c.b, mut &c.a)
    return c, ok
}

pub Renderer.clear(): bool { return c_render_clear(self.handle) }
pub Renderer.present(): bool { return c_render_present(self.handle) }

// The current output size in render pixels, which follows window resizes.
pub Renderer.size(): (i32, i32, bool) {
    w: i32 = 0
    h: i32 = 0
    ok: bool = c_get_current_render_output_size(self.handle, mut &w, mut &h)
    return w, h, ok
}

// Untextured triangles: each three indices name one triangle's vertices,
// whose colors SDL interpolates across it. Without indices, each three
// consecutive vertices form one triangle. Indices without vertices fail.
pub Renderer.geometry(vertices: []Vertex, indices: []i32): bool {
    if vertices.len == 0 { return indices.len == 0 }
    if indices.len == 0 {
        return c_render_geometry(self.handle, null, &vertices[0], i32(vertices.len), null, 0)
    }
    return c_render_geometry(self.handle, null, &vertices[0], i32(vertices.len), &indices[0], i32(indices.len))
}

// Present in step with the display: 1 waits for every refresh, 2 for every
// other one, VSYNC_ADAPTIVE tears only when late, and VSYNC_DISABLED never
// waits.
pub Renderer.vsync(interval: i32): bool {
    return c_set_render_vsync(self.handle, interval)
}

// Multiply every later drawing coordinate; 1, 1 is the identity.
pub Renderer.scale(x: f32, y: f32): bool {
    return c_set_render_scale(self.handle, x, y)
}

// Draw text in SDL's built-in 8x8 font with the draw color; text longer
// than TEXT_MAX bytes draws nothing and returns false.
pub Renderer.debug_text(x: f32, y: f32, text: string): bool {
    buf: [TEXT_MAX + 1]u8
    p: *u8 = c_text(mut buf[..], text)
    if p == null { return false }
    return c_render_debug_text(self.handle, x, y, p)
}
