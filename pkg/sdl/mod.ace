/* sdl — a minimal SDL3 binding: window, renderer, draw color, colored
 * triangle geometry, debug text, vsync, fragment shaders on the GPU render
 * driver, and the keyboard, mouse, and quit events of a classic SDL_PollEvent
 * loop.
 *
 * Layouts, values, and signatures mirror the SDL 3.4 headers; the
 * static_asserts pin them. The manifest links Homebrew's
 * /opt/homebrew/lib/libSDL3.dylib; an app whose SDL3 lives elsewhere names
 * its own file with a [link] path of the same file name.
 */

import str

// SDL_InitFlags: the subsystems sdl.init starts.
pub InitFlags: bits u32 { _: 5, video: 1, _: 8, events: 1, _: 17 }

// SDL_WindowFlags: window properties chosen at creation.
pub WindowFlags: bits u64 { _: 5, resizable: 1, _: 58 }

// SDL_GPUShaderFormat: the shader code formats a GPU renderer accepts, or the
// one format a Shader's code is in.
pub ShaderFormats: bits u32 { _: 1, spirv: 1, dxbc: 1, dxil: 1, msl: 1, metallib: 1, _: 26 }

// SDL_EventType values this binding names. The enum is open: SDL may deliver
// others, which compare unequal to every member.
pub EventType: enum u32 {
    none,
    quit = 0x100,
    window_close_requested = 0x210,
    key_down = 0x300,
    key_up = 0x301,
    mouse_motion = 0x400,
    mouse_button_down = 0x401,
    mouse_button_up = 0x402,
    mouse_wheel = 0x403,
    _,
}

// SDL_Keycode values this binding names. Keys produce their unshifted
// character, and the enum is open, so any other key is still reachable:
// `Keycode('/')` builds one, and `u32(key)` gives the integer for range checks.
pub Keycode: enum u32 {
    unknown,
    backspace = 0x08,
    tab = 0x09,
    enter = 0x0d,
    escape = 0x1b,
    space = 0x20,
    digit_0 = '0',
    digit_1 = '1',
    digit_2 = '2',
    digit_3 = '3',
    digit_4 = '4',
    digit_5 = '5',
    digit_6 = '6',
    digit_7 = '7',
    digit_8 = '8',
    digit_9 = '9',
    a = 'a',
    b = 'b',
    c = 'c',
    d = 'd',
    e = 'e',
    f = 'f',
    g = 'g',
    h = 'h',
    i = 'i',
    j = 'j',
    k = 'k',
    l = 'l',
    m = 'm',
    n = 'n',
    o = 'o',
    p = 'p',
    q = 'q',
    r = 'r',
    s = 's',
    t = 't',
    u = 'u',
    v = 'v',
    w = 'w',
    x = 'x',
    y = 'y',
    z = 'z',
    right = 0x4000_004f,
    left = 0x4000_0050,
    down = 0x4000_0051,
    up = 0x4000_0052,
    _,
}

// Renderer.vsync intervals: 1 presents on every refresh, 0 never waits.
pub VSYNC_DISABLED: const i32 = 0
pub VSYNC_ADAPTIVE: const i32 = -1

// The render driver that draws through SDL's GPU API, the only one whose
// renderers take a Shader and a RenderState.
pub GPU_DRIVER: const string = "gpu"

// Blend modes for Renderer.blend (SDL_BlendMode): none overwrites, alpha mixes
// the source over the target by its alpha.
pub BLEND_NONE: const u32 = 0
pub BLEND_ALPHA: const u32 = 1

// Longest text, in bytes, that Window.new, a render driver name, and
// Renderer.debug_text accept.
pub TEXT_MAX: const usize = 255

// Debug text glyphs are this many render units square.
pub DEBUG_TEXT_SIZE: const f32 = 8.0

// Opaque C objects, only ever seen behind a pointer.
SDL_Window: struct {}
SDL_Renderer: struct {}
SDL_Texture: struct {}
SDL_GPUDevice: struct {}
SDL_GPUShader: struct {}
SDL_GPURenderState: struct {}
SDL_Cursor: struct {}

// Handles own one C object each; a null handle means creation failed.
pub Window: struct { pub handle: *SDL_Window }
pub Renderer: struct { pub handle: *SDL_Renderer }
pub RenderState: struct { pub handle: *SDL_GPURenderState }
pub Cursor: struct { pub handle: *SDL_Cursor }

// SDL_SystemCursor: the platform's own cursor shapes. macOS draws `move` as
// a closed hand.
pub SystemCursor: enum u32 {
    default, text, wait, crosshair, progress, nwse_resize, nesw_resize,
    ew_resize, ns_resize, move, not_allowed, pointer,
}

// A fragment shader, with the renderer's device that releases it.
pub Shader: struct { pub device: *SDL_GPUDevice, pub handle: *SDL_GPUShader }

// A position in render pixels (SDL_FPoint).
pub Point: struct { pub x: f32 = 0.0, pub y: f32 = 0.0 }

// A color with 0..1 channels (SDL_FColor), opaque unless `a` says otherwise.
pub Color: struct { pub r: f32 = 0.0, pub g: f32 = 0.0, pub b: f32 = 0.0, pub a: f32 = 1.0 }

// A geometry vertex; the texture coordinate is unused without a texture.
pub Vertex: struct {
    pub position: Point = Point {},
    pub color: Color = Color {},
    pub tex_coord: Point = Point {},
}

pub QuitEvent: struct {
    pub type: EventType,
    pub reserved: u32,
    pub timestamp: u64,
}

pub KeyboardEvent: struct {
    pub type: EventType,
    pub reserved: u32,
    pub timestamp: u64,
    pub window_id: u32,
    pub which: u32,
    pub scancode: u32,
    pub key: Keycode,
    pub mod: u16,
    pub raw: u16,
    pub down: bool,
    pub repeat: bool,
}

// SDL_BUTTON_* indices; the enum is open for further buttons.
pub MouseButton: enum u8 { none, left, middle, right, x1, x2, _ }

// SDL_MouseButtonFlags: the buttons held during a motion, one bit per button.
pub MouseButtons: bits u32 { left: 1, middle: 1, right: 1, x1: 1, x2: 1, _: 27 }

pub MouseMotionEvent: struct {
    pub type: EventType,
    pub reserved: u32,
    pub timestamp: u64,
    pub window_id: u32,
    pub which: u32,
    pub state: MouseButtons,
    pub x: f32,
    pub y: f32,
    pub xrel: f32,
    pub yrel: f32,
}

pub MouseButtonEvent: struct {
    pub type: EventType,
    pub reserved: u32,
    pub timestamp: u64,
    pub window_id: u32,
    pub which: u32,
    pub button: MouseButton,
    pub down: bool,
    pub clicks: u8,
    pub padding: u8,
    pub x: f32,
    pub y: f32,
}

// SDL_MouseWheelEvent. x and y are the scroll amounts (y positive away from
// the user), already unflipped when direction is 1 (SDL_MOUSEWHEEL_FLIPPED);
// mouse_x and mouse_y are the pointer's window position; integer_x and
// integer_y accumulate whole wheel steps.
pub MouseWheelEvent: struct {
    pub type: EventType,
    pub reserved: u32,
    pub timestamp: u64,
    pub window_id: u32,
    pub which: u32,
    pub x: f32,
    pub y: f32,
    pub direction: u32,
    pub mouse_x: f32,
    pub mouse_y: f32,
    pub integer_x: i32,
    pub integer_y: i32,
}

// SDL_Event: a C union, written as an overlapping struct.
pub Event: struct {
    @offset(0)
    pub type: EventType,

    @offset(0)
    pub keyboard: KeyboardEvent,

    @offset(0)
    pub quit: QuitEvent,

    @offset(0)
    pub motion: MouseMotionEvent,

    @offset(0)
    pub button: MouseButtonEvent,

    @offset(0)
    pub wheel: MouseWheelEvent,

    @offset(0)
    pub padding: [128]u8,
}

// SDL_GPUShaderCreateInfo; stage is an SDL_GPUShaderStage.
ShaderCreateInfo: struct {
    code_size: usize,
    code: *u8,
    entrypoint: *u8,
    format: u32,
    stage: u32,
    num_samplers: u32,
    num_storage_textures: u32,
    num_storage_buffers: u32,
    num_uniform_buffers: u32,
    props: u32,
}

SHADER_STAGE_FRAGMENT: const u32 = 1

// SDL_GPURenderStateCreateInfo; the bindings this binding leaves empty stay
// untyped.
RenderStateCreateInfo: struct {
    fragment_shader: *SDL_GPUShader,
    num_sampler_bindings: i32,
    sampler_bindings: *u8,
    num_storage_textures: i32,
    storage_textures: *u8,
    num_storage_buffers: i32,
    storage_buffers: *u8,
    props: u32,
}

static_assert(sizeof(QuitEvent) == 16)
static_assert(sizeof(KeyboardEvent) == 40 && alignof(KeyboardEvent) == 8)
static_assert(offsetof(KeyboardEvent, key) == 28)
static_assert(offsetof(KeyboardEvent, mod) == 32)
static_assert(offsetof(KeyboardEvent, down) == 36)
static_assert(sizeof(MouseMotionEvent) == 48 && offsetof(MouseMotionEvent, state) == 24)
static_assert(offsetof(MouseMotionEvent, x) == 28 && offsetof(MouseMotionEvent, yrel) == 40)
static_assert(sizeof(MouseButtonEvent) == 40 && offsetof(MouseButtonEvent, button) == 24)
static_assert(offsetof(MouseButtonEvent, clicks) == 26 && offsetof(MouseButtonEvent, x) == 28)
static_assert(sizeof(MouseWheelEvent) == 56 && offsetof(MouseWheelEvent, x) == 24)
static_assert(offsetof(MouseWheelEvent, mouse_x) == 36 && offsetof(MouseWheelEvent, integer_y) == 48)
static_assert(sizeof(Event) == 128 && alignof(Event) == 8)
static_assert(sizeof(Color) == 16)
static_assert(sizeof(Vertex) == 32 && offsetof(Vertex, color) == 8)
static_assert(sizeof(ShaderCreateInfo) == 56 && offsetof(ShaderCreateInfo, format) == 24)
static_assert(sizeof(RenderStateCreateInfo) == 64 && offsetof(RenderStateCreateInfo, props) == 56)

extern "c" {
    c_init(flags: u32): bool as "SDL_Init"
    c_quit() as "SDL_Quit"
    c_get_error(): *u8 as "SDL_GetError"
    c_create_window(title: *u8, w: i32, h: i32, flags: u64): *SDL_Window as "SDL_CreateWindow"
    c_destroy_window(window: *SDL_Window) as "SDL_DestroyWindow"
    c_set_window_title(window: *SDL_Window, title: *u8): bool as "SDL_SetWindowTitle"
    c_minimize_window(window: *SDL_Window): bool as "SDL_MinimizeWindow"
    c_maximize_window(window: *SDL_Window): bool as "SDL_MaximizeWindow"
    c_restore_window(window: *SDL_Window): bool as "SDL_RestoreWindow"
    c_get_window_flags(window: *SDL_Window): u64 as "SDL_GetWindowFlags"
    c_create_renderer(window: *SDL_Window, name: *u8): *SDL_Renderer as "SDL_CreateRenderer"
    c_destroy_renderer(renderer: *SDL_Renderer) as "SDL_DestroyRenderer"
    c_set_render_draw_color_float(renderer: *SDL_Renderer, r: f32, g: f32, b: f32, a: f32): bool as "SDL_SetRenderDrawColorFloat"
    c_set_render_draw_blend_mode(renderer: *SDL_Renderer, mode: u32): bool as "SDL_SetRenderDrawBlendMode"
    c_get_render_draw_color_float(renderer: *SDL_Renderer, r: *f32, g: *f32, b: *f32, a: *f32): bool as "SDL_GetRenderDrawColorFloat"
    c_render_clear(renderer: *SDL_Renderer): bool as "SDL_RenderClear"
    c_set_render_clip_rect(renderer: *SDL_Renderer, rect: *i32): bool as "SDL_SetRenderClipRect"
    c_render_present(renderer: *SDL_Renderer): bool as "SDL_RenderPresent"
    c_get_current_render_output_size(renderer: *SDL_Renderer, w: *i32, h: *i32): bool as "SDL_GetCurrentRenderOutputSize"
    c_render_geometry(renderer: *SDL_Renderer, texture: *SDL_Texture, vertices: *Vertex, num_vertices: i32, indices: *i32, num_indices: i32): bool as "SDL_RenderGeometry"
    c_get_ticks(): u64 as "SDL_GetTicks"
    c_get_ticks_ns(): u64 as "SDL_GetTicksNS"
    c_set_render_vsync(renderer: *SDL_Renderer, vsync: i32): bool as "SDL_SetRenderVSync"
    c_set_render_scale(renderer: *SDL_Renderer, x: f32, y: f32): bool as "SDL_SetRenderScale"
    c_render_debug_text(renderer: *SDL_Renderer, x: f32, y: f32, text: *u8): bool as "SDL_RenderDebugText"
    c_get_gpu_renderer_device(renderer: *SDL_Renderer): *SDL_GPUDevice as "SDL_GetGPURendererDevice"
    c_get_gpu_shader_formats(device: *SDL_GPUDevice): u32 as "SDL_GetGPUShaderFormats"
    c_create_gpu_shader(device: *SDL_GPUDevice, info: *ShaderCreateInfo): *SDL_GPUShader as "SDL_CreateGPUShader"
    c_release_gpu_shader(device: *SDL_GPUDevice, shader: *SDL_GPUShader) as "SDL_ReleaseGPUShader"
    c_create_gpu_render_state(renderer: *SDL_Renderer, info: *RenderStateCreateInfo): *SDL_GPURenderState as "SDL_CreateGPURenderState"
    c_destroy_gpu_render_state(state: *SDL_GPURenderState) as "SDL_DestroyGPURenderState"
    c_set_gpu_render_state_fragment_uniforms(state: *SDL_GPURenderState, slot: u32, data: *f32, length: u32): bool as "SDL_SetGPURenderStateFragmentUniforms"
    c_set_gpu_render_state(renderer: *SDL_Renderer, state: *SDL_GPURenderState): bool as "SDL_SetGPURenderState"
    c_poll_event(event: *Event): bool as "SDL_PollEvent"
    c_delay(ms: u32) as "SDL_Delay"
    c_create_system_cursor(id: u32): *SDL_Cursor as "SDL_CreateSystemCursor"
    c_destroy_cursor(cursor: *SDL_Cursor) as "SDL_DestroyCursor"
    c_set_cursor(cursor: *SDL_Cursor): bool as "SDL_SetCursor"
}

pub init(flags: InitFlags): bool { return c_init(u32(flags)) }
pub quit() { c_quit() }
pub delay(ms: u32) { c_delay(ms) }

// Milliseconds since SDL initialization.
pub ticks(): u64 { return c_get_ticks() }

// Nanoseconds since SDL initialization.
pub ticks_ns(): u64 { return c_get_ticks_ns() }

// SDL returns NUL-terminated text; view it as a string without libc.
pub error(): string {
    p: *u8 = c_get_error()
    if p == null { return "" }
    n: usize = 0
    for *(p + n) != 0 { n += 1 }
    return string([]u8(p, n))
}

// Fill this event with the next pending one; false when none is left.
pub Event.poll(self): bool { return c_poll_event(&self) }

// The keyboard member, and whether type says it holds one; false for every
// other kind, whose bytes the member would misread.
pub Event.key(const self): (KeyboardEvent, bool) {
    return self.keyboard, self.type == EventType.key_down || self.type == EventType.key_up
}

// The mouse-motion member, and whether type says it holds one.
pub Event.mouse_motion(const self): (MouseMotionEvent, bool) {
    return self.motion, self.type == EventType.mouse_motion
}

// The mouse-button member, and whether type says it holds one.
pub Event.mouse_button(const self): (MouseButtonEvent, bool) {
    return self.button, self.type == EventType.mouse_button_down || self.type == EventType.mouse_button_up
}

// The mouse-wheel member, and whether type says it holds one.
pub Event.mouse_wheel(const self): (MouseWheelEvent, bool) {
    return self.wheel, self.type == EventType.mouse_wheel
}

// An opaque color from a 24-bit 0xRRGGBB value, e.g. 0xF44336, as written
// in CSS and design tools.
pub Color.hex(rgb: u32): Color {
    return Color {
        r = f32((rgb >> 16) & 0xFF) / 255.0,
        g = f32((rgb >> 8) & 0xFF) / 255.0,
        b = f32(rgb & 0xFF) / 255.0,
    }
}

// A title longer than TEXT_MAX bytes or holding a NUL byte fails creation.
pub Window.new(title: string, w: i32, h: i32, flags: WindowFlags): Window {
    buf: [TEXT_MAX + 1]u8
    if !str.cstring(title, buf[..]) { return Window { handle = null } }
    return Window { handle = c_create_window(&buf[0], w, h, u64(flags)) }
}

// Retitles the window; false for a title longer than TEXT_MAX bytes or holding
// a NUL byte, which leaves the old one.
pub Window.title(self, title: string): bool {
    buf: [TEXT_MAX + 1]u8
    if !str.cstring(title, buf[..]) { return false }
    return c_set_window_title(self.handle, &buf[0])
}

pub Window.ok(const self): bool { return self.handle != null }
pub Window.wipe(self) {
    c_destroy_window(self.handle)
    self.handle = null
}

// Iconifies the window, fills the screen's usable area with it, or undoes
// either; the change takes effect when the window system gets to it.
pub Window.minimize(self): bool { return c_minimize_window(self.handle) }
pub Window.maximize(self): bool { return c_maximize_window(self.handle) }
pub Window.restore(self): bool { return c_restore_window(self.handle) }

// Whether the window is maximized (SDL_WINDOW_MAXIMIZED).
pub Window.maximized(const self): bool { return (c_get_window_flags(self.handle) & 0x80) != 0 }

// The platform's `shape` cursor; needs the video subsystem.
pub Cursor.new(shape: SystemCursor): Cursor {
    return Cursor { handle = c_create_system_cursor(u32(shape)) }
}

pub Cursor.ok(const self): bool { return self.handle != null }
pub Cursor.wipe(self) {
    c_destroy_cursor(self.handle)
    self.handle = null
}

// Makes `c` the active cursor; it must outlive its use.
pub cursor(c: Cursor): bool { return c_set_cursor(c.handle) }

pub Renderer.new(window: Window): Renderer {
    return Renderer { handle = c_create_renderer(window.handle, null) }
}

// A renderer on the named SDL render driver, such as GPU_DRIVER. A name
// longer than TEXT_MAX bytes or holding a NUL byte fails creation.
pub Renderer.new(window: Window, driver: string): Renderer {
    buf: [TEXT_MAX + 1]u8
    if !str.cstring(driver, buf[..]) { return Renderer { handle = null } }
    return Renderer { handle = c_create_renderer(window.handle, &buf[0]) }
}

pub Renderer.ok(const self): bool { return self.handle != null }
pub Renderer.wipe(self) {
    c_destroy_renderer(self.handle)
    self.handle = null
}

pub Renderer.color(self, color: Color): bool {
    return c_set_render_draw_color_float(self.handle, color.r, color.g, color.b, color.a)
}

pub Renderer.color(const self): (Color, bool) {
    c: Color
    ok: bool = c_get_render_draw_color_float(self.handle, &c.r, &c.g, &c.b, &c.a)
    return c, ok
}

// How later draws blend with what is already there; BLEND_ALPHA lets vertex
// alpha fade geometry edges.
pub Renderer.blend(self, mode: u32): bool {
    return c_set_render_draw_blend_mode(self.handle, mode)
}

pub Renderer.clear(self): bool { return c_render_clear(self.handle) }

// Cuts later draws off outside the w x h rectangle at (x, y), in window
// coordinates; clear ignores it.
pub Renderer.clip(self, x: i32, y: i32, w: i32, h: i32): bool {
    rect: [4]i32 = [x, y, w, h]
    return c_set_render_clip_rect(self.handle, &rect[0])
}

// Draws everywhere again.
pub Renderer.unclip(self): bool { return c_set_render_clip_rect(self.handle, null) }
pub Renderer.present(self): bool { return c_render_present(self.handle) }

// The current output size in render pixels, which follows window resizes.
pub Renderer.size(const self): (i32, i32, bool) {
    w: i32 = 0
    h: i32 = 0
    ok: bool = c_get_current_render_output_size(self.handle, &w, &h)
    return w, h, ok
}

// Untextured triangles: each three indices name one triangle's vertices,
// whose colors SDL interpolates across it. Without indices, each three
// consecutive vertices form one triangle. Indices without vertices fail.
pub Renderer.geometry(self, vertices: []Vertex, indices: []i32): bool {
    if vertices.len == 0 { return indices.len == 0 }
    if indices.len == 0 {
        return c_render_geometry(self.handle, null, &vertices[0], i32(vertices.len), null, 0)
    }
    return c_render_geometry(self.handle, null, &vertices[0], i32(vertices.len), &indices[0], i32(indices.len))
}

// Present in step with the display: 1 waits for every refresh, 2 for every
// other one, VSYNC_ADAPTIVE tears only when late, and VSYNC_DISABLED never
// waits.
pub Renderer.vsync(self, interval: i32): bool {
    return c_set_render_vsync(self.handle, interval)
}

// Multiply every later drawing coordinate; 1, 1 is the identity.
pub Renderer.scale(self, x: f32, y: f32): bool {
    return c_set_render_scale(self.handle, x, y)
}

// Draw text in SDL's built-in 8x8 font with the draw color; text longer
// than TEXT_MAX bytes or holding a NUL byte draws nothing and returns false.
pub Renderer.debug_text(self, x: f32, y: f32, text: string): bool {
    buf: [TEXT_MAX + 1]u8
    if !str.cstring(text, buf[..]) { return false }
    return c_render_debug_text(self.handle, x, y, &buf[0])
}

// The shader code formats this renderer accepts: none unless it is on
// GPU_DRIVER, then those of the GPU API beneath it (SPIR-V on Vulkan, MSL on
// Metal).
pub Renderer.shader_formats(const self): ShaderFormats {
    device: *SDL_GPUDevice = c_get_gpu_renderer_device(self.handle)
    if device == null { return ShaderFormats {} }
    return ShaderFormats(c_get_gpu_shader_formats(device))
}

// A fragment shader for a GPU_DRIVER renderer, from code in the one format
// set in `format`, reading `uniform_buffers` uniform buffers and nothing
// else. Its entry point is the format's default: main, or main0 in MSL.
pub Shader.new(renderer: Renderer, format: ShaderFormats, code: []u8, uniform_buffers: u32): Shader {
    device: *SDL_GPUDevice = c_get_gpu_renderer_device(renderer.handle)
    if device == null || code.len == 0 { return Shader { device = null, handle = null } }
    info: ShaderCreateInfo = blank(ShaderCreateInfo)
    info.code_size = code.len
    info.code = &code[0]
    info.format = u32(format)
    info.stage = SHADER_STAGE_FRAGMENT
    info.num_uniform_buffers = uniform_buffers
    return Shader { device = device, handle = c_create_gpu_shader(device, &info) }
}

pub Shader.ok(const self): bool { return self.handle != null }
pub Shader.wipe(self) {
    if self.handle != null { c_release_gpu_shader(self.device, self.handle) }
    self.handle = null
}

// A render state that fills the renderer's geometry with `shader`, which
// must outlive it.
pub RenderState.new(renderer: Renderer, shader: Shader): RenderState {
    if shader.handle == null { return RenderState { handle = null } }
    info: RenderStateCreateInfo = blank(RenderStateCreateInfo)
    info.fragment_shader = shader.handle
    return RenderState { handle = c_create_gpu_render_state(renderer.handle, &info) }
}

pub RenderState.ok(const self): bool { return self.handle != null }
pub RenderState.wipe(self) {
    if self.handle != null { c_destroy_gpu_render_state(self.handle) }
    self.handle = null
}

// Set the contents of the shader's uniform buffer `slot`, which later draws
// with this state read until it is set again.
pub RenderState.uniforms(self, slot: u32, values: []f32): bool {
    if self.handle == null || values.len == 0 { return false }
    return c_set_gpu_render_state_fragment_uniforms(self.handle, slot, &values[0], u32(values.len * sizeof(f32)))
}

// Draw later geometry with a render state; blank(RenderState) restores the
// renderer's own shaders.
pub Renderer.state(self, state: RenderState): bool {
    return c_set_gpu_render_state(self.handle, state.handle)
}
