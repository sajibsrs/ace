import test
import fmt
import ui: "../mod.ace"
import Keycode from sdl

/* No window: drawing only fills the layer. */
canvas: ui.Canvas

/* Controls and list rows 26 high, an 18 icon. */
THEME: const ui.Theme = ui.Theme { height = 26.0, padding = 8.0, gap = 4.0, icon = 18.0 }

/* A context over `canvas`, its frame begun. */
frame(c: *ui.Context) {
    c.canvas = &canvas
    c.theme = THEME
    c.begin()
}

pub cuts(t: *test.T) {
    row: ui.Rect = ui.Rect { x = 10.0, y = 20.0, w = 100.0, h = 30.0 }
    left: ui.Rect = row.cut_left(40.0)
    t.equal(left.x == 10.0 && left.w == 40.0 && left.h == 30.0, true, @file, @line)
    t.equal(row.x == 50.0 && row.w == 60.0, true, @file, @line)
    top: ui.Rect = row.cut_top(10.0)
    t.equal(top.y == 20.0 && top.h == 10.0, true, @file, @line)
    t.equal(row.y == 30.0 && row.h == 20.0, true, @file, @line)
    inner: ui.Rect = row.inset(ui.Insets.all(2.0))
    t.equal(inner.x == 52.0 && inner.y == 32.0 && inner.w == 56.0 && inner.h == 16.0, true, @file, @line)
    box: ui.Rect = ui.Rect { w = 10.0, h = 10.0 }.square(4.0)
    t.equal(box.x == 3.0 && box.y == 3.0 && box.w == 4.0, true, @file, @line)
}

/* Down an area controls take its width; across one they keep theirs,
 * centered on its height; `fill` sends the rest to the far edge. */
pub place(t: *test.T) {
    c: ui.Context = ui.Context {}
    frame(&c)
    column: ui.Area = ui.area(ui.Rect { x = 10.0, y = 20.0, w = 100.0, h = 200.0 })
    a: ui.Rect = ui.place(30.0, 26.0)
    t.equal(a.x == 10.0 && a.y == 20.0 && a.w == 100.0 && a.h == 26.0, true, @file, @line)
    ui.space(6.0)
    b: ui.Rect = ui.place(30.0, 10.0)
    t.equal(b.y == 56.0, true, @file, @line)
    ui.width(40.0)
    t.equal(ui.place(0.0, 10.0).w == 40.0, true, @file, @line)
    t.equal(ui.place(0.0, 10.0).w == 100.0, true, @file, @line)
    column.end()

    bar: ui.Area = ui.area(ui.Rect { x = 0.0, y = 0.0, w = 300.0, h = 30.0 }, ui.Flow.across)
    d: ui.Rect = ui.place(50.0, 26.0)
    e: ui.Rect = ui.place(20.0, 10.0)
    t.equal(d.x == 0.0 && d.y == 2.0 && d.w == 50.0, true, @file, @line)
    t.equal(e.x == 54.0 && e.y == 10.0, true, @file, @line)
    ui.fill()
    f: ui.Rect = ui.place(40.0, 26.0)
    g: ui.Rect = ui.place(10.0, 26.0)
    t.equal(f.x == 260.0 && g.x == 246.0, true, @file, @line)
    bar.end()
    c.end()
}

/* `row` splits one line into equal columns and ends it by itself; `grid`
 * wraps its controls into lines. */
pub rows(t: *test.T) {
    c: ui.Context = ui.Context {}
    frame(&c)
    column: ui.Area = ui.area(ui.Rect { w = 104.0, h = 200.0 })
    ui.row(2)
    a: ui.Rect = ui.place(0.0, 20.0)
    b: ui.Rect = ui.place(0.0, 26.0)
    t.equal(a.x == 0.0 && a.w == 50.0 && b.x == 54.0 && b.w == 50.0 && b.y == 0.0, true, @file, @line)
    after: ui.Rect = ui.place(0.0, 10.0)
    t.equal(after.y == 30.0 && after.w == 104.0, true, @file, @line)

    ui.grid(3, 4)
    for i: usize in 0 .. 3 { ui.place(0.0, 10.0) }
    fourth: ui.Rect = ui.place(0.0, 10.0)
    t.equal(fourth.x == 0.0 && fourth.y == 58.0 && fourth.w == 32.0, true, @file, @line)
    t.equal(ui.place(0.0, 10.0).y == 72.0, true, @file, @line)
    column.end()
    c.end()
}

/* Down a card each control takes a 40-high cell, centered on it and inset
 * the padding at the sides; a `row` splits a cell. */
pub card(t: *test.T) {
    c: ui.Context = ui.Context {}
    frame(&c)
    column: ui.Area = ui.area(ui.Rect { w = 110.0, h = 200.0 })
    cells: ui.Area = ui.card(3)
    a: ui.Rect = ui.place(0.0, 26.0)
    t.equal(a.x == 8.0 && a.w == 94.0 && a.y == 7.0, true, @file, @line)
    t.equal(ui.place(0.0, 26.0).y == 47.0, true, @file, @line)
    ui.row(2)
    l: ui.Rect = ui.place(0.0, 20.0)
    r: ui.Rect = ui.place(0.0, 20.0)
    t.equal(l.x == 8.0 && l.w == 45.0 && r.x == 57.0 && l.y == 90.0 && r.y == 90.0, true, @file, @line)
    cells.end()
    t.equal(ui.place(0.0, 10.0).y == 124.0, true, @file, @line)
    column.end()
    c.end()
}

/* A button is as wide as its content across an area, an icon alone square,
 * and `width` can size it for another label. */
pub buttons(t: *test.T) {
    c: ui.Context = ui.Context {}
    frame(&c)
    shape: ui.Icon = ui.Icon {}
    bar: ui.Area = ui.area(ui.Rect { w = 400.0, h = 30.0 }, ui.Flow.across)
    ui.button("Save")
    t.equal(ui.last().rect.w == 16.0 + ui.text_width("Save"), true, @file, @line)
    ui.button(shape, "Open")
    t.equal(ui.last().rect.w == 16.0 + ui.text_width("Open") + 22.0, true, @file, @line)
    ui.button(shape)
    t.equal(ui.last().rect.w == 26.0 && ui.last().rect.h == 26.0, true, @file, @line)
    ui.width("Simulate")
    ui.button(shape, "Edit")
    t.equal(ui.last().rect.w == 16.0 + ui.text_width("Simulate") + 22.0, true, @file, @line)
    bar.end()
    c.end()
}

/* A click is a press and a release on the same widget. */
pub clicks(t: *test.T) {
    c: ui.Context = ui.Context { mouse = ui.Mouse { x = 5.0, y = 5.0, pressed = true } }
    hit: ui.Rect = ui.Rect { w = 10.0, h = 10.0 }
    miss: ui.Rect = ui.Rect { x = 20.0, w = 10.0, h = 10.0 }
    frame(&c)
    t.equal(ui.track(1, hit).press, true, @file, @line)
    t.equal(ui.track(2, miss).press, false, @file, @line)
    c.end()
    frame(&c)
    t.equal(ui.track(1, hit).held, true, @file, @line)
    t.equal(ui.last().held, true, @file, @line)
    t.equal(ui.track(1, hit).click, false, @file, @line)
    c.mouse.released = true
    t.equal(ui.track(1, hit).click, true, @file, @line)
    c.end()
    frame(&c)
    t.equal(ui.track(1, hit).held, false, @file, @line)
    c.end()
}

/* While a popup is up, a frame later, only its controls take the pointer. */
pub popup(t: *test.T) {
    c: ui.Context = ui.Context { mouse = ui.Mouse { x = 5.0, y = 5.0 } }
    hit: ui.Rect = ui.Rect { w = 10.0, h = 10.0 }
    for i: usize in 0 .. 2 {
        frame(&c)
        under: bool = ui.track(1, hit).hover
        t.equal(under, i == 0, @file, @line)
        dialog: ui.Area = ui.popup(ui.Rect { w = 50.0, h = 50.0 })
        t.equal(ui.track(2, hit).hover, true, @file, @line)
        dialog.end()
        c.end()
    }
    frame(&c)
    c.end()
    frame(&c)
    t.equal(ui.track(1, hit).hover, true, @file, @line)
    c.end()
}

/* A label, an icon or a value's address names a control; a scope tells the
 * same name apart. */
pub ids(t: *test.T) {
    c: ui.Context = ui.Context {}
    frame(&c)
    a: bool = false
    b: bool = false
    t.equal(ui.id("Save") != ui.id("Open"), true, @file, @line)
    t.equal(ui.id(ui.Icon { start = 3 }) == ui.id(ui.Icon { start = 3 }), true, @file, @line)
    t.equal(ui.id(ui.Icon { start = 3 }) != ui.id(ui.Icon { start = 4 }), true, @file, @line)
    t.equal(ui.id(usize(&a)) != ui.id(usize(&b)), true, @file, @line)
    t.equal(ui.id(usize(3)) != ui.id(ui.Icon { start = 3 }), true, @file, @line)
    outer: u32 = ui.id("row")
    ui.push_id(1)
    one: u32 = ui.id("row")
    ui.pop_id()
    ui.push_id(2)
    two: u32 = ui.id("row")
    ui.pop_id()
    t.equal(outer != one && one != two && outer != two, true, @file, @line)
    t.equal(ui.id("row") == outer, true, @file, @line)
    c.end()
}

/* A toggle flips its value on a click and rests selected while it is set. */
pub toggle(t: *test.T) {
    c: ui.Context = ui.Context { mouse = ui.Mouse { x = 5.0, y = 5.0, pressed = true, released = true } }
    on: bool = false
    frame(&c)
    bar: ui.Area = ui.area(ui.Rect { w = 100.0, h = 30.0 }, ui.Flow.across)
    t.equal(ui.toggle(ui.Icon {}, &on), true, @file, @line)
    t.equal(on, true, @file, @line)
    bar.end()
    c.end()
}

/* A key is consumed once, with exactly its modifiers, either side's. */
pub keys(t: *test.T) {
    c: ui.Context = ui.Context {}
    frame(&c)
    c.keyboard.add(Keycode.s, 0x0400, false)
    c.keyboard.add(Keycode.escape, 0, false)
    t.equal(c.keyboard.consume(Keycode.s, 0), false, @file, @line)
    t.equal(c.keyboard.consume(Keycode.a, ui.MOD_GUI), false, @file, @line)
    t.equal(c.keyboard.consume(Keycode.s, ui.MOD_GUI), true, @file, @line)
    t.equal(c.keyboard.consume(Keycode.s, ui.MOD_GUI), false, @file, @line)
    t.equal(ui.key(Keycode.escape), true, @file, @line)
    t.equal(ui.key(Keycode.escape), false, @file, @line)
    c.end()
    t.equal(c.keyboard.count, 0, @file, @line)
}

/* `line` formats into scratch space, empty on each call. */
pub line(t: *test.T) {
    c: ui.Context = ui.Context {}
    frame(&c)
    l: *fmt.Buffer = ui.line()
    l.printf("%d ticks", 8)
    t.equal(l.text(), "8 ticks", @file, @line)
    t.equal(ui.line().text(), "", @file, @line)
    c.end()
}

/* Text measures in proportion to the text size, which is kept between 6 and 96. */
pub size(t: *test.T) {
    ui.set_text_size(16.0)
    w16: f32 = ui.text_width("Hamburg")
    ui.set_text_size(32.0)
    w32: f32 = ui.text_width("Hamburg")
    t.equal(ui.text_size() == 32.0 && w32 - 2.0 * w16 < 0.01 && 2.0 * w16 - w32 < 0.01, true, @file, @line)
    ui.set_text_size(1000.0)
    t.equal(ui.text_size() == 96.0, true, @file, @line)
    ui.set_text_size(16.0)
}
