/* ui look — how each control draws itself, given where it was placed, what
 * the pointer did, and its component's style in the theme: a `Box` picks the
 * `Look` for the control's state and draws its shadow, fill and outline; the
 * label and icons go on top. The sizes it exports are the ones placement
 * reads. */

import math
import Point, Color from sdl
import Rect, Insets, Canvas, Icon, Align, Text, text_width from "./canvas.ace"
import Theme, Box, Look, States, Graphical, Labeled, Ruled, Shadow, Response, LIST_PAD from "./theme.ace"

/* The room a button adds above and below its frame. */
pub BUTTON_PAD: const f32 = 2.0

/* The text field's caret. */
CARET_W: const f32 = 2.0
CARET_PAD: const f32 = 6.0

/* A stepped slider's ticks' height; the room under its bar is the slider
 * rule's gap plus this. */
pub TICK_H: const f32 = 4.0

/* What `box`, with corners of `radius`, casts as `s`; nothing when `s` is
 * transparent. */
cast(cv: *Canvas, box: Rect, radius: f32, s: Shadow) {
    if s.color.a <= 0.0 { return }
    cv.shadow(Rect { x = box.x + s.dx, y = box.y + s.dy, w = box.w, h = box.h }, radius, s.blur, s.color)
}

/* `box` framed by `b` in `l`: its shadow, its fill, and its outline when `b`
 * has a width and `l` a border color. */
frame(cv: *Canvas, b: const *Box, box: Rect, l: Look) {
    cast(cv, box, b.radius, l.shadow)
    if l.fill.a > 0.0 { cv.fill(box, b.radius, l.fill) }
    if b.border > 0.0 && l.border.a > 0.0 { cv.outline(box, b.radius, b.border, l.border) }
}

/* `s` in `style` in `color`, `pad` in from `box`'s left. */
say(cv: *Canvas, style: Text, box: Rect, pad: f32, s: string, color: Color) {
    cv.text(Rect { x = box.x + pad, y = box.y, w = box.w - pad, h = box.h }, s, style.in(color).at(Align.left))
}

/* `s` in `style` in `color`, centered in `box`. */
mid(cv: *Canvas, style: Text, box: Rect, s: string, color: Color) {
    cv.text(box, s, style.in(color).at(Align.center))
}

/* A button at `box` in `st`, on while `on`, for `res`, faint when `off`: its
 * icon, from `shapes` for its state, when `icon`, and `label`, centered together however wide the
 * button. */
pub button(cv: *Canvas, st: const *Graphical, box: Rect, res: Response, shapes: States[Icon], icon: bool, label: string, on: bool, off: bool) {
    looks: States[Look] = st.box.look
    if on { looks = st.box.on }
    l: Look = looks.pick(res, off)
    shape: Icon = shapes.pick(res, off)
    frame(cv, &st.box, box, l)
    g: f32 = st.graphic.size
    if label.len == 0 {
        cv.icon(shape, box.square(g), l.tint)
    } else if icon {
        at: f32 = (box.w - g - st.graphic.gap - text_width(label, st.label)) / 2.0
        cv.icon(shape, box.square(at, g), l.tint)
        say(cv, st.label, box, at + g + st.graphic.gap, label, l.text)
    } else {
        mid(cv, st.label, box, label, l.text)
    }
}

/* `s` centered on a fill like a resting button's. */
pub readout(cv: *Canvas, t: const *Theme, box: Rect, s: string) {
    l: Look = t.button.box.look.rest
    cv.fill(box, t.button.box.radius, l.fill)
    mid(cv, t.button.label, box, s, t.text)
}

/* The icon `shapes` has for `res`, in `color`, in `st`, on while `selected`. */
pub swatch(cv: *Canvas, st: const *Graphical, box: Rect, res: Response, shapes: States[Icon], color: Color, selected: bool) {
    looks: States[Look] = st.box.look
    if selected { looks = st.box.on }
    frame(cv, &st.box, box, looks.pick(res, false))
    cv.icon(shapes.pick(res, false), box.square(st.graphic.size), color)
}

/* A box the graphic's size at `box`'s left, centered on its height, in `st`
 * for `res`: on, with `tick` inside its padding, while `on`; then `label`,
 * the graphic's gap after the box. */
pub checkbox(cv: *Canvas, st: const *Graphical, tick: Icon, box: Rect, res: Response, on: bool, label: string) {
    side: f32 = st.graphic.size
    at: Rect = box.square(0.0, side)
    looks: States[Look] = st.box.look
    if on { looks = st.box.on }
    l: Look = looks.pick(res, false)
    frame(cv, &st.box, at, l)
    if on { cv.icon(tick, at.inset(st.box.padding), l.tint) }
    say(cv, st.label, box, side + st.graphic.gap, label, st.label.color)
}

/* A slider at `box` in `st`: a bar filled as it rests, on up to `at` (0 to 1),
 * `s` centered on it, and, when `stops` is 2 or more and they are the rule's
 * room apart, a tick under the bar at each in the border color. */
pub slider(cv: *Canvas, st: const *Ruled, box: Rect, at: f32, stops: int, s: string) {
    l: Look = st.box.look.rest
    r: f32 = st.box.radius
    bar: Rect = box
    if stops >= 2 { bar.h -= st.rule.gap + TICK_H }
    cv.fill(bar, r, l.fill)
    cv.fill_until(bar, math.min[f32](r, bar.h / 2.0), bar.x + bar.w * at, st.box.on.rest.fill)
    w: f32 = st.rule.w
    if stops >= 2 && bar.w / f32(stops - 1) >= st.rule.room {
        for i: int in 0 .. stops {
            tx: f32 = bar.x + bar.w * f32(i) / f32(stops - 1)
            tx = math.max[f32](bar.x + w / 2.0, math.min[f32](tx, bar.x + bar.w - w / 2.0))
            cv.fill(Rect { x = tx - w / 2.0, y = bar.y + bar.h + st.rule.gap, w = w, h = TICK_H }, l.border)
        }
    }
    mid(cv, st.label, bar, s, l.text)
}

/* A picker at `box` in `st`: `items` in equal segments on a track as it rests,
 * the one at `chosen` on. */
pub picker(cv: *Canvas, st: const *Labeled, box: Rect, items: []string, chosen: usize) {
    w: f32 = box.w / f32(items.len)
    frame(cv, &st.box, box, st.box.look.rest)
    if chosen < items.len {
        cv.fill(Rect { x = box.x + f32(chosen) * w, y = box.y, w = w, h = box.h }, st.box.radius, st.box.on.rest.fill)
    }
    for i: usize in 0 .. items.len {
        ink: Color = st.box.look.rest.text
        if i == chosen { ink = st.box.on.rest.text }
        mid(cv, st.label, Rect { x = box.x + f32(i) * w, y = box.y, w = w, h = box.h }, items[i], ink)
    }
}

/* A card at `box` in `st`. */
pub card(cv: *Canvas, st: const *Ruled, box: Rect) {
    frame(cv, &st.box, box, st.box.look.rest)
}

/* A tooltip `s` in `st`, its top left TIP_OFFSET right of and below the
 * pointer at `x`, `y`, `h` high. */
TIP_OFFSET: const f32 = 14.0
pub tooltip(cv: *Canvas, st: const *Labeled, x: f32, y: f32, h: f32, s: string) {
    p: Insets = st.box.padding
    box: Rect = Rect { x = x + TIP_OFFSET, y = y + TIP_OFFSET, w = text_width(s, st.label) + p.left + p.right, h = h }
    frame(cv, &st.box, box, st.box.look.rest)
    mid(cv, st.label, box, s, st.box.look.rest.text)
}

/* A popup's title `s` on the header strip, across the top of the popup at
 * `box` and `h` high. */
pub title(cv: *Canvas, st: const *Labeled, box: Rect, h: f32, s: string) {
    strip: Rect = Rect { x = box.x, y = box.y, w = box.w, h = h }
    l: Look = st.box.look.rest
    cv.fill(strip, st.box.radius, 0.0, l.fill)
    say(cv, st.label, strip.inset(Insets { right = st.box.padding.right }), st.box.padding.left, s, l.text)
}

/* Rules between `box`'s cells, each `cell` high, the rule's gap in from its
 * left, in the border color. */
pub separators(cv: *Canvas, st: const *Ruled, box: Rect, cell: f32) {
    for y: f32 = box.y + cell; y < box.y + box.h - 0.5; y += cell {
        cv.fill(Rect { x = box.x + st.rule.gap, y = y, w = box.w - st.rule.gap, h = st.rule.w }, st.box.look.rest.border)
    }
}

/* A field at `box` in `st` showing `text`, or `hint` in `muted` while it is
 * empty, with a caret in the tint before byte `caret` while `focused`.
 * Focused, it is on, in the box's focus glow. */
pub field(cv: *Canvas, st: const *Labeled, box: Rect, text: string, hint: string, muted: Color, focused: bool, caret: usize) {
    l: Look = st.box.look.rest
    if focused {
        l = st.box.on.rest
        cast(cv, box, st.box.radius, st.box.focus)
    }
    frame(cv, &st.box, box, l)
    pad: f32 = st.box.padding.left
    if text.len == 0 { say(cv, st.label, box, pad, hint, muted) } else { say(cv, st.label, box, pad, text, l.text) }
    if !focused { return }
    x: f32 = box.x + pad + text_width(text[0..caret], st.label)
    cv.fill(Rect { x = x - CARET_W / 2.0, y = box.y + CARET_PAD, w = CARET_W, h = box.h - 2.0 * CARET_PAD }, l.tint)
}

/* A list row at `box` in `st` showing `item`: on while `chosen`, else as
 * `res` has it. Its text is `pad` in. */
pub row(cv: *Canvas, st: const *Labeled, box: Rect, res: Response, chosen: bool, pad: f32, item: string) {
    looks: States[Look] = st.box.look
    if chosen { looks = st.box.on }
    l: Look = looks.pick(res, false)
    frame(cv, &st.box, box, l)
    say(cv, st.label, box, pad, item, l.text)
}

/* A list's scroll thumb at `box`, in the list's resting tint. */
pub thumb(cv: *Canvas, st: const *Labeled, box: Rect) {
    cv.fill(box, box.w / 2.0, st.box.look.rest.tint)
}

/* A popup's background at `box` in `b`. */
pub popup(cv: *Canvas, b: const *Box, box: Rect) {
    frame(cv, b, box, b.look.rest)
}
