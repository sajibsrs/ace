/* ui look — how each control draws itself, given where it was placed, what
 * the pointer did, and the theme: flat rounded fills, knobs and cards raised
 * by soft shadows, and popups raised further. A different look is an edit to
 * this file alone; the sizes it exports are the ones placement reads. */

import math
import Point, Color from sdl
import Rect, Insets, Canvas, Icon, Align, Weight, text_width from "./canvas.ace"
import Theme, Fill, Response from "./theme.ace"

/* The room a button adds above and below its frame. */
pub BUTTON_PAD: const f32 = 2.0

/* The accent glow round a focused field: how far it spreads, and its
 * opacity at the edge. */
FOCUS_BLUR: const f32 = 6.0
FOCUS_GLOW: const f32 = 0.7

/* The text field's caret. */
CARET_W: const f32 = 2.0
CARET_PAD: const f32 = 6.0

/* A popup's corner radius, rounder than a control's; a card's, and a chosen
 * list row's. */
POPUP_RADIUS: const f32 = 14.0
CARD_RADIUS: const f32 = 10.0
PILL_RADIUS: const f32 = 8.0

/* How far a popup's shadow falls below it, and how far it blurs. */
SHADOW_DROP: const f32 = 18.0
SHADOW_BLUR: const f32 = 48.0

/* How far a knob's lift falls below it and blurs, and its contact shadow. */
LIFT_DROP: const f32 = 2.0
LIFT_BLUR: const f32 = 6.0
CONTACT_DROP: const f32 = 1.0

/* A popup's and a card's rim, half a pixel. */
EDGE: const f32 = 0.5

/* A switch's track; its knob is inset KNOB_INSET all round, and is 1.5 times
 * as wide as it is tall, so it is a pill and not a circle. The track is twice
 * as wide as the knob. */
SWITCH_H: const f32 = 22.0
KNOB_INSET: const f32 = 2.0
KNOB_H: const f32 = SWITCH_H - 2.0 * KNOB_INSET
KNOB_W: const f32 = 1.0 * KNOB_H
pub SWITCH_W: const f32 = 2.0 * KNOB_W

/* The width of a picker's boundary dash and of a slider's stop line. */
DIVIDER_W: const f32 = 1.0

/* A picker's boundary dash, left clear this fraction of a segment's height
 * at each end. */
DASH_INSET: const f32 = 0.25

/* A checkbox's box, its corners, and its tick's stroke. */
pub CHECK_SIDE: const f32 = 16.0
CHECK_RADIUS: const f32 = 6.0
CHECK_STROKE: const f32 = 1.75

/* A slider's knob, a circle as tall as a switch's, which stays inside the slider, so
 * its center travels from half of it in from one end to half of it in from
 * the other. */
pub SLIDER_KNOB: const f32 = KNOB_H
TRACK_H: const f32 = 8.0
/* A stepped slider's stops, as lines DIVIDER_W wide and TICK_H high, TICK_DROP
 * under its track, drawn only when the stops are at least TICK_ROOM apart. */
TICK_H: const f32 = 4.0
TICK_DROP: const f32 = 4.0
TICK_ROOM: const f32 = 6.0

/* The gap round a picker's chosen segment, inside its track. */
SEGMENT_PAD: const f32 = 2.0

/* A list's card, around its rows. */
pub LIST_PAD: const f32 = 4.0

/* A disabled button's alpha, and an outlined button's line. */
OFF_ALPHA: const f32 = 0.4
EDGE_W: const f32 = 1.0

/* `color` at `a` times its alpha. */
fade(color: Color, a: f32): Color { return Color { r = color.r, g = color.g, b = color.b, a = color.a * a } }

/* `box` moved `dy` down. */
lower(box: Rect, dy: f32): Rect { return Rect { x = box.x, y = box.y + dy, w = box.w, h = box.h } }

/* `box` in `color` with corners of `radius`, raised off what is under it by a
 * lift shadow and a contact shadow: a knob or a picker's segment. The contact
 * shadow's 1 px blur is the fill's own fading edge. */
raised(cv: *Canvas, t: *Theme, box: Rect, radius: f32, color: Color) {
    cv.shadow(lower(box, LIFT_DROP), radius, LIFT_BLUR, t.lift)
    cv.fill(lower(box, CONTACT_DROP), radius, t.contact)
    cv.fill(box, radius, color)
}

/* A button at `box` in `fill`'s shade for `res`, its icon `shape` when
 * `icon`, and `label`; the icon and label are centered together, however wide
 * the button. The label is picked from the resting shade, so it stays put on hover. Outlined when `fill` has an edge, in its own ink when it has one, faint when `off`. */
pub button(cv: *Canvas, t: *Theme, box: Rect, res: Response, shape: Icon, icon: bool, label: string, fill: Fill, off: bool) {
    shade: Color = fill.shade(res)
    ink: Color = on(t, fill.rest)
    if fill.ink.a > 0.0 { ink = fill.ink }
    edge: Color = fill.edge
    if off {
        shade = fade(shade, OFF_ALPHA)
        ink = fade(ink, OFF_ALPHA)
        edge = fade(edge, OFF_ALPHA)
    }
    cv.fill(box, t.radius, shade)
    if edge.a > 0.0 { cv.outline(box, t.radius, EDGE_W, edge) }
    if label.len == 0 {
        cv.icon(shape, box.square(t.icon), ink)
    } else if icon {
        at: f32 = (box.w - t.icon - t.gap - text_width(label, Weight.regular)) / 2.0
        cv.icon(shape, box.square(at, t.icon), ink)
        cv.text(box, at + t.icon + t.gap, label, ink)
    } else {
        cv.text(box, label, ink, Align.center)
    }
}

/* Text on `fill`: the theme's over a translucent fill, which shows the
 * surface under it; over an opaque one, the accent's text when the fill is
 * dark and near-black when it is light. */
on(t: *Theme, fill: Color): Color {
    if fill.a < 1.0 { return t.text }
    if 0.2126 * fill.r + 0.7152 * fill.g + 0.0722 * fill.b < 0.44 { return t.on_accent }
    return Color { r = 0.1, g = 0.1, b = 0.1, a = 1.0 }
}

/* A line `s` in `color` and weight `w` at `align` in `box`. */
pub text(cv: *Canvas, t: *Theme, box: Rect, s: string, color: Color, align: Align, w: Weight) {
    cv.text(box, s, color, align, w)
}

/* A section's title `s` in the heading color at `align` in `box`. */
pub heading(cv: *Canvas, t: *Theme, box: Rect, s: string, align: Align) {
    cv.text(box, s, t.heading, align, Weight.bold)
}

/* `s` centered on a fill like a resting button's. */
pub readout(cv: *Canvas, t: *Theme, box: Rect, s: string) {
    cv.fill(box, t.radius, t.button.rest)
    cv.text(box, s, t.text, Align.center)
}

/* `shape` in `color`, on a button's resting gray while `selected`. */
pub swatch(cv: *Canvas, t: *Theme, box: Rect, shape: Icon, color: Color, selected: bool) {
    if selected { cv.fill(box, t.radius, t.button.rest) }
    cv.icon(shape, box.square(t.icon), color)
}

/* A CHECK_SIDE box at `box`'s left, centered on its height: on the accent
 * with a tick while `on`, else filled as a button for `res` inside a
 * hairline; then `label`. */
pub checkbox(cv: *Canvas, t: *Theme, box: Rect, res: Response, on: bool, label: string) {
    side: f32 = CHECK_SIDE
    tick: Rect = box.square(0.0, side)
    if on {
        cv.fill(tick, CHECK_RADIUS, t.accent)
        mark: [3]Point = [
            Point { x = tick.x + 0.29 * side, y = tick.y + 0.52 * side },
            Point { x = tick.x + 0.44 * side, y = tick.y + 0.67 * side },
            Point { x = tick.x + 0.71 * side, y = tick.y + 0.35 * side },
        ]
        cv.stroke(mark[..], false, CHECK_STROKE, t.on_accent)
    } else {
        cv.fill(tick, CHECK_RADIUS, t.button.shade(res))
    }
    cv.text(box, side + t.gap, label, t.text)
}

/* `label` at `box`'s left and a switch at its right, centered on its
 * height: its knob at the far end on `on` while `on`, else at the near end
 * on the off track. */
pub toggle(cv: *Canvas, t: *Theme, box: Rect, on: bool, label: string) {
    track: Rect = box.square(box.w - SWITCH_W, SWITCH_H)
    track.w = SWITCH_W
    color: Color = t.track
    if on { color = t.on }
    cv.fill(track, SWITCH_H / 2.0, color)
    knob: Rect = Rect { x = track.x + KNOB_INSET, y = track.y + KNOB_INSET, w = KNOB_W, h = KNOB_H }
    if on { knob.x = track.x + track.w - KNOB_INSET - KNOB_W }
    raised(cv, t, knob, KNOB_H / 2.0, t.knob)
    cv.text(box, 0.0, label, t.text)
}

/* A slider at `box`: a track filled with the accent up to its knob, which
 * sits `at` (0 to 1) along its travel, and, when `stops` is 2 or more and
 * they have room, a dot under the track at each. */
pub slider(cv: *Canvas, t: *Theme, box: Rect, at: f32, stops: int) {
    r: f32 = SLIDER_KNOB / 2.0
    travel: f32 = box.w - SLIDER_KNOB
    track: Rect = Rect { x = box.x, y = box.y + (box.h - TRACK_H) / 2.0, w = box.w, h = TRACK_H }
    x: f32 = box.x + r + at * travel
    cv.fill(track, TRACK_H / 2.0, t.track)
    cv.fill(Rect { x = track.x, y = track.y, w = x - track.x, h = track.h }, TRACK_H / 2.0, t.accent)
    if stops >= 2 && travel / f32(stops - 1) >= TICK_ROOM {
        for i: int in 0 .. stops {
            tx: f32 = box.x + r + travel * f32(i) / f32(stops - 1)
            cv.fill(Rect { x = tx - DIVIDER_W / 2.0, y = track.y + track.h + TICK_DROP, w = DIVIDER_W, h = TICK_H }, t.track)
        }
    }
    knob: Rect = Rect { x = x - r, y = box.y + (box.h - SLIDER_KNOB) / 2.0, w = SLIDER_KNOB, h = SLIDER_KNOB }
    raised(cv, t, knob, r, t.knob)
}

/* The room a stepped block slider leaves under its block for the ticks. */
pub BAR_TICKS: const f32 = TICK_DROP + TICK_H

/* A block slider at `box`: a block filled as a button rests, the accent
 * across it up to `at` (0 to 1), the block's own shape masked to a flat
 * front, and `s` centered on it. When `stops` is 2 or more the
 * block leaves BAR_TICKS under it, with a tick there at each stop when they
 * have room. */
pub bar(cv: *Canvas, t: *Theme, box: Rect, at: f32, stops: int, s: string) {
    if stops >= 2 { box.h -= BAR_TICKS }
    cv.fill(box, t.radius, t.button.rest)
    w: f32 = box.w * at
    r: f32 = math.min[f32](t.radius, box.h / 2.0)
    cv.fill_until(box, r, box.x + w, t.accent)
    if stops >= 2 && box.w / f32(stops - 1) >= TICK_ROOM {
        for i: int in 0 .. stops {
            tx: f32 = box.x + box.w * f32(i) / f32(stops - 1)
            tx = math.max[f32](box.x + DIVIDER_W / 2.0, math.min[f32](tx, box.x + box.w - DIVIDER_W / 2.0))
            cv.fill(Rect { x = tx - DIVIDER_W / 2.0, y = box.y + box.h + TICK_DROP, w = DIVIDER_W, h = TICK_H }, t.track)
        }
    }
    cv.text(box, s, t.text, Align.center, Weight.regular)
}

/* A picker at `box`: `items` in equal segments on a track filled as a
 * button rests, the one at `chosen` on a raised segment, and a short vertical
 * dash on each boundary the raised segment does not touch. */
pub picker(cv: *Canvas, t: *Theme, box: Rect, items: []string, chosen: usize) {
    inner: Rect = box.inset(Insets.all(SEGMENT_PAD))
    w: f32 = inner.w / f32(items.len)
    cv.fill(box, PILL_RADIUS + SEGMENT_PAD, t.button.rest)
    if chosen < items.len {
        raised(cv, t, Rect { x = inner.x + f32(chosen) * w, y = inner.y, w = w, h = inner.h }, PILL_RADIUS, t.segment)
    }
    for i: usize in 1 .. items.len {
        if i == chosen || i == chosen + 1 { continue }
        cv.fill(Rect { x = inner.x + f32(i) * w - DIVIDER_W / 2.0, y = inner.y + inner.h * DASH_INSET, w = DIVIDER_W, h = inner.h * (1.0 - 2.0 * DASH_INSET) }, t.separator)
    }
    for i: usize in 0 .. items.len {
        cv.text(Rect { x = inner.x + f32(i) * w, y = box.y, w = w, h = box.h }, items[i], t.text, Align.center)
    }
}

/* A card at `box`: the card color, rounder than a control, set off by a
 * contact shadow. */
pub card(cv: *Canvas, t: *Theme, box: Rect) {
    cv.fill(lower(box, CONTACT_DROP), CARD_RADIUS, t.contact)
    cv.fill(box, CARD_RADIUS, t.card)
}

/* Half-pixel separators between `box`'s cells, each `cell` high, inset the
 * padding from its left: a pixel at half the separator's alpha. */
pub separators(cv: *Canvas, t: *Theme, box: Rect, cell: f32) {
    line: Color = fade(t.separator, EDGE)
    for y: f32 = box.y + cell; y < box.y + box.h - 0.5; y += cell {
        cv.fill(Rect { x = box.x + t.padding, y = y, w = box.w - t.padding, h = 1.0 }, line)
    }
}

/* A field at `box` showing `text`, or `hint` muted while it is empty, with a
 * caret before byte `caret` while `focused`. Focused, it sits on the card color in an accent glow. */
pub field(cv: *Canvas, t: *Theme, box: Rect, text: string, hint: string, focused: bool, caret: usize) {
    if focused { cv.shadow(box, t.radius, FOCUS_BLUR, fade(t.accent, FOCUS_GLOW)) }
    if focused { cv.fill(box, t.radius, t.card) } else { cv.fill(box, t.radius, t.button.rest) }
    if text.len == 0 { cv.text(box, t.padding, hint, t.muted) } else { cv.text(box, t.padding, text, t.text) }
    if !focused { return }
    x: f32 = box.x + t.padding + text_width(text[0..caret], Weight.regular)
    cv.fill(Rect { x = x - CARET_W / 2.0, y = box.y + CARET_PAD, w = CARET_W, h = box.h - 2.0 * CARET_PAD }, t.accent)
}

/* A list row at `box` showing `item`: an accent pill while `chosen`, else a
 * pill filled as a button for `res` under the pointer. Its text lines up with
 * the padding from the list's card. */
pub row(cv: *Canvas, t: *Theme, box: Rect, res: Response, chosen: bool, item: string) {
    pad: f32 = t.padding - LIST_PAD
    cv.fill(Rect { x = box.x, y = box.y + box.h - 1.0, w = box.w, h = 1.0 }, fade(t.separator, EDGE))
    if chosen {
        cv.fill(box, PILL_RADIUS, t.accent)
        cv.text(box, pad, item, t.on_accent)
        return
    }
    if res.hover || res.held { cv.fill(box, PILL_RADIUS, t.button.shade(res)) }
    cv.text(box, pad, item, t.text)
}

/* A list's scroll thumb at `box`. */
pub thumb(cv: *Canvas, t: *Theme, box: Rect) { cv.fill(box, box.w / 2.0, t.text) }

/* A popup's background at `box`: a card raised off what is under it by a
 * shadow below. */
pub popup(cv: *Canvas, t: *Theme, box: Rect) {
    cv.shadow(lower(box, SHADOW_DROP), POPUP_RADIUS, SHADOW_BLUR, t.shadow)
    cv.fill(box, POPUP_RADIUS, t.card)
}

/* A popup's title `s` in white text on the darker header strip,
 * across the top of the popup at `box` and `h` high. */
pub title(cv: *Canvas, t: *Theme, box: Rect, h: f32, s: string) {
    strip: Rect = Rect { x = box.x, y = box.y, w = box.w, h = h }
    cv.fill(strip, POPUP_RADIUS, 0.0, t.header)
    cv.text(strip.inset(Insets { left = t.padding, right = t.padding }), s, t.on_header, Align.left, Weight.bold)
}
