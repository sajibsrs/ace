/* ui canvas — rectangles, and a layer of triangles that draws shapes, icons
 * and text in one geometry call. */

import math
import Renderer, Texture, Vertex, Point, Color from sdl
import Font from "./face.ace"
import mono from "./font.ace"
import glyphs: "./glyphs.ace"

/* Sets the device pixels per window point, as the renderer's scale, so text is
 * rasterized for the display's own pixels; 1 by default. */
pub set_text_density(d: f32) {
    glyphs.set_density(d)
}

/* How a line of text looks: its font (pkg/ui's `mono` while empty), `size` in pixels per em (kept between 6
 * and 96), its color, `spacing` pixels added after each character, and where
 * it sits in its box. A weight is a font of its own. */
pub Text: struct {
    pub font: Font = Font {},
    pub size: f32 = 16.0,
    pub color: Color = Color {},
    pub spacing: f32 = 0.0,
    pub align: Align = Align.left,
}

/* This style in `color`. */
pub Text.in(const self, color: Color): Text {
    t: Text = self
    t.color = color
    return t
}

/* This style at `align`. */
pub Text.at(const self, align: Align): Text {
    t: Text = self
    t.align = align
    return t
}

/* Where `f`'s glyph for byte `c` sits in its tables; a byte it lacks takes a
 * space's place. */
glyph(f: *Font, c: u8): usize {
    k: usize = usize(c)
    if k < f.first || k > f.last { k = f.first }
    return k - f.first
}

/* `style` with its font, `mono` while it has none. */
pub Text.resolve(const self): Text {
    t: Text = self
    if t.font.points.len == 0 { t.font = mono() }
    return t
}

/* How wide `text` is, in pixels, in `style`. */
pub text_width(text: string, style: Text): f32 {
    style = style.resolve()
    sum: f32 = 0.0
    for k: usize in 0 .. text.len { sum += style.font.advance[glyph(&style.font, text[k])] }
    return sum * glyphs.clamp(style.size) / style.font.em + style.spacing * f32(text.len)
}

/* A rectangle in window pixels: its top-left corner (x, y), width, and height. */
pub Rect: struct {
    pub x: f32 = 0.0,
    pub y: f32 = 0.0,
    pub w: f32 = 0.0,
    pub h: f32 = 0.0,
}

/* Whether window point (x, y) lies in the rectangle. */
pub Rect.has(const self, x: f32, y: f32): bool {
    return x >= self.x && x < self.x + self.w && y >= self.y && y < self.y + self.h
}

/* Space kept inside each edge of a rectangle. */
pub Insets: struct {
    pub top: f32 = 0.0,
    pub right: f32 = 0.0,
    pub bottom: f32 = 0.0,
    pub left: f32 = 0.0,
}

/* The same space on every edge. */
pub Insets.all(n: f32): Insets {
    return Insets { top = n, right = n, bottom = n, left = n }
}

/* The rectangle left inside `by`. */
pub Rect.inset(const self, by: Insets): Rect {
    return Rect { x = self.x + by.left, y = self.y + by.top, w = self.w - by.left - by.right, h = self.h - by.top - by.bottom }
}

/* The baseline that centers `style`'s capital letters in the rectangle. */
Rect.baseline(const self, style: Text): f32 {
    return self.y + (self.h + style.font.cap * glyphs.clamp(style.size) / style.font.em) / 2.0
}

/* Removes a strip `w` wide from the left and returns it. */
pub Rect.cut_left(self, w: f32): Rect {
    strip: Rect = Rect { x = self.x, y = self.y, w = w, h = self.h }
    self.x += w
    self.w -= w
    return strip
}

/* Removes a strip `h` high from the top and returns it. */
pub Rect.cut_top(self, h: f32): Rect {
    strip: Rect = Rect { x = self.x, y = self.y, w = self.w, h = h }
    self.y += h
    self.h -= h
    return strip
}

/* A square of `side` centered in the rectangle. */
pub Rect.square(const self, side: f32): Rect {
    return Rect { x = self.x + (self.w - side) / 2.0, y = self.y + (self.h - side) / 2.0, w = side, h = side }
}

/* A square of `side`, `pad` in from the left and centered vertically. */
pub Rect.square(const self, pad: f32, side: f32): Rect {
    return Rect { x = self.x + pad, y = self.y + (self.h - side) / 2.0, w = side, h = side }
}

/* Triangles for one layer, drawn in a single geometry call, or more when it
 * fills: a full layer is flushed to `r`, so nothing is dropped. */
pub Canvas: struct {
    vertices: [16384]Vertex = [Vertex {} : 16384],
    count: usize = 0,
    r: Renderer = Renderer { handle = null },
}

/* An empty layer that draws to `r`. */
pub Canvas.init(r: Renderer): Canvas {
    glyphs.ensure(r)
    return Canvas { r = r }
}

/* A solid triangle `a`, `b`, `c` in `color`. */
pub Canvas.triangle(self, a: Point, b: Point, c: Point, color: Color) {
    if self.count + 3 > self.vertices.len { self.flush() }
    self.vertices[self.count] = Vertex { position = a, color = color }
    self.vertices[self.count + 1] = Vertex { position = b, color = color }
    self.vertices[self.count + 2] = Vertex { position = c, color = color }
    self.count += 3
}

/* `box` filled with `color`, square-cornered. */
pub Canvas.fill(self, box: Rect, color: Color) {
    a: Point = Point { x = box.x, y = box.y }
    b: Point = Point { x = box.x + box.w, y = box.y }
    c: Point = Point { x = box.x + box.w, y = box.y + box.h }
    d: Point = Point { x = box.x, y = box.y + box.h }
    self.triangle(a, b, c, color)
    self.triangle(a, c, d, color)
}

/* A `thick` outline just inside `box`. */
pub Canvas.outline(self, box: Rect, thick: f32, color: Color) {
    self.fill(Rect { x = box.x, y = box.y, w = box.w, h = thick }, color)
    self.fill(Rect { x = box.x, y = box.y + box.h - thick, w = box.w, h = thick }, color)
    self.fill(Rect { x = box.x, y = box.y, w = thick, h = box.h }, color)
    self.fill(Rect { x = box.x + box.w - thick, y = box.y, w = thick, h = box.h }, color)
}

/* The distance from one dash's start to the next along a side `side` long,
 * near 5 times `thick` but even, so the last dash ends on the far corner; 0
 * when the side is too short for two dashes. */
dash_step(side: f32, thick: f32): f32 {
    dash: f32 = 3.0 * thick
    gaps: f32 = math.floor((side - dash) / (5.0 * thick) + 0.5)
    if gaps < 1.0 { return 0.0 }
    return (side - dash) / gaps
}

/* A `thick` dashed outline just inside `box`, in dashes of 3 times `thick`
 * and gaps near 2 times, so every corner holds a dash; only dashes that reach
 * `view` are drawn. */
pub Canvas.outline_dashed(self, box: Rect, thick: f32, color: Color, view: Rect) {
    dash: f32 = 3.0 * thick
    step: f32 = dash_step(box.w, thick)
    if step == 0.0 { step = box.w + 1.0 }
    x: f32 = box.x
    for x < box.x + box.w - 0.5 {
        w: f32 = math.min[f32](dash, box.x + box.w - x)
        if x + w > view.x && x < view.x + view.w {
            self.fill(Rect { x = x, y = box.y, w = w, h = thick }, color)
            self.fill(Rect { x = x, y = box.y + box.h - thick, w = w, h = thick }, color)
        }
        x += step
    }
    step = dash_step(box.h, thick)
    if step == 0.0 { step = box.h + 1.0 }
    y: f32 = box.y
    for y < box.y + box.h - 0.5 {
        h: f32 = math.min[f32](dash, box.y + box.h - y)
        if y + h > view.y && y < view.y + view.h {
            self.fill(Rect { x = box.x, y = y, w = thick, h = h }, color)
            self.fill(Rect { x = box.x + box.w - thick, y = y, w = thick, h = h }, color)
        }
        y += step
    }
}

/* Each corner's arc, a quarter turn in ROUND_STEPS even steps. */
ROUND_STEPS: const usize = 5
ROUND_POINTS: const usize = 4 * ROUND_STEPS
ROUND_C: [ROUND_STEPS]f32 = [1.0, 0.9239, 0.7071, 0.3827, 0.0]
ROUND_S: [ROUND_STEPS]f32 = [0.0, 0.3827, 0.7071, 0.9239, 1.0]

/* `box` with corners of `radius`, its edge fading out over one pixel. */
pub Canvas.fill(self, box: Rect, radius: f32, color: Color) {
    self.fill(box, radius, radius, color)
}

/* `box` with top corners of `top` and bottom corners of `bottom`, its edge
 * fading out over one pixel. */
pub Canvas.fill(self, box: Rect, top: f32, bottom: f32, color: Color) {
    self.fill(box, top, bottom, box.x + box.w, color)
}

/* `box` with corners of `radius`, masked to the part left of `cut`: its
 * shape stays the box's, and the cut edge is straight and fades out over
 * one pixel as the rest does. */
pub Canvas.fill_until(self, box: Rect, radius: f32, cut: f32, color: Color) {
    self.fill(box, radius, radius, cut, color)
}

Canvas.fill(self, box: Rect, top: f32, bottom: f32, cut: f32, color: Color) {
    if box.w <= 0.0 || box.h <= 0.0 || cut <= box.x { return }
    most: f32 = math.min[f32](box.w, box.h) / 2.0
    rad: f32 = math.min[f32](top, most)
    low: f32 = math.min[f32](bottom, most)
    if rad <= 0.5 && low <= 0.5 {
        self.fill(Rect { x = box.x, y = box.y, w = math.min[f32](box.w, cut - box.x), h = box.h }, color)
        return
    }
    /* A square corner is one of half a pixel: its inner points meet at the
     * corner, so the fan does not fold over itself. */
    rad = math.max[f32](rad, 0.5)
    low = math.max[f32](low, 0.5)
    n: usize = ROUND_POINTS
    if self.count + 9 * n > self.vertices.len { self.flush() }
    clear: Color = Color { r = color.r, g = color.g, b = color.b, a = 0.0 }
    inner: [ROUND_POINTS]Point = [Point {} : ROUND_POINTS]
    outer: [ROUND_POINTS]Point = [Point {} : ROUND_POINTS]
    /* Clockwise on screen from the top-left corner's left end. */
    for k: usize in 0 .. ROUND_STEPS {
        c: f32 = ROUND_C[k]
        s: f32 = ROUND_S[k]
        self.arc(inner[..], outer[..], k, box.x + rad, box.y + rad, -c, -s, rad)
        self.arc(inner[..], outer[..], k + ROUND_STEPS, box.x + box.w - rad, box.y + rad, s, -c, rad)
        self.arc(inner[..], outer[..], k + 2 * ROUND_STEPS, box.x + box.w - low, box.y + box.h - low, c, s, low)
        self.arc(inner[..], outer[..], k + 3 * ROUND_STEPS, box.x + low, box.y + box.h - low, -s, c, low)
    }
    /* The mask: points past `cut` move onto it, which turns the outline
     * there into a straight edge. */
    if cut < box.x + box.w {
        for k: usize in 0 .. n {
            inner[k].x = math.min[f32](inner[k].x, cut - 0.5)
            outer[k].x = math.min[f32](outer[k].x, cut + 0.5)
        }
    }
    for k: usize in 1 .. n - 1 { self.triangle(inner[0], inner[k], inner[k + 1], color) }
    for k: usize in 0 .. n {
        j: usize = (k + 1) % n
        self.quad(Vertex { position = inner[k], color = color }, Vertex { position = inner[j], color = color },
            Vertex { position = outer[j], color = clear }, Vertex { position = outer[k], color = clear })
    }
}

/* Point `k` of a rounded box, around (x, y) along direction (dx, dy). */
Canvas.arc(self, inner: []Point, outer: []Point, k: usize, x: f32, y: f32, dx: f32, dy: f32, rad: f32) {
    inner[k] = Point { x = x + dx * (rad - 0.5), y = y + dy * (rad - 0.5) }
    outer[k] = Point { x = x + dx * (rad + 0.5), y = y + dy * (rad + 0.5) }
}

/* A quadrilateral `a`, `b`, `c`, `d` in order, as two triangles, each corner
 * keeping its vertex color. */
pub Canvas.quad(self, a: Vertex, b: Vertex, c: Vertex, d: Vertex) {
    if self.count + 6 > self.vertices.len { self.flush() }
    self.vertices[self.count] = a
    self.vertices[self.count + 1] = b
    self.vertices[self.count + 2] = c
    self.vertices[self.count + 3] = a
    self.vertices[self.count + 4] = c
    self.vertices[self.count + 5] = d
    self.count += 6
}

/* The ring `d` outside the edge of `box`, whose corners are `rad`, into `pts`
 * (inside when `d` is negative): its corners round by `rad` + `d`, or are
 * square once that reaches 0. Clockwise on screen from the top-left corner's
 * left end, as `fill` runs. */
ring(pts: []Point, box: Rect, rad: f32, d: f32) {
    r: f32 = math.max[f32](rad + d, 0.0)
    x0: f32 = box.x - d + r
    y0: f32 = box.y - d + r
    x1: f32 = box.x + box.w + d - r
    y1: f32 = box.y + box.h + d - r
    for k: usize in 0 .. ROUND_STEPS {
        c: f32 = ROUND_C[k]
        s: f32 = ROUND_S[k]
        pts[k] = Point { x = x0 - c * r, y = y0 - s * r }
        pts[k + ROUND_STEPS] = Point { x = x1 + s * r, y = y0 - c * r }
        pts[k + 2 * ROUND_STEPS] = Point { x = x1 + c * r, y = y1 + s * r }
        pts[k + 3 * ROUND_STEPS] = Point { x = x0 - s * r, y = y1 + c * r }
    }
}

/* The band between rings `a` and `b`, shading from `ca` to `cb`. */
Canvas.band(self, a: []Point, ca: Color, b: []Point, cb: Color) {
    n: usize = a.len
    for k: usize in 0 .. n {
        j: usize = (k + 1) % n
        self.quad(Vertex { position = a[k], color = ca }, Vertex { position = a[j], color = ca },
            Vertex { position = b[j], color = cb }, Vertex { position = b[k], color = cb })
    }
}

/* `color` at `a` times its alpha. */
fade(color: Color, a: f32): Color {
    return Color { r = color.r, g = color.g, b = color.b, a = color.a * a }
}

/* A blur's edge: its cover `d` inside the edge of what casts it, for a blur
 * reaching `blur` each way, the normal distribution's at 0, 1 and 2 standard
 * deviations and straight between. */
cover(d: f32, blur: f32): f32 {
    x: f32 = math.min[f32](math.max[f32](d / blur, -1.0), 1.0)
    if x < -0.5 { return 0.32 * (x + 1.0) }
    if x < 0.5 { return 0.5 + 0.68 * x }
    return 0.84 + 0.32 * (x - 0.5)
}

/* The soft shadow of `box`, whose corners are `radius`: `color` where `box`
 * covers fully, fading out across `blur` either side of its edge, as a
 * Gaussian blur of standard deviation `blur` / 2 does. A box narrower than
 * twice `blur` casts a fainter, tighter shadow. The caller offsets `box`. */
pub Canvas.shadow(self, box: Rect, radius: f32, blur: f32, color: Color) {
    if box.w <= 0.0 || box.h <= 0.0 { return }
    if blur <= 0.5 {
        self.fill(box, radius, color)
        return
    }
    half: f32 = math.min[f32](box.w, box.h) / 2.0
    rad: f32 = math.min[f32](radius, half)
    b: f32 = math.min[f32](blur, half)
    peak: Color = fade(color, 2.0 * cover(half, blur) - 1.0)
    if self.count + 3 * (ROUND_POINTS - 2) + 24 * ROUND_POINTS > self.vertices.len { self.flush() }
    core: [ROUND_POINTS]Point = [Point {} : ROUND_POINTS]
    inner: [ROUND_POINTS]Point = [Point {} : ROUND_POINTS]
    edge: [ROUND_POINTS]Point = [Point {} : ROUND_POINTS]
    outer: [ROUND_POINTS]Point = [Point {} : ROUND_POINTS]
    rim: [ROUND_POINTS]Point = [Point {} : ROUND_POINTS]
    ring(core[..], box, rad, -b)
    ring(inner[..], box, rad, -b / 2.0)
    ring(edge[..], box, rad, 0.0)
    ring(outer[..], box, rad, b / 2.0)
    ring(rim[..], box, rad, b)
    for k: usize in 1 .. ROUND_POINTS - 1 { self.triangle(core[0], core[k], core[k + 1], peak) }
    self.band(core[..], peak, inner[..], fade(peak, 0.84))
    self.band(inner[..], fade(peak, 0.84), edge[..], fade(peak, 0.5))
    self.band(edge[..], fade(peak, 0.5), outer[..], fade(peak, 0.16))
    self.band(outer[..], fade(peak, 0.16), rim[..], fade(peak, 0.0))
}

/* A `thick` outline just inside `box`, with corners of `radius`, its edges
 * fading out over one pixel straddling them, as `fill`'s does. Thinner than a
 * pixel, it draws a pixel's width at `thick` of `color`'s alpha. */
pub Canvas.outline(self, box: Rect, radius: f32, thick: f32, color: Color) {
    if box.w <= 0.0 || box.h <= 0.0 || thick <= 0.0 { return }
    half: f32 = math.min[f32](box.w, box.h) / 2.0
    rad: f32 = math.min[f32](radius, half)
    w: f32 = math.min[f32](math.max[f32](thick, 1.0), half)
    ink: Color = fade(color, math.min[f32](thick, 1.0))
    clear: Color = fade(color, 0.0)
    if self.count + 18 * ROUND_POINTS > self.vertices.len { self.flush() }
    outer: [ROUND_POINTS]Point = [Point {} : ROUND_POINTS]
    a: [ROUND_POINTS]Point = [Point {} : ROUND_POINTS]
    b: [ROUND_POINTS]Point = [Point {} : ROUND_POINTS]
    inner: [ROUND_POINTS]Point = [Point {} : ROUND_POINTS]
    ring(outer[..], box, rad, 0.5)
    ring(a[..], box, rad, -0.5)
    ring(b[..], box, rad, 0.5 - w)
    ring(inner[..], box, rad, -0.5 - w)
    self.band(outer[..], clear, a[..], ink)
    if w > 1.0 { self.band(a[..], ink, b[..], ink) }
    self.band(b[..], ink, inner[..], clear)
}

/* Most points of one icon or glyph polygon. */
SHAPE_MAX: const usize = 128
/* Stroke of an icon's lines, in grid units. */
STROKE: const f32 = 3.5

/* A `thick` stroke through `pts`, joined at its corners and square-capped
 * unless `closed`, anti-aliased: an opaque ribbon whose edges fade out over
 * one pixel straddling the true edge. */
pub Canvas.stroke(self, pts: []Point, closed: bool, thick: f32, color: Color) {
    n: usize = pts.len
    if n < 2 || n > SHAPE_MAX { return }
    if self.count + 18 * n + 12 > self.vertices.len { self.flush() }
    clear: Color = Color { r = color.r, g = color.g, b = color.b, a = 0.0 }
    /* The opaque ribbon reaches `fill` from the path; the fade, `fade`. */
    fill: f32 = thick / 2.0 - 0.5
    fade: f32 = thick / 2.0 + 0.5
    /* Both edges of the ribbon, and where each fades out, at every point. */
    a: [SHAPE_MAX]Point = [Point {} : SHAPE_MAX]
    b: [SHAPE_MAX]Point = [Point {} : SHAPE_MAX]
    oa: [SHAPE_MAX]Point = [Point {} : SHAPE_MAX]
    ob: [SHAPE_MAX]Point = [Point {} : SHAPE_MAX]
    for k: usize in 0 .. n {
        here: Point = pts[k]
        mx: f32 = 0.0
        my: f32 = 0.0
        scale: f32 = 1.0
        if !closed && k == 0 {
            m: Point = turn(here, pts[1])
            mx = m.x
            my = m.y
            /* The cap pushes the end back by what the ribbon reaches. */
            here = Point { x = here.x + my * fill, y = here.y - mx * fill }
        } else if !closed && k == n - 1 {
            m: Point = turn(pts[n - 2], here)
            mx = m.x
            my = m.y
            here = Point { x = here.x - my * fill, y = here.y + mx * fill }
        } else {
            n1: Point = turn(pts[(k + n - 1) % n], here)
            n2: Point = turn(here, pts[(k + 1) % n])
            mx = n1.x + n2.x
            my = n1.y + n2.y
            ml: f32 = math.sqrt(mx * mx + my * my)
            if ml < 0.0001 {
                mx = n1.x
                my = n1.y
                ml = 1.0
            }
            mx /= ml
            my /= ml
            cosine: f32 = mx * n1.x + my * n1.y
            if cosine < 0.5 { cosine = 0.5 }
            scale = 1.0 / cosine
        }
        a[k] = Point { x = here.x + mx * fill * scale, y = here.y + my * fill * scale }
        b[k] = Point { x = here.x - mx * fill * scale, y = here.y - my * fill * scale }
        oa[k] = Point { x = here.x + mx * fade * scale, y = here.y + my * fade * scale }
        ob[k] = Point { x = here.x - mx * fade * scale, y = here.y - my * fade * scale }
    }
    last: usize = n - 1
    if closed { last = n }
    for k: usize in 0 .. last {
        j: usize = (k + 1) % n
        self.quad(Vertex { position = a[k], color = color }, Vertex { position = a[j], color = color },
            Vertex { position = b[j], color = color }, Vertex { position = b[k], color = color })
        self.quad(Vertex { position = a[k], color = color }, Vertex { position = a[j], color = color },
            Vertex { position = oa[j], color = clear }, Vertex { position = oa[k], color = clear })
        self.quad(Vertex { position = b[k], color = color }, Vertex { position = b[j], color = color },
            Vertex { position = ob[j], color = clear }, Vertex { position = ob[k], color = clear })
    }
    if closed { return }
    /* A cap's fade runs one pixel past each end, along the path. */
    d0: Point = turn(b[0], a[0])
    d1: Point = turn(a[last], b[last])
    self.quad(Vertex { position = a[0], color = color }, Vertex { position = b[0], color = color },
        Vertex { position = Point { x = b[0].x + d0.x, y = b[0].y + d0.y }, color = clear },
        Vertex { position = Point { x = a[0].x + d0.x, y = a[0].y + d0.y }, color = clear })
    self.quad(Vertex { position = a[last], color = color }, Vertex { position = b[last], color = color },
        Vertex { position = Point { x = b[last].x + d1.x, y = b[last].y + d1.y }, color = clear },
        Vertex { position = Point { x = a[last].x + d1.x, y = a[last].y + d1.y }, color = clear })
}

/* An icon: where its shapes start in baked `points`. */
pub Icon: struct {
    pub points: []f32 = [],
    pub start: usize = 0,
}

/* `shape` drawn in the largest square that fits `box`, centered: bold lines
 * and filled polygons whose edges fade out over one pixel. Flushes whenever
 * the layer fills. An `Icon {}`, with no points, draws nothing. */
pub Canvas.icon(self, shape: Icon, box: Rect, color: Color) {
    if shape.points.len == 0 { return }
    side: f32 = box.w
    if box.h < side { side = box.h }
    unit: f32 = side / 24.0
    ox: f32 = box.x + (box.w - side) / 2.0
    oy: f32 = box.y + (box.h - side) / 2.0
    self.shapes(shape.points, shape.start, ox, oy, unit, color)
}

/* The shapes of `data` from index `i` to its -9 end mark, each point scaled
 * by `unit` and moved to (ox, oy). */
Canvas.shapes(self, data: []f32, at: usize, ox: f32, oy: f32, unit: f32, color: Color) {
    clear: Color = Color { r = color.r, g = color.g, b = color.b, a = 0.0 }
    edge: [SHAPE_MAX]Point = [Point {} : SHAPE_MAX]
    inner: [SHAPE_MAX]Point = [Point {} : SHAPE_MAX]
    outer: [SHAPE_MAX]Point = [Point {} : SHAPE_MAX]
    /* The corner neighbors a fringe follows, and the bridge edges it skips. */
    prev: [SHAPE_MAX]usize
    next: [SHAPE_MAX]usize
    bridge: [SHAPE_MAX]bool = [false : SHAPE_MAX]
    i: usize = at
    for data[i] != -9.0 {
        tag: f32 = data[i]
        n: usize = usize(data[i + 1])
        i += 2
        if tag != -2.0 && tag != -4.0 {
            if n > SHAPE_MAX { return }
            for k: usize in 0 .. n {
                edge[k] = Point { x = ox + data[i + 2 * k] * unit, y = oy + data[i + 2 * k + 1] * unit }
            }
            self.stroke(edge[0..n], tag == -3.0, STROKE * unit, color)
            i += 2 * n
            continue
        }
        if n > SHAPE_MAX { return }
        for k: usize in 0 .. n {
            edge[k] = Point { x = ox + data[i + 2 * k] * unit, y = oy + data[i + 2 * k + 1] * unit }
        }
        i += 2 * n
        tris: usize = i
        i += 3 * (n - 2)
        for k: usize in 0 .. n {
            prev[k] = (k + n - 1) % n
            next[k] = (k + 1) % n
            bridge[k] = false
        }
        /* A bridge a -> b, c -> d (b at c's point, d at a's) is a zero-width
         * cut: it draws no fringe, and its corners follow the true outline
         * and hole edges around it. */
        if tag == -4.0 {
            for m: usize in 0 .. usize(data[i]) {
                a: usize = usize(data[i + 1 + 2 * m])
                c: usize = usize(data[i + 2 + 2 * m])
                b: usize = (a + 1) % n
                d: usize = (c + 1) % n
                bridge[a] = true
                bridge[c] = true
                next[a] = (d + 1) % n
                prev[d] = (a + n - 1) % n
                prev[b] = (c + n - 1) % n
                next[c] = (b + 1) % n
            }
            i += 1 + 2 * usize(data[i])
        }
        /* Each point moves half a pixel in and out along its corner's
         * bisector, so the fringe between the two straddles the true edge. */
        for k: usize in 0 .. n {
            before: Point = edge[prev[k]]
            here: Point = edge[k]
            after: Point = edge[next[k]]
            n1: Point = turn(before, here)
            n2: Point = turn(here, after)
            mx: f32 = n1.x + n2.x
            my: f32 = n1.y + n2.y
            ml: f32 = math.sqrt(mx * mx + my * my)
            if ml < 0.0001 {
                mx = n1.x
                my = n1.y
                ml = 1.0
            }
            mx /= ml
            my /= ml
            /* A sharp corner reaches farther, up to twice. */
            cosine: f32 = mx * n1.x + my * n1.y
            if cosine < 0.5 { cosine = 0.5 }
            reach: f32 = 0.5 / cosine
            inner[k] = Point { x = here.x - mx * reach, y = here.y - my * reach }
            outer[k] = Point { x = here.x + mx * reach, y = here.y + my * reach }
        }
        if self.count + 3 * (n - 2) + 6 * n > self.vertices.len { self.flush() }
        for t: usize in 0 .. n - 2 {
            a: usize = usize(data[tris + 3 * t])
            b: usize = usize(data[tris + 3 * t + 1])
            c: usize = usize(data[tris + 3 * t + 2])
            self.triangle(inner[a], inner[b], inner[c], color)
        }
        for k: usize in 0 .. n {
            if bridge[k] { continue }
            j: usize = (k + 1) % n
            self.quad(Vertex { position = inner[k], color = color }, Vertex { position = inner[j], color = color },
                Vertex { position = outer[j], color = clear }, Vertex { position = outer[k], color = clear })
        }
    }
}

/* The unit normal of the edge from a to b, pointing out of a polygon wound
 * clockwise on screen. */
turn(a: Point, b: Point): Point {
    dx: f32 = b.x - a.x
    dy: f32 = b.y - a.y
    length: f32 = math.sqrt(dx * dx + dy * dy)
    if length < 0.0001 { length = 0.0001 }
    return Point { x = dy / length, y = -dx / length }
}

/* Draws the layer and empties it for the next. */
pub Canvas.flush(self) {
    none: []i32 = []
    t: Texture = glyphs.texture()
    self.r.geometry(t, self.vertices[0..self.count], none)
    self.count = 0
}

/* `rgb` as a vertex color. */
pub color(rgb: u32): Color {
    return Color.hex(rgb)
}

/* `text` in `style` with its baseline at window point (x, y), in this layer.
 * The baseline sits on a whole pixel; each glyph sits on a whole pixel plus a
 * quarter-pixel phase, from the atlas, so spacing stays even. */
Canvas.print(self, x: f32, y: f32, text: string, style: Text) {
    f: *Font = &style.font
    glyphs.ensure(self.r)
    if glyphs.texture().handle == null { return }
    size: f32 = glyphs.clamp(style.size)
    color: Color = style.color
    d: f32 = glyphs.density()
    unit: f32 = size / f.em * d
    base: f32 = math.floor(y * d + 0.5)
    pen: f32 = x * d
    fi: usize = glyphs.face(f)
    for k: usize in 0 .. text.len {
        g: usize = glyph(f, text[k])
        c: usize = usize(text[k])
        if c > f.first && c <= f.last {
            whole: f32 = math.floor(pen)
            phase: usize = usize((pen - whole) * 4.0)
            if phase > 3 { phase = 3 }
            at: usize = glyphs.MISS
            if fi != glyphs.FULL { at = glyphs.lookup(fi, f, size, c, phase) }
            if at == glyphs.MISS {
                /* Full: draw what refers to the old atlas, then start over. */
                self.flush()
                self.r.flush()
                glyphs.reset()
                fi = glyphs.face(f)
                at = glyphs.lookup(fi, f, size, c, phase)
            }
            s: glyphs.Slot = glyphs.slot(at)
            if s.w > 0 {
                x0: f32 = (whole + f32(s.left)) / d
                y0: f32 = (base + f32(s.top)) / d
                side: f32 = f32(glyphs.SIDE)
                u0: f32 = f32(s.x) / side
                v0: f32 = f32(s.y) / side
                u1: f32 = f32(s.x + s.w) / side
                v1: f32 = f32(s.y + s.h) / side
                x1: f32 = x0 + f32(s.w) / d
                y1: f32 = y0 + f32(s.h) / d
                self.quad(Vertex { position = Point { x = x0, y = y0 }, color = color, tex_coord = Point { x = u0, y = v0 } },
                    Vertex { position = Point { x = x1, y = y0 }, color = color, tex_coord = Point { x = u1, y = v0 } },
                    Vertex { position = Point { x = x1, y = y1 }, color = color, tex_coord = Point { x = u1, y = v1 } },
                    Vertex { position = Point { x = x0, y = y1 }, color = color, tex_coord = Point { x = u0, y = v1 } })
            }
        }
        pen += f.advance[g] * unit + style.spacing * d
    }
}

/* Where text sits in a box. */
pub Align: enum {
    left,
    center,
    right,
}

/* `text` in `style`, placed in `box` by its alignment, in this layer. */
pub Canvas.text(self, box: Rect, text: string, style: Text) {
    style = style.resolve()
    pad: f32 = 0.0
    if style.align == Align.center { pad = (box.w - text_width(text, style)) / 2.0 }
    if style.align == Align.right { pad = box.w - text_width(text, style) }
    self.print(box.x + pad, box.baseline(style), text, style)
}
