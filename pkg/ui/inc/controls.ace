/* ui controls — buttons, toggles, value controls and text, each placed in the
 * current area and tracked here, and drawn by `look.ace`. */

import math
import Color, Keycode from sdl
import Rect, Insets, Icon, Align, TEXT_SIZE, GLYPH_WIDTH from "./canvas.ace"
import Keyboard, KEY_DELETE, KEY_HOME, KEY_END from "./input.ace"
import context: "./context.ace"
import Context, Item from "./context.ace"
import Fill, Theme, Response from "./theme.ace"
import look: "./look.ace"

/* A list's scroll thumb, inside its right edge. */
THUMB_W: const f32 = 4.0
THUMB_MIN: const f32 = 16.0

/* Places and draws a button in `fill`, with an icon when `icon`, and says
 * whether it was clicked. */
press(id: u32, shape: Icon, icon: bool, label: string, fill: Fill): bool {
    c: *Context = context.current
    box: Rect = context.place(context.measure(icon, label), context.frame())
    res: Response = context.track(context.claim(id), box)
    look.button(c.canvas, &c.theme, box, res, shape, icon, label, fill)
    return res.click
}

/* A button showing `label`, which names it; true when clicked. */
pub button(label: string): bool {
    c: *Context = context.current
    return press(context.id(label), Icon {}, false, label, c.theme.button)
}

/* An icon and `label`, which names it. */
pub button(shape: Icon, label: string): bool {
    c: *Context = context.current
    return press(name(shape, label), shape, true, label, c.theme.button)
}

/* An icon alone, which names it. */
pub button(shape: Icon): bool {
    c: *Context = context.current
    return press(context.id(shape), shape, true, "", c.theme.button)
}

/* A button that rests on the accent while `on`, as a chosen tool does. */
pub button(shape: Icon, label: string, on: bool): bool {
    c: *Context = context.current
    fill: Fill = c.theme.button
    if on { fill = c.theme.chosen() }
    return press(name(shape, label), shape, true, label, fill)
}

/* A button in `fill` rather than the theme's. */
pub button(shape: Icon, label: string, fill: Fill): bool {
    return press(name(shape, label), shape, true, label, fill)
}

/* The id of a button: its label's, or its icon's when it has none. */
name(shape: Icon, label: string): u32 {
    if label.len == 0 { return context.id(shape) }
    return context.id(label)
}

/* A button that flips `value` when clicked and rests on the accent while it
 * is set; `value`'s address names it. True when it flipped. */
pub toggle(shape: Icon, label: string, value: *bool): bool {
    c: *Context = context.current
    fill: Fill = c.theme.button
    if *value { fill = c.theme.chosen() }
    if !press(context.id(usize(value)), shape, true, label, fill) { return false }
    *value = !*value
    return true
}

/* A toggle showing its icon alone. */
pub toggle(shape: Icon, value: *bool): bool { return toggle(shape, "", value) }

/* `label` then a switch that is on while `value` is set; a click anywhere on
 * it flips `value`, whose address names it. True when it flipped. */
pub toggle(label: string, value: *bool): bool {
    c: *Context = context.current
    t: *Theme = &c.theme
    box: Rect = context.place(f32(label.len) * GLYPH_WIDTH + t.gap + look.SWITCH_W, context.frame())
    res: Response = context.track(context.claim(context.id(usize(value))), box)
    if res.click { *value = !*value }
    look.toggle(c.canvas, t, box, *value, label)
    return res.click
}

/* Equal segments showing `items`, the one at `*chosen` raised; a click on a
 * segment sets `*chosen` to it. `chosen`'s address names it. True when
 * `*chosen` changed. */
pub picker(items: []string, chosen: *usize): bool {
    c: *Context = context.current
    t: *Theme = &c.theme
    assert(items.len > 0)
    w: f32 = 0.0
    for i: usize in 0 .. items.len { w += f32(items[i].len) * GLYPH_WIDTH + 2.0 * t.padding }
    box: Rect = context.place(w, context.frame())
    base: u32 = context.claim(context.id(usize(chosen)))
    each: f32 = box.w / f32(items.len)
    changed: bool = false
    for i: usize in 0 .. items.len {
        at: Rect = Rect { x = box.x + f32(i) * each, y = box.y, w = each, h = box.h }
        res: Response = context.track(context.derive(base, i), at)
        if res.click && *chosen != i {
            *chosen = i
            changed = true
        }
    }
    look.picker(c.canvas, t, box, items, *chosen)
    context.record(Item { hovered = context.reachable() && c.mouse.over(box), rect = box })
    return changed
}

/* `s` in `color`, a text line high, at `align` in its place: as wide as it,
 * or the area's width when not left. */
print(s: string, color: Color, align: Align) {
    w: f32 = f32(s.len) * GLYPH_WIDTH
    if align != Align.left && !context.across() { w = context.span() }
    box: Rect = context.place(w, TEXT_SIZE)
    context.record(Item { rect = box })
    c: *Context = context.current
    look.text(c.canvas, &c.theme, box, s, color, align)
}

/* A line of body text. */
pub text(s: string) { print(s, context.current.theme.text, Align.left) }

/* A line of body text at `align`. */
pub text(s: string, align: Align) { print(s, context.current.theme.text, align) }

/* A line of secondary text. */
pub muted(s: string) { print(s, context.current.theme.muted, Align.left) }

/* A line of secondary text at `align`. */
pub muted(s: string, align: Align) { print(s, context.current.theme.muted, align) }

/* A section's title in muted text on a strip a control high, which reaches
 * half the padding past the area's sides. */
pub heading(s: string) { heading(s, Align.left) }

/* A section's title at `align` on its strip. */
pub heading(s: string, align: Align) {
    c: *Context = context.current
    t: *Theme = &c.theme
    box: Rect = context.place(f32(s.len) * GLYPH_WIDTH + 2.0 * t.padding, t.height)
    context.record(Item { rect = box })
    look.heading(c.canvas, t, box, s, align)
}

/* `s` centered on a fill like a resting button's: a value shown, not
 * edited. */
pub readout(s: string) {
    c: *Context = context.current
    t: *Theme = &c.theme
    box: Rect = context.place(f32(s.len) * GLYPH_WIDTH + 2.0 * t.padding, context.frame())
    context.record(Item { rect = box })
    look.readout(c.canvas, t, box, s)
}

/* A square showing `shape` in `color`, on the accent while `selected`; the
 * pointer changes nothing. Its icon names it. True when clicked. */
pub swatch(shape: Icon, color: Color, selected: bool): bool {
    c: *Context = context.current
    side: f32 = context.frame()
    if !context.across() { side = context.span() }
    box: Rect = context.place(side, side)
    res: Response = context.track(context.claim(context.id(shape)), box)
    look.swatch(c.canvas, &c.theme, box, shape, color, selected)
    return res.click
}

/* A box ticked while `value` is set, then `label`; a click anywhere on it
 * flips `value`, whose address names it. True when it flipped. */
pub checkbox(label: string, value: *bool): bool {
    c: *Context = context.current
    t: *Theme = &c.theme
    box: Rect = context.place(look.CHECK_SIDE + t.gap + f32(label.len) * GLYPH_WIDTH, context.frame())
    res: Response = context.track(context.claim(context.id(usize(value))), box)
    if res.click { *value = !*value }
    look.checkbox(c.canvas, t, box, res, *value, label)
    return res.click
}

/* A slider's width across an area, unless `width` sets it. */
SLIDER_GLYPHS: const f32 = 12.0

/* Places a slider for the value at `address` and tracks it: where the
 * pointer holds its knob's center along its travel, 0 to 1, or -1 while it is
 * not held. */
grab(address: usize): f32 {
    c: *Context = context.current
    box: Rect = context.place(SLIDER_GLYPHS * GLYPH_WIDTH + 2.0 * c.theme.padding, context.frame())
    res: Response = context.track(context.claim(context.id(address)), box)
    if !res.held { return -1.0 }
    travel: f32 = box.w - look.SLIDER_KNOB
    if travel <= 0.0 { return 0.0 }
    return math.max[f32](0.0, math.min[f32](1.0, (c.mouse.x - box.x - look.SLIDER_KNOB / 2.0) / travel))
}

/* A knob dragged along a track to set `value` from `min` to `max`, the track
 * filled up to it; `value`'s address names it. True when it changed. */
pub slider(value: *f32, min: f32, max: f32): bool {
    c: *Context = context.current
    at: f32 = grab(usize(value))
    before: f32 = *value
    if at >= 0.0 { *value = min + at * (max - min) }
    look.slider(c.canvas, &c.theme, context.last().rect, (*value - min) / (max - min), 0)
    return *value != before
}

/* A knob that stops at each whole number from `min` to `max`, set to the
 * stop nearest the pointer, with a tick at each stop when they have room;
 * `value`'s address names it. True when it changed. */
pub slider(value: *int, min: int, max: int): bool {
    c: *Context = context.current
    n: int = max - min
    at: f32 = grab(usize(value))
    before: int = *value
    if at >= 0.0 { *value = min + int(at * f32(n) + 0.5) }
    shown: f32 = 0.0
    if n > 0 { shown = f32(*value - min) / f32(n) }
    look.slider(c.canvas, &c.theme, context.last().rect, shown, n + 1)
    return *value != before
}

/* Caller storage for a field: the first `len` bytes of `buffer` are in use,
 * with the caret before byte `caret`. `buffer` stays put from frame to frame:
 * its address names the field. */
pub TextInput: struct {
    pub buffer: []u8 = [],
    pub len: usize = 0,
    pub caret: usize = 0,
}

/* The text in use. */
pub TextInput.text(const self): string { return string(self.buffer[0..self.len]) }

/* Removes the byte at `i`. */
TextInput.remove(self, i: usize) {
    for j: usize in i .. self.len - 1 { self.buffer[j] = self.buffer[j + 1] }
    self.len -= 1
}

/* Inserts `c` at the caret and moves past it. */
TextInput.insert(self, c: u8) {
    for j: usize = self.len; j > self.caret; j -= 1 { self.buffer[j] = self.buffer[j - 1] }
    self.buffer[self.caret] = c
    self.len += 1
    self.caret += 1
}

/* A one-line field over `input`, as wide as its buffer across an area. A
 * click or `focus` gives it the keyboard; a press elsewhere takes it away.
 * Focused, it consumes every key and the frame's text, so read a key meant
 * for its owner first; a frame's keys apply before its text. It adds only the
 * printable ASCII bytes in `allow`, or any when `allow` is empty. True when
 * the text changed; Enter sets `last().submit`. */
pub field(input: *TextInput, allow: string): bool {
    c: *Context = context.current
    t: *Theme = &c.theme
    assert(input.buffer.len > 0)
    box: Rect = context.place(2.0 * t.padding + f32(input.buffer.len) * GLYPH_WIDTH, context.frame())
    me: u32 = context.claim(context.id(usize(&input.buffer[0])))
    res: Response = context.track(me, box)
    if context.focusing() || res.press {
        c.focus = me
    } else if c.mouse.pressed && c.focus == me {
        c.focus = 0
    }
    changed: bool = false
    if c.focus == me {
        kb: *Keyboard = &c.keyboard
        for i: usize in 0 .. kb.count {
            if kb.keys[i].used { continue }
            kb.keys[i].used = true
            code: Keycode = kb.keys[i].code
            k: u32 = u32(code)
            if code == Keycode.enter {
                context.submit()
            } else if code == Keycode.backspace {
                if input.caret > 0 {
                    input.remove(input.caret - 1)
                    input.caret -= 1
                    changed = true
                }
            } else if k == KEY_DELETE {
                if input.caret < input.len {
                    input.remove(input.caret)
                    changed = true
                }
            } else if code == Keycode.left {
                if input.caret > 0 { input.caret -= 1 }
            } else if code == Keycode.right {
                if input.caret < input.len { input.caret += 1 }
            } else if k == KEY_HOME {
                input.caret = 0
            } else if k == KEY_END {
                input.caret = input.len
            }
        }
        typed: string = kb.consume()
        for i: usize in 0 .. typed.len {
            b: u8 = typed[i]
            if b < 0x20 || b > 0x7e || input.len == input.buffer.len || !allowed(allow, b) { continue }
            input.insert(b)
            changed = true
        }
    }
    look.field(c.canvas, t, box, input.text(), c.focus == me, input.caret)
    return changed
}

/* Whether `allow` lets `c` in. */
allowed(allow: string, c: u8): bool {
    if allow.len == 0 { return true }
    for i: usize in 0 .. allow.len {
        if allow[i] == c { return true }
    }
    return false
}

/* The height of a list of `n` rows, its card's padding included. */
pub rows(n: usize): f32 { return f32(n) * context.current.theme.row() + 2.0 * look.LIST_PAD }

/* A list of `items` on a card, `rows` of them showing from row `*scroll`
 * on, `*chosen` on an accent pill and the row under the pointer on a pill
 * filled as a button. A press
 * on a row sets `*chosen` to it; true when a row was pressed. Under the
 * pointer and longer than `rows`, it consumes the wheel, a row a notch, and
 * draws a thumb at its right edge. `scroll`'s address names it. */
pub list(items: []string, chosen: *usize, rows: usize, scroll: *f32): bool {
    c: *Context = context.current
    t: *Theme = &c.theme
    h: f32 = t.row()
    box: Rect = context.place(context.span(), f32(rows) * h + 2.0 * look.LIST_PAD)
    inner: Rect = box.inset(Insets.all(look.LIST_PAD))
    look.card(c.canvas, t, box)
    base: u32 = context.claim(context.id(usize(scroll)))
    most: f32 = 0.0
    if items.len > rows { most = f32(items.len - rows) }
    if context.reachable() && c.mouse.over(box) && most > 0.0 {
        *scroll -= c.mouse.wheel
        c.mouse.wheel = 0.0
    }
    *scroll = math.max[f32](0.0, math.min[f32](*scroll, most))
    first: usize = usize(*scroll)
    pressed: bool = false
    for i: usize in first .. math.min[usize](first + rows, items.len) {
        at: Rect = Rect { x = inner.x, y = inner.y + f32(i - first) * h, w = inner.w, h = h }
        res: Response = context.track(context.derive(base, i), at)
        if res.press {
            *chosen = i
            pressed = true
        }
        look.row(c.canvas, t, at, res, i == *chosen, items[i])
    }
    if most > 0.0 {
        thumb: f32 = math.max[f32](inner.h * f32(rows) / f32(items.len), THUMB_MIN)
        y: f32 = inner.y + (inner.h - thumb) * *scroll / most
        bounds: Rect = Rect { x = inner.x + inner.w - THUMB_W, y = y, w = THUMB_W, h = thumb }
        look.thumb(c.canvas, t, bounds)
    }
    context.record(Item { hovered = context.reachable() && c.mouse.over(box), rect = box })
    return pressed
}
