/* ui controls — buttons, toggles, value controls and text, each placed in the
 * current area and tracked here, and drawn by `look.ace`. */

import fmt
import math
import Color, Keycode from sdl
import Rect, Insets, Icon, Align, Text, text_width from "./canvas.ace"
import Keyboard, KEY_DELETE, KEY_HOME, KEY_END from "./input.ace"
import context: "./context.ace"
import Context, Item from "./context.ace"
import Theme, States, Graphical, Labeled, Ruled, Response from "./theme.ace"
import look: "./look.ace"

/* A list's scroll thumb, inside its right edge. */
THUMB_W: const f32 = 4.0
THUMB_MIN: const f32 = 16.0

/* Places and draws a button in `st`, on while `on`, with an icon from
 * `shapes` when `icon`, and says whether it was clicked; never when `disable`
 * came before it. */
press(id: u32, shapes: States[Icon], icon: bool, label: string, st: const *Graphical, on: bool): bool {
    c: *Context = context.current
    off: bool = context.disabled()
    box: Rect = context.place(context.measure(st, icon, label), context.frame() + 2.0 * look.BUTTON_PAD)
    res: Response = Response {}
    if !off { res = context.track(context.claim(id), box) }
    look.button(c.canvas, st, box, res, shapes, icon, label, on, off)
    return res.click
}

/* A button showing `label`, which names it, in `st`; true when clicked. */
pub button(label: string, st: const *Graphical): bool {
    return press(context.id(label), States[Icon].all(Icon {}), false, label, st, false)
}

/* A button showing `label`, in the theme's button style. */
pub button(label: string): bool {
    return button(label, &context.current.theme.button)
}

/* A button in `st`, on while `on`, as a chosen tool is: an icon from `shapes`
 * for its state, then `label`; an icon alone, square, when `label` is empty.
 * The label names it, or the resting icon when it has none. */
pub button(shapes: States[Icon], label: string, on: bool, st: const *Graphical): bool {
    return press(name(shapes.rest, label), shapes, true, label, st, on)
}

/* The full button in the theme's button style. */
pub button(shapes: States[Icon], label: string, on: bool): bool {
    return button(shapes, label, on, &context.current.theme.button)
}

/* An icon, the same in every state, and `label`, in `st`. */
pub button(shape: Icon, label: string, st: const *Graphical): bool {
    return button(States[Icon].all(shape), label, false, st)
}

/* An icon and `label` in the theme's button style. */
pub button(shape: Icon, label: string): bool {
    return button(States[Icon].all(shape), label, false)
}

/* The id of a button: its label's, or its icon's when it has none. */
name(shape: Icon, label: string): u32 {
    if label.len == 0 { return context.id(shape) }
    return context.id(label)
}

/* A button in `st` that flips `value` when clicked and is on while it is
 * set: an icon from `shapes` for its state, then `label`, or the icon alone
 * when `label` is empty. `value`'s address names it. True when it flipped. */
pub toggle(shapes: States[Icon], label: string, value: *bool, st: const *Graphical): bool {
    if !press(context.id(usize(value)), shapes, true, label, st, *value) { return false }
    *value = !*value
    return true
}

/* The toggle in the theme's toggle style. */
pub toggle(shapes: States[Icon], label: string, value: *bool): bool {
    return toggle(shapes, label, value, &context.current.theme.toggle)
}

/* A toggle whose icon is the same in every state, in `st`. */
pub toggle(shape: Icon, label: string, value: *bool, st: const *Graphical): bool {
    return toggle(States[Icon].all(shape), label, value, st)
}

/* A toggle whose icon is the same in every state. */
pub toggle(shape: Icon, label: string, value: *bool): bool {
    return toggle(States[Icon].all(shape), label, value)
}

/* Equal segments showing `items`, the one at `*chosen` raised; a click on a
 * segment sets `*chosen` to it. `chosen`'s address names it. True when
 * `*chosen` changed. */
pub picker(items: []string, chosen: *usize, st: const *Labeled): bool {
    c: *Context = context.current
    assert(items.len > 0)
    w: f32 = 0.0
    p: f32 = st.box.padding.left + st.box.padding.right
    for i: usize in 0 .. items.len { w += text_width(items[i], st.label) + p }
    box: Rect = context.place(w, context.frame() + 2.0 * look.BUTTON_PAD)
    base: u32 = context.claim(context.id(usize(chosen)))
    each: f32 = box.w / f32(items.len)
    changed: bool = false
    for i: usize in 0 .. items.len {
        at: Rect = Rect { x = box.x + f32(i) * each, y = box.y, w = each, h = box.h }
        res: Response = context.track(context.derive(base, i), at)
        if res.click && *chosen != i {
            *chosen = i
            changed = true
        }
    }
    look.picker(c.canvas, st, box, items, *chosen)
    context.record(Item { hovered = context.reachable() && c.mouse.over(box), rect = box })
    return changed
}

pub picker(items: []string, chosen: *usize): bool {
    return picker(items, chosen, &context.current.theme.picker)
}

/* Width the layout allots a character of a field, or a twelfth of a slider:
 * 0.6 of the theme's text size. */
cell(): f32 {
    return 0.6 * context.current.theme.font.size
}

/* A line of `s` in `style`, its size high, placed by its alignment: as wide as
 * it, or the area's width when not left. */
pub text(s: string, style: Text) {
    w: f32 = text_width(s, style)
    if style.align != Align.left && !context.across() { w = context.span() }
    box: Rect = context.place(w, style.size)
    context.record(Item { rect = box })
    context.current.canvas.text(box, s, style)
}

/* A line of `s` in the theme's text. */
pub text(s: string) {
    text(s, context.current.theme.font)
}

/* `s` centered on a fill like a resting button's: a value shown, not
 * edited. */
pub readout(s: string) {
    c: *Context = context.current
    t: *Theme = &c.theme
    box: Rect = context.place(text_width(s, t.button.label) + 2.0 * t.padding, context.frame())
    context.record(Item { rect = box })
    look.readout(c.canvas, t, box, s)
}

/* A square in `st` showing the icon `shapes` has for its state, in `color`,
 * on while `selected`. Its resting icon names it. True when clicked. */
pub swatch(shapes: States[Icon], color: Color, selected: bool, st: const *Graphical): bool {
    c: *Context = context.current
    side: f32 = context.frame()
    if !context.across() { side = context.span() }
    box: Rect = context.place(side, side)
    res: Response = context.track(context.claim(context.id(shapes.rest)), box)
    look.swatch(c.canvas, st, box, res, shapes, color, selected)
    return res.click
}

pub swatch(shape: Icon, color: Color, selected: bool, st: const *Graphical): bool {
    return swatch(States[Icon].all(shape), color, selected, st)
}
pub swatch(shapes: States[Icon], color: Color, selected: bool): bool {
    return swatch(shapes, color, selected, &context.current.theme.swatch)
}
pub swatch(shape: Icon, color: Color, selected: bool): bool {
    return swatch(States[Icon].all(shape), color, selected)
}

/* A box ticked while `value` is set, then `label`; a click on the box or the
 * label flips `value`, whose address names it. True when it flipped. */
pub checkbox(label: string, value: *bool, st: const *Graphical): bool {
    c: *Context = context.current
    t: *Theme = &c.theme
    w: f32 = st.graphic.size + st.graphic.gap + text_width(label, st.label)
    box: Rect = context.place(w, context.frame())
    res: Response = context.track(context.claim(context.id(usize(value))), Rect { x = box.x, y = box.y, w = w, h = box.h })
    if res.click { *value = !*value }
    look.checkbox(c.canvas, st, t.glyphs.check, box, res, *value, label)
    return res.click
}

pub checkbox(label: string, value: *bool): bool {
    return checkbox(label, value, &context.current.theme.check)
}

/* A slider's width across an area, unless `width` sets it. */
SLIDER_GLYPHS: const f32 = 12.0

/* Places a slider for the value at `address`, with room for ticks under it
 * when `ticks`, and tracks it: where the pointer holds it, 0 to 1, or -1
 * while it is not held. */
grab(address: usize, ticks: bool, st: const *Ruled): f32 {
    c: *Context = context.current
    h: f32 = context.frame()
    if ticks { h += st.rule.gap + look.TICK_H }
    box: Rect = context.place(SLIDER_GLYPHS * cell() + st.box.padding.left + st.box.padding.right, h)
    res: Response = context.track(context.claim(context.id(address)), box)
    if !res.held || box.w <= 0.0 { return -1.0 }
    return math.max[f32](0.0, math.min[f32](1.0, (c.mouse.x - box.x) / box.w))
}

/* A bar dragged across to set `value` from `min` to `max`, filled up to it
 * and showing it to two places; `value`'s address names it. True when it
 * changed. */
pub slider(value: *f32, min: f32, max: f32, st: const *Ruled): bool {
    c: *Context = context.current
    at: f32 = grab(usize(value), false, st)
    before: f32 = *value
    if at >= 0.0 { *value = min + at * (max - min) }
    l: *fmt.Buffer = context.line()
    l.printf("%.2f", *value)
    look.slider(c.canvas, st, context.last().rect, (*value - min) / (max - min), 0, l.text())
    return *value != before
}

/* A bar that stops at each whole number from `min` to `max`, set to the
 * stop nearest the pointer and showing it, with a tick under each stop when
 * they have room;
 * `value`'s address names it. True when it changed. */
pub slider(value: *int, min: int, max: int, st: const *Ruled): bool {
    c: *Context = context.current
    n: int = max - min
    at: f32 = grab(usize(value), n > 0, st)
    before: int = *value
    if at >= 0.0 { *value = min + int(at * f32(n) + 0.5) }
    shown: f32 = 0.0
    if n > 0 { shown = f32(*value - min) / f32(n) }
    l: *fmt.Buffer = context.line()
    l.printf("%d", *value)
    look.slider(c.canvas, st, context.last().rect, shown, n + 1, l.text())
    return *value != before
}

pub slider(value: *f32, min: f32, max: f32): bool {
    return slider(value, min, max, &context.current.theme.slider)
}
pub slider(value: *int, min: int, max: int): bool {
    return slider(value, min, max, &context.current.theme.slider)
}

/* Caller storage for a field: the first `len` bytes of `buffer` are in use,
 * with the caret before byte `caret`. `buffer` stays put from frame to frame:
 * its address names the field. While empty, it shows `hint` in the muted
 * color. */
pub TextInput: struct {
    pub buffer: []u8 = [],
    pub len: usize = 0,
    pub caret: usize = 0,
    pub hint: string = "",
}

/* The text in use. */
pub TextInput.text(const self): string {
    return string(self.buffer[0..self.len])
}

/* Removes the byte at `i`. */
TextInput.remove(self, i: usize) {
    for j: usize in i .. self.len - 1 { self.buffer[j] = self.buffer[j + 1] }
    self.len -= 1
}

/* Inserts `c` at the caret and moves past it. */
TextInput.insert(self, c: u8) {
    for j: usize = self.len; j > self.caret; j -= 1 { self.buffer[j] = self.buffer[j - 1] }
    self.buffer[self.caret] = c
    self.len += 1
    self.caret += 1
}

/* A one-line field over `input`, as wide as its buffer across an area. A
 * click or `focus` gives it the keyboard; a press elsewhere takes it away.
 * Focused, it consumes every key and the frame's text, so read a key meant
 * for its owner first; a frame's keys apply before its text. It adds only the
 * printable ASCII bytes in `allow`, or any when `allow` is empty. True when
 * the text changed; Enter sets `last().submit`. */
pub field(input: *TextInput, allow: string, st: const *Labeled): bool {
    c: *Context = context.current
    t: *Theme = &c.theme
    assert(input.buffer.len > 0)
    box: Rect = context.place(st.box.padding.left + st.box.padding.right + f32(input.buffer.len) * cell(), context.frame())
    me: u32 = context.claim(context.id(usize(&input.buffer[0])))
    res: Response = context.track(me, box)
    if context.focusing() || res.press {
        c.focus = me
    } else if c.mouse.pressed && c.focus == me {
        c.focus = 0
    }
    changed: bool = false
    if c.focus == me {
        kb: *Keyboard = &c.keyboard
        for i: usize in 0 .. kb.count {
            if kb.keys[i].used { continue }
            kb.keys[i].used = true
            code: Keycode = kb.keys[i].code
            k: u32 = u32(code)
            if code == Keycode.enter {
                context.submit()
            } else if code == Keycode.backspace {
                if input.caret > 0 {
                    input.remove(input.caret - 1)
                    input.caret -= 1
                    changed = true
                }
            } else if k == KEY_DELETE {
                if input.caret < input.len {
                    input.remove(input.caret)
                    changed = true
                }
            } else if code == Keycode.left {
                if input.caret > 0 { input.caret -= 1 }
            } else if code == Keycode.right {
                if input.caret < input.len { input.caret += 1 }
            } else if k == KEY_HOME {
                input.caret = 0
            } else if k == KEY_END {
                input.caret = input.len
            }
        }
        typed: string = kb.consume()
        for i: usize in 0 .. typed.len {
            b: u8 = typed[i]
            if b < 0x20 || b > 0x7e || input.len == input.buffer.len || !allowed(allow, b) { continue }
            input.insert(b)
            changed = true
        }
    }
    look.field(c.canvas, st, box, input.text(), input.hint, t.muted, c.focus == me, input.caret)
    return changed
}

pub field(input: *TextInput, allow: string): bool {
    return field(input, allow, &context.current.theme.field)
}

/* Whether `allow` lets `c` in. */
allowed(allow: string, c: u8): bool {
    if allow.len == 0 { return true }
    for i: usize in 0 .. allow.len {
        if allow[i] == c { return true }
    }
    return false
}

/* The height of a list of `n` rows, its card's padding included. */
pub rows(n: usize): f32 {
    t: *Theme = &context.current.theme
    return f32(n) * t.row() + t.list.box.padding.top + t.list.box.padding.bottom
}

pub list(items: []string, chosen: *usize, rows: usize, scroll: *f32): bool {
    return list(items, chosen, rows, scroll, &context.current.theme.list)
}

/* A list of `items` with a faint line under each, `rows` of them showing from row `*scroll`
 * on, `*chosen` on an accent pill and the row under the pointer on a pill
 * filled as a button. A press
 * on a row sets `*chosen` to it; true when a row was pressed. Under the
 * pointer and longer than `rows`, it consumes the wheel, a row a notch, and
 * draws a thumb at its right edge. `scroll`'s address names it. */
pub list(items: []string, chosen: *usize, rows: usize, scroll: *f32, st: const *Labeled): bool {
    c: *Context = context.current
    t: *Theme = &c.theme
    h: f32 = t.row()
    box: Rect = context.place(context.span(), f32(rows) * h + st.box.padding.top + st.box.padding.bottom)
    inner: Rect = box.inset(st.box.padding)
    base: u32 = context.claim(context.id(usize(scroll)))
    most: f32 = 0.0
    if items.len > rows { most = f32(items.len - rows) }
    if context.reachable() && c.mouse.over(box) && most > 0.0 {
        *scroll -= c.mouse.wheel
        c.mouse.wheel = 0.0
    }
    *scroll = math.max[f32](0.0, math.min[f32](*scroll, most))
    first: usize = usize(*scroll)
    pressed: bool = false
    for i: usize in first .. math.min[usize](first + rows, items.len) {
        at: Rect = Rect { x = inner.x, y = inner.y + f32(i - first) * h, w = inner.w, h = h }
        res: Response = context.track(context.derive(base, i), at)
        if res.press {
            *chosen = i
            pressed = true
        }
        look.row(c.canvas, st, at, res, i == *chosen, t.padding - st.box.padding.left, items[i])
    }
    if most > 0.0 {
        thumb: f32 = math.max[f32](inner.h * f32(rows) / f32(items.len), THUMB_MIN)
        y: f32 = inner.y + (inner.h - thumb) * *scroll / most
        bounds: Rect = Rect { x = inner.x + inner.w - THUMB_W, y = y, w = THUMB_W, h = thumb }
        look.thumb(c.canvas, st, bounds)
    }
    context.record(Item { hovered = context.reachable() && c.mouse.over(box), rect = box })
    return pressed
}
