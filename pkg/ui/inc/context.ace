/* ui context — a frame's input, theme, ids and layout: what places and tracks
 * every control. */

import fmt
import math
import Keycode from sdl
import Rect, Insets, Canvas, Icon, text_width from "./canvas.ace"
import Mouse, Keyboard from "./input.ace"
import Theme, Graphical, Response from "./theme.ace"
import look: "./look.ace"

/* The last control placed: whether the pointer is over it or holds it, where
 * it is, and, for a field, whether Enter was pressed in it. */
pub Item: struct {
    pub hovered: bool = false,
    pub held: bool = false,
    pub rect: Rect = Rect {},
    pub submit: bool = false,
}

/* Nested `push_id` scopes and areas, and the ids a debug build checks for
 * repeats in one frame; past that many it checks no more. */
SCOPES_MAX: const usize = 16
AREAS_MAX: const usize = 8

/* The columns a weighted `row` or `grid` takes. */
COLS_MAX: const usize = 16
SEEN_MAX: const usize = 256

/* The bytes `line` formats into. */
LINE_MAX: const usize = 256

/* The bytes a tooltip keeps, and the frames the pointer rests on a control
 * before its tooltip shows: half a second at 60 frames a second. */
TIP_MAX: const usize = 128
TIP_FRAMES: const u32 = 30

/* A card's cell. */
CELL: const f32 = 40.0

/* FNV-1a, 32-bit, from the scope's hash. */
FNV_PRIME: const u32 = 0x0100_0193

/* Tags that keep an icon's and a pointer's id apart from a label's. */
TAG_ICON: const u8 = 1
TAG_POINTER: const u8 = 2

/* Which way an area's controls follow one another. */
pub Flow: enum {
    down,
    across,
}

/* A weighted column: its share of a line beside the others, like CSS `fr`,
 * and the least and most it takes; 0 is no limit. */
pub Col: struct {
    pub fr: f32 = 1.0,
    pub min: f32 = 0.0,
    pub max: f32 = 0.0,
}

/* An open area, closed by `end`. */
pub Area: struct {
    level: usize = 0,
}

/* Where an open area places its next control. */
Layout: struct {
    box: Rect = Rect {},
    flow: Flow = Flow.down,
    /* Down, the next control's top; across, its left, or after `fill` its
     * right, from the far edge. Both from the area's own edge. */
    at: f32 = 0.0,
    far: bool = false,
    /* In a popup, which a popup shown last frame leaves under the pointer. */
    modal: bool = false,
    /* In a card, the height of the cell each control or line takes, centered
     * on it; 0 elsewhere. */
    cell: f32 = 0.0,
    /* A `grid`'s columns, the controls it has left to place, the column the
     * next takes, and the height of its line so far. */
    cols: usize = 0,
    left: usize = 0,
    col: usize = 0,
    line: f32 = 0.0,
    /* A weighted grid's columns: each one's left, from the area's edge, and
     * width; `weighted` false for equal columns. */
    weighted: bool = false,
    xs: [COLS_MAX]f32 = [0.0 : COLS_MAX],
    ws: [COLS_MAX]f32 = [0.0 : COLS_MAX],
}

/* The frame's input, who holds it, and where controls go. A widget that uses
 * an input consumes it, so what runs after it, shortcuts included, sees none.
 * All zeros is a valid context; the application sets `theme` and `canvas`. */
pub Context: struct {
    pub canvas: *Canvas = null,
    pub mouse: Mouse = Mouse {},
    pub keyboard: Keyboard = Keyboard {},
    /* The widget that takes the keyboard; 0 for none. */
    pub focus: u32 = 0,
    /* `focus()` was called: the next field takes the keyboard. */
    focusing: bool = false,
    pub theme: Theme = Theme {},
    active: u32 = 0,
    scope: u32 = 0,
    scopes: [SCOPES_MAX]u32 = [0 : SCOPES_MAX],
    depth: usize = 0,
    seen: [SEEN_MAX]u32 = [0 : SEEN_MAX],
    seen_count: usize = 0,
    areas: [AREAS_MAX]Layout = [Layout {} : AREAS_MAX],
    level: usize = 0,
    /* The next control's width from `width`, or its label's stand-in. */
    next_w: f32 = 0.0,
    /* The next control's height from `height`, and whether `disable` made it
     * unable to take the pointer. */
    next_h: f32 = 0.0,
    next_off: bool = false,
    fit: string = "",
    fitting: bool = false,
    last: Item = Item {},
    /* A popup is up this frame, and was last frame: only it takes the
     * pointer. */
    modal: bool = false,
    blocking: bool = false,
    bytes: [LINE_MAX]u8 = [0 : LINE_MAX],
    scratch: fmt.Buffer = blank(fmt.Buffer),
    /* The control a tooltip waits on, the frames the pointer has rested on
     * it, whether one asked this frame, and the text to show at `end`, if
     * any. */
    tip_at: Rect = Rect {},
    tip_frames: u32 = 0,
    tip_asked: bool = false,
    tip_bytes: [TIP_MAX]u8 = [0 : TIP_MAX],
    tip_len: usize = 0,
}

/* The context the free functions act on, from `begin` to `end`. */
pub current: *Context = null

/* Starts a frame: the free functions act on this context until `end`. */
pub Context.begin(self) {
    current = &self
    self.blocking = self.modal
    self.modal = false
}

/* Ends the frame: clears its input, after the application's shortcuts read
 * what the controls left. Every area and id scope is closed by now. */
pub Context.end(self) {
    assert(self.depth == 0 && self.level == 0)
    if !self.tip_asked { self.tip_frames = 0 }
    if self.tip_len > 0 && self.canvas != null {
        look.tooltip(self.canvas, &self.theme.tip, self.mouse.x, self.mouse.y, self.theme.height - 4.0, self.tip_bytes[0..self.tip_len])
    }
    self.tip_asked = false
    self.tip_len = 0
    current = null
    self.seen_count = 0
    if self.mouse.released { self.active = 0 }
    self.mouse.pressed = false
    self.mouse.released = false
    self.mouse.wheel = 0.0
    self.keyboard.clear()
}

/* `bytes` mixed into hash `h`. */
fnv(h: u32, bytes: []u8): u32 {
    for i: usize in 0 .. bytes.len { h = (h ^ u32(bytes[i])) * FNV_PRIME }
    return h
}

/* `n`'s eight bytes after `tag`, mixed into hash `h`. */
fnv(h: u32, tag: u8, n: u64): u32 {
    k: [9]u8 = [tag, u8(n), u8(n >> 8), u8(n >> 16), u8(n >> 24), u8(n >> 32), u8(n >> 40), u8(n >> 48), u8(n >> 56)]
    return fnv(h, k[..])
}

/* `h` as an id, which is never 0. */
nonzero(h: u32): u32 {
    if h == 0 { return 1 }
    return h
}

/* The id of the control `label` names in the current scope. */
pub id(label: string): u32 {
    return nonzero(fnv(current.scope, label))
}

/* The id of the icon-only control that shows `shape`. */
pub id(shape: Icon): u32 {
    return nonzero(fnv(current.scope, TAG_ICON, u64(shape.start)))
}

/* The id of the control that edits the value at `address`, as `usize(&v)`. */
pub id(address: usize): u32 {
    return nonzero(fnv(current.scope, TAG_POINTER, u64(address)))
}

/* Opens a scope `n` names: the same label, icon or value names a different
 * control inside it, as in a loop's rows. `pop_id` closes it. */
pub push_id(n: u32) {
    c: *Context = current
    c.scopes[c.depth] = c.scope
    c.depth += 1
    c.scope = fnv(c.scope, 0, u64(n))
}

/* Closes the scope the last `push_id` opened. */
pub pop_id() {
    c: *Context = current
    c.depth -= 1
    c.scope = c.scopes[c.depth]
}

/* Whether `id` is new this frame, recording it. */
Context.unique(self, id: u32): bool {
    for i: usize in 0 .. self.seen_count {
        if self.seen[i] == id { return false }
    }
    if self.seen_count < SEEN_MAX {
        self.seen[self.seen_count] = id
        self.seen_count += 1
    }
    return true
}

/* `id`, which a debug build aborts on when a second control takes it in one
 * frame. */
Context.claim(self, id: u32): u32 {
    assert(self.unique(id))
    return id
}

/* Whether the pointer may reach a control: always, unless a popup is up and
 * the control is outside it. */
Context.reachable(const self): bool {
    return !self.blocking || (self.level > 0 && self.areas[self.level - 1].modal)
}

/* What the pointer did to the widget `id` at `box`. A click is a release on
 * the widget that took the press. */
pub track(id: u32, box: Rect): Response {
    c: *Context = current
    over: bool = c.reachable() && c.mouse.over(box)
    res: Response = Response { hover = over }
    if over && c.mouse.pressed {
        c.active = id
        res.press = true
    }
    res.held = c.active == id
    res.click = res.held && over && c.mouse.released
    c.last = Item { hovered = res.hover, held = res.held, rect = box }
    return res
}

/* Shows `s` by the pointer, over everything, once it has rested on the last
 * control for TIP_FRAMES frames; a press hides it until the pointer leaves. */
pub tooltip(s: string) {
    c: *Context = current
    box: Rect = c.last.rect
    if !c.last.hovered { return }
    same: bool = box.x == c.tip_at.x && box.y == c.tip_at.y && box.w == c.tip_at.w && box.h == c.tip_at.h
    if !same {
        c.tip_at = box
        c.tip_frames = 0
    }
    c.tip_asked = true
    if c.mouse.pressed || c.last.held { c.tip_frames = TIP_FRAMES + 1 }
    if c.tip_frames < TIP_FRAMES { c.tip_frames += 1 }
    if c.tip_frames != TIP_FRAMES { return }
    n: usize = math.min[usize](s.len, TIP_MAX)
    for i: usize in 0 .. n { c.tip_bytes[i] = s[i] }
    c.tip_len = n
}

/* The last control placed. */
pub last(): Item {
    return current.last
}

/* An area over `box` whose controls go down it, each as wide as it. */
pub area(box: Rect): Area {
    return current.open(box, Flow.down, false)
}

/* An area over `box` whose controls follow `flow`. Across, each is as wide
 * as its content and centered on the area's height. */
pub area(box: Rect, flow: Flow): Area {
    return current.open(box, flow, false)
}

/* A modal area over `box`, on the surface: while it is up, only
 * the controls inside it take the pointer. Its controls go down it. */
pub popup(box: Rect): Area {
    c: *Context = current
    c.modal = true
    look.popup(c.canvas, &c.theme.popup, box)
    return c.open(box, Flow.down, true)
}

/* A popup over `box` titled `s` on a strip `Theme.title` high across its top;
 * its controls go down the rest. */
pub popup(box: Rect, s: string): Area {
    c: *Context = current
    c.modal = true
    look.popup(c.canvas, &c.theme.popup, box)
    h: f32 = c.theme.title()
    look.title(c.canvas, &c.theme.header, box, h, s)
    return c.open(Rect { x = box.x, y = box.y + h, w = box.w, h = box.h - h }, Flow.down, true)
}

/* A card of `cells` cells across the area, with separators between them.
 * Down it each control, or `row` line, takes a cell, inset the padding at the
 * sides and centered on the cell's height. */
pub card(cells: usize): Area {
    c: *Context = current
    t: *Theme = &c.theme
    box: Rect = c.place(c.span(), f32(cells) * CELL)
    look.card(c.canvas, &t.card, box)
    look.separators(c.canvas, &t.card, box, CELL)
    area: Area = c.open(box.inset(Insets { left = t.card.box.padding.left, right = t.card.box.padding.right }), Flow.down, false)
    c.top().cell = CELL
    return area
}

Context.open(self, box: Rect, flow: Flow, modal: bool): Area {
    assert(self.level < AREAS_MAX)
    inside: bool = modal || (self.level > 0 && self.areas[self.level - 1].modal)
    self.areas[self.level] = Layout { box = box, flow = flow, modal = inside }
    self.level += 1
    return Area { level = self.level }
}

/* Closes the area; areas close in the reverse of their opening. */
pub Area.end(const self) {
    c: *Context = current
    assert(c.level == self.level)
    l: *Layout = c.top()
    assert(l.cell == 0.0 || l.at <= l.box.h)
    c.level -= 1
}

/* The next `n` controls share a line in equal columns; the line ends after
 * them. */
pub row(n: usize) {
    grid(n, n)
}

/* The next `count` controls go in lines of `n` equal columns. */
pub grid(n: usize, count: usize) {
    l: *Layout = current.top()
    l.cols = n
    l.left = count
    l.col = 0
    l.line = 0.0
    l.weighted = false
    if count == 0 { l.cols = 0 }
}

/* The next controls share a line in columns weighted by `weights`. */
pub row(weights: []int) {
    cols: [COLS_MAX]Col = [Col {} : COLS_MAX]
    assert(weights.len <= COLS_MAX)
    for i: usize in 0 .. weights.len { cols[i].fr = f32(weights[i]) }
    grid(cols[0 .. weights.len], weights.len)
}

/* The next controls share a line in `cols`. */
pub row(cols: []Col) {
    grid(cols, cols.len)
}

/* The next `count` controls go in lines of `cols`: the area's width, less
 * the gaps, is shared by weight, and a column its share would take past its
 * `min` or `max` is held there while the others share the rest, as CSS flex
 * resolves it. Minimums wider than the area overflow it. */
pub grid(cols: []Col, count: usize) {
    n: usize = cols.len
    assert(n > 0 && n <= COLS_MAX)
    grid(n, count)
    l: *Layout = current.top()
    l.weighted = true
    gap: f32 = current.theme.gap
    room: f32 = l.box.w - gap * f32(n - 1)
    held: [COLS_MAX]bool = [false : COLS_MAX]
    for pass: usize in 0 .. n + 1 {
        free: f32 = room
        fr: f32 = 0.0
        for i: usize in 0 .. n {
            if held[i] { free -= l.ws[i] } else { fr += cols[i].fr }
        }
        /* Each free column's share, and how far its limits move it. */
        off: f32 = 0.0
        for i: usize in 0 .. n {
            if held[i] { continue }
            w: f32 = 0.0
            if fr > 0.0 { w = math.max[f32](free, 0.0) * cols[i].fr / fr }
            l.ws[i] = w
            if cols[i].max > 0.0 && w > cols[i].max { w = cols[i].max }
            if w < cols[i].min { w = cols[i].min }
            off += w - l.ws[i]
        }
        if off == 0.0 { break }
        /* Hold only the columns pushed the way the total moved. */
        for i: usize in 0 .. n {
            if held[i] { continue }
            w: f32 = l.ws[i]
            if off > 0.0 && w < cols[i].min {
                l.ws[i] = cols[i].min
                held[i] = true
            } else if off < 0.0 && cols[i].max > 0.0 && w > cols[i].max {
                l.ws[i] = cols[i].max
                held[i] = true
            }
        }
    }
    x: f32 = 0.0
    for i: usize in 0 .. n {
        l.xs[i] = x
        x += l.ws[i] + gap
    }
}

/* The open area's width and height, inside a card's padding: what an
 * application branches on to lay out by the room it has. */
pub area_width(): f32 {
    return current.top().box.w
}

pub area_height(): f32 {
    return current.top().box.h
}

/* The next control is `w` wide, down an area as across one. */
pub width(w: f32) {
    current.next_w = w
}

/* The next control is `h` high. */
pub height(h: f32) {
    current.next_h = h
}

/* The next button is drawn faint and takes no pointer. */
pub disable() {
    current.next_off = true
}

/* Whether the next control was made unable to take the pointer. */
pub disabled(): bool {
    return current.next_off
}

/* The next control is as wide as it would be showing `label`. */
pub width(label: string) {
    current.fit = label
    current.fitting = true
}

/* Moves the next control `w` further on. */
pub space(w: f32) {
    current.top().at += w
}

/* Puts the rest of an across area at its far edge: the next control at the
 * edge, and each after it before the last. */
pub fill() {
    l: *Layout = current.top()
    l.far = true
    l.at = 0.0
}

Context.top(self): *Layout {
    assert(self.level > 0)
    return &self.areas[self.level - 1]
}

/* How wide the next control is down its area: a `grid`'s column, else the
 * area's width, unless `width` set it. */
Context.span(self): f32 {
    if self.next_w > 0.0 { return self.next_w }
    l: *Layout = self.top()
    if l.weighted { return l.ws[l.col] }
    if l.cols > 0 { return (l.box.w - self.theme.gap * f32(l.cols - 1)) / f32(l.cols) }
    return l.box.w
}

/* Whether the next control goes across its area, outside a grid. */
Context.across(self): bool {
    l: *Layout = self.top()
    return l.flow == Flow.across && l.cols == 0
}

/* The rectangle of the next control, `w` wide (across an area; down one it
 * takes `span`) and `h` high, past which the area moves on. */
pub place(w: f32, h: f32): Rect {
    return current.place(w, h)
}

Context.place(self, w: f32, h: f32): Rect {
    l: *Layout = self.top()
    gap: f32 = self.theme.gap
    if self.next_w > 0.0 { w = self.next_w }
    box: Rect = Rect {}
    if l.cols > 0 {
        w = self.span()
        x: f32 = l.box.x + f32(l.col) * (w + gap)
        if l.weighted { x = l.box.x + l.xs[l.col] }
        box = Rect { x = x, y = l.box.y + l.at, w = w, h = h }
        l.line = math.max[f32](l.line, h)
        if l.cell > 0.0 { box.y += (l.cell - h) / 2.0 }
        l.col += 1
        l.left -= 1
        if l.col == l.cols || l.left == 0 {
            if l.cell > 0.0 { l.at += l.cell } else { l.at += l.line + gap }
            l.col = 0
            l.line = 0.0
            if l.left == 0 {
                l.cols = 0
                l.weighted = false
            }
        }
    } else if l.flow == Flow.down {
        box = Rect { x = l.box.x, y = l.box.y + l.at, w = self.span(), h = h }
        if l.cell > 0.0 {
            box.y += (l.cell - h) / 2.0
            l.at += l.cell
        } else {
            l.at += h + gap
        }
    } else {
        x: f32 = l.box.x + l.at
        if l.far { x = l.box.x + l.box.w - l.at - w }
        box = Rect { x = x, y = l.box.y + (l.box.h - h) / 2.0, w = w, h = h }
        l.at += w + gap
    }
    self.next_w = 0.0
    self.next_h = 0.0
    self.next_off = false
    self.fitting = false
    return box
}

/* A control's height: the theme's, unless `height` set it. */
Context.frame(const self): f32 {
    if self.next_h > 0.0 { return self.next_h }
    return self.theme.height
}

/* How wide a button is across an area: its label, or `width`'s stand-in,
 * padded, after its icon; an icon alone is square. */
Context.measure(const self, st: const *Graphical, icon: bool, label: string): f32 {
    text: string = label
    if self.fitting { text = self.fit }
    if text.len == 0 { return self.frame() }
    w: f32 = st.box.padding.left + st.box.padding.right + text_width(text, st.label)
    if icon { w += st.graphic.size + st.graphic.gap }
    return w
}

/* Consumes a press of `code` with no modifiers, and says whether there was
 * one. */
pub key(code: Keycode): bool {
    return current.keyboard.consume(code, 0)
}

/* The context's scratch buffer, emptied, for a control's formatted text, as
 * `ui.text(l.text())` after `l.printf(...)`. The next call empties it. */
pub line(): *fmt.Buffer {
    c: *Context = current
    c.scratch = fmt.Buffer.init(c.bytes[..])
    return &c.scratch
}

/* The next control that takes the keyboard takes `focus`. */
pub focus() {
    current.focusing = true
}

/* What controls in other files reach of the current context. */

/* `id`, which a debug build aborts on when a second control takes it in one
 * frame. */
pub claim(id: u32): u32 {
    return current.claim(id)
}

/* Whether the pointer may reach the next control. */
pub reachable(): bool {
    return current.reachable()
}

/* A control's height. */
pub frame(): f32 {
    return current.frame()
}

/* How wide a button is across an area. */
pub measure(st: const *Graphical, icon: bool, label: string): f32 {
    return current.measure(st, icon, label)
}

/* How wide the next control is down its area. */
pub span(): f32 {
    return current.span()
}

/* Whether the next control goes across its area. */
pub across(): bool {
    return current.across()
}

/* Records `item` as the last control. */
pub record(item: Item) {
    current.last = item
}

/* Records that Enter was pressed in the last control. */
pub submit() {
    current.last.submit = true
}

/* Whether `focus` was called since a control last asked, which this asks. */
pub focusing(): bool {
    asked: bool = current.focusing
    current.focusing = false
    return asked
}

/* The id of part `n` of the control `base`. */
pub derive(base: u32, n: usize): u32 {
    return nonzero(fnv(base, 0, u64(n)))
}
