/* array — a growable sequence of elements over the process allocator.
 *
 * An Array holds `len` live elements at the front of `items`; `items.len` is
 * its capacity. The canonical zero value and the empty literal `Array[T]{}` are
 * valid empty arrays holding no storage, so an Array needs no constructor and
 * grows on its first `push`.
 * Growth goes through `mem.grow`, doubling storage; allocation failure is an
 * `Error` and leaves the array unchanged. Element access is bounds-checked
 * against `len`, not against capacity. Call `wipe` once the array is no
 * longer used.
 */

import mem

pub ArrayErr: error {
    1: allocation = "array storage allocation failed",
    2: empty = "array is empty",
}

pub Array[T]: struct {
    items: []T = null,
    pub len: usize = 0,
}

/* Creates an array with room for `capacity` elements and none live. A zero
 * capacity allocates nothing.
 */
pub Array[T].new(capacity: usize): (Array[T], Error) {
    if capacity == 0 { return Array[T] {}, null }
    items: []T = mem.alloc[T](capacity)
    if items == null { return Array[T] {}, ArrayErr.allocation }

    return Array[T] { items = items }, null
}

/* Creates an array of `count` live elements, each `value`, from one zeroed
 * allocation; elements are written only when `value` is not `blank(T)`. A
 * zero count allocates nothing. `T` must support `==`.
 */
pub Array[T].filled(count: usize, value: T): (Array[T], Error) {
    a: Array[T] = Array[T] {}
    if a.resize(count) != null { return Array[T] {}, ArrayErr.allocation }
    if value != blank(T) {
        for i: usize in 0 .. count { a.items[i] = value }
    }
    return a, null
}

/* Releases the array's storage and leaves it empty. */
pub inline Array[T].wipe(self) {
    items: []T = self.items
    mem.release[T](&items)
    self.items = null
    self.len = 0
}

/* The live elements. The view aliases the array's storage and is invalidated
 * by any call that grows it.
 */
pub Array[T].view(const self): []T {
    return self.items[..self.len]
}

pub inline Array[T].get(const self, index: usize): T {
    return self.items[..self.len][index]
}

pub inline Array[T].set(self, index: usize, value: T) {
    live: []T = self.items[..self.len]
    live[index] = value
}

/* `get` for an `int` index; a negative index is a bounds violation. */
pub inline Array[T].get(const self, index: int): T {
    return self.items[..self.len][index]
}

/* Appends `value`, growing storage when full. */
pub inline Array[T].push(self, value: T): Error {
    len: usize = self.len
    if len == self.items.len {
        grown: []T, ok: bool = mem.grow[T](self.items, len + 1)
        if !ok { return ArrayErr.allocation }
        self.items = grown
    }
    self.items[len] = value
    self.len = len + 1
    return null
}

/* Removes and returns the last element. An empty array returns `blank(T)` and
 * `ArrayErr.empty`.
 */
pub Array[T].pop(self): (T, Error) {
    if self.len == 0 { return blank(T), ArrayErr.empty }
    self.len -= 1
    return self.items[self.len], null
}

/* Ensures capacity for at least `count` elements in total. */
pub Array[T].reserve(self, count: usize): Error {
    grown: []T, ok: bool = mem.grow[T](self.items, count)
    if !ok { return ArrayErr.allocation }

    self.items = grown
    return null
}

/* Sets the live length to `count`. Growing appends `blank(T)` elements;
 * shrinking drops the tail and keeps storage.
 */
pub Array[T].resize(self, count: usize): Error {
    if self.items == null {
        if count == 0 { return null }
        fresh: []T = mem.zalloc[T](count)
        if fresh == null { return ArrayErr.allocation }
        self.items = fresh
        self.len = count
        return null
    }
    if count > self.items.len {
        grown: []T, ok: bool = mem.grow[T](self.items, count)
        if !ok { return ArrayErr.allocation }
        self.items = grown
    }
    for i: usize in self.len .. count { self.items[i] = blank(T) }
    self.len = count
    return null
}

/* Drops every live element and keeps the storage. */
pub Array[T].clear(self) {
    self.len = 0
}

/* Drops every live element from index `count` onward, keeping storage. `count`
 * follows the ordinary sequence bounds contract: debug builds diagnose a
 * count past the current length and release assumes it.
 */
pub Array[T].truncate(self, count: usize) {
    self.len = self.view()[..count].len
}
