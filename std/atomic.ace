pub xor_relaxed(p: mut *u64, value: u64): u64 intrinsic

pub cas(p: mut *u64, expected: u64, desired: u64): (u64, bool) intrinsic
pub cas_acq_rel(p: mut *u64, expected: u64, desired: u64): (u64, bool) intrinsic
pub cas_relaxed(p: mut *u64, expected: u64, desired: u64): (u64, bool) intrinsic

pub fence() intrinsic
pub fence_acquire() intrinsic
pub fence_release() intrinsic
