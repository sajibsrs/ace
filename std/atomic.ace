/* atomic — indivisible, lock-free operations on shared u32, u64, and usize words.
 * Compiler-backed target instructions (spec/std/atomic.md); the unsuffixed name
 * is sequentially consistent and a suffix names a weaker ordering.
 */


/* Loads and stores of the u32 at `p`. */
pub load(p: *u32): u32 intrinsic
pub load_acquire(p: *u32): u32 intrinsic
pub load_relaxed(p: *u32): u32 intrinsic
pub store(p: *u32, value: u32) intrinsic
pub store_release(p: *u32, value: u32) intrinsic
pub store_relaxed(p: *u32, value: u32) intrinsic

/* Writes `value` to the u32 at `p` and returns the previous value. */
pub exchange(p: *u32, value: u32): u32 intrinsic
pub exchange_acquire(p: *u32, value: u32): u32 intrinsic
pub exchange_release(p: *u32, value: u32): u32 intrinsic
pub exchange_acq_rel(p: *u32, value: u32): u32 intrinsic
pub exchange_relaxed(p: *u32, value: u32): u32 intrinsic

/* Adds `value` to the u32 at `p`, wrapping, and returns the previous value. */
pub add(p: *u32, value: u32): u32 intrinsic
pub add_acquire(p: *u32, value: u32): u32 intrinsic
pub add_release(p: *u32, value: u32): u32 intrinsic
pub add_acq_rel(p: *u32, value: u32): u32 intrinsic
pub add_relaxed(p: *u32, value: u32): u32 intrinsic

/* Subtracts `value` from the u32 at `p`, wrapping, and returns the previous value. */
pub sub(p: *u32, value: u32): u32 intrinsic
pub sub_acquire(p: *u32, value: u32): u32 intrinsic
pub sub_release(p: *u32, value: u32): u32 intrinsic
pub sub_acq_rel(p: *u32, value: u32): u32 intrinsic
pub sub_relaxed(p: *u32, value: u32): u32 intrinsic

/* ANDs `value` into the u32 at `p` and returns the previous value. */
pub and(p: *u32, value: u32): u32 intrinsic
pub and_acquire(p: *u32, value: u32): u32 intrinsic
pub and_release(p: *u32, value: u32): u32 intrinsic
pub and_acq_rel(p: *u32, value: u32): u32 intrinsic
pub and_relaxed(p: *u32, value: u32): u32 intrinsic

/* ORs `value` into the u32 at `p` and returns the previous value. */
pub or(p: *u32, value: u32): u32 intrinsic
pub or_acquire(p: *u32, value: u32): u32 intrinsic
pub or_release(p: *u32, value: u32): u32 intrinsic
pub or_acq_rel(p: *u32, value: u32): u32 intrinsic
pub or_relaxed(p: *u32, value: u32): u32 intrinsic

/* XORs `value` into the u32 at `p` and returns the previous value. */
pub xor(p: *u32, value: u32): u32 intrinsic
pub xor_acquire(p: *u32, value: u32): u32 intrinsic
pub xor_release(p: *u32, value: u32): u32 intrinsic
pub xor_acq_rel(p: *u32, value: u32): u32 intrinsic
pub xor_relaxed(p: *u32, value: u32): u32 intrinsic

/* Writes `desired` to the u32 at `p` only when it holds `expected`; returns
 * the value observed and whether it wrote. Never fails spuriously.
 */
pub cas(p: *u32, expected: u32, desired: u32): (u32, bool) intrinsic
pub cas_acq_rel(p: *u32, expected: u32, desired: u32): (u32, bool) intrinsic
pub cas_relaxed(p: *u32, expected: u32, desired: u32): (u32, bool) intrinsic

