/* bits — explicit access to machine representations.
 * Compiler-backed target instructions; no numeric conversion or runtime calls.
 */

pub popcount(value: u8): uint intrinsic
pub popcount(value: u16): uint intrinsic
pub popcount(value: u32): uint intrinsic
pub popcount(value: u64): uint intrinsic

pub clz(value: u8): uint intrinsic
pub clz(value: u16): uint intrinsic
pub clz(value: u32): uint intrinsic
pub clz(value: u64): uint intrinsic

pub ctz(value: u8): uint intrinsic
pub ctz(value: u16): uint intrinsic
pub ctz(value: u32): uint intrinsic
pub ctz(value: u64): uint intrinsic

pub bswap(value: u8): u8 intrinsic
pub bswap(value: u16): u16 intrinsic
pub bswap(value: u32): u32 intrinsic
pub bswap(value: u64): u64 intrinsic

pub rotl(value: u8, count: uint): u8 intrinsic
pub rotl(value: u16, count: uint): u16 intrinsic
pub rotl(value: u32, count: uint): u32 intrinsic
pub rotl(value: u64, count: uint): u64 intrinsic

pub rotr(value: u8, count: uint): u8 intrinsic
pub rotr(value: u16, count: uint): u16 intrinsic
pub rotr(value: u32, count: uint): u32 intrinsic
pub rotr(value: u64, count: uint): u64 intrinsic

pub wradd(a: u8, b: u8): u8 intrinsic
pub wradd(a: u16, b: u16): u16 intrinsic
pub wradd(a: u32, b: u32): u32 intrinsic
pub wradd(a: u64, b: u64): u64 intrinsic
pub wrsub(a: u8, b: u8): u8 intrinsic
pub wrsub(a: u16, b: u16): u16 intrinsic
pub wrsub(a: u32, b: u32): u32 intrinsic
pub wrsub(a: u64, b: u64): u64 intrinsic
pub wrmul(a: u8, b: u8): u8 intrinsic
pub wrmul(a: u16, b: u16): u16 intrinsic
pub wrmul(a: u32, b: u32): u32 intrinsic
pub wrmul(a: u64, b: u64): u64 intrinsic

// The 128-bit product a * b as its high and low words.
pub mul_wide(a: u64, b: u64): (u64, u64) intrinsic
