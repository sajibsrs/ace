/* file — whole-file reads and writes composed from `sys` descriptor calls.
 * Kept out of `sys` so that importing `sys` never links the allocator.
 */

import mem
import sys

/* Failures `read` adds to those of `sys.open`, `sys.stat`, and `sys.read`. */
pub FileErr: error {
    1: allocation = "allocation failed"
    2: truncated = "file shrank while being read"
}

/* The whole file at `path` in one allocation the caller releases with
 * `mem.release`, null on failure. An empty file is a null slice with no error.
 * The size is taken once, so a file that grows while being read yields its
 * leading bytes, and one that shrinks is `FileErr.truncated`.
 */
pub read(path: string): (mut []u8, Error) {
    fd: sys.Fd, err: Error = sys.open(path, sys.O_RDONLY)
    if err != null { return null, err }
    defer sys.close(fd)
    info: sys.FileInfo
    info, err = sys.stat(path)
    if err != null { return null, err }
    data: mut []u8 = mem.alloc[u8](usize(info.size))
    if data == null && info.size != 0 { return null, FileErr.allocation }
    total: usize = 0

    for total < data.len {
        count: int, rerr: Error = sys.read(fd, data[total..])
        if rerr == sys.ReadErr.interrupted { continue }
        if rerr == null && count == 0 { rerr = FileErr.truncated }

        if rerr != null {
            mem.release[u8](mut data)
            return null, rerr
        }
        total += usize(count)
    }
    return data, null
}

/* Writes all of `data` to `path`, truncating an existing file or creating one
 * with mode 0o666 less the process umask, as C's `fopen` does. A close failure
 * is reported, since it can carry a deferred write error.
 */
pub write(path: string, data: []u8): Error {
    mode: u32 = sys.S_IRUSR | sys.S_IWUSR | sys.S_IRGRP | sys.S_IWGRP | sys.S_IROTH | sys.S_IWOTH
    fd: sys.Fd, err: Error = sys.open(path, sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC, mode)
    if err != null { return err }
    total: usize = 0

    for total < data.len && err == null {
        count: int, werr: Error = sys.write(fd, data[total..])

        if werr == null {
            total += usize(count)
        } else if werr != sys.WriteErr.interrupted {
            err = werr
        }
    }
    cerr: Error = sys.close(fd)
    if err != null { return err }
    return cerr
}
