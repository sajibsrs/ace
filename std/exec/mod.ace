/* exec — starting programs as child processes. It builds on `sys`, which
 * keeps one call per operation and imports nothing, and allocates through
 * `mem`; only programs that start processes load it.
 */

import mem
import sys

@when(target == "darwin-arm64")
import os: "./os/darwin-arm64.ace"

@when(target == "linux-x64")
import os: "./os/linux-x64.ace"

pub SpawnErr: type = os.SpawnErr

/* Where a child's standard stream goes: `inherit` keeps this process's
 * stream; `fd` duplicates a descriptor onto it.
 */
pub Redirect: enum { inherit, fd }

/* Options for a spawned child. Canonical zero changes nothing: an empty `dir`
 * keeps this process's working directory and both streams inherit. The
 * `*_fd` field is read only when its stream is `Redirect.fd`.
 */
pub SpawnOptions: struct {
    pub dir: string,
    pub stdout: Redirect,
    pub stdout_fd: sys.Fd,
    pub stderr: Redirect,
    pub stderr_fd: sys.Fd,
}

/* Start `argv[0]`, searched in PATH, with `argv` as its arguments and this
 * process's environment; no shell runs between. Wait for it with `sys.wait`.
 * The strings are copied into NUL-terminated storage released before return.
 * The child starts with an empty signal mask; a signal this process ignores
 * stays ignored. An empty `argv` or an argument holding a NUL byte fails with
 * `SpawnErr.invalid`.
 */
pub spawn(argv: []string): (sys.Process, Error) {
    process: sys.Process, err: Error = spawn(argv, blank(SpawnOptions))
    return process, err
}

/* `spawn` with `options`: the child runs in `options.dir` when it is not
 * empty, and a stream marked `Redirect.fd` has its descriptor duplicated onto
 * it, so the same descriptor on both is `2>&1`. The caller keeps its own
 * descriptors open and closes them. A missing or unusable `dir` fails with
 * the code `posix_spawnp` returns; a `dir` holding a NUL byte fails with
 * `SpawnErr.invalid`.
 */
pub spawn(argv: []string, options: SpawnOptions): (sys.Process, Error) {
    if argv.len == 0 { return sys.Process(-1), SpawnErr.invalid }
    envc: usize = sys.envc()
    size: usize = 0
    for i: usize in 0 .. argv.len {
        for j: usize in 0 .. argv[i].len {
            if argv[i][j] == 0 { return sys.Process(-1), SpawnErr.invalid }
        }
        size += argv[i].len + 1
    }
    for j: usize in 0 .. options.dir.len {
        if options.dir[j] == 0 { return sys.Process(-1), SpawnErr.invalid }
    }
    size += options.dir.len + 1
    for i: usize in 0 .. envc { size += sys.env(i).len + 1 }

    bytes: mut []u8 = mem.alloc[u8](size)
    defer mem.release[u8](mut bytes)
    pointers: mut []*u8 = mem.alloc[*u8](argv.len + envc + 2)
    defer mem.release[*u8](mut pointers)
    if bytes == null || pointers == null { return sys.Process(-1), SpawnErr.memory }

    at: usize = 0
    for i: usize in 0 .. argv.len + envc {
        text: string = i < argv.len ? argv[i] : sys.env(i - argv.len)
        for j: usize in 0 .. text.len { bytes[at + j] = text[j] }
        bytes[at + text.len] = 0
        slot: usize = i < argv.len ? i : i + 1
        pointers[slot] = &bytes[at]
        at += text.len + 1
    }
    pointers[argv.len] = null
    pointers[argv.len + envc + 1] = null

    dir: *u8 = null
    if options.dir.len > 0 {
        for j: usize in 0 .. options.dir.len { bytes[at + j] = options.dir[j] }
        bytes[at + options.dir.len] = 0
        dir = &bytes[at]
    }
    out: i32 = options.stdout == Redirect.fd ? i32(options.stdout_fd) : -1
    err_fd: i32 = options.stderr == Redirect.fd ? i32(options.stderr_fd) : -1
    process: sys.Process, err: Error = os.spawn(pointers[0 .. argv.len + 1], pointers[argv.len + 1 .. argv.len + envc + 2], dir, out, err_fd)
    return process, err
}
