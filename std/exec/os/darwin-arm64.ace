/* exec — darwin-arm64 spawning over posix_spawnp. */

import sys

pub SpawnErr: error {
    2: not_found = "program not found",
    7: too_big = "argument list too long",
    8: format = "program is not executable",
    12: memory = "insufficient memory to create process",
    13: access = "permission denied",
    22: invalid = "spawn request is invalid",
    35: retry = "temporary process resource limit reached",
}

extern "c" {
    c_posix_spawnp(pid: *i32, file: *u8, actions: *u64, attributes: *usize, argv: **u8, envp: **u8): i32 as "posix_spawnp"
    c_actions_init(actions: *u64): i32 as "posix_spawn_file_actions_init"
    c_actions_destroy(actions: *u64): i32 as "posix_spawn_file_actions_destroy"
    c_actions_dup2(actions: *u64, fd: i32, target: i32): i32 as "posix_spawn_file_actions_adddup2"
    c_actions_chdir(actions: *u64, path: *u8): i32 as "posix_spawn_file_actions_addchdir_np"
    c_attributes_init(attributes: *usize): i32 as "posix_spawnattr_init"
    c_attributes_destroy(attributes: *usize): i32 as "posix_spawnattr_destroy"
    c_attributes_flags(attributes: *usize, flags: i16): i32 as "posix_spawnattr_setflags"
    c_attributes_sigmask(attributes: *usize, mask: *u32): i32 as "posix_spawnattr_setsigmask"
}

POSIX_SPAWN_SETSIGMASK: const i16 = 0x0008

/* posix_spawnp over NUL-terminated `argv` and `envp` arrays; it returns its
 * error code directly rather than through errno. The child starts with an
 * empty signal mask whatever this thread blocks. A non-null `dir` is the
 * child's working directory; a non-negative `out` or `err` is a descriptor
 * duplicated onto the child's standard output or error. File actions run in
 * the child in that order: directory, then the two duplications. The
 * file-actions object is opaque and at most 80 bytes (glibc; Darwin holds a
 * pointer), so 128 bytes of aligned stack storage hold it. Darwin's
 * attributes object is a pointer that `posix_spawnattr_init` allocates.
 */
pub spawn(argv: []*u8, envp: []*u8, dir: *u8, out: i32, err: i32): (sys.Process, Error) {
    attributes: usize = 0
    code: i32 = c_attributes_init(&attributes)
    if code != 0 { return sys.Process(-1), SpawnErr(code) }
    defer c_attributes_destroy(&attributes)
    code = c_attributes_flags(&attributes, POSIX_SPAWN_SETSIGMASK)
    if code != 0 { return sys.Process(-1), SpawnErr(code) }
    empty: u32 = 0
    code = c_attributes_sigmask(&attributes, &empty)
    if code != 0 { return sys.Process(-1), SpawnErr(code) }

    pid: i32 = 0
    if dir == null && out < 0 && err < 0 {
        code = c_posix_spawnp(&pid, argv[0], null, &attributes, &argv[0], &envp[0])
        if code != 0 { return sys.Process(-1), SpawnErr(code) }

        return sys.Process(pid), null
    }

    actions: [16]u64
    code = c_actions_init(&actions[0])
    if code != 0 { return sys.Process(-1), SpawnErr(code) }
    defer c_actions_destroy(&actions[0])
    if dir != null {
        code = c_actions_chdir(&actions[0], dir)
        if code != 0 { return sys.Process(-1), SpawnErr(code) }
    }
    if out >= 0 {
        code = c_actions_dup2(&actions[0], out, 1)
        if code != 0 { return sys.Process(-1), SpawnErr(code) }
    }
    if err >= 0 {
        code = c_actions_dup2(&actions[0], err, 2)
        if code != 0 { return sys.Process(-1), SpawnErr(code) }
    }
    code = c_posix_spawnp(&pid, argv[0], &actions[0], &attributes, &argv[0], &envp[0])
    if code != 0 { return sys.Process(-1), SpawnErr(code) }

    return sys.Process(pid), null
}
