/* mem — the fixed process-wide raw allocation boundary.
 *
 * These declarations define the public Ace surface. The bootstrap compiler
 * recognizes this exact standard module and lowers calls directly to the
 * platform allocator; the fallback bodies are never emitted.
 */

pub alloc(size: int, align: int): mut []u8 { return null }

pub realloc(data: []u8, new_size: int): mut []u8 { return null }

pub release(mut data: []u8) { data = null }

/* Typed allocation over the same fixed allocator: the element type is stated
 * at the explicit instantiation, and the byte size and alignment derive from
 * it. The bootstrap compiler lowers these exact declarations directly, like
 * the raw forms above.
 */

pub alloc[T](count: usize): mut []T { return null }

pub realloc[T](data: []T, new_count: usize): mut []T { return null }

pub release[T](mut data: []T) { data = null }

/* Usable size in bytes of a live allocation, at least the requested length
 * and allocator-defined beyond it. `data` must be the base slice a raw
 * `alloc`/`realloc` returned; null and non-allocation pointers report 0. The
 * bootstrap compiler lowers this exact declaration directly to the platform
 * allocator's size query.
 */

pub alloc_size(data: []u8): usize { return 0 }

/* Byte operations use complete slice views as their ranges. Write destinations
 * carry type-position `mut` (Mutability #10): their argument must be a
 * `mut []u8` view. The bootstrap compiler emits them natively as calls to
 * wide per-object routines; no platform memory routine is called.
 */

pub copy(noalias dst: mut []u8, src: []u8) {}

pub move(dst: mut []u8, src: []u8) {}

pub fill(data: mut []u8, value: u8) {}

pub zero(data: mut []u8) {}

pub compare(a: []u8, b: []u8): int { return 0 }

/* The bootstrap accepts every pairwise [N]u8, []u8, and string combination
 * at this compiler-backed declaration; its representative parameter types do
 * not constrain intrinsic call checking.
 */
pub equal(a: []u8, b: []u8): bool { return false }

/* Grows `slice` to at least `needed` elements, doubling its length when that
 * is larger. A null slice allocates. On allocation failure or count overflow
 * the caller's slice is returned unchanged with false; the original stays
 * live, so check the flag before replacing the caller's slice.
 */
pub grow[T](slice: mut []T, needed: usize): (mut []T, bool) {
    if slice.len >= needed { return slice, true }
    capacity: usize = slice.len * 2
    if capacity < slice.len { return slice, false }
    if capacity < needed { capacity = needed }
    if capacity == 0 { capacity = 1 }
    if slice == null {
        fresh: mut []T = alloc[T](capacity)
        if fresh == null { return slice, false }
        return fresh, true
    }
    bigger: mut []T = realloc[T](slice, capacity)
    if bigger == null { return slice, false }
    return bigger, true
}
