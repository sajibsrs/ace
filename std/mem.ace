/* mem — the fixed process-wide raw allocation boundary.
 *
 * These declarations define the public Ace surface. The bootstrap compiler
 * recognizes this exact standard module and lowers calls directly to the
 * platform allocator; the fallback bodies are never emitted.
 */

/* `size` uninitialized bytes aligned to `align`, or null on failure. */
pub alloc(size: int, align: int): []u8 {
    return null
}

/* Resizes allocation `data` to `new_size` bytes, possibly moving it, and
 * returns the new slice; null on failure, with `data` still live.
 */
pub realloc(data: []u8, new_size: int): []u8 {
    return null
}

/* Releases allocation `*data` and nulls the caller's slice; a null slice
 * is a no-op.
 */
pub release(data: *[]u8) {
    *data = null
}

/* Typed allocation over the same fixed allocator: the element type is stated
 * at the explicit instantiation, and the byte size and alignment derive from
 * it. The bootstrap compiler lowers these exact declarations directly, like
 * the raw forms above.
 */
pub alloc[T](count: usize): []T {
    return null
}

/* Like `alloc[T]`, but every byte of the returned storage is zero, which is
 * a valid `T` for every type. The bootstrap compiler lowers it directly to the
 * platform's zero-filling allocator.
 */
pub zalloc[T](count: usize): []T {
    return null
}

/* Resizes typed allocation `data` to `new_count` elements, possibly moving
 * it; null on failure, with `data` still live.
 */
pub realloc[T](data: []T, new_count: usize): []T {
    return null
}

/* Releases typed allocation `*data` and nulls the caller's slice; a null
 * slice is a no-op.
 */
pub release[T](data: *[]T) {
    data = null
}

/* One `T` reached by pointer, uninitialized like `alloc[T]`, or null on the
 * same failures. Release it with the pointer form below.
 */
pub new[T](): *T {
    data: []T = alloc[T](1)
    if data == null { return null }
    return &data[0]
}

/* Releases what `new[T]` returned and nulls the caller's pointer; a null
 * pointer is a no-op.
 */
pub release[T](data: **T) {
    if *data == null { return }
    whole: []T = []T(*data, usize(1))
    release[T](&whole)
    *data = null
}

/* Usable size in bytes of a live allocation, at least the requested length
 * and allocator-defined beyond it. `data` must be the base slice a raw
 * `alloc`/`realloc` returned; null and non-allocation pointers report 0. The
 * bootstrap compiler lowers this exact declaration directly to the platform
 * allocator's size query.
 */
pub usable(data: []u8): usize {
    return 0
}

/* Copies `src` into `dst`, which must have equal lengths and not overlap.
 * Byte operations use complete slice views as their ranges. The bootstrap
 * compiler emits them natively as calls to wide per-object routines; no
 * platform memory routine is called.
 */
pub copy(noalias dst: []u8, src: []u8) {}

/* Like `copy`, but `dst` and `src` may overlap in either direction. */
pub move(dst: []u8, src: []u8) {}

/* Typed forms of `copy` and `move`: equal element counts, copying
 * `len * sizeof(T)` bytes under the same rules as the byte forms.
 */
pub copy[T](noalias dst: []T, src: []T) {}

pub move[T](dst: []T, src: []T) {}

/* Sets every byte of `data` to `value`. */
pub fill(data: []u8, value: u8) {}

/* Sets every byte of `data` to zero. */
pub zero(data: []u8) {}

/* -1, 0, or 1 as `a` sorts before, equal to, or after `b`, comparing
 * unsigned bytes; after an equal prefix the shorter sorts first.
 */
pub compare(a: []u8, b: []u8): int {
    return 0
}

/* The bootstrap accepts every pairwise [N]u8, []u8, and string combination
 * at this compiler-backed declaration; its representative parameter types do
 * not constrain intrinsic call checking.
 */
pub equal(a: []u8, b: []u8): bool {
    return false
}

/* Grows `slice` to at least `needed` elements, doubling its length when that
 * is larger. A null slice allocates. On allocation failure or count overflow
 * the caller's slice is returned unchanged with false; the original stays
 * live, so check the flag before replacing the caller's slice.
 */
@cold
pub grow[T](slice: []T, needed: usize): ([]T, bool) {
    if slice.len >= needed { return slice, true }
    capacity: usize = slice.len * 2
    if capacity < slice.len { return slice, false }
    if capacity < needed { capacity = needed }
    if capacity == 0 { capacity = 1 }
    if slice == null {
        fresh: []T = alloc[T](capacity)
        if fresh == null { return slice, false }

        return fresh, true
    }
    bigger: []T = realloc[T](slice, capacity)
    if bigger == null { return slice, false }

    return bigger, true
}
