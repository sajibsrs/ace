/* map — a hash map from keys to values over the process allocator.
 *
 * A Map holds `count` live entries in `slots`, whose length is the capacity: a
 * power of two, or zero for the canonical zero value and the empty literal
 * `Map[K, V]{}`, which are valid empty maps holding no storage. Entries live
 * in open-addressed slots probed linearly from the key's hash; the table
 * grows, doubling and rehashing into fresh storage, whenever an insertion
 * would exceed three quarters full, and `unset` shifts later entries back
 * over the hole, so no tombstones exist. Allocation failure is an `Error` and
 * leaves the map unchanged. Iteration order is unspecified and iteration is
 * not offered. Call `wipe` once the map is no longer used.
 *
 * The key type K is one of the integer types, `bool`, or `string`; `hash` and
 * `same` are specialized for exactly those, and any other key type is a
 * compile-time error at the instantiation.
 */

import bits
import mem

pub MapErr: error {
    1: allocation = "map storage allocation failed",
}

pub Slot[K, V]: struct {
    key: K,
    value: V,
    used: bool,
}

pub Map[K, V]: struct {
    slots: []Slot[K, V] = null,
    count: usize = 0,
}

hash[K](key: K): u64 specialized

same[K](a: K, b: K): bool specialized

FIB: const u64 = 0x9e3779b97f4a7c15

/* The slot `h` starts probing at in `n` slots, a power of two: its top bits,
 * where a multiplicative hash mixes in every key bit.
 */
inline home(h: u64, n: usize): usize {
    return usize(h >> (bits.clz(u64(n)) + 1))
}

/* Finalizer that spreads every bit of a string's FNV-1a hash across the top
 * bits used to index.
 */
inline mix(value: u64): u64 {
    x: u64 = value
    x = bits.wrmul(x ^ (x >> 30), u64(0xbf58476d1ce4e5b9))
    x = bits.wrmul(x ^ (x >> 27), u64(0x94d049bb133111eb))
    return x ^ (x >> 31)
}

inline hash[i8](key: i8): u64 {
    return bits.wrmul(u64(key), FIB)
}

inline hash[i16](key: i16): u64 {
    return bits.wrmul(u64(key), FIB)
}

inline hash[i32](key: i32): u64 {
    return bits.wrmul(u64(key), FIB)
}

inline hash[i64](key: i64): u64 {
    return bits.wrmul(u64(key), FIB)
}

inline hash[u8](key: u8): u64 {
    return bits.wrmul(u64(key), FIB)
}

inline hash[u16](key: u16): u64 {
    return bits.wrmul(u64(key), FIB)
}

inline hash[u32](key: u32): u64 {
    return bits.wrmul(u64(key), FIB)
}

inline hash[u64](key: u64): u64 {
    return bits.wrmul(key, FIB)
}

inline hash[usize](key: usize): u64 {
    return bits.wrmul(u64(key), FIB)
}

inline hash[bool](key: bool): u64 {
    if key { return FIB }
    return 0
}

/* FNV-1a over the bytes, then the finalizer. */
inline hash[string](key: string): u64 {
    h: u64 = 0xcbf29ce484222325
    for i: usize in 0 .. key.len { h = bits.wrmul(h ^ u64(key[i]), u64(0x100000001b3)) }
    return mix(h)
}

inline same[i8](a: i8, b: i8): bool {
    return a == b
}

inline same[i16](a: i16, b: i16): bool {
    return a == b
}

inline same[i32](a: i32, b: i32): bool {
    return a == b
}

inline same[i64](a: i64, b: i64): bool {
    return a == b
}

inline same[u8](a: u8, b: u8): bool {
    return a == b
}

inline same[u16](a: u16, b: u16): bool {
    return a == b
}

inline same[u32](a: u32, b: u32): bool {
    return a == b
}

inline same[u64](a: u64, b: u64): bool {
    return a == b
}

inline same[usize](a: usize, b: usize): bool {
    return a == b
}

inline same[bool](a: bool, b: bool): bool {
    return a == b
}

inline same[string](a: string, b: string): bool {
    return mem.equal(a, b)
}

/* The slot holding `key`, or else the empty slot where it belongs. `slots` is
 * nonempty and never full, which the load limit guarantees.
 */
inline probe[K, V](slots: []Slot[K, V], key: K): usize {
    mask: usize = slots.len - 1
    at: usize = home(hash[K](key), slots.len)
    for slots[at].used && !same[K](slots[at].key, key) { at = (at + 1) & mask }
    return at
}

/* The smallest capacity that holds `count` entries within the load limit. */
capacity_for(count: usize): usize {
    capacity: usize = 8
    for capacity * 3 < count * 4 { capacity *= 2 }
    return capacity
}

/* Creates a map with room for `capacity` entries and none live. A zero
 * capacity allocates nothing.
 */
pub Map[K, V].new(capacity: usize): (Map[K, V], Error) {
    map: Map[K, V] = Map[K, V] {}
    if capacity == 0 { return map, null }
    err: Error = map.rehash(capacity_for(capacity))
    if err != null { return Map[K, V] {}, err }

    return map, null
}

/* Releases the map's storage and leaves it empty. */
pub Map[K, V].wipe(self) {
    mem.release[Slot[K, V]](&self.slots)
    self.count = 0
}

/* Moves every live entry into fresh storage of `capacity` slots, a power of
 * two large enough for them.
 */
Map[K, V].rehash(self, capacity: usize): Error {
    fresh: []Slot[K, V] = mem.zalloc[Slot[K, V]](capacity)
    if fresh == null { return MapErr.allocation }
    old: []Slot[K, V] = self.slots
    for i: usize in 0 .. old.len {
        if old[i].used { fresh[probe[K, V](fresh, old[i].key)] = old[i] }
    }
    mem.release[Slot[K, V]](&self.slots)
    self.slots = fresh
    return null
}

/* The number of live entries. */
pub Map[K, V].len(const self): usize {
    return self.count
}

pub inline Map[K, V].has(const self, key: K): bool {
    if self.count == 0 { return false }
    return self.slots[probe[K, V](self.slots, key)].used
}

/* The value stored for `key`. A missing key returns `blank(V)` and false. */
pub inline Map[K, V].get(const self, key: K): (V, bool) {
    if self.count == 0 { return blank(V), false }
    at: usize = probe[K, V](self.slots, key)
    if !self.slots[at].used { return blank(V), false }
    return self.slots[at].value, true
}

/* Stores `value` under `key`, replacing any earlier value, and grows storage
 * when a new entry would exceed the load limit.
 */
pub inline Map[K, V].set(self, key: K, value: V): Error {
    at: usize = 0
    slots: []Slot[K, V] = self.slots
    if slots.len != 0 {
        at = probe[K, V](slots, key)
        if slots[at].used {
            slots[at].value = value
            return null
        }
    }
    if (self.count + 1) * 4 > self.slots.len * 3 {
        err: Error = self.rehash(capacity_for(self.count + 1))
        if err != null { return err }
        at = probe[K, V](self.slots, key)
    }
    self.slots[at] = Slot[K, V] {
        key = key,
        value = value,
        used = true,
    }
    self.count += 1
    return null
}

/* Removes `key`, returning whether it was present. */
pub inline Map[K, V].unset(self, key: K): bool {
    if self.count == 0 { return false }
    slots: []Slot[K, V] = self.slots
    n: usize = slots.len
    mask: usize = n - 1
    hole: usize = probe[K, V](slots, key)
    if !slots[hole].used { return false }
    at: usize = hole
    for {
        at = (at + 1) & mask
        if !slots[at].used { break }
        from: usize = home(hash[K](slots[at].key), n)
        // The entry may fill the hole unless its home lies cyclically in
        // (hole, at], where the probe from home would no longer reach it.
        if ((at + n - from) & mask) >= ((at + n - hole) & mask) {
            slots[hole] = slots[at]
            hole = at
        }
    }
    slots[hole].used = false
    self.count -= 1
    return true
}

/* Ensures room for at least `count` entries in total. */
pub Map[K, V].reserve(self, count: usize): Error {
    capacity: usize = capacity_for(count)
    if capacity <= self.slots.len { return null }

    return self.rehash(capacity)
}

/* Drops every entry and keeps the storage. */
pub Map[K, V].clear(self) {
    for i: usize in 0 .. self.slots.len { self.slots[i].used = false }
    self.count = 0
}
