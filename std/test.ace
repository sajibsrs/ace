/* test — table-driven test runner.
 *
 * A test is `pub name(t: *test.T)` in a test file whose `main` returns `test.run([("name", name), ...])`. Checks report the
 * test's name and the location the caller passes; nothing allocates.
 */

import fmt
import mem

/* One test's state: whether a check failed. */
pub T: struct {
    failed: bool,
}

/* A named test function. */
pub Case: type = (string, (t: *T): void)

/* On failure marks the test failed and prints the check's location. */
begin(t: *T, ok: bool, file: string, line: int): bool {
    if ok { return true }

    t.failed = true
    fmt.print("    ")
    fmt.print(file)
    fmt.print(":")
    fmt.print(line)
    fmt.print(": ")
    return false
}

pub T.equal(self, got: int, want: int, file: string, line: int): bool {
    if begin(&self, got == want, file, line) { return true }
    fmt.print("got ")
    fmt.print(got)
    fmt.print(", want ")
    fmt.println(want)
    return false
}

pub T.equal(self, got: uint, want: uint, file: string, line: int): bool {
    if begin(&self, got == want, file, line) { return true }
    fmt.print("got ")
    fmt.print(got)
    fmt.print(", want ")
    fmt.println(want)
    return false
}

pub T.equal(self, got: usize, want: usize, file: string, line: int): bool {
    if begin(&self, got == want, file, line) { return true }
    fmt.print("got ")
    fmt.print(got)
    fmt.print(", want ")
    fmt.println(want)
    return false
}

pub T.equal(self, got: bool, want: bool, file: string, line: int): bool {
    if begin(&self, got == want, file, line) { return true }
    fmt.print("got ")
    fmt.print(got)
    fmt.print(", want ")
    fmt.println(want)
    return false
}

pub T.equal(self, got: string, want: string, file: string, line: int): bool {
    if begin(&self, mem.equal(got, want), file, line) { return true }
    fmt.print("got \"")
    fmt.print(got)
    fmt.print("\", want \"")
    fmt.print(want)
    fmt.println("\"")
    return false
}

/* Compares enum values of type `E`, printing members by name; an open
 * enum's non-member prints as an empty name. */
pub equal[E](t: *T, got: E, want: E, file: string, line: int): bool {
    if begin(t, got == want, file, line) { return true }
    fmt.print("got ")
    fmt.print(got.name)
    fmt.print(", want ")
    fmt.println(want.name)
    return false
}

/* Fails the test unconditionally with `message`. */
pub T.fail(self, message: string, file: string, line: int) {
    begin(&self, false, file, line)
    fmt.println(message)
}

/* Runs `table` in order, printing `ok   name` or `FAIL name` per case and then
 * `N passed, M failed`. Returns 0 when every case passed, otherwise 1.
 */
pub run(table: []Case): int {
    passed: int = 0
    failed: int = 0

    for i: usize = 0; i < table.len; i += 1 {
        name: string, body: (t: *T): void = table[i]
        t: T = blank(T)
        body(&t)
        if t.failed {
            fmt.print("FAIL ")
            failed += 1
        } else {
            fmt.print("ok   ")
            passed += 1
        }
        fmt.println(name)
    }

    fmt.print(passed)
    fmt.print(" passed, ")
    fmt.print(failed)
    fmt.println(" failed")
    if failed > 0 { return 1 }
    return 0
}
