/* Darwin sys OS layer — process termination, file descriptors, byte I/O,
 * and monotonic time (Darwin/Apple arm64).
 *
 * Pure Ace over the system library through extern "c"; the link-name syntax
 * keeps the raw C bindings private. Every public function is allocation-free;
 * only callers allocate.
 */

/* Descriptor handle. Canonical zero is fd 0 (stdin, valid); -1 marks a
 * failed open. There is no named invalid constant.
 */
pub Fd: distinct i32
pub Process: distinct i32

pub ProcessStatus: struct {
    exited: bool,
    code: int,
    signal: int,
}

/* The three standard descriptors, valid from process start: standard input
 * (0), standard output (1), and standard error (2).
 */
pub stdin: const Fd = Fd(0)
pub stdout: const Fd = Fd(1)
pub stderr: const Fd = Fd(2)

/* Terminate immediately with the requested process status. This does not
 * return, unwind, run defers, or invoke C-runtime exit handlers.
 */
pub exit(code: int) {
    c_exit(i32(code))
}

/* Per-operation error domains: the failing operation is readable from the
 * returned handle's domain; the raw errno is queried separately via errno().
 */

pub OpenErr: error
pub ReadErr: error
pub WriteErr: error
pub CloseErr: error
pub StatErr: error
pub MkdirErr: error
pub RenameErr: error
pub UnlinkErr: error
pub OpenDirErr: error
pub ReadDirErr: error
pub CloseDirErr: error
pub ForkErr: error
pub WaitErr: error
pub PipeErr: error

pub FileKind: enum { unknown, regular, directory, symlink, other }

pub FileInfo: struct {
    size: u64,
    kind: FileKind,
}

/* Caller-owned directory iteration state. `active` makes canonical zero an
 * invalid handle even when the kernel returns descriptor zero.
 */
pub Dir: struct {
    fd: Fd,
    buffer: [4096]u8,
    next: usize,
    count: usize,
    base: i64,
    active: bool,
    done: bool,
}

DarwinTimespec: struct {
    seconds: i64,
    nanoseconds: i64,
}

/* Darwin arm64's 64-bit-inode struct stat from <sys/stat.h>. */
DarwinStat: struct {
    device: i32,
    mode: u16,
    links: u16,
    inode: u64,
    user: u32,
    group: u32,
    special_device: i32,
    access: DarwinTimespec,
    modification: DarwinTimespec,
    change: DarwinTimespec,
    birth: DarwinTimespec,
    size: i64,
    blocks: i64,
    block_size: i32,
    flags: u32,
    generation: u32,
    spare: i32,
    qspare: [2]i64,
}

extern "c" {
    /* `open` is variadic and Apple arm64 passes its variadic mode on the
     * caller's stack, so the fixed-arity libSystem export __open is used.
     */
    c_open(path: *u8, flags: i32, mode: u32): i32 = "__open"
    c_close(fd: i32): i32 = "close"
    c_read(fd: i32, buf: mut *u8, size: usize): i64 = "read"
    c_write(fd: i32, buf: *u8, size: usize): i64 = "write"
    c_stat(path: *u8, info: mut *DarwinStat): i32 = "stat"
    c_mkdir(path: *u8, mode: u32): i32 = "mkdir"
    c_rename(old_path: *u8, new_path: *u8): i32 = "rename"
    c_unlink(path: *u8): i32 = "unlink"
    c_getdirentries64(fd: i32, buf: mut *u8, size: usize, base: mut *i64): i32 = "__getdirentries64"
    c_errno(): mut *i32 = "__error"
    c_clock_gettime_nsec_np(clk_id: i32): u64 = "clock_gettime_nsec_np"
    c_exit(status: i32) = "_exit"
    c_fork(): i32 = "fork"
    c_waitpid(pid: i32, status: mut *i32, options: i32): i32 = "waitpid"
    c_pipe(fds: mut *i32): i32 = "pipe"
}

// open(2) flags: Darwin values and spellings, composed with `|`.
pub O_RDONLY: const i32 = 0
pub O_WRONLY: const i32 = 1
pub O_RDWR: const i32 = 2
pub O_NONBLOCK: const i32 = 0x0004
pub O_APPEND: const i32 = 0x0008
pub O_CREAT: const i32 = 0x0200
pub O_TRUNC: const i32 = 0x0400
pub O_EXCL: const i32 = 0x0800
O_DIRECTORY: const i32 = 0x00100000

// Retryable nonblocking-operation errno values on Darwin.
pub EAGAIN: const i32 = 35
pub EWOULDBLOCK: const i32 = EAGAIN

// POSIX creation-permission bits for open(2) and mkdir(2).
pub S_IRWXU: const u32 = 0x1C0
pub S_IRUSR: const u32 = 0x100
pub S_IWUSR: const u32 = 0x080
pub S_IXUSR: const u32 = 0x040
pub S_IRWXG: const u32 = 0x038
pub S_IRGRP: const u32 = 0x020
pub S_IWGRP: const u32 = 0x010
pub S_IXGRP: const u32 = 0x008
pub S_IRWXO: const u32 = 0x007
pub S_IROTH: const u32 = 0x004
pub S_IWOTH: const u32 = 0x002
pub S_IXOTH: const u32 = 0x001

errno_set(value: i32) {
    slot: mut *i32 = c_errno()
    ~slot = value
}

path_copy(path: string, buf: mut []u8): bool {
    if len(path) > 1023 {
        errno_set(63)
        return false
    }
    for i: usize in 0 .. len(path) {
        buf[i] = path[i]
    }
    buf[len(path)] = 0
    return true
}

zero_dir(): Dir {
    dir: Dir = Dir {
        fd: Fd(0),
        buffer: [u8(0) : 4096],
        next: 0,
        count: 0,
        base: 0,
        active: false,
        done: false,
    }
    return dir
}

zero_timespec(): DarwinTimespec {
    return DarwinTimespec { seconds: 0, nanoseconds: 0 }
}

zero_stat(): DarwinStat {
    time: DarwinTimespec = zero_timespec()
    return DarwinStat {
        device: 0,
        mode: 0,
        links: 0,
        inode: 0,
        user: 0,
        group: 0,
        special_device: 0,
        access: time,
        modification: time,
        change: time,
        birth: time,
        size: 0,
        blocks: 0,
        block_size: 0,
        flags: 0,
        generation: 0,
        spare: 0,
        qspare: [i64(0) : 2],
    }
}

kind_from_mode(mode: u16): FileKind {
    kind: u16 = mode & u16(0xf000)
    if kind == u16(0x8000) {
        return FileKind.regular
    }
    if kind == u16(0x4000) {
        return FileKind.directory
    }
    if kind == u16(0xa000) {
        return FileKind.symlink
    }
    return FileKind.other
}

kind_from_dirent(kind: u8): FileKind {
    if kind == 8 {
        return FileKind.regular
    }
    if kind == 4 {
        return FileKind.directory
    }
    if kind == 10 {
        return FileKind.symlink
    }
    if kind == 0 {
        return FileKind.unknown
    }
    return FileKind.other
}

/* Raw errno of the most recent system call (thread-local). Query it
 * immediately after a failed call; any intervening call may overwrite it.
 */
pub errno(): i32 {
    slot: mut *i32 = c_errno()
    return ~slot
}

pub fork(): (Process, Error) {
    pid: i32 = c_fork()

    if pid == -1 {
        return Process(-1), ForkErr(errno())
    }
    return Process(pid), null
}

pub wait(process: Process): (ProcessStatus, Error) {
    raw: i32 = 0

    if i32(process) <= 0 {
        errno_set(22)
        zero: ProcessStatus = ProcessStatus {exited: false, code: 0, signal: 0}
        return zero, WaitErr(errno())
    }

    if c_waitpid(i32(process), mut &raw, 0) == -1 {
        zero: ProcessStatus = ProcessStatus {exited: false, code: 0, signal: 0}
        return zero, WaitErr(errno())
    }
    signal: int = int(raw & 0x7f)

    if signal == 0 {
        status: ProcessStatus = ProcessStatus {
            exited: true,
            code: int((raw >> 8) & 0xff),
            signal: 0,
        }
        return status, null
    }
    return ProcessStatus {exited: false, code: 0, signal: signal}, null
}

pub pipe(): (Fd, Fd, Error) {
    fds: [2]i32 = [i32(0) : 2]

    if c_pipe(mut &fds[0]) == -1 {
        return Fd(-1), Fd(-1), PipeErr(errno())
    }
    return Fd(fds[0]), Fd(fds[1]), null
}

pub read(fd: Fd, buf: mut []u8): (int, Error) {
    if len(buf) == 0 {
        return 0, null
    }
    n: i64 = c_read(i32(fd), mut &buf[0], len(buf))

    if n < 0 {
        return 0, ReadErr(errno())
    }
    return int(n), null
}

// Partial writes are legitimate results and are returned as-is; no retry.
pub write(fd: Fd, data: []u8): (int, Error) {
    if len(data) == 0 {
        return 0, null
    }
    n: i64 = c_write(i32(fd), &data[0], len(data))

    if n < 0 {
        return 0, WriteErr(errno())
    }
    return int(n), null
}

pub close(fd: Fd): Error {
    if c_close(i32(fd)) == -1 {
        return CloseErr(errno())
    }
    return null
}

pub open(path: string, flags: i32): (Fd, Error) {
    fd: Fd, err: Error = open(path, flags, u32(0))
    return fd, err
}

/* The path is copied into a fixed PATH_MAX stack buffer and NUL-terminated;
 * the kernel rejects longer paths itself, so the buffer never rejects a
 * legitimate one. Overlong paths fail with ENAMETOOLONG via errno().
 */
pub open(path: string, flags: i32, mode: u32): (Fd, Error) {
    buf: [1024]u8

    if !path_copy(path, mut buf[0..1024]) {
        return Fd(-1), OpenErr(errno())
    }
    fd: i32 = c_open(&buf[0], flags, mode)

    if fd == -1 {
        return Fd(-1), OpenErr(errno())
    }
    return Fd(fd), null
}

pub stat(path: string): (FileInfo, Error) {
    path_buf: [1024]u8
    zero: FileInfo = FileInfo { size: 0, kind: FileKind.unknown }

    if !path_copy(path, mut path_buf[0..1024]) {
        return zero, StatErr(errno())
    }
    raw: DarwinStat = zero_stat()
    if c_stat(&path_buf[0], mut &raw) == -1 {
        return zero, StatErr(errno())
    }
    return FileInfo { size: u64(raw.size), kind: kind_from_mode(raw.mode) }, null
}

pub mkdir(path: string, mode: u32): Error {
    path_buf: [1024]u8
    if !path_copy(path, mut path_buf[0..1024]) {
        return MkdirErr(errno())
    }
    if c_mkdir(&path_buf[0], mode) == -1 {
        return MkdirErr(errno())
    }
    return null
}

/* Portable creation form: request all ordinary permissions and let the
 * process umask choose the effective platform permissions.
 */
pub mkdir(path: string): Error {
    return mkdir(path, S_IRWXU | S_IRWXG | S_IRWXO)
}

pub rename(old_path: string, new_path: string): Error {
    from_buf: [1024]u8
    to_buf: [1024]u8
    if !path_copy(old_path, mut from_buf[0..1024]) {
        return RenameErr(errno())
    }
    if !path_copy(new_path, mut to_buf[0..1024]) {
        return RenameErr(errno())
    }
    if c_rename(&from_buf[0], &to_buf[0]) == -1 {
        return RenameErr(errno())
    }
    return null
}

pub unlink(path: string): Error {
    path_buf: [1024]u8
    if !path_copy(path, mut path_buf[0..1024]) {
        return UnlinkErr(errno())
    }
    if c_unlink(&path_buf[0]) == -1 {
        return UnlinkErr(errno())
    }
    return null
}

pub open_dir(path: string): (Dir, Error) {
    path_buf: [1024]u8
    if !path_copy(path, mut path_buf[0..1024]) {
        return zero_dir(), OpenDirErr(errno())
    }
    fd: i32 = c_open(&path_buf[0], O_RDONLY | O_DIRECTORY, u32(0))
    if fd == -1 {
        return zero_dir(), OpenDirErr(errno())
    }
    dir: Dir = Dir {
        fd: Fd(fd),
        buffer: [u8(0) : 4096],
        next: 0,
        count: 0,
        base: 0,
        active: true,
        done: false,
    }
    return dir, null
}

/* Darwin dirent64 records begin with ino:u64, seekoff:u64, reclen:u16,
 * namlen:u16, type:u8, then the name bytes. Entries are retained when the
 * caller's name buffer is too small, so the caller may retry.
 */
pub read_dir(mut dir: Dir, name: mut []u8): (usize, FileKind, bool, Error) {
    if !dir.active {
        errno_set(9)
        return 0, FileKind.unknown, false, ReadDirErr(errno())
    }
    if dir.done {
        return 0, FileKind.unknown, true, null
    }

    for {
        if dir.next == dir.count {
            count: i32 = c_getdirentries64(i32(dir.fd), mut &dir.buffer[0],
                                           4096, mut &dir.base)
            if count < 0 {
                return 0, FileKind.unknown, false, ReadDirErr(errno())
            }
            if count == 0 {
                dir.done = true
                return 0, FileKind.unknown, true, null
            }
            dir.next = 0
            dir.count = usize(count)
        }

        at: usize = dir.next
        if at + 21 > dir.count {
            errno_set(5)
            return 0, FileKind.unknown, false, ReadDirErr(errno())
        }
        record_len: usize = usize(dir.buffer[at + 16]) |
                            (usize(dir.buffer[at + 17]) << 8)
        name_len: usize = usize(dir.buffer[at + 18]) |
                          (usize(dir.buffer[at + 19]) << 8)
        if record_len < 21 || at + record_len > dir.count ||
           name_len > record_len - 21 {
            errno_set(5)
            return 0, FileKind.unknown, false, ReadDirErr(errno())
        }

        is_dot: bool = name_len == 1 && dir.buffer[at + 21] == u8('.')
        is_dot_dot: bool = name_len == 2 &&
                           dir.buffer[at + 21] == u8('.') &&
                           dir.buffer[at + 22] == u8('.')
        if is_dot || is_dot_dot {
            dir.next = at + record_len
        } else {
            if len(name) < name_len {
                errno_set(34)
                return 0, FileKind.unknown, false, ReadDirErr(errno())
            }
            for i: usize in 0 .. name_len {
                name[i] = dir.buffer[at + 21 + i]
            }
            kind: FileKind = kind_from_dirent(dir.buffer[at + 20])
            dir.next = at + record_len
            return name_len, kind, false, null
        }
    }
}

pub close_dir(mut dir: Dir): Error {
    if !dir.active {
        errno_set(9)
        return CloseDirErr(errno())
    }
    fd: i32 = i32(dir.fd)
    dir = zero_dir()
    if c_close(fd) == -1 {
        return CloseDirErr(errno())
    }
    return null
}

/* Monotonic time. Darwin clock ids from mach/clock_types.h:
 * CLOCK_MONOTONIC_RAW runs on mach_continuous_time and keeps advancing while
 * the system is asleep; CLOCK_UPTIME_RAW runs on mach_absolute_time and
 * pauses while the system is asleep. Both are tick-based, so setting the
 * calendar clock moves neither.
 */

CLOCK_MONOTONIC_RAW: const i32 = 4
CLOCK_UPTIME_RAW: const i32 = 8

/* System-wide monotonic nanoseconds from an unspecified origin, reset at
 * every boot. Continues advancing during system sleep, so it stays in sync
 * with real elapsed time across sleep/wake cycles. Unaffected by
 * calendar-clock changes.
 */
pub time_elapsed(): u64 {
    return c_clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW)
}

/* System-wide monotonic nanoseconds from an unspecified origin, reset at
 * every boot. Pauses during system sleep and resumes when the system wakes;
 * unaffected by calendar-clock changes.
 */
pub time_awake(): u64 {
    return c_clock_gettime_nsec_np(CLOCK_UPTIME_RAW)
}
