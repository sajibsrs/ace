/* Darwin sys OS layer — process termination, file descriptors, byte I/O
 * (Darwin/Apple arm64).
 *
 * Pure Ace over the system library through extern "c"; the link-name syntax
 * keeps the raw C bindings private. Every public function is allocation-free;
 * only callers allocate.
 */

/* Descriptor handle. Canonical zero is fd 0 (stdin, valid); -1 marks a
 * failed open. There is no named invalid constant.
 */
pub Fd: distinct i32
pub Process: distinct i32

pub ProcessStatus: struct {
    pub exited: bool,
    pub code: int,
    pub signal: int,
}

/* The three standard descriptors, valid from process start: standard input
 * (0), standard output (1), and standard error (2).
 */
pub stdin: const Fd = Fd(0)
pub stdout: const Fd = Fd(1)
pub stderr: const Fd = Fd(2)

/* Terminate immediately with the requested process status. This does not
 * return, unwind, run defers, or invoke C-runtime exit handlers.
 */
pub exit(code: int) {
    c_exit(i32(code))
}

/* Per-operation error domains: the failing operation is readable from the
 * returned handle's domain; the raw errno is queried separately via errno().
 */

pub OpenErr: error {
    2: not_found = "path does not exist",
    4: interrupted = "open was interrupted",
    9: descriptor = "invalid directory descriptor",
    13: access = "permission denied",
    17: exists = "path already exists",
    20: not_directory = "path component is not a directory",
    21: directory = "path refers to a directory",
    23: system_limit = "system descriptor limit reached",
    24: process_limit = "process descriptor limit reached",
    28: no_space = "device has no space available",
    30: read_only = "file system is read-only",
    35: would_block = "open would block",
    62: loop = "too many symbolic links",
    63: name_too_long = "path is too long",
}

pub ReadErr: error {
    4: interrupted = "read was interrupted",
    9: descriptor = "invalid descriptor",
    14: address = "invalid read buffer address",
    21: directory = "descriptor refers to a directory",
    22: invalid = "invalid read request",
    35: would_block = "read would block",
}

pub WriteErr: error {
    4: interrupted = "write was interrupted",
    9: descriptor = "invalid descriptor",
    13: access = "permission denied",
    14: address = "invalid write buffer address",
    22: invalid = "invalid write request",
    27: too_large = "file is too large",
    28: no_space = "device has no space available",
    32: broken_pipe = "pipe or connection is closed",
    35: would_block = "write would block",
}

pub CloseErr: error {
    4: interrupted = "close was interrupted",
    9: descriptor = "invalid descriptor",
}

pub StatErr: error {
    2: not_found = "path does not exist",
    13: access = "permission denied",
    14: address = "invalid file-information storage",
    20: not_directory = "path component is not a directory",
    62: loop = "too many symbolic links",
    63: name_too_long = "path is too long",
}

pub MkdirErr: error {
    13: access = "permission denied",
    17: exists = "path already exists",
    20: not_directory = "path component is not a directory",
    28: no_space = "device has no space available",
    30: read_only = "file system is read-only",
    62: loop = "too many symbolic links",
    63: name_too_long = "path is too long",
}

pub RenameErr: error {
    2: not_found = "source or destination parent does not exist",
    13: access = "permission denied",
    16: busy = "source or destination is busy",
    17: exists = "destination already exists",
    18: cross_device = "paths are on different file systems",
    20: not_directory = "path component is not a directory",
    21: directory = "file and directory types do not match",
    22: invalid = "invalid rename operation",
    28: no_space = "device has no space available",
    30: read_only = "file system is read-only",
    62: loop = "too many symbolic links",
    63: name_too_long = "path is too long",
    66: not_empty = "destination directory is not empty",
}

pub UnlinkErr: error {
    2: not_found = "path does not exist",
    13: access = "permission denied",
    16: busy = "path is busy",
    20: not_directory = "path component is not a directory",
    21: directory = "path refers to a directory",
    30: read_only = "file system is read-only",
    62: loop = "too many symbolic links",
    63: name_too_long = "path is too long",
}

pub OpendirErr: error {
    2: not_found = "directory does not exist",
    13: access = "permission denied",
    20: not_directory = "path is not a directory",
    23: system_limit = "system descriptor limit reached",
    24: process_limit = "process descriptor limit reached",
    62: loop = "too many symbolic links",
    63: name_too_long = "path is too long",
}

pub CanonicalErr: error {
    2: not_found = "path does not exist",
    13: access = "permission denied",
    20: not_directory = "path component is not a directory",
    34: capacity = "path storage is too small",
    62: loop = "too many symbolic links",
    63: name_too_long = "path is too long",
}

pub ExecutableErr: error {
    2: not_found = "executable path does not exist",
    34: capacity = "path storage is too small",
}

pub ReaddirErr: error {
    5: malformed = "operating-system directory data is malformed",
    9: inactive = "directory is not active",
    34: capacity = "name storage is too small",
}

pub ClosedirErr: error {
    9: inactive = "directory is not active",
}

pub RandomErr: error {
    5: input_output = "secure random source failed",
    14: address = "secure random destination is invalid",
    22: invalid = "secure random request is invalid",
}
pub ForkErr: error {
    12: memory = "insufficient memory to create process",
    35: retry = "temporary process resource limit reached",
    67: process_limit = "process limit reached",
}

pub WaitErr: error {
    4: interrupted = "process wait was interrupted",
    10: no_child = "process is not a child of this process",
    22: invalid = "process handle must be positive",
}

pub PipeErr: error {
    23: system_limit = "system descriptor limit reached",
    24: process_limit = "process descriptor limit reached",
}

pub IoctlErr: error {
    9: descriptor = "invalid descriptor",
    14: address = "invalid device-control data address",
    22: empty = "device-control data storage must not be empty",
    25: inappropriate = "device does not support the requested control",
}

pub FileType: enum { unknown, regular, directory, symlink, other }

/* `device` and `inode` together identify the file: two infos describe one
 * file exactly when both are equal.
 */
pub FileInfo: struct {
    pub size: u64,
    pub file_type: FileType,
    pub device: u64,
    pub inode: u64,
}

/* Caller-owned directory iteration state. `active` makes canonical zero an
 * invalid handle even when the kernel returns descriptor zero.
 */
pub Dir: struct {
    fd: Fd,
    buffer: [4096]u8,
    next: usize,
    count: usize,
    base: i64,
    active: bool,
    done: bool,
}

DarwinTimespec: struct {
    seconds: i64,
    nanoseconds: i64,
}

/* Darwin arm64's 64-bit-inode struct stat from <sys/stat.h>. */
DarwinStat: struct {
    device: i32,
    mode: u16,
    links: u16,
    inode: u64,
    user: u32,
    group: u32,
    special_device: i32,
    access: DarwinTimespec,
    modification: DarwinTimespec,
    change: DarwinTimespec,
    birth: DarwinTimespec,
    size: i64,
    blocks: i64,
    block_size: i32,
    flags: u32,
    generation: u32,
    spare: i32,
    qspare: [2]i64,
}

/* getattrlist(2) request and its ATTR_CMN_FULLPATH reply: the reply's
 * length word, then an attrreference whose offset counts from itself.
 */
DarwinAttrList: struct {
    count: u16,
    reserved: u16,
    common: u32,
    volume: u32,
    directory: u32,
    file: u32,
    fork: u32,
}

DarwinFullPath: struct {
    length: u32,
    offset: i32,
    size: u32,
    data: [1024]u8,
}

static_assert(sizeof(DarwinAttrList) == 24)
static_assert(offsetof(DarwinFullPath, data) == 12)

/* Darwin arm64 layouts used to derive and verify the BPF ioctl request
 * values. The public ioctl wrapper still accepts caller-owned bytes; it does
 * not turn byte storage into typed storage.
 */
@align(8)
DarwinIfreq: struct {
    name: [16]u8,
    data: [16]u8,
}

DarwinBpfTimeval: struct {
    seconds: i32,
    microseconds: i32,
}

DarwinBpfHeader: struct {
    timestamp: DarwinBpfTimeval,
    captured_length: u32,
    data_length: u32,
    header_length: u16,
}

static_assert(sizeof(DarwinIfreq) == 32 && alignof(DarwinIfreq) == 8)
static_assert(offsetof(DarwinIfreq, name) == 0 && offsetof(DarwinIfreq, data) == 16)
static_assert(sizeof(DarwinBpfTimeval) == 8 && alignof(DarwinBpfTimeval) == 4)
static_assert(sizeof(DarwinBpfHeader) == 20 && alignof(DarwinBpfHeader) == 4)
static_assert(offsetof(DarwinBpfHeader, captured_length) == 8)
static_assert(offsetof(DarwinBpfHeader, data_length) == 12)
static_assert(offsetof(DarwinBpfHeader, header_length) == 16)

extern "c" {
    /* `open` is variadic and Apple arm64 passes its variadic mode on the
     * caller's stack, so the fixed-arity libSystem export __open is used.
     */
    c_open(path: *u8, flags: i32, mode: u32): i32 as "__open"
    c_close(fd: i32): i32 as "close"
    c_read(fd: i32, buf: mut *u8, size: usize): i64 as "read"
    c_write(fd: i32, buf: *u8, size: usize): i64 as "write"
    c_stat(path: *u8, info: mut *DarwinStat): i32 as "stat"
    c_lstat(path: *u8, info: mut *DarwinStat): i32 as "lstat"
    c_getattrlist(path: *u8, list: *DarwinAttrList, buf: mut *DarwinFullPath, size: usize, options: u32): i32 as "getattrlist"
    c_executable(buf: mut *u8, size: mut *u32): i32 as "_NSGetExecutablePath"
    c_mkdir(path: *u8, mode: u32): i32 as "mkdir"
    c_rename(old_path: *u8, new_path: *u8): i32 as "rename"
    c_unlink(path: *u8): i32 as "unlink"
    c_getdirentries64(fd: i32, buf: mut *u8, size: usize, base: mut *i64): i32 as "__getdirentries64"
    c_errno(): mut *i32 as "__error"
    c_getentropy(buffer: mut *u8, size: usize): i32 as "getentropy"
    c_exit(status: i32) as "_exit"
    c_fork(): i32 as "fork"
    c_waitpid(pid: i32, status: mut *i32, options: i32): i32 as "waitpid"
    c_pipe(fds: mut *i32): i32 as "pipe"
    c_fcntl(fd: i32, command: i32, ...): i32 as "fcntl"
    /* Darwin declares ioctl(int, unsigned long, ...). On Apple arm64 every
     * unnamed variadic argument is passed in an eight-byte stack slot.
     */
    c_ioctl(fd: i32, request: uint, ...): i32 as "ioctl"
}

// open(2) flags: Darwin values and spellings, composed with `|`.
pub O_RDONLY: const i32 = 0
pub O_WRONLY: const i32 = 1
pub O_RDWR: const i32 = 2
pub O_NONBLOCK: const i32 = 0x0004
pub O_APPEND: const i32 = 0x0008
pub O_CREAT: const i32 = 0x0200
pub O_TRUNC: const i32 = 0x0400
pub O_EXCL: const i32 = 0x0800
O_DIRECTORY: const i32 = 0x00100000
O_CLOEXEC: const i32 = 0x01000000
F_SETFD: const i32 = 2
FD_CLOEXEC: const i32 = 1

// Public retry-policy errno values on Darwin.
pub EINTR: const i32 = 4
pub EAGAIN: const i32 = 35
pub EWOULDBLOCK: const i32 = EAGAIN
pub EINPROGRESS: const i32 = 36
pub ECONNRESET: const i32 = 54
pub EACCES: const i32 = 13
pub EBUSY: const i32 = 16

/* Darwin limits each getentropy(2) request to 256 bytes. Retry an interrupted
 * chunk and capture errno immediately for every other failure.
 */
pub random(storage: mut []u8): Error {
    at: usize = 0
    for at < storage.len {
        count: usize = storage.len - at
        if count > 256 { count = 256 }
        if c_getentropy(mut &storage[at], count) == 0 {
            at += count
        } else {
            code: i32 = errno()
            if code != EINTR { return RandomErr(code) }
        }
    }
    return null
}

/* Darwin <net/bpf.h> request values, expanded using the SDK's _IOC macros.
 * The request parameter is unsigned long on Darwin, hence uint rather than
 * u32 even though the encoded values occupy 32 bits.
 */
pub BIOCGBLEN: const uint = uint(0x40044266)
pub BIOCPROMISC: const uint = uint(0x20004269)
pub BIOCSETIF: const uint = uint(0x8020426c)
pub BIOCIMMEDIATE: const uint = uint(0x80044270)

// POSIX creation-permission bits for open(2) and mkdir(2).
pub S_IRWXU: const u32 = 0x1C0
pub S_IRUSR: const u32 = 0x100
pub S_IWUSR: const u32 = 0x080
pub S_IXUSR: const u32 = 0x040
pub S_IRWXG: const u32 = 0x038
pub S_IRGRP: const u32 = 0x020
pub S_IWGRP: const u32 = 0x010
pub S_IXGRP: const u32 = 0x008
pub S_IRWXO: const u32 = 0x007
pub S_IROTH: const u32 = 0x004
pub S_IWOTH: const u32 = 0x002
pub S_IXOTH: const u32 = 0x001

errno_set(value: i32) {
    slot: mut *i32 = c_errno()
    *slot = value
}

/* Copies path into buf with a trailing NUL; false, with errno set, when it is
 * too long (ENAMETOOLONG) or holds a NUL byte (EINVAL), which C would read as
 * its end.
 */
path_copy(path: string, buf: mut []u8): bool {
    if path.len > 1023 {
        errno_set(63)
        return false
    }
    for i: usize in 0 .. path.len {
        if path[i] == 0 {
            errno_set(22)
            return false
        }
        buf[i] = path[i]
    }
    buf[path.len] = 0
    return true
}

file_type_from_mode(mode: u16): FileType {
    type_bits: u16 = mode & u16(0xf000)
    if type_bits == u16(0x8000) { return FileType.regular }
    if type_bits == u16(0x4000) { return FileType.directory }
    if type_bits == u16(0xa000) { return FileType.symlink }
    return FileType.other
}

file_type_from_dirent(dirent_type: u8): FileType {
    if dirent_type == 8 { return FileType.regular }
    if dirent_type == 4 { return FileType.directory }
    if dirent_type == 10 { return FileType.symlink }
    if dirent_type == 0 { return FileType.unknown }
    return FileType.other
}

/* Raw errno of the most recent system call (thread-local). Query it
 * immediately after a failed call; any intervening call may overwrite it.
 */
pub errno(): i32 {
    slot: mut *i32 = c_errno()
    return *slot
}

pub fork(): (Process, Error) {
    pid: i32 = c_fork()
    if pid == -1 { return Process(-1), ForkErr(errno()) }

    return Process(pid), null
}

pub wait(process: Process): (ProcessStatus, Error) {
    raw: i32 = 0

    if i32(process) <= 0 {
        errno_set(22)
        zero: ProcessStatus = ProcessStatus {
            exited = false,
            code = 0,
            signal = 0,
        }
        return zero, WaitErr.invalid
    }

    if c_waitpid(i32(process), mut &raw, 0) == -1 {
        zero: ProcessStatus = ProcessStatus {
            exited = false,
            code = 0,
            signal = 0,
        }
        return zero, WaitErr(errno())
    }
    signal: int = int(raw & 0x7f)
    if signal == 0 {
        status: ProcessStatus = ProcessStatus {
            exited = true,
            code = int((raw >> 8) & 0xff),
            signal = 0,
        }
        return status, null
    }

    process_status: ProcessStatus = ProcessStatus {
        exited = false,
        code = 0,
        signal = signal,
    }
    return process_status, null
}

pub pipe(): (Fd, Fd, Error) {
    fds: [2]i32 = [i32(0) : 2]

    if c_pipe(mut &fds[0]) == -1 { return Fd(-1), Fd(-1), PipeErr(errno()) }
    // Darwin has no pipe2: set close-on-exec on both ends right after creation.
    if c_fcntl(fds[0], F_SETFD, FD_CLOEXEC) == -1 || c_fcntl(fds[1], F_SETFD, FD_CLOEXEC) == -1 {
        code: i32 = errno()
        c_close(fds[0])
        c_close(fds[1])
        return Fd(-1), Fd(-1), PipeErr(code)
    }
    return Fd(fds[0]), Fd(fds[1]), null
}

pub read(fd: Fd, buf: mut []u8): (int, Error) {
    if buf.len == 0 { return 0, null }
    n: i64 = c_read(i32(fd), mut &buf[0], buf.len)
    if n < 0 { return 0, ReadErr(errno()) }

    return int(n), null
}

// Partial writes are legitimate results and are returned as-is; no retry.
pub write(fd: Fd, data: []u8): (int, Error) {
    if data.len == 0 { return 0, null }
    n: i64 = c_write(i32(fd), &data[0], data.len)
    if n < 0 { return 0, WriteErr(errno()) }

    return int(n), null
}

pub close(fd: Fd): Error {
    if c_close(i32(fd)) == -1 { return CloseErr(errno()) }
    return null
}

pub ioctl(fd: Fd, request: uint): Error {
    if c_ioctl(i32(fd), request) == -1 {
        code: i32 = errno()
        return IoctlErr(code)
    }
    return null
}

pub ioctl(fd: Fd, request: uint, data: mut []u8): Error {
    if data.len == 0 {
        errno_set(22)
        return IoctlErr.empty
    }
    if c_ioctl(i32(fd), request, &data[0]) == -1 {
        code: i32 = errno()
        return IoctlErr(code)
    }
    return null
}

pub open(path: string, flags: i32): (Fd, Error) {
    fd: Fd, err: Error = open(path, flags, u32(0))
    return fd, err
}

/* The path is copied into a fixed PATH_MAX stack buffer and NUL-terminated;
 * the kernel rejects longer paths itself, so the buffer never rejects a
 * legitimate one. Overlong paths fail with ENAMETOOLONG and paths holding a
 * NUL byte with EINVAL, via errno().
 */
pub open(path: string, flags: i32, mode: u32): (Fd, Error) {
    buf: [1024]u8

    if !path_copy(path, mut buf[0..1024]) { return Fd(-1), OpenErr(errno()) }
    fd: i32 = c_open(&buf[0], flags | O_CLOEXEC, mode)
    if fd == -1 { return Fd(-1), OpenErr(errno()) }

    return Fd(fd), null
}

pub stat(path: string): (FileInfo, Error) {
    info: FileInfo, err: Error = stat(path, true)
    return info, err
}

pub lstat(path: string): (FileInfo, Error) {
    info: FileInfo, err: Error = stat(path, false)
    return info, err
}

stat(path: string, follow: bool): (FileInfo, Error) {
    path_buf: [1024]u8
    zero: FileInfo = FileInfo {
        size = 0,
        file_type = FileType.unknown,
        device = 0,
        inode = 0,
    }

    if !path_copy(path, mut path_buf[0..1024]) { return zero, StatErr(errno()) }
    raw: DarwinStat = blank(DarwinStat)
    result: i32 = 0
    if follow {
        result = c_stat(&path_buf[0], mut &raw)
    } else {
        result = c_lstat(&path_buf[0], mut &raw)
    }
    if result == -1 { return zero, StatErr(errno()) }
    info: FileInfo = FileInfo {
        size = u64(raw.size),
        file_type = file_type_from_mode(raw.mode),
        device = u64(u32(raw.device)),
        inode = raw.inode,
    }
    return info, null
}

/* The kernel's full path of the NUL-terminated `path_buf`, symlinks followed,
 * copied without its NUL into `buf`; the byte count, or -1 with errno set.
 */
full_path(path_buf: []u8, buf: mut []u8): int {
    list: DarwinAttrList = blank(DarwinAttrList)
    list.count = 5        // ATTR_BIT_MAP_COUNT
    list.common = 0x08000000        // ATTR_CMN_FULLPATH
    reply: DarwinFullPath = blank(DarwinFullPath)
    if c_getattrlist(&path_buf[0], &list, mut &reply, sizeof(DarwinFullPath), 0) == -1 { return -1 }
    // The reference sits at byte 4; its data must lie within `reply.data`.
    at: i64 = 4 + i64(reply.offset) - 12
    if at < 0 || reply.size == 0 || u64(at) + u64(reply.size) > 1024 {
        errno_set(5)
        return -1
    }
    count: usize = usize(reply.size) - 1
    if count > buf.len {
        errno_set(34)
        return -1
    }
    for i: usize in 0 .. count { buf[i] = reply.data[usize(at) + i] }
    return int(count)
}

pub canonical(path: string, buf: mut []u8): (usize, Error) {
    path_buf: [1024]u8
    if !path_copy(path, mut path_buf[0..1024]) { return 0, CanonicalErr(errno()) }
    count: int = full_path(path_buf[0..1024], buf)
    if count < 0 { return 0, CanonicalErr(errno()) }
    return usize(count), null
}

pub executable(buf: mut []u8): (usize, Error) {
    path_buf: [1024]u8
    out: mut []u8 = mut path_buf[0..1024]
    size: u32 = 1024
    if c_executable(mut &out[0], mut &size) != 0 { return 0, ExecutableErr.capacity }
    count: int = full_path(path_buf[0..1024], buf)
    if count < 0 { return 0, ExecutableErr(errno()) }
    return usize(count), null
}

pub mkdir(path: string, mode: u32): Error {
    path_buf: [1024]u8
    if !path_copy(path, mut path_buf[0..1024]) { return MkdirErr(errno()) }
    if c_mkdir(&path_buf[0], mode) == -1 { return MkdirErr(errno()) }
    return null
}

/* Portable creation form: request all ordinary permissions and let the
 * process umask choose the effective platform permissions.
 */
pub mkdir(path: string): Error {
    return mkdir(path, S_IRWXU | S_IRWXG | S_IRWXO)
}

pub rename(old_path: string, new_path: string): Error {
    from_buf: [1024]u8
    to_buf: [1024]u8
    if !path_copy(old_path, mut from_buf[0..1024]) { return RenameErr(errno()) }
    if !path_copy(new_path, mut to_buf[0..1024]) { return RenameErr(errno()) }
    if c_rename(&from_buf[0], &to_buf[0]) == -1 { return RenameErr(errno()) }
    return null
}

pub unlink(path: string): Error {
    path_buf: [1024]u8
    if !path_copy(path, mut path_buf[0..1024]) { return UnlinkErr(errno()) }
    if c_unlink(&path_buf[0]) == -1 { return UnlinkErr(errno()) }
    return null
}

pub opendir(path: string): (Dir, Error) {
    path_buf: [1024]u8
    if !path_copy(path, mut path_buf[0..1024]) { return blank(Dir), OpendirErr(errno()) }
    fd: i32 = c_open(&path_buf[0], O_RDONLY | O_DIRECTORY, u32(0))
    if fd == -1 { return blank(Dir), OpendirErr(errno()) }

    dir: Dir = Dir {
        fd = Fd(fd),
        buffer = [0 : 4096],
        next = 0,
        count = 0,
        base = 0,
        active = true,
        done = false,
    }
    return dir, null
}

/* Darwin dirent64 records begin with ino:u64, seekoff:u64, reclen:u16,
 * namlen:u16, type:u8, then the name bytes. Entries are retained when the
 * caller's name buffer is too small, so the caller may retry.
 */
pub readdir(mut dir: Dir, name: mut []u8): (usize, FileType, bool, Error) {
    if !dir.active {
        errno_set(9)
        return 0, FileType.unknown, false, ReaddirErr.inactive
    }
    if dir.done { return 0, FileType.unknown, true, null }

    for {
        if dir.next == dir.count {
            count: i32 = c_getdirentries64(i32(dir.fd), mut &dir.buffer[0], 4096, mut &dir.base)
            if count < 0 { return 0, FileType.unknown, false, ReaddirErr(errno()) }
            if count == 0 {
                dir.done = true
                return 0, FileType.unknown, true, null
            }

            dir.next = 0
            dir.count = usize(count)
        }

        at: usize = dir.next
        if at + 21 > dir.count {
            errno_set(5)
            return 0, FileType.unknown, false, ReaddirErr.malformed
        }
        record_len: usize = usize(dir.buffer[at + 16]) |
                            (usize(dir.buffer[at + 17]) << 8)
        name_len: usize = usize(dir.buffer[at + 18]) |
                          (usize(dir.buffer[at + 19]) << 8)
        if record_len < 21 || at + record_len > dir.count ||
           name_len > record_len - 21 {
            errno_set(5)
            return 0, FileType.unknown, false, ReaddirErr.malformed
        }

        is_dot: bool = name_len == 1 && dir.buffer[at + 21] == u8('.')
        is_dot_dot: bool = name_len == 2 &&
                           dir.buffer[at + 21] == u8('.') &&
                           dir.buffer[at + 22] == u8('.')
        if is_dot || is_dot_dot {
            dir.next = at + record_len
        } else {
            if name.len < name_len {
                errno_set(34)
                return 0, FileType.unknown, false, ReaddirErr.capacity
            }
            for i: usize in 0 .. name_len { name[i] = dir.buffer[at + 21 + i] }
            file_type: FileType = file_type_from_dirent(dir.buffer[at + 20])
            dir.next = at + record_len
            return name_len, file_type, false, null
        }
    }
}

pub closedir(mut dir: Dir): Error {
    if !dir.active {
        errno_set(9)
        return ClosedirErr.inactive
    }
    fd: i32 = i32(dir.fd)
    dir = blank(Dir)
    if c_close(fd) == -1 { return ClosedirErr(errno()) }
    return null
}
