/* sys — OS-neutral process and operating-system facade. */

@when(target == "darwin-arm64")
import os: "./os/darwin-arm64.ace"

@when(target == "linux-x64")
import os: "./os/linux-x64.ace"

pub Fd: type = os.Fd
pub Process: type = os.Process
pub ProcessStatus: type = os.ProcessStatus

pub OpenErr: type = os.OpenErr
pub ReadErr: type = os.ReadErr
pub WriteErr: type = os.WriteErr
pub CloseErr: type = os.CloseErr
pub StatErr: type = os.StatErr
pub MkdirErr: type = os.MkdirErr
pub RenameErr: type = os.RenameErr
pub UnlinkErr: type = os.UnlinkErr
pub OpendirErr: type = os.OpendirErr
pub ReaddirErr: type = os.ReaddirErr
pub ClosedirErr: type = os.ClosedirErr
pub ForkErr: type = os.ForkErr
pub WaitErr: type = os.WaitErr
pub PipeErr: type = os.PipeErr
pub IoctlErr: type = os.IoctlErr
pub RandomErr: type = os.RandomErr

pub FileType: type = os.FileType
pub FileInfo: type = os.FileInfo
pub Dir: type = os.Dir

pub stdin: const Fd = Fd(0)
pub stdout: const Fd = Fd(1)
pub stderr: const Fd = Fd(2)

pub O_RDONLY: const i32 = os.O_RDONLY
pub O_WRONLY: const i32 = os.O_WRONLY
pub O_RDWR: const i32 = os.O_RDWR
pub O_NONBLOCK: const i32 = os.O_NONBLOCK
pub O_APPEND: const i32 = os.O_APPEND
pub O_CREAT: const i32 = os.O_CREAT
pub O_TRUNC: const i32 = os.O_TRUNC
pub O_EXCL: const i32 = os.O_EXCL

pub EINTR: const i32 = os.EINTR
pub EAGAIN: const i32 = os.EAGAIN
pub EWOULDBLOCK: const i32 = os.EWOULDBLOCK
pub EINPROGRESS: const i32 = os.EINPROGRESS
pub ECONNRESET: const i32 = os.ECONNRESET
pub EACCES: const i32 = os.EACCES
pub EBUSY: const i32 = os.EBUSY

@when(target == "darwin-arm64")
pub BIOCGBLEN: const uint = os.BIOCGBLEN

@when(target == "darwin-arm64")
pub BIOCPROMISC: const uint = os.BIOCPROMISC

@when(target == "darwin-arm64")
pub BIOCSETIF: const uint = os.BIOCSETIF

@when(target == "darwin-arm64")
pub BIOCIMMEDIATE: const uint = os.BIOCIMMEDIATE

pub S_IRWXU: const u32 = os.S_IRWXU
pub S_IRUSR: const u32 = os.S_IRUSR
pub S_IWUSR: const u32 = os.S_IWUSR
pub S_IXUSR: const u32 = os.S_IXUSR
pub S_IRWXG: const u32 = os.S_IRWXG
pub S_IRGRP: const u32 = os.S_IRGRP
pub S_IWGRP: const u32 = os.S_IWGRP
pub S_IXGRP: const u32 = os.S_IXGRP
pub S_IRWXO: const u32 = os.S_IRWXO
pub S_IROTH: const u32 = os.S_IROTH
pub S_IWOTH: const u32 = os.S_IWOTH
pub S_IXOTH: const u32 = os.S_IXOTH

/* Process-start pointer arrays stay behind compiler-backed helpers because
 * Ace deliberately exposes no pointer arithmetic over their C layouts.
 */
process_argc(): usize {
    return 0
}

process_arg(index: usize): string {
    return null
}

process_envc(): usize {
    return 0
}

process_env(index: usize): string {
    return null
}

pub argc(): usize {
    return process_argc()
}

pub arg(index: usize): string {
    return process_arg(index)
}

pub envc(): usize {
    return process_envc()
}

pub env(index: usize): string {
    return process_env(index)
}

pub exit(code: int) {
    os.exit(code)
}

pub errno(): i32 {
    return os.errno()
}

/* Fill caller-owned storage with cryptographically secure operating-system
 * entropy. Empty storage succeeds without making a platform call.
 */
pub random(storage: mut []u8): Error {
    return os.random(storage)
}

pub fork(): (Process, Error) {
    process: Process, err: Error = os.fork()
    return process, err
}

pub wait(process: Process): (ProcessStatus, Error) {
    status: ProcessStatus, err: Error = os.wait(process)
    return status, err
}

pub pipe(): (Fd, Fd, Error) {
    input: Fd, output: Fd, err: Error = os.pipe()
    return input, output, err
}

pub read(fd: Fd, buf: mut []u8): (int, Error) {
    count: int, err: Error = os.read(fd, buf)
    return count, err
}

pub write(fd: Fd, data: []u8): (int, Error) {
    count: int, err: Error = os.write(fd, data)
    return count, err
}

pub close(fd: Fd): Error {
    return os.close(fd)
}

pub ioctl(fd: Fd, request: uint): Error {
    return os.ioctl(fd, request)
}

pub ioctl(fd: Fd, request: uint, data: mut []u8): Error {
    return os.ioctl(fd, request, data)
}

pub open(path: string, flags: i32): (Fd, Error) {
    fd: Fd, err: Error = os.open(path, flags)
    return fd, err
}

pub open(path: string, flags: i32, mode: u32): (Fd, Error) {
    fd: Fd, err: Error = os.open(path, flags, mode)
    return fd, err
}

pub stat(path: string): (FileInfo, Error) {
    info: FileInfo, err: Error = os.stat(path)
    return info, err
}

pub mkdir(path: string, mode: u32): Error {
    return os.mkdir(path, mode)
}

pub mkdir(path: string): Error {
    return os.mkdir(path)
}

pub rename(old_path: string, new_path: string): Error {
    return os.rename(old_path, new_path)
}

pub unlink(path: string): Error {
    return os.unlink(path)
}

pub opendir(path: string): (Dir, Error) {
    dir: Dir, err: Error = os.opendir(path)
    return dir, err
}

pub readdir(mut dir: Dir, name: mut []u8): (usize, FileType, bool, Error) {
    length: usize, file_type: FileType, done: bool, err: Error = os.readdir(mut dir, name)
    return length, file_type, done, err
}

pub closedir(mut dir: Dir): Error {
    return os.closedir(mut dir)
}
