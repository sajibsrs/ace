}

// Byte flush with partial-write retry, shared by the numeric overloads.
write_bytes(data: []u8): int {
    total: int = 0

    for attempt: int in 0 .. int(data.len) {
        n: int = write(1, &data[total], data.len - usize(total))

        if n <= 0 {
            return n
        }
        total += n

        if usize(total) == data.len {
            return total
        }
    }
    return total
}

/*
 * Formats the shortest round-trip digits in the canonical notation: decimal
 * for scientific exponents -6 through 20, otherwise scientific like 1.5e-7.
 * The sign comes first; no trailing zeros are added.
 */
format_float(negative: bool, digits: []u8, count: int, decpt: i32): int {
    out: [48]u8
    at: int = 0

    if negative {
        out[0] = u8(45)
        at = 1
    }
    exp: i32 = decpt - 1
    dp: int = int(decpt)

    if exp >= -6 && exp <= 20 {
        if dp <= 0 {
            out[at] = u8(48)
            out[at + 1] = u8(46)
            at += 2
            zeros: int = 0 - dp

            for z: int in 0 .. zeros {
                out[at] = u8(48)
                at += 1
            }

            for d: int in 0 .. count {
                out[at] = digits[d]
                at += 1
            }
        } else if dp >= count {
            for d: int in 0 .. count {
                out[at] = digits[d]
                at += 1
            }
            pad: int = dp - count

            for z: int in 0 .. pad {
                out[at] = u8(48)
                at += 1
            }
        } else {
            for d: int in 0 .. dp {
                out[at] = digits[d]
                at += 1
            }
            out[at] = u8(46)
            at += 1

            for d: int in dp .. count {
                out[at] = digits[d]
                at += 1
            }
        }
    } else {
        out[at] = digits[0]
        at += 1

        if count > 1 {
            out[at] = u8(46)
            at += 1

            for d: int in 1 .. count {
                out[at] = digits[d]
                at += 1
            }
        }
        out[at] = u8(101)
        at += 1
        e: i32 = exp

        if e < 0 {
            out[at] = u8(45)
            at += 1
            e = 0 - e
        }
        hi: i32 = e / 100
        mid: i32 = (e / 10) % 10
        lo: i32 = e % 10

        if hi != 0 {
            out[at] = u8(48 + hi)
            at += 1
            out[at] = u8(48 + mid)
            at += 1
        } else if mid != 0 {
            out[at] = u8(48 + mid)
            at += 1
        }
        out[at] = u8(48 + lo)
        at += 1
    }
    return write_bytes(out[0..at])
}

/*
 * The shortest digit count whose correctly rounded decimal form parses back
 * to the exact value, through libSystem ecvt (correctly rounded digits) and
 * strtod/strtof (the round-trip check; strtof parses f32 directly, with no
 * double-rounding detour). ecvt returns internal storage that a later call may
 * overwrite, so the digits are copied out immediately. The digits are the
 * integer form: value equals digits x 10^(decpt - count).
 */
shortest_digits(mag: f64, max: int, narrow: bool, mut digits: []u8, mut probe: []u8): (int, i32) {
    decpt: i32 = 0
    unused: i32 = 0
    count: int = max
    limit: int = max + 1

    for p: int in 1 .. limit {
        src: *u8 = ecvt(mag, i32(p), mut &decpt, mut &unused)
        memcpy(&digits[0], src, usize(p))

        for i: int in 0 .. p {
            probe[i] = digits[i]
        }
        exp: i32 = decpt - i32(p)
        q: int = p
        probe[p] = u8(101)
        q += 1
        e: i32 = exp

        if e < 0 {
            probe[q] = u8(45)
            q += 1
            e = 0 - e
        }
        hi: i32 = e / 100
        mid: i32 = (e / 10) % 10
        lo: i32 = e % 10

        if hi != 0 {
            probe[q] = u8(48 + hi)
            q += 1
            probe[q] = u8(48 + mid)
            q += 1
        } else if mid != 0 {
            probe[q] = u8(48 + mid)
            q += 1
        }
        probe[q] = u8(48 + lo)
        q += 1
        probe[q] = u8(0)

        if narrow {
            if strtof(&probe[0], null) == f32(mag) {
                count = p
                break
            }
        } else {
            if strtod(&probe[0], null) == mag {
                count = p
                break
            }
        }
    }
    return count, decpt
}

pub print(value: f64): int {
    one: f64 = 1.0
    zero: f64 = 0.0

    if value != value {
        return print("nan")
    }

    if value - value != zero {
        if value < zero {
            return print("-inf")
        }
        return print("inf")
    }
    negative: bool = value < zero
    mag: f64 = value

    if negative {
        mag = zero - value
    }

    if mag == zero {
        /*
         * The comparison operators cannot see the sign of a zero, so the sign
         * bit is read through the reciprocal: 1/-0 is -inf.
         */
        if one / value < zero {
            return print("-0")
        }
        return print("0")
    }
    digits: [24]u8
    probe: [32]u8
    dv: []u8 = digits[0..17]
    pv: []u8 = probe[0..32]
    count: int, decpt: i32 = shortest_digits(mag, 17, false, mut dv, mut pv)
    return format_float(negative, dv, count, decpt)
}

pub print(value: f32): int {
    pone: f32 = 1.0
    zero: f32 = 0.0

    if value != value {
        return print("nan")
    }

    if value - value != zero {
        if value < zero {
            return print("-inf")
        }
        return print("inf")
    }
    negative: bool = value < zero
    mag: f32 = value

    if negative {
        mag = zero - value
    }

    if mag == zero {
        /*
         * The comparison operators cannot see the sign of a zero, so the sign
         * bit is read through the reciprocal: 1/-0 is -inf.
         */
        if pone / value < zero {
            return print("-0")
        }
        return print("0")
    }
    digits: [24]u8
    probe: [32]u8
    dv: []u8 = digits[0..9]
    pv: []u8 = probe[0..32]
    /*
     * f32 -> f64 is exact, so correctly rounded digits of the widened value are
     * correctly rounded digits of the f32 itself; the round trip is checked
     * against the narrow type through strtof.
     */
    count: int, decpt: i32 = shortest_digits(f64(mag), 9, true, mut dv, mut pv)
    return format_float(negative, dv, count, decpt)
}

/*
 * The compiler's checked printf lowering resolves its helpers through exact-
 * type specialization lookup: each shape below is a specialized template, and
 * the format interpreter's concrete argument type selects the specialization
 * with the equal type-argument tuple. Helpers use fixed stack storage and the
 * shared partial-write retry path; no runtime dispatch or metadata exists.
 */
print_counted[T](value: T): int specialized

print_precision[T](value: T, precision: usize): int specialized

print_hex[T](value: T, uppercase: bool): int specialized

print_counted[string](text: string): int {
    return print(text)
}

print_counted[int](value: int): int {
    return print(value)
}

print_counted[uint](value: uint): int {
    return print(value)
}

print_counted[usize](value: usize): int {
    return print(value)
}

print_counted[u8](value: u8): int {
    out: [1]u8 = [value]
    return write_bytes(out[0..1])
}

print_hex[uint](value: uint, uppercase: bool): int {
    out: [16]u8
    at: int = 16
    remaining: uint = value

    for digit: int in 0 .. 16 {
        at -= 1
        d: uint = remaining % 16

        if d < 10 {
            out[at] = u8(48 + d)
        } else if uppercase {
            out[at] = u8(55 + d)
        } else {
            out[at] = u8(87 + d)
        }
        remaining = remaining / 16

        if remaining == 0 {
            break
        }
    }
    return write_bytes(out[at..16])
}

print_hex[usize](value: usize, uppercase: bool): int {
    out: [16]u8
    at: int = 16
    remaining: usize = value

    for digit: int in 0 .. 16 {
        at -= 1
        d: usize = remaining % 16

        if d < 10 {
            out[at] = u8(48 + d)
        } else if uppercase {
            out[at] = u8(55 + d)
        } else {
            out[at] = u8(87 + d)
        }
        remaining = remaining / 16

        if remaining == 0 {
            break
        }
    }
    return write_bytes(out[at..16])
}

/*
 * Fixed decimal through libSystem fcvt. The returned digits are copied into
 * the declared output buffer before any later conversion can reuse fcvt's
 * internal storage. Precision zero is rounded explicitly to nearest/even
 * because Darwin fcvt deliberately returns no digits for ndigit == 0.
 */
print_precision[f64](value: f64, precision: usize): int {
    zero: f64 = 0.0
    one: f64 = 1.0

    if value != value {
        return print_counted[string]("nan")
    }

    if value - value != zero {
        if value < zero {
            return print_counted[string]("-inf")
        }
        return print_counted[string]("inf")
    }

    negative: bool = value < zero

    if value == zero {
        if one / value < zero {
            negative = true
        }
    }
    mag: f64 = value

    if negative {
        mag = zero - value
    }

    out: [640]u8
    at: int = 0

    if negative {
        out[at] = u8(45)
        at += 1
    }
    places: int = int(precision)
    decpt: i32 = 0
    unused_sign: i32 = 0
    src: *u8

    if places == 0 {
        whole: f64 = floor(mag)
        fraction: f64 = mag - whole
        half: f64 = 0.5

        if fraction > half {
            whole += 1.0
        } else if fraction == half {
            parity: uint = uint(whole) % 2

            if parity != 0 {
                whole += 1.0
            }
        }
        src = fcvt(whole, 1, mut &decpt, mut &unused_sign)

        if whole == zero {
            out[at] = u8(48)
            at += 1
        } else {
            digits: int = int(decpt)
            memcpy(&out[at], src, usize(digits))
            at += digits
        }
        return write_bytes(out[0..at])
    }

    rounding: i32 = fegetround()

    if rounding != 0 {
        fesetround(0) // Darwin FE_TONEAREST: nearest, exact ties to even
    }
    src = fcvt(mag, i32(places), mut &decpt, mut &unused_sign)

    if rounding != 0 {
        fesetround(rounding)
    }
    point: int = int(decpt)
    available: int = places + point

    if point <= 0 && available < 0 {
        available = 0
    }

    if point <= 0 {
        out[at] = u8(48)
        out[at + 1] = u8(46)
        at += 2
        zeros: int = 0 - point

        if zeros > places {
            zeros = places
        }

        for i: int in 0 .. zeros {
            out[at] = u8(48)
            at += 1
        }
        digits: int = places - zeros

        if digits > 0 {
            memcpy(&out[at], src, usize(digits))
            at += digits
        }
    } else {
        memcpy(&out[at], src, usize(available))
        memmove(&out[at + point + 1], &out[at + point], usize(places))
        out[at + point] = u8(46)
        at += point + places + 1
    }
    return write_bytes(out[0..at])
}

print_precision[f32](value: f32, precision: usize): int {
    return print_precision[f64](f64(value), precision)
}

/*
 * This body serves the zero-conversion case and gives the public name an
 * ordinary declaration. Calls are otherwise validated and lowered directly
 * by the compiler; this format-dependent function is never a first-class value.
 */
pub printf(format: string): int {
    return print_counted[string](format)
}

/*
 * Closes a println after a nonempty value write: a non-positive result is
 * returned with no newline attempted; the newline's own failure is returned
 * unchanged; full success returns the combined byte count including the newline.
 * The string overload handles its empty success before calling this helper.
 */
finish_line(written: int): int {
    if written <= 0 {
        return written
    }
    n: int = print("\n")

    if n < 0 {
        return n
    }
    return written + n
}

pub println(text: string): int {
    if text.len == 0 {
        return print("\n")
    }
    return finish_line(print(text))
}

pub println(value: int): int {
    return finish_line(print(value))
}

pub println(value: uint): int {
    return finish_line(print(value))
}

pub println(value: usize): int {
    return finish_line(print(value))
}

pub println(value: f32): int {
    return finish_line(print(value))
}

pub println(value: f64): int {
    return finish_line(print(value))
}
