// fmt — allocation-free text output.
extern "c" {
    write(fd: i32, data: *u8, size: usize): int
}

pub print(text: string): int {
    if text.len == 0 {
        return 0
    }
    total: int = 0
    for attempt: int in 0 .. int(text.len) {
        n: int = write(1, &text[total], text.len - usize(total))
        if n <= 0 {
            return n
        }
        total += n
        if usize(total) == text.len {
            return total
        }
    }
    return total
}

pub print(value: int): int {
    digits: [20]u8
    at: int = 20
    remaining: int = value
    negative: bool = value < 0
    for digit: int in 0 .. 20 {
        at -= 1
        remainder: int = remaining % 10
        if negative {
            digits[at] = u8(48 - remainder)
        } else {
            digits[at] = u8(48 + remainder)
        }
        remaining = remaining / 10
        if remaining == 0 {
            break
        }
    }
    if negative {
        at -= 1
        digits[at] = u8(45)
    }
    size: usize = usize(20 - at)
    total: int = 0
    for attempt: int in 0 .. int(size) {
        n: int = write(1, &digits[at + total], size - usize(total))
        if n <= 0 {
            return n
        }
        total += n
        if usize(total) == size {
            return total
        }
    }
    return total
}

pub print(value: uint): int {
    digits: [20]u8
    at: int = 20
    remaining: uint = value
    for digit: int in 0 .. 20 {
        at -= 1
        remainder: uint = remaining % 10
        digits[at] = u8(48 + remainder)
        remaining = remaining / 10
        if remaining == 0 {
            break
        }
    }
    size: usize = usize(20 - at)
    total: int = 0
    for attempt: int in 0 .. int(size) {
        n: int = write(1, &digits[at + total], size - usize(total))
        if n <= 0 {
            return n
        }
        total += n
        if usize(total) == size {
            return total
        }
    }
    return total
}

pub print(value: usize): int {
    digits: [20]u8
    at: int = 20
    remaining: usize = value
    for digit: int in 0 .. 20 {
        at -= 1
        remainder: usize = remaining % 10
        digits[at] = u8(48 + remainder)
        remaining = remaining / 10
        if remaining == 0 {
            break
        }
    }
    size: usize = usize(20 - at)
    total: int = 0
    for attempt: int in 0 .. int(size) {
        n: int = write(1, &digits[at + total], size - usize(total))
        if n <= 0 {
            return n
        }
        total += n
        if usize(total) == size {
            return total
        }
    }
    return total
}
