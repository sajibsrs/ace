/* utf8 — allocation-free UTF-8 encoding and decoding over byte strings.
 *
 * Code points are plain u32 values. Validation is strict per RFC 3629:
 * overlong forms, surrogates 0xD800..0xDFFF, values above 0x10FFFF,
 * truncated sequences, and unexpected continuation bytes are invalid.
 */

import bits

/* Returns the encoded byte width of `value` (1-4), or 0 when it is not a
 * Unicode scalar value.
 */
pub inline width(value: u32): usize {
    if value < 0x80 { return 1 }

    if value < 0x800 { return 2 }

    if value >= 0xD800 && value <= 0xDFFF { return 0 }

    if value < 0x10000 { return 3 }

    if value <= 0x10FFFF { return 4 }
    return 0
}

/* Writes the complete encoding of `value` and returns its width and true.
 * An invalid code point or insufficient capacity returns (0, false) without
 * writing; the unused destination suffix is unchanged.
 */
pub encode(value: u32, destination: []char): (usize, bool) {
    n: usize = width(value)
    if n == 0 || destination.len < n { return 0, false }
    if n == 1 {
        destination[0] = u8(value)
    } else if n == 2 {
        destination[0] = u8(0xC0 | (value >> 6))
        destination[1] = u8(0x80 | (value & 0x3F))
    } else if n == 3 {
        destination[0] = u8(0xE0 | (value >> 12))
        destination[1] = u8(0x80 | ((value >> 6) & 0x3F))
        destination[2] = u8(0x80 | (value & 0x3F))
    } else {
        destination[0] = u8(0xF0 | (value >> 18))
        destination[1] = u8(0x80 | ((value >> 12) & 0x3F))
        destination[2] = u8(0x80 | ((value >> 6) & 0x3F))
        destination[3] = u8(0x80 | (value & 0x3F))
    }

    return n, true
}

/* Per lead byte: the sequence width (0 when the byte cannot lead) in the low
 * nibble and the second byte's ACCEPT_LOW/ACCEPT_COUNT row in the high one.
 */
LEADS: [256]u8 = [
    0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
    0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
    0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
    0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
    0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
    0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
    0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
    0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02,
    0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02,
    0x13, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x23, 0x03, 0x03,
    0x34, 0x04, 0x04, 0x04, 0x44, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
]

/* The second byte's valid range per row, as low bound and count, which some
 * leads narrow.
 */
ACCEPT_LOW: [5]u8 = [0x80, 0xA0, 0x80, 0x90, 0x80]
ACCEPT_COUNT: [5]u8 = [0x40, 0x20, 0x20, 0x30, 0x10]

/* The width (1-4) of the well-formed sequence starting at byte `at`, or 0
 * when it is malformed or truncated; `at` is below `text.len`. Validation
 * runs on this alone, without assembling a code point.
 */
inline span(text: string, at: usize): usize {
    lead: u8 = LEADS[text[at]]
    n: usize = usize(lead & 0x0F)

    if n <= 1 { return n }

    if text.len - at < n { return 0 }
    row: u8 = lead >> 4

    if bits.wrsub(text[at + 1], ACCEPT_LOW[row]) >= ACCEPT_COUNT[row] { return 0 }

    if n >= 3 && (text[at + 2] & 0xC0) != 0x80 { return 0 }

    if n == 4 && (text[at + 3] & 0xC0) != 0x80 { return 0 }
    return n
}

/* Decodes the one sequence starting at byte `at`, returning the code point,
 * its width, and true. Invalid input returns (0, 1, false): the width stays
 * 1 so a decode loop always advances past a bad byte. `at >= text.len`
 * returns (0, 0, false).
 */
pub decode(text: string, at: usize): (u32, usize, bool) {
    if at >= text.len { return 0, 0, false }
    n: usize = span(text, at)

    if n == 0 { return 0, 1, false }
    lead: u8 = text[at]

    if n == 1 { return u32(lead), 1, true }
    value: u32 = u32(lead & (0x7F >> u8(n)))

    for i: usize in 1 .. n {
        value = (value << 6) | u32(text[at + i] & 0x3F)
    }
    return value, n, true
}

/* Reports whether the complete text is well-formed UTF-8. Empty text is
 * valid.
 */
pub valid(text: string): bool {
    at: usize = 0

    for at < text.len {
        if text[at] < 0x80 {
            at += 1
            continue
        }
        n: usize = span(text, at)
        if n == 0 { return false }

        at += n
    }
    return true
}
