/* str — allocation-free byte-exact string utilities.
 *
 * Every operation works on views or caller storage: search and ordering never
 * allocate or decode, conversions write into caller buffers, and every
 * failure — capacity, invalid text, unsupported radix — is reported
 * explicitly. Strings are read-only UTF-8 byte views; `char` is the
 * transparent u8 alias, so a `char` overload is also the byte overload.
 * The float representations written here are exactly those of the matching
 * `fmt.print` overloads.
 */

import bits
import mem

import decimal: @float_decimal
import float_parse: @float_parse
import load: @byte_load

/* Word-at-a-time search constants. For a word x, ~(((x & LOW7) + LOW7) | x |
 * LOW7) has 0x80 exactly in the bytes of x that are zero: each masked byte
 * sum is at most 0xFE, so no carry crosses a byte and the test is exact.
 * Byte i of a word is text[at + i] on the little-endian target, so the
 * lowest set bit marks the first match.
 */
ONES: const u64 = 0x0101010101010101
LOW7: const u64 = 0x7F7F7F7F7F7F7F7F

/* First occurrence of needle: the byte index and whether it was found; an
 * empty string needle is found at zero, and absence returns canonical zero.
 */
pub find(text: string, needle: string): (usize, bool) {
    at: usize, found: bool = index_from(text, needle, 0)
    return at, found
}

pub find(text: string, needle: char): (usize, bool) {
    at: usize, found: bool = index_byte_from(text, needle, 0)
    return at, found
}

/* Whether needle occurs anywhere; an empty string needle is present. */
pub has(text: string, needle: string): bool {
    at: usize, found: bool = index_from(text, needle, 0)
    return found
}

pub has(text: string, needle: char): bool {
    at: usize, found: bool = index_byte_from(text, needle, 0)
    return found
}

/* One boundary test: false selects the prefix and true the suffix; an empty
 * string part matches either boundary.
 */
pub has(text: string, part: string, suffix: bool): bool {
    if part.len > text.len { return false }

    if !suffix { return mem.equal(text[..part.len], part) }
    return mem.equal(text[text.len - part.len..], part)
}

/* Unsigned byte-wise lexicographic order: exactly -1, 0, or 1; after an
 * equal prefix the shorter string sorts first.
 */
pub compare(a: string, b: string): int {
    n: usize = a.len

    if b.len < n { n = b.len }

    for i: usize in 0 .. n {
        if a[i] != b[i] {
            if a[i] < b[i] { return -1 }
            return 1
        }
    }

    if a.len < b.len { return -1 }

    if a.len > b.len { return 1 }
    return 0
}

/* Copies the complete text into destination[0..text.len]; a shorter
 * destination is unchanged and fails, and the unused suffix is untouched.
 */
pub copy(text: string, noalias destination: mut []char): bool {
    if text.len > destination.len { return false }

    for i: usize in 0 .. text.len { destination[i] = text[i] }
    return true
}

/* Concatenates every part in order into caller storage. Insufficient capacity
 * fails without writing; success returns the complete byte count and leaves
 * the unused destination suffix unchanged.
 */
pub concat(parts: []string, destination: mut []char): (usize, bool) {
    total: usize = 0

    for i: usize in 0 .. parts.len {
        if total > destination.len || parts[i].len > destination.len - total { return 0, false }
        total += parts[i].len
    }

    at: usize = 0
    for i: usize in 0 .. parts.len {
        count: usize = parts[i].len
        mem.copy(destination[at..at + count], parts[i])
        at += count
    }
    return total, true
}

/* Splits left to right on non-overlapping exact matches. Separators are
 * omitted, boundaries produce empty parts, empty input produces one empty
 * part, and each written part is a zero-copy view into text. The result is
 * the number written and whether the complete result fit; unwritten slots
 * are unchanged. An empty separator fails without writing.
 */
pub split(text: string, separator: string, parts: mut []string): (usize, bool) {
    if separator.len == 0 { return 0, false }
    written: usize = 0
    start: usize = 0
    cursor: usize = 0

    for guard: usize in 0 .. text.len + 1 {
        at: usize, found: bool = index_from(text, separator, cursor)
        if !found { break }

        if written < parts.len {
            parts[written] = text[start..at]
            written += 1
        }
        start = at + separator.len
        cursor = start
    }
    complete: bool = false

    if written < parts.len {
        parts[written] = text[start..]
        written += 1
        complete = true
    }
    return written, complete
}

pub split(text: string, separator: char, parts: mut []string): (usize, bool) {
    unit: [1]char = [separator]
    count: usize, complete: bool = split(text, unit[0..1], parts)
    return count, complete
}

/* Removes at most one exact boundary match: false selects the prefix and
 * true the suffix. A match returns the remaining zero-copy view and true;
 * absence returns the original view and false; an empty string part
 * succeeds without changing the view.
 */
pub trim(text: string, part: string, suffix: bool): (string, bool) {
    if part.len == 0 { return text, true }

    if !suffix {
        if part.len <= text.len && mem.equal(text[..part.len], part) { return text[part.len..], true }
        return text, false
    }

    if part.len <= text.len && mem.equal(text[text.len - part.len..], part) { return text[..text.len - part.len], true }
    return text, false
}

pub trim(text: string, part: char, suffix: bool): (string, bool) {
    if text.len == 0 { return text, false }

    if !suffix {
        if text[0] == part { return text[1..], true }
        return text, false
    }

    if text[text.len - 1] == part { return text[..text.len - 1], true }
    return text, false
}

/* Removes all leading and trailing ASCII whitespace bytes and returns the
 * zero-copy view; no Unicode whitespace processing happens.
 */
pub trim(text: string): string {
    start: usize = text.len

    for i: usize in 0 .. text.len {
        if !space_byte(text[i]) {
            start = i
            break
        }
    }
    end: usize = text.len

    if start < text.len {
        for i: usize in 0 .. text.len - start {
            if !space_byte(text[text.len - 1 - i]) {
                end = text.len - i
                break
            }
        }
    }
    return text[start..end]
}

/* Parses the complete text as T. The default form admits exactly int, uint,
 * usize, f32, and f64; the radix form admits exactly the three integer types
 * with radices 2 through 36. Surrounding whitespace, a leading plus, and
 * minus signs outside the signed forms are rejected; leading zeroes are
 * accepted. Invalid text, an unsupported radix, or overflow returns
 * canonical-zero T and false; finite float underflow rounded to signed zero
 * succeeds. Both forms are specialized templates with no default body, so
 * the callable surface is exactly the per-type specializations below; any
 * other type argument is a compile-time error at the call. */

pub parse[T](text: string): (T, bool) specialized

pub parse[T](text: string, radix: u8): (T, bool) specialized

/* Writes the complete representation of value into destination or nothing
 * at all, returning the byte count and whether it fit. Integer radix forms
 * use lowercase digits with no base prefix and only int may emit a minus.
 * The no-radix float representations are exactly the matching fmt.print
 * overloads', including the nan/inf/-inf and signed-zero spellings.
 */
pub format(destination: mut []char, value: int): (usize, bool) {
    digits: [20]u8
    at: int = 20
    remaining: int = value
    negative: bool = value < 0

    for d: int in 0 .. 20 {
        at -= 1
        remainder: int = remaining % 10

        if negative {
            digits[at] = u8(48 - remainder)
        } else {
            digits[at] = u8(48 + remainder)
        }
        remaining = remaining / 10

        if remaining == 0 { break }
    }

    if negative {
        at -= 1
        digits[at] = u8(45)
    }
    n: usize, ok: bool = store_bytes(destination, mut digits[at..20])
    return n, ok
}

pub format(destination: mut []char, value: uint): (usize, bool) {
    digits: [20]u8
    at: int = 20
    remaining: uint = value

    for d: int in 0 .. 20 {
        at -= 1
        digits[at] = u8(48 + remaining % 10)
        remaining = remaining / 10

        if remaining == 0 { break }
    }
    n: usize, ok: bool = store_bytes(destination, mut digits[at..20])
    return n, ok
}

pub format(destination: mut []char, value: usize): (usize, bool) {
    digits: [20]u8
    at: int = 20
    remaining: usize = value

    for d: int in 0 .. 20 {
        at -= 1
        digits[at] = u8(48 + remaining % 10)
        remaining = remaining / 10

        if remaining == 0 { break }
    }
    n: usize, ok: bool = store_bytes(destination, mut digits[at..20])
    return n, ok
}

pub format(destination: mut []char, value: f64): (usize, bool) {
    one: f64 = 1.0
    zero: f64 = 0.0

    if value != value {
        n: usize, ok: bool = store_text(destination, "nan")
        return n, ok
    }

    if value - value != zero {
        if value < zero {
            n: usize, ok: bool = store_text(destination, "-inf")
            return n, ok
        }
        n: usize, ok: bool = store_text(destination, "inf")
        return n, ok
    }
    negative: bool = value < zero
    mag: f64 = value

    if negative { mag = zero - value }

    if mag == zero {
        /* The comparison operators cannot see the sign of a zero, so the
         * sign bit is read through the reciprocal: 1/-0 is -inf. */
        if one / value < zero {
            n: usize, ok: bool = store_text(destination, "-0")
            return n, ok
        }
        n: usize, ok: bool = store_text(destination, "0")
        return n, ok
    }
    digits: [24]u8
    dv: mut []u8 = mut digits[0..17]
    converted: decimal.Decimal = decimal.binary64(mag, dv)
    out: [48]u8
    view: mut []u8 = mut out[0..48]
    n: usize = render_float(negative, dv, converted.count, converted.point, view)
    n2: usize, ok: bool = store_bytes(destination, out[0..n])
    return n2, ok
}

pub format(destination: mut []char, value: f32): (usize, bool) {
    pone: f32 = 1.0
    zero: f32 = 0.0

    if value != value {
        n: usize, ok: bool = store_text(destination, "nan")
        return n, ok
    }

    if value - value != zero {
        if value < zero {
            n: usize, ok: bool = store_text(destination, "-inf")
            return n, ok
        }
        n: usize, ok: bool = store_text(destination, "inf")
        return n, ok
    }
    negative: bool = value < zero
    mag: f32 = value

    if negative { mag = zero - value }

    if mag == zero {
        /* The comparison operators cannot see the sign of a zero, so the
         * sign bit is read through the reciprocal: 1/-0 is -inf. */
        if pone / value < zero {
            n: usize, ok: bool = store_text(destination, "-0")
            return n, ok
        }
        n: usize, ok: bool = store_text(destination, "0")
        return n, ok
    }
    digits: [24]u8
    dv: mut []u8 = mut digits[0..9]
    converted: decimal.Decimal = decimal.binary32(mag, dv)
    out: [48]u8
    view: mut []u8 = mut out[0..48]
    n: usize = render_float(negative, dv, converted.count, converted.point, view)
    n2: usize, ok: bool = store_bytes(destination, out[0..n])
    return n2, ok
}

pub format(destination: mut []char, value: int, radix: u8): (usize, bool) {
    if radix < 2 || radix > 36 { return 0, false }
    digits: [65]u8
    at: int = 65
    remaining: u64 = 0
    negative: bool = value < 0

    if negative {
        /* Add before negating so the signed minimum never overflows; convert
         * only the nonnegative intermediate, then restore the final unit. */
        remaining = u64(0 - (value + 1)) + 1
    } else {
        remaining = u64(value)
    }

    for d: int in 0 .. 65 {
        at -= 1
        r: u64 = remaining % u64(radix)

        if r < 10 {
            digits[at] = u8(48 + r)
        } else {
            digits[at] = u8(87 + r)
        }
        remaining = remaining / u64(radix)

        if remaining == 0 { break }
    }

    if negative {
        at -= 1
        digits[at] = u8(45)
    }
    n2: usize, ok: bool = store_bytes(destination, mut digits[at..65])
    return n2, ok
}

pub format(destination: mut []char, value: uint, radix: u8): (usize, bool) {
    if radix < 2 || radix > 36 { return 0, false }
    digits: [64]u8
    at: int = 64
    remaining: uint = value

    for d: int in 0 .. 64 {
        at -= 1
        r: uint = remaining % uint(radix)

        if r < 10 {
            digits[at] = u8(48 + r)
        } else {
            digits[at] = u8(87 + r)
        }
        remaining = remaining / uint(radix)

        if remaining == 0 { break }
    }
    n2: usize, ok: bool = store_bytes(destination, mut digits[at..64])
    return n2, ok
}

pub format(destination: mut []char, value: usize, radix: u8): (usize, bool) {
    if radix < 2 || radix > 36 { return 0, false }
    digits: [64]u8
    at: int = 64
    remaining: usize = value

    for d: int in 0 .. 64 {
        at -= 1
        r: usize = remaining % usize(radix)

        if r < 10 {
            digits[at] = u8(48 + r)
        } else {
            digits[at] = u8(87 + r)
        }
        remaining = remaining / usize(radix)

        if remaining == 0 { break }
    }
    n2: usize, ok: bool = store_bytes(destination, mut digits[at..64])
    return n2, ok
}

/* Writes the complete byte sequence into destination or nothing at all. */
store_bytes(destination: mut []u8, source: []u8): (usize, bool) {
    if source.len > destination.len { return 0, false }

    for i: usize in 0 .. source.len { destination[i] = source[i] }
    return source.len, true
}

/* Writes the complete text into destination or nothing at all. */
store_text(destination: mut []char, text: string): (usize, bool) {
    if text.len > destination.len { return 0, false }

    for i: usize in 0 .. text.len { destination[i] = text[i] }
    return text.len, true
}

/* First occurrence of needle at or after from: the index and whether the
 * needle was found. An empty needle is found at every position. Eight start
 * positions are filtered per step by needle's first and last bytes together;
 * each surviving candidate is confirmed whole.
 */
index_from(text: string, needle: string, after: usize): (usize, bool) {
    if needle.len == 0 { return after, true }

    // after past the last start would make the range below run downward
    if needle.len > text.len || after > text.len - needle.len { return 0, false }

    if needle.len == 1 {
        index: usize, found: bool = index_byte_from(text, needle[0], after)
        return index, found
    }
    last: usize = needle.len - 1
    first_pattern: u64 = u64(needle[0]) * ONES
    last_pattern: u64 = u64(needle[last]) * ONES
    at: usize = after

    for at + last + 8 <= text.len {
        a: u64 = load.unaligned_u64(text, at) ^ first_pattern
        b: u64 = load.unaligned_u64(text, at + last) ^ last_pattern
        hit: u64 = ~(((a & LOW7) + LOW7) | a | ((b & LOW7) + LOW7) | b | LOW7)

        for hit != 0 {
            scan: usize = at + usize(bits.ctz(hit) / 8)

            if mem.equal(text[scan..scan + needle.len], needle) { return scan, true }
            hit &= hit - 1
        }
        at += 8
    }

    for scan: usize in at .. text.len - last {
        if text[scan] == needle[0] && mem.equal(text[scan..scan + needle.len], needle) { return scan, true }
    }
    return 0, false
}

/* First occurrence of one byte at or after from, eight bytes per step. */
index_byte_from(text: string, byte: char, after: usize): (usize, bool) {
    if after >= text.len { return 0, false }
    pattern: u64 = u64(byte) * ONES
    at: usize = after

    for at + 8 <= text.len {
        x: u64 = load.unaligned_u64(text, at) ^ pattern
        hit: u64 = ~(((x & LOW7) + LOW7) | x | LOW7)

        if hit != 0 { return at + usize(bits.ctz(hit) / 8), true }
        at += 8
    }

    for i: usize in at .. text.len {
        if text[i] == byte { return i, true }
    }
    return 0, false
}

/* The value of one ASCII digit and whether it is a digit at all. */
digit_value(c: u8): (u64, bool) {
    if c >= '0' && c <= '9' { return u64(c - '0'), true }

    if c >= 'a' && c <= 'z' { return u64(c - 87), true }

    if c >= 'A' && c <= 'Z' { return u64(c - 55), true }
    return 0, false
}

/* Accumulates one digit with the overflow-before-multiply check. */
accumulate(mag: u64, d: u64, radix: u8, limit: u64): (u64, bool) {
    if mag > (limit - d) / u64(radix) { return 0, false }
    return mag * u64(radix) + d, true
}

/* Parses the complete text as a signed integer in the given radix. The
 * magnitude accumulates in u64, so the signed limit also covers the negative
 * minimum; the unsigned forms reject the leading minus outright.
 */
pub parse[int](text: string, radix: u8): (int, bool) {
    if radix < 2 || radix > 36 { return 0, false }

    if text.len == 0 { return 0, false }
    negative: bool = text[0] == 45
    at: usize = 0

    if negative { at = 1 }

    if at == text.len { return 0, false }
    limit: u64 = 9223372036854775807

    if negative { limit = 9223372036854775808 }
    mag: u64 = 0

    for i: usize in at .. text.len {
        d: u64, ok: bool = digit_value(text[i])
        if !ok || d >= u64(radix) { return 0, false }

        mag, ok = accumulate(mag, d, radix, limit)
        if !ok { return 0, false }
    }

    if negative {
        if mag == 9223372036854775808 { return int(mag), true }
        return 0 - int(mag), true
    }
    return int(mag), true
}

pub parse[uint](text: string, radix: u8): (uint, bool) {
    if radix < 2 || radix > 36 { return 0, false }

    if text.len == 0 { return 0, false }

    if text[0] == 45 { return 0, false }
    mag: u64 = 0

    for i: usize in 0 .. text.len {
        d: u64, ok: bool = digit_value(text[i])
        if !ok || d >= u64(radix) { return 0, false }

        mag, ok = accumulate(mag, d, radix, 18446744073709551615)
        if !ok { return 0, false }
    }
    return uint(mag), true
}

/* usize is u64-wide on the v1 target, so its range matches uint exactly. */
pub parse[usize](text: string, radix: u8): (usize, bool) {
    v: uint, ok: bool = parse[uint](text, radix)
    if !ok { return 0, false }

    return usize(v), true
}

/* The default integer forms forward to their radix specializations at the
 * ordinary decimal radix. */
pub parse[int](text: string): (int, bool) {
    v: int, ok: bool = parse[int](text, u8(10))
    return v, ok
}

pub parse[uint](text: string): (uint, bool) {
    v: uint, ok: bool = parse[uint](text, u8(10))
    return v, ok
}

pub parse[usize](text: string): (usize, bool) {
    v: usize, ok: bool = parse[usize](text, u8(10))
    return v, ok
}

pub parse[f64](text: string): (f64, bool) {
    value: f64, ok: bool = float_parse.binary64(text)
    return value, ok
}

pub parse[f32](text: string): (f32, bool) {
    value: f32, ok: bool = float_parse.binary32(text)
    return value, ok
}

/* True for exactly the ASCII whitespace bytes 0x09..0x0D and 0x20. */
space_byte(c: u8): bool {
    return (c >= '\t' && c <= '\r') || c == ' '
}

/* Renders the canonical notation into out: decimal for scientific exponents
 * -6 through 20, otherwise scientific like 1.5e-7. The sign comes first and
 * no trailing zeros are added. Returns the byte count.
 */
render_float(negative: bool, digits: []u8, count: int, decpt: i32, out: mut []u8): usize {
    at: int = 0

    if negative {
        out[at] = u8(45)
        at += 1
    }
    exp: i32 = decpt - 1
    dp: int = int(decpt)

    if exp >= -6 && exp <= 20 {
        if dp <= 0 {
            out[at] = u8(48)
            out[at + 1] = u8(46)
            at += 2
            zeros: int = 0 - dp

            for z: int in 0 .. zeros {
                out[at] = u8(48)
                at += 1
            }

            for d: int in 0 .. count {
                out[at] = digits[d]
                at += 1
            }
        } else if dp >= count {
            for d: int in 0 .. count {
                out[at] = digits[d]
                at += 1
            }
            pad: int = dp - count

            for z: int in 0 .. pad {
                out[at] = u8(48)
                at += 1
            }
        } else {
            for d: int in 0 .. dp {
                out[at] = digits[d]
                at += 1
            }
            out[at] = u8(46)
            at += 1

            for d: int in dp .. count {
                out[at] = digits[d]
                at += 1
            }
        }
    } else {
        out[at] = digits[0]
        at += 1

        if count > 1 {
            out[at] = u8(46)
            at += 1

            for d: int in 1 .. count {
                out[at] = digits[d]
                at += 1
            }
        }
        out[at] = u8(101)
        at += 1
        e: i32 = exp

        if e < 0 {
            out[at] = u8(45)
            at += 1
            e = 0 - e
        }
        hi: i32 = e / 100
        mid: i32 = (e / 10) % 10
        lo: i32 = e % 10

        if hi != 0 {
            out[at] = u8(48 + hi)
            at += 1
            out[at] = u8(48 + mid)
            at += 1
        } else if mid != 0 {
            out[at] = u8(48 + mid)
            at += 1
        }
        out[at] = u8(48 + lo)
        at += 1
    }
    return usize(at)
}
