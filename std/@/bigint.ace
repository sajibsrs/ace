/* Fixed-capacity unsigned integer support for exact standard-library numeric
 * conversion. Internal implementation module; no bare std facade exposes it.
 */

pub Big: struct {
    limbs: [96]u32,
    used: int,
}

pub from_u64(value: u64): Big {
    out: Big = Big { limbs = [u32(0) : 96], used = 0 }

    if value != 0 {
        out.limbs[0] = u32(value)
        out.used = 1

        if value >> 32 != 0 {
            out.limbs[1] = u32(value >> 32)
            out.used = 2
        }
    }
    return out
}

normalize(mut value: Big) {
    for value.used > 0 {
        if value.limbs[value.used - 1] != 0 {
            break
        }
        value.used -= 1
    }
}

pub multiply_small(mut value: Big, factor: u32) {
    if factor == 0 {
        value.used = 0
        return
    }
    carry: u64 = 0

    for i: int in 0 .. value.used {
        product: u64 = u64(value.limbs[i]) * u64(factor) + carry
        value.limbs[i] = u32(product)
        carry = product >> 32
    }

    if carry != 0 {
        value.limbs[value.used] = u32(carry)
        value.used += 1
    }
}

pub add_small(mut value: Big, addend: u32) {
    if addend == 0 {
        return
    }
    carry: u64 = u64(addend)
    at: int = 0

    for carry != 0 && at < value.used {
        sum: u64 = u64(value.limbs[at]) + carry
        value.limbs[at] = u32(sum)
        carry = sum >> 32
        at += 1
    }

    if carry != 0 {
        value.limbs[value.used] = u32(carry)
        value.used += 1
    } else if value.used == 0 {
        value.limbs[0] = addend
        value.used = 1
    }
}

pub multiply_power5(mut value: Big, power: int) {
    for i: int in 0 .. power {
        multiply_small(mut value, 5)
    }
}

pub shift_left(mut value: Big, count: int) {
    if value.used == 0 || count == 0 {
        return
    }
    words: int = count / 32
    bits: int = count % 32

    if words != 0 {
        for i: int in 0 .. value.used {
            source_index: int = value.used - 1 - i
            value.limbs[source_index + words] = value.limbs[source_index]
        }
        for i: int in 0 .. words {
            value.limbs[i] = 0
        }
        value.used += words
    }

    if bits != 0 {
        carry: u64 = 0

        for i: int in 0 .. value.used {
            shifted: u64 = (u64(value.limbs[i]) << u64(bits)) | carry
            value.limbs[i] = u32(shifted)
            carry = shifted >> 32
        }

        if carry != 0 {
            value.limbs[value.used] = u32(carry)
            value.used += 1
        }
    }
}

pub compare(a: Big, b: Big): int {
    if a.used < b.used {
        return -1
    }

    if a.used > b.used {
        return 1
    }

    for i: int in 0 .. a.used {
        at: int = a.used - 1 - i

        if a.limbs[at] < b.limbs[at] {
            return -1
        }

        if a.limbs[at] > b.limbs[at] {
            return 1
        }
    }
    return 0
}

divide_small(mut value: Big, divisor: u32): u32 {
    remainder: u64 = 0

    for i: int in 0 .. value.used {
        at: int = value.used - 1 - i
        whole: u64 = (remainder << 32) | u64(value.limbs[at])
        value.limbs[at] = u32(whole / u64(divisor))
        remainder = whole % u64(divisor)
    }
    normalize(mut value)
    return u32(remainder)
}

pub decimal(value: Big, out: mut []u8): int {
    if value.used == 0 {
        out[0] = u8(48)
        return 1
    }
    work: Big = value
    count: int = 0

    for work.used != 0 {
        digit: u32 = divide_small(mut work, 10)
        out[count] = u8(48 + digit)
        count += 1
    }

    for i: int in 0 .. count / 2 {
        other: int = count - 1 - i
        saved: u8 = out[i]
        out[i] = out[other]
        out[other] = saved
    }
    return count
}
