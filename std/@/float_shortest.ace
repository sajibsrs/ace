/* Fixed-width shortest IEEE-754 binary-to-decimal conversion.
 *
 * This is an Ace adaptation of Ulf Adams' Ryu algorithm and lookup tables:
 * https://github.com/ulfjack/ryu
 * Copyright 2018 Ulf Adams. Licensed under Apache-2.0; see
 * LICENSES/Apache-2.0.txt. The implementation is expressed in Ace and returns
 * only a decimal coefficient and exponent; public spelling remains owned by
 * fmt and str.
 */

import table: @float_shortest_tables

pub Floating: struct {
    coefficient: u64,
    exponent: i32,
}

pub Wide: struct {
    low: u64,
    high: u64,
}

log10_pow2(exponent: i32): u32 { return (u32(exponent) * 78913) >> 18 }

log10_pow5(exponent: i32): u32 { return (u32(exponent) * 732923) >> 20 }

pow5_bits(exponent: i32): i32 { return i32((u32(exponent) * 1217359) >> 19) + 1 }

pub multiply_wide(a: u64, b: u64): Wide {
    a_low: u32 = u32(a)
    a_high: u32 = u32(a >> 32)
    b_low: u32 = u32(b)
    b_high: u32 = u32(b >> 32)
    p00: u64 = u64(a_low) * u64(b_low)
    p01: u64 = u64(a_low) * u64(b_high)
    p10: u64 = u64(a_high) * u64(b_low)
    p11: u64 = u64(a_high) * u64(b_high)
    mid1: u64 = p10 + (p00 >> 32)
    mid2: u64 = p01 + u64(u32(mid1))
    high: u64 = p11 + (mid1 >> 32) + (mid2 >> 32)
    low: u64 = (u64(u32(mid2)) << 32) | u64(u32(p00))
    return Wide {
        low = low,
        high = high,
    }
}

shift_wide(value: Wide, distance: i32): u64 {
    shift: u64 = u64(distance)
    return (value.high << (64 - shift)) | (value.low >> shift)
}

multiply_shift64(value: u64, factor: table.Power, shift: i32): u64 {
    upper: Wide = multiply_wide(value, factor.high)
    lower: Wide = multiply_wide(value, factor.low)
    low_sum: u64 = u64(u32(upper.low)) + u64(u32(lower.high))
    high_sum: u64 = (upper.low >> 32) + (lower.high >> 32) +
                    (low_sum >> 32)
    middle: u64 = (u64(u32(high_sum)) << 32) | u64(u32(low_sum))
    high: u64 = upper.high + (high_sum >> 32)
    return shift_wide(Wide {
        low = middle,
        high = high,
    }, shift - 64)
}

multiply_shift32(value: u32, factor: u64, shift: i32): u32 {
    factor_low: u32 = u32(factor)
    factor_high: u32 = u32(factor >> 32)
    low: u64 = u64(value) * u64(factor_low)
    high: u64 = u64(value) * u64(factor_high)
    sum: u64 = (low >> 32) + high
    return u32(sum >> u64(shift - 32))
}

power5_factor(value: u64): u32 {
    work: u64 = value
    count: u32 = 0

    for work != 0 {
        quotient: u64 = work / 5

        if work - quotient * 5 != 0 { break }
        work = quotient
        count += 1
    }
    return count
}

multiple_power5(value: u64, power: u32): bool { return power5_factor(value) >= power }

multiple_power2(value: u64, power: u32): bool {
    if power == 0 { return true }
    return (value & ((u64(1) << u64(power)) - 1)) == 0
}

pub binary64(fraction: u64, exponent: u64): Floating {
    exponent2: i32 = 0
    mantissa2: u64 = 0

    if exponent == 0 {
        exponent2 = 1 - 1023 - 52 - 2
        mantissa2 = fraction
    } else {
        exponent2 = i32(exponent) - 1023 - 52 - 2
        mantissa2 = u64(0x10000000000000) | fraction
    }
    accept_bounds: bool = mantissa2 % 2 == 0
    center: u64 = 4 * mantissa2
    lower_shift: u64 = 0

    if fraction != 0 || exponent <= 1 { lower_shift = 1 }
    rounded: u64 = 0
    upper: u64 = 0
    lower: u64 = 0
    exponent10: i32 = 0
    lower_zeros: bool = false
    rounded_zeros: bool = false

    if exponent2 >= 0 {
        q: u32 = log10_pow2(exponent2)

        if exponent2 > 3 { q -= 1 }
        exponent10 = i32(q)
        k: i32 = 125 + pow5_bits(i32(q)) - 1
        shift: i32 = 0 - exponent2 + i32(q) + k
        factor: table.Power = table.inverse[int(q)]
        rounded = multiply_shift64(center, factor, shift)
        upper = multiply_shift64(center + 2, factor, shift)
        lower = multiply_shift64(center - 1 - lower_shift, factor, shift)

        if q <= 21 {
            if center % 5 == 0 {
                rounded_zeros = multiple_power5(center, q)
            } else if accept_bounds {
                lower_zeros = multiple_power5(center - 1 - lower_shift, q)
            } else if multiple_power5(center + 2, q) {
                upper -= 1
            }
        }
    } else {
        positive: i32 = 0 - exponent2
        q: u32 = log10_pow5(positive)

        if positive > 1 { q -= 1 }
        exponent10 = i32(q) + exponent2
        power: i32 = positive - i32(q)
        k: i32 = pow5_bits(power) - 125
        shift: i32 = i32(q) - k
        factor: table.Power = table.power[int(power)]
        rounded = multiply_shift64(center, factor, shift)
        upper = multiply_shift64(center + 2, factor, shift)
        lower = multiply_shift64(center - 1 - lower_shift, factor, shift)

        if q <= 1 {
            rounded_zeros = true

            if accept_bounds {
                lower_zeros = lower_shift == 1
            } else {
                upper -= 1
            }
        } else if q < 63 {
            rounded_zeros = multiple_power2(center, q)
        }
    }
    removed: i32 = 0
    last: u8 = 0
    output: u64 = 0

    if lower_zeros || rounded_zeros {
        for upper / 10 > lower / 10 {
            lower_zeros = lower_zeros && lower % 10 == 0
            rounded_zeros = rounded_zeros && last == 0
            last = u8(rounded % 10)
            rounded = rounded / 10
            upper = upper / 10
            lower = lower / 10
            removed += 1
        }

        if lower_zeros {
            for lower % 10 == 0 {
                rounded_zeros = rounded_zeros && last == 0
                last = u8(rounded % 10)
                rounded = rounded / 10
                upper = upper / 10
                lower = lower / 10
                removed += 1
            }
        }

        if rounded_zeros && last == 5 && rounded % 2 == 0 { last = 4 }
        output = rounded

        if (rounded == lower && (!accept_bounds || !lower_zeros)) || last >= 5 { output += 1 }
    } else {
        round_up: bool = false
        upper100: u64 = upper / 100
        lower100: u64 = lower / 100

        if upper100 > lower100 {
            round_up = rounded - (rounded / 100) * 100 >= 50
            rounded = rounded / 100
            upper = upper100
            lower = lower100
            removed += 2
        }

        for upper / 10 > lower / 10 {
            quotient: u64 = rounded / 10
            round_up = rounded - quotient * 10 >= 5
            rounded = quotient
            upper = upper / 10
            lower = lower / 10
            removed += 1
        }
        output = rounded

        if rounded == lower || round_up { output += 1 }
    }
    return Floating {
        coefficient = output,
        exponent = exponent10 + removed,
    }
}

pub binary32(fraction: u32, exponent: u32): Floating {
    exponent2: i32 = 0
    mantissa2: u32 = 0

    if exponent == 0 {
        exponent2 = 1 - 127 - 23 - 2
        mantissa2 = fraction
    } else {
        exponent2 = i32(exponent) - 127 - 23 - 2
        mantissa2 = u32(0x800000) | fraction
    }
    accept_bounds: bool = mantissa2 % 2 == 0
    center: u32 = 4 * mantissa2
    upper_source: u32 = center + 2
    lower_shift: u32 = 0

    if fraction != 0 || exponent <= 1 { lower_shift = 1 }
    lower_source: u32 = center - 1 - lower_shift
    rounded: u32 = 0
    upper: u32 = 0
    lower: u32 = 0
    exponent10: i32 = 0
    lower_zeros: bool = false
    rounded_zeros: bool = false
    last: u8 = 0

    if exponent2 >= 0 {
        q: u32 = log10_pow2(exponent2)
        exponent10 = i32(q)
        k: i32 = 61 + pow5_bits(i32(q)) - 1
        shift: i32 = 0 - exponent2 + i32(q) + k
        factor: u64 = table.inverse[int(q)].high + 1
        rounded = multiply_shift32(center, factor, shift)
        upper = multiply_shift32(upper_source, factor, shift)
        lower = multiply_shift32(lower_source, factor, shift)

        if q != 0 && (upper - 1) / 10 <= lower / 10 {
            previous: u32 = q - 1
            previous_k: i32 = 61 + pow5_bits(i32(previous)) - 1
            previous_factor: u64 = table.inverse[int(previous)].high + 1
            last = u8(multiply_shift32(center, previous_factor, 0 - exponent2 + i32(previous) + previous_k) % 10)
        }

        if q <= 9 {
            if center % 5 == 0 {
                rounded_zeros = multiple_power5(u64(center), q)
            } else if accept_bounds {
                lower_zeros = multiple_power5(u64(lower_source), q)
            } else if multiple_power5(u64(upper_source), q) {
                upper -= 1
            }
        }
    } else {
        positive: i32 = 0 - exponent2
        q: u32 = log10_pow5(positive)
        exponent10 = i32(q) + exponent2
        power_index: i32 = positive - i32(q)
        k: i32 = pow5_bits(power_index) - 61
        shift: i32 = i32(q) - k
        factor: u64 = table.power[power_index].high
        rounded = multiply_shift32(center, factor, shift)
        upper = multiply_shift32(upper_source, factor, shift)
        lower = multiply_shift32(lower_source, factor, shift)

        if q != 0 && (upper - 1) / 10 <= lower / 10 {
            next_index: i32 = power_index + 1
            next_shift: i32 = i32(q) - 1 - (pow5_bits(next_index) - 61)
            last = u8(multiply_shift32(center, table.power[next_index].high, next_shift) % 10)
        }

        if q <= 1 {
            rounded_zeros = true

            if accept_bounds {
                lower_zeros = lower_shift == 1
            } else {
                upper -= 1
            }
        } else if q < 31 {
            rounded_zeros = multiple_power2(u64(center), q - 1)
        }
    }
    removed: i32 = 0
    output: u32 = 0

    if lower_zeros || rounded_zeros {
        for upper / 10 > lower / 10 {
            lower_zeros = lower_zeros && lower % 10 == 0
            rounded_zeros = rounded_zeros && last == 0
            last = u8(rounded % 10)
            rounded = rounded / 10
            upper = upper / 10
            lower = lower / 10
            removed += 1
        }

        if lower_zeros {
            for lower % 10 == 0 {
                rounded_zeros = rounded_zeros && last == 0
                last = u8(rounded % 10)
                rounded = rounded / 10
                upper = upper / 10
                lower = lower / 10
                removed += 1
            }
        }

        if rounded_zeros && last == 5 && rounded % 2 == 0 { last = 4 }
        output = rounded

        if (rounded == lower && (!accept_bounds || !lower_zeros)) || last >= 5 { output += 1 }
    } else {
        for upper / 10 > lower / 10 {
            last = u8(rounded % 10)
            rounded = rounded / 10
            upper = upper / 10
            lower = lower / 10
            removed += 1
        }
        output = rounded

        if rounded == lower || last >= 5 { output += 1 }
    }
    return Floating {
        coefficient = u64(output),
        exponent = exponent10 + removed,
    }
}
