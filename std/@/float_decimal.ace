/* Exact IEEE-754 binary-to-decimal conversion available to compiler-shipped
 * standard-library sources. This reserved internal implementation module has
 * no bare std facade.
 */

import bits
import big: @bigint
import ryu: @float_shortest

pub Type: enum { finite, zero, infinity, nan }

pub Decimal: struct {
    count: int,
    point: i32,
    negative: bool,
    number_type: Type,
}

write_shortest(value: ryu.Floating, out: mut []u8): (int, i32) {
    coefficient: u64 = value.coefficient
    reversed: [24]u8 = [0 : 24]
    count: int = 0

    for coefficient != 0 {
        reversed[count] = u8(48 + coefficient % 10)
        coefficient = coefficient / 10
        count += 1
    }

    for i: int in 0 .. count { out[i] = reversed[count - 1 - i] }
    return count, value.exponent + i32(count)
}

pub binary64(value: f64, out: mut []u8): Decimal {
    raw: u64 = bits.from_float(value)
    negative: bool = raw >> 63 != 0
    exponent: u64 = (raw >> 52) & u64(0x7FF)
    fraction: u64 = raw & u64(0xFFFFFFFFFFFFF)

    if exponent == u64(0x7FF) {
        if fraction == 0 {
            return Decimal {
                count = 0,
                point = 0,
                negative = negative,
                number_type = Type.infinity,
            }
        }
        return Decimal {
            count = 0,
            point = 0,
            negative = false,
            number_type = Type.nan,
        }
    }

    if exponent == 0 && fraction == 0 {
        return Decimal {
            count = 0,
            point = 0,
            negative = negative,
            number_type = Type.zero,
        }
    }
    converted: ryu.Floating = ryu.binary64(fraction, exponent)
    count: int, point: i32 = write_shortest(converted, out)
    return Decimal {
        count = count,
        point = point,
        negative = negative,
        number_type = Type.finite,
    }
}

pub binary32(value: f32, out: mut []u8): Decimal {
    raw: u32 = bits.from_float(value)
    negative: bool = raw >> 31 != 0
    exponent: u32 = (raw >> 23) & u32(0xFF)
    fraction: u32 = raw & u32(0x7FFFFF)

    if exponent == u32(0xFF) {
        if fraction == 0 {
            return Decimal {
                count = 0,
                point = 0,
                negative = negative,
                number_type = Type.infinity,
            }
        }
        return Decimal {
            count = 0,
            point = 0,
            negative = false,
            number_type = Type.nan,
        }
    }

    if exponent == 0 && fraction == 0 {
        return Decimal {
            count = 0,
            point = 0,
            negative = negative,
            number_type = Type.zero,
        }
    }
    converted: ryu.Floating = ryu.binary32(fraction, exponent)
    count: int, point: i32 = write_shortest(converted, out)
    return Decimal {
        count = count,
        point = point,
        negative = negative,
        number_type = Type.finite,
    }
}

fixed(mantissa: u64, exponent2: i32, precision: int, negative: bool, out: mut []u8): Decimal {
    exact_value: big.Big = big.from_u64(mantissa)

    if exponent2 >= 0 {
        big.shift_left(mut exact_value, int(exponent2))
    } else {
        big.multiply_power5(mut exact_value, 0 - int(exponent2))
    }
    exact: [800]u8
    exact_view: mut []u8 = mut exact[0..800]
    exact_count: int = big.decimal(exact_value, exact_view)
    point: i32 = i32(exact_count)

    if exponent2 < 0 { point += exponent2 }
    keep: int = int(point) + precision

    if keep < 0 {
        return Decimal {
            count = 0,
            point = point,
            negative = negative,
            number_type = Type.zero,
        }
    }

    if keep == 0 {
        round_up: bool = exact_view[0] > 53

        if exact_view[0] == 53 {
            for i: int in 1 .. exact_count {
                if exact_view[i] != 48 {
                    round_up = true
                    break
                }
            }
        }

        if round_up {
            out[0] = u8(49)
            return Decimal {
                count = 1,
                point = i32(1 - precision),
                negative = negative,
                number_type = Type.finite,
            }
        }
        return Decimal {
            count = 0,
            point = point,
            negative = negative,
            number_type = Type.zero,
        }
    }
    copied: int = keep

    if copied > exact_count { copied = exact_count }

    for i: int in 0 .. copied { out[i] = exact_view[i] }

    for i: int in copied .. keep { out[i] = u8(48) }

    if keep < exact_count {
        round_up: bool = exact_view[keep] > 53

        if exact_view[keep] == 53 {
            for i: int in keep + 1 .. exact_count {
                if exact_view[i] != 48 {
                    round_up = true
                    break
                }
            }

            if !round_up && (out[keep - 1] - 48) % 2 != 0 { round_up = true }
        }

        if round_up {
            carry: bool = true

            for i: int in 0 .. keep {
                at: int = keep - 1 - i

                if out[at] != 57 {
                    out[at] += 1
                    carry = false
                    break
                }
                out[at] = u8(48)
            }

            if carry {
                for i: int in 0 .. keep { out[keep - i] = out[keep - 1 - i] }
                out[0] = u8(49)
                keep += 1
                point += 1
            }
        }
    }
    return Decimal {
        count = keep,
        point = point,
        negative = negative,
        number_type = Type.finite,
    }
}

pub fixed64(value: f64, precision: usize, out: mut []u8): Decimal {
    raw: u64 = bits.from_float(value)
    negative: bool = raw >> 63 != 0
    exponent: u64 = (raw >> 52) & u64(0x7FF)
    fraction: u64 = raw & u64(0xFFFFFFFFFFFFF)

    if exponent == u64(0x7FF) {
        if fraction == 0 {
            return Decimal {
                count = 0,
                point = 0,
                negative = negative,
                number_type = Type.infinity,
            }
        }
        return Decimal {
            count = 0,
            point = 0,
            negative = false,
            number_type = Type.nan,
        }
    }

    if exponent == 0 && fraction == 0 {
        return Decimal {
            count = 0,
            point = 0,
            negative = negative,
            number_type = Type.zero,
        }
    }
    mantissa: u64 = fraction
    exponent2: i32 = -1074

    if exponent != 0 {
        mantissa |= u64(0x10000000000000)
        exponent2 = i32(exponent) - 1023 - 52
    }
    return fixed(mantissa, exponent2, int(precision), negative, out)
}

pub fixed32(value: f32, precision: usize, out: mut []u8): Decimal {
    raw: u32 = bits.from_float(value)
    negative: bool = raw >> 31 != 0
    exponent: u32 = (raw >> 23) & u32(0xFF)
    fraction: u32 = raw & u32(0x7FFFFF)

    if exponent == u32(0xFF) {
        if fraction == 0 {
            return Decimal {
                count = 0,
                point = 0,
                negative = negative,
                number_type = Type.infinity,
            }
        }
        return Decimal {
            count = 0,
            point = 0,
            negative = false,
            number_type = Type.nan,
        }
    }

    if exponent == 0 && fraction == 0 {
        return Decimal {
            count = 0,
            point = 0,
            negative = negative,
            number_type = Type.zero,
        }
    }
    mantissa: u64 = u64(fraction)
    exponent2: i32 = -149

    if exponent != 0 {
        mantissa |= u64(0x800000)
        exponent2 = i32(exponent) - 127 - 23
    }
    return fixed(mantissa, exponent2, int(precision), negative, out)
}
