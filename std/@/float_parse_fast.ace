/* Fixed-width tiers for decimal-to-IEEE conversion, adapted from Daniel
 * Lemire's fast_float implementation (Apache-2.0). The caller retains an
 * exact bigint fallback for inputs outside these proven paths.
 */

import bits
import table: @float_parse_tables

// Powers of ten exactly representable at each width: 5^22 < 2^53, 5^10 < 2^24.
EXACT_POWERS64: const [23]f64 = [
    1.0e0, 1.0e1, 1.0e2, 1.0e3, 1.0e4, 1.0e5, 1.0e6, 1.0e7,
    1.0e8, 1.0e9, 1.0e10, 1.0e11, 1.0e12, 1.0e13, 1.0e14, 1.0e15,
    1.0e16, 1.0e17, 1.0e18, 1.0e19, 1.0e20, 1.0e21, 1.0e22,
]
EXACT_POWERS32: const [11]f32 = [
    1.0e0, 1.0e1, 1.0e2, 1.0e3, 1.0e4, 1.0e5, 1.0e6, 1.0e7,
    1.0e8, 1.0e9, 1.0e10,
]

integer_bits(value: u64, fraction_bits: int, bias: int): u64 {
    length: int = 64 - int(bits.lead_zeros(value))
    significand: u64 = value

    if length > fraction_bits + 1 {
        removed: int = length - fraction_bits - 1
        quotient: u64 = value >> u64(removed)
        mask: u64 = (u64(1) << u64(removed)) - 1
        remainder: u64 = value & mask
        halfway: u64 = u64(1) << u64(removed - 1)

        if remainder > halfway || (remainder == halfway && quotient % 2 != 0) {
            quotient += 1
        }
        significand = quotient

        if significand == (u64(1) << u64(fraction_bits + 1)) {
            significand = significand >> 1
            length += 1
        }
    } else {
        significand = value << u64(fraction_bits + 1 - length)
    }
    exponent: u64 = u64(length - 1 + bias)
    fraction_mask: u64 = (u64(1) << u64(fraction_bits)) - 1
    return (exponent << u64(fraction_bits)) | (significand & fraction_mask)
}

/* Clinger's fast path: an exact coefficient scaled by an exact power of ten
 * rounds once, correctly, in the default round-to-nearest environment.
 */
pub exact64(coefficient: u64, exponent10: int, mut raw: u64): bool {
    if coefficient > (u64(1) << 53) || exponent10 < -22 || exponent10 > 22 {
        return false
    }
    value: f64 = f64(coefficient)

    if exponent10 < 0 {
        value = value / EXACT_POWERS64[0 - exponent10]
    } else {
        value = value * EXACT_POWERS64[exponent10]
    }
    raw = bits.from_float(value)
    return true
}

pub exact32(coefficient: u64, exponent10: int, mut raw: u64): bool {
    if coefficient > (u64(1) << 24) || exponent10 < -10 || exponent10 > 10 {
        return false
    }
    value: f32 = f32(coefficient)

    if exponent10 < 0 {
        value = value / EXACT_POWERS32[0 - exponent10]
    } else {
        value = value * EXACT_POWERS32[exponent10]
    }
    raw = u64(bits.from_float(value))
    return true
}

pub small_integer(coefficient: u64, exponent10: int, fraction_bits: int, bias: int, mut raw: u64): bool {
    // Past 10^19 any nonzero value overflows; binary64/binary32 handle zero.
    if exponent10 > 19 {
        return false
    }
    value: u64 = coefficient
    exponent: int = exponent10

    for exponent < 0 && value % 10 == 0 {
        value = value / 10
        exponent += 1
    }

    if exponent < 0 {
        return false
    }

    for exponent > 0 {
        if value > u64(0xFFFFFFFFFFFFFFFF) / 10 {
            return false
        }
        value *= 10
        exponent -= 1
    }

    if value == 0 {
        raw = 0
        return true
    }
    raw = integer_bits(value, fraction_bits, bias)
    return true
}

pub binary64(coefficient: u64, exponent10: int, mut raw: u64): bool {
    if coefficient == 0 || exponent10 < -342 {
        raw = 0
        return true
    }
    if exponent10 > 308 {
        raw = u64(2047) << 52
        return true
    }
    zeros: int = int(bits.lead_zeros(coefficient))
    normalized: u64 = coefficient << u64(zeros)
    index: int = 2 * (exponent10 + 342)
    factor: u64 = table.powers[index]
    value_low: u32 = u32(normalized)
    value_high: u32 = u32(normalized >> 32)
    factor_low: u32 = u32(factor)
    factor_high: u32 = u32(factor >> 32)
    p00: u64 = u64(value_low) * u64(factor_low)
    p01: u64 = u64(value_low) * u64(factor_high)
    p10: u64 = u64(value_high) * u64(factor_low)
    p11: u64 = u64(value_high) * u64(factor_high)
    mid1: u64 = p10 + (p00 >> 32)
    mid2: u64 = p01 + u64(u32(mid1))
    multiplied_high: u64 = p11 + (mid1 >> 32) + (mid2 >> 32)
    multiplied_low: u64 = (u64(u32(mid2)) << 32) | u64(u32(p00))
    mask: u64 = u64(0xFFFFFFFFFFFFFFFF) >> 55

    if (multiplied_high & mask) == mask {
        second_factor: u64 = table.powers[index + 1]
        second_low: u32 = u32(second_factor)
        second_high: u32 = u32(second_factor >> 32)
        q00: u64 = u64(value_low) * u64(second_low)
        q01: u64 = u64(value_low) * u64(second_high)
        q10: u64 = u64(value_high) * u64(second_low)
        q11: u64 = u64(value_high) * u64(second_high)
        qmid1: u64 = q10 + (q00 >> 32)
        qmid2: u64 = q01 + u64(u32(qmid1))
        second_product_high: u64 = q11 + (qmid1 >> 32) + (qmid2 >> 32)
        low_part: u64 = u64(u32(multiplied_low)) +
                        u64(u32(second_product_high))
        high_part: u64 = (multiplied_low >> 32) +
                         (second_product_high >> 32) + (low_part >> 32)
        multiplied_low = (u64(u32(high_part)) << 32) | u64(u32(low_part))
        multiplied_high += high_part >> 32
    }
    upper_bit: int = int(multiplied_high >> 63)
    shift: int = upper_bit + 9
    mantissa: u64 = multiplied_high >> u64(shift)
    power2: int = ((217706 * exponent10) >> 16) + 1086 + upper_bit - zeros

    if power2 <= 0 {
        distance: int = 0 - power2 + 1

        if distance >= 64 {
            raw = 0
            return true
        }
        mantissa = mantissa >> u64(distance)
        mantissa += mantissa & 1
        mantissa = mantissa >> 1

        if mantissa < (u64(1) << 52) {
            power2 = 0
        } else {
            power2 = 1
        }
        raw = (u64(power2) << 52) | mantissa
        return true
    }

    if multiplied_low <= 1 && exponent10 >= -4 && exponent10 <= 23 &&
       (mantissa & 3) == 1 &&
       (mantissa << u64(shift)) == multiplied_high {
        mantissa &= u64(0xFFFFFFFFFFFFFFFE)
    }
    mantissa += mantissa & 1
    mantissa = mantissa >> 1

    if mantissa >= (u64(2) << 52) {
        mantissa = u64(1) << 52
        power2 += 1
    }
    mantissa &= (u64(1) << 52) - 1

    if power2 >= 2047 {
        power2 = 2047
        mantissa = 0
    }
    raw = (u64(power2) << 52) | mantissa
    return true
}

pub binary32(coefficient: u64, exponent10: int, mut raw: u64): bool {
    if coefficient == 0 || exponent10 < -64 {
        raw = 0
        return true
    }
    if exponent10 > 38 {
        raw = u64(255) << 23
        return true
    }
    zeros: int = int(bits.lead_zeros(coefficient))
    normalized: u64 = coefficient << u64(zeros)
    index: int = 2 * (exponent10 + 342)
    factor: u64 = table.powers[index]
    value_low: u32 = u32(normalized)
    value_high: u32 = u32(normalized >> 32)
    factor_low: u32 = u32(factor)
    factor_high: u32 = u32(factor >> 32)
    p00: u64 = u64(value_low) * u64(factor_low)
    p01: u64 = u64(value_low) * u64(factor_high)
    p10: u64 = u64(value_high) * u64(factor_low)
    p11: u64 = u64(value_high) * u64(factor_high)
    mid1: u64 = p10 + (p00 >> 32)
    mid2: u64 = p01 + u64(u32(mid1))
    multiplied_high: u64 = p11 + (mid1 >> 32) + (mid2 >> 32)
    multiplied_low: u64 = (u64(u32(mid2)) << 32) | u64(u32(p00))
    mask: u64 = u64(0xFFFFFFFFFFFFFFFF) >> 26

    if (multiplied_high & mask) == mask {
        second_factor: u64 = table.powers[index + 1]
        second_low: u32 = u32(second_factor)
        second_high: u32 = u32(second_factor >> 32)
        q00: u64 = u64(value_low) * u64(second_low)
        q01: u64 = u64(value_low) * u64(second_high)
        q10: u64 = u64(value_high) * u64(second_low)
        q11: u64 = u64(value_high) * u64(second_high)
        qmid1: u64 = q10 + (q00 >> 32)
        qmid2: u64 = q01 + u64(u32(qmid1))
        second_product_high: u64 = q11 + (qmid1 >> 32) + (qmid2 >> 32)
        low_part: u64 = u64(u32(multiplied_low)) +
                        u64(u32(second_product_high))
        high_part: u64 = (multiplied_low >> 32) +
                         (second_product_high >> 32) + (low_part >> 32)
        multiplied_low = (u64(u32(high_part)) << 32) | u64(u32(low_part))
        multiplied_high += high_part >> 32
    }
    upper_bit: int = int(multiplied_high >> 63)
    shift: int = upper_bit + 38
    mantissa: u64 = multiplied_high >> u64(shift)
    power2: int = ((217706 * exponent10) >> 16) + 190 + upper_bit - zeros

    if power2 <= 0 {
        distance: int = 0 - power2 + 1

        if distance >= 64 {
            raw = 0
            return true
        }
        mantissa = mantissa >> u64(distance)
        mantissa += mantissa & 1
        mantissa = mantissa >> 1

        if mantissa < (u64(1) << 23) {
            power2 = 0
        } else {
            power2 = 1
        }
        raw = (u64(power2) << 23) | mantissa
        return true
    }

    if multiplied_low <= 1 && exponent10 >= -17 && exponent10 <= 10 &&
       (mantissa & 3) == 1 &&
       (mantissa << u64(shift)) == multiplied_high {
        mantissa &= u64(0xFFFFFFFFFFFFFFFE)
    }
    mantissa += mantissa & 1
    mantissa = mantissa >> 1

    if mantissa >= (u64(2) << 23) {
        mantissa = u64(1) << 23
        power2 += 1
    }
    mantissa &= (u64(1) << 23) - 1

    if power2 >= 255 {
        power2 = 255
        mantissa = 0
    }
    raw = (u64(power2) << 23) | mantissa
    return true
}
