/* Exact decimal-to-IEEE-754 conversion available to compiler-shipped
 * standard-library sources. This reserved internal implementation module has
 * no bare std facade.
 */

import bits
import big: @bigint
import load: @byte_load
import fast: @eisel_lemire

FastDecimal: struct {
    coefficient: u64,
    exponent10: int,
    negative: bool,
    digits: int,
    number_type: int, // 0 finite, 1 infinity, 2 NaN, 3 invalid
}

pub Decimal: struct {
    coefficient: big.Big,
    exponent10: int,
    negative: bool,
    digits: int,
    number_type: int, // 0 finite, 1 infinity, 2 NaN, 3 invalid
}

equal_text(text: string, expected: string): bool {
    if text.len != expected.len { return false }
    for i: usize in 0 .. text.len {
        if text[i] != expected[i] { return false }
    }
    return true
}

fast_decimal(text: string, result: *FastDecimal) {
    if text.len == 0 || text.len >= 512 { return }
    if text.len == 3 {
        if text[0] == 110 && text[1] == 97 && text[2] == 110 {
            result.number_type = 2
            return
        }
        if text[0] == 105 && text[1] == 110 && text[2] == 102 {
            result.number_type = 1
            return
        }
    } else if text.len == 4 && text[0] == 45 && text[1] == 105 &&
              text[2] == 110 && text[3] == 102 {
        result.negative = true
        result.number_type = 1
        return
    }
    at: usize = 0
    negative: bool = false

    if text[0] == 45 {
        negative = true
        at = 1
    }
    if at == text.len { return }
    coefficient: u64 = 0
    fractional: int = 0
    significant: int = 0
    seen_nonzero: bool = false
    seen_dot: bool = false
    seen_digit: bool = false

    for at < text.len {
        c: u8 = text[at]

        if seen_nonzero && c >= '0' && c <= '9' && at + 8 <= text.len {
            word: u64 = load.unaligned_u64(text, at)
            high: u64 = (word & u64(0xF0F0F0F0F0F0F0F0)) ^
                        u64(0x3030303030303030)
            high_bad: u64 = (high | (high << 1) | (high << 2) | (high << 3)) &
                            u64(0x8080808080808080)
            low: u64 = word & u64(0x0F0F0F0F0F0F0F0F)
            low_bad: u64 = ((low + u64(0x0606060606060606)) &
                            u64(0x1010101010101010)) << 3
            non_digit: u64 = high_bad | low_bad
            run: int = 8

            if non_digit != 0 { run = int(bits.ctz(non_digit)) / 8 }

            if run > 0 {
                seen_digit = true

                if run == 8 && seen_nonzero {
                    if seen_dot { fractional += 8 }
                    significant += 8

                    if significant <= 19 {
                        digits: u64 = word - u64(0x3030303030303030)
                        bytes: u64 = u64(0x00FF00FF00FF00FF)
                        pairs: u64 = (digits & bytes) * 10 +
                                     ((digits >> 8) & bytes)
                        halves: u64 = u64(0x0000FFFF0000FFFF)
                        quads: u64 = (pairs & halves) * 100 +
                                     ((pairs >> 16) & halves)
                        eight: u64 = u64(u32(quads)) * 10000 + (quads >> 32)
                        coefficient = coefficient * 100000000 +
                                      eight
                    }
                } else {
                    for offset: int in 0 .. run {
                        c: u8 = text[at + usize(offset)]

                        if seen_dot { fractional += 1 }
                        if c != 48 || seen_nonzero {
                            seen_nonzero = true
                            significant += 1

                            if significant <= 19 { coefficient = coefficient * 10 + u64(c - 48) }
                        }
                    }
                }
                at += usize(run)
                continue
            }
        }

        if c >= '0' && c <= '9' {
            seen_digit = true

            if seen_dot { fractional += 1 }
            if c != 48 || seen_nonzero {
                seen_nonzero = true
                significant += 1

                if significant <= 19 { coefficient = coefficient * 10 + u64(c - 48) }
            }
            at += 1
            continue
        }
        if c == '.' && !seen_dot {
            seen_dot = true
            at += 1
            continue
        }
        break
    }
    if !seen_digit { return }
    explicit: int = 0

    if at < text.len && (text[at] == 101 || text[at] == 69) {
        at += 1
        exponent_negative: bool = false

        if at < text.len && (text[at] == 43 || text[at] == 45) {
            exponent_negative = text[at] == 45
            at += 1
        }
        exponent_digits: int = 0

        for at < text.len && text[at] >= 48 && text[at] <= 57 {
            if explicit < 10000 { explicit = explicit * 10 + int(text[at] - 48) }
            exponent_digits += 1
            at += 1
        }
        if exponent_digits == 0 { return }
        if exponent_negative { explicit = 0 - explicit }
    }
    if at != text.len { return }
    exponent10: int = explicit - fractional

    if significant > 19 { exponent10 += significant - 19 }
    result.coefficient = coefficient
    result.exponent10 = exponent10
    result.negative = negative
    result.digits = significant
    result.number_type = 0
}

decimal(text: string): Decimal {
    invalid: Decimal = Decimal {
        coefficient = big.from_u64(0),
        exponent10 = 0,
        negative = false,
        digits = 0,
        number_type = 3,
    }

    if text.len == 0 || text.len >= 512 { return invalid }
    if equal_text(text, "nan") {
        return Decimal {
            coefficient = big.from_u64(0),
            exponent10 = 0,
            negative = false,
            digits = 0,
            number_type = 2,
        }
    }
    if equal_text(text, "inf") {
        return Decimal {
            coefficient = big.from_u64(0),
            exponent10 = 0,
            negative = false,
            digits = 0,
            number_type = 1,
        }
    }
    if equal_text(text, "-inf") {
        return Decimal {
            coefficient = big.from_u64(0),
            exponent10 = 0,
            negative = true,
            digits = 0,
            number_type = 1,
        }
    }
    at: usize = 0
    negative: bool = false

    if text[0] == 45 {
        negative = true
        at = 1
    }

    if at == text.len { return invalid }
    coefficient: big.Big = big.from_u64(0)
    fractional: int = 0
    significant: int = 0
    seen_nonzero: bool = false
    seen_dot: bool = false
    seen_digit: bool = false

    for at < text.len {
        c: u8 = text[at]

        if c >= '0' && c <= '9' {
            seen_digit = true
            big.multiply_small(&coefficient, 10)
            big.add_small(&coefficient, u32(c - 48))

            if seen_dot { fractional += 1 }
            if c != 48 || seen_nonzero {
                seen_nonzero = true
                significant += 1
            }
            at += 1
            continue
        }

        if c == '.' && !seen_dot {
            seen_dot = true
            at += 1
            continue
        }
        break
    }

    if !seen_digit { return invalid }
    explicit: int = 0

    if at < text.len && (text[at] == 101 || text[at] == 69) {
        at += 1
        exponent_negative: bool = false

        if at < text.len && (text[at] == 43 || text[at] == 45) {
            exponent_negative = text[at] == 45
            at += 1
        }
        exponent_digits: int = 0

        for at < text.len && text[at] >= 48 && text[at] <= 57 {
            if explicit < 10000 { explicit = explicit * 10 + int(text[at] - 48) }
            exponent_digits += 1
            at += 1
        }

        if exponent_digits == 0 { return invalid }
        if exponent_negative { explicit = 0 - explicit }
    }

    if at != text.len { return invalid }
    return Decimal {
        coefficient = coefficient,
        exponent10 = explicit - fractional,
        negative = negative,
        digits = significant,
        number_type = 0,
    }
}

compare_binary(value: Decimal, mantissa: u64, exponent2: int): int {
    left: big.Big = value.coefficient
    right: big.Big = big.from_u64(mantissa)
    left_exponent: int = 0
    right_exponent: int = exponent2

    if value.exponent10 >= 0 {
        big.multiply_power5(&left, value.exponent10)
        left_exponent = value.exponent10
    } else {
        scale: int = 0 - value.exponent10
        big.multiply_power5(&right, scale)
        right_exponent += scale
    }

    if left_exponent < right_exponent {
        big.shift_left(&right, right_exponent - left_exponent)
    } else if right_exponent < left_exponent {
        big.shift_left(&left, left_exponent - right_exponent)
    }
    return big.compare(left, right)
}

decode64(raw: u64): (u64, int) {
    exponent: u64 = (raw >> 52) & u64(0x7FF)
    fraction: u64 = raw & u64(0xFFFFFFFFFFFFF)

    if exponent == 0 { return fraction, -1074 }
    return fraction | u64(0x10000000000000), int(exponent) - 1023 - 52
}

decode32(raw: u32): (u64, int) {
    exponent: u32 = (raw >> 23) & u32(0xFF)
    fraction: u32 = raw & u32(0x7FFFFF)

    if exponent == 0 { return u64(fraction), -149 }
    return u64(fraction | u32(0x800000)), int(exponent) - 127 - 23
}

midpoint64(value: Decimal, upper: u64): int {
    mantissa: u64, exponent2: int = decode64(upper)
    exponent_field: u64 = (upper >> 52) & u64(0x7FF)

    if exponent_field > 1 && (upper & u64(0xFFFFFFFFFFFFF)) == 0 {
        return compare_binary(value, u64(0x3FFFFFFFFFFFFF), exponent2 - 2)
    }
    return compare_binary(value, mantissa * 2 - 1, exponent2 - 1)
}

midpoint32(value: Decimal, upper: u32): int {
    mantissa: u64, exponent2: int = decode32(upper)
    exponent_field: u32 = (upper >> 23) & u32(0xFF)

    if exponent_field > 1 && (upper & u32(0x7FFFFF)) == 0 {
        return compare_binary(value, u64(0x1FFFFFF), exponent2 - 2)
    }
    return compare_binary(value, mantissa * 2 - 1, exponent2 - 1)
}

pub binary64(text: string): (f64, bool) {
    scanned: FastDecimal
    scanned.coefficient = 0
    scanned.exponent10 = 0
    scanned.negative = false
    scanned.digits = 0
    scanned.number_type = 3
    fast_decimal(text, &scanned)

    if scanned.number_type == 2 { return bitcast(f64, u64(0x7FF8000000000000)), true }
    if scanned.number_type == 1 {
        raw_inf: u64 = u64(0x7FF0000000000000)

        if scanned.negative { raw_inf |= u64(0x8000000000000000) }
        return bitcast(f64, raw_inf), true
    }
    if scanned.number_type == 3 { return 0.0, false }
    sign: u64 = 0

    if scanned.negative { sign = u64(0x8000000000000000) }
    if scanned.digits <= 19 {
        raw: u64 = 0
        handled: bool = fast.exact64(scanned.coefficient, scanned.exponent10, &raw)
        if !handled { handled = fast.small_integer(scanned.coefficient, scanned.exponent10, 52, 1023, &raw) }
        if !handled { handled = fast.binary64(scanned.coefficient, scanned.exponent10, &raw) }
        if handled {
            if raw == u64(0x7FF0000000000000) { return 0.0, false }
            return bitcast(f64, sign | raw), true
        }
    }
    value: Decimal = decimal(text)
    if value.digits == 0 || value.digits + value.exponent10 < -350 { return bitcast(f64, sign), true }
    if value.digits + value.exponent10 > 310 ||
       compare_binary(value, u64(0x3FFFFFFFFFFFFF), 970) >= 0 {
        return 0.0, false
    }

    low: u64 = 0
    high: u64 = u64(0x7FEFFFFFFFFFFFFF)

    for low < high {
        middle: u64 = low + (high - low) / 2 + 1
        mantissa: u64, exponent2: int = decode64(middle)

        if compare_binary(value, mantissa, exponent2) >= 0 {
            low = middle
        } else {
            high = middle - 1
        }
    }
    mantissa: u64, exponent2: int = decode64(low)

    if compare_binary(value, mantissa, exponent2) != 0 {
        upper: u64 = low + 1
        midpoint: int = midpoint64(value, upper)
        if midpoint > 0 || (midpoint == 0 && (upper & 1) == 0) { low = upper }
    }
    return bitcast(f64, sign | low), true
}

pub binary32(text: string): (f32, bool) {
    scanned: FastDecimal
    scanned.coefficient = 0
    scanned.exponent10 = 0
    scanned.negative = false
    scanned.digits = 0
    scanned.number_type = 3
    fast_decimal(text, &scanned)

    if scanned.number_type == 2 { return bitcast(f32, u32(0x7FC00000)), true }
    if scanned.number_type == 1 {
        raw_inf: u32 = u32(0x7F800000)

        if scanned.negative { raw_inf |= u32(0x80000000) }
        return bitcast(f32, raw_inf), true
    }
    if scanned.number_type == 3 { return 0.0, false }
    sign: u32 = 0

    if scanned.negative { sign = u32(0x80000000) }
    if scanned.digits <= 19 {
        wide_raw: u64 = 0
        handled: bool = fast.exact32(scanned.coefficient, scanned.exponent10, &wide_raw)
        if !handled { handled = fast.small_integer(scanned.coefficient, scanned.exponent10, 23, 127, &wide_raw) }
        if !handled { handled = fast.binary32(scanned.coefficient, scanned.exponent10, &wide_raw) }
        if handled {
            raw: u32 = u32(wide_raw)
            if raw == u32(0x7F800000) { return 0.0, false }

            return bitcast(f32, sign | raw), true
        }
    }
    value: Decimal = decimal(text)
    if value.digits == 0 || value.digits + value.exponent10 < -60 { return bitcast(f32, sign), true }
    if value.digits + value.exponent10 > 50 ||
       compare_binary(value, u64(0x1FFFFFF), 103) >= 0 {
        return 0.0, false
    }

    low: u32 = 0
    high: u32 = u32(0x7F7FFFFF)

    for low < high {
        middle: u32 = low + (high - low) / 2 + 1
        mantissa: u64, exponent2: int = decode32(middle)

        if compare_binary(value, mantissa, exponent2) >= 0 {
            low = middle
        } else {
            high = middle - 1
        }
    }
    mantissa: u64, exponent2: int = decode32(low)

    if compare_binary(value, mantissa, exponent2) != 0 {
        upper: u32 = low + 1
        midpoint: int = midpoint32(value, upper)
        if midpoint > 0 || (midpoint == 0 && (upper & 1) == 0) { low = upper }
    }
    return bitcast(f32, sign | low), true
}
