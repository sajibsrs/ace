/* Blocking, single-connection-at-a-time HTTP/1.1 server core. */

import ascii
import mem
import net
import sys
import tcp
import message: "./message.ace"
import parsing: "./parsing.ace"
import routing: "./router.ace"

ServerErr: error {
    1: capacity = "malformed or unresolvable endpoint"
}

Header: type = message.Header
Request: type = message.Request
Response: type = message.Response
FormatErr: type = message.FormatErr
Router: type = routing.Router
RequestParser: type = parsing.RequestParser
RequestPhase: type = parsing.RequestPhase
RequestFraming: type = parsing.RequestFraming
RequestCapacity: type = parsing.RequestCapacity
RequestResult: type = parsing.RequestResult
RequestProgress: type = parsing.RequestProgress

/* Owns the buffers a `serve` loop reads requests into and writes responses
 * from, growing each one via `mem.adjust` as connections demand, plus the
 * listen backlog `serve` binds with. Buffers start empty; there is no size
 * cap.
 */
pub Context: struct {
    input: mut []u8 = null,
    headers: mut []Header = null,
    body: mut []u8 = null,
    output: mut []u8 = null,
    backlog: usize = 512,
}

pub context_new(): Context {
    return Context{}
}

/* Releases buffer storage. Call once the context is no longer served. */
pub context_wipe(mut context: Context) {
    mem.release[u8](mut context.input)
    mem.release[Header](mut context.headers)
    mem.release[u8](mut context.body)
    mem.release[u8](mut context.output)
}

/* Reads exactly one complete request from `conn` into `context`, growing its
 * `input`/`headers`/`body` buffers via `mem.adjust` as the request demands.
 * The second result is false on EOF, mid-read disconnect, allocation
 * failure, or parse failure — in every such case the caller responds to
 * nothing and just returns.
 */
read_request(conn: tcp.Conn, mut context: Context): (Request, bool) {
    parser: RequestParser = RequestParser {phase = RequestPhase.request, framing = RequestFraming.undecided}
    occupied: usize = 0
    parse_pending: bool = false

    for {
        if !parse_pending {
            if occupied == context.input.len {
                grown: mut []u8, ok: bool = mem.adjust[u8](context.input, context.input.len + 1)
                if !ok {
                    return Request{method = null, target = null}, false
                }
                context.input = grown

                /* Header and target views point into input. Reparse the
                 * retained bytes after a moving reallocation before
                 * exposing any views. */
                parser = RequestParser {phase = RequestPhase.request, framing = RequestFraming.undecided}
            }

            received: int, recv_err: Error = net.receive(conn.socket, mut context.input[occupied..])
            if recv_err != null {
                if recv_err.domain == typeid(net.ReceiveErr) && recv_err.code == sys.EINTR {
                    continue
                }
                return Request{method = null, target = null}, false
            }
            if received == 0 {
                return Request{method = null, target = null}, false
            }
            occupied += usize(received)
        }
        parse_pending = false

        result: RequestResult = mut parser.parse(context.input[..occupied], mut context.headers[..], mut context.body[..], false)
        switch result {
            RequestResult.complete(request: Request) {
                return request, true
            }
            RequestResult.progress(value: RequestProgress) {}
            RequestResult.capacity(kind: RequestCapacity) {
                if kind == RequestCapacity.headers {
                    grown: mut []Header, ok: bool = mem.adjust[Header](context.headers, context.headers.len + 1)
                    if !ok {
                        return Request{method = null, target = null}, false
                    }
                    context.headers = grown
                } else {
                    needed: usize = parser.body_count + (occupied - parser.input_offset)
                    if parser.framing == RequestFraming.content_length {
                        needed = parser.content_length
                    } else if parser.framing == RequestFraming.chunked {
                        needed = parser.body_count + parser.chunk_remaining
                    }
                    grown: mut []u8, ok: bool = mem.adjust[u8](context.body, needed)
                    if !ok {
                        return Request{method = null, target = null}, false
                    }
                    context.body = grown
                }
                parse_pending = true
            }
            else {
                return Request{method = null, target = null}, false
            }
        }
    }
}

/* Writes `response` with a synthesized `Connection: close` (a handler-
 * supplied one is dropped along with the connection either way), growing
 * `context.headers`/`context.output` via `mem.adjust` as needed. A format
 * failure other than a capacity shortfall just skips the write; the caller
 * closes the connection regardless.
 */
respond_close(conn: tcp.Conn, response: Response, mut context: Context) {
    for i: usize in 0 .. response.headers.len {
        if ascii.is_equal(response.headers[i].name, "connection", false) {
            return
        }
    }
    needed: usize = response.headers.len + 1
    if needed > context.headers.len {
        grown: mut []Header, ok: bool = mem.adjust[Header](context.headers, needed)
        if !ok {
            return
        }
        context.headers = grown
    }
    for i: usize in 0 .. response.headers.len {
        context.headers[i] = response.headers[i]
    }
    context.headers[response.headers.len] = Header {name = "Connection", value = "close"}
    outgoing: Response = Response {
        version_minor = response.version_minor,
        status = response.status,
        reason = response.reason,
        headers = context.headers[..needed],
        body = response.body,
    }
    count: usize, format_err: Error = outgoing.format(mut context.output[..])
    for format_err == FormatErr.capacity {
        grown: mut []u8, ok: bool = mem.adjust[u8](context.output, context.output.len + 1)
        if !ok {
            return
        }
        context.output = grown
        count, format_err = outgoing.format(mut context.output[..])
    }
    if format_err == null {
        tcp.send_all(conn, context.output[..count])
    }
}

/* Reads exactly one request from `conn` and writes `router`'s response. */
serve_one(conn: tcp.Conn, router: Router, mut context: Context) {
    request: Request, ok: bool = read_request(conn, mut context)
    if !ok {
        return
    }
    respond_close(conn, router.dispatch(request), mut context)
}

/* Resolves and binds `endpoint` with the given listen backlog, ready for a
 * caller's `tcp.accept` loop.
 */
listen_endpoint(endpoint: string, backlog: usize): (tcp.Listener, Error) {
    address: net.Addr4, parsed: bool = net.parse4(endpoint)
    if !parsed {
        return tcp.Listener{socket = net.Socket(0)}, ServerErr.capacity
    }
    listener: tcp.Listener, listen_err: Error = tcp.listen(address, backlog)
    return listener, listen_err
}

/* Blocking, single-connection-at-a-time HTTP/1.1 server: binds `endpoint`
 * with `context.backlog`, then loops forever accepting one connection,
 * reading exactly one request, dispatching it through `router`, writing the
 * response, and closing the connection — no poll queue, no session table.
 * `context` owns the buffers used across every connection, growing them via
 * `mem.adjust` as requests demand; wipe it with `context_wipe` once the
 * server is no longer served. Returns only if the listener itself cannot be
 * created; a per-connection failure just drops that connection and the loop
 * continues.
 */
pub serve(endpoint: string, mut context: Context, router: Router): Error {
    listener: tcp.Listener, listen_err: Error = listen_endpoint(endpoint, context.backlog)
    if listen_err != null {
        return listen_err
    }

    for {
        conn: tcp.Conn, _: net.Addr4, accept_err: Error = tcp.accept(listener)
        if accept_err != null {
            continue
        }
        serve_one(conn, router, mut context)
        tcp.close(mut conn)
    }
}
