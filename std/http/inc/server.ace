/* Blocking, single-connection-at-a-time HTTP/1.1 server core. */

import ascii
import net
import sys
import tcp
import message: "./format.ace"
import parsing: "./parse.ace"
import routing: "./router.ace"

ServerErr: error {
    1: capacity = "malformed or unresolvable endpoint"
}

Header: type = message.Header
Request: type = message.Request
Response: type = message.Response
Router: type = routing.Router
RequestParser: type = parsing.RequestParser
RequestPhase: type = parsing.RequestPhase
RequestFraming: type = parsing.RequestFraming
RequestResult: type = parsing.RequestResult
RequestProgress: type = parsing.RequestProgress

BACKLOG: const usize = 512
INPUT_SIZE: const usize = 8192
MAX_HEADERS: const usize = 64
BODY_SIZE: const usize = 262144
OUTPUT_SIZE: const usize = 262144

/* Reads exactly one complete request from `conn` into `input`/`headers`/
 * `body`. The second result is false on EOF, mid-read disconnect, oversized
 * request, or parse failure — in every such case the caller responds to
 * nothing and just returns.
 */
read_request(conn: tcp.Conn, input: mut []u8, headers: mut []Header, body: mut []u8): (Request, bool) {
    parser: RequestParser = RequestParser {phase = RequestPhase.request, framing = RequestFraming.undecided}
    occupied: usize = 0

    for occupied < input.len {
        received: int, recv_err: Error = net.receive(conn.socket, input[occupied..])
        if recv_err != null {
            if recv_err.domain == typeid(net.ReceiveErr) && recv_err.code == sys.EINTR {
                continue
            }
            return Request{method = null, target = null}, false
        }
        if received == 0 {
            return Request{method = null, target = null}, false
        }
        occupied += usize(received)

        result: RequestResult = mut parser.parse(input[..occupied], headers, body, false)
        switch result {
            RequestResult.complete(request: Request) {
                return request, true
            }
            RequestResult.progress(value: RequestProgress) {}
            else {
                return Request{method = null, target = null}, false
            }
        }
    }
    return Request{method = null, target = null}, false
}

/* Writes `response` with a synthesized `Connection: close` (a handler-
 * supplied one is dropped along with the connection either way). Too many
 * headers to add the close header, or a format failure, just skips the write;
 * the caller closes the connection regardless.
 */
respond_close(conn: tcp.Conn, response: Response, headers: mut []Header, output: mut []u8) {
    for i: usize in 0 .. response.headers.len {
        if ascii.is_equal(response.headers[i].name, "connection", false) {
            return
        }
    }
    needed: usize = response.headers.len + 1
    if needed > headers.len {
        return
    }
    for i: usize in 0 .. response.headers.len {
        headers[i] = response.headers[i]
    }
    headers[response.headers.len] = Header {name = "Connection", value = "close"}
    outgoing: Response = Response {
        version_minor = response.version_minor,
        status = response.status,
        reason = response.reason,
        headers = headers[..needed],
        body = response.body,
    }
    count: usize, format_err: Error = outgoing.format(output)
    if format_err == null {
        tcp.send_all(conn, output[..count])
    }
}

/* Reads exactly one request from `conn` and writes `handle`'s response. */
serve_one(conn: tcp.Conn, handle: (Request): Response,
    input: mut []u8, headers: mut []Header, body: mut []u8, output: mut []u8) {

    request: Request, ok: bool = read_request(conn, input, headers, body)
    if !ok {
        return
    }
    respond_close(conn, handle(request), headers, output)
}

/* Reads exactly one request from `conn` and writes `router`'s response. */
serve_one_router(conn: tcp.Conn, router: Router,
    input: mut []u8, headers: mut []Header, body: mut []u8, output: mut []u8) {

    request: Request, ok: bool = read_request(conn, input, headers, body)
    if !ok {
        return
    }
    respond_close(conn, router.dispatch(request), headers, output)
}

/* Resolves and binds `endpoint`, ready for a caller's `tcp.accept` loop. */
listen_endpoint(endpoint: string): (tcp.Listener, Error) {
    address: net.Addr4, parsed: bool = net.parse4(endpoint)
    if !parsed {
        return tcp.Listener{socket = net.Socket(0)}, ServerErr.capacity
    }
    listener: tcp.Listener, listen_err: Error = tcp.listen(address, BACKLOG)
    return listener, listen_err
}

/* Blocking, single-connection-at-a-time HTTP/1.1 server: binds `endpoint`,
 * then loops forever accepting one connection, reading exactly one request,
 * calling `handle`, writing its response, and closing it — no poll queue, no
 * session table, and no caller-visible backlog or capacity tuning. Returns
 * only if the listener itself cannot be created; a per-connection failure
 * just drops that connection and the loop continues.
 */
pub serve(endpoint: string, handle: (Request): Response): Error {
    listener: tcp.Listener, listen_err: Error = listen_endpoint(endpoint)
    if listen_err != null {
        return listen_err
    }

    input: [INPUT_SIZE]u8
    headers: [MAX_HEADERS]Header
    body: [BODY_SIZE]u8
    output: [OUTPUT_SIZE]u8

    for {
        conn: tcp.Conn, _: net.Addr4, accept_err: Error = tcp.accept(listener)
        if accept_err != null {
            continue
        }
        serve_one(conn, handle, mut input[..], mut headers[..], mut body[..], mut output[..])
        tcp.close(mut conn)
    }
}

/* Same as `serve(endpoint, handle)`, dispatching each request through
 * `router`'s registered routes instead of a single bare handler.
 */
pub serve(endpoint: string, router: Router): Error {
    listener: tcp.Listener, listen_err: Error = listen_endpoint(endpoint)
    if listen_err != null {
        return listen_err
    }

    input: [INPUT_SIZE]u8
    headers: [MAX_HEADERS]Header
    body: [BODY_SIZE]u8
    output: [OUTPUT_SIZE]u8

    for {
        conn: tcp.Conn, _: net.Addr4, accept_err: Error = tcp.accept(listener)
        if accept_err != null {
            continue
        }
        serve_one_router(conn, router, mut input[..], mut headers[..], mut body[..], mut output[..])
        tcp.close(mut conn)
    }
}
