/* Shared plaintext HTTP transport and exchange machinery. */

import mem
import net
import tcp
import str
import secure: "../tls.ace"
import message: "./format.ace"
import parsing: "./parse.ace"

pub Header: type = message.Header
pub Request: type = message.Request
pub Response: type = message.Response
pub ResponseParser: type = parsing.ResponseParser
pub ResponseResult: type = parsing.ResponseResult
pub ResponsePhase: type = parsing.ResponsePhase
pub ResponseFraming: type = parsing.ResponseFraming
pub ResponseCapacity: type = parsing.ResponseCapacity
pub ResponseProgress: type = parsing.ResponseProgress
pub Url: type = parsing.Url
pub UrlErr: type = parsing.UrlErr

pub TlsConfig: struct {
    trust_anchor: []u8 = null,
}

FormatErr: type = message.FormatErr
method_get: const string = message.method_get

pub ClientErr: error {
    1: address = "no usable address was resolved"
    2: target_capacity = "request-target storage is too small"
    3: response = "response parsing or storage failed"
    4: allocation = "memory allocation failed"
}

pub Storage: struct {
    addresses: mut []net.Addr4,
    output: mut []u8,
    target: mut []u8,
    input: mut []u8,
    headers: mut []Header,
    body: mut []u8,
    url: mut []u8 = null,
    tls_context: mut []u8 = null,
    tls_records: mut []u8 = null,
}

/* Adjusts `slice` to at least `needed` elements, doubling its length when that
 * is larger. A null slice allocates. On allocation failure or count overflow
 * the caller's slice is returned unchanged with false; the original stays
 * live, so check the flag before replacing the caller's slice.
 */
pub mem_adjust[T](slice: mut []T, needed: usize): (mut []T, bool) {
    if slice.len >= needed { return slice, true }
    capacity: usize = slice.len * 2
    if capacity < slice.len { return slice, false }
    if capacity < needed { capacity = needed }
    if capacity == 0 { capacity = 1 }
    if slice == null {
        fresh: mut []T = mem.alloc[T](capacity)
        if fresh == null {
            return slice, false
        }
        return fresh, true
    }
    bigger: mut []T = mem.realloc[T](slice, capacity)
    if bigger == null { return slice, false }
    return bigger, true
}

pub connect_url(parsed: Url, mut storage: Storage, resize: bool): (tcp.Conn, Error) {
    zero: tcp.Conn = tcp.Conn {
        socket = net.Socket(0),
        interest = tcp.Interest.none,
        send_offset = usize(0),
    }
    if resize {
        mem_addresses: mut []net.Addr4, addr_ok: bool = mem_adjust[net.Addr4](storage.addresses, 4)
        if !addr_ok { return zero, ClientErr.allocation }
        storage.addresses = mem_addresses
    }

    count: usize, resolve_err: Error = net.resolve4(parsed.host, parsed.port, mut storage.addresses[..])
    if resolve_err != null { return zero, resolve_err }
    if count == 0 { return zero, ClientErr.address }

    conn: tcp.Conn = tcp.Conn {
        socket = net.Socket(0),
        interest = tcp.Interest.none,
        send_offset = usize(0),
    }

    conn_err: Error = ClientErr.address
    is_connected: bool = false
    for i: usize in 0 .. count {
        conn, conn_err = tcp.connect(storage.addresses[i])
        if conn_err == null {
            is_connected = true
            break
        }
    }
    if !is_connected { return zero, conn_err }
    return conn, null
}

tcp_receive(connection: tcp.Conn, destination: mut []u8): (int, Error) {
    count: int, err: Error = net.receive(connection.socket, destination)
    return count, err
}

pub exchange[C](connection: C, raw: tcp.Conn,
    send: (C, []u8): (usize, Error),
    receive: (C, mut []u8): (int, Error),
    parsed: Url, mut storage: Storage, resize: bool): (Response, Error) {

    /* The request target is known exactly: size to fit before writing. */
    target_parts: [2]string = [parsed.path, parsed.query]
    if resize {
        mem_target: mut []u8, target_ok: bool = mem_adjust[u8](storage.target, parsed.path.len + parsed.query.len)
        if !target_ok {
            tcp.close(mut raw)
            return Response{}, ClientErr.allocation
        }
        storage.target = mem_target
    }
    target_count: usize, fit: bool = str.concat(target_parts[..], mut storage.target[..])
    if !fit {
        tcp.close(mut raw)
        return Response{}, ClientErr.target_capacity
    }

    fields: [2]Header = [
        Header {name = "Host", value = parsed.host},
        Header {name = "Connection", value = "close"},
    ]
    request: Request = Request {
        method = method_get,
        target = storage.target[..target_count],
        headers = fields[..],
    }

    output_count: usize, format_err: Error = request.format(mut storage.output[..])
    for resize && format_err == FormatErr.capacity {
        mem_output: mut []u8, output_ok: bool = mem_adjust[u8](storage.output, storage.output.len + 1)
        if !output_ok {
            tcp.close(mut raw)
            return Response{}, ClientErr.allocation
        }
        storage.output = mem_output
        output_count, format_err = request.format(mut storage.output[..])
    }
    if format_err != null {
        tcp.close(mut raw)
        return Response{}, format_err
    }

    _: usize, send_err: Error = send(connection, storage.output[..output_count])
    if send_err != null {
        tcp.close(mut raw)
        return Response{}, send_err
    }

    occupied: usize = 0
    parser: ResponseParser = ResponseParser {
        phase = ResponsePhase.status,
        framing = ResponseFraming.undecided,
    }
    parse_pending: bool = false
    eof: bool = false

    for {
        if !parse_pending {
            if occupied == storage.input.len {
                if !resize {
                    tcp.close(mut raw)
                    return Response{}, ClientErr.response
                }
                mem_input: mut []u8, input_ok: bool = mem_adjust[u8](storage.input, storage.input.len + 1)
                if !input_ok {
                    tcp.close(mut raw)
                    return Response{}, ClientErr.allocation
                }
                storage.input = mem_input

                /* Header views point into input. Reparse the retained bytes
                 * after a moving reallocation before exposing any views.
                 */
                parser = ResponseParser {
                    phase = ResponsePhase.status,
                    framing = ResponseFraming.undecided,
                }
            }

            received: int
            received, recv_err: Error = receive(connection, mut storage.input[occupied..])
            if recv_err != null {
                tcp.close(mut raw)
                return Response{}, recv_err
            }
            occupied += usize(received)
            eof = received == 0
        }
        parse_pending = false

        result: ResponseResult = mut parser.parse(
            storage.input[..occupied],
            mut storage.headers[..],
            mut storage.body[..],
            eof,
            false,
        )

        switch result {
            ResponseResult.complete(response: Response) {
                tcp.close(mut raw)
                return response, null
            }
            ResponseResult.progress(value: ResponseProgress) {}
            ResponseResult.capacity(kind: ResponseCapacity) {
                if !resize {
                    tcp.close(mut raw)
                    return Response{}, ClientErr.response
                }
                if kind == ResponseCapacity.headers {
                    mem_headers: mut []Header, headers_ok: bool = mem_adjust[Header](storage.headers, storage.headers.len + 1)
                    if !headers_ok {
                        tcp.close(mut raw)
                        return Response{}, ClientErr.allocation
                    }
                    storage.headers = mem_headers
                } else {
                    /* Body size is exact when the response states its length;
                     * otherwise adjust by the pending bytes, doubled. */
                    needed: usize = parser.body_count + (occupied - parser.input_offset)
                    if parser.framing == ResponseFraming.content_length {
                        needed = parser.content_length
                    } else if parser.framing == ResponseFraming.chunked {
                        needed = parser.body_count + parser.chunk_remaining
                    }
                    mem_body: mut []u8, body_ok: bool = mem_adjust[u8](storage.body, needed)
                    if !body_ok {
                        tcp.close(mut raw)
                        return Response{}, ClientErr.allocation
                    }
                    storage.body = mem_body
                }
                parse_pending = true
            }
            else {
                tcp.close(mut raw)
                return Response{}, ClientErr.response
            }
        }
    }
}

pub get_with_storage(url: string, mut storage: Storage, resize: bool): (Response, Error) {
    parsed: Url, url_err: Error = parsing.parse_url_for(url, false)
    if url_err != null { return Response{}, url_err }
    connection: tcp.Conn, connect_err: Error = connect_url(parsed, mut storage, resize)
    if connect_err != null { return Response{}, connect_err }
    response: Response, err: Error = exchange[tcp.Conn](connection, connection,
        tcp.send_all, tcp_receive, parsed, mut storage, resize)
    return response, err
}

@extern("tls")
pub get_with_storage(url: string, config: TlsConfig, mut storage: Storage, resize: bool): (Response, Error) {
    parsed: Url, url_err: Error = parsing.parse_url_for(url, true)
    if url_err != null { return Response{}, url_err }
    if resize {
        if storage.tls_context == null {
            storage.tls_context = mem.alloc(int(secure.context_size()),
                int(secure.context_align()))
            if storage.tls_context == null { return Response{}, ClientErr.allocation }
        }
        mem_records: mut []u8, records_ok: bool = mem_adjust[u8](
            storage.tls_records, secure.record_size())
        if !records_ok { return Response{}, ClientErr.allocation }
        storage.tls_records = mem_records
    }
    connection: tcp.Conn, connect_err: Error = connect_url(parsed, mut storage, resize)
    if connect_err != null { return Response{}, connect_err }
    secured: secure.Conn, tls_err: Error = secure.connect(connection, parsed.host,
        config.trust_anchor, secure.Storage {
            context = storage.tls_context,
            records = storage.tls_records,
        })
    if tls_err != null {
        tcp.close(mut connection)
        return Response{}, tls_err
    }
    response: Response, err: Error = exchange[secure.Conn](secured, connection,
        secure.send_all, secure.receive, parsed, mut storage, resize)
    return response, err
}
