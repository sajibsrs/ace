/* math — minimal pure-Ace numeric helpers.
 * sqrt, floor, and ceil are compiler-backed exact IEEE operations. exp, log, and pow are pure Ace,
 * within 1 ULP over the whole finite domain, and all three are table-driven over the same two
 * 128-entry tables in `math_tables`: a logarithm table of invc/log(c) and a table of 2^(j/128).
 * exp reduces by n*ln2/128, looks up 2^(j/128), and applies a fifth-degree correction; log splits
 * the exponent, takes log(c) from the table, and evaluates log1p of the exact residue r = z*invc - 1.
 * pow runs both halves back to back, carrying its logarithm as a high and low double because the
 * value must survive multiplication by the exponent; exp and log return one rounded double and so
 * keep only the single compensation term the cancelling add needs. The f32 pow overload is a
 * separate plain-f64 kernel over the same tables; the other f32 overloads round the f64 result.
 */

import bits
import table: @math_tables

pub sqrt(value: f64): f64 intrinsic
pub sqrt(value: f32): f32 intrinsic

pub floor(value: f64): f64 intrinsic
pub floor(value: f32): f32 intrinsic

pub ceil(value: f64): f64 intrinsic
pub ceil(value: f32): f32 intrinsic

pub fma(a: f64, b: f64, c: f64): f64 intrinsic
pub fma(a: f32, b: f32, c: f32): f32 intrinsic

EXP_OVERFLOW: const f64 = 7.09782712893383973096e+02
EXP_UNDERFLOW: const f64 = -7.45133219101941108420e+02

PIO4: const f64 = 7.85398163397448278999e-01
SMALL_ARGUMENT: const f64 = 7.450580596923828125e-09
MEDIUM_LIMIT: const f64 = 1647099.0
INV_PIO2: const f64 = 6.36619772367581382433e-01
PIO2_1: const f64 = 1.57079632673412561417e+00
PIO2_1T: const f64 = 6.07710050650619224932e-11
PIO2_2: const f64 = 6.07710050630396597660e-11
PIO2_2T: const f64 = 2.02226624879595063154e-21
PIO2_3: const f64 = 2.02226624871116645580e-21
PIO2_3T: const f64 = 8.47842766036889956997e-32
PIO2_A: const f64 = 1.5707963267948966
PIO2_B: const f64 = 6.123233995736766e-17

SIN_S1: const f64 = -1.66666666666666324348e-01
SIN_S2: const f64 = 8.33333333332248946124e-03
SIN_S3: const f64 = -1.98412698298579493134e-04
SIN_S4: const f64 = 2.75573137070700676789e-06
SIN_S5: const f64 = -2.50507602534068634195e-08
SIN_S6: const f64 = 1.58969099521155010221e-10

COS_C1: const f64 = 4.16666666666666019037e-02
COS_C2: const f64 = -1.38888888888741095749e-03
COS_C3: const f64 = 2.48015872894767294178e-05
COS_C4: const f64 = -2.75573143513906633035e-07
COS_C5: const f64 = 2.08757232129817482790e-09
COS_C6: const f64 = -1.13596475577881948265e-11

// Logarithm reduction over the `math_tables` log table, shared by log and pow: x = 2^k * z with z
// in [OFF, 2*OFF); LOG_HIGH32 splits z for pow's exact product; C3..C10 carry log1p(r) - r + r^2/2
// from r^3, of which log needs only C3..C8.
LOG_OFF: const i64 = 4604666736195665920
LOG_HIGH32: const u64 = 0xFFFFFFFF00000000
LOG_LN2: const f64 = 6.931471805599453e-01
LOG_LN2_HI: const f64 = 6.931471805592082e-01
LOG_LN2_LO: const f64 = 7.371002565167799e-13
LOG_C3: const f64 = 0.3333333333333333
LOG_C4: const f64 = -0.25
LOG_C5: const f64 = 0.2
LOG_C6: const f64 = -0.16666666666666666
LOG_C7: const f64 = 0.14285714285714285
LOG_C8: const f64 = -0.125
LOG_C9: const f64 = 0.1111111111111111
LOG_C10: const f64 = -0.1
// 52 * 2^52: lowers a bit pattern's exponent field by 52 after scaling a subnormal by 2^52.
LOG_SUB_OFF: const i64 = 234187180623265792

// Exponential reduction over the `math_tables` 2^(j/128) table, shared by exp and pow: n = 128*k + j
// is the argument times INV_LN2N, rounded by adding SHIFT and read back through SHIFT_BITS;
// C3..C5 carry exp(r) - 1 - r - r^2/2 from r^3. EXP_LN2_N serves pow's shorter f32 kernel.
EXP_INV_LN2N: const f64 = 184.6649652337873
EXP_LN2_N: const f64 = 0.005415212348111709
EXP_NEG_LN2_HI_N: const f64 = -0.005415212347998022
EXP_NEG_LN2_LO_N: const f64 = -1.2655086083325438e-13
EXP_SHIFT: const f64 = 6755399441055744.0
EXP_SHIFT_BITS: const i64 = 4843621399236968448
EXP_C3: const f64 = 0.16666666666666666
EXP_C4: const f64 = 0.041666666666666664
EXP_C5: const f64 = 0.008333333333333333
EXP_LIMIT: const f64 = 745.2
// 1023 << 52: the bit-pattern bias for a 2^1023 scale.
EXP_TOP: const i64 = 4607182418800017408

// Plain powers of two, the magnitude mask, and the sign bit only pow needs.
TWO_52: const f64 = 4503599627370496.0
TWO_M60: const f64 = 8.673617379884035e-19
ABS_BITS: const u64 = 0x7FFFFFFFFFFFFFFF
INF_BITS: const u64 = 0x7FF0000000000000
POW_SIGN: const u64 = 0x8000000000000000

pub isnan(value: f64): bool {
    raw: u64 = bits.cast(value)
    exponent: u64 = raw & u64(0x7FF0000000000000)
    fraction: u64 = raw & u64(0x000FFFFFFFFFFFFF)
    return exponent == u64(0x7FF0000000000000) && fraction != 0
}

pub isnan(value: f32): bool {
    raw: u32 = bits.cast(value)
    exponent: u32 = raw & u32(0x7F800000)
    fraction: u32 = raw & u32(0x007FFFFF)
    return exponent == u32(0x7F800000) && fraction != 0
}

pub isinf(value: f64): bool {
    raw: u64 = bits.cast(value)
    magnitude: u64 = raw & u64(0x7FFFFFFFFFFFFFFF)
    return magnitude == u64(0x7FF0000000000000)
}

pub isinf(value: f32): bool {
    raw: u32 = bits.cast(value)
    magnitude: u32 = raw & u32(0x7FFFFFFF)
    return magnitude == u32(0x7F800000)
}

pub isfinite(value: f64): bool {
    raw: u64 = bits.cast(value)
    exponent: u64 = raw & u64(0x7FF0000000000000)
    return exponent != u64(0x7FF0000000000000)
}

pub isfinite(value: f32): bool {
    raw: u32 = bits.cast(value)
    exponent: u32 = raw & u32(0x7F800000)
    return exponent != u32(0x7F800000)
}

pub min[T](a: T, b: T): T {
    if a < b { return a }
    return b
}

pub max[T](a: T, b: T): T {
    if a > b { return a }
    return b
}

pub abs[T](x: T): T {
    if x < 0 { return -x }
    return x
}

pub exp(value: f64): f64 {
    if isnan(value) { return value }
    if value > EXP_OVERFLOW { return bits.cast(u64(0x7FF0000000000000)) }
    if value < EXP_UNDERFLOW { return 0.0 }
    // exp(x) = 2^k * 2^(j/128) * exp(r), where n = 128*k + j is x*128/ln2 rounded and read out of
    // the shifted double, and r = x - n*ln2/128 with ln2/128 in two words, so |r| <= ln2/256.
    shifted: f64 = fma(value, EXP_INV_LN2N, EXP_SHIFT)
    n: i64 = i64(bits.cast(shifted)) - EXP_SHIFT_BITS
    r: f64 = fma(shifted - EXP_SHIFT, EXP_NEG_LN2_LO_N, fma(shifted - EXP_SHIFT, EXP_NEG_LN2_HI_N, value))
    r2: f64 = r * r
    j: u64 = u64(n) & 127
    // 2^(j/128) is the table's s * (1 + tail), so the whole factor is s * (1 + correction) with
    // correction = tail + r + r^2/2 + ... + r^5/120. The tail*r cross term is below 2^-62 relative.
    correction: f64 = fma(r2, fma(r, EXP_C3, 0.5), table.two_tail[j] + r) +
        (r2 * r2) * fma(r, EXP_C5, EXP_C4)
    power: i64 = n >> 7
    // -1022 is where the scale stops being a normal double, so this is the guard's own limit rather
    // than a borrowed one. Widening to it is output-identical to `pow_extreme`'s -1000: in between,
    // the result is still normal, so that path's closing multiply by 2^-1000 is an exact shift and
    // never a second rounding. Only a genuinely subnormal result rounds twice, and both spellings
    // send it below regardless.
    if power >= -1022 && power <= 1023 {
        scale: f64 = bits.cast(u64(i64(table.two_bits[j]) + (power << 52)))
        return fma(scale, correction, scale)
    }
    // Past 1023 only k == 1024 reaches here, just under the overflow limit: scale at 2^1023 and
    // double once, so the correction is applied while the scale is still a normal double.
    if power > 1023 {
        scale: f64 = bits.cast(u64(i64(table.two_bits[j]) + EXP_TOP))
        return fma(scale, correction, scale) * 2.0
    }
    // Subnormal result: scale in two exact steps so only the last one rounds.
    scale: f64 = bits.cast(u64(i64(table.two_bits[j]) + ((power + 1000) << 52)))
    return fma(scale, correction, scale) * bits.cast(u64(23) << 52)
}

pub exp(value: f32): f32 {
    return f32(exp(f64(value)))
}

pub log(value: f64): f64 {
    if isnan(value) { return value }
    if value < 0.0 { return bits.cast(u64(0x7FF8000000000000)) }
    if value == 0.0 { return -bits.cast(u64(0x7FF0000000000000)) }
    if isinf(value) { return value }
    // x = 2^k * z with z in [OFF, 2*OFF), k = offset >> 52 and z the bits in the shifted pattern;
    // i selects the table entry, c = 1/invc lies near z, and log(x) = k*ln2 + log(c) + log1p(r).
    xs: i64 = i64(bits.cast(value))
    if (bits.cast(value) >> 52) == 0 { xs = i64(bits.cast(value * TWO_52)) - LOG_SUB_OFF }
    offset: i64 = xs - LOG_OFF
    i: u64 = u64(offset >> 45) & 127
    // z*invc - 1 is representable exactly, so one fma carries r with no error at all.
    r: f64 = fma(bits.cast(u64(xs - (offset & -4503599627370496))), table.log[i].invc, -1.0)
    // k*ln2hi + logc is exact. Their sum with r cancels, so t loses up to half an ulp of itself;
    // (w - t) + r is that loss exactly, and carrying it is what keeps a single rounded double honest.
    w: f64 = f64(offset >> 52) * LOG_LN2_HI + table.log[i].logc
    t: f64 = w + r
    r2: f64 = r * r
    // log1p(r) - r as a series from r^2 to r^8: |r| <= 0.00585, so the r^9 term is below 2^-70.
    q: f64 = fma(
        r2 * r2,
        fma(r2, LOG_C8, fma(r, LOG_C7, LOG_C6)),
        fma(r2, fma(r, LOG_C5, LOG_C4), fma(r, LOG_C3, -0.5)),
    )
    return t + ((w - t + r) + (fma(f64(offset >> 52), LOG_LN2_LO, table.log[i].logctail) + r2 * q))
}

pub log(value: f32): f32 {
    return f32(log(f64(value)))
}

// Parity of the finite non-zero exponent with bits `raw`: 0 fractional, 1 odd, 2 even.
integer_parity(raw: u64): int {
    e: u64 = (raw >> 52) & 0x7FF
    if e < 0x3FF { return 0 }
    if e > 0x3FF + 52 { return 2 }
    unit: u64 = u64(1) << (0x3FF + 52 - e)
    if (raw & (unit - 1)) != 0 { return 0 }
    if (raw & unit) != 0 { return 1 }
    return 2
}

// A result of pow computed for |x|: negative when x is a negative base and y an odd integer.
pow_signed(magnitude: f64, flip: u64): f64 {
    if flip != 0 { return -magnitude }
    return magnitude
}

// Handles every operand pair the main path cannot: zero, infinite, NaN, negative, or subnormal x,
// and y so small or large that the answer is 1, 0, or infinity. Returns (done, result, magnitude
// bits of x as a signed integer, flip). When not done, the bits are those of |x| with a subnormal
// rescaled by 2^52 and its exponent field lowered by 52, so the field may go negative.
pow_special(x: f64, y: f64): (bool, f64, i64, u64) {
    ix: u64 = bits.cast(x)
    iy: u64 = bits.cast(y)
    ax: u64 = ix & ABS_BITS
    ay: u64 = iy & ABS_BITS
    one: u64 = 0x3FF0000000000000
    infinite: u64 = 0x7FF0000000000000
    infinity: f64 = bits.cast(infinite)
    // Zero exponent and a base of +1 give 1 whatever the other operand is, a NaN included.
    if ay == 0 || ix == one { return true, 1.0, 0, 0 }
    if ax > infinite || ay > infinite { return true, x + y, 0, 0 }
    grows: bool = ax > one
    y_positive: bool = (iy >> 63) == 0
    if ay == infinite {
        if ax == one { return true, 1.0, 0, 0 }
        if grows == y_positive { return true, infinity, 0, 0 }
        return true, 0.0, 0, 0
    }
    // y is finite and non-zero; a negative base needs its exponent's parity, and only an odd integer
    // exponent flips the sign.
    negative: bool = (ix >> 63) != 0
    parity: int = 0
    flip: u64 = 0
    if negative {
        parity = integer_parity(iy)
        if parity == 1 { flip = POW_SIGN }
    }
    if ax == 0 || ax == infinite {
        // A zero base gives 0 for y > 0 and infinity for y < 0; an infinite base the reverse.
        if (ax == 0) == y_positive { return true, pow_signed(0.0, flip), 0, 0 }
        return true, pow_signed(infinity, flip), 0, 0
    }
    // A finite negative base with a fractional exponent has no real power.
    if negative && parity == 0 { return true, bits.cast(u64(0x7FF8000000000000)), 0, 0 }
    // |y| < 2^-65 puts the result within 2^-54 of 1; |y| >= 2^63 overflows or underflows unless |x| = 1.
    ey: u64 = (iy >> 52) & 0x7FF
    if ax == one || ey < 0x3BE { return true, 1.0, 0, 0 }
    if ey >= 0x43E {
        if grows == y_positive { return true, infinity, 0, 0 }
        return true, 0.0, 0, 0
    }
    magnitude: i64 = i64(ax)
    if (ax >> 52) == 0 { magnitude = i64(bits.cast(bits.cast(ax) * TWO_52)) - LOG_SUB_OFF }
    return false, 0.0, magnitude, flip
}

// w * 2^n for an exponent too close to the ends of the range for the main path, which adds a
// correction scaled by 2^n and so needs that correction to be a normal double. Overflows for n > 1024;
// otherwise scales in two steps so w keeps its precision and only the last multiply can round into
// the subnormal range.
pow_extreme(w: f64, n: i64): f64 {
    if n > 1024 { return bits.cast(u64(0x7FF0000000000000)) }
    if n == 1024 { return (w * bits.cast(u64(2046) << 52)) * 2.0 }
    return (w * bits.cast(u64(n + 1083) << 52)) * TWO_M60
}

/* The body names as few locals as it can. A local that does not win one of the eight callee-saved
 * float registers costs a store where it is set and a load at every mention, so single-use values
 * stay nested in the expression that consumes them and cheap ones are recomputed rather than named.
 */
pub pow(x: f64, y: f64): f64 {
    ix: u64 = bits.cast(x)
    iy: u64 = bits.cast(y)
    // An exponent of 2, 1, -1, or 0.5 (a zero mantissa selects the powers of two) has a cheaper exact
    // form. Only a positive base takes the square root: pow(-0, 0.5) is +0 and pow(-inf, 0.5) is +inf.
    if (iy << 12) == 0 {
        if iy == 0x4000000000000000 { return x * x }
        if iy == 0x3FF0000000000000 { return x }
        if iy == 0xBFF0000000000000 { return 1.0 / x }
        if iy == 0x3FE0000000000000 && ix < 0x7FF0000000000000 { return sqrt(x) }
    }
    top_x: u64 = ix >> 52
    top_y: u64 = (iy >> 52) & 0x7FF
    xs: i64 = i64(ix)
    flip: u64 = 0
    if top_x < 1 || top_x >= 0x7FF || top_y < 0x3BE || top_y >= 0x43E {
        if top_x > 0x800 && top_x < 0xFFF && top_y >= 0x3BE && top_y < 0x43E {
            // A finite negative base and an ordinary exponent: only an integer exponent is defined, and
            // an odd one flips the sign. The units bit of y sits 0x433 - top_y places above bit 0.
            if top_y < 0x3FF { return bits.cast(u64(0x7FF8000000000000)) }
            if top_y <= 0x433 {
                if (iy & ((u64(1) << (0x433 - top_y)) - 1)) != 0 { return bits.cast(u64(0x7FF8000000000000)) }
                flip = (iy >> (0x433 - top_y)) << 63
            }
            xs = i64(ix & ABS_BITS)
        } else {
            done: bool, result: f64, magnitude: i64, sign: u64 = pow_special(x, y)
            if done { return result }

            xs = magnitude
            flip = sign
        }
    }

    // x = 2^k * z with z in [OFF, 2*OFF), k = offset >> 52 and z the bits in `scaled`; i selects the
    // table entry, c = 1/invc lies near z, and log(x) = k*ln2 + log(c) + log1p(r), with r = z*invc - 1
    // formed exactly as rhi + rlo from z's high 32 bits and the rest.
    offset: i64 = xs - LOG_OFF
    i: u64 = u64(offset >> 45) & 127
    scaled: u64 = u64(xs - (offset & -4503599627370496))
    invc: f64 = table.log[i].invc
    rhi: f64 = bits.cast((scaled + 2147483648) & LOG_HIGH32) * invc - 1.0
    rlo: f64 = (bits.cast(scaled) - bits.cast((scaled + 2147483648) & LOG_HIGH32)) * invc
    r: f64 = rhi + rlo
    // k*ln2 + logc is exact; each sum below keeps its rounding error in the low word.
    t1: f64 = f64(offset >> 52) * LOG_LN2_HI + table.log[i].logc
    t2: f64 = t1 + r
    // -r^2/2 = -rhi^2/2 + rlo * (-(r + rhi)/2), and rhi^2 is exact.
    hi: f64 = t2 + -0.5 * rhi * rhi
    r2: f64 = r * r
    // The last term is log1p(r) - r + r^2/2 as a series from r^3 to r^10.
    lo: f64 = (f64(offset >> 52) * LOG_LN2_LO + table.log[i].logctail) + (t1 - t2 + r) +
        rlo * (-0.5 * (r + rhi)) + (t2 - hi + -0.5 * rhi * rhi) +
        r2 * r * ((LOG_C3 + r * LOG_C4) + r2 * (LOG_C5 + r * LOG_C6) +
        r2 * r2 * ((LOG_C7 + r * LOG_C8) + r2 * (LOG_C9 + r * LOG_C10)))
    log_hi: f64 = hi + lo

    // y * log(x) as e_hi + e_lo. fma gives the product's rounding error exactly, so neither operand
    // needs splitting into halves; e_lo also takes the logarithm's low word, hi - log_hi + lo, and is
    // formed in er below, its only use.
    e_hi: f64 = y * log_hi

    // exp(e_hi + e_lo) = 2^e * 2^(j/128) * exp(er), where n = 128*e + j is e_hi/ln2*128 rounded and
    // |er| <= ln2/256. Below 2^-54 the answer rounds to 1; beyond +-745.2 it overflows or underflows.
    // flip holds the sign bit a negative base's odd exponent sets, so xoring it in negates the result.
    top_e: u64 = (bits.cast(e_hi) >> 52) & 0x7FF
    if top_e < 0x3C9 { return bits.cast(u64(0x3FF0000000000000) ^ flip) }
    if top_e >= 0x408 {
        if e_hi > EXP_LIMIT { return bits.cast(u64(0x7FF0000000000000) ^ flip) }
        if e_hi < -EXP_LIMIT { return bits.cast(flip) }
    }
    shifted: f64 = EXP_INV_LN2N * e_hi + EXP_SHIFT
    n: i64 = i64(bits.cast(shifted)) - EXP_SHIFT_BITS
    er: f64 = e_hi + (shifted - EXP_SHIFT) * EXP_NEG_LN2_HI_N +
        (shifted - EXP_SHIFT) * EXP_NEG_LN2_LO_N +
        (fma(y, log_hi, -e_hi) + y * (hi - log_hi + lo))
    j: u64 = u64(n) & 127
    power: i64 = n >> 7
    if power < -1000 || power > 1023 {
        s: f64 = bits.cast(table.two_bits[j])
        er2: f64 = er * er
        correction: f64 = table.two_tail[j] + er + er2 * (0.5 + er * EXP_C3) +
            er2 * er2 * (EXP_C4 + er * EXP_C5)
        return bits.cast(bits.cast(pow_extreme(s + s * correction, power)) ^ flip)
    }
    scale: f64 = bits.cast(u64(i64(table.two_bits[j]) + (power << 52)))
    return bits.cast(bits.cast(scale + scale * (table.two_tail[j] + er +
        er * er * (0.5 + er * EXP_C3) +
        (er * er) * (er * er) * (EXP_C4 + er * EXP_C5))) ^ flip)
}

// The f32 kernel needs only about 2^-30 relative accuracy, so it runs in plain f64: the same log table
// (no tail word), a series to r^5, and a degree-3 exponential; the final conversion rounds once, into
// the subnormal range or to infinity when the result leaves f32. Every f32 magnitude is a normal f64,
// so only zero, infinite, NaN, and negative bases and non-finite exponents take the f64 path.
pub pow(x: f32, y: f32): f32 {
    ix: u32 = bits.cast(x)
    iy: u32 = bits.cast(y)
    if (iy << 9) == 0 {
        if iy == 0x40000000 { return x * x }
        if iy == 0x3F800000 { return x }
        if iy == 0xBF800000 { return 1.0 / x }
        if iy == 0x3F000000 && ix < 0x7F800000 { return sqrt(x) }
    }
    if ix < 1 || ix >= 0x7F800000 || (iy & 0x7FFFFFFF) >= 0x7F800000 { return f32(pow(f64(x), f64(y))) }
    xs: i64 = i64(bits.cast(f64(x)))
    offset: i64 = xs - LOG_OFF
    i: u64 = u64(offset >> 45) & 127
    r: f64 = bits.cast(u64(xs - (offset & -4503599627370496))) * table.log[i].invc - 1.0
    e: f64 = f64(y) * (f64(offset >> 52) * LOG_LN2 + table.log[i].logc + r -
        r * r * (0.5 - r * (LOG_C3 + r * (LOG_C4 + r * LOG_C5))))
    // Beyond |e| = 128 the result overflows or underflows to zero in f32.
    if ((bits.cast(e) >> 52) & 0x7FF) >= 0x406 {
        if e > 0.0 { return bits.cast(u32(0x7F800000)) }
        return 0.0
    }
    shifted: f64 = EXP_INV_LN2N * e + EXP_SHIFT
    n: i64 = i64(bits.cast(shifted)) - EXP_SHIFT_BITS
    er: f64 = e - (shifted - EXP_SHIFT) * EXP_LN2_N
    scale: f64 = bits.cast(u64(i64(table.two_bits[u64(n) & 127]) + ((n >> 7) << 52)))
    return f32(scale + scale * (er + er * er * (0.5 + er * EXP_C3)))
}



exponent_field(x: f64): int {
    return int((bits.cast(x) >> 52) & u64(0x7FF))
}

/* Cody-Waite reduction for 0 < x < 2^20 * pi/2: x = n * pi/2 + (y0 + y1). */

bit_at(limbs: []u64, k: int): u64 {
    if k < 0 || k >= 320 { return 0 }
    return (limbs[usize(k / 32)] >> u64(k % 32)) & 1
}

/* Payne-Hanek reduction for x >= 2^20 * pi/2. With x = m * 2^e (m a 53-bit
 * integer), x * 2/pi mod 4 needs only the limbs of 2/pi whose weight can reach
 * the fraction or the two quotient bits; eight limbs give a 256-bit fixed-point
 * sum whose truncation error, 2^-170 of the product, leaves over 100 good bits
 * even when the fraction cancels to 2^-62 (the worst case for an f64).
 */
reduce_large(x: f64): (f64, f64, int) {
    raw: u64 = bits.cast(x)
    e: int = exponent_field(x) - 1075
    m: u64 = (raw & u64(0x000FFFFFFFFFFFFF)) | u64(0x0010000000000000)
    ml: u64 = m & u64(0xFFFFFFFF)
    mh: u64 = m >> 32
    first: int = 0
    if e >= 2 { first = (e - 2) / 32 }
    limbs: [10]u64 = [0 : 10]
    for j: int in 0 .. 8 {
        limb: u64 = u64(table.two_over_pi[usize(first + j)])
        low: u64 = limb * ml
        high: u64 = limb * mh
        position: int = 7 - j
        limbs[usize(position)] += low & u64(0xFFFFFFFF)
        limbs[usize(position + 1)] += (low >> 32) + (high & u64(0xFFFFFFFF))
        limbs[usize(position + 2)] += high >> 32
    }
    carry: u64 = 0
    for j: int in 0 .. 10 {
        sum: u64 = limbs[usize(j)] + carry
        limbs[usize(j)] = sum & u64(0xFFFFFFFF)
        carry = sum >> 32
    }
    // The product is an integer of weight 2^-fraction_bits; its bits at and
    // above fraction_bits hold the quotient (only the low two matter).
    fraction_bits: int = 256 + 32 * first - e
    quotient: int = int(bit_at(limbs[..], fraction_bits) + 2 * bit_at(limbs[..], fraction_bits + 1))
    negative: bool = bit_at(limbs[..], fraction_bits - 1) == 1
    if negative {
        // Fraction >= 1/2: round the quotient up and use 1 - fraction instead.
        quotient = quotient + 1
        carry = 1
        for j: int in 0 .. 10 {
            sum: u64 = (~limbs[usize(j)] & u64(0xFFFFFFFF)) + carry
            limbs[usize(j)] = sum & u64(0xFFFFFFFF)
            carry = sum >> 32
        }
    }
    top: int = fraction_bits - 1
    for top >= 0 && bit_at(limbs[..], top) == 0 { top = top - 1 }
    if top < 0 { return 0.0, 0.0, quotient & 3 }
    // The fraction as two exact 53-bit pieces, most significant first.
    high_bits: u64 = 0
    low_bits: u64 = 0
    for t: int in 0 .. 53 {
        high_bits = high_bits * 2 + bit_at(limbs[..], top - t)
        low_bits = low_bits * 2 + bit_at(limbs[..], top - 53 - t)
    }
    fh: f64 = f64(high_bits) * bits.cast(u64(1023 + top - 52 - fraction_bits) << 52)
    fl: f64 = f64(low_bits) * bits.cast(u64(1023 + top - 105 - fraction_bits) << 52)
    // (fh + fl) * pi/2 as a double-double, using pi/2 = A + B + (C, negligible).
    p: f64 = fh * PIO2_A
    t: f64 = fma(fh, PIO2_A, -p) + (fh * PIO2_B + fl * PIO2_A)
    y0: f64 = p + t
    y1: f64 = t - (y0 - p)
    if negative { return -y0, -y1, quotient & 3 }
    return y0, y1, quotient & 3
}

pub sin(value: f64): f64 {
    raw: u64 = bits.cast(value)
    if (raw & ABS_BITS) >= INF_BITS { return bits.cast(u64(0x7FF8000000000000)) }
    magnitude: f64 = bits.cast(raw & ABS_BITS)
    if magnitude <= PIO4 {
        if magnitude < SMALL_ARGUMENT { return value }
        z: f64 = value * value
        return fma(
            z * value,
            fma(z, fma(z, fma(z, fma(z, fma(z, SIN_S6, SIN_S5), SIN_S4), SIN_S3), SIN_S2), SIN_S1),
            value,
        )
    }

    y0: f64 = 0.0
    y1: f64 = 0.0
    quarter: int = 0
    if magnitude >= MEDIUM_LIMIT {
        y0, y1, quarter = reduce_large(magnitude)
    } else {
        // Cody-Waite: x - n*pi/2 with pi/2 in two or three words, extended only as far as the
        // cancellation in `a` demands. Inline because every call would spill the promoted floats.
        n: int = int(magnitude * INV_PIO2 + 0.5)
        fn: f64 = f64(n)
        r: f64 = fma(-fn, PIO2_1, magnitude)
        w: f64 = fn * PIO2_1T
        a: f64 = r - w
        j: int = int((raw >> 52) & u64(0x7FF))
        if j - int((bits.cast(a) >> 52) & u64(0x7FF)) > 16 {
            t: f64 = r
            w = fn * PIO2_2
            r = t - w
            w = fn * PIO2_2T - ((t - r) - w)
            a = r - w
            if j - int((bits.cast(a) >> 52) & u64(0x7FF)) > 49 {
                t = r
                w = fn * PIO2_3
                r = t - w
                w = fn * PIO2_3T - ((t - r) - w)
                a = r - w
            }
        }

        y0 = a
        y1 = (r - a) - w
        quarter = n & 3
    }
    result: f64 = 0.0
    // An even quarter takes the sine kernel and an odd one the cosine kernel; the second bit of the
    // quarter carries the sign, and sin is odd, so a negative argument flips the result once more.
    if (quarter & 1) == 0 {
        z: f64 = y0 * y0
        v: f64 = z * y0
        poly: f64 = fma(z, fma(z, fma(z, fma(z, SIN_S6, SIN_S5), SIN_S4), SIN_S3), SIN_S2)
        result = y0 - ((z * (0.5 * y1 - v * poly) - y1) - v * SIN_S1)
    } else {
        z: f64 = y0 * y0
        r: f64 = z * fma(z, fma(z, fma(z, fma(z, fma(z, COS_C6, COS_C5), COS_C4), COS_C3), COS_C2), COS_C1)
        reduced: f64 = bits.cast(bits.cast(y0) & ABS_BITS)
        if reduced < 0.3 {
            result = 1.0 - (0.5 * z - (z * r - y0 * y1))
        } else {
            qx: f64 = 0.28125
            // y0/4 truncated to its high word, so the subtraction below stays exact.
            if reduced <= 0.78125 { qx = bits.cast(((bits.cast(reduced) >> 32) - u64(0x00200000)) << 32) }
            result = (1.0 - qx) - ((0.5 * z - qx) - (z * r - y0 * y1))
        }
    }
    if (quarter & 2) != 0 { result = -result }
    if value < 0.0 { return -result }
    return result
}

pub sin(value: f32): f32 {
    return f32(sin(f64(value)))
}

pub cos(value: f64): f64 {
    raw: u64 = bits.cast(value)
    if (raw & ABS_BITS) >= INF_BITS { return bits.cast(u64(0x7FF8000000000000)) }
    magnitude: f64 = bits.cast(raw & ABS_BITS)
    if magnitude <= PIO4 {
        if magnitude < SMALL_ARGUMENT { return 1.0 }
        // The unreduced argument carries no tail, so every y1 term of the kernel below drops out.
        z: f64 = magnitude * magnitude
        r: f64 = z * fma(z, fma(z, fma(z, fma(z, fma(z, COS_C6, COS_C5), COS_C4), COS_C3), COS_C2), COS_C1)
        if magnitude < 0.3 { return 1.0 - (0.5 * z - z * r) }
        qx: f64 = 0.28125
        // magnitude/4 truncated to its high word, so the subtraction below stays exact.
        if magnitude <= 0.78125 { qx = bits.cast(((bits.cast(magnitude) >> 32) - u64(0x00200000)) << 32) }
        return (1.0 - qx) - ((0.5 * z - qx) - z * r)
    }

    y0: f64 = 0.0
    y1: f64 = 0.0
    quarter: int = 0
    if magnitude >= MEDIUM_LIMIT {
        y0, y1, quarter = reduce_large(magnitude)
    } else {
        // Cody-Waite: x - n*pi/2 with pi/2 in two or three words, extended only as far as the
        // cancellation in `a` demands. Inline because every call would spill the promoted floats.
        n: int = int(magnitude * INV_PIO2 + 0.5)
        fn: f64 = f64(n)
        r: f64 = fma(-fn, PIO2_1, magnitude)
        w: f64 = fn * PIO2_1T
        a: f64 = r - w
        j: int = int((raw >> 52) & u64(0x7FF))
        if j - int((bits.cast(a) >> 52) & u64(0x7FF)) > 16 {
            t: f64 = r
            w = fn * PIO2_2
            r = t - w
            w = fn * PIO2_2T - ((t - r) - w)
            a = r - w
            if j - int((bits.cast(a) >> 52) & u64(0x7FF)) > 49 {
                t = r
                w = fn * PIO2_3
                r = t - w
                w = fn * PIO2_3T - ((t - r) - w)
                a = r - w
            }
        }

        y0 = a
        y1 = (r - a) - w
        quarter = n & 3
    }
    result: f64 = 0.0
    // The quarters run cos, -sin, -cos, sin: an even one takes the cosine kernel, and the middle two
    // are negative. cos is even, so the argument's sign never reaches the result.
    if (quarter & 1) == 0 {
        z: f64 = y0 * y0
        r: f64 = z * fma(z, fma(z, fma(z, fma(z, fma(z, COS_C6, COS_C5), COS_C4), COS_C3), COS_C2), COS_C1)
        reduced: f64 = bits.cast(bits.cast(y0) & ABS_BITS)
        if reduced < 0.3 {
            result = 1.0 - (0.5 * z - (z * r - y0 * y1))
        } else {
            qx: f64 = 0.28125
            // y0/4 truncated to its high word, so the subtraction below stays exact.
            if reduced <= 0.78125 { qx = bits.cast(((bits.cast(reduced) >> 32) - u64(0x00200000)) << 32) }
            result = (1.0 - qx) - ((0.5 * z - qx) - (z * r - y0 * y1))
        }
    } else {
        z: f64 = y0 * y0
        v: f64 = z * y0
        poly: f64 = fma(z, fma(z, fma(z, fma(z, SIN_S6, SIN_S5), SIN_S4), SIN_S3), SIN_S2)
        result = y0 - ((z * (0.5 * y1 - v * poly) - y1) - v * SIN_S1)
    }
    if quarter == 1 || quarter == 2 { return -result }
    return result
}

pub cos(value: f32): f32 {
    return f32(cos(f64(value)))
}
