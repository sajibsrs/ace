/* math — minimal pure-Ace numeric helpers.
 * sqrt, floor, and ceil are compiler-backed exact IEEE operations. exp and log
 * are pure Ace, within 1 ULP over the whole finite domain: exp reduces by
 * k*ln2 and evaluates a rational polynomial, log splits the exponent and
 * evaluates a polynomial in s = f/(2+f). Both use the classic fdlibm scheme
 * with the ln2 constant split into a high and low part.
 */

import bits

pub sqrt(value: f64): f64 intrinsic
pub sqrt(value: f32): f32 intrinsic

pub floor(value: f64): f64 intrinsic
pub floor(value: f32): f32 intrinsic

pub ceil(value: f64): f64 intrinsic
pub ceil(value: f32): f32 intrinsic

LN2_HI: const f64 = 6.93147180369123816490e-01
LN2_LO: const f64 = 1.90821492927058770002e-10
INV_LN2: const f64 = 1.44269504088896338700e+00

EXP_OVERFLOW: const f64 = 7.09782712893383973096e+02
EXP_UNDERFLOW: const f64 = -7.45133219101941108420e+02
EXP_HALF_LN2: const f64 = 3.46573590279972643113e-01
EXP_P1: const f64 = 1.66666666666666019037e-01
EXP_P2: const f64 = -2.77777777770155933842e-03
EXP_P3: const f64 = 6.61375632143793436117e-05
EXP_P4: const f64 = -1.65339022054652515390e-06
EXP_P5: const f64 = 4.13813679705723846039e-08

LOG_L1: const f64 = 6.666666666666735130e-01
LOG_L2: const f64 = 3.999999999940941908e-01
LOG_L3: const f64 = 2.857142874366239149e-01
LOG_L4: const f64 = 2.222219843214978396e-01
LOG_L5: const f64 = 1.818357216161805012e-01
LOG_L6: const f64 = 1.531383769920937332e-01
LOG_L7: const f64 = 1.479819860511658591e-01

/* pow's extended-precision log2 kernel. Its 2^x polynomial reuses EXP_P1..P5. */
POW_L1: const f64 = 5.99999999999994648725e-01
POW_L2: const f64 = 4.28571428578550184252e-01
POW_L3: const f64 = 3.33333329818377432918e-01
POW_L4: const f64 = 2.72728123808534006489e-01
POW_L5: const f64 = 2.30660745775561754067e-01
POW_L6: const f64 = 2.06975017800338417784e-01
POW_LG2: const f64 = 6.93147180559945286227e-01
POW_LG2_HI: const f64 = 6.93147182464599609375e-01
POW_LG2_LO: const f64 = -1.90465429995776804525e-09
POW_INV_LN2_HI: const f64 = 1.44269466400146484375e+00
POW_INV_LN2_LO: const f64 = 3.76887498563609911454e-07
POW_CP: const f64 = 9.61796693925975554329e-01
POW_CP_HI: const f64 = 9.61796700954437255859e-01
POW_CP_LO: const f64 = -7.02846165095275826516e-09
POW_DP_HI: const f64 = 5.84962487220764160156e-01
POW_DP_LO: const f64 = 1.35003920212974897128e-08
POW_OVT: const f64 = 8.0085662595372944372e-17
POW_TWO_M54: const f64 = 5.55111512312578270212e-17

PIO4: const f64 = 7.85398163397448278999e-01
SMALL_ARGUMENT: const f64 = 7.450580596923828125e-09
MEDIUM_LIMIT: const f64 = 1647099.0
INV_PIO2: const f64 = 6.36619772367581382433e-01
PIO2_1: const f64 = 1.57079632673412561417e+00
PIO2_1T: const f64 = 6.07710050650619224932e-11
PIO2_2: const f64 = 6.07710050630396597660e-11
PIO2_2T: const f64 = 2.02226624879595063154e-21
PIO2_3: const f64 = 2.02226624871116645580e-21
PIO2_3T: const f64 = 8.47842766036889956997e-32
PIO2_A: const f64 = 1.5707963267948966
PIO2_B: const f64 = 6.123233995736766e-17
SPLIT: const f64 = 134217729.0

SIN_S1: const f64 = -1.66666666666666324348e-01
SIN_S2: const f64 = 8.33333333332248946124e-03
SIN_S3: const f64 = -1.98412698298579493134e-04
SIN_S4: const f64 = 2.75573137070700676789e-06
SIN_S5: const f64 = -2.50507602534068634195e-08
SIN_S6: const f64 = 1.58969099521155010221e-10

COS_C1: const f64 = 4.16666666666666019037e-02
COS_C2: const f64 = -1.38888888888741095749e-03
COS_C3: const f64 = 2.48015872894767294178e-05
COS_C4: const f64 = -2.75573143513906633035e-07
COS_C5: const f64 = 2.08757232129817482790e-09
COS_C6: const f64 = -1.13596475577881948265e-11

/* 2/pi as 32-bit limbs of its binary fraction, most significant first: 1280 bits,
 * enough for any finite f64 argument in the Payne-Hanek reduction below.
 */
TWO_OVER_PI: [40]u32 = [
    0xA2F9836E, 0x4E441529, 0xFC2757D1, 0xF534DDC0, 0xDB629599, 0x3C439041,
    0xFE5163AB, 0xDEBBC561, 0xB7246E3A, 0x424DD2E0, 0x06492EEA, 0x09D1921C,
    0xFE1DEB1C, 0xB129A73E, 0xE88235F5, 0x2EBB4484, 0xE99C7026, 0xB45F7E41,
    0x3991D639, 0x835339F4, 0x9C845F8B, 0xBDF9283B, 0x1FF897FF, 0xDE05980F,
    0xEF2F118B, 0x5A0A6D1F, 0x6D367ECF, 0x27CB09B7, 0x4F463F66, 0x9E5FEA2D,
    0x7527BAC7, 0xEBE5F17B, 0x3D0739F7, 0x8A5292EA, 0x6BFB5FB1, 0x1F8D5D08,
    0x56033046, 0xFC7B6BAB, 0xF0CFBC20, 0x9AF4361D,
]

pub isnan(value: f64): bool {
    raw: u64 = bits.from_float(value)
    exponent: u64 = raw & u64(0x7FF0000000000000)
    fraction: u64 = raw & u64(0x000FFFFFFFFFFFFF)
    return exponent == u64(0x7FF0000000000000) && fraction != 0
}

pub isnan(value: f32): bool {
    raw: u32 = bits.from_float(value)
    exponent: u32 = raw & u32(0x7F800000)
    fraction: u32 = raw & u32(0x007FFFFF)
    return exponent == u32(0x7F800000) && fraction != 0
}

pub isinf(value: f64): bool {
    raw: u64 = bits.from_float(value)
    magnitude: u64 = raw & u64(0x7FFFFFFFFFFFFFFF)
    return magnitude == u64(0x7FF0000000000000)
}

pub isinf(value: f32): bool {
    raw: u32 = bits.from_float(value)
    magnitude: u32 = raw & u32(0x7FFFFFFF)
    return magnitude == u32(0x7F800000)
}

pub isfinite(value: f64): bool {
    raw: u64 = bits.from_float(value)
    exponent: u64 = raw & u64(0x7FF0000000000000)
    return exponent != u64(0x7FF0000000000000)
}

pub isfinite(value: f32): bool {
    raw: u32 = bits.from_float(value)
    exponent: u32 = raw & u32(0x7F800000)
    return exponent != u32(0x7F800000)
}

pub min[T](a: T, b: T): T {
    if a < b {
        return a
    }
    return b
}

pub max[T](a: T, b: T): T {
    if a > b {
        return a
    }
    return b
}

pub abs[T](x: T): T {
    if x < 0 {
        return -x
    }
    return x
}

pub exp(value: f64): f64 {
    if isnan(value) {
        return value
    }
    if value > EXP_OVERFLOW {
        return bits.to_float(u64(0x7FF0000000000000))
    }
    if value < EXP_UNDERFLOW {
        return 0.0
    }
    high: f64 = value
    low: f64 = 0.0
    k: int = 0
    if value <= -EXP_HALF_LN2 || value >= EXP_HALF_LN2 {
        half: f64 = 0.5
        if value < 0.0 {
            half = -0.5
        }
        k = int(INV_LN2 * value + half)
        scale: f64 = f64(k)
        high = value - scale * LN2_HI
        low = scale * LN2_LO
    }
    r: f64 = high - low
    r2: f64 = r * r
    c: f64 = r - r2 * (EXP_P1 + r2 * (EXP_P2 + r2 * (EXP_P3 + r2 * (EXP_P4 + r2 * EXP_P5))))
    if k == 0 {
        return 1.0 - ((r * c) / (c - 2.0) - r)
    }
    y: f64 = 1.0 - ((low - (r * c) / (2.0 - c)) - high)
    if k == 1024 {
        y = y * 2.0
        k = 1023
    }
    if k >= -1021 {
        return y * bits.to_float(u64(1023 + k) << 52)
    }
    // Subnormal result: scale in two exact steps so only the last one rounds.
    return y * bits.to_float(u64(1023 + k + 1000) << 52) * bits.to_float(u64(23) << 52)
}

pub exp(value: f32): f32 {
    return f32(exp(f64(value)))
}

pub log(value: f64): f64 {
    if isnan(value) {
        return value
    }
    if value < 0.0 {
        return bits.to_float(u64(0x7FF8000000000000))
    }
    if value == 0.0 {
        return -bits.to_float(u64(0x7FF0000000000000))
    }
    if isinf(value) {
        return value
    }
    x: f64 = value
    raw: u64 = bits.from_float(x)
    k: int = 0
    if (raw >> 52) == 0 {
        // Subnormal: scale by 2^54 so the exponent field is meaningful.
        k = -54
        x = x * 18014398509481984.0
        raw = bits.from_float(x)
    }
    k = k + int(raw >> 52) - 1023
    mantissa: u64 = raw & u64(0x000FFFFFFFFFFFFF)
    // Normalize the significand into [sqrt(2)/2, sqrt(2)).
    if mantissa > u64(0x6A09E667F3BCD) {
        mantissa = mantissa | (u64(1022) << 52)
        k = k + 1
    } else {
        mantissa = mantissa | (u64(1023) << 52)
    }
    f: f64 = bits.to_float(mantissa) - 1.0
    s: f64 = f / (2.0 + f)
    z: f64 = s * s
    w: f64 = z * z
    t1: f64 = w * (LOG_L2 + w * (LOG_L4 + w * LOG_L6))
    t2: f64 = z * (LOG_L1 + w * (LOG_L3 + w * (LOG_L5 + w * LOG_L7)))
    r: f64 = t2 + t1
    half_f2: f64 = 0.5 * f * f
    dk: f64 = f64(k)
    return dk * LN2_HI - ((half_f2 - (s * (half_f2 + r) + dk * LN2_LO)) - f)
}

pub log(value: f32): f32 {
    return f32(log(f64(value)))
}

/* Low 32 bits cleared, so the product of two such values is exact in f64. */
trunc_low(x: f64): f64 {
    return bits.to_float((bits.from_float(x) >> 32) << 32)
}

/* 0 when y is not an integer, 1 when it is an odd integer, 2 when it is even.
 * Only a negative base needs this: it decides the sign of the result and
 * whether the power exists at all.
 */
integer_kind(y: f64): int {
    ay: u64 = bits.from_float(y) & u64(0x7FFFFFFFFFFFFFFF)
    if ay >= u64(0x4340000000000000) {
        // 2^53 and above: no odd value is representable there.
        return 2
    }
    if ay < u64(0x3FF0000000000000) {
        // Below 1, and a zero exponent is settled by the caller.
        return 0
    }
    // The binary point sits 1075 - exponent_field bits up from the bottom.
    shift: u64 = u64(1075) - (ay >> 52)
    if (ay & ((u64(1) << shift) - u64(1))) != 0 {
        return 0
    }
    return 2 - int((ay >> shift) & u64(1))
}

/* log2(value) as a high and low part, the high part holding the leading bits
 * with its low 32 cleared. pow needs about eleven bits more than log returns,
 * so it carries this kernel instead: the significand is normalized into one of
 * two subintervals, around 1.0 and 1.5, and the polynomial runs in
 * s = (m - bp) / (m + bp), every step split into a high and low part.
 */
log2_split(value: f64): (f64, f64) {
    ax: f64 = value
    raw: u64 = bits.from_float(ax)
    n: int = 0
    if raw < u64(0x0010000000000000) {
        // Subnormal: scale by 2^53 so the exponent field is meaningful.
        ax = ax * 9007199254740992.0
        raw = bits.from_float(ax)
        n = -53
    }
    n = n + int(raw >> 52) - 1023
    mantissa: u64 = raw & u64(0x000FFFFFFFFFFFFF)
    raw = mantissa | u64(0x3FF0000000000000)
    k: int = 0
    bp: f64 = 1.0
    dp_hi: f64 = 0.0
    dp_lo: f64 = 0.0
    top: u64 = mantissa >> 32
    if top > u64(0x3988E) {
        if top < u64(0xBB67A) {
            // Between sqrt(3/2) and sqrt(3): measure against 1.5.
            k = 1
            bp = 1.5
            dp_hi = POW_DP_HI
            dp_lo = POW_DP_LO
        } else {
            // Above sqrt(3): halve the significand and raise the exponent.
            n = n + 1
            raw = raw - u64(0x0010000000000000)
        }
    }
    ax = bits.to_float(raw)
    u: f64 = ax - bp
    v: f64 = 1.0 / (ax + bp)
    s: f64 = u * v
    s_hi: f64 = trunc_low(s)
    // High part of ax + bp, assembled from the exponent field directly.
    sum_word: u64 = ((raw >> 33) | u64(0x20000000)) + u64(0x00080000) + (u64(k) << 18)
    t_hi: f64 = bits.to_float(sum_word << 32)
    t_lo: f64 = ax - (t_hi - bp)
    s_lo: f64 = v * ((u - s_hi * t_hi) - s_hi * t_lo)
    z: f64 = s * s
    r: f64 = z * z *
        (POW_L1 + z * (POW_L2 + z * (POW_L3 + z * (POW_L4 + z * (POW_L5 + z * POW_L6)))))
    r = r + s_lo * (s_hi + s)
    z = s_hi * s_hi
    t_hi = trunc_low(3.0 + z + r)
    t_lo = r - ((t_hi - 3.0) - z)
    u = s_hi * t_hi
    v = s_lo * t_hi + t_lo * s
    p_hi: f64 = trunc_low(u + v)
    p_lo: f64 = v - (p_hi - u)
    // 2/(3 ln 2) scales the kernel to log2; dp and n restore the rest.
    z_hi: f64 = POW_CP_HI * p_hi
    z_lo: f64 = POW_CP_LO * p_hi + p_lo * POW_CP + dp_lo
    scale: f64 = f64(n)
    high: f64 = trunc_low(((z_hi + z_lo) + dp_hi) + scale)
    return high, z_lo - (((high - scale) - dp_hi) - z_hi)
}

pub pow(base: f64, exponent: f64): f64 {
    xbits: u64 = bits.from_float(base)
    ybits: u64 = bits.from_float(exponent)
    ax_bits: u64 = xbits & u64(0x7FFFFFFFFFFFFFFF)
    ay_bits: u64 = ybits & u64(0x7FFFFFFFFFFFFFFF)
    // x**0 and 1**y are 1 for every operand, a NaN included, and so is
    // (-1)**(+-inf). Every other NaN operand gives a NaN.
    if ay_bits == 0 || xbits == u64(0x3FF0000000000000) {
        return 1.0
    }
    if ax_bits == u64(0x3FF0000000000000) && ay_bits == u64(0x7FF0000000000000) {
        return 1.0
    }
    if isnan(base) || isnan(exponent) {
        return base + exponent
    }
    negative: bool = (xbits >> 63) != 0
    down: bool = (ybits >> 63) != 0
    kind: int = 0
    if negative {
        kind = integer_kind(exponent)
    }
    if ay_bits == u64(0x7FF0000000000000) {
        // |x| == 1 is settled above, so this is a limit of 0 or an infinity.
        if (ax_bits > u64(0x3FF0000000000000)) != down {
            return bits.to_float(u64(0x7FF0000000000000))
        }
        return 0.0
    }
    if ay_bits == u64(0x3FF0000000000000) {
        if down {
            return 1.0 / base
        }
        return base
    }
    if ybits == u64(0x4000000000000000) {
        return base * base
    }
    if ybits == u64(0x3FE0000000000000) && !negative {
        return sqrt(base)
    }
    if ax_bits == 0 || ax_bits == u64(0x3FF0000000000000) || ax_bits == u64(0x7FF0000000000000) {
        // |x| is 0, 1, or an infinity: again a limit rather than a power.
        limit: f64 = bits.to_float(ax_bits)
        if down {
            limit = 1.0 / limit
        }
        if negative {
            if ax_bits == u64(0x3FF0000000000000) && kind == 0 {
                return bits.to_float(u64(0x7FF8000000000000))
            }
            if kind == 1 {
                limit = -limit
            }
        }
        return limit
    }
    // A finite negative base with a finite non-integer exponent has no real power.
    if negative && kind == 0 {
        return bits.to_float(u64(0x7FF8000000000000))
    }
    sign: f64 = 1.0
    if negative && kind == 1 {
        sign = -1.0
    }
    ax: f64 = bits.to_float(ax_bits)
    high: f64 = 0.0
    low: f64 = 0.0
    if ay_bits > u64(0x41E0000000000000) {
        // |y| > 2^31. Unless the base sits within 2^-20 of 1 the result is a
        // limit, and past 2^64 every exponent is an even integer, so no base
        // escapes it.
        far: bool = ax_bits < u64(0x3FEFFFFF00000000) || ax_bits >= u64(0x3FF0000100000000)
        if ay_bits > u64(0x43F0000000000000) {
            far = true
        }
        if far {
            if (ax_bits > u64(0x3FF0000000000000)) != down {
                return sign * bits.to_float(u64(0x7FF0000000000000))
            }
            return sign * 0.0
        }
        // |1 - x| <= 2^-20: four series terms carry log(x) to full precision.
        d: f64 = ax - 1.0
        series: f64 = (d * d) * (0.5 - d * (0.3333333333333333333333 - d * 0.25))
        lead: f64 = POW_INV_LN2_HI * d
        rest: f64 = d * POW_INV_LN2_LO - series * INV_LN2
        high = trunc_low(lead + rest)
        low = rest - (high - lead)
    } else {
        high, low = log2_split(ax)
    }
    // y * log2(x), split so the leading product is exact.
    y_hi: f64 = trunc_low(exponent)
    p_lo: f64 = (exponent - y_hi) * high + exponent * low
    p_hi: f64 = y_hi * high
    z: f64 = p_lo + p_hi
    if z >= 1024.0 {
        if z > 1024.0 || p_lo + POW_OVT > z - p_hi {
            return sign * bits.to_float(u64(0x7FF0000000000000))
        }
    } else if z <= -1075.0 {
        if z < -1075.0 || p_lo <= z - p_hi {
            return sign * 0.0
        }
    }
    // 2**(p_hi + p_lo): take the nearest integer n out of the exponent, leaving
    // a remainder of at most half for the polynomial.
    word: u64 = bits.from_float(z) >> 32
    magnitude: u64 = word & u64(0x7FFFFFFF)
    k: int = int(magnitude >> 20) - 1023
    n: int = 0
    if magnitude > u64(0x3FE00000) {
        rounded: u64 = word + (u64(0x00100000) >> u64(k + 1))
        k = int((rounded & u64(0x7FFFFFFF)) >> 20) - 1023
        mask: u64 = u64(0x000FFFFF) >> u64(k)
        whole: f64 = bits.to_float((rounded - (rounded & mask)) << 32)
        n = int(((rounded & u64(0x000FFFFF)) | u64(0x00100000)) >> u64(20 - k))
        if (word >> 31) != 0 {
            n = -n
        }
        p_hi = p_hi - whole
    }
    split: f64 = trunc_low(p_lo + p_hi)
    u: f64 = split * POW_LG2_HI
    v: f64 = (p_lo - (split - p_hi)) * POW_LG2 + split * POW_LG2_LO
    r: f64 = u + v
    w: f64 = v - (r - u)
    q: f64 = r * r
    c: f64 = r - q * (EXP_P1 + q * (EXP_P2 + q * (EXP_P3 + q * (EXP_P4 + q * EXP_P5))))
    correction: f64 = (r * c) / (c - 2.0) - (w + r * w)
    result: f64 = 1.0 - (correction - r)
    mantissa: u64 = bits.from_float(result) & u64(0x000FFFFFFFFFFFFF)
    field: int = int(bits.from_float(result) >> 52) + n
    if field <= 0 {
        // Subnormal result: bias the exponent up by 54 and scale back in one
        // rounding step. The underflow return above keeps field above -54.
        return sign * (bits.to_float(mantissa | (u64(field + 54) << 52)) * POW_TWO_M54)
    }
    return sign * bits.to_float(mantissa | (u64(field) << 52))
}

pub pow(base: f32, exponent: f32): f32 {
    return f32(pow(f64(base), f64(exponent)))
}

kernel_sin(x: f64, y: f64, tail: bool): f64 {
    z: f64 = x * x
    v: f64 = z * x
    r: f64 = SIN_S2 + z * (SIN_S3 + z * (SIN_S4 + z * (SIN_S5 + z * SIN_S6)))
    if !tail {
        return x + v * (SIN_S1 + z * r)
    }
    return x - ((z * (0.5 * y - v * r) - y) - v * SIN_S1)
}

kernel_cos(x: f64, y: f64): f64 {
    z: f64 = x * x
    r: f64 = z * (COS_C1 + z * (COS_C2 + z * (COS_C3 + z * (COS_C4 + z * (COS_C5 + z * COS_C6)))))
    magnitude: f64 = x
    if x < 0.0 {
        magnitude = -x
    }
    if magnitude < 0.3 {
        return 1.0 - (0.5 * z - (z * r - x * y))
    }
    qx: f64 = 0.28125
    if magnitude <= 0.78125 {
        // x/4 truncated to its high word, so the subtraction below stays exact.
        qx = bits.to_float(((bits.from_float(magnitude) >> 32) - u64(0x00200000)) << 32)
    }
    hz: f64 = 0.5 * z - qx
    return (1.0 - qx) - (hz - (z * r - x * y))
}

exponent_field(x: f64): int {
    return int((bits.from_float(x) >> 52) & u64(0x7FF))
}

/* Cody-Waite reduction for 0 < x < 2^20 * pi/2: x = n * pi/2 + (y0 + y1). */
reduce_medium(x: f64): (f64, f64, int) {
    n: int = int(x * INV_PIO2 + 0.5)
    fn: f64 = f64(n)
    r: f64 = x - fn * PIO2_1
    w: f64 = fn * PIO2_1T
    a: f64 = r - w
    j: int = exponent_field(x)
    if j - exponent_field(a) > 16 {
        t: f64 = r
        w = fn * PIO2_2
        r = t - w
        w = fn * PIO2_2T - ((t - r) - w)
        a = r - w
        if j - exponent_field(a) > 49 {
            t = r
            w = fn * PIO2_3
            r = t - w
            w = fn * PIO2_3T - ((t - r) - w)
            a = r - w
        }
    }
    return a, (r - a) - w, n & 3
}

bit_at(limbs: []u64, k: int): u64 {
    if k < 0 || k >= 320 {
        return 0
    }
    return (limbs[usize(k / 32)] >> u64(k % 32)) & 1
}

/* Low part of the exact product a * b, given p = a * b rounded (Dekker). */
product_error(a: f64, b: f64, p: f64): f64 {
    ta: f64 = SPLIT * a
    ah: f64 = ta - (ta - a)
    al: f64 = a - ah
    tb: f64 = SPLIT * b
    bh: f64 = tb - (tb - b)
    bl: f64 = b - bh
    return ((ah * bh - p) + ah * bl + al * bh) + al * bl
}

/* Payne-Hanek reduction for x >= 2^20 * pi/2. With x = m * 2^e (m a 53-bit
 * integer), x * 2/pi mod 4 needs only the limbs of 2/pi whose weight can reach
 * the fraction or the two quotient bits; eight limbs give a 256-bit fixed-point
 * sum whose truncation error, 2^-170 of the product, leaves over 100 good bits
 * even when the fraction cancels to 2^-62 (the worst case for an f64).
 */
reduce_large(x: f64): (f64, f64, int) {
    raw: u64 = bits.from_float(x)
    e: int = exponent_field(x) - 1075
    m: u64 = (raw & u64(0x000FFFFFFFFFFFFF)) | u64(0x0010000000000000)
    ml: u64 = m & u64(0xFFFFFFFF)
    mh: u64 = m >> 32
    first: int = 0
    if e >= 2 {
        first = (e - 2) / 32
    }
    limbs: [10]u64 = [0 : 10]
    for j: int in 0 .. 8 {
        limb: u64 = u64(TWO_OVER_PI[usize(first + j)])
        low: u64 = limb * ml
        high: u64 = limb * mh
        position: int = 7 - j
        limbs[usize(position)] += low & u64(0xFFFFFFFF)
        limbs[usize(position + 1)] += (low >> 32) + (high & u64(0xFFFFFFFF))
        limbs[usize(position + 2)] += high >> 32
    }
    carry: u64 = 0
    for j: int in 0 .. 10 {
        sum: u64 = limbs[usize(j)] + carry
        limbs[usize(j)] = sum & u64(0xFFFFFFFF)
        carry = sum >> 32
    }
    // The product is an integer of weight 2^-fraction_bits; its bits at and
    // above fraction_bits hold the quotient (only the low two matter).
    fraction_bits: int = 256 + 32 * first - e
    quotient: int = int(bit_at(limbs[..], fraction_bits) + 2 * bit_at(limbs[..], fraction_bits + 1))
    negative: bool = bit_at(limbs[..], fraction_bits - 1) == 1
    if negative {
        // Fraction >= 1/2: round the quotient up and use 1 - fraction instead.
        quotient = quotient + 1
        carry = 1
        for j: int in 0 .. 10 {
            sum: u64 = (~limbs[usize(j)] & u64(0xFFFFFFFF)) + carry
            limbs[usize(j)] = sum & u64(0xFFFFFFFF)
            carry = sum >> 32
        }
    }
    top: int = fraction_bits - 1
    for top >= 0 && bit_at(limbs[..], top) == 0 {
        top = top - 1
    }
    if top < 0 {
        return 0.0, 0.0, quotient & 3
    }
    // The fraction as two exact 53-bit pieces, most significant first.
    high_bits: u64 = 0
    low_bits: u64 = 0
    for t: int in 0 .. 53 {
        high_bits = high_bits * 2 + bit_at(limbs[..], top - t)
        low_bits = low_bits * 2 + bit_at(limbs[..], top - 53 - t)
    }
    fh: f64 = f64(high_bits) * bits.to_float(u64(1023 + top - 52 - fraction_bits) << 52)
    fl: f64 = f64(low_bits) * bits.to_float(u64(1023 + top - 105 - fraction_bits) << 52)
    // (fh + fl) * pi/2 as a double-double, using pi/2 = A + B + (C, negligible).
    p: f64 = fh * PIO2_A
    t: f64 = product_error(fh, PIO2_A, p) + (fh * PIO2_B + fl * PIO2_A)
    y0: f64 = p + t
    y1: f64 = t - (y0 - p)
    if negative {
        return -y0, -y1, quotient & 3
    }
    return y0, y1, quotient & 3
}

reduce(x: f64): (f64, f64, int) {
    y0: f64 = 0.0
    y1: f64 = 0.0
    quarter: int = 0
    if x < MEDIUM_LIMIT {
        y0, y1, quarter = reduce_medium(x)
    } else {
        y0, y1, quarter = reduce_large(x)
    }
    return y0, y1, quarter
}

pub sin(value: f64): f64 {
    if isnan(value) || isinf(value) {
        return bits.to_float(u64(0x7FF8000000000000))
    }
    magnitude: f64 = value
    if value < 0.0 {
        magnitude = -value
    }
    if magnitude <= PIO4 {
        if magnitude < SMALL_ARGUMENT {
            return value
        }
        return kernel_sin(value, 0.0, false)
    }
    y0: f64, y1: f64, quarter: int = reduce(magnitude)
    result: f64 = 0.0
    if quarter == 0 {
        result = kernel_sin(y0, y1, true)
    } else if quarter == 1 {
        result = kernel_cos(y0, y1)
    } else if quarter == 2 {
        result = -kernel_sin(y0, y1, true)
    } else {
        result = -kernel_cos(y0, y1)
    }
    if value < 0.0 {
        return -result
    }
    return result
}

pub sin(value: f32): f32 {
    return f32(sin(f64(value)))
}

pub cos(value: f64): f64 {
    if isnan(value) || isinf(value) {
        return bits.to_float(u64(0x7FF8000000000000))
    }
    magnitude: f64 = value
    if value < 0.0 {
        magnitude = -value
    }
    if magnitude <= PIO4 {
        if magnitude < SMALL_ARGUMENT {
            return 1.0
        }
        return kernel_cos(magnitude, 0.0)
    }
    y0: f64, y1: f64, quarter: int = reduce(magnitude)
    if quarter == 0 {
        return kernel_cos(y0, y1)
    }
    if quarter == 1 {
        return -kernel_sin(y0, y1, true)
    }
    if quarter == 2 {
        return -kernel_cos(y0, y1)
    }
    return kernel_sin(y0, y1, true)
}

pub cos(value: f32): f32 {
    return f32(cos(f64(value)))
}
