/* math — minimal pure-Ace numeric helpers.
 * sqrt, floor, and ceil are compiler-backed exact IEEE operations. exp and log
 * are pure Ace, within 1 ULP over the whole finite domain: exp reduces by
 * k*ln2 and evaluates a rational polynomial, log splits the exponent and
 * evaluates a polynomial in s = f/(2+f). Both use the classic fdlibm scheme
 * with the ln2 constant split into a high and low part. pow is table-driven:
 * it forms log(x) as a high and low double from a 128-entry table plus a
 * short series, multiplies by y in extended precision, and rebuilds the
 * result from a 128-entry 2^(i/128) table; the tables live in `pow_tables`. The f32
 * overload is a separate plain-f64 kernel over the same tables.
 */

import bits
import table: @pow_tables

pub sqrt(value: f64): f64 intrinsic
pub sqrt(value: f32): f32 intrinsic

pub floor(value: f64): f64 intrinsic
pub floor(value: f32): f32 intrinsic

pub ceil(value: f64): f64 intrinsic
pub ceil(value: f32): f32 intrinsic

pub fma(a: f64, b: f64, c: f64): f64 intrinsic
pub fma(a: f32, b: f32, c: f32): f32 intrinsic

LN2_HI: const f64 = 6.93147180369123816490e-01
LN2_LO: const f64 = 1.90821492927058770002e-10
INV_LN2: const f64 = 1.44269504088896338700e+00

EXP_OVERFLOW: const f64 = 7.09782712893383973096e+02
EXP_UNDERFLOW: const f64 = -7.45133219101941108420e+02
EXP_HALF_LN2: const f64 = 3.46573590279972643113e-01
EXP_P1: const f64 = 1.66666666666666019037e-01
EXP_P2: const f64 = -2.77777777770155933842e-03
EXP_P3: const f64 = 6.61375632143793436117e-05
EXP_P4: const f64 = -1.65339022054652515390e-06
EXP_P5: const f64 = 4.13813679705723846039e-08

LOG_L1: const f64 = 6.666666666666735130e-01
LOG_L2: const f64 = 3.999999999940941908e-01
LOG_L3: const f64 = 2.857142874366239149e-01
LOG_L4: const f64 = 2.222219843214978396e-01
LOG_L5: const f64 = 1.818357216161805012e-01
LOG_L6: const f64 = 1.531383769920937332e-01
LOG_L7: const f64 = 1.479819860511658591e-01

PIO4: const f64 = 7.85398163397448278999e-01
SMALL_ARGUMENT: const f64 = 7.450580596923828125e-09
MEDIUM_LIMIT: const f64 = 1647099.0
INV_PIO2: const f64 = 6.36619772367581382433e-01
PIO2_1: const f64 = 1.57079632673412561417e+00
PIO2_1T: const f64 = 6.07710050650619224932e-11
PIO2_2: const f64 = 6.07710050630396597660e-11
PIO2_2T: const f64 = 2.02226624879595063154e-21
PIO2_3: const f64 = 2.02226624871116645580e-21
PIO2_3T: const f64 = 8.47842766036889956997e-32
PIO2_A: const f64 = 1.5707963267948966
PIO2_B: const f64 = 6.123233995736766e-17
SPLIT: const f64 = 134217729.0

SIN_S1: const f64 = -1.66666666666666324348e-01
SIN_S2: const f64 = 8.33333333332248946124e-03
SIN_S3: const f64 = -1.98412698298579493134e-04
SIN_S4: const f64 = 2.75573137070700676789e-06
SIN_S5: const f64 = -2.50507602534068634195e-08
SIN_S6: const f64 = 1.58969099521155010221e-10

COS_C1: const f64 = 4.16666666666666019037e-02
COS_C2: const f64 = -1.38888888888741095749e-03
COS_C3: const f64 = 2.48015872894767294178e-05
COS_C4: const f64 = -2.75573143513906633035e-07
COS_C5: const f64 = 2.08757232129817482790e-09
COS_C6: const f64 = -1.13596475577881948265e-11

POW_LOG_OFF: const i64 = 4604666736195665920
POW_HIGH32: const u64 = 0xFFFFFFFF00000000
POW_HIGH26: const u64 = 0xFFFFFFFFF8000000
POW_LN2: const f64 = 6.931471805599453e-01
POW_LN2_HI: const f64 = 6.931471805592082e-01
POW_LN2_LO: const f64 = 7.371002565167799e-13
POW_LOG_C3: const f64 = 0.3333333333333333
POW_LOG_C4: const f64 = -0.25
POW_LOG_C5: const f64 = 0.2
POW_LOG_C6: const f64 = -0.16666666666666666
POW_LOG_C7: const f64 = 0.14285714285714285
POW_LOG_C8: const f64 = -0.125
POW_LOG_C9: const f64 = 0.1111111111111111
POW_LOG_C10: const f64 = -0.1
POW_EXP_INV_LN2N: const f64 = 184.6649652337873
POW_EXP_LN2_N: const f64 = 0.005415212348111709
POW_EXP_NEG_LN2_HI_N: const f64 = -0.005415212347998022
POW_EXP_NEG_LN2_LO_N: const f64 = -1.2655086083325438e-13
POW_EXP_SHIFT: const f64 = 6755399441055744.0
POW_EXP_C3: const f64 = 0.16666666666666666
POW_EXP_C4: const f64 = 0.041666666666666664
POW_EXP_C5: const f64 = 0.008333333333333333
POW_TWO_52: const f64 = 4503599627370496.0
POW_TWO_M60: const f64 = 8.673617379884035e-19
POW_SHIFT_BITS: const i64 = 4843621399236968448
POW_EXP_LIMIT: const f64 = 745.2
POW_ABS: const u64 = 0x7FFFFFFFFFFFFFFF
POW_SIGN: const u64 = 0x8000000000000000

/* 2/pi as 32-bit limbs of its binary fraction, most significant first: 1280 bits,
 * enough for any finite f64 argument in the Payne-Hanek reduction below.
 */
TWO_OVER_PI: [40]u32 = [
    0xA2F9836E, 0x4E441529, 0xFC2757D1, 0xF534DDC0, 0xDB629599, 0x3C439041,
    0xFE5163AB, 0xDEBBC561, 0xB7246E3A, 0x424DD2E0, 0x06492EEA, 0x09D1921C,
    0xFE1DEB1C, 0xB129A73E, 0xE88235F5, 0x2EBB4484, 0xE99C7026, 0xB45F7E41,
    0x3991D639, 0x835339F4, 0x9C845F8B, 0xBDF9283B, 0x1FF897FF, 0xDE05980F,
    0xEF2F118B, 0x5A0A6D1F, 0x6D367ECF, 0x27CB09B7, 0x4F463F66, 0x9E5FEA2D,
    0x7527BAC7, 0xEBE5F17B, 0x3D0739F7, 0x8A5292EA, 0x6BFB5FB1, 0x1F8D5D08,
    0x56033046, 0xFC7B6BAB, 0xF0CFBC20, 0x9AF4361D,
]

pub isnan(value: f64): bool {
    raw: u64 = bits.from_float(value)
    exponent: u64 = raw & u64(0x7FF0000000000000)
    fraction: u64 = raw & u64(0x000FFFFFFFFFFFFF)
    return exponent == u64(0x7FF0000000000000) && fraction != 0
}

pub isnan(value: f32): bool {
    raw: u32 = bits.from_float(value)
    exponent: u32 = raw & u32(0x7F800000)
    fraction: u32 = raw & u32(0x007FFFFF)
    return exponent == u32(0x7F800000) && fraction != 0
}

pub isinf(value: f64): bool {
    raw: u64 = bits.from_float(value)
    magnitude: u64 = raw & u64(0x7FFFFFFFFFFFFFFF)
    return magnitude == u64(0x7FF0000000000000)
}

pub isinf(value: f32): bool {
    raw: u32 = bits.from_float(value)
    magnitude: u32 = raw & u32(0x7FFFFFFF)
    return magnitude == u32(0x7F800000)
}

pub isfinite(value: f64): bool {
    raw: u64 = bits.from_float(value)
    exponent: u64 = raw & u64(0x7FF0000000000000)
    return exponent != u64(0x7FF0000000000000)
}

pub isfinite(value: f32): bool {
    raw: u32 = bits.from_float(value)
    exponent: u32 = raw & u32(0x7F800000)
    return exponent != u32(0x7F800000)
}

pub min[T](a: T, b: T): T {
    if a < b {
        return a
    }
    return b
}

pub max[T](a: T, b: T): T {
    if a > b {
        return a
    }
    return b
}

pub abs[T](x: T): T {
    if x < 0 {
        return -x
    }
    return x
}

pub exp(value: f64): f64 {
    if isnan(value) {
        return value
    }
    if value > EXP_OVERFLOW {
        return bits.to_float(u64(0x7FF0000000000000))
    }
    if value < EXP_UNDERFLOW {
        return 0.0
    }
    high: f64 = value
    low: f64 = 0.0
    k: int = 0
    if value <= -EXP_HALF_LN2 || value >= EXP_HALF_LN2 {
        half: f64 = 0.5
        if value < 0.0 {
            half = -0.5
        }
        k = int(INV_LN2 * value + half)
        scale: f64 = f64(k)
        high = value - scale * LN2_HI
        low = scale * LN2_LO
    }
    r: f64 = high - low
    r2: f64 = r * r
    c: f64 = r - r2 * (EXP_P1 + r2 * (EXP_P2 + r2 * (EXP_P3 + r2 * (EXP_P4 + r2 * EXP_P5))))
    if k == 0 {
        return 1.0 - ((r * c) / (c - 2.0) - r)
    }
    y: f64 = 1.0 - ((low - (r * c) / (2.0 - c)) - high)
    if k == 1024 {
        y = y * 2.0
        k = 1023
    }
    if k >= -1021 {
        return y * bits.to_float(u64(1023 + k) << 52)
    }
    // Subnormal result: scale in two exact steps so only the last one rounds.
    return y * bits.to_float(u64(1023 + k + 1000) << 52) * bits.to_float(u64(23) << 52)
}

pub exp(value: f32): f32 {
    return f32(exp(f64(value)))
}

pub log(value: f64): f64 {
    if isnan(value) {
        return value
    }
    if value < 0.0 {
        return bits.to_float(u64(0x7FF8000000000000))
    }
    if value == 0.0 {
        return -bits.to_float(u64(0x7FF0000000000000))
    }
    if isinf(value) {
        return value
    }
    x: f64 = value
    raw: u64 = bits.from_float(x)
    k: int = 0
    if (raw >> 52) == 0 {
        // Subnormal: scale by 2^54 so the exponent field is meaningful.
        k = -54
        x = x * 18014398509481984.0
        raw = bits.from_float(x)
    }
    k = k + int(raw >> 52) - 1023
    mantissa: u64 = raw & u64(0x000FFFFFFFFFFFFF)
    // Normalize the significand into [sqrt(2)/2, sqrt(2)).
    if mantissa > u64(0x6A09E667F3BCD) {
        mantissa = mantissa | (u64(1022) << 52)
        k = k + 1
    } else {
        mantissa = mantissa | (u64(1023) << 52)
    }
    f: f64 = bits.to_float(mantissa) - 1.0
    s: f64 = f / (2.0 + f)
    z: f64 = s * s
    w: f64 = z * z
    t1: f64 = w * (LOG_L2 + w * (LOG_L4 + w * LOG_L6))
    t2: f64 = z * (LOG_L1 + w * (LOG_L3 + w * (LOG_L5 + w * LOG_L7)))
    r: f64 = t2 + t1
    half_f2: f64 = 0.5 * f * f
    dk: f64 = f64(k)
    return dk * LN2_HI - ((half_f2 - (s * (half_f2 + r) + dk * LN2_LO)) - f)
}

pub log(value: f32): f32 {
    return f32(log(f64(value)))
}

// Parity of the finite non-zero exponent with bits `raw`: 0 fractional, 1 odd, 2 even.
integer_parity(raw: u64): int {
    e: u64 = (raw >> 52) & 0x7FF
    if e < 0x3FF {
        return 0
    }
    if e > 0x3FF + 52 {
        return 2
    }
    unit: u64 = u64(1) << (0x3FF + 52 - e)
    if (raw & (unit - 1)) != 0 {
        return 0
    }
    if (raw & unit) != 0 {
        return 1
    }
    return 2
}

// A result of pow computed for |x|: negative when x is a negative base and y an odd integer.
pow_signed(magnitude: f64, flip: u64): f64 {
    if flip != 0 {
        return -magnitude
    }
    return magnitude
}

// Handles every operand pair the main path cannot: zero, infinite, NaN, negative, or subnormal x,
// and y so small or large that the answer is 1, 0, or infinity. Returns (done, result, magnitude
// bits of x as a signed integer, flip). When not done, the bits are those of |x| with a subnormal
// rescaled by 2^52 and its exponent field lowered by 52, so the field may go negative.
pow_special(x: f64, y: f64): (bool, f64, i64, u64) {
    ix: u64 = bits.from_float(x)
    iy: u64 = bits.from_float(y)
    ax: u64 = ix & POW_ABS
    ay: u64 = iy & POW_ABS
    one: u64 = 0x3FF0000000000000
    infinite: u64 = 0x7FF0000000000000
    infinity: f64 = bits.to_float(infinite)
    // Zero exponent and a base of +1 give 1 whatever the other operand is, a NaN included.
    if ay == 0 || ix == one {
        return true, 1.0, 0, 0
    }
    if ax > infinite || ay > infinite {
        return true, x + y, 0, 0
    }
    grows: bool = ax > one
    y_positive: bool = (iy >> 63) == 0
    if ay == infinite {
        if ax == one {
            return true, 1.0, 0, 0
        }
        if grows == y_positive {
            return true, infinity, 0, 0
        }
        return true, 0.0, 0, 0
    }
    // y is finite and non-zero; a negative base needs its exponent's parity, and only an odd integer
    // exponent flips the sign.
    negative: bool = (ix >> 63) != 0
    parity: int = 0
    flip: u64 = 0
    if negative {
        parity = integer_parity(iy)
        if parity == 1 {
            flip = POW_SIGN
        }
    }
    if ax == 0 || ax == infinite {
        // A zero base gives 0 for y > 0 and infinity for y < 0; an infinite base the reverse.
        if (ax == 0) == y_positive {
            return true, pow_signed(0.0, flip), 0, 0
        }
        return true, pow_signed(infinity, flip), 0, 0
    }
    // A finite negative base with a fractional exponent has no real power.
    if negative && parity == 0 {
        return true, bits.to_float(u64(0x7FF8000000000000)), 0, 0
    }
    // |y| < 2^-65 puts the result within 2^-54 of 1; |y| >= 2^63 overflows or underflows unless |x| = 1.
    ey: u64 = (iy >> 52) & 0x7FF
    if ax == one || ey < 0x3BE {
        return true, 1.0, 0, 0
    }
    if ey >= 0x43E {
        if grows == y_positive {
            return true, infinity, 0, 0
        }
        return true, 0.0, 0, 0
    }
    magnitude: i64 = i64(ax)
    if (ax >> 52) == 0 {
        magnitude = i64(bits.from_float(bits.to_float(ax) * POW_TWO_52)) - 234187180623265792
    }
    return false, 0.0, magnitude, flip
}

// w * 2^n for an exponent too close to the ends of the range for the main path, which adds a
// correction scaled by 2^n and so needs that correction to be a normal double. Overflows for n > 1024;
// otherwise scales in two steps so w keeps its precision and only the last multiply can round into
// the subnormal range.
pow_extreme(w: f64, n: i64): f64 {
    if n > 1024 {
        return bits.to_float(u64(0x7FF0000000000000))
    }
    if n == 1024 {
        return (w * bits.to_float(u64(2046) << 52)) * 2.0
    }
    return (w * bits.to_float(u64(n + 1083) << 52)) * POW_TWO_M60
}

/* The body names as few locals as it can. A local that does not win one of the eight callee-saved
 * float registers costs a store where it is set and a load at every mention, so single-use values
 * stay nested in the expression that consumes them and cheap ones are recomputed rather than named.
 */
pub pow(x: f64, y: f64): f64 {
    ix: u64 = bits.from_float(x)
    iy: u64 = bits.from_float(y)
    // An exponent of 2, 1, -1, or 0.5 (a zero mantissa selects the powers of two) has a cheaper exact
    // form. Only a positive base takes the square root: pow(-0, 0.5) is +0 and pow(-inf, 0.5) is +inf.
    if (iy << 12) == 0 {
        if iy == 0x4000000000000000 {
            return x * x
        }
        if iy == 0x3FF0000000000000 {
            return x
        }
        if iy == 0xBFF0000000000000 {
            return 1.0 / x
        }
        if iy == 0x3FE0000000000000 && ix < 0x7FF0000000000000 {
            return sqrt(x)
        }
    }
    top_x: u64 = ix >> 52
    top_y: u64 = (iy >> 52) & 0x7FF
    xs: i64 = i64(ix)
    flip: u64 = 0
    if top_x < 1 || top_x >= 0x7FF || top_y < 0x3BE || top_y >= 0x43E {
        if top_x > 0x800 && top_x < 0xFFF && top_y >= 0x3BE && top_y < 0x43E {
            // A finite negative base and an ordinary exponent: only an integer exponent is defined, and
            // an odd one flips the sign. The units bit of y sits 0x433 - top_y places above bit 0.
            if top_y < 0x3FF {
                return bits.to_float(u64(0x7FF8000000000000))
            }
            if top_y <= 0x433 {
                if (iy & ((u64(1) << (0x433 - top_y)) - 1)) != 0 {
                    return bits.to_float(u64(0x7FF8000000000000))
                }
                flip = (iy >> (0x433 - top_y)) << 63
            }
            xs = i64(ix & POW_ABS)
        } else {
            done: bool, result: f64, magnitude: i64, sign: u64 = pow_special(x, y)
            if done {
                return result
            }
            xs = magnitude
            flip = sign
        }
    }

    // x = 2^k * z with z in [OFF, 2*OFF), k = offset >> 52 and z the bits in `scaled`; i selects the
    // table entry, c = 1/invc lies near z, and log(x) = k*ln2 + log(c) + log1p(r), with r = z*invc - 1
    // formed exactly as rhi + rlo from z's high 32 bits and the rest.
    offset: i64 = xs - POW_LOG_OFF
    i: u64 = u64(offset >> 45) & 127
    scaled: u64 = u64(xs - (offset & -4503599627370496))
    invc: f64 = table.log[i].invc
    rhi: f64 = bits.to_float((scaled + 2147483648) & POW_HIGH32) * invc - 1.0
    rlo: f64 = (bits.to_float(scaled) - bits.to_float((scaled + 2147483648) & POW_HIGH32)) * invc
    r: f64 = rhi + rlo
    // k*ln2 + logc is exact; each sum below keeps its rounding error in the low word.
    t1: f64 = f64(offset >> 52) * POW_LN2_HI + table.log[i].logc
    t2: f64 = t1 + r
    // -r^2/2 = -rhi^2/2 + rlo * (-(r + rhi)/2), and rhi^2 is exact.
    hi: f64 = t2 + -0.5 * rhi * rhi
    r2: f64 = r * r
    // The last term is log1p(r) - r + r^2/2 as a series from r^3 to r^10.
    lo: f64 = (f64(offset >> 52) * POW_LN2_LO + table.log[i].logctail) + (t1 - t2 + r) +
        rlo * (-0.5 * (r + rhi)) + (t2 - hi + -0.5 * rhi * rhi) +
        r2 * r * ((POW_LOG_C3 + r * POW_LOG_C4) + r2 * (POW_LOG_C5 + r * POW_LOG_C6) +
        r2 * r2 * ((POW_LOG_C7 + r * POW_LOG_C8) + r2 * (POW_LOG_C9 + r * POW_LOG_C10)))
    log_hi: f64 = hi + lo

    // y * log(x) as e_hi + e_lo, with 26-bit halves so the leading product is exact. e_lo needs the
    // low word of the logarithm, hi - log_hi + lo, and is formed in er below, its only use.
    l_hi: f64 = bits.to_float(bits.from_float(log_hi) & POW_HIGH26)
    e_hi: f64 = bits.to_float(iy & POW_HIGH26) * l_hi

    // exp(e_hi + e_lo) = 2^e * 2^(j/128) * exp(er), where n = 128*e + j is e_hi/ln2*128 rounded and
    // |er| <= ln2/256. Below 2^-54 the answer rounds to 1; beyond +-745.2 it overflows or underflows.
    // flip holds the sign bit a negative base's odd exponent sets, so xoring it in negates the result.
    top_e: u64 = (bits.from_float(e_hi) >> 52) & 0x7FF
    if top_e < 0x3C9 {
        return bits.to_float(u64(0x3FF0000000000000) ^ flip)
    }
    if top_e >= 0x408 {
        if e_hi > POW_EXP_LIMIT {
            return bits.to_float(u64(0x7FF0000000000000) ^ flip)
        }
        if e_hi < -POW_EXP_LIMIT {
            return bits.to_float(flip)
        }
    }
    shifted: f64 = POW_EXP_INV_LN2N * e_hi + POW_EXP_SHIFT
    n: i64 = i64(bits.from_float(shifted)) - POW_SHIFT_BITS
    er: f64 = e_hi + (shifted - POW_EXP_SHIFT) * POW_EXP_NEG_LN2_HI_N +
        (shifted - POW_EXP_SHIFT) * POW_EXP_NEG_LN2_LO_N +
        ((y - bits.to_float(iy & POW_HIGH26)) * l_hi + y * (log_hi - l_hi + (hi - log_hi + lo)))
    j: u64 = u64(n) & 127
    power: i64 = n >> 7
    if power < -1000 || power > 1023 {
        s: f64 = bits.to_float(table.two_bits[j])
        er2: f64 = er * er
        correction: f64 = table.two_tail[j] + er + er2 * (0.5 + er * POW_EXP_C3) +
            er2 * er2 * (POW_EXP_C4 + er * POW_EXP_C5)
        return bits.to_float(bits.from_float(pow_extreme(s + s * correction, power)) ^ flip)
    }
    scale: f64 = bits.to_float(u64(i64(table.two_bits[j]) + (power << 52)))
    return bits.to_float(bits.from_float(scale + scale * (table.two_tail[j] + er +
        er * er * (0.5 + er * POW_EXP_C3) +
        (er * er) * (er * er) * (POW_EXP_C4 + er * POW_EXP_C5))) ^ flip)
}

// The f32 kernel needs only about 2^-30 relative accuracy, so it runs in plain f64: the same log table
// (no tail word), a series to r^5, and a degree-3 exponential; the final conversion rounds once, into
// the subnormal range or to infinity when the result leaves f32. Every f32 magnitude is a normal f64,
// so only zero, infinite, NaN, and negative bases and non-finite exponents take the f64 path.
pub pow(x: f32, y: f32): f32 {
    ix: u32 = bits.from_float(x)
    iy: u32 = bits.from_float(y)
    if (iy << 9) == 0 {
        if iy == 0x40000000 {
            return x * x
        }
        if iy == 0x3F800000 {
            return x
        }
        if iy == 0xBF800000 {
            return 1.0 / x
        }
        if iy == 0x3F000000 && ix < 0x7F800000 {
            return sqrt(x)
        }
    }
    if ix < 1 || ix >= 0x7F800000 || (iy & 0x7FFFFFFF) >= 0x7F800000 {
        return f32(pow(f64(x), f64(y)))
    }
    xs: i64 = i64(bits.from_float(f64(x)))
    offset: i64 = xs - POW_LOG_OFF
    i: u64 = u64(offset >> 45) & 127
    r: f64 = bits.to_float(u64(xs - (offset & -4503599627370496))) * table.log[i].invc - 1.0
    e: f64 = f64(y) * (f64(offset >> 52) * POW_LN2 + table.log[i].logc + r -
        r * r * (0.5 - r * (POW_LOG_C3 + r * (POW_LOG_C4 + r * POW_LOG_C5))))
    // Beyond |e| = 128 the result overflows or underflows to zero in f32.
    if ((bits.from_float(e) >> 52) & 0x7FF) >= 0x406 {
        if e > 0.0 {
            return bits.to_float(u32(0x7F800000))
        }
        return 0.0
    }
    shifted: f64 = POW_EXP_INV_LN2N * e + POW_EXP_SHIFT
    n: i64 = i64(bits.from_float(shifted)) - POW_SHIFT_BITS
    er: f64 = e - (shifted - POW_EXP_SHIFT) * POW_EXP_LN2_N
    scale: f64 = bits.to_float(u64(i64(table.two_bits[u64(n) & 127]) + ((n >> 7) << 52)))
    return f32(scale + scale * (er + er * er * (0.5 + er * POW_EXP_C3)))
}

kernel_sin(x: f64, y: f64, tail: bool): f64 {
    z: f64 = x * x
    v: f64 = z * x
    r: f64 = SIN_S2 + z * (SIN_S3 + z * (SIN_S4 + z * (SIN_S5 + z * SIN_S6)))
    if !tail {
        return x + v * (SIN_S1 + z * r)
    }
    return x - ((z * (0.5 * y - v * r) - y) - v * SIN_S1)
}

kernel_cos(x: f64, y: f64): f64 {
    z: f64 = x * x
    r: f64 = z * (COS_C1 + z * (COS_C2 + z * (COS_C3 + z * (COS_C4 + z * (COS_C5 + z * COS_C6)))))
    magnitude: f64 = x
    if x < 0.0 {
        magnitude = -x
    }
    if magnitude < 0.3 {
        return 1.0 - (0.5 * z - (z * r - x * y))
    }
    qx: f64 = 0.28125
    if magnitude <= 0.78125 {
        // x/4 truncated to its high word, so the subtraction below stays exact.
        qx = bits.to_float(((bits.from_float(magnitude) >> 32) - u64(0x00200000)) << 32)
    }
    hz: f64 = 0.5 * z - qx
    return (1.0 - qx) - (hz - (z * r - x * y))
}

exponent_field(x: f64): int {
    return int((bits.from_float(x) >> 52) & u64(0x7FF))
}

/* Cody-Waite reduction for 0 < x < 2^20 * pi/2: x = n * pi/2 + (y0 + y1). */
reduce_medium(x: f64): (f64, f64, int) {
    n: int = int(x * INV_PIO2 + 0.5)
    fn: f64 = f64(n)
    r: f64 = x - fn * PIO2_1
    w: f64 = fn * PIO2_1T
    a: f64 = r - w
    j: int = exponent_field(x)
    if j - exponent_field(a) > 16 {
        t: f64 = r
        w = fn * PIO2_2
        r = t - w
        w = fn * PIO2_2T - ((t - r) - w)
        a = r - w
        if j - exponent_field(a) > 49 {
            t = r
            w = fn * PIO2_3
            r = t - w
            w = fn * PIO2_3T - ((t - r) - w)
            a = r - w
        }
    }
    return a, (r - a) - w, n & 3
}

bit_at(limbs: []u64, k: int): u64 {
    if k < 0 || k >= 320 {
        return 0
    }
    return (limbs[usize(k / 32)] >> u64(k % 32)) & 1
}

/* Low part of the exact product a * b, given p = a * b rounded (Dekker). */
product_error(a: f64, b: f64, p: f64): f64 {
    ta: f64 = SPLIT * a
    ah: f64 = ta - (ta - a)
    al: f64 = a - ah
    tb: f64 = SPLIT * b
    bh: f64 = tb - (tb - b)
    bl: f64 = b - bh
    return ((ah * bh - p) + ah * bl + al * bh) + al * bl
}

/* Payne-Hanek reduction for x >= 2^20 * pi/2. With x = m * 2^e (m a 53-bit
 * integer), x * 2/pi mod 4 needs only the limbs of 2/pi whose weight can reach
 * the fraction or the two quotient bits; eight limbs give a 256-bit fixed-point
 * sum whose truncation error, 2^-170 of the product, leaves over 100 good bits
 * even when the fraction cancels to 2^-62 (the worst case for an f64).
 */
reduce_large(x: f64): (f64, f64, int) {
    raw: u64 = bits.from_float(x)
    e: int = exponent_field(x) - 1075
    m: u64 = (raw & u64(0x000FFFFFFFFFFFFF)) | u64(0x0010000000000000)
    ml: u64 = m & u64(0xFFFFFFFF)
    mh: u64 = m >> 32
    first: int = 0
    if e >= 2 {
        first = (e - 2) / 32
    }
    limbs: [10]u64 = [0 : 10]
    for j: int in 0 .. 8 {
        limb: u64 = u64(TWO_OVER_PI[usize(first + j)])
        low: u64 = limb * ml
        high: u64 = limb * mh
        position: int = 7 - j
        limbs[usize(position)] += low & u64(0xFFFFFFFF)
        limbs[usize(position + 1)] += (low >> 32) + (high & u64(0xFFFFFFFF))
        limbs[usize(position + 2)] += high >> 32
    }
    carry: u64 = 0
    for j: int in 0 .. 10 {
        sum: u64 = limbs[usize(j)] + carry
        limbs[usize(j)] = sum & u64(0xFFFFFFFF)
        carry = sum >> 32
    }
    // The product is an integer of weight 2^-fraction_bits; its bits at and
    // above fraction_bits hold the quotient (only the low two matter).
    fraction_bits: int = 256 + 32 * first - e
    quotient: int = int(bit_at(limbs[..], fraction_bits) + 2 * bit_at(limbs[..], fraction_bits + 1))
    negative: bool = bit_at(limbs[..], fraction_bits - 1) == 1
    if negative {
        // Fraction >= 1/2: round the quotient up and use 1 - fraction instead.
        quotient = quotient + 1
        carry = 1
        for j: int in 0 .. 10 {
            sum: u64 = (~limbs[usize(j)] & u64(0xFFFFFFFF)) + carry
            limbs[usize(j)] = sum & u64(0xFFFFFFFF)
            carry = sum >> 32
        }
    }
    top: int = fraction_bits - 1
    for top >= 0 && bit_at(limbs[..], top) == 0 {
        top = top - 1
    }
    if top < 0 {
        return 0.0, 0.0, quotient & 3
    }
    // The fraction as two exact 53-bit pieces, most significant first.
    high_bits: u64 = 0
    low_bits: u64 = 0
    for t: int in 0 .. 53 {
        high_bits = high_bits * 2 + bit_at(limbs[..], top - t)
        low_bits = low_bits * 2 + bit_at(limbs[..], top - 53 - t)
    }
    fh: f64 = f64(high_bits) * bits.to_float(u64(1023 + top - 52 - fraction_bits) << 52)
    fl: f64 = f64(low_bits) * bits.to_float(u64(1023 + top - 105 - fraction_bits) << 52)
    // (fh + fl) * pi/2 as a double-double, using pi/2 = A + B + (C, negligible).
    p: f64 = fh * PIO2_A
    t: f64 = product_error(fh, PIO2_A, p) + (fh * PIO2_B + fl * PIO2_A)
    y0: f64 = p + t
    y1: f64 = t - (y0 - p)
    if negative {
        return -y0, -y1, quotient & 3
    }
    return y0, y1, quotient & 3
}

reduce(x: f64): (f64, f64, int) {
    y0: f64 = 0.0
    y1: f64 = 0.0
    quarter: int = 0
    if x < MEDIUM_LIMIT {
        y0, y1, quarter = reduce_medium(x)
    } else {
        y0, y1, quarter = reduce_large(x)
    }
    return y0, y1, quarter
}

pub sin(value: f64): f64 {
    if isnan(value) || isinf(value) {
        return bits.to_float(u64(0x7FF8000000000000))
    }
    magnitude: f64 = value
    if value < 0.0 {
        magnitude = -value
    }
    if magnitude <= PIO4 {
        if magnitude < SMALL_ARGUMENT {
            return value
        }
        return kernel_sin(value, 0.0, false)
    }
    y0: f64, y1: f64, quarter: int = reduce(magnitude)
    result: f64 = 0.0
    if quarter == 0 {
        result = kernel_sin(y0, y1, true)
    } else if quarter == 1 {
        result = kernel_cos(y0, y1)
    } else if quarter == 2 {
        result = -kernel_sin(y0, y1, true)
    } else {
        result = -kernel_cos(y0, y1)
    }
    if value < 0.0 {
        return -result
    }
    return result
}

pub sin(value: f32): f32 {
    return f32(sin(f64(value)))
}

pub cos(value: f64): f64 {
    if isnan(value) || isinf(value) {
        return bits.to_float(u64(0x7FF8000000000000))
    }
    magnitude: f64 = value
    if value < 0.0 {
        magnitude = -value
    }
    if magnitude <= PIO4 {
        if magnitude < SMALL_ARGUMENT {
            return 1.0
        }
        return kernel_cos(magnitude, 0.0)
    }
    y0: f64, y1: f64, quarter: int = reduce(magnitude)
    if quarter == 0 {
        return kernel_cos(y0, y1)
    }
    if quarter == 1 {
        return -kernel_sin(y0, y1, true)
    }
    if quarter == 2 {
        return -kernel_cos(y0, y1)
    }
    return kernel_sin(y0, y1, true)
}

pub cos(value: f32): f32 {
    return f32(cos(f64(value)))
}
