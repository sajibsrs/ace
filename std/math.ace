/* math — minimal v1 math helpers. Pure Ace, no libm yet; floats and richer
 * functions (sqrt, …) are follow-up work.
 */

pub min[T](a: T, b: T): T {
    if a < b {
        return a
    }
    return b
}

pub max[T](a: T, b: T): T {
    if a > b {
        return a
    }
    return b
}

pub abs[T](x: T): T {
    if x < 0 {
        return -x
    }
    return x
}
