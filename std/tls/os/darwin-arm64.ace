/* Private Darwin entropy layer for the experimental TLS proof.
 * The eventual public std/tls facade does not re-export this operation.
 */

import sys

pub EntropyErr: error {
    5: input_output = "entropy source failed"
    14: address = "entropy destination is invalid"
    22: invalid = "entropy request is invalid"
}

extern "c" {
    c_getentropy(buffer: mut *u8, size: usize): i32 = "getentropy"
}

/* Darwin limits each getentropy(2) request to 256 bytes. Empty storage is
 * already completely filled and must not be indexed for a foreign call.
 */
pub fill(storage: mut []u8): Error {
    at: usize = 0

    for at < storage.len {
        count: usize = storage.len - at
        if count > 256 { count = 256 }

        if c_getentropy(mut &storage[at], count) == 0 {
            at += count
        } else {
            code: i32 = sys.errno()
            if code != sys.EINTR {
                return EntropyErr(code)
            }
        }
    }
    return null
}
