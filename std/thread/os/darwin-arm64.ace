/* thread — darwin-arm64 threads over libSystem's pthread library, and locks
 * and waits over its platform library.
 */

/* A `pthread_t`, which Darwin defines as a pointer. */
pub Thread: distinct usize

pub CreateErr: error {
    1: permission = "thread scheduling not permitted",
    22: invalid = "thread attributes are invalid",
    35: retry = "temporary thread resource limit reached",
}

pub JoinErr: error {
    3: not_found = "no such thread",
    11: deadlock = "thread would join itself",
    22: invalid = "thread is not joinable",
}

extern "c" {
    c_create(thread: *Thread, attributes: *u8, entry: extern "c" (*u8): void, argument: *u8): i32 as "pthread_create"
    c_join(thread: Thread, result: **u8): i32 as "pthread_join"
    c_lock(lock: *u32) as "os_unfair_lock_lock"
    c_unlock(lock: *u32) as "os_unfair_lock_unlock"
    c_wait(address: *u32, value: u64, size: usize, flags: u32): i32 as "os_sync_wait_on_address"
    c_wake_any(address: *u32, size: usize, flags: u32): i32 as "os_sync_wake_by_address_any"
    c_wake_all(address: *u32, size: usize, flags: u32): i32 as "os_sync_wake_by_address_all"
}

/* pthread_create and pthread_join return their error code directly rather
 * than through errno.
 */
pub create(entry: extern "c" (*u8): void, argument: *u8): (Thread, Error) {
    thread: Thread = Thread(0)
    code: i32 = c_create(&thread, null, entry, argument)
    if code != 0 { return Thread(0), CreateErr(code) }

    return thread, null
}

pub join(thread: Thread): Error {
    if thread == Thread(0) { return JoinErr.not_found }
    code: i32 = c_join(thread, null)
    if code != 0 { return JoinErr(code) }

    return null
}

/* An `os_unfair_lock`, whose unlocked value is zero. Unlocking from another
 * thread, or locking twice from one, aborts the process.
 */
pub lock(word: *u32) {
    c_lock(word)
}

pub unlock(word: *u32) {
    c_unlock(word)
}

/* Sleep while `*word` holds `seen`. An interruption or a word already changed
 * returns at once, which the caller treats as a wake.
 */
pub wait(word: *u32, seen: u32) {
    c_wait(word, u64(seen), usize(4), u32(0))
}

/* Waking with no thread waiting fails with ENOENT, which needs no action. */
pub wake_one(word: *u32) {
    c_wake_any(word, usize(4), u32(0))
}

pub wake_all(word: *u32) {
    c_wake_all(word, usize(4), u32(0))
}
