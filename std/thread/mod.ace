/* thread — explicit OS threads. Creation and joining synchronize as the
 * memory model states; the module allocates nothing.
 */

@when(target == "darwin-arm64")
import os: "./os/darwin-arm64.ace"

pub Thread: type = os.Thread
pub CreateErr: type = os.CreateErr
pub JoinErr: type = os.JoinErr

/* Start a thread running `entry(argument)` with the platform's default
 * attributes. The entry is an `extern "c"` definition; the thread ends when
 * it returns. Failure returns `Thread(0)`.
 */
pub create(entry: extern "c" (mut *u8): mut *u8, argument: mut *u8): (Thread, Error) {
    thread: Thread, err: Error = os.create(entry, argument)
    return thread, err
}

/* Wait for `thread`'s entry to return, release the thread, and return the
 * entry's result. Each created thread is joined exactly once; `Thread(0)`
 * fails with `JoinErr.not_found`.
 */
pub join(thread: Thread): (mut *u8, Error) {
    result: mut *u8, err: Error = os.join(thread)
    return result, err
}
