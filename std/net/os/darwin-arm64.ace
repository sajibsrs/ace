/* Darwin net OS layer — allocation-free IPv4 TCP sockets
 * (Darwin/Apple arm64).
 *
 * Public declarations are the target interface consumed by ../mod.ace.
 * The stable user-facing networking surface remains in that facade.
 */

import sys

pub Socket: type = sys.Fd

pub SocketType: enum { tcp }

pub Addr4: struct {
    ip: [4]u8,
    port: u16,
}

/* Every operation has a distinct public error domain. The raw OS error is
 * available through sys.errno() and must be queried immediately on failure.
 */

pub SocketErr: error {
    12: memory = "insufficient memory"
    22: invalid = "invalid socket type"
    23: system_limit = "system socket limit reached"
    24: process_limit = "process socket limit reached"
    43: protocol = "protocol is not supported"
    47: family = "address family is not supported"
    55: buffer = "insufficient network buffer space"
}

pub ReuseAddrErr: error {
    9: descriptor = "invalid socket descriptor"
    22: invalid = "invalid socket option value"
    42: option = "socket option is not available"
    45: unsupported = "operation is not supported by the socket"
}

pub ReusePortErr: error {
    9: descriptor = "invalid socket descriptor"
    22: invalid = "invalid socket option value"
    42: option = "socket option is not available"
    45: unsupported = "operation is not supported by the socket"
}

pub NonblockErr: error {
    9: descriptor = "invalid socket descriptor"
    22: invalid = "invalid descriptor flags"
}

pub BindErr: error {
    9: descriptor = "invalid socket descriptor"
    13: access = "permission denied for the address"
    22: invalid = "invalid socket or address"
    48: in_use = "address is already in use"
    49: unavailable = "address is not available"
}

pub ListenErr: error {
    9: descriptor = "invalid socket descriptor"
    22: invalid = "invalid listen backlog"
    45: unsupported = "socket does not support listening"
}

pub AcceptErr: error {
    4: interrupted = "accept was interrupted"
    9: descriptor = "invalid listener descriptor"
    24: process_limit = "process socket limit reached"
    35: would_block = "no connection is ready to accept"
    53: aborted = "pending connection was aborted"
}

pub ConnectErr: error {
    4: interrupted = "connection attempt was interrupted"
    9: descriptor = "invalid socket descriptor"
    13: access = "permission denied for the address"
    22: invalid = "invalid socket or address"
    35: would_block = "connection cannot complete immediately"
    36: in_progress = "connection is in progress"
    47: family = "address family is not supported"
    48: in_use = "local address is already in use"
    49: unavailable = "local address is not available"
    50: network_down = "network is down"
    51: network_unreachable = "network is unreachable"
    60: timed_out = "connection attempt timed out"
    61: refused = "connection was refused"
    64: host_down = "remote host is down"
    65: host_unreachable = "no route to remote host"
}

pub PendingErrorErr: error {
    9: descriptor = "invalid socket descriptor"
    14: address = "invalid option storage address"
    22: invalid = "invalid socket option query"
    42: option = "socket option is not available"
    45: unsupported = "operation is not supported by the socket"
}

pub ReceiveErr: error {
    4: interrupted = "receive was interrupted"
    9: descriptor = "invalid socket descriptor"
    14: address = "invalid receive buffer address"
    22: invalid = "invalid receive request"
    35: would_block = "receive would block"
    54: reset = "connection was reset"
    57: disconnected = "socket is not connected"
    60: timed_out = "receive timed out"
}

pub SendErr: error {
    4: interrupted = "send was interrupted"
    9: descriptor = "invalid socket descriptor"
    13: access = "permission denied while sending"
    14: address = "invalid send buffer address"
    22: invalid = "invalid send request"
    32: broken_pipe = "connection is closed"
    35: would_block = "send would block"
    40: too_large = "message is too large"
    54: reset = "connection was reset"
    55: buffer = "insufficient network buffer space"
    57: disconnected = "socket is not connected"
    60: timed_out = "send timed out"
}
pub ResolveErr: error {
    2: again = "temporary name-resolution failure"
    3: bad_flags = "invalid name-resolution flags"
    4: failed = "non-recoverable name-resolution failure"
    5: family = "unsupported address family"
    6: memory = "name-resolution memory allocation failed"
    8: not_found = "host or service was not found"
    9: service = "service is unavailable for the socket type"
    10: socket_type = "unsupported socket type"
    11: system = "system error during name resolution"
    14: overflow = "name-resolution result overflowed"
    22: invalid = "invalid name-resolution input or result"
}
pub LocalErr: error {
    9: descriptor = "invalid socket descriptor"
    14: address = "invalid address storage"
    22: invalid = "invalid socket address query"
}

DarwinAddr4: struct {
    length: u8,
    family: u8,
    port: [2]u8,
    ip: [4]u8,
    zero: [8]u8,
}

DarwinAddrInfo: struct {
    flags: i32,
    family: i32,
    socket_type: i32,
    protocol: i32,
    address_length: u32,
    canonical_name: *u8,
    address: *DarwinAddr4,
    next: *DarwinAddrInfo,
}

AF_INET: const i32 = 2
SOCK_STREAM: const i32 = 1
SOL_SOCKET: const i32 = 0xffff
SO_REUSEADDR: const i32 = 0x0004
SO_REUSEPORT: const i32 = 0x0200
SO_ERROR: const i32 = 0x1007
MSG_NOSIGNAL: const i32 = 0x00080000
F_GETFL: const i32 = 3
F_SETFL: const i32 = 4
O_NONBLOCK: const i32 = 0x0004
EINVAL: const i32 = 22
SOCKADDR4_SIZE: const u32 = 16
I32_MAX_USIZE: const usize = 0x7fffffff
HOST_NAME_MAX: const usize = 253

extern "c" {
    c_socket(domain: i32, socket_type: i32, protocol: i32): i32 = "socket"
    c_setsockopt(socket: i32, level: i32, option: i32, value: *i32, length: u32): i32 = "setsockopt"
    c_getsockopt(socket: i32, level: i32, option: i32, value: mut *i32,
                 length: mut *u32): i32 = "getsockopt"
    c_bind(socket: i32, address: *DarwinAddr4, length: u32): i32 = "bind"
    c_listen(socket: i32, backlog: i32): i32 = "listen"
    c_accept(socket: i32, address: mut *DarwinAddr4, length: mut *u32): i32 = "accept"
    c_connect(socket: i32, address: *DarwinAddr4, length: u32): i32 = "connect"
    c_getsockname(socket: i32, address: mut *DarwinAddr4,
                  length: mut *u32): i32 = "getsockname"
    c_recv(socket: i32, buffer: mut *u8, length: usize, flags: i32): i64 = "recv"
    c_send(socket: i32, data: *u8, length: usize, flags: i32): i64 = "send"
    c_fcntl(socket: i32, command: i32, ...): i32 = "fcntl"
    c_getaddrinfo(host: *u8, service: *u8, hints: *DarwinAddrInfo,
                  result: mut **DarwinAddrInfo): i32 = "getaddrinfo"
    c_freeaddrinfo(result: *DarwinAddrInfo) = "freeaddrinfo"
    c_errno(): mut *i32 = "__error"
}

errno_set(value: i32) {
    slot: mut *i32 = c_errno()
    *slot = value
}

to_darwin(address: Addr4): DarwinAddr4 {
    port: [2]u8 = [u8(address.port >> 8), u8(address.port)]
    ip: [4]u8 = [address.ip[0], address.ip[1], address.ip[2], address.ip[3]]
    zero: [8]u8 = [0 : 8]

    return DarwinAddr4 {
        length = u8(SOCKADDR4_SIZE),
        family = u8(AF_INET),
        port = port,
        ip = ip,
        zero = zero,
    }
}

from_darwin(address: DarwinAddr4): Addr4 {
    ip: [4]u8 = [address.ip[0], address.ip[1], address.ip[2], address.ip[3]]

    return Addr4 {
        ip = ip,
        port = (u16(address.port[0]) << 8) | u16(address.port[1]),
    }
}

pub socket(socket_type: SocketType): (Socket, Error) {
    // tcp is the only initial type; its enum zero maps to SOCK_STREAM.
    if socket_type != SocketType.tcp {
        errno_set(EINVAL)
        return Socket(-1), SocketErr.invalid
    }
    raw: i32 = c_socket(AF_INET, SOCK_STREAM, 0)

    if raw == -1 { return Socket(-1), SocketErr(sys.errno()) }
    return Socket(raw), null
}

set_socket_option(sock: Socket, option: i32, enabled: bool, domain: typeid): Error {
    value: i32 = 0

    if enabled { value = 1 }

    if c_setsockopt(i32(sock), SOL_SOCKET, option, &value, u32(sizeof(i32))) == -1 {
        code: i32 = sys.errno()
        if domain == typeid(ReuseAddrErr) { return ReuseAddrErr(code) }
        return ReusePortErr(code)
    }
    return null
}

pub reuse_addr(sock: Socket, enabled: bool): Error {
    return set_socket_option(sock, SO_REUSEADDR, enabled, typeid(ReuseAddrErr))
}

pub reuse_port(sock: Socket, enabled: bool): Error {
    return set_socket_option(sock, SO_REUSEPORT, enabled, typeid(ReusePortErr))
}

pub nonblock(sock: Socket, enabled: bool): Error {
    flags: i32 = c_fcntl(i32(sock), F_GETFL)

    if flags == -1 { return NonblockErr(sys.errno()) }

    if enabled {
        flags = flags | O_NONBLOCK
    } else {
        flags = flags & ~O_NONBLOCK
    }

    if c_fcntl(i32(sock), F_SETFL, flags) == -1 { return NonblockErr(sys.errno()) }
    return null
}

pub bind(sock: Socket, address: Addr4): Error {
    raw: DarwinAddr4 = to_darwin(address)

    if c_bind(i32(sock), &raw, SOCKADDR4_SIZE) == -1 { return BindErr(sys.errno()) }
    return null
}

pub listen(sock: Socket, backlog: usize): Error {
    if backlog > I32_MAX_USIZE {
        errno_set(EINVAL)
        return ListenErr.invalid
    }

    if c_listen(i32(sock), i32(backlog)) == -1 { return ListenErr(sys.errno()) }
    return null
}

pub accept(listener: Socket): (Socket, Addr4, Error) {
    port: [2]u8 = [0 : 2]
    ip: [4]u8 = [0 : 4]
    zero: [8]u8 = [0 : 8]

    raw: DarwinAddr4 = DarwinAddr4 {
        length = 0, family = 0, port = port, ip = ip, zero = zero,
    }
    length: u32 = SOCKADDR4_SIZE
    accepted: i32 = c_accept(i32(listener), mut &raw, mut &length)

    if accepted == -1 { return Socket(-1), blank(Addr4), AcceptErr(sys.errno()) }
    return Socket(accepted), from_darwin(raw), null
}

pub connect(sock: Socket, address: Addr4): Error {
    raw: DarwinAddr4 = to_darwin(address)

    if c_connect(i32(sock), &raw, SOCKADDR4_SIZE) == -1 { return ConnectErr(sys.errno()) }
    return null
}

pub pending_error(sock: Socket): Error {
    value: i32 = 0
    length: u32 = u32(sizeof(i32))

    if c_getsockopt(i32(sock), SOL_SOCKET, SO_ERROR, mut &value,
                    mut &length) == -1 {
        return PendingErrorErr(sys.errno())
    }
    if value != 0 { return ConnectErr(value) }
    return null
}

pub local(sock: Socket): (Addr4, Error) {
    raw: DarwinAddr4 = DarwinAddr4 {
        length = 0,
        family = 0,
        port = [0 : 2],
        ip = [0 : 4],
        zero = [0 : 8],
    }
    length: u32 = SOCKADDR4_SIZE

    if c_getsockname(i32(sock), mut &raw, mut &length) == -1 { return blank(Addr4), LocalErr(sys.errno()) }
    return from_darwin(raw), null
}

pub receive(sock: Socket, buffer: mut []u8): (int, Error) {
    if buffer.len == 0 { return 0, null }
    count: i64 = c_recv(i32(sock), mut &buffer[0], buffer.len, 0)

    if count < 0 { return 0, ReceiveErr(sys.errno()) }
    return int(count), null
}

pub send(sock: Socket, data: []u8): (int, Error) {
    if data.len == 0 { return 0, null }
    count: i64 = c_send(i32(sock), &data[0], data.len, MSG_NOSIGNAL)

    if count < 0 { return 0, SendErr(sys.errno()) }
    return int(count), null
}

pub resolve4(host: string, port: u16, addresses: mut []Addr4): (usize, Error) {
    if host.len > HOST_NAME_MAX || addresses.len == 0 { return usize(0), ResolveErr.invalid }
    storage: [254]u8
    name: mut []u8 = mut storage[0..254]

    for index: usize in usize(0) .. host.len {
        byte: u8 = host[index]

        if byte == 0 { return usize(0), ResolveErr.invalid }
        name[index] = byte
    }
    name[host.len] = u8(0)

    hints: DarwinAddrInfo = DarwinAddrInfo {
        flags = 0,
        family = AF_INET,
        socket_type = SOCK_STREAM,
        protocol = 0,
        address_length = u32(0),
        canonical_name = null,
        address = null,
        next = null,
    }
    result: *DarwinAddrInfo = null

    status: i32 = c_getaddrinfo(&name[0], null, &hints, mut &result)

    if status != 0 || result == null {
        if status == 0 { status = ResolveErr.invalid.code }
        return usize(0), ResolveErr(status)
    }

    written: usize = 0
    current: *DarwinAddrInfo = result

    scan: {
        if current == null || written == addresses.len { break scan }

        if current.family == AF_INET && current.address != null &&
           current.address_length >= SOCKADDR4_SIZE {
            address: Addr4 = from_darwin(*current.address)
            address.port = port
            addresses[written] = address
            written += usize(1)
        }
        current = current.next
        continue scan
    }
    c_freeaddrinfo(result)

    if written == 0 { return usize(0), ResolveErr.invalid }
    return written, null
}
