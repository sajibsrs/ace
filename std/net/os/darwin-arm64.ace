/* Darwin net OS layer — allocation-free IPv4 TCP sockets
 * (Darwin/Apple arm64).
 *
 * The public declarations form the stable Ace networking surface. The
 * private section below them owns Darwin's constants, structures, C link
 * names, byte order, and conversion details.
 */

import sys

pub Socket: type = sys.Fd

pub SocketKind: enum { tcp }

pub Address4: struct {
    ip: [4]u8,
    port: u16,
}

/* Every operation has a distinct public error domain. The raw OS error is
 * available through sys.errno() and must be queried immediately on failure.
 */

pub SocketErr: error
pub SetReuseAddressErr: error
pub SetReusePortErr: error
pub SetNonblockingErr: error
pub BindErr: error
pub ListenErr: error
pub AcceptErr: error
pub ConnectErr: error
pub ReceiveErr: error
pub SendErr: error
pub ResolveErr: error

pub socket(kind: SocketKind): (Socket, Error) {
    result: Socket, err: Error = socket_darwin(kind)
    return result, err
}

pub set_reuse_address(sock: Socket, enabled: bool): Error {
    return set_reuse_address_darwin(sock, enabled)
}

pub set_reuse_port(sock: Socket, enabled: bool): Error {
    return set_reuse_port_darwin(sock, enabled)
}

pub set_nonblocking(sock: Socket, enabled: bool): Error {
    return set_nonblocking_darwin(sock, enabled)
}

pub bind(sock: Socket, address: Address4): Error {
    return bind_darwin(sock, address)
}

pub listen(sock: Socket, backlog: usize): Error {
    return listen_darwin(sock, backlog)
}

pub accept(listener: Socket): (Socket, Address4, Error) {
    address: Address4 = zero_address4()
    accepted: Socket, err: Error = accept_darwin(listener, mut address)
    return accepted, address, err
}

pub connect(sock: Socket, address: Address4): Error {
    return connect_darwin(sock, address)
}

pub receive(sock: Socket, buffer: mut []u8): (int, Error) {
    count: int, err: Error = receive_darwin(sock, buffer)
    return count, err
}

pub send(sock: Socket, data: []u8): (int, Error) {
    count: int, err: Error = send_bytes_darwin(sock, data)
    return count, err
}

pub send(sock: Socket, data: string): (int, Error) {
    count: int, err: Error = send_string_darwin(sock, data)
    return count, err
}

pub resolve4(host: string, port: u16, addresses: mut []Address4): (usize, Error) {
    count: usize, err: Error = resolve4_darwin(host, port, addresses)
    return count, err
}

// --- private Darwin implementation ---------------------------------------

/* Darwin's sockaddr_in layout: length/family bytes, network-order port,
 * four address bytes, then eight zero bytes. Keeping the byte fields explicit
 * prevents platform byte order from leaking into Address4.
 */
DarwinAddress4: struct {
    length: u8,
    family: u8,
    port: [2]u8,
    ip: [4]u8,
    zero: [8]u8,
}

DarwinAddrInfo: struct {
    flags: i32,
    family: i32,
    kind: i32,
    protocol: i32,
    address_length: u32,
    canonical_name: *u8,
    address: *DarwinAddress4,
    next: *DarwinAddrInfo,
}

AF_INET: const i32 = 2
SOCK_STREAM: const i32 = 1
SOL_SOCKET: const i32 = 0xffff
SO_REUSEADDR: const i32 = 0x0004
SO_REUSEPORT: const i32 = 0x0200
MSG_NOSIGNAL: const i32 = 0x00080000
F_GETFL: const i32 = 3
F_SETFL: const i32 = 4
O_NONBLOCK: const i32 = 0x0004
EINVAL: const i32 = 22
SOCKADDR4_SIZE: const u32 = 16
I32_MAX_USIZE: const usize = 0x7fffffff
HOST_NAME_MAX: const usize = 253

extern "c" {
    c_socket(domain: i32, kind: i32, protocol: i32): i32 = "socket"
    c_setsockopt(socket: i32, level: i32, option: i32, value: *i32, length: u32): i32 = "setsockopt"
    c_bind(socket: i32, address: *DarwinAddress4, length: u32): i32 = "bind"
    c_listen(socket: i32, backlog: i32): i32 = "listen"
    c_accept(socket: i32, address: mut *DarwinAddress4, length: mut *u32): i32 = "accept"
    c_connect(socket: i32, address: *DarwinAddress4, length: u32): i32 = "connect"
    c_recv(socket: i32, buffer: mut *u8, length: usize, flags: i32): i64 = "recv"
    c_send(socket: i32, data: *u8, length: usize, flags: i32): i64 = "send"
    c_fcntl(socket: i32, command: i32, ...): i32 = "fcntl"
    c_getaddrinfo(host: *u8, service: *u8, hints: *DarwinAddrInfo,
                  result: mut **DarwinAddrInfo): i32 = "getaddrinfo"
    c_freeaddrinfo(result: *DarwinAddrInfo) = "freeaddrinfo"
    c_errno(): mut *i32 = "__error"
}

errno_set(value: i32) {
    slot: mut *i32 = c_errno()
    ~slot = value
}

to_darwin(address: Address4): DarwinAddress4 {
    port: [2]u8 = [u8(address.port >> 8), u8(address.port)]
    ip: [4]u8 = [address.ip[0], address.ip[1], address.ip[2], address.ip[3]]
    zero: [8]u8 = [u8(0) : 8]

    return DarwinAddress4 {
        length: u8(SOCKADDR4_SIZE),
        family: u8(AF_INET),
        port: port,
        ip: ip,
        zero: zero,
    }
}

from_darwin(address: DarwinAddress4): Address4 {
    ip: [4]u8 = [address.ip[0], address.ip[1], address.ip[2], address.ip[3]]

    return Address4 {
        ip: ip,
        port: (u16(address.port[0]) << 8) | u16(address.port[1]),
    }
}

zero_address4(): Address4 {
    ip: [4]u8 = [u8(0) : 4]

    return Address4 {ip: ip, port: u16(0)}
}

socket_darwin(kind: SocketKind): (Socket, Error) {
    // tcp is the only initial kind; its enum zero maps to SOCK_STREAM.
    if kind != SocketKind.tcp {
        errno_set(EINVAL)
        return Socket(-1), SocketErr(sys.errno())
    }
    raw: i32 = c_socket(AF_INET, SOCK_STREAM, 0)

    if raw == -1 {
        return Socket(-1), SocketErr(sys.errno())
    }
    return Socket(raw), null
}

set_socket_option_darwin(sock: Socket, option: i32, enabled: bool, domain: typeid): Error {
    value: i32 = 0

    if enabled {
        value = 1
    }

    if c_setsockopt(i32(sock), SOL_SOCKET, option, &value, u32(sizeof(i32))) == -1 {
        code: i32 = sys.errno()
        if domain == typeid(SetReuseAddressErr) {
            return SetReuseAddressErr(code)
        }
        return SetReusePortErr(code)
    }
    return null
}

set_reuse_address_darwin(sock: Socket, enabled: bool): Error {
    return set_socket_option_darwin(sock, SO_REUSEADDR, enabled, typeid(SetReuseAddressErr))
}

set_reuse_port_darwin(sock: Socket, enabled: bool): Error {
    return set_socket_option_darwin(sock, SO_REUSEPORT, enabled, typeid(SetReusePortErr))
}

set_nonblocking_darwin(sock: Socket, enabled: bool): Error {
    flags: i32 = c_fcntl(i32(sock), F_GETFL)

    if flags == -1 {
        return SetNonblockingErr(sys.errno())
    }

    if enabled {
        flags = flags | O_NONBLOCK
    } else {
        flags = flags & !O_NONBLOCK
    }

    if c_fcntl(i32(sock), F_SETFL, flags) == -1 {
        return SetNonblockingErr(sys.errno())
    }
    return null
}

bind_darwin(sock: Socket, address: Address4): Error {
    raw: DarwinAddress4 = to_darwin(address)

    if c_bind(i32(sock), &raw, SOCKADDR4_SIZE) == -1 {
        return BindErr(sys.errno())
    }
    return null
}

listen_darwin(sock: Socket, backlog: usize): Error {
    if backlog > I32_MAX_USIZE {
        errno_set(EINVAL)
        return ListenErr(sys.errno())
    }

    if c_listen(i32(sock), i32(backlog)) == -1 {
        return ListenErr(sys.errno())
    }
    return null
}

accept_darwin(listener: Socket, mut address: Address4): (Socket, Error) {
    port: [2]u8 = [u8(0) : 2]
    ip: [4]u8 = [u8(0) : 4]
    zero: [8]u8 = [u8(0) : 8]

    raw: DarwinAddress4 = DarwinAddress4 {
        length: u8(0), family: u8(0), port: port, ip: ip, zero: zero,
    }
    length: u32 = SOCKADDR4_SIZE
    accepted: i32 = c_accept(i32(listener), mut &raw, mut &length)

    if accepted == -1 {
        address = zero_address4()
        return Socket(-1), AcceptErr(sys.errno())
    }
    address = from_darwin(raw)
    return Socket(accepted), null
}

connect_darwin(sock: Socket, address: Address4): Error {
    raw: DarwinAddress4 = to_darwin(address)

    if c_connect(i32(sock), &raw, SOCKADDR4_SIZE) == -1 {
        return ConnectErr(sys.errno())
    }
    return null
}

receive_darwin(sock: Socket, buffer: mut []u8): (int, Error) {
    if len(buffer) == 0 {
        return 0, null
    }
    count: i64 = c_recv(i32(sock), mut &buffer[0], len(buffer), 0)

    if count < 0 {
        return 0, ReceiveErr(sys.errno())
    }
    return int(count), null
}

send_bytes_darwin(sock: Socket, data: []u8): (int, Error) {
    if len(data) == 0 {
        return 0, null
    }
    count: i64 = c_send(i32(sock), &data[0], len(data), MSG_NOSIGNAL)

    if count < 0 {
        return 0, SendErr(sys.errno())
    }
    return int(count), null
}

send_string_darwin(sock: Socket, data: string): (int, Error) {
    if len(data) == 0 {
        return 0, null
    }
    count: i64 = c_send(i32(sock), &data[0], len(data), MSG_NOSIGNAL)

    if count < 0 {
        return 0, SendErr(sys.errno())
    }
    return int(count), null
}

resolve4_darwin(host: string, port: u16, addresses: mut []Address4): (usize, Error) {
    if len(host) > HOST_NAME_MAX || len(addresses) == 0 {
        return usize(0), ResolveErr(EINVAL)
    }
    name: [254]u8

    for index: usize in usize(0) .. len(host) {
        byte: u8 = host[index]

        if byte == 0 {
            return usize(0), ResolveErr(EINVAL)
        }
        name[index] = byte
    }
    name[len(host)] = u8(0)

    hints: DarwinAddrInfo = DarwinAddrInfo {
        flags: 0,
        family: AF_INET,
        kind: SOCK_STREAM,
        protocol: 0,
        address_length: u32(0),
        canonical_name: null,
        address: null,
        next: null,
    }
    result: *DarwinAddrInfo = null

    status: i32 = c_getaddrinfo(&name[0], null, &hints, mut &result)

    if status != 0 || result == null {
        if status == 0 {
            status = EINVAL
        }
        return usize(0), ResolveErr(status)
    }

    written: usize = 0
    current: *DarwinAddrInfo = result

    scan: {
        if current == null || written == len(addresses) {
            break scan
        }

        if current.family == AF_INET && current.address != null &&
           current.address_length >= SOCKADDR4_SIZE {
            address: Address4 = from_darwin(~current.address)
            address.port = port
            addresses[written] = address
            written += usize(1)
        }
        current = current.next
        continue scan
    }
    c_freeaddrinfo(result)

    if written == 0 {
        return usize(0), ResolveErr(EINVAL)
    }
    return written, null
}
