/* Linux net OS layer — allocation-free IPv4 TCP sockets
 * (Linux x86-64 over glibc).
 *
 * Public declarations are the target interface consumed by ../mod.ace.
 * The stable user-facing networking surface remains in that facade.
 */

import sys

pub Socket: type = sys.Fd

pub SocketType: enum { tcp }

pub Addr4: struct {
    pub ip: [4]u8,
    pub port: u16,
}

/* Every operation has a distinct public error domain. The raw OS error is
 * available through sys.errno() and must be queried immediately on failure.
 */

pub SocketErr: error {
    12: memory = "insufficient memory",
    22: invalid = "invalid socket type",
    23: system_limit = "system socket limit reached",
    24: process_limit = "process socket limit reached",
    93: protocol = "protocol is not supported",
    97: family = "address family is not supported",
    105: buffer = "insufficient network buffer space",
}

pub ReuseaddrErr: error {
    9: descriptor = "invalid socket descriptor",
    22: invalid = "invalid socket option value",
    92: option = "socket option is not available",
    95: unsupported = "operation is not supported by the socket",
}

pub ReuseportErr: error {
    9: descriptor = "invalid socket descriptor",
    22: invalid = "invalid socket option value",
    92: option = "socket option is not available",
    95: unsupported = "operation is not supported by the socket",
}

pub NonblockErr: error {
    9: descriptor = "invalid socket descriptor",
    22: invalid = "invalid descriptor flags",
}

pub BindErr: error {
    9: descriptor = "invalid socket descriptor",
    13: access = "permission denied for the address",
    22: invalid = "invalid socket or address",
    98: in_use = "address is already in use",
    99: unavailable = "address is not available",
}

pub ListenErr: error {
    9: descriptor = "invalid socket descriptor",
    22: invalid = "invalid listen backlog",
    95: unsupported = "socket does not support listening",
}

pub AcceptErr: error {
    4: interrupted = "accept was interrupted",
    9: descriptor = "invalid listener descriptor",
    11: would_block = "no connection is ready to accept",
    24: process_limit = "process socket limit reached",
    103: aborted = "pending connection was aborted",
}

pub ConnectErr: error {
    4: interrupted = "connection attempt was interrupted",
    9: descriptor = "invalid socket descriptor",
    11: would_block = "connection cannot complete immediately",
    13: access = "permission denied for the address",
    22: invalid = "invalid socket or address",
    97: family = "address family is not supported",
    98: in_use = "local address is already in use",
    99: unavailable = "local address is not available",
    100: network_down = "network is down",
    101: network_unreachable = "network is unreachable",
    110: timed_out = "connection attempt timed out",
    111: refused = "connection was refused",
    112: host_down = "remote host is down",
    113: host_unreachable = "no route to remote host",
    115: in_progress = "connection is in progress",
}

pub PendingErrorErr: error {
    9: descriptor = "invalid socket descriptor",
    14: address = "invalid option storage address",
    22: invalid = "invalid socket option query",
    92: option = "socket option is not available",
    95: unsupported = "operation is not supported by the socket",
}

pub ReceiveErr: error {
    4: interrupted = "receive was interrupted",
    9: descriptor = "invalid socket descriptor",
    11: would_block = "receive would block",
    14: address = "invalid receive buffer address",
    22: invalid = "invalid receive request",
    104: reset = "connection was reset",
    107: disconnected = "socket is not connected",
    110: timed_out = "receive timed out",
}

pub SendErr: error {
    4: interrupted = "send was interrupted",
    9: descriptor = "invalid socket descriptor",
    11: would_block = "send would block",
    13: access = "permission denied while sending",
    14: address = "invalid send buffer address",
    22: invalid = "invalid send request",
    32: broken_pipe = "connection is closed",
    90: too_large = "message is too large",
    104: reset = "connection was reset",
    105: buffer = "insufficient network buffer space",
    107: disconnected = "socket is not connected",
    110: timed_out = "send timed out",
}

/* glibc's getaddrinfo status codes are negative (<netdb.h> EAI_*); invalid
 * is the local EINVAL for input this layer rejects before the call.
 */
pub ResolveErr: error {
    -12: overflow = "name-resolution result overflowed",
    -11: system = "system error during name resolution",
    -10: memory = "name-resolution memory allocation failed",
    -8: service = "service is unavailable for the socket type",
    -7: socket_type = "unsupported socket type",
    -6: family = "unsupported address family",
    -4: failed = "non-recoverable name-resolution failure",
    -3: again = "temporary name-resolution failure",
    -2: not_found = "host or service was not found",
    -1: bad_flags = "invalid name-resolution flags",
    22: invalid = "invalid name-resolution input or result",
}

pub LocalErr: error {
    9: descriptor = "invalid socket descriptor",
    14: address = "invalid address storage",
    22: invalid = "invalid socket address query",
}

/* struct sockaddr_in: a host-order family, then the network-order port. */
LinuxAddr4: struct {
    family: u16,
    port: [2]u8,
    ip: [4]u8,
    zero: [8]u8,
}

/* glibc's struct addrinfo: the address precedes the canonical name. */
LinuxAddrInfo: struct {
    flags: i32,
    family: i32,
    socket_type: i32,
    protocol: i32,
    address_length: u32,
    address: *LinuxAddr4,
    canonical_name: *u8,
    next: *LinuxAddrInfo,
}

static_assert(sizeof(LinuxAddr4) == 16 && offsetof(LinuxAddr4, ip) == 4)
static_assert(sizeof(LinuxAddrInfo) == 48 && offsetof(LinuxAddrInfo, address) == 24)

AF_INET: const i32 = 2
SOCK_STREAM: const i32 = 1
SOL_SOCKET: const i32 = 1
SO_REUSEADDR: const i32 = 2
SO_REUSEPORT: const i32 = 15
SO_ERROR: const i32 = 4
MSG_NOSIGNAL: const i32 = 0x4000
F_GETFL: const i32 = 3
F_SETFL: const i32 = 4
O_NONBLOCK: const i32 = 0x0800
EINVAL: const i32 = 22
SOCKADDR4_SIZE: const u32 = 16
I32_MAX_USIZE: const usize = 0x7fffffff
HOST_NAME_MAX: const usize = 253

extern "c" {
    c_socket(domain: i32, socket_type: i32, protocol: i32): i32 as "socket"
    c_setsockopt(socket: i32, level: i32, option: i32, value: *i32, length: u32): i32 as "setsockopt"
    c_getsockopt(socket: i32, level: i32, option: i32, value: *i32, length: *u32): i32 as "getsockopt"
    c_bind(socket: i32, address: *LinuxAddr4, length: u32): i32 as "bind"
    c_listen(socket: i32, backlog: i32): i32 as "listen"
    c_accept(socket: i32, address: *LinuxAddr4, length: *u32): i32 as "accept"
    c_connect(socket: i32, address: *LinuxAddr4, length: u32): i32 as "connect"
    c_getsockname(socket: i32, address: *LinuxAddr4, length: *u32): i32 as "getsockname"
    c_recv(socket: i32, buffer: *u8, length: usize, flags: i32): i64 as "recv"
    c_send(socket: i32, data: *u8, length: usize, flags: i32): i64 as "send"
    c_fcntl(socket: i32, command: i32, ...): i32 as "fcntl"
    c_getaddrinfo(host: *u8, service: *u8, hints: *LinuxAddrInfo, result: **LinuxAddrInfo): i32 as "getaddrinfo"
    c_freeaddrinfo(result: *LinuxAddrInfo) as "freeaddrinfo"
    c_errno(): *i32 as "__errno_location"
}

errno_set(value: i32) {
    slot: *i32 = c_errno()
    *slot = value
}

to_linux(address: Addr4): LinuxAddr4 {
    port: [2]u8 = [u8(address.port >> 8), u8(address.port)]
    ip: [4]u8 = [address.ip[0], address.ip[1], address.ip[2], address.ip[3]]
    zero: [8]u8 = [0 : 8]

    return LinuxAddr4 {
        family = u16(AF_INET),
        port = port,
        ip = ip,
        zero = zero,
    }
}

from_linux(address: LinuxAddr4): Addr4 {
    ip: [4]u8 = [address.ip[0], address.ip[1], address.ip[2], address.ip[3]]

    return Addr4 {
        ip = ip,
        port = (u16(address.port[0]) << 8) | u16(address.port[1]),
    }
}

pub socket(socket_type: SocketType): (Socket, Error) {
    // tcp is the only initial type, so socket_type maps to SOCK_STREAM.
    raw: i32 = c_socket(AF_INET, SOCK_STREAM, 0)
    if raw == -1 { return Socket(-1), SocketErr(sys.errno()) }

    return Socket(raw), null
}

set_socket_option(sock: Socket, option: i32, enabled: bool, domain: typeid): Error {
    value: i32 = 0

    if enabled { value = 1 }

    if c_setsockopt(i32(sock), SOL_SOCKET, option, &value, u32(sizeof(i32))) == -1 {
        code: i32 = sys.errno()
        if domain == typeid(ReuseaddrErr) { return ReuseaddrErr(code) }
        return ReuseportErr(code)
    }
    return null
}

pub reuseaddr(sock: Socket, enabled: bool): Error {
    return set_socket_option(sock, SO_REUSEADDR, enabled, typeid(ReuseaddrErr))
}

pub reuseport(sock: Socket, enabled: bool): Error {
    return set_socket_option(sock, SO_REUSEPORT, enabled, typeid(ReuseportErr))
}

pub nonblock(sock: Socket, enabled: bool): Error {
    flags: i32 = c_fcntl(i32(sock), F_GETFL)
    if flags == -1 { return NonblockErr(sys.errno()) }

    if enabled {
        flags = flags | O_NONBLOCK
    } else {
        flags = flags & ~O_NONBLOCK
    }

    if c_fcntl(i32(sock), F_SETFL, flags) == -1 { return NonblockErr(sys.errno()) }
    return null
}

pub bind(sock: Socket, address: Addr4): Error {
    raw: LinuxAddr4 = to_linux(address)

    if c_bind(i32(sock), &raw, SOCKADDR4_SIZE) == -1 { return BindErr(sys.errno()) }
    return null
}

pub listen(sock: Socket, backlog: usize): Error {
    if backlog > I32_MAX_USIZE {
        errno_set(EINVAL)
        return ListenErr.invalid
    }

    if c_listen(i32(sock), i32(backlog)) == -1 { return ListenErr(sys.errno()) }
    return null
}

pub accept(listener: Socket): (Socket, Addr4, Error) {
    port: [2]u8 = [0 : 2]
    ip: [4]u8 = [0 : 4]
    zero: [8]u8 = [0 : 8]

    raw: LinuxAddr4 = LinuxAddr4 {
        family = 0,
        port = port,
        ip = ip,
        zero = zero,
    }
    length: u32 = SOCKADDR4_SIZE
    accepted: i32 = c_accept(i32(listener), &raw, &length)
    if accepted == -1 { return Socket(-1), blank(Addr4), AcceptErr(sys.errno()) }

    return Socket(accepted), from_linux(raw), null
}

pub connect(sock: Socket, address: Addr4): Error {
    raw: LinuxAddr4 = to_linux(address)

    if c_connect(i32(sock), &raw, SOCKADDR4_SIZE) == -1 { return ConnectErr(sys.errno()) }
    return null
}

pub pending_error(sock: Socket): Error {
    value: i32 = 0
    length: u32 = u32(sizeof(i32))

    if c_getsockopt(i32(sock), SOL_SOCKET, SO_ERROR, &value, &length) == -1 {
        return PendingErrorErr(sys.errno())
    }
    if value != 0 { return ConnectErr(value) }
    return null
}

pub local(sock: Socket): (Addr4, Error) {
    raw: LinuxAddr4 = LinuxAddr4 {
        family = 0,
        port = [0 : 2],
        ip = [0 : 4],
        zero = [0 : 8],
    }
    length: u32 = SOCKADDR4_SIZE

    if c_getsockname(i32(sock), &raw, &length) == -1 { return blank(Addr4), LocalErr(sys.errno()) }
    return from_linux(raw), null
}

pub receive(sock: Socket, buffer: []u8): (int, Error) {
    if buffer.len == 0 { return 0, null }
    count: i64 = c_recv(i32(sock), &buffer[0], buffer.len, 0)
    if count < 0 { return 0, ReceiveErr(sys.errno()) }

    return int(count), null
}

pub send(sock: Socket, data: []u8): (int, Error) {
    if data.len == 0 { return 0, null }
    count: i64 = c_send(i32(sock), &data[0], data.len, MSG_NOSIGNAL)
    if count < 0 { return 0, SendErr(sys.errno()) }

    return int(count), null
}

pub resolve4(host: string, port: u16, addresses: []Addr4): (usize, Error) {
    if host.len > HOST_NAME_MAX || addresses.len == 0 { return usize(0), ResolveErr.invalid }
    storage: [254]u8
    name: []u8 = storage[0..254]

    for index: usize in usize(0) .. host.len {
        byte: u8 = host[index]

        if byte == 0 { return usize(0), ResolveErr.invalid }
        name[index] = byte
    }
    name[host.len] = u8(0)

    hints: LinuxAddrInfo = LinuxAddrInfo {
        flags = 0,
        family = AF_INET,
        socket_type = SOCK_STREAM,
        protocol = 0,
        address_length = u32(0),
        address = null,
        canonical_name = null,
        next = null,
    }
    result: *LinuxAddrInfo = null

    status: i32 = c_getaddrinfo(&name[0], null, &hints, &result)
    if status != 0 || result == null {
        if status == 0 { status = ResolveErr.invalid.code }
        return usize(0), ResolveErr(status)
    }

    written: usize = 0
    current: *LinuxAddrInfo = result

    scan: {
        if current == null || written == addresses.len { break scan }

        if current.family == AF_INET && current.address != null &&
           current.address_length >= SOCKADDR4_SIZE {
            address: Addr4 = from_linux(*current.address)
            address.port = port
            addresses[written] = address
            written += usize(1)
        }
        current = current.next
        continue scan
    }
    c_freeaddrinfo(result)

    if written == 0 { return usize(0), ResolveErr.invalid }
    return written, null
}
