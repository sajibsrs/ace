/* net — OS-neutral allocation-free networking facade. */

@when(target == "darwin-arm64")
import os: "./os/darwin-arm64.ace"

pub Socket: type = os.Socket
pub SocketKind: type = os.SocketKind
pub Address4: type = os.Address4

pub SocketErr: type = os.SocketErr
pub SetReuseAddressErr: type = os.SetReuseAddressErr
pub SetReusePortErr: type = os.SetReusePortErr
pub SetNonblockingErr: type = os.SetNonblockingErr
pub BindErr: type = os.BindErr
pub ListenErr: type = os.ListenErr
pub AcceptErr: type = os.AcceptErr
pub ConnectErr: type = os.ConnectErr
pub ReceiveErr: type = os.ReceiveErr
pub SendErr: type = os.SendErr
pub ResolveErr: type = os.ResolveErr

pub socket(kind: SocketKind): (Socket, Error) {
    result: Socket, err: Error = os.socket(kind)
    return result, err
}

pub set_reuse_address(sock: Socket, enabled: bool): Error {
    return os.set_reuse_address(sock, enabled)
}

pub set_reuse_port(sock: Socket, enabled: bool): Error {
    return os.set_reuse_port(sock, enabled)
}

pub set_nonblocking(sock: Socket, enabled: bool): Error {
    return os.set_nonblocking(sock, enabled)
}

pub bind(sock: Socket, address: Address4): Error {
    return os.bind(sock, address)
}

pub listen(sock: Socket, backlog: usize): Error {
    return os.listen(sock, backlog)
}

pub accept(listener: Socket): (Socket, Address4, Error) {
    accepted: Socket, address: Address4, err: Error = os.accept(listener)
    return accepted, address, err
}

pub connect(sock: Socket, address: Address4): Error {
    return os.connect(sock, address)
}

pub receive(sock: Socket, buffer: mut []u8): (int, Error) {
    count: int, err: Error = os.receive(sock, buffer)
    return count, err
}

pub send(sock: Socket, data: []u8): (int, Error) {
    count: int, err: Error = os.send(sock, data)
    return count, err
}

pub send(sock: Socket, data: string): (int, Error) {
    count: int, err: Error = os.send(sock, data)
    return count, err
}

pub resolve4(host: string, port: u16, addresses: mut []Address4): (usize, Error) {
    count: usize, err: Error = os.resolve4(host, port, addresses)
    return count, err
}
