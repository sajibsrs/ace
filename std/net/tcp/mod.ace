/* tcp — pure-Ace blocking IPv4 TCP composition over net. */

import net
import poll
import sys

/* `active` marks a live handle: canonical zero (`Listener {}`) is the empty
 * handle, since descriptor zero is itself a valid descriptor.
 */
pub Listener: struct {
    socket: net.Socket = net.Socket(0),
    active: bool = false,
}

pub Interest: enum {
    none,
    read,
    write,
    both,
}

pub Conn: struct {
    socket: net.Socket = net.Socket(0),
    interest: Interest = Interest.none,
    send_offset: usize = 0,
    active: bool = false,
}

pub Event: union {
    none,
    data: usize,
    sent: usize,
    connected,
    disconnected,
    failed: Error,
}

pub ReceiveAllErr: error {
    0: incomplete = "connection closed before the requested bytes were received",
}

pub SendAllErr: error {
    0: stalled = "connection made no progress while sending",
}

connection(sock: net.Socket, interest: Interest): Conn {
    return Conn {
        socket = sock,
        interest = interest,
        active = true,
    }
}

with_read(interest: Interest, enabled: bool): Interest {
    if enabled {
        if interest == Interest.write || interest == Interest.both { return Interest.both }
        return Interest.read
    }
    if interest == Interest.both { return Interest.write }
    if interest == Interest.read { return Interest.none }
    return interest
}

with_write(interest: Interest, enabled: bool): Interest {
    if enabled {
        if interest == Interest.read || interest == Interest.both { return Interest.both }
        return Interest.write
    }
    if interest == Interest.both { return Interest.read }
    if interest == Interest.write { return Interest.none }
    return interest
}

pub listen(address: net.Addr4, backlog: usize): (Listener, Error) {
    sock: net.Socket, err: Error = net.socket(net.SocketType.tcp)
    if err != null { return Listener {}, err }

    err = net.reuseaddr(sock, true)
    if err == null { err = net.bind(sock, address) }
    if err == null { err = net.listen(sock, backlog) }
    if err != null {
        sys.close(sock)
        return Listener {}, err
    }

    listener: Listener = Listener {
        socket = sock,
        active = true,
    }
    return listener, null
}

pub connect(address: net.Addr4): (Conn, Error) {
    sock: net.Socket, err: Error = net.socket(net.SocketType.tcp)
    if err != null { return Conn {}, err }

    err = net.connect(sock, address)
    if err != null {
        sys.close(sock)
        return Conn {}, err
    }

    return connection(sock, Interest.read), null
}

pub connect_nonblock(address: net.Addr4): (Conn, Error) {
    sock: net.Socket, err: Error = net.socket(net.SocketType.tcp)
    if err != null { return Conn {}, err }

    err = net.nonblock(sock, true)
    if err != null {
        sys.close(sock)
        return Conn {}, err
    }

    connect_attempt: {
        err = net.connect(sock, address)
        if err != null && err.domain == typeid(net.ConnectErr) && err.code == sys.EINTR { continue connect_attempt }
    }
    if err == null { return connection(sock, Interest.read), null }
    if err.domain == typeid(net.ConnectErr) && err.code == sys.EINPROGRESS {
        return connection(sock, Interest.write), null
    }
    sys.close(sock)
    return Conn {}, err
}

pub listen_nonblock(address: net.Addr4, backlog: usize): (Listener, Error) {
    sock: net.Socket, err: Error = net.socket(net.SocketType.tcp)
    if err != null { return Listener {}, err }

    err = net.nonblock(sock, true)
    if err == null { err = net.reuseaddr(sock, true) }
    if err == null { err = net.bind(sock, address) }
    if err == null { err = net.listen(sock, backlog) }
    if err != null {
        sys.close(sock)
        return Listener {}, err
    }

    listener: Listener = Listener {
        socket = sock,
        active = true,
    }
    return listener, null
}

pub local(listener: Listener): (net.Addr4, Error) {
    address: net.Addr4, err: Error = net.local(listener.socket)
    return address, err
}

pub accept(listener: Listener): (Conn, net.Addr4, Error) {
    sock: net.Socket, address: net.Addr4, err: Error = net.accept(listener.socket)
    if err != null { return Conn {}, address, err }

    return connection(sock, Interest.read), address, null
}

pub accept_nonblock(listener: Listener): (Conn, net.Addr4, Error) {
    sock: net.Socket, address: net.Addr4, err: Error = net.accept(listener.socket)
    if err != null { return Conn {}, address, err }

    err = net.nonblock(sock, true)
    if err != null {
        sys.close(sock)
        return Conn {}, address, err
    }

    return connection(sock, Interest.read), address, null
}

/* Registers the connection's descriptor with exactly its current interest. */
pub watch(q: poll.Queue, connection: Conn): Error {
    return poll.watch(
        q,
        connection.socket,
        connection.interest == Interest.read || connection.interest == Interest.both,
        connection.interest == Interest.write || connection.interest == Interest.both,
    )
}

pub interest(conn: Conn): Interest {
    return conn.interest
}

pub progress_connect(conn: *Conn): Event {
    err: Error = net.pending_error(conn.socket)
    if err == null {
        conn.interest = Interest.read
        return Event.connected
    }

    conn.interest = Interest.none
    return Event.failed(err)
}

pub progress_receive(conn: *Conn, dest: []u8): Event {
    if dest.len == 0 {
        conn.interest = with_read(conn.interest, false)
        return Event.none
    }
    receive_attempt: {
        count: int, err: Error = net.receive(conn.socket, dest)
        if err != null {
            if err.domain == typeid(net.ReceiveErr) && err.code == sys.EINTR { continue receive_attempt }
            if err.domain == typeid(net.ReceiveErr) && (err.code == sys.EAGAIN || err.code == sys.EWOULDBLOCK) {
                conn.interest = with_read(conn.interest, true)
                return Event.none
            }
            conn.interest = Interest.none
            if err.domain == typeid(net.ReceiveErr) && err.code == sys.ECONNRESET { return Event.disconnected }
            return Event.failed(err)
        }
        if count == 0 {
            conn.interest = Interest.none
            return Event.disconnected
        }

        conn.interest = with_read(conn.interest, false)
        return Event.data(usize(count))
    }
}

pub progress_send(conn: *Conn, src: []u8): Event {
    if src.len == 0 {
        conn.send_offset = usize(0)
        conn.interest = with_write(conn.interest, false)
        return Event.sent(usize(0))
    }
    send_attempt: {
        count: int, err: Error = net.send(conn.socket, src[conn.send_offset..])
        if err != null {
            if err.domain == typeid(net.SendErr) && err.code == sys.EINTR { continue send_attempt }
            if err.domain == typeid(net.SendErr) && (err.code == sys.EAGAIN || err.code == sys.EWOULDBLOCK) {
                conn.interest = with_write(conn.interest, true)
                return Event.none
            }
            conn.interest = Interest.none
            if err.domain == typeid(net.SendErr) && err.code == sys.ECONNRESET { return Event.disconnected }
            return Event.failed(err)
        }
        if count == 0 {
            conn.interest = with_write(conn.interest, true)
            return Event.none
        }

        conn.send_offset += usize(count)
        if conn.send_offset == src.len {
            conn.send_offset = usize(0)
            conn.interest = with_write(conn.interest, false)
        } else {
            conn.interest = with_write(conn.interest, true)
        }
        return Event.sent(usize(count))
    }
}

/* One receive into `buffer`: the byte count, zero at end of stream. */
pub receive(connection: Conn, buffer: []u8): (int, Error) {
    return net.receive(connection.socket, buffer)
}

pub receive_all(connection: Conn, buffer: []u8): (usize, Error) {
    received: usize = 0

    for received < buffer.len {
        count: int, err: Error = net.receive(connection.socket, buffer[received..])
        if err != null {
            if err.domain == typeid(net.ReceiveErr) && err.code == sys.EINTR { continue }
            return received, err
        }
        if count == 0 { return received, ReceiveAllErr.incomplete }

        received += usize(count)
    }
    return received, null
}

pub send_all(connection: Conn, data: []u8): (usize, Error) {
    if data.len == 0 { return 0, null }
    sent: usize = 0

    for sent < data.len {
        count: int, err: Error = net.send(connection.socket, data[sent..])
        if err != null {
            if err.domain == typeid(net.SendErr) && err.code == sys.EINTR { continue }
            return sent, err
        }
        if count == 0 { return sent, SendAllErr.stalled }

        sent += usize(count)
    }
    return sent, null
}

/* A no-op returning null on an inactive handle, so a deferred close may
 * precede the constructor's error check.
 */
pub close(listener: *Listener): Error {
    if !listener.active { return null }
    err: Error = sys.close(listener.socket)
    *listener = Listener {}
    return err
}

pub close(connection: *Conn): Error {
    if !connection.active { return null }
    err: Error = sys.close(connection.socket)
    *connection = Conn {}
    return err
}
