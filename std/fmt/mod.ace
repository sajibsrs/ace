/* fmt — allocation-free text output. */

@when(target == "darwin-arm64")
import os: "./os/darwin-arm64.ace"

@when(target == "linux-x64")
import os: "./os/linux-x64.ace"

import sys

import decimal: @float_decimal
import formatting: @formatting

/* The descriptor every output call but `printf(fd, ...)` writes to. */
STDOUT: const i32 = 1

pub print(text: string): int {
    if text.len == 0 { return 0 }
    total: int = 0

    for 0 .. int(text.len) {
        n: int = os.write(STDOUT, &text[total], text.len - usize(total))
        if n <= 0 { return n }

        total += n

        if usize(total) == text.len { return total }
    }
    return total
}

pub print(value: int): int {
    storage: [20]u8
    digits: mut []u8 = mut storage[0..20]
    at: int = 20
    remaining: int = value
    negative: bool = value < 0

    for 0 .. 20 {
        at -= 1
        remainder: int = remaining % 10

        if negative {
            digits[at] = u8(48 - remainder)
        } else {
            digits[at] = u8(48 + remainder)
        }
        remaining = remaining / 10

        if remaining == 0 { break }
    }

    if negative {
        at -= 1
        digits[at] = u8(45)
    }
    size: usize = usize(20 - at)
    total: int = 0

    for 0 .. int(size) {
        n: int = os.write(STDOUT, &digits[at + total], size - usize(total))
        if n <= 0 { return n }

        total += n

        if usize(total) == size { return total }
    }
    return total
}

pub print(value: uint): int {
    storage: [20]u8
    digits: mut []u8 = mut storage[0..20]
    at: int = 20
    remaining: uint = value

    for 0 .. 20 {
        at -= 1
        remainder: uint = remaining % 10
        digits[at] = u8(48 + remainder)
        remaining = remaining / 10

        if remaining == 0 { break }
    }
    size: usize = usize(20 - at)
    total: int = 0

    for 0 .. int(size) {
        n: int = os.write(STDOUT, &digits[at + total], size - usize(total))
        if n <= 0 { return n }

        total += n

        if usize(total) == size { return total }
    }
    return total
}

pub print(value: usize): int {
    storage: [20]u8
    digits: mut []u8 = mut storage[0..20]
    at: int = 20
    remaining: usize = value

    for 0 .. 20 {
        at -= 1
        remainder: usize = remaining % 10
        digits[at] = u8(48 + remainder)
        remaining = remaining / 10

        if remaining == 0 { break }
    }
    size: usize = usize(20 - at)
    total: int = 0

    for 0 .. int(size) {
        n: int = os.write(STDOUT, &digits[at + total], size - usize(total))
        if n <= 0 { return n }

        total += n

        if usize(total) == size { return total }
    }
    return total
}

// Byte flush to fd with partial-write retry, shared by the numeric overloads
// and the printf sinks.
write_bytes(fd: i32, data: []u8): int {
    total: int = 0

    for 0 .. int(data.len) {
        n: int = os.write(fd, &data[total], data.len - usize(total))
        if n <= 0 { return n }

        total += n

        if usize(total) == data.len { return total }
    }
    return total
}

/*
 * Formats the shortest round-trip digits in the canonical notation: decimal
 * for scientific exponents -6 through 20, otherwise scientific like 1.5e-7.
 * The sign comes first; no trailing zeros are added.
 */
format_float(negative: bool, digits: []u8, count: int, decpt: i32): int {
    storage: [48]u8
    out: mut []u8 = mut storage[0..48]
    at: int = 0

    if negative {
        out[0] = u8(45)
        at = 1
    }
    exp: i32 = decpt - 1
    dp: int = int(decpt)

    if exp >= -6 && exp <= 20 {
        if dp <= 0 {
            out[at] = u8(48)
            out[at + 1] = u8(46)
            at += 2
            zeros: int = 0 - dp

            for 0 .. zeros {
                out[at] = u8(48)
                at += 1
            }

            for d: int in 0 .. count {
                out[at] = digits[d]
                at += 1
            }
        } else if dp >= count {
            for d: int in 0 .. count {
                out[at] = digits[d]
                at += 1
            }
            pad: int = dp - count

            for 0 .. pad {
                out[at] = u8(48)
                at += 1
            }
        } else {
            for d: int in 0 .. dp {
                out[at] = digits[d]
                at += 1
            }
            out[at] = u8(46)
            at += 1

            for d: int in dp .. count {
                out[at] = digits[d]
                at += 1
            }
        }
    } else {
        out[at] = digits[0]
        at += 1

        if count > 1 {
            out[at] = u8(46)
            at += 1

            for d: int in 1 .. count {
                out[at] = digits[d]
                at += 1
            }
        }
        out[at] = u8(101)
        at += 1
        e: i32 = exp

        if e < 0 {
            out[at] = u8(45)
            at += 1
            e = 0 - e
        }
        hi: i32 = e / 100
        mid: i32 = (e / 10) % 10
        lo: i32 = e % 10

        if hi != 0 {
            out[at] = u8(48 + hi)
            at += 1
            out[at] = u8(48 + mid)
            at += 1
        } else if mid != 0 {
            out[at] = u8(48 + mid)
            at += 1
        }
        out[at] = u8(48 + lo)
        at += 1
    }
    return write_bytes(STDOUT, out[0..at])
}

pub print(value: f64): int {
    one: f64 = 1.0
    zero: f64 = 0.0

    if value != value { return print("nan") }

    if value - value != zero {
        if value < zero { return print("-inf") }
        return print("inf")
    }
    negative: bool = value < zero
    mag: f64 = value

    if negative { mag = zero - value }

    if mag == zero {
        /*
         * The comparison operators cannot see the sign of a zero, so the sign
         * bit is read through the reciprocal: 1/-0 is -inf.
         */
        if one / value < zero { return print("-0") }
        return print("0")
    }
    digits: [24]u8
    dv: mut []u8 = mut digits[0..17]
    converted: decimal.Decimal = decimal.binary64(mag, dv)
    return format_float(negative, dv, converted.count, converted.point)
}

pub print(value: f32): int {
    pone: f32 = 1.0
    zero: f32 = 0.0

    if value != value { return print("nan") }

    if value - value != zero {
        if value < zero { return print("-inf") }
        return print("inf")
    }
    negative: bool = value < zero
    mag: f32 = value

    if negative { mag = zero - value }

    if mag == zero {
        /*
         * The comparison operators cannot see the sign of a zero, so the sign
         * bit is read through the reciprocal: 1/-0 is -inf.
         */
        if pone / value < zero { return print("-0") }
        return print("0")
    }
    digits: [24]u8
    dv: mut []u8 = mut digits[0..9]
    converted: decimal.Decimal = decimal.binary32(mag, dv)
    return format_float(negative, dv, converted.count, converted.point)
}

/*
 * The compiler's checked printf lowering opens a sink over fixed storage in
 * the caller's frame, writes each format piece into it through the shared
 * formatting.piece* writers, and closes it: normally one write per call.
 * Complete success returns the total byte count; a failed write stops the
 * call and its non-positive result is returned unchanged.
 */
print_open(mut sink: formatting.Sink, storage: mut []u8) {
    sink = formatting.Sink.init(storage, STDOUT, write_bytes)
}

/* The opener of `printf(fd, ...)`: the same sink, draining to fd. */
print_to_open(mut sink: formatting.Sink, storage: mut []u8, fd: sys.Fd) {
    sink = formatting.Sink.init(storage, i32(fd), write_bytes)
}

print_close(mut sink: formatting.Sink): int {
    mut sink.flush()
    if sink.failed { return sink.status }

    return sink.drained
}

/*
 * Output buffered across calls: `mut buffer.printf(...)` appends to the
 * caller's storage, writing to the descriptor only when it fills and on
 * `flush`, as Go's bufio.Writer. Empty storage writes every piece through.
 * A failed write sticks: later calls write nothing and return its result.
 */
pub Buffer: struct {
    sink: formatting.Sink,
    mark: int,                  // bytes taken before the current printf
}

pub Buffer.init(fd: sys.Fd, storage: mut []u8): Buffer {
    return Buffer { sink = formatting.Sink.init(storage, i32(fd), write_bytes), mark = 0 }
}

/* A buffer that keeps its output in storage, as error context does: bytes
 * past the end are dropped, never written, and `text` reads what was kept.
 */
pub Buffer.init(storage: mut []u8): Buffer {
    return Buffer { sink = formatting.Sink.init(storage, 0, null), mark = 0 }
}

/* The bytes kept so far: all of them for a storage-only buffer. */
pub Buffer.text(self): string {
    return self.sink.storage[0..self.sink.used]
}

/* The bytes a storage-only buffer dropped for want of room. */
pub Buffer.dropped(self): usize {
    return self.sink.dropped
}

/* Writes the buffered bytes: their count, or the failing write's result. */
pub Buffer.flush(mut self): int {
    before: int = self.sink.drained
    mut self.sink.flush()
    if self.sink.failed { return self.sink.status }

    return self.sink.drained - before
}

/* Formats like `printf` into the buffer, written to its descriptor when the
 * buffer fills or on `flush` rather than before returning; the same checks and
 * lowering. Returns the bytes the call took, or the failing write's result.
 */
pub Buffer.printf(mut self, format: string): int {
    before: int = self.sink.drained + int(self.sink.used)
    mut self.sink.put(format)
    if self.sink.failed { return self.sink.status }

    return self.sink.drained + int(self.sink.used) - before
}

/* The opener and closer of `Buffer.printf`, whose pieces write through the
 * buffer's sink in place. The closer returns the bytes the call took, or the
 * failing write's result.
 */
Buffer.print_open(mut self) {
    self.mark = self.sink.drained + int(self.sink.used)
}

Buffer.print_close(mut self): int {
    if self.sink.failed { return self.sink.status }

    return self.sink.drained + int(self.sink.used) - self.mark
}

/*
 * This body serves the zero-conversion case and gives the public name an
 * ordinary declaration. Calls are otherwise validated and lowered directly
 * by the compiler; this format-dependent function is never a first-class value.
 */
pub printf(format: string): int {
    return print(format)
}

/* `printf` to the descriptor fd instead of standard output, as C's `dprintf`;
 * the same checks, lowering, and result.
 */
pub printf(fd: sys.Fd, format: string): int {
    if format.len == 0 { return 0 }

    return write_bytes(i32(fd), format)
}

/*
 * Closes a println after a nonempty value write: a non-positive result is
 * returned with no newline attempted; the newline's own failure is returned
 * unchanged; full success returns the combined byte count including the newline.
 * The string overload handles its empty success before calling this helper.
 */
finish_line(written: int): int {
    if written <= 0 { return written }
    n: int = print("\n")
    if n < 0 { return n }

    return written + n
}

pub println(text: string): int {
    if text.len == 0 { return print("\n") }
    return finish_line(print(text))
}

pub println(value: int): int {
    return finish_line(print(value))
}

pub println(value: uint): int {
    return finish_line(print(value))
}

pub println(value: usize): int {
    return finish_line(print(value))
}

pub println(value: f32): int {
    return finish_line(print(value))
}

pub println(value: f64): int {
    return finish_line(print(value))
}
