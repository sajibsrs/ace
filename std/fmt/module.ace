}

// Byte flush with partial-write retry, shared by the numeric overloads.
write_bytes(data: []u8): int {
    total: int = 0

    for attempt: int in 0 .. int(len(data)) {
        n: int = os.write(&data[total], len(data) - usize(total))

        if n <= 0 {
            return n
        }
        total += n

        if usize(total) == len(data) {
            return total
        }
    }
    return total
}

/*
 * Formats the shortest round-trip digits in the canonical notation: decimal
 * for scientific exponents -6 through 20, otherwise scientific like 1.5e-7.
 * The sign comes first; no trailing zeros are added.
 */
format_float(negative: bool, digits: []u8, count: int, decpt: i32): int {
    out: [48]u8
    at: int = 0

    if negative {
        out[0] = u8(45)
        at = 1
    }
    exp: i32 = decpt - 1
    dp: int = int(decpt)

    if exp >= -6 && exp <= 20 {
        if dp <= 0 {
            out[at] = u8(48)
            out[at + 1] = u8(46)
            at += 2
            zeros: int = 0 - dp

            for z: int in 0 .. zeros {
                out[at] = u8(48)
                at += 1
            }

            for d: int in 0 .. count {
                out[at] = digits[d]
                at += 1
            }
        } else if dp >= count {
            for d: int in 0 .. count {
                out[at] = digits[d]
                at += 1
            }
            pad: int = dp - count

            for z: int in 0 .. pad {
                out[at] = u8(48)
                at += 1
            }
        } else {
            for d: int in 0 .. dp {
                out[at] = digits[d]
                at += 1
            }
            out[at] = u8(46)
            at += 1

            for d: int in dp .. count {
                out[at] = digits[d]
                at += 1
            }
        }
    } else {
        out[at] = digits[0]
        at += 1

        if count > 1 {
            out[at] = u8(46)
            at += 1

            for d: int in 1 .. count {
                out[at] = digits[d]
                at += 1
            }
        }
        out[at] = u8(101)
        at += 1
        e: i32 = exp

        if e < 0 {
            out[at] = u8(45)
            at += 1
            e = 0 - e
        }
        hi: i32 = e / 100
        mid: i32 = (e / 10) % 10
        lo: i32 = e % 10

        if hi != 0 {
            out[at] = u8(48 + hi)
            at += 1
            out[at] = u8(48 + mid)
            at += 1
        } else if mid != 0 {
            out[at] = u8(48 + mid)
            at += 1
        }
        out[at] = u8(48 + lo)
        at += 1
    }
    return write_bytes(out[0..at])
}

pub print(value: f64): int {
    one: f64 = 1.0
    zero: f64 = 0.0

    if value != value {
        return print("nan")
    }

    if value - value != zero {
        if value < zero {
            return print("-inf")
        }
        return print("inf")
    }
    negative: bool = value < zero
    mag: f64 = value

    if negative {
        mag = zero - value
    }

    if mag == zero {
        /*
         * The comparison operators cannot see the sign of a zero, so the sign
         * bit is read through the reciprocal: 1/-0 is -inf.
         */
        if one / value < zero {
            return print("-0")
        }
        return print("0")
    }
    digits: [24]u8
    dv: mut []u8 = mut digits[0..17]
    converted: decimal.Decimal = decimal.binary64(mag, dv)
    return format_float(negative, dv, converted.count, converted.point)
}

pub print(value: f32): int {
    pone: f32 = 1.0
    zero: f32 = 0.0

    if value != value {
        return print("nan")
    }

    if value - value != zero {
        if value < zero {
            return print("-inf")
        }
        return print("inf")
    }
    negative: bool = value < zero
    mag: f32 = value

    if negative {
        mag = zero - value
    }

    if mag == zero {
        /*
         * The comparison operators cannot see the sign of a zero, so the sign
         * bit is read through the reciprocal: 1/-0 is -inf.
         */
        if pone / value < zero {
            return print("-0")
        }
        return print("0")
    }
    digits: [24]u8
    dv: mut []u8 = mut digits[0..9]
    converted: decimal.Decimal = decimal.binary32(mag, dv)
    return format_float(negative, dv, converted.count, converted.point)
}

/*
 * The compiler's checked printf lowering resolves its helpers through exact-
 * type specialization lookup: each shape below is a specialized template, and
 * the format interpreter's concrete argument type selects the specialization
 * with the equal type-argument tuple. Helpers use fixed stack storage and the
 * shared partial-write retry path; no runtime dispatch or metadata exists.
 */
print_counted[T](value: T): int specialized

print_precision[T](value: T, precision: usize): int specialized

print_radix[T](value: T, radix: u8, uppercase: bool): int specialized

print_counted[string](text: string): int {
    return print(text)
}

print_counted[int](value: int): int {
    return print(value)
}

print_counted[uint](value: uint): int {
    return print(value)
}

print_counted[usize](value: usize): int {
    return print(value)
}

print_counted[u8](value: u8): int {
    out: [1]u8 = [value]
    return write_bytes(out[0..1])
}

print_radix[uint](value: uint, radix: u8, uppercase: bool): int {
    out: [64]u8
    at: int = 64
    remaining: uint = value

    for digit: int in 0 .. 64 {
        at -= 1
        d: uint = remaining % uint(radix)

        if d < 10 {
            out[at] = u8(48 + d)
        } else if uppercase {
            out[at] = u8(55 + d)
        } else {
            out[at] = u8(87 + d)
        }
        remaining = remaining / uint(radix)

        if remaining == 0 {
            break
        }
    }
    return write_bytes(out[at..64])
}

print_radix[usize](value: usize, radix: u8, uppercase: bool): int {
    out: [64]u8
    at: int = 64
    remaining: usize = value

    for digit: int in 0 .. 64 {
        at -= 1
        d: usize = remaining % usize(radix)

        if d < 10 {
            out[at] = u8(48 + d)
        } else if uppercase {
            out[at] = u8(55 + d)
        } else {
            out[at] = u8(87 + d)
        }
        remaining = remaining / usize(radix)

        if remaining == 0 {
            break
        }
    }
    return write_bytes(out[at..64])
}

write_fixed(value: decimal.Decimal, digits: []u8, precision: usize): int {
    if value.kind == decimal.Kind.nan {
        return print_counted[string]("nan")
    }

    if value.kind == decimal.Kind.infinity {
        if value.negative {
            return print_counted[string]("-inf")
        }
        return print_counted[string]("inf")
    }
    out: [640]u8
    at: int = 0

    if value.negative {
        out[at] = u8(45)
        at += 1
    }
    point: int = int(value.point)
    places: int = int(precision)

    if value.kind == decimal.Kind.zero {
        out[at] = u8(48)
        at += 1
    } else if point <= 0 {
        out[at] = u8(48)
        at += 1
    } else {
        for i: int in 0 .. point {
            if i < value.count {
                out[at] = digits[i]
            } else {
                out[at] = u8(48)
            }
            at += 1
        }
    }

    if places != 0 {
        out[at] = u8(46)
        at += 1

        for i: int in 0 .. places {
            source: int = point + i

            if value.kind != decimal.Kind.zero && source >= 0 && source < value.count {
                out[at] = digits[source]
            } else {
                out[at] = u8(48)
            }
            at += 1
        }
    }
    return write_bytes(out[0..at])
}

print_precision[f64](value: f64, precision: usize): int {
    digits: [640]u8
    view: mut []u8 = mut digits[0..640]
    converted: decimal.Decimal = decimal.fixed64(value, precision, view)
    return write_fixed(converted, view, precision)
}

print_precision[f32](value: f32, precision: usize): int {
    digits: [640]u8
    view: mut []u8 = mut digits[0..640]
    converted: decimal.Decimal = decimal.fixed32(value, precision, view)
    return write_fixed(converted, view, precision)
}

/*
 * This body serves the zero-conversion case and gives the public name an
 * ordinary declaration. Calls are otherwise validated and lowered directly
 * by the compiler; this format-dependent function is never a first-class value.
 */
pub printf(format: string): int {
    return print_counted[string](format)
}

/*
 * Closes a println after a nonempty value write: a non-positive result is
 * returned with no newline attempted; the newline's own failure is returned
 * unchanged; full success returns the combined byte count including the newline.
 * The string overload handles its empty success before calling this helper.
 */
finish_line(written: int): int {
    if written <= 0 {
        return written
    }
    n: int = print("\n")

    if n < 0 {
        return n
    }
    return written + n
}

pub println(text: string): int {
    if len(text) == 0 {
        return print("\n")
    }
    return finish_line(print(text))
}

pub println(value: int): int {
    return finish_line(print(value))
}

pub println(value: uint): int {
    return finish_line(print(value))
}

pub println(value: usize): int {
    return finish_line(print(value))
}

pub println(value: f32): int {
    return finish_line(print(value))
}

pub println(value: f64): int {
    return finish_line(print(value))
}
