/* fmt — allocation-free text output. */

@when(target == "darwin-arm64")
import os: "./os/darwin-arm64.ace"
import decimal: @float_decimal.ace

pub print(text: string): int {
    if len(text) == 0 {
        return 0
    }
    total: int = 0

    for attempt: int in 0 .. int(len(text)) {
        n: int = os.write(&text[total], len(text) - usize(total))

        if n <= 0 {
            return n
        }
        total += n

        if usize(total) == len(text) {
            return total
        }
    }
    return total
}

pub print(value: int): int {
    digits: [20]u8
    at: int = 20
    remaining: int = value
    negative: bool = value < 0

    for digit: int in 0 .. 20 {
        at -= 1
        remainder: int = remaining % 10

        if negative {
            digits[at] = u8(48 - remainder)
        } else {
            digits[at] = u8(48 + remainder)
        }
        remaining = remaining / 10

        if remaining == 0 {
            break
        }
    }

    if negative {
        at -= 1
        digits[at] = u8(45)
    }
    size: usize = usize(20 - at)
    total: int = 0

    for attempt: int in 0 .. int(size) {
        n: int = os.write(&digits[at + total], size - usize(total))

        if n <= 0 {
            return n
        }
        total += n

        if usize(total) == size {
            return total
        }
    }
    return total
}

