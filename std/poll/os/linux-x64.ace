/* Linux poll OS layer — allocation-free level-triggered epoll readiness. */

import sys

pub Queue: distinct sys.Fd

pub Event: struct {
    fd: sys.Fd,
    readable: bool,
    writable: bool,
    error: bool,
    hangup: bool,
}

pub QueueErr: error {
    12: memory = "insufficient memory for readiness queue",
    23: system_limit = "system descriptor limit reached",
    24: process_limit = "process descriptor limit reached",
}

pub WatchErr: error {
    1: unsupported = "descriptor does not support readiness",
    9: descriptor = "invalid queue or watched descriptor",
    12: memory = "insufficient memory for readiness registration",
    22: invalid = "at least one readiness interest is required",
    28: watch_limit = "readiness registration limit reached",
}

pub UnwatchErr: error {
    2: not_found = "descriptor was not watched",
    9: descriptor = "invalid queue or watched descriptor",
    12: memory = "insufficient memory while removing readiness registration",
}

pub WaitErr: error {
    4: interrupted = "readiness wait was interrupted",
    9: descriptor = "invalid readiness queue descriptor",
    14: address = "invalid readiness event storage",
    22: invalid = "event storage must not be empty",
}

pub FOREVER: const u64 = 0xffffffffffffffff

/* Linux x86-64's packed struct epoll_event from <sys/epoll.h>. The data word
 * carries the fd in its low 32 bits and the registered interest above it, so
 * wait can report a hangup as readable only for read interest (as a kqueue
 * read filter's EOF does) without a registration side table.
 */
@packed
LinuxEpollEvent: struct {
    events: u32,
    data: u64,
}

static_assert(sizeof(LinuxEpollEvent) == 12)

EPOLL_CTL_ADD: const i32 = 1
EPOLL_CTL_DEL: const i32 = 2
EPOLL_CTL_MOD: const i32 = 3
EPOLLIN: const u32 = 0x0001
EPOLLOUT: const u32 = 0x0004
EPOLLERR: const u32 = 0x0008
EPOLLHUP: const u32 = 0x0010
EPOLLRDHUP: const u32 = 0x2000
READ_INTEREST: const u64 = 0x100000000
EEXIST: const i32 = 17
EINVAL: const i32 = 22
NSEC_PER_MSEC: const u64 = 1000000
MAX_TIMEOUT_MS: const u64 = 0x7fffffff
MAX_WAIT_EVENTS: const usize = 64

extern "c" {
    c_epoll_create1(flags: i32): i32 as "epoll_create1"
    c_epoll_ctl(queue: i32, operation: i32, fd: i32, event: mut *LinuxEpollEvent): i32 as "epoll_ctl"
    c_epoll_wait(queue: i32, events: mut *LinuxEpollEvent, event_count: i32, timeout_ms: i32): i32 as "epoll_wait"
    c_errno(): mut *i32 as "__errno_location"
}

errno_set(value: i32) {
    slot: mut *i32 = c_errno()
    *slot = value
}

pub queue(): (Queue, Error) {
    fd: i32 = c_epoll_create1(0)
    if fd == -1 { return Queue(sys.Fd(-1)), QueueErr(sys.errno()) }

    return Queue(sys.Fd(fd)), null
}

/* One registration replaces the fd's complete interest atomically: add, or
 * modify when the fd is already watched.
 */
pub watch(q: Queue, fd: sys.Fd, readable: bool, writable: bool): Error {
    if !readable && !writable {
        errno_set(EINVAL)
        return WatchErr.invalid
    }
    change: LinuxEpollEvent = LinuxEpollEvent {
        events = u32(0),
        data = u64(u32(i32(fd))),
    }

    if readable {
        change.events = change.events | EPOLLIN | EPOLLRDHUP
        change.data = change.data | READ_INTEREST
    }

    if writable { change.events = change.events | EPOLLOUT }

    if c_epoll_ctl(i32(sys.Fd(q)), EPOLL_CTL_ADD, i32(fd), mut &change) == 0 { return null }

    if sys.errno() != EEXIST { return WatchErr(sys.errno()) }

    if c_epoll_ctl(i32(sys.Fd(q)), EPOLL_CTL_MOD, i32(fd), mut &change) == -1 {
        return WatchErr(sys.errno())
    }
    return null
}

pub unwatch(q: Queue, fd: sys.Fd): Error {
    change: LinuxEpollEvent = blank(LinuxEpollEvent)
    if c_epoll_ctl(i32(sys.Fd(q)), EPOLL_CTL_DEL, i32(fd), mut &change) == -1 {
        return UnwatchErr(sys.errno())
    }
    return null
}

pub wait(q: Queue, events: mut []Event, timeout_ns: u64): (usize, Error) {
    if events.len == 0 {
        errno_set(EINVAL)
        return usize(0), WaitErr.invalid
    }
    capacity: usize = events.len

    if capacity > MAX_WAIT_EVENTS { capacity = MAX_WAIT_EVENTS }

    // epoll takes whole milliseconds: round up so a wait never ends early,
    // and cap at the i32 maximum (about 24.8 days).
    timeout_ms: i32 = -1

    if timeout_ns != FOREVER {
        milliseconds: u64 = timeout_ns / NSEC_PER_MSEC

        if timeout_ns % NSEC_PER_MSEC != 0 { milliseconds = milliseconds + 1 }

        if milliseconds > MAX_TIMEOUT_MS { milliseconds = MAX_TIMEOUT_MS }

        timeout_ms = i32(milliseconds)
    }
    raw: [64]LinuxEpollEvent = [blank(LinuxEpollEvent) : 64]
    ready: i32 = c_epoll_wait(i32(sys.Fd(q)), mut &raw[0], i32(capacity), timeout_ms)
    if ready == -1 { return usize(0), WaitErr(sys.errno()) }

    // epoll reports each fd at most once per wait, so events map one to one.
    for index: usize in 0 .. usize(ready) {
        bits: u32 = raw[index].events
        data: u64 = raw[index].data
        hangup: bool = (bits & (EPOLLHUP | EPOLLRDHUP)) != 0
        events[index] = Event {
            fd = sys.Fd(i32(u32(data & 0xffffffff))),
            readable = (bits & EPOLLIN) != 0 || (hangup && (data & READ_INTEREST) != 0),
            writable = (bits & EPOLLOUT) != 0,
            error = (bits & EPOLLERR) != 0,
            hangup = hangup,
        }
    }
    return usize(ready), null
}
