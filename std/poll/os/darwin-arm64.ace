/* Darwin poll OS layer — allocation-free kqueue readiness. */

import sys

pub Queue: distinct sys.Fd

pub Event: struct {
    pub fd: sys.Fd,
    pub readable: bool,
    pub writable: bool,
    pub error: bool,
    pub hangup: bool,
}

pub QueueErr: error {
    12: memory = "insufficient memory for readiness queue",
    23: system_limit = "system descriptor limit reached",
    24: process_limit = "process descriptor limit reached",
}

pub WatchErr: error {
    9: descriptor = "invalid queue or watched descriptor",
    12: memory = "insufficient memory for readiness registration",
    22: invalid = "at least one readiness interest is required",
}

pub UnwatchErr: error {
    2: not_found = "descriptor was not watched",
    9: descriptor = "invalid queue or watched descriptor",
    12: memory = "insufficient memory while removing readiness registration",
}

pub WaitErr: error {
    4: interrupted = "readiness wait was interrupted",
    9: descriptor = "invalid readiness queue descriptor",
    14: address = "invalid readiness event storage",
    22: invalid = "event storage must not be empty",
}

pub FOREVER: const u64 = 0xffffffffffffffff

DarwinKevent: struct {
    ident: usize,
    filter: i16,
    flags: u16,
    fflags: u32,
    data: i64,
    udata: *u8,
}

DarwinTimespec: struct {
    seconds: i64,
    nanoseconds: i64,
}

EVFILT_READ: const i16 = -1
EVFILT_WRITE: const i16 = -2
EV_ADD: const u16 = 0x0001
EV_DELETE: const u16 = 0x0002
EV_ENABLE: const u16 = 0x0004
EV_ERROR: const u16 = 0x4000
EV_EOF: const u16 = 0x8000
EINVAL: const i32 = 22
ENOENT: const i32 = 2
NSEC_PER_SEC: const u64 = 1000000000
MAX_WAIT_EVENTS: const usize = 64

extern "c" {
    c_kqueue(): i32 as "kqueue"
    c_kevent(
        queue: i32,
        changes: *DarwinKevent,
        change_count: i32,
        events: mut *DarwinKevent,
        event_count: i32,
        timeout: *DarwinTimespec,
    ): i32 as "kevent"
}

kevent_change(fd: sys.Fd, filter: i16, flags: u16): DarwinKevent {
    return DarwinKevent {
        ident = usize(i32(fd)),
        filter = filter,
        flags = flags,
        fflags = u32(0),
        data = i64(0),
        udata = null,
    }
}

pub queue(): (Queue, Error) {
    fd: i32 = c_kqueue()
    if fd == -1 { return Queue(sys.Fd(-1)), QueueErr(sys.errno()) }

    return Queue(sys.Fd(fd)), null
}

pub watch(q: Queue, fd: sys.Fd, readable: bool, writable: bool): Error {
    if !readable && !writable {
        sys.errno(EINVAL)
        return WatchErr.invalid
    }
    read_flags: u16 = EV_DELETE
    write_flags: u16 = EV_DELETE

    if readable { read_flags = EV_ADD | EV_ENABLE }

    if writable { write_flags = EV_ADD | EV_ENABLE }

    if change_filter(q, fd, EVFILT_READ, read_flags) == -1 &&
       !(read_flags == EV_DELETE && sys.errno() == ENOENT) {
        return WatchErr(sys.errno())
    }

    if change_filter(q, fd, EVFILT_WRITE, write_flags) == -1 &&
       !(write_flags == EV_DELETE && sys.errno() == ENOENT) {
        return WatchErr(sys.errno())
    }
    return null
}

pub unwatch(q: Queue, fd: sys.Fd): Error {
    removed: bool = false
    result: i32 = change_filter(q, fd, EVFILT_READ, EV_DELETE)
    if result == 0 {
        removed = true
    } else if sys.errno() != ENOENT {
        return UnwatchErr.not_found
    }

    result = change_filter(q, fd, EVFILT_WRITE, EV_DELETE)
    if result == 0 {
        removed = true
    } else if sys.errno() != ENOENT {
        return UnwatchErr(sys.errno())
    }

    if !removed {
        sys.errno(ENOENT)
        return UnwatchErr(sys.errno())
    }
    return null
}

change_filter(q: Queue, fd: sys.Fd, filter: i16, flags: u16): i32 {
    change: DarwinKevent = kevent_change(fd, filter, flags)
    return c_kevent(i32(sys.Fd(q)), &change, 1, null, 0, null)
}

pub wait(q: Queue, events: mut []Event, timeout_ns: u64): (usize, Error) {
    if events.len == 0 {
        sys.errno(EINVAL)
        return usize(0), WaitErr.invalid
    }
    capacity: usize = events.len

    if capacity > MAX_WAIT_EVENTS { capacity = MAX_WAIT_EVENTS }

    timeout: DarwinTimespec = DarwinTimespec {
        seconds = i64(0),
        nanoseconds = i64(0),
    }
    timeout_pointer: *DarwinTimespec = null

    if timeout_ns != FOREVER {
        timeout.seconds = i64(timeout_ns / NSEC_PER_SEC)
        timeout.nanoseconds = i64(timeout_ns % NSEC_PER_SEC)
        timeout_pointer = &timeout
    }
    raw: [64]DarwinKevent = [blank(DarwinKevent) : 64]
    ready: i32 = c_kevent(i32(sys.Fd(q)), null, 0, mut &raw[0], i32(capacity), timeout_pointer)
    if ready == -1 { return usize(0), WaitErr(sys.errno()) }

    written: usize = 0

    for index: usize in 0 .. usize(ready) {
        fd: sys.Fd = sys.Fd(i32(raw[index].ident))
        slot: usize = written

        for candidate: usize in 0 .. written {
            if events[candidate].fd == fd { slot = candidate }
        }

        if slot == written {
            events[slot] = Event {
                fd = fd,
                readable = false,
                writable = false,
                error = false,
                hangup = false,
            }
            written += usize(1)
        }

        if raw[index].filter == EVFILT_READ { events[slot].readable = true }

        if raw[index].filter == EVFILT_WRITE { events[slot].writable = true }

        if (raw[index].flags & EV_ERROR) != 0 { events[slot].error = true }

        if (raw[index].flags & EV_EOF) != 0 { events[slot].hangup = true }
    }
    return written, null
}
