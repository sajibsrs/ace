/* Darwin poll OS layer — allocation-free kqueue readiness. */

import sys

pub Queue: distinct sys.Fd

pub Event: struct {
    pub fd: sys.Fd,
    pub context: *u8 = null,
    pub readable: bool,
    pub writable: bool,
    pub error: bool,
    pub hangup: bool,
}

pub QueueErr: error {
    12: memory = "insufficient memory for readiness queue",
    23: system_limit = "system descriptor limit reached",
    24: process_limit = "process descriptor limit reached",
}

pub WatchErr: error {
    9: descriptor = "invalid queue or watched descriptor",
    12: memory = "insufficient memory for readiness registration",
    22: invalid = "at least one readiness interest is required",
}

pub UnwatchErr: error {
    2: not_found = "descriptor was not watched",
    9: descriptor = "invalid queue or watched descriptor",
    12: memory = "insufficient memory while removing readiness registration",
}

pub WaitErr: error {
    4: interrupted = "readiness wait was interrupted",
    9: descriptor = "invalid readiness queue descriptor",
    14: address = "invalid readiness event storage",
    22: invalid = "event storage must not be empty",
}

pub FOREVER: const u64 = 0xffffffffffffffff

DarwinKevent: struct {
    ident: usize,
    filter: i16,
    flags: u16,
    fflags: u32,
    data: i64,
    udata: *u8,
}

DarwinTimespec: struct {
    seconds: i64,
    nanoseconds: i64,
}

EVFILT_READ: const i16 = -1
EVFILT_WRITE: const i16 = -2
EV_ADD: const u16 = 0x0001
EV_DELETE: const u16 = 0x0002
EV_ENABLE: const u16 = 0x0004
EV_ERROR: const u16 = 0x4000
EV_EOF: const u16 = 0x8000
EINVAL: const i32 = 22
ENOENT: const i32 = 2
NSEC_PER_SEC: const u64 = 1000000000
STACK_EVENTS: const usize = 64
MAX_KEVENTS: const usize = 0x7fffffff

extern "c" {
    c_kqueue(): i32 as "kqueue"
    c_kevent(
        queue: i32,
        changes: *DarwinKevent,
        change_count: i32,
        events: *DarwinKevent,
        event_count: i32,
        timeout: *DarwinTimespec,
    ): i32 as "kevent"
}

kevent_change(fd: sys.Fd, filter: i16, flags: u16, context: *u8): DarwinKevent {
    return DarwinKevent {
        ident = usize(i32(fd)),
        filter = filter,
        flags = flags,
        fflags = u32(0),
        data = i64(0),
        udata = context,
    }
}

pub queue(): (Queue, Error) {
    fd: i32 = c_kqueue()
    if fd == -1 { return Queue(sys.Fd(-1)), QueueErr(sys.errno()) }

    return Queue(sys.Fd(fd)), null
}

pub watch(q: Queue, fd: sys.Fd, readable: bool, writable: bool): Error {
    return watch(q, fd, readable, writable, null)
}

pub watch(q: Queue, fd: sys.Fd, readable: bool, writable: bool, context: *u8): Error {
    if !readable && !writable {
        sys.errno(EINVAL)
        return WatchErr.invalid
    }
    read_flags: u16 = EV_DELETE
    write_flags: u16 = EV_DELETE

    if readable { read_flags = EV_ADD | EV_ENABLE }

    if writable { write_flags = EV_ADD | EV_ENABLE }

    if change_filter(q, fd, EVFILT_READ, read_flags, context) == -1 &&
       !(read_flags == EV_DELETE && sys.errno() == ENOENT) {
        return WatchErr(sys.errno())
    }

    if change_filter(q, fd, EVFILT_WRITE, write_flags, context) == -1 &&
       !(write_flags == EV_DELETE && sys.errno() == ENOENT) {
        return WatchErr(sys.errno())
    }
    return null
}

pub unwatch(q: Queue, fd: sys.Fd): Error {
    removed: bool = false
    result: i32 = change_filter(q, fd, EVFILT_READ, EV_DELETE, null)
    if result == 0 {
        removed = true
    } else if sys.errno() != ENOENT {
        return UnwatchErr(sys.errno())
    }

    result = change_filter(q, fd, EVFILT_WRITE, EV_DELETE, null)
    if result == 0 {
        removed = true
    } else if sys.errno() != ENOENT {
        return UnwatchErr(sys.errno())
    }

    if !removed {
        sys.errno(ENOENT)
        return UnwatchErr(sys.errno())
    }
    return null
}

change_filter(q: Queue, fd: sys.Fd, filter: i16, flags: u16, context: *u8): i32 {
    change: DarwinKevent = kevent_change(fd, filter, flags, context)
    return c_kevent(i32(sys.Fd(q)), &change, 1, null, 0, null)
}

/* Collects raw kevents into whichever holds more: a stack buffer or the
 * caller's storage viewed as kevents, which are larger than an Event and no
 * more aligned, so each Event lands at or before the bytes of the kevent it
 * came from, after that kevent is read. `slots` maps an fd below 1024 to its
 * Event; it is never cleared, so a hit counts only when that Event has the fd.
 */
pub wait(q: Queue, events: []Event, timeout_ns: u64): (usize, Error) {
    if events.len == 0 {
        sys.errno(EINVAL)
        return usize(0), WaitErr.invalid
    }
    timeout: DarwinTimespec = DarwinTimespec {
        seconds = i64(0),
        nanoseconds = i64(0),
    }
    timeout_pointer: *DarwinTimespec = null

    if timeout_ns != FOREVER {
        timeout.seconds = i64(timeout_ns / NSEC_PER_SEC)
        timeout.nanoseconds = i64(timeout_ns % NSEC_PER_SEC)
        timeout_pointer = &timeout
    }
    stack: [64]DarwinKevent
    raw: []DarwinKevent = stack[0..STACK_EVENTS]

    if events.len < STACK_EVENTS { raw = stack[0..events.len] }

    shared: usize = events.len * sizeof(Event) / sizeof(DarwinKevent)

    if shared > STACK_EVENTS {
        if shared > MAX_KEVENTS { shared = MAX_KEVENTS }
        raw = []DarwinKevent(*DarwinKevent(*u8(&events[0])), shared)
    }
    ready: i32 = c_kevent(i32(sys.Fd(q)), null, 0, &raw[0], i32(raw.len), timeout_pointer)
    if ready == -1 { return usize(0), WaitErr(sys.errno()) }

    slots: [1024]u32
    written: usize = 0

    for index: usize in 0 .. usize(ready) {
        change: DarwinKevent = raw[index]
        fd: sys.Fd = sys.Fd(i32(change.ident))

        slot: usize = written
        key: usize = usize(i32(fd))

        if key < 1024 {
            candidate: usize = usize(slots[key])
            if candidate < written && events[candidate].fd == fd { slot = candidate }
        } else {
            for other: usize in 0 .. written {
                if events[other].fd == fd { slot = other }
            }
        }

        if slot == written {
            if key < 1024 { slots[key] = u32(written) }
            events[written] = Event {
                fd = fd,
                context = change.udata,
                readable = false,
                writable = false,
                error = false,
                hangup = false,
            }
            written += usize(1)
        }

        if change.filter == EVFILT_READ { events[slot].readable = true }

        if change.filter == EVFILT_WRITE { events[slot].writable = true }

        if (change.flags & EV_ERROR) != 0 { events[slot].error = true }

        if (change.flags & EV_EOF) != 0 { events[slot].hangup = true }
    }

    for index: usize in 0 .. written {
        if events[index].context != null { events[index].fd = sys.Fd(-1) }
    }
    return written, null
}
