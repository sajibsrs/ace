// Integer CPU benchmark shared with cpu.c. Keep the recurrence bounded so
// debug mode measures guards without intentionally overflowing.
import fmt
import time

main(): int {
    iterations: usize = 5000000
    state: usize = 1

    started: u64 = time.awake()
    for i: usize in 0 .. iterations { state = (state * 48271 + (i % 97)) % 2147483647 }
    elapsed: u64 = time.awake() - started

    fmt.printf("iterations: %u\nelapsed ns: %u\nchecksum: %u\n", iterations, usize(elapsed), state)
    return 0
}
