// Benchmarks Game n-body, shared with nbody.c, nbody.cpp, and nbody.rs: the
// Jovian planets orbiting the sun, advanced STEPS times by a simple symplectic
// integrator. The checksum is the system's energy after the last step.
import fmt
import math
import time

STEPS: const int = 10000000
PI: const f64 = 3.141592653589793
SOLAR_MASS: const f64 = 4.0 * PI * PI
DAYS_PER_YEAR: const f64 = 365.24
BODIES: const usize = 5

Body: struct { x: f64, y: f64, z: f64, vx: f64, vy: f64, vz: f64, mass: f64 }

offset_momentum(bodies: []Body) {
    px: f64 = 0.0
    py: f64 = 0.0
    pz: f64 = 0.0
    for i: usize in 0 .. BODIES {
        px += bodies[i].vx * bodies[i].mass
        py += bodies[i].vy * bodies[i].mass
        pz += bodies[i].vz * bodies[i].mass
    }
    bodies[0].vx = -px / SOLAR_MASS
    bodies[0].vy = -py / SOLAR_MASS
    bodies[0].vz = -pz / SOLAR_MASS
}

energy(bodies: []Body): f64 {
    e: f64 = 0.0
    for i: usize in 0 .. BODIES {
        b: Body = bodies[i]
        e += 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
        for j: usize in i + 1 .. BODIES {
            o: Body = bodies[j]
            dx: f64 = b.x - o.x
            dy: f64 = b.y - o.y
            dz: f64 = b.z - o.z
            e -= b.mass * o.mass / math.sqrt(dx * dx + dy * dy + dz * dz)
        }
    }
    return e
}

advance(bodies: []Body, dt: f64) {
    for i: usize in 0 .. BODIES {
        for j: usize in i + 1 .. BODIES {
            dx: f64 = bodies[i].x - bodies[j].x
            dy: f64 = bodies[i].y - bodies[j].y
            dz: f64 = bodies[i].z - bodies[j].z
            d2: f64 = dx * dx + dy * dy + dz * dz
            mag: f64 = dt / (d2 * math.sqrt(d2))
            mi: f64 = bodies[i].mass * mag
            mj: f64 = bodies[j].mass * mag
            bodies[i].vx -= dx * mj
            bodies[i].vy -= dy * mj
            bodies[i].vz -= dz * mj
            bodies[j].vx += dx * mi
            bodies[j].vy += dy * mi
            bodies[j].vz += dz * mi
        }
    }
    for i: usize in 0 .. BODIES {
        bodies[i].x += dt * bodies[i].vx
        bodies[i].y += dt * bodies[i].vy
        bodies[i].z += dt * bodies[i].vz
    }
}

main(): int {
    bodies: [BODIES]Body = [
        // sun
        Body { x = 0.0, y = 0.0, z = 0.0, vx = 0.0, vy = 0.0, vz = 0.0, mass = SOLAR_MASS },
        // jupiter
        Body {
            x = 4.84143144246472090e+00,
            y = -1.16032004402742839e+00,
            z = -1.03622044471123109e-01,
            vx = 1.66007664274403694e-03 * DAYS_PER_YEAR,
            vy = 7.69901118419740425e-03 * DAYS_PER_YEAR,
            vz = -6.90460016972063023e-05 * DAYS_PER_YEAR,
            mass = 9.54791938424326609e-04 * SOLAR_MASS,
        },
        // saturn
        Body {
            x = 8.34336671824457987e+00,
            y = 4.12479856412430479e+00,
            z = -4.03523417114321381e-01,
            vx = -2.76742510726862411e-03 * DAYS_PER_YEAR,
            vy = 4.99852801234917238e-03 * DAYS_PER_YEAR,
            vz = 2.30417297573763929e-05 * DAYS_PER_YEAR,
            mass = 2.85885980666130812e-04 * SOLAR_MASS,
        },
        // uranus
        Body {
            x = 1.28943695621391310e+01,
            y = -1.51111514016986312e+01,
            z = -2.23307578892655734e-01,
            vx = 2.96460137564761618e-03 * DAYS_PER_YEAR,
            vy = 2.37847173959480950e-03 * DAYS_PER_YEAR,
            vz = -2.96589568540237556e-05 * DAYS_PER_YEAR,
            mass = 4.36624404335156298e-05 * SOLAR_MASS,
        },
        // neptune
        Body {
            x = 1.53796971148509165e+01,
            y = -2.59193146099879641e+01,
            z = 1.79258772950371181e-01,
            vx = 2.68067772490389322e-03 * DAYS_PER_YEAR,
            vy = 1.62824170038242295e-03 * DAYS_PER_YEAR,
            vz = -9.51592254519715870e-05 * DAYS_PER_YEAR,
            mass = 5.15138902046611451e-05 * SOLAR_MASS,
        },
    ]
    offset_momentum(bodies[..])
    before: f64 = energy(bodies[..])

    started: u64 = time.awake()
    for 0 .. STEPS { advance(bodies[..], 0.01) }
    elapsed: u64 = time.awake() - started

    fmt.printf("energy: %.9f\nelapsed ns: %u\nchecksum: %.9f\n", before, usize(elapsed), energy(bodies[..]))
    return 0
}
