/* Regular-expression benchmark paired with regex.c (the same Pike VM over
 * the same programs in C) and regex-pcre2.c (a backtracking reference).
 * Every workload runs over identical generated text and reports a checksum
 * of the match spans, so all variants must agree on what matched.
 */

import bits
import fmt
import mem
import regex
import time

/* The generated text: 1 MiB of lowercase letters, digits, dashes, spaces,
 * and newlines.
 */
SIZE: usize = 1048576

/* Pathological calls: `(a|aa)*c` against 14 `a`s, a `b`, then a `c`. A
 * backtracker tries every way to split the run before failing at the `b`,
 * which grows exponentially with the run's length.
 */
CALLS: usize = 10000

now(): u64 {
    return time.awake()
}

report(name: string, elapsed: u64, operations: usize, checksum: usize) {
    fmt.printf("%s %u %u %u\n", name, usize(elapsed), operations, checksum)
}

/* A 64-bit LCG, one output byte per step, from the top bits. Kind 0 of 16 is
 * a space, 1 a newline, 2-4 a digit, 5 a dash, and the rest a letter.
 */
fill(text: mut []u8) {
    x: u64 = 88172645463325252

    for i: usize in 0 .. text.len {
        x = bits.wradd(bits.wrmul(x, u64(6364136223846793005)), u64(1442695040888963407))
        r: u64 = x >> 33
        kind: u64 = r % 16

        if kind == 0 {
            text[i] = ' '
        } else if kind == 1 {
            text[i] = '\n'
        } else if kind <= 4 {
            text[i] = u8(48 + (r >> 8) % 10)
        } else if kind == 5 {
            text[i] = '-'
        } else {
            text[i] = u8(97 + (r >> 8) % 26)
        }
    }
}

compile(pattern: string): regex.Regex {
    re: regex.Regex, err: Error = regex.Regex.compile(pattern)
    if err != null { fmt.println(err.message) }

    return re
}

/* Every match of `pattern`, as `next` visits them. */
find_all(name: string, pattern: string, text: string) {
    re: regex.Regex = compile(pattern)
    defer mut re.wipe()
    checksum: usize = 0
    at: usize = 0
    started: u64 = now()

    for mut re.next(text, mut at) {
        span: regex.Span = re.span(0)
        checksum += 1 + span.start + span.end
    }
    report(name, now() - started, text.len, checksum)
}

/* Every match of `(\d+)-(\d+)`, summing both groups' positions. */
captures(text: string) {
    re: regex.Regex = compile("(\\d+)-(\\d+)")
    defer mut re.wipe()
    checksum: usize = 0
    at: usize = 0
    started: u64 = now()

    for at <= text.len {
        if !mut re.find(text, at) { break }
        checksum += 1 + re.span(1).start + re.span(2).end
        at = re.span(0).end
    }
    report("captures", now() - started, text.len, checksum)
}

pathological() {
    re: regex.Regex = compile("(a|aa)*c")
    defer mut re.wipe()
    text: string = "aaaaaaaaaaaaaabc"
    checksum: usize = 0
    started: u64 = now()

    for i: usize in 0 .. CALLS {
        if mut re.find(text, 0) {
            span: regex.Span = re.span(0)
            checksum += 1 + span.start + span.end
        }
    }
    report("pathological", now() - started, CALLS * text.len, checksum)
}

main(): int {
    text: mut []u8 = mem.alloc[u8](SIZE)
    defer mem.release[u8](mut text)
    if text == null { return 1 }

    fill(text)
    find_all("literal", "zqxj", string(text))
    find_all("word-ing", "[a-z]+ing", string(text))
    captures(string(text))
    pathological()
    return 0
}
