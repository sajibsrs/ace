/* Array and Map benchmark paired with collections.c, which implements the same
 * growth policy, hash, load limit, and probing. Timed results are consumed
 * into checksums so the work remains observable.
 */

import array
import fmt
import map
import time

now(): u64 {
    return time.awake()
}

report(name: string, elapsed: u64, operations: usize, checksum: usize) {
    fmt.printf("%s %u %u %u\n", name, usize(elapsed), operations, checksum)
}

main(): int {
    count: usize = 1000000
    rounds: usize = 8
    push_time: u64 = 0
    set_time: u64 = 0
    get_time: u64 = 0
    checksum: usize = 0

    for round: usize in 0 .. rounds {
        items: array.Array[u64] = array.Array[u64] {}
        defer mut items.wipe()
        started: u64 = now()
        for i: usize in 0 .. count {
            err: Error = mut items.push(u64(i))
            if err != null { return 1 }
        }
        push_time += now() - started
        started = now()
        for i: usize in 0 .. count { mut items.set(i, u64(i * 3 + round)) }
        set_time += now() - started
        started = now()
        sum: u64 = 0
        for i: usize in 0 .. count { sum += items.get(i) }
        get_time += now() - started
        checksum += usize(sum % 1000003) + items.len
    }
    report("array-push", push_time, count * rounds, checksum)
    report("array-set", set_time, count * rounds, checksum)
    report("array-get", get_time, count * rounds, checksum)

    keys: usize = 16384
    map_rounds: usize = 64
    set_time = 0
    get_time = 0
    miss_time: u64 = 0
    unset_time: u64 = 0
    checksum = 0

    for round: usize in 0 .. map_rounds {
        table: map.Map[int, int] = map.Map[int, int] {}
        defer mut table.wipe()
        started: u64 = now()
        for i: usize in 0 .. keys {
            err: Error = mut table.set(int(i * 7), int(i + round))
            if err != null { return 2 }
        }
        set_time += now() - started
        started = now()
        for i: usize in 0 .. keys {
            value: int, found: bool = table.get(int(i * 7))
            if found { checksum += usize(value) }
        }
        get_time += now() - started
        started = now()
        for i: usize in 0 .. keys {
            value: int, found: bool = table.get(int(i * 7 + 3))
            if !found { checksum += 1 }
        }
        miss_time += now() - started
        started = now()
        for i: usize in 0 .. keys {
            if mut table.unset(int(i * 7)) { checksum += 2 }
        }
        unset_time += now() - started
        checksum += table.len
    }
    report("map-set", set_time, keys * map_rounds, checksum)
    report("map-get", get_time, keys * map_rounds, checksum)
    report("map-miss", miss_time, keys * map_rounds, checksum)
    report("map-unset", unset_time, keys * map_rounds, checksum)
    return 0
}
