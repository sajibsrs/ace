/* String and byte-operation benchmark paired with string.c. Timed results are
 * consumed into checksums so the work remains observable.
 */

import bits
import fmt
import mem
import str
import time

now(): u64 {
    return time.awake()
}

report(name: string, elapsed: u64, operations: usize, checksum: usize) {
    fmt.printf("%s %u %u %u\n", name, usize(elapsed), operations, checksum)
}

main(): int {
    iterations: usize = 1000000
    small_a: [64]u8 = [u8(97) : 64]
    small_b: [64]u8 = [u8(97) : 64]
    large_a: [4096]u8 = [u8(97) : 4096]
    large_b: [4096]u8 = [u8(97) : 4096]
    small_b[63] = 98
    large_b[4095] = 98
    checksum: usize = 0
    started: u64 = now()

    for i: usize in 0 .. iterations {
        checksum += usize(mem.compare(small_a[..], small_b[..]) + 1) + i % 2
    }
    report("compare-64", now() - started, iterations, checksum)
    checksum = 0
    started = now()

    for i: usize in 0 .. iterations / 16 {
        checksum += usize(mem.compare(large_a[..], large_b[..]) + 1) + i % 2
    }
    report("compare-4096", now() - started, iterations / 16, checksum)
    copy_small: [64]u8 = [u8(0) : 64]
    copy_large: [4096]u8 = [u8(0) : 4096]
    checksum = 0
    started = now()

    for i: usize in 0 .. iterations {
        mem.copy(mut copy_small[..], small_a[..])
        checksum += usize(copy_small[i % 64])
    }
    report("copy-64", now() - started, iterations, checksum)
    checksum = 0
    started = now()

    for i: usize in 0 .. iterations / 16 {
        mem.copy(mut copy_large[..], large_a[..])
        checksum += usize(copy_large[i % 4096])
    }
    report("copy-4096", now() - started, iterations / 16, checksum)
    large_a[4093] = 120
    large_a[4094] = 121
    large_a[4095] = 122
    haystack: string = large_a[..]
    checksum = 0
    started = now()

    for i: usize in 0 .. iterations / 32 {
        at: usize, found: bool = str.find(haystack, "xyz")

        if found {
            checksum += at + i % 2
        }
    }
    report("find-4096", now() - started, iterations / 32, checksum)
    decimal_inputs: [8]string = [
        "0.1", "1.5", "3.141592653589793", "1e-308",
        "5e-324", "1.7976931348623157e308", "-2.5e100", "6.02214076e23",
    ]
    float_iterations: usize = 20000
    raw_sum: u64 = 0
    started = now()

    for i: usize in 0 .. float_iterations {
        value: f64, ok: bool = str.parse[f64](decimal_inputs[i % 8])

        if ok {
            raw_sum ^= bits.from_float(value) + u64(i)
        }
    }
    report("parse-f64-short", now() - started, float_iterations, usize(raw_sum))
    long_decimal_inputs: [8]string = [
        "1234567890123456", "1234567890123456789",
        "0.1234567890123456789", "1234567890123456.5",
        "1.234567890123456e+308", "-9876543210987654e-200",
        "0.000000000000000123456789012345", "3141592653589793238",
    ]
    raw_sum = 0
    started = now()

    for i: usize in 0 .. float_iterations {
        value: f64, ok: bool = str.parse[f64](long_decimal_inputs[i % 8])

        if ok {
            raw_sum ^= bits.from_float(value) + u64(i)
        }
    }
    report("parse-f64-long", now() - started, float_iterations, usize(raw_sum))
    // Canonical workload assumption: 80% common/short, 20% long/scientific.
    blended_decimal_inputs: [40]string = [
        decimal_inputs[0], decimal_inputs[1], decimal_inputs[2], decimal_inputs[3],
        decimal_inputs[4], decimal_inputs[5], decimal_inputs[6], decimal_inputs[7],
        decimal_inputs[0], decimal_inputs[1], decimal_inputs[2], decimal_inputs[3],
        decimal_inputs[4], decimal_inputs[5], decimal_inputs[6], decimal_inputs[7],
        decimal_inputs[0], decimal_inputs[1], decimal_inputs[2], decimal_inputs[3],
        decimal_inputs[4], decimal_inputs[5], decimal_inputs[6], decimal_inputs[7],
        decimal_inputs[0], decimal_inputs[1], decimal_inputs[2], decimal_inputs[3],
        decimal_inputs[4], decimal_inputs[5], decimal_inputs[6], decimal_inputs[7],
        long_decimal_inputs[0], long_decimal_inputs[1],
        long_decimal_inputs[2], long_decimal_inputs[3],
        long_decimal_inputs[4], long_decimal_inputs[5],
        long_decimal_inputs[6], long_decimal_inputs[7],
    ]
    raw_sum = 0
    started = now()

    for i: usize in 0 .. float_iterations {
        value: f64, ok: bool = str.parse[f64](blended_decimal_inputs[i % 40])

        if ok {
            raw_sum ^= bits.from_float(value) + u64(i)
        }
    }
    report("parse-f64", now() - started, float_iterations, usize(raw_sum))
    values: [8]f64 = [
        0.1, 1.5, 3.141592653589793, 1.0e-308,
        5.0e-324, 1.7976931348623157e308, (0.0 - 2.5e100), 6.02214076e23,
    ]
    out: [64]u8 = [u8(0) : 64]
    view: mut []u8 = mut out[..]
    checksum = 0
    started = now()

    for i: usize in 0 .. iterations / 10 {
        count: usize, ok: bool = str.format(view, values[i % 8])

        if ok {
            checksum += count + usize(out[0])
        }
    }
    report("format-f64-shortest", now() - started, iterations / 10, checksum)
    return 0
}
