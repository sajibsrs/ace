/* lexer — the Ace lexer written in Ace, mirroring src/lexer.c token for token.
 *
 * `Lexer.next` streams one token per call; the lexer holds that token's
 * position and value (`pos`, `lit`, `int`, `float`) until the next call.
 * Identifier text is a view into the source; a string literal's decoded bytes
 * live in the lexer's scratch buffer.
 */

import mem
import str

pub Token: enum u8 {
    eof, newline, ident,
    kw_import, kw_pub, kw_mut, kw_const, kw_noalias, kw_if, kw_else, kw_for,
    kw_in, kw_switch, kw_default, kw_return, kw_break, kw_continue, kw_defer,
    kw_asm, kw_extern, kw_contract, kw_struct, kw_embed, kw_signs, kw_distinct,
    kw_type, kw_enum, kw_union, kw_specialized, kw_intrinsic, kw_inline,
    kw_volatile, kw_self, kw_null, kw_true, kw_false,
    int, float, string, char,
    assign, add_eq, sub_eq, mul_eq, div_eq, mod_eq, and_eq, or_eq, xor_eq,
    shl_eq, shr_eq,
    plus, minus, star, slash, percent, eq_eq, bang_eq, lt, le, gt, ge,
    and_and, or_or, amp, pipe, caret, shl, shr, tilde, bang,
    lparen, rparen, lbrack, rbrack, lbrace, rbrace, comma, colon, semi, at,
    dot, dot_dot, dot_dot_dot,
}

/* Display names: one per Token, checked complete by the compiler. */
DISP: [Token]string = [
    Token.eof = "eof",
    Token.newline = "newline",
    Token.ident = "ident",
    Token.kw_import = "import",
    Token.kw_pub = "pub",
    Token.kw_mut = "mut",
    Token.kw_const = "const",
    Token.kw_noalias = "noalias",
    Token.kw_if = "if",
    Token.kw_else = "else",
    Token.kw_for = "for",
    Token.kw_in = "in",
    Token.kw_switch = "switch",
    Token.kw_default = "default",
    Token.kw_return = "return",
    Token.kw_break = "break",
    Token.kw_continue = "continue",
    Token.kw_defer = "defer",
    Token.kw_asm = "asm",
    Token.kw_extern = "extern",
    Token.kw_contract = "contract",
    Token.kw_struct = "struct",
    Token.kw_embed = "embed",
    Token.kw_signs = "signs",
    Token.kw_distinct = "distinct",
    Token.kw_type = "type",
    Token.kw_enum = "enum",
    Token.kw_union = "union",
    Token.kw_specialized = "specialized",
    Token.kw_intrinsic = "intrinsic",
    Token.kw_inline = "inline",
    Token.kw_volatile = "volatile",
    Token.kw_self = "self",
    Token.kw_null = "null",
    Token.kw_true = "true",
    Token.kw_false = "false",
    Token.int = "int",
    Token.float = "float",
    Token.string = "string",
    Token.char = "char",
    Token.assign = "=",
    Token.add_eq = "+=",
    Token.sub_eq = "-=",
    Token.mul_eq = "*=",
    Token.div_eq = "/=",
    Token.mod_eq = "%=",
    Token.and_eq = "&=",
    Token.or_eq = "|=",
    Token.xor_eq = "^=",
    Token.shl_eq = "<<=",
    Token.shr_eq = ">>=",
    Token.plus = "+",
    Token.minus = "-",
    Token.star = "*",
    Token.slash = "/",
    Token.percent = "%",
    Token.eq_eq = "==",
    Token.bang_eq = "!=",
    Token.lt = "<",
    Token.le = "<=",
    Token.gt = ">",
    Token.ge = ">=",
    Token.and_and = "&&",
    Token.or_or = "||",
    Token.amp = "&",
    Token.pipe = "|",
    Token.caret = "^",
    Token.shl = "<<",
    Token.shr = ">>",
    Token.tilde = "~",
    Token.bang = "!",
    Token.lparen = "(",
    Token.rparen = ")",
    Token.lbrack = "[",
    Token.rbrack = "]",
    Token.lbrace = "{",
    Token.rbrace = "}",
    Token.comma = ",",
    Token.colon = ":",
    Token.semi = ";",
    Token.at = "@",
    Token.dot = ".",
    Token.dot_dot = "..",
    Token.dot_dot_dot = "...",
]

pub disp(kind: Token): string {
    return DISP[kind]
}

pub LexErr: error {
    1: allocation = "out of memory",
    2: escape_end = "unterminated escape sequence",
    3: escape_hex = "\\x escape needs two hex digits",
    4: escape = "unknown escape sequence",
    5: string = "unterminated string literal",
    6: char_end = "unterminated char literal",
    7: char_empty = "empty char literal",
    8: char_size = "char literal must hold exactly one character",
    9: exponent = "malformed float exponent",
    10: exponent_dot = "float exponent requires a '.' — write 1.0e5, not 1e5",
    11: separator = "malformed '_' separator (must sit between digits)",
    12: digits = "missing digits after base prefix",
    13: binary = "invalid binary digit",
    14: range = "integer literal out of range",
    15: colons = "'::' is not an operator; a type's functions are reached with '.'",
    16: non_ascii = "non-ASCII byte (identifiers are ASCII in v1)",
    17: unexpected = "unexpected character",
    18: comment = "unterminated block comment",
}

pub Lexer: struct {
    src: string,
    off: usize,
    line: u32,
    lstart: usize,  // offset of the current line's first byte (columns count from it)
    tline: u32,     // start of the token being scanned
    tcol: u32,
    prev: Token,    // last returned token; newline = none or already emitted
    count: usize,   // tokens returned so far
    scratch: mut []u8 = null,
    used: usize,
    text: string,   // ident: source view; string: decoded bytes (scratch)
    ival: u64,      // int value, char byte
    fval: f64,      // float value
    err: Error,     // first error of the current token
    eline: u32,
    ecol: u32,
}

/* A lexer over `src`, which must outlive it. Call `wipe` when done. */
pub Lexer.new(src: string): Lexer {
    lx: Lexer = Lexer {
        src = src, off = 0, line = 1, lstart = 0, tline = 1, tcol = 1,
        prev = Token.newline, count = 0, used = 0, text = "", ival = 0, fval = 0.0,
        err = null, eline = 0, ecol = 0,
    }
    if src.len >= 3 && src[0] == 0xEF && src[1] == 0xBB && src[2] == 0xBF {
        lx.off = 3 // UTF-8 BOM
        lx.lstart = 3
    }
    return lx
}

pub Lexer.wipe(mut self) {
    mem.release[u8](mut self.scratch)
    self.used = 0
}

/* The current token's position. */
pub Lexer.pos(self): (u32, u32) {
    return self.tline, self.tcol
}

/* The current token's text: an ident's source view, or a string literal's
 * decoded bytes (valid until the next `next`).
 */
pub Lexer.lit(self): string {
    return self.text
}

/* The current int token's value, or a char token's byte. */
pub Lexer.int(self): u64 {
    return self.ival
}

/* The current float token's value. */
pub Lexer.float(self): f64 {
    return self.fval
}

/* The current error's position (valid when `next` returned an error). */
pub Lexer.where(self): (u32, u32) {
    return self.eline, self.ecol
}

inline Lexer.cur(self): u8 {
    if self.off < self.src.len { return self.src[self.off] }
    return 0
}

inline Lexer.peek(self, k: usize): u8 {
    p: usize = self.off + k
    if p < self.src.len { return self.src[p] }
    return 0
}

inline Lexer.adv(mut self): u8 {
    if self.off >= self.src.len { return 0 }
    c: u8 = self.src[self.off]
    self.off += 1
    if c == '\n' {
        self.line += 1
        self.lstart = self.off
    }
    return c
}

/* Starts a token (or block comment) at the current byte. */
inline Lexer.mark(mut self) {
    self.tline = self.line
    self.tcol = u32(self.off - self.lstart + 1)
}

Lexer.fail(mut self, e: Error) {
    if self.err != null { return }
    self.err = e
    self.eline = self.tline
    self.ecol = self.tcol
}

Lexer.push(mut self, c: u8) {
    if self.used == self.scratch.len {
        grown: mut []u8, ok: bool = mem.grow[u8](self.scratch, self.used + 1)
        if !ok {
            mut self.fail(LexErr.allocation)
            return
        }
        self.scratch = grown
    }
    self.scratch[self.used] = c
    self.used += 1
}

/* Can a token of this kind end an expression? (the newline rule) */
ends_expr(k: Token): bool {
    switch k {
        (Token.ident, Token.int, Token.float, Token.string, Token.char,
         Token.kw_null, Token.kw_true, Token.kw_false, Token.kw_self,
         Token.rparen, Token.rbrack, Token.rbrace,
         Token.kw_return, Token.kw_break, Token.kw_continue,
         Token.kw_specialized, Token.kw_intrinsic) { return true }
        default {}
    }
    return false
}

inline ident_start(c: u8): bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

inline ident_char(c: u8): bool {
    return ident_start(c) || (c >= '0' && c <= '9')
}

/* The digit's value in `base`, or -1. */
digval(c: u8, base: int): int {
    v: int = -1
    if c >= '0' && c <= '9' {
        v = int(c - '0')
    } else if c >= 'a' && c <= 'f' {
        v = int(c - 'a') + 10
    } else if c >= 'A' && c <= 'F' {
        v = int(c - 'A') + 10
    }
    if v >= base { v = -1 }
    return v
}

/* Every '_' must sit between two digits of the given base. */
seps_ok(p: []char, base: int): bool {
    for i: usize in 0 .. p.len {
        if p[i] != '_' { continue }
        if i == 0 || i == p.len - 1 { return false }
        if digval(p[i - 1], base) < 0 || digval(p[i + 1], base) < 0 { return false }
    }
    return true
}

keyword(t: []char): Token {
    k: Token = Token.ident
    switch t[0] {
        'a' { if mem.equal(t, "asm") { k = Token.kw_asm } }
        'b' { if mem.equal(t, "break") { k = Token.kw_break } }
        'c' {
            if mem.equal(t, "const") {
                k = Token.kw_const
            } else if mem.equal(t, "continue") {
                k = Token.kw_continue
            } else if mem.equal(t, "contract") {
                k = Token.kw_contract
            }
        }
        'd' {
            if mem.equal(t, "default") {
                k = Token.kw_default
            } else if mem.equal(t, "defer") {
                k = Token.kw_defer
            } else if mem.equal(t, "distinct") {
                k = Token.kw_distinct
            }
        }
        'e' {
            if mem.equal(t, "else") {
                k = Token.kw_else
            } else if mem.equal(t, "extern") {
                k = Token.kw_extern
            } else if mem.equal(t, "embed") {
                k = Token.kw_embed
            } else if mem.equal(t, "enum") {
                k = Token.kw_enum
            }
        }
        'f' {
            if mem.equal(t, "for") {
                k = Token.kw_for
            } else if mem.equal(t, "false") {
                k = Token.kw_false
            }
        }
        'i' {
            if mem.equal(t, "if") {
                k = Token.kw_if
            } else if mem.equal(t, "in") {
                k = Token.kw_in
            } else if mem.equal(t, "import") {
                k = Token.kw_import
            } else if mem.equal(t, "intrinsic") {
                k = Token.kw_intrinsic
            } else if mem.equal(t, "inline") {
                k = Token.kw_inline
            }
        }
        'm' { if mem.equal(t, "mut") { k = Token.kw_mut } }
        'n' {
            if mem.equal(t, "noalias") {
                k = Token.kw_noalias
            } else if mem.equal(t, "null") {
                k = Token.kw_null
            }
        }
        'p' { if mem.equal(t, "pub") { k = Token.kw_pub } }
        'r' { if mem.equal(t, "return") { k = Token.kw_return } }
        's' {
            if mem.equal(t, "switch") {
                k = Token.kw_switch
            } else if mem.equal(t, "struct") {
                k = Token.kw_struct
            } else if mem.equal(t, "signs") {
                k = Token.kw_signs
            } else if mem.equal(t, "specialized") {
                k = Token.kw_specialized
            } else if mem.equal(t, "self") {
                k = Token.kw_self
            }
        }
        't' {
            if mem.equal(t, "type") {
                k = Token.kw_type
            } else if mem.equal(t, "true") {
                k = Token.kw_true
            }
        }
        'u' { if mem.equal(t, "union") { k = Token.kw_union } }
        'v' { if mem.equal(t, "volatile") { k = Token.kw_volatile } }
        default {}
    }
    return k
}

Lexer.scan_ident(mut self): Token {
    start: usize = self.off
    i: usize = self.off
    for i < self.src.len && ident_char(self.src[i]) { i += 1 }
    self.off = i
    text: string = self.src[start..self.off]
    self.text = text
    return keyword(text)
}

/* Skips a run of digits in `base` and '_' separators (no newlines). */
inline Lexer.digits(mut self, base: int) {
    i: usize = self.off
    for i < self.src.len && (self.src[i] == '_' || digval(self.src[i], base) >= 0) { i += 1 }
    self.off = i
}

Lexer.scan_number(mut self): Token {
    start: usize = self.off
    base: int = 10
    if self.cur() == '0' && (self.peek(1) == 'x' || self.peek(1) == 'X') {
        mut self.adv()
        mut self.adv()
        base = 16
    } else if self.cur() == '0' && (self.peek(1) == 'b' || self.peek(1) == 'B') {
        mut self.adv()
        mut self.adv()
        base = 2
    }

    dstart: usize = self.off
    mut self.digits(base)
    dend: usize = self.off

    is_float: bool = false
    if base == 10 && self.cur() == '.' && digval(self.peek(1), 10) >= 0 {
        is_float = true
        mut self.adv()
        mut self.digits(10)
        if self.cur() == 'e' || self.cur() == 'E' {
            mut self.adv()
            if self.cur() == '+' || self.cur() == '-' { mut self.adv() }
            if digval(self.cur(), 10) < 0 { mut self.fail(LexErr.exponent) }
            mut self.digits(10)
        }
    } else if base == 10 && (self.cur() == 'e' || self.cur() == 'E') {
        n1: u8 = self.peek(1)
        n2: u8 = self.peek(2)
        if digval(n1, 10) >= 0 || ((n1 == '+' || n1 == '-') && digval(n2, 10) >= 0) {
            mut self.fail(LexErr.exponent_dot)
        }
    }

    if !seps_ok(self.src[dstart..self.off], base) { mut self.fail(LexErr.separator) }
    if dend == dstart {
        mut self.fail(LexErr.digits)
    } else if base == 2 && digval(self.cur(), 10) >= 0 {
        mut self.fail(LexErr.binary)
    }

    if is_float {
        self.used = 0
        for i: usize in start .. self.off {
            if self.src[i] != '_' { mut self.push(self.src[i]) }
        }
        v: f64, ok: bool = str.parse[f64](self.scratch[..self.used])
        self.fval = v
        return Token.float
    }

    v: u64 = 0
    over: bool = false
    b: u64 = u64(base)
    for i: usize in dstart .. dend {
        c: u8 = self.src[i]
        if c == '_' { continue }
        dv: u64 = u64(digval(c, base))
        if v > (u64(0xFFFFFFFFFFFFFFFF) - dv) / b {
            over = true
            break
        }
        v = v * b + dv
    }
    self.ival = v // on overflow, the digits read so far (as the C lexer keeps them)
    if over { mut self.fail(LexErr.range) }
    return Token.int
}

/* Called with the backslash already consumed. */
Lexer.escape(mut self): u8 {
    c: u8 = self.cur()
    if c == 0 {
        mut self.fail(LexErr.escape_end)
        return '?'
    }
    mut self.adv()
    switch c {
        'n' { return '\n' }
        't' { return '\t' }
        'r' { return '\r' }
        '0' { return 0 }
        '\\', '"', '\'' { return c }
        'x' {
            h: int = digval(self.cur(), 16)
            if h < 0 {
                mut self.fail(LexErr.escape_hex)
                return '?'
            }
            mut self.adv()
            l: int = digval(self.cur(), 16)
            if l < 0 {
                mut self.fail(LexErr.escape_hex)
                return '?'
            }
            mut self.adv()
            return u8(h * 16 + l)
        }
        default {}
    }
    mut self.fail(LexErr.escape)
    return '?'
}

Lexer.scan_string(mut self): Token {
    mut self.adv() // opening quote
    self.used = 0
    for {
        c: u8 = self.cur()
        if c == '"' {
            mut self.adv()
            break
        }
        if c == 0 || c == '\n' {
            mut self.fail(LexErr.string)
            break
        }
        if c == '\\' {
            mut self.adv()
            e: u8 = mut self.escape()
            mut self.push(e)
        } else {
            mut self.push(mut self.adv()) // UTF-8 bytes pass through
        }
    }
    self.text = self.scratch[..self.used]
    return Token.string
}

Lexer.scan_char(mut self): Token {
    mut self.adv() // opening quote
    val: u8 = 0
    ok: bool = true
    if self.cur() == 0 || self.cur() == '\n' {
        mut self.fail(LexErr.char_end)
        ok = false
    } else if self.cur() == '\'' {
        mut self.adv()
        mut self.fail(LexErr.char_empty)
        ok = false
    } else if self.cur() == '\\' {
        mut self.adv()
        val = mut self.escape()
    } else {
        val = mut self.adv()
    }
    if ok {
        if self.cur() != '\'' {
            mut self.fail(LexErr.char_size)
            for self.cur() != 0 && self.cur() != '\'' && self.cur() != '\n' { mut self.adv() }
            if self.cur() == '\'' { mut self.adv() }
        } else {
            mut self.adv()
        }
    }
    self.ival = u64(val)
    return Token.char
}

/* `plain`, or `with_eq` when an '=' follows (consumed). */
Lexer.eq(mut self, plain: Token, with_eq: Token): Token {
    if self.cur() == '=' {
        mut self.adv()
        return with_eq
    }
    return plain
}

/* A punctuation token, or false after an unexpected byte (reported). */
Lexer.scan_punct(mut self, c: u8): (Token, bool) {
    mut self.adv()
    k: Token = Token.eof
    switch c {
        '(' { k = Token.lparen }
        ')' { k = Token.rparen }
        '[' { k = Token.lbrack }
        ']' { k = Token.rbrack }
        '{' { k = Token.lbrace }
        '}' { k = Token.rbrace }
        ',' { k = Token.comma }
        ':' {
            if self.cur() == ':' { mut self.fail(LexErr.colons) }
            k = Token.colon
        }
        '~' { k = Token.tilde }
        '+' { k = mut self.eq(Token.plus, Token.add_eq) }
        '-' { k = mut self.eq(Token.minus, Token.sub_eq) }
        '*' { k = mut self.eq(Token.star, Token.mul_eq) }
        '%' { k = mut self.eq(Token.percent, Token.mod_eq) }
        '^' { k = mut self.eq(Token.caret, Token.xor_eq) }
        '=' { k = mut self.eq(Token.assign, Token.eq_eq) }
        '!' { k = mut self.eq(Token.bang, Token.bang_eq) }
        '/' { k = mut self.eq(Token.slash, Token.div_eq) }
        '&' {
            if self.cur() == '&' {
                mut self.adv()
                k = Token.and_and
            } else {
                k = mut self.eq(Token.amp, Token.and_eq)
            }
        }
        '|' {
            if self.cur() == '|' {
                mut self.adv()
                k = Token.or_or
            } else {
                k = mut self.eq(Token.pipe, Token.or_eq)
            }
        }
        '<' {
            if self.cur() == '<' {
                mut self.adv()
                k = mut self.eq(Token.shl, Token.shl_eq)
            } else {
                k = mut self.eq(Token.lt, Token.le)
            }
        }
        '>' {
            if self.cur() == '>' {
                mut self.adv()
                k = mut self.eq(Token.shr, Token.shr_eq)
            } else {
                k = mut self.eq(Token.gt, Token.ge)
            }
        }
        '.' {
            k = Token.dot
            if self.cur() == '.' {
                mut self.adv()
                k = Token.dot_dot
                if self.cur() == '.' {
                    mut self.adv()
                    k = Token.dot_dot_dot
                }
            }
        }
        ';' { k = Token.semi }
        '@' { k = Token.at }
        default {
            if c >= 0x80 {
                mut self.fail(LexErr.non_ascii)
            } else {
                mut self.fail(LexErr.unexpected)
            }
            return k, false
        }
    }
    return k, true
}

/* Skips whitespace and comments; true when a newline was crossed. */
Lexer.trivia(mut self): bool {
    src: string = self.src
    i: usize = self.off
    nl: bool = false
    for i < src.len {
        c: u8 = src[i]
        if c == ' ' || c == '\t' || c == 0x0B || c == 0x0C {
            i += 1
        } else if c == '\n' {
            i += 1
            self.line += 1
            self.lstart = i
            nl = true
        } else if c == '\r' { // CRLF and lone CR both count once
            i += 1
            if i < src.len && src[i] == '\n' {
                i += 1
                self.line += 1
                self.lstart = i
            }
            nl = true
        } else if c == '/' && i + 1 < src.len && src[i + 1] == '/' {
            i += 2
            for i < src.len && src[i] != 0 && src[i] != '\n' { i += 1 }
        } else if c == '/' && i + 1 < src.len && src[i + 1] == '*' {
            self.off = i
            mut self.mark()
            i += 2
            for {
                if i >= src.len || src[i] == 0 {
                    mut self.fail(LexErr.comment)
                    break
                }
                b: u8 = src[i]
                if b == '*' && i + 1 < src.len && src[i + 1] == '/' {
                    i += 2
                    break
                }
                i += 1
                if b == '\n' {
                    self.line += 1
                    self.lstart = i
                    nl = true
                }
            }
        } else {
            break
        }
    }
    self.off = i
    return nl
}

Lexer.emit(mut self, t: Token): (Token, Error) {
    self.prev = t
    self.count += 1
    e: Error = self.err
    self.err = null
    return t, e
}

/* The next token; after eof, eof again. A token with an error is still a
 * token (as in the C lexer); `where` gives the error's position.
 */
pub Lexer.next(mut self): (Token, Error) {
    for {
        nl: bool = mut self.trivia()
        mut self.mark()

        if self.cur() == 0 {
            if self.count > 0 && self.prev != Token.newline && self.prev != Token.eof {
                return mut self.emit(Token.newline)
            }
            return mut self.emit(Token.eof)
        }

        // No newline before ';' (for-head clauses stay joined).
        if nl && ends_expr(self.prev) && self.cur() != ';' { return mut self.emit(Token.newline) }

        c: u8 = self.cur()
        if ident_start(c) { return mut self.emit(mut self.scan_ident()) }
        if c >= '0' && c <= '9' { return mut self.emit(mut self.scan_number()) }
        if c == '"' { return mut self.emit(mut self.scan_string()) }
        if c == '\'' { return mut self.emit(mut self.scan_char()) }
        k: Token, ok: bool = mut self.scan_punct(c)
        if ok { return mut self.emit(k) }
        // An unexpected byte yields no token; its error rides on the next one.
    }
}
