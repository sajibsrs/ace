/* Lexes one file and prints its tokens exactly as `ace --tokens` does, or
 * with --ast parses it and prints the tree exactly as `ace --ast` does.
 */

import file
import fmt
import mem
import sys

import lexer: "./lexer.ace"
import output: "./output.ace"
import parser: "./parser.ace"

Token: type = lexer.Token
Out: type = output.Out

/* What @when compares `target` against: the target this driver runs on. */
@when(target == "darwin-arm64")
TARGET: const string = "darwin-arm64"
@when(target == "linux-x64")
TARGET: const string = "linux-x64"

main(): int {
    ast: bool = sys.argc() == 3 && mem.equal(sys.arg(1), "--ast")
    if sys.argc() != 2 && !ast {
        fmt.printf(sys.stderr, "usage: ace-self [--ast] file.ace\n")
        return 2
    }
    path: string = sys.arg(sys.argc() - 1)
    src: mut []u8, rerr: Error = file.read(path)
    defer mem.release[u8](mut src)
    if rerr != null {
        fmt.printf(sys.stderr, "ace: cannot open '%s'\n", path)
        return 1
    }

    out: Out = Out { buf = mem.alloc[u8](65536), at = 0 }
    defer mem.release[u8](mut out.buf)
    if ast { return dump_ast(mut out, src, path) }
    lx: lexer.Lexer = lexer.Lexer.new(src)
    defer mut lx.wipe()
    errors: int = 0

    for {
        t: Token, err: Error = mut lx.next()
        if err != null {
            eline: u32, ecol: u32 = lx.where()
            fmt.printf(sys.stderr, "%s:%d:%d: error: %s\n", path, int(eline), int(ecol), err.message)
            errors += 1
        }
        line: u32, col: u32 = lx.pos()
        mut out.num(u64(line))
        mut out.byte(':')
        mut out.num(u64(col))
        mut out.byte('\t')
        mut out.put(lexer.disp(t))
        switch t {
            Token.ident {
                mut out.byte('\t')
                mut out.put(lx.lit())
            }
            Token.int {
                mut out.byte('\t')
                mut out.num(lx.int())
            }
            Token.float {
                mut out.byte('\t')
                mut out.general(lx.float())
            }
            Token.string {
                mut out.put("\t\"")
                mut out.quoted(lx.lit())
                mut out.byte('"')
            }
            Token.char {
                mut out.byte('\t')
                if lx.int() >= 33 && lx.int() <= 126 {
                    mut out.byte('\'')
                    mut out.byte(u8(lx.int()))
                    mut out.byte('\'')
                } else {
                    mut out.num(lx.int())
                }
            }
            default {}
        }
        mut out.byte('\n')
        if t == Token.eof { break }
    }
    mut out.flush()
    if errors > 0 { return 1 }
    return 0
}

/* Parses `src` for the host target and dumps the tree; 1 on any error. */
dump_ast(mut out: Out, src: string, path: string): int {
    p: parser.Parser, lex_errors: int = parser.Parser.new(src, path)
    defer mut p.wipe()
    if lex_errors > 0 { return 1 }
    f: u32 = mut p.parse(TARGET)
    failed: bool, line: u32, col: u32, message: string = p.error()
    if failed {
        fmt.printf(sys.stderr, "%s:%d:%d: error: %s\n", path, int(line), int(col), message)
        return 1
    }
    p.dump(mut out, f, 0)
    mut out.flush()
    return 0
}
