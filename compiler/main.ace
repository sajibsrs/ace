/* Lexes one file and prints its tokens exactly as `ace --tokens` does, or
 * with --ast parses it and prints the tree exactly as `ace --ast` does, or
 * with --modules resolves its imports and prints the loaded modules, or with
 * --resolved prints the merged tree as `ace --resolved` does.
 */

import file
import fmt
import mem
import sys

import lexer: "./lexer.ace"
import module: "./module.ace"
import output: "./output.ace"
import parser: "./parser.ace"

Token: type = lexer.Token
Out: type = fmt.Buffer

/* What @when compares `target` against: the target this driver runs on. */
@when(target == "darwin-arm64")
TARGET: const string = "darwin-arm64"
@when(target == "linux-x64")
TARGET: const string = "linux-x64"

main(): int {
    ast: bool = sys.argc() == 3 && mem.equal(sys.arg(1), "--ast")
    modules: bool = sys.argc() == 3 && mem.equal(sys.arg(1), "--modules")
    resolved: bool = sys.argc() == 3 && mem.equal(sys.arg(1), "--resolved")
    if sys.argc() != 2 && !ast && !modules && !resolved {
        fmt.printf(sys.stderr, "usage: ace-self [--ast|--modules|--resolved] file.ace\n")
        return 2
    }
    path: string = sys.arg(sys.argc() - 1)
    if modules || resolved { return dump_modules(path, resolved) }
    src: mut []u8, rerr: Error = file.read(path)
    defer mem.release[u8](mut src)
    if rerr != null {
        fmt.printf(sys.stderr, "ace: cannot open '%s'\n", path)
        return 1
    }

    storage: mut []u8 = mem.alloc[u8](65536)
    defer mem.release[u8](mut storage)
    out: Out = Out.init(sys.stdout, storage)
    if ast { return dump_ast(mut out, src, path) }
    lx: lexer.Lexer = lexer.Lexer.new(src)
    defer mut lx.wipe()

    for {
        t: Token = mut lx.next()
        line: u32, col: u32 = lx.pos()
        mut out.printf("%d:%d\t%s", int(line), int(col), lexer.disp(t))
        switch t {
            Token.ident { mut out.printf("\t%s", lx.lit()) }
            Token.int { mut out.printf("\t%u", uint(lx.int())) }
            Token.float { mut out.printf("\t%g", lx.float()) }
            Token.string {
                mut out.printf("\t\"")
                output.quoted(mut out, lx.lit())
                mut out.printf("\"")
            }
            Token.char {
                if lx.int() >= 33 && lx.int() <= 126 {
                    mut out.printf("\t'%c'", u8(lx.int()))
                } else {
                    mut out.printf("\t%u", uint(lx.int()))
                }
            }
            default {}
        }
        mut out.printf("\n")
        if t == Token.eof { break }
    }
    for d: lexer.Diag in lx.errors() { lexer.report(path, d) }
    mut out.flush()
    return summary(path, int(lx.errors().len))
}

/* C's closing count, "path: N error(s)"; 1 when there were any errors. */
summary(path: string, errors: int): int {
    if errors == 0 { return 0 }
    if errors == 1 {
        fmt.printf(sys.stderr, "%s: 1 error\n", path)
    } else {
        fmt.printf(sys.stderr, "%s: %d errors\n", path, errors)
    }
    return 1
}

/* Parses `src` for the host target and dumps the tree; 1 on any error. */
dump_ast(mut out: Out, src: string, path: string): int {
    p: parser.Parser, lex_errors: int = parser.Parser.new(src, path)
    defer mut p.wipe()
    if lex_errors > 0 { return summary(path, lex_errors) }
    f: u32 = mut p.parse(TARGET)
    errors: []parser.SyntaxError, stopped: bool = p.errors()
    for e: parser.SyntaxError in errors {
        fmt.printf(sys.stderr, "%s:%d:%d: error: %s\n", path, int(e.line), int(e.col), e.message)
    }
    if stopped { fmt.printf(sys.stderr, "%s: stopped at %d errors; the rest of the file was not parsed\n", path, int(parser.ERROR_LIMIT)) }
    if errors.len > 0 { return summary(path, int(errors.len)) }
    p.dump(mut out, f, 0)
    mut out.flush()
    return 0
}

/* Resolves `path`'s imports for the host target and dumps the modules, or the
 * merged tree; 1 on any error.
 */
dump_modules(path: string, tree: bool): int {
    l: module.Loader, found: bool = module.Loader.new(TARGET)
    defer mut l.wipe()
    if !found { return 1 }
    ok: bool = mut l.resolve(path)
    if !ok { return summary(path, l.errors) }
    storage: mut []u8 = mem.alloc[u8](65536)
    defer mem.release[u8](mut storage)
    out: Out = Out.init(sys.stdout, storage)
    if tree { l.dump_resolved(mut out) } else { l.dump(mut out) }
    mut out.flush()
    return 0
}
