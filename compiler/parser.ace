/* parser — the Ace parser written in Ace, mirroring src/parser.c node for node.
 *
 * The whole file is lexed up front into `kinds` (one Token per entry) and
 * `toks` (positions and values), so lookahead is index arithmetic. Nodes live
 * in one flat array, addressed by u32 index; index 0 is the absent node. A
 * node's variable-length children are a run in the shared `kids` array, built
 * on `stack` while the list is open. Per-kind layout follows src/parser.c.
 *
 * The first syntax error stops the parse: from then on every token reads as
 * eof, so each loop ends without further checks.
 */

import fmt
import mem
import str
import sys

import lexer: "./lexer.ace"

pub Token: type = lexer.Token
Out: type = fmt.Buffer

pub Kind: enum u8 {
    file,
    named, ptr, slice_t, array_t, tuple_t, func_t, const_t, tparams, staticmap_t,
    import, var, func, param, struct, bits, field, union, variant, contract,
    method, enum, alias, distinct, error, signing, conformance, extern,
    externfn, externvar,
    block, exprstmt, assign, if, for, range, switch, case, varpat, return,
    break, continue, fallthrough, asm, asmbind, label, defer,
    int_lit, float_lit, str_lit, char_lit, bool, null, ident, tuple,
    binary, cmpchain, ops, op, unary, call, mutarg, index, slice, selector,
    arraylit, structlit, fieldinit, staticmaplit, mapentry,
}

/* Node flags, with src/ace.h's values. */
pub F_PUB: const u32 = 1
pub F_EXPO: const u32 = 2
pub F_MUT: const u32 = 4
pub F_NOALIAS: const u32 = 8
pub F_CONST: const u32 = 16
pub F_DEFAULT: const u32 = 32
pub F_VARARGS: const u32 = 64
pub F_METHOD: const u32 = 128
pub F_SELECT: const u32 = 256
pub F_EMBED: const u32 = 512
pub F_SPECIALIZED: const u32 = 1024
pub F_FORGEN: const u32 = 2048
pub F_MIXED: const u32 = 4096
pub F_INTRINSIC: const u32 = 16384
pub F_PACKED: const u32 = 32768
pub F_VOLATILE: const u32 = 65536
pub F_CABI: const u32 = 131072
pub F_ASSOC: const u32 = 262144
pub F_INLINE: const u32 = 1048576
pub F_COLD: const u32 = 4194304
pub F_GROUPED: const u32 = 33554432
F_TEXT: const u32 = 0x80000000 // `text` is set (it may still be empty)

/* Flag dump names, in `ace --ast` order. */
FLAG_BITS: [18]u32 = [
    F_PUB, F_EXPO, F_MUT, F_NOALIAS, F_CONST, F_DEFAULT, F_VARARGS, F_METHOD,
    F_ASSOC, F_SELECT, F_EMBED, F_SPECIALIZED, F_INTRINSIC, F_INLINE, F_COLD,
    F_PACKED, F_VOLATILE, F_CABI,
]
FLAG_NAMES: [18]string = [
    " pub", " extern-c", " mut", " noalias", " const", " default", " varargs",
    " method", " assoc", " select", " embed", " specialized", " intrinsic",
    " inline", " cold", " packed", " volatile", " c_abi",
]

NOSLIT: const int = 1 // no struct literal at this expression level

pub Node: struct {
    kind: Kind,
    op: Token,     // binary/unary/assign/op operator
    flags: u32,
    line: u32,
    col: u32,
    text: string,  // name or string bytes, when F_TEXT is set
    cname: string, // C link name, when a C-boundary declaration renames it
    ival: u64,     // int/char/bool literal
    fval: f64,     // float literal
    a: u32,
    b: u32,
    c: u32,
    d: u32,
    kids: u32,     // first child in Parser.kids
    nkids: u32,
}

/* A token's position and value; its kind lives in Parser.kinds. */
Tok: struct {
    line: u32,
    col: u32,
    ival: u64,
    fval: f64,
    text: string, // ident: source view; string: decoded bytes in `pool`
}

pub Parser: struct {
    path: string,
    kinds: mut []Token = null,
    toks: mut []Tok = null,
    ntok: usize,
    pool: mut []u8 = null, // decoded string literals; never reallocated
    i: usize,
    nodes: mut []Node = null,
    nnode: usize,
    kids: mut []u32 = null,
    nkid: usize,
    stack: mut []u32 = null,
    nstack: usize,
    failed: bool,
    eline: u32,
    ecol: u32,
    msg: mut []u8 = null,      // storage of `err`
    err: fmt.Buffer,           // the first error's message
    exports: mut []u32 = null, // an extern block's Ace-defined C symbols
    nexport: usize,
    target: string,            // what @when compares `target` against
}

/* Lexes `src` (which must outlive the parser) into a parser over `path`.
 * Lex errors are reported on stderr as `ace --tokens` reports them; the
 * returned count is how many there were. Call `wipe` when done.
 */
pub Parser.new(src: string, path: string): (Parser, int) {
    msg: mut []u8 = mem.alloc[u8](256) // the longest message, one name included
    p: Parser = Parser { path = path, ntok = 0, i = 0, nnode = 1, nkid = 0, nstack = 0, failed = false, eline = 0, ecol = 0, msg = msg, err = fmt.Buffer.init(msg), nexport = 0, target = "" }
    p.pool = mem.alloc[u8](src.len + 1)
    p.kinds = mem.alloc[Token](64)
    p.toks = mem.alloc[Tok](64)
    p.nodes = mem.alloc[Node](256)
    p.kids = mem.alloc[u32](256)
    p.stack = mem.alloc[u32](64)
    p.exports = mem.alloc[u32](8)
    used: usize = 0
    lx: lexer.Lexer = lexer.Lexer.new(src)
    defer mut lx.wipe()
    for {
        t: Token = mut lx.next()
        line: u32, col: u32 = lx.pos()
        tok: Tok = Tok { line = line, col = col, ival = lx.int(), fval = lx.float(), text = "" }
        switch t {
            Token.string {
                text: string = lx.lit()
                mem.copy(p.pool[used..used + text.len], text)
                tok.text = p.pool[used..used + text.len]
                used += text.len
            }
            default { tok.text = lx.lit() }
        }
        if p.ntok == p.kinds.len {
            p.kinds = grow[Token](p.kinds)
            p.toks = grow[Tok](p.toks)
        }
        p.kinds[p.ntok] = t
        p.toks[p.ntok] = tok
        p.ntok += 1
        if t == Token.eof { break }
    }
    for d: lexer.Diag in lx.errors() { lexer.report(path, d) }
    return p, int(lx.errors().len)
}

pub Parser.wipe(mut self) {
    mem.release[Token](mut self.kinds)
    mem.release[Tok](mut self.toks)
    mem.release[u8](mut self.pool)
    mem.release[Node](mut self.nodes)
    mem.release[u32](mut self.kids)
    mem.release[u32](mut self.stack)
    mem.release[u32](mut self.exports)
    mem.release[u8](mut self.msg)
}

/* `s` with doubled capacity; aborts when out of memory, as the C parser's
 * arena does.
 */
grow[T](s: mut []T): mut []T {
    g: mut []T, ok: bool = mem.grow[T](s, s.len * 2)
    if !ok {
        report("ace", 0, 0, "out of memory")
        sys.exit(1)
    }
    return g
}

/* `path` relative to its own directory, the root's, as C's build_path writes
 * a root file's `@file`. C also maps a file under the compiler's std/ to
 * `std/<rel>` through realpath; that case is not ported.
 */
base_name(path: string): string {
    i: usize = path.len
    for i > 0 && path[i - 1] != '/' { i -= 1 }
    return path[i..]
}

report(path: string, line: u32, col: u32, message: string) {
    fmt.printf(sys.stderr, "%s:%d:%d: error: %s\n", path, int(line), int(col), message)
}

/* The syntax error, if the parse failed. */
pub Parser.error(self): (bool, u32, u32, string) {
    assert(self.err.dropped() == 0) // sized to fit any message
    return self.failed, self.eline, self.ecol, self.err.text()
}

pub Parser.node(self, n: u32): Node {
    return self.nodes[n]
}

pub Parser.kid(self, n: u32, k: u32): u32 {
    return self.kids[self.nodes[n].kids + k]
}

// --- cursor -------------------------------------------------------------------

/* The kind of the token `k` ahead; eof past the end or after an error. */
inline Parser.kth(self, k: usize): Token {
    j: usize = self.i + k
    if self.failed || j >= self.ntok { return Token.eof }
    return self.kinds[j]
}

pub inline Parser.at(self, k: Token): bool {
    return self.kth(0) == k
}

pub inline Parser.eat(mut self, k: Token): bool {
    if self.kth(0) == k {
        self.i += 1
        return true
    }
    return false
}

/* The current token is the identifier `s`. */
Parser.ident_at(self, k: usize, s: string): bool {
    return self.kth(k) == Token.ident && mem.equal(self.toks[self.i + k].text, s)
}

/* Records the first error, at token `ti`, as the concatenation of `parts`;
 * later errors are dropped.
 */
Parser.fail_at(mut self, ti: usize, parts: []string) {
    if self.failed { return }
    self.failed = true
    t: usize = ti
    if t >= self.ntok { t = self.ntok - 1 }
    self.eline = self.toks[t].line
    self.ecol = self.toks[t].col
    for part: string in parts { mut self.err.printf("%s", part) }
}

Parser.fail(mut self, message: string) {
    mut self.fail_at(self.i, [message])
}

/* `prefix` then the current token's description, as C's gdesc writes it. */
Parser.fail_got(mut self, prefix: string) {
    if self.failed { return }
    switch self.kinds[self.i] {
        Token.ident { mut self.fail_at(self.i, [prefix, "'", self.toks[self.i].text, "'"]) }
        Token.string { mut self.fail_at(self.i, [prefix, "string literal"]) }
        default { mut self.fail_at(self.i, [prefix, "'", lexer.disp(self.kinds[self.i]), "'"]) }
    }
}

/* "expected <what>, got <current token>". */
Parser.fail_expected(mut self, what: string) {
    if self.failed { return }
    mut self.err.printf("expected %s", what)
    mut self.fail_got(", got ")
}

/* A member name (field, enum member, variant, error entry, method) may be a
 * keyword: it is declared in its list or written after '.', never bare.
 */
member_kind(k: Token): bool {
    return k == Token.ident || (u8(k) >= u8(Token.import) && u8(k) <= u8(Token.false))
}

/* Consumes a member name and returns its index, or fails. */
Parser.expect_member(mut self, what: string): usize {
    if !member_kind(self.kth(0)) { mut self.fail_expected(what) }
    t: usize = self.i
    if !self.failed { self.i += 1 }
    return t
}

/* Consumes a `k` token and returns its index, or fails. */
Parser.expect(mut self, k: Token, what: string): usize {
    if !self.at(k) { mut self.fail_expected(what) }
    t: usize = self.i
    if !self.failed { self.i += 1 }
    return t
}


// --- nodes --------------------------------------------------------------------

/* A new node of `kind` at token `ti`'s position. */
Parser.make(mut self, kind: Kind, ti: usize): u32 {
    if self.nnode == self.nodes.len { self.nodes = grow[Node](self.nodes) }
    t: usize = ti
    if t >= self.ntok { t = self.ntok - 1 }
    n: u32 = u32(self.nnode)
    self.nodes[n] = Node {
        kind = kind, op = Token.eof, flags = 0, line = self.toks[t].line, col = self.toks[t].col,
        text = "", cname = "", ival = 0, fval = 0.0, a = 0, b = 0, c = 0, d = 0, kids = 0, nkids = 0,
    }
    self.nnode += 1
    return n
}

/* A new node at the current token. */
Parser.nd(mut self, kind: Kind): u32 {
    return mut self.make(kind, self.i)
}

Parser.named(mut self, n: u32, text: string) {
    self.nodes[n].text = text
    self.nodes[n].flags |= F_TEXT
}

/* An identifier node for token `ti`. */
Parser.ident_node(mut self, kind: Kind, ti: usize): u32 {
    n: u32 = mut self.make(kind, ti)
    mut self.named(n, self.toks[ti].text)
    return n
}

Parser.push(mut self, x: u32) {
    if self.nstack == self.stack.len { self.stack = grow[u32](self.stack) }
    self.stack[self.nstack] = x
    self.nstack += 1
}

/* Moves the children pushed since `mark` into `n`'s kids. */
Parser.close(mut self, n: u32, mark: usize) {
    count: usize = self.nstack - mark
    for self.nkid + count > self.kids.len { self.kids = grow[u32](self.kids) }
    mem.copy[u32](self.kids[self.nkid..self.nkid + count], self.stack[mark..self.nstack])
    self.nodes[n].kids = u32(self.nkid)
    self.nodes[n].nkids = u32(count)
    self.nkid += count
    self.nstack = mark
}

// --- types --------------------------------------------------------------------

/* At `void` used as a type (not `void.x`). */
Parser.at_void(self): bool {
    return self.ident_at(0, "void") && self.kth(1) != Token.dot
}

/* A function type's return after its ':': a type, or 'void' for none. */
Parser.func_type_ret(mut self): u32 {
    if self.at_void() {
        self.i += 1
        return 0
    }
    return mut self.parse_type()
}

/* A type argument: a type, or 'void'. */
Parser.type_arg(mut self): u32 {
    if !self.at_void() { return mut self.parse_type() }
    v: u32 = mut self.ident_node(Kind.named, self.i)
    self.i += 1
    return v
}

/* A comma list of types up to `close`, trailing comma allowed. */
Parser.type_list(mut self, close: Token) {
    if self.at(close) { return }
    for {
        mut self.push(mut self.parse_type())
        if !mut self.eat(Token.comma) || self.at(close) { break }
    }
}

pub Parser.parse_type(mut self): u32 {
    if self.at(Token.const) {
        t: u32 = mut self.nd(Kind.const_t)
        self.i += 1
        self.nodes[t].a = mut self.parse_type()
        return t
    }
    if self.at(Token.mut) { // type-position mut marks writable content
        self.i += 1
        if self.at(Token.star) { // mut *T
            t: u32 = mut self.nd(Kind.ptr)
            self.nodes[t].flags |= F_MUT
            self.i += 1
            self.nodes[t].a = mut self.parse_type()
            return t
        }
        if self.at(Token.lbrack) { // mut []T
            if self.kth(1) != Token.rbrack {
                mut self.fail("'mut' marks writable views ('mut *T', 'mut []T', 'mut string'); a fixed array is already writable storage; take a writable view with 'mut name[..]'")
                return 0
            }
            t: u32 = mut self.nd(Kind.slice_t)
            self.nodes[t].flags |= F_MUT
            self.i += 2
            self.nodes[t].a = mut self.parse_type()
            return t
        }
        if self.ident_at(0, "string") && self.kth(1) != Token.dot { // mut string
            t: u32 = mut self.ident_node(Kind.named, self.i)
            self.nodes[t].flags |= F_MUT
            self.i += 1
            return t
        }
        mut self.fail("'mut' in a type marks a writable view: 'mut *T', 'mut []T', or 'mut string'")
        return 0
    }
    if self.at(Token.star) {
        t: u32 = mut self.nd(Kind.ptr)
        self.i += 1
        self.nodes[t].a = mut self.parse_type()
        return t
    }
    if self.at(Token.lbrack) {
        self.i += 1
        if mut self.eat(Token.rbrack) { // []T
            t: u32 = mut self.nd(Kind.slice_t)
            self.nodes[t].a = mut self.parse_type()
            return t
        }
        t: u32 = mut self.nd(Kind.array_t) // [N]T
        self.nodes[t].b = mut self.expr(0)
        mut self.expect(Token.rbrack, "']' after array length")
        self.nodes[t].a = mut self.parse_type()
        return t
    }
    if self.at(Token.extern) { // extern "c" (params): ret
        f: u32 = mut self.nd(Kind.func_t)
        self.nodes[f].flags |= F_CABI
        self.i += 1
        abi: usize = mut self.expect(Token.string, "ABI string after 'extern'")
        if !self.failed && !mem.equal(self.toks[abi].text, "c") { mut self.fail("function types support only the 'c' ABI") }
        mut self.expect(Token.lparen, "'(' after function type ABI")
        mark: usize = self.nstack
        mut self.type_list(Token.rparen)
        mut self.expect(Token.rparen, "')' to close function parameter types")
        mut self.close(f, mark)
        mut self.expect(Token.colon, "':' and a return type or 'void' after C function parameter types")
        self.nodes[f].a = mut self.func_type_ret()
        return f
    }
    if self.at(Token.lparen) { // tuple or function type
        t: u32 = mut self.nd(Kind.tuple_t)
        self.i += 1
        mark: usize = self.nstack
        mut self.type_list(Token.rparen)
        mut self.expect(Token.rparen, "')' to close type list")
        if mut self.eat(Token.colon) { // (params): ret
            f: u32 = mut self.nd(Kind.func_t)
            mut self.close(f, mark)
            self.nodes[f].a = mut self.func_type_ret()
            return f
        }
        count: usize = self.nstack - mark
        if count < 2 {
            if count == 0 {
                mut self.fail("'()' is not a type: a tuple has two or more members, and a function type needs ': R' or ': void'")
            } else {
                mut self.fail("'(T)' is not a type: a tuple has two or more members, and a function type needs ': R' or ': void'")
            }
            self.nstack = mark
            return 0
        }
        mut self.close(t, mark)
        return t
    }
    if self.at(Token.ident) { // named, qualified, generic-instantiated
        if self.ident_at(0, "StaticMap") && self.kth(1) == Token.lbrack {
            m: u32 = mut self.nd(Kind.staticmap_t)
            self.i += 2
            self.nodes[m].a = mut self.parse_type()
            if mut self.eat(Token.comma) { mut self.fail("StaticMap type is spelled StaticMap[K]V, not StaticMap[K, V]") }
            mut self.expect(Token.rbrack, "']' after StaticMap key type")
            self.nodes[m].b = mut self.parse_type()
            return m
        }
        if self.at_void() {
            mut self.fail("'void' is allowed only as a function type's return or a type argument")
            return 0
        }
        named: u32 = mut self.ident_node(Kind.named, self.i)
        self.i += 1
        for self.at(Token.dot) {
            self.i += 1
            m: usize = mut self.expect(Token.ident, "type name after '.'")
            outer: u32 = mut self.ident_node(Kind.named, m)
            self.nodes[outer].a = named
            named = outer
        }
        if self.at(Token.lbrack) { // generic instantiation
            self.i += 1
            mark: usize = self.nstack
            for {
                mut self.push(mut self.type_arg())
                if !mut self.eat(Token.comma) || self.at(Token.rbrack) { break }
            }
            mut self.expect(Token.rbrack, "']' to close type arguments")
            mut self.close(named, mark)
        }
        return named
    }
    mut self.fail_got("expected type, got ")
    return 0
}

// --- expressions --------------------------------------------------------------

/* Binary operator levels, loosest first: || && | ^ & ==/!= (comparison
 * chains) <</>> +/- * / %; 0 when `k` is no binary operator.
 */
level(k: Token): int {
    switch k {
        Token.or_or { return 1 }
        Token.and_and { return 2 }
        Token.pipe { return 3 }
        Token.caret { return 4 }
        Token.amp { return 5 }
        Token.eq_eq, Token.bang_eq { return 6 }
        Token.lt, Token.le, Token.gt, Token.ge { return 7 }
        Token.shl, Token.shr { return 8 }
        Token.plus, Token.minus { return 9 }
        Token.star, Token.slash, Token.percent { return 10 }
        default { return 0 }
    }
}

CMP_LEVEL: const int = 7

pub Parser.expr(mut self, ctx: int): u32 {
    r: u32, top: int = mut self.binary(1, ctx)
    return r
}

/* Whether level `lv` is an equality or comparison's, which a bitwise operator
 * (| ^ &, levels 3-5) never takes as an operand unparenthesized.
 */
compare_level(lv: int): bool {
    return lv == 6 || lv == CMP_LEVEL
}

/* Left-associative operators of level `min` and tighter, by precedence
 * climbing: one level lookup per operator, not one call per level. Also
 * returns the level of the result's outermost operator, 0 for none.
 */
Parser.binary(mut self, min: int, ctx: int): (u32, int) {
    l: u32 = mut self.unary(ctx)
    ltop: int = 0
    for {
        lv: int = level(self.kth(0))
        if lv < min || lv == 0 { break }
        if lv == CMP_LEVEL {
            l = mut self.chain(l, ctx)
            ltop = lv
            continue
        }
        op: usize = self.i
        self.i += 1
        r: u32, rtop: int = mut self.binary(lv + 1, ctx)
        if lv >= 3 && lv <= 5 && (compare_level(ltop) || compare_level(rtop)) {
            mut self.fail_at(op, ["a bitwise operator and a comparison need parentheses to mix"])
        }
        b: u32 = mut self.make(Kind.binary, op)
        self.nodes[b].op = self.kinds[op]
        self.nodes[b].a = l
        self.nodes[b].b = r
        l = b
        ltop = lv
    }
    return l, ltop
}

/* The comparison chain whose first operand is `l`. */
Parser.chain(mut self, l: u32, ctx: int): u32 {
    ch: u32 = mut self.nd(Kind.cmpchain)
    ops: u32 = mut self.nd(Kind.ops)
    mark: usize = self.nstack
    mut self.push(l)
    opmark: usize = 0
    // Operands and operators interleave on the stack; split them after.
    for level(self.kth(0)) == CMP_LEVEL {
        on: u32 = mut self.nd(Kind.op)
        self.nodes[on].op = self.kinds[self.i]
        mut self.push(on)
        self.i += 1
        operand: u32, top: int = mut self.binary(CMP_LEVEL + 1, ctx)
        mut self.push(operand)
    }
    count: usize = self.nstack - mark
    // Reorder [x0, op1, x1, op2, x2] into operands then operators.
    tmp: mut []u32 = mem.alloc[u32](count)
    nx: usize = 0
    j: usize = 0
    for j < count {
        tmp[nx] = self.stack[mark + j]
        nx += 1
        j += 2
    }
    opmark = nx
    j = 1
    for j < count {
        tmp[opmark] = self.stack[mark + j]
        opmark += 1
        j += 2
    }
    mem.copy[u32](self.stack[mark..self.nstack], tmp)
    mem.release[u32](mut tmp)
    mut self.close(ops, mark + nx)
    mut self.close(ch, mark)
    self.nodes[ch].a = ops
    return ch
}

/* A prefix operator node over the unary expression that follows. */
Parser.prefix(mut self, op: Token, flags: u32, skip: usize, ctx: int): u32 {
    u: u32 = mut self.nd(Kind.unary)
    self.nodes[u].op = op
    self.nodes[u].flags |= flags
    self.i += skip
    self.nodes[u].a = mut self.unary(ctx)
    return u
}

/* Non-diagnostic type lookahead from token `i`: the index after the type,
 * or 0 when no type starts there.
 */
Parser.scan_type(self, i: usize): usize {
    k: Token = self.kind_at(i)
    switch k {
        Token.const, Token.star { return self.scan_type(i + 1) }
        Token.mut {
            n: Token = self.kind_at(i + 1)
            if n != Token.star && n != Token.lbrack && n != Token.ident { return 0 }
            return self.scan_type(i + 1)
        }
        Token.lbrack {
            j: usize = i + 1
            if self.kind_at(j) == Token.rbrack {
                j += 1
            } else {
                if self.kind_at(j) != Token.int || self.kind_at(j + 1) != Token.rbrack { return 0 }
                j += 2
            }
            return self.scan_type(j)
        }
        Token.ident {
            j: usize = i + 1
            for self.kind_at(j) == Token.dot {
                if self.kind_at(j + 1) != Token.ident { return 0 }
                j += 2
            }
            if self.kind_at(j) == Token.lbrack {
                j = self.scan_types(j + 1)
                if j == 0 || self.kind_at(j) != Token.rbrack { return 0 }
                j += 1
            }
            return j
        }
        Token.lparen {
            j: usize = self.scan_types(i + 1)
            if j == 0 || self.kind_at(j) != Token.rparen { return 0 }
            j += 1
            if self.kind_at(j) == Token.colon { return self.scan_type(j + 1) }
            return j
        }
        default { return 0 }
    }
}

/* A comma list of scanned types: the index after it, or 0. */
Parser.scan_types(self, i: usize): usize {
    j: usize = i
    for {
        j = self.scan_type(j)
        if j == 0 { return 0 }
        if self.kind_at(j) != Token.comma { return j }
        j += 1
    }
}

/* Token `j`'s kind, eof past the end (scans ignore the error state). */
inline Parser.kind_at(self, j: usize): Token {
    if j >= self.ntok { return Token.eof }
    return self.kinds[j]
}

/* A bracketed argument in expression position: a function type can only be
 * a type argument, never an index.
 */
Parser.bracket_arg(mut self): u32 {
    if self.at(Token.extern) { return mut self.parse_type() }
    if self.at(Token.lparen) {
        j: usize = self.i
        depth: int = 0
        for j < self.ntok {
            k: Token = self.kinds[j]
            if k == Token.lparen {
                depth += 1
            } else if k == Token.rparen {
                depth -= 1
                if depth == 0 { break }
            }
            j += 1
        }
        if self.kind_at(j + 1) == Token.colon { return mut self.parse_type() }
    }
    return mut self.expr(0)
}

Parser.unary(mut self, ctx: int): u32 {
    k: Token = self.kth(0)
    if k == Token.bang || k == Token.tilde || k == Token.minus { return mut self.prefix(k, 0, 1, ctx) }
    if k == Token.mut && self.kth(1) == Token.amp { return mut self.prefix(Token.amp, F_MUT, 2, ctx) }
    if k == Token.mut {
        // Type-position mut in expression-position type arguments.
        mut_string: bool = self.ident_at(1, "string")
        if self.kth(1) == Token.star ||
            (self.kth(1) == Token.lbrack && self.kth(2) == Token.rbrack) ||
            (mut_string && self.kth(2) != Token.lbrack) {
            return mut self.postfix(ctx, mut self.parse_type())
        }
        // A mutating method call or writable-view establishment.
        self.i += 1
        base: u32 = mut self.postfix(ctx, mut self.primary(ctx))
        if base != 0 && (self.nodes[base].kind == Kind.slice || self.nodes[base].kind == Kind.call) {
            self.nodes[base].flags |= F_MUT
            return base
        }
        mut self.fail("'mut' in an expression marks a method receiver or establishes a writable view")
        return base
    }
    if k == Token.star {
        // `*T(address)` is a pointer conversion; any other '*' dereferences.
        after: usize = 0
        if !self.failed { after = self.scan_type(self.i) }
        if after != 0 && self.kind_at(after) == Token.lparen { return mut self.postfix(ctx, mut self.parse_type()) }
        self.i += 1
        u: u32 = mut self.nd(Kind.unary)
        self.nodes[u].op = Token.star
        self.nodes[u].a = mut self.unary(ctx)
        return u
    }
    if k == Token.amp { return mut self.prefix(Token.amp, 0, 1, ctx) }
    if k == Token.volatile { return mut self.prefix(Token.volatile, 0, 1, ctx) }
    return mut self.postfix(ctx, mut self.primary(ctx))
}

Parser.structlit(mut self, base: u32): u32 {
    lit: u32 = mut self.nd(Kind.structlit)
    self.nodes[lit].a = base
    self.i += 1 // '{'
    mark: usize = self.nstack
    if !self.at(Token.rbrace) {
        for {
            fi: u32 = mut self.nd(Kind.fieldinit)
            if member_kind(self.kth(0)) && self.kth(1) == Token.colon {
                mut self.fail("struct literal field initialization uses '='; ':' is for declarations and type annotations")
            }
            if member_kind(self.kth(0)) && self.kth(1) == Token.assign {
                mut self.named(fi, self.toks[self.i].text)
                self.i += 2
            }
            self.nodes[fi].a = mut self.expr(0)
            mut self.push(fi)
            if !mut self.eat(Token.comma) || self.at(Token.rbrace) { break }
        }
    }
    mut self.expect(Token.rbrace, "'}' to close struct literal")
    mut self.close(lit, mark)
    return lit
}

pub Parser.staticmaplit(mut self): u32 {
    lit: u32 = mut self.nd(Kind.staticmaplit)
    mut self.expect(Token.lbrace, "'{' to open StaticMap literal")
    mark: usize = self.nstack
    for !self.at(Token.rbrace) {
        entry: u32 = mut self.nd(Kind.mapentry)
        self.nodes[entry].a = mut self.expr(0)
        mut self.expect(Token.colon, "':' between StaticMap key and value")
        self.nodes[entry].b = mut self.expr(0)
        mut self.push(entry)
        if !mut self.eat(Token.comma) || self.at(Token.rbrace) { break }
    }
    mut self.expect(Token.rbrace, "'}' to close StaticMap literal")
    mut self.close(lit, mark)
    return lit
}

/* `base` is an identifier node spelled `s`. */
Parser.is_ident(self, base: u32, s: string): bool {
    return base != 0 && self.nodes[base].kind == Kind.ident && mem.equal(self.nodes[base].text, s)
}

/* A call's arguments after its '(' (consumed). */
Parser.call_args(mut self, call: u32, base: u32) {
    mark: usize = self.nstack
    if self.is_ident(base, "sizeof") || self.is_ident(base, "alignof") || self.is_ident(base, "blank") {
        mut self.push(mut self.parse_type())
        mut self.expect(Token.rparen, "')' after layout type")
        mut self.close(call, mark)
        return
    }
    if self.is_ident(base, "bitcast") {
        mut self.push(mut self.parse_type())
        mut self.expect(Token.comma, "',' after bitcast type")
        mut self.push(mut self.expr(0))
        mut self.expect(Token.rparen, "')' after bitcast value")
        mut self.close(call, mark)
        return
    }
    if self.is_ident(base, "offsetof") {
        mut self.push(mut self.parse_type())
        mut self.expect(Token.comma, "',' after offsetof type")
        ft: usize = mut self.expect_member("field name in offsetof")
        path: u32 = mut self.ident_node(Kind.ident, ft)
        for mut self.eat(Token.dot) {
            part: usize = mut self.expect_member("field name after '.' in offsetof")
            field: u32 = mut self.ident_node(Kind.selector, part)
            self.nodes[field].a = path
            path = field
        }
        mut self.push(path)
        mut self.expect(Token.rparen, "')' after offsetof field path")
        mut self.close(call, mark)
        return
    }
    if !self.at(Token.rparen) {
        for {
            // `mut &value` is one writable-address expression, not a mut argument.
            if self.at(Token.mut) && self.kth(1) != Token.amp {
                mt: usize = self.i
                self.i += 1
                value: u32 = mut self.expr(0)
                if value != 0 && (self.nodes[value].kind == Kind.slice || self.nodes[value].kind == Kind.call) {
                    // a writable view, or a nested call's receiver mark
                    self.nodes[value].flags |= F_MUT
                    mut self.push(value)
                } else {
                    ma: u32 = mut self.make(Kind.mutarg, mt)
                    self.nodes[ma].a = value
                    mut self.push(ma)
                }
            } else {
                mut self.push(mut self.expr(0))
            }
            if !mut self.eat(Token.comma) || self.at(Token.rparen) { break }
        }
    }
    mut self.expect(Token.rparen, "')' to close call arguments")
    mut self.close(call, mark)
}

Parser.postfix(mut self, ctx: int, start: u32): u32 {
    base: u32 = start
    for {
        switch self.kth(0) {
            Token.lparen {
                call: u32 = mut self.nd(Kind.call)
                self.nodes[call].a = base
                self.i += 1
                mut self.call_args(call, base)
                base = call
            }
            Token.lbrack { // index, slice, or generic instantiation
                self.i += 1
                ix: u32 = mut self.nd(Kind.index)
                self.nodes[ix].a = base
                lo: u32 = 0
                hi: u32 = 0
                is_slice: bool = false
                multi: bool = false
                if self.at(Token.dot_dot) {
                    is_slice = true
                    self.i += 1
                    if !self.at(Token.rbrack) { hi = mut self.expr(0) }
                } else {
                    lo = mut self.bracket_arg()
                    if self.at(Token.dot_dot) {
                        is_slice = true
                        self.i += 1
                        if !self.at(Token.rbrack) { hi = mut self.expr(0) }
                    } else if self.at(Token.comma) { // f[int, f64]
                        mark: usize = self.nstack
                        mut self.push(lo)
                        for mut self.eat(Token.comma) {
                            if self.at(Token.rbrack) { break }
                            mut self.push(mut self.bracket_arg())
                        }
                        mut self.expect(Token.rbrack, "']' after index/type arguments")
                        mut self.close(ix, mark)
                        multi = true
                    }
                }
                if multi {
                    base = ix
                } else {
                    mut self.expect(Token.rbrack, "']' after index/slice")
                    if is_slice {
                        sl: u32 = mut self.nd(Kind.slice)
                        self.nodes[sl].line = self.nodes[ix].line
                        self.nodes[sl].col = self.nodes[ix].col
                        self.nodes[sl].a = base
                        self.nodes[sl].b = lo
                        self.nodes[sl].c = hi
                        base = sl
                    } else {
                        self.nodes[ix].b = lo
                        base = ix
                    }
                }
            }
            Token.dot {
                self.i += 1
                f: usize = mut self.expect_member("field name after '.'")
                fa: u32 = mut self.ident_node(Kind.selector, f)
                self.nodes[fa].a = base
                base = fa
            }
            Token.lbrace { // typed struct literal, suppressed at statement heads
                if (ctx & NOSLIT) != 0 { return base }
                base = mut self.structlit(base)
            }
            default { return base }
        }
    }
}

Parser.leaf(mut self, kind: Kind): u32 {
    x: u32 = mut self.nd(kind)
    self.i += 1
    return x
}

Parser.primary(mut self, ctx: int): u32 {
    t: usize = self.i
    switch self.kth(0) {
        Token.int, Token.char {
            kind: Kind = Kind.int_lit
            if self.kinds[t] == Token.char { kind = Kind.char_lit }
            x: u32 = mut self.leaf(kind)
            self.nodes[x].ival = self.toks[t].ival
            return x
        }
        Token.float {
            x: u32 = mut self.leaf(Kind.float_lit)
            self.nodes[x].fval = self.toks[t].fval
            return x
        }
        Token.string {
            x: u32 = mut self.leaf(Kind.str_lit)
            mut self.named(x, self.toks[t].text)
            return x
        }
        Token.at { // @file / @line
            if self.ident_at(1, "line") {
                x: u32 = mut self.nd(Kind.int_lit)
                self.nodes[x].ival = u64(self.toks[t].line)
                self.i += 2
                return x
            }
            if self.ident_at(1, "file") {
                x: u32 = mut self.nd(Kind.str_lit)
                mut self.named(x, base_name(self.path))
                self.i += 2
                return x
            }
            mut self.fail("expected 'file' or 'line' after '@' in an expression")
            return mut self.nd(Kind.int_lit)
        }
        Token.null {
            self.i += 1
            return mut self.nd(Kind.null) // at the next token, as in C
        }
        Token.true, Token.false {
            x: u32 = mut self.leaf(Kind.bool)
            if self.kinds[t] == Token.true { self.nodes[x].ival = 1 }
            return x
        }
        Token.ident, Token.self { // the receiver reads as an ordinary local
            x: u32 = mut self.ident_node(Kind.ident, t)
            self.i += 1
            return x
        }
        Token.lparen { // grouping or tuple
            self.i += 1
            mark: usize = self.nstack
            mut self.push(mut self.expr(0))
            for mut self.eat(Token.comma) {
                if self.at(Token.rparen) { break }
                mut self.push(mut self.expr(0))
            }
            mut self.expect(Token.rparen, "')' to close expression")
            if self.nstack - mark == 1 {
                x: u32 = self.stack[mark]
                self.nstack = mark
                if x != 0 && self.nodes[x].kind == Kind.selector { self.nodes[x].flags |= F_GROUPED }
                return x
            }
            tu: u32 = mut self.make(Kind.tuple, t)
            mut self.close(tu, mark)
            return tu
        }
        Token.lbrack { // array literal, or a slice type called as a conversion
            self.i += 1
            if self.at(Token.rbrack) && slice_type_start(self.kth(1)) {
                ty: u32 = mut self.nd(Kind.slice_t)
                self.i += 1
                self.nodes[ty].a = mut self.parse_type()
                return ty
            }
            al: u32 = mut self.nd(Kind.arraylit)
            mark: usize = self.nstack
            if !self.at(Token.rbrack) {
                first: u32 = mut self.expr(0)
                if mut self.eat(Token.colon) {
                    self.nodes[al].a = first
                    self.nodes[al].b = mut self.expr(0) // repetition count
                } else {
                    keyed: bool = self.at(Token.assign) // [E.a = x, E.b = y]
                    el: u32 = first
                    for {
                        if keyed {
                            en: u32 = mut self.nd(Kind.mapentry)
                            self.nodes[en].a = el
                            mut self.expect(Token.assign, "'=' after a keyed array literal's member")
                            self.nodes[en].b = mut self.expr(0)
                            el = en
                        } else if self.at(Token.assign) {
                            mut self.fail("a keyed array literal keys every element, the first included")
                        }
                        mut self.push(el)
                        if !mut self.eat(Token.comma) || self.at(Token.rbrack) { break }
                        el = mut self.expr(0)
                    }
                }
            }
            mut self.expect(Token.rbrack, "']' to close array literal")
            if self.nstack - mark == 1 && self.nodes[al].a == 0 && self.nodes[self.stack[mark]].kind != Kind.mapentry &&
                self.array_cast_ahead() {
                // [N]T(value): an array type called as a cast, admitted only as a callee
                ty: u32 = mut self.make(Kind.array_t, t)
                self.nodes[ty].b = self.stack[mark]
                self.nstack = mark
                self.nodes[ty].a = mut self.parse_type()
                return ty
            }
            mut self.close(al, mark)
            return al
        }
        Token.lbrace { // bare struct literal
            if (ctx & NOSLIT) != 0 { mut self.fail("unexpected '{' — struct literals need a type or parentheses here") }
            return mut self.structlit(0)
        }
        default {
            mut self.fail_got("expected expression, got ")
            return 0
        }
    }
}

/* The index just past the bracket run opening at `k` ahead; 0 at eof. */
Parser.past_brackets(self, k: usize): usize {
    j: usize = k
    depth: int = 0
    for {
        t: Token = self.kth(j)
        if t == Token.eof { return 0 }
        if t == Token.lbrack {
            depth += 1
        } else if t == Token.rbrack {
            depth -= 1
            if depth == 0 { return j + 1 }
        }
        j += 1
    }
}

/* The tokens ahead spell an element type called as a cast, `T(`, `*T(`,
 * `[2]T(`, or `m.T[A](`: after a one-element array literal they make it the
 * length of an array type called as a cast ([N]T(value)).
 */
Parser.array_cast_ahead(self): bool {
    k: usize = 0
    for {
        t: Token = self.kth(k)
        if t == Token.star || t == Token.mut || t == Token.const {
            k += 1
        } else if t == Token.lbrack {
            k = self.past_brackets(k)
            if k == 0 { return false }
        } else {
            break
        }
    }
    if self.kth(k) != Token.ident { return false }
    k += 1
    for self.kth(k) == Token.dot && self.kth(k + 1) == Token.ident { k += 2 }
    if self.kth(k) == Token.lbrack {
        k = self.past_brackets(k)
        if k == 0 { return false }
    }
    return self.kth(k) == Token.lparen
}

/* Tokens that may start a slice conversion's element type after `[]`. */
slice_type_start(k: Token): bool {
    return k == Token.ident || k == Token.mut || k == Token.star || k == Token.lbrack ||
        k == Token.lparen || k == Token.const
}

// --- statements ---------------------------------------------------------------

/* The current token's line (the last token's once past the end). */
Parser.line(self): u32 {
    t: usize = self.i
    if t >= self.ntok { t = self.ntok - 1 }
    return self.toks[t].line
}

Parser.skipnl(mut self) {
    for self.at(Token.newline) { self.i += 1 }
}

Parser.bare_list_line(mut self, line: u32) {
    if self.line() != line { mut self.fail("bare comma-separated lists must stay on one physical line") }
}

/* One expression, or a bare comma list of them as a tuple. */
Parser.expr_list(mut self, ctx: int): u32 {
    first: usize = self.i
    line: u32 = self.line()
    mark: usize = self.nstack
    mut self.push(mut self.expr(ctx))
    for self.at(Token.comma) {
        mut self.bare_list_line(line)
        self.i += 1
        mut self.bare_list_line(line)
        mut self.push(mut self.expr(0))
    }
    if self.nstack - mark == 1 {
        x: u32 = self.stack[mark]
        self.nstack = mark
        return x
    }
    tu: u32 = mut self.make(Kind.tuple, first)
    mut self.close(tu, mark)
    return tu
}

Parser.stmt_end(mut self) {
    if !mut self.eat(Token.newline) && !self.at(Token.rbrace) && !self.at(Token.eof) {
        mut self.fail_got("expected newline or '}' after statement, got ")
    }
}

Parser.parse_if(mut self): u32 {
    n: u32 = mut self.nd(Kind.if)
    mut self.expect(Token.if, "'if'")
    self.nodes[n].a = mut self.expr(NOSLIT)
    self.nodes[n].b = mut self.block()
    if self.at(Token.else) { // must be on the '}' line (the lexer emits a newline otherwise)
        self.i += 1
        c: u32 = 0
        if self.at(Token.if) {
            c = mut self.parse_if()
        } else {
            c = mut self.block()
        }
        self.nodes[n].c = c
    }
    return n
}

/* Scans an `ident ':'` for-head: a depth-0 `in` selects typed binders; a
 * depth-0 `=` or `;` selects a declaration init. Bounded, never backtracking.
 */
Parser.for_head_typed_at(self): bool {
    j: usize = self.i + 2 // past the binder name and ':'
    depth: int = 0
    for j < self.ntok {
        k: Token = self.kinds[j]
        if depth == 0 {
            if k == Token.in { return true }
            if k == Token.assign || k == Token.semi || k == Token.lbrace || k == Token.newline || k == Token.eof { return false }
        }
        if k == Token.lbrack || k == Token.lparen || k == Token.lbrace {
            depth += 1
        } else if k == Token.rbrack || k == Token.rparen || k == Token.rbrace {
            if depth == 0 { return false }
            depth -= 1
        }
        j += 1
    }
    return false
}

Parser.for_semi(mut self, hline: u32, what: string) {
    if self.line() != hline { mut self.fail("for-head clauses must stay on one physical line") }
    mut self.expect(Token.semi, what)
}

/* The three-clause tail after the init: [cond] ';' [post] block. */
Parser.for_tail(mut self, n: u32, hline: u32) {
    if !self.at(Token.semi) && !self.at(Token.lbrace) {
        self.nodes[n].b = mut self.expr(NOSLIT)
    }
    mut self.for_semi(hline, "';' after the for-head condition")
    if !self.at(Token.lbrace) {
        self.nodes[n].c = mut self.expr_stmt(NOSLIT)
    }
    if self.line() != hline { mut self.fail("for-head clauses must stay on one physical line") }
    self.nodes[n].d = mut self.block()
}

/* The head after `for`, told apart by bounded lookahead: `{` infinite, `;`
 * three-clause with no init, `ident ':'` typed binders or a declaration init,
 * otherwise a condition or an assignment/expression-statement init.
 */
Parser.for_head(mut self, n: u32): u32 {
    hline: u32 = self.line()
    if self.at(Token.lbrace) { // infinite: exits only via break/return
        self.nodes[n].flags |= F_FORGEN
        self.nodes[n].d = mut self.block()
        return n
    }
    if self.at(Token.semi) { // three-clause with an empty init
        self.nodes[n].flags |= F_FORGEN
        self.i += 1
        mut self.for_tail(n, hline)
        return n
    }
    if self.at(Token.ident) && self.kth(1) == Token.colon && self.for_head_typed_at() {
        line: u32 = self.line()
        mark: usize = self.nstack
        for {
            v: usize = mut self.expect(Token.ident, "loop variable name")
            binder: u32 = mut self.ident_node(Kind.param, v)
            mut self.expect(Token.colon, "':' after loop variable")
            self.nodes[binder].a = mut self.parse_type()
            mut self.push(binder)
            if !self.at(Token.comma) { break }
            mut self.bare_list_line(line)
            self.i += 1
            mut self.bare_list_line(line)
            if self.nstack - mark == 2 { mut self.fail("for-in accepts at most index and value binders") }
            if self.failed { break }
        }
        mut self.close(n, mark)
        mut self.expect(Token.in, "'in'")
        if mut self.eat(Token.mut) { self.nodes[n].flags |= F_MUT } // `in mut iterable`: aliasing
        it: u32 = mut self.expr(NOSLIT)
        if (self.nodes[n].flags & F_MUT) != 0 && it != 0 && self.nodes[it].kind == Kind.slice {
            self.nodes[it].flags |= F_MUT // `in mut xs[lo..hi]`: establish, then alias
        }
        if self.at(Token.dot_dot) {
            r: u32 = mut self.nd(Kind.range) // at '..', like a binary node
            self.i += 1
            self.nodes[r].a = it
            self.nodes[r].b = mut self.expr(NOSLIT)
            if self.ident_at(0, "step") {
                self.i += 1
                self.nodes[r].c = mut self.expr(NOSLIT)
            }
            it = r
        }
        self.nodes[n].b = it
        self.nodes[n].c = mut self.block()
        return n
    }
    self.nodes[n].flags |= F_FORGEN
    if self.at(Token.ident) && self.kth(1) == Token.colon { // declaration init
        name: usize = self.i
        self.i += 1 // ident; decl_stmt consumes ':'
        self.nodes[n].a = mut self.decl_stmt(name)
    } else {
        a: u32 = mut self.expr_stmt(NOSLIT)
        self.nodes[n].a = a
        if self.at(Token.lbrace) { // condition only: the expression is the condition
            self.nodes[n].b = self.nodes[a].a
            self.nodes[n].a = 0
            self.nodes[n].d = mut self.block()
            return n
        }
    }
    mut self.for_semi(hline, "';' after the for-head initializer")
    mut self.for_tail(n, hline)
    return n
}

/* At a union-variant case pattern `Type.variant(binder: T)`, qualified and
 * generic bases included: a bounded scan for the `(` opening the binder.
 */
Parser.variant_binder_at(self): bool {
    j: usize = self.i
    if self.kind_at(j) != Token.ident { return false }
    j += 1
    segments: int = 1
    for {
        for self.kind_at(j) == Token.lbrack { // generic arguments
            depth: int = 0
            for j < self.ntok {
                k: Token = self.kinds[j]
                j += 1
                if k == Token.lbrack {
                    depth += 1
                } else if k == Token.rbrack {
                    depth -= 1
                    if depth == 0 { break }
                }
            }
        }
        if self.kind_at(j) == Token.dot && member_kind(self.kind_at(j + 1)) {
            j += 2
            segments += 1
            continue
        }
        break
    }
    if segments < 2 { return false }
    if j + 2 >= self.ntok { return false }
    return self.kinds[j] == Token.lparen && self.kinds[j + 1] == Token.ident &&
        (self.kinds[j + 2] == Token.colon || self.kinds[j + 2] == Token.rparen)
}

/* `Type.variant(binder: T)`: the variant reference keeps the field shape
 * sema resolves for construction; the binder rides in b.
 */
Parser.variant_pattern(mut self): u32 {
    base: u32 = 0 // qualified chain of the segments before the variant
    seg: usize = 0
    for {
        first: bool = base == 0 && !self.at(Token.dot)
        if self.at(Token.dot) { self.i += 1 } // separator before the next segment
        if first {
            seg = mut self.expect(Token.ident, "type or variant name")
        } else {
            seg = mut self.expect_member("type or variant name")
        }
        if self.at(Token.lparen) || self.failed { break } // the variant name
        node: u32 = mut self.ident_node(Kind.ident, seg)
        if base != 0 {
            q: u32 = mut self.ident_node(Kind.selector, seg)
            self.nodes[q].a = base
            base = q
        } else {
            base = node
        }
        if self.at(Token.lbrack) { // generic arguments on this segment
            self.i += 1
            ix: u32 = mut self.nd(Kind.index)
            self.nodes[ix].a = base
            mark: usize = self.nstack
            for {
                mut self.push(mut self.parse_type())
                if !mut self.eat(Token.comma) || self.at(Token.rbrack) { break }
            }
            mut self.expect(Token.rbrack, "']' to close type arguments")
            mut self.close(ix, mark)
            base = ix
        }
    }
    vp: u32 = mut self.make(Kind.varpat, seg)
    ref: u32 = mut self.ident_node(Kind.selector, seg)
    self.nodes[ref].a = base
    self.nodes[vp].a = ref
    self.i += 1 // '('
    bname: usize = mut self.expect(Token.ident, "binder name")
    binder: u32 = mut self.ident_node(Kind.param, bname)
    if mut self.eat(Token.colon) { // `Variant(k)` is a typeless binder; sema diagnoses it
        self.nodes[binder].a = mut self.parse_type()
    }
    self.nodes[vp].b = binder
    mut self.expect(Token.rparen, "')' to close variant pattern")
    return vp
}

/* A case opening with `(` whose matching `)` encloses a top-level comma is a
 * parenthesized case list, never a tuple: no switch value is a tuple.
 */
Parser.case_list_at(self): bool {
    if !self.at(Token.lparen) { return false }
    depth: int = 0
    for j: usize in self.i..self.ntok {
        k: Token = self.kinds[j]
        if k == Token.lparen || k == Token.lbrack || k == Token.lbrace {
            depth += 1
        } else if k == Token.rparen || k == Token.rbrack || k == Token.rbrace {
            depth -= 1
            if depth == 0 { return false }
        } else if k == Token.comma && depth == 1 {
            return true
        } else if k == Token.eof {
            return false
        }
    }
    return false
}

Parser.parse_switch(mut self): u32 {
    n: u32 = mut self.nd(Kind.switch)
    mut self.expect(Token.switch, "'switch'")
    self.nodes[n].a = mut self.expr(NOSLIT)
    mut self.expect(Token.lbrace, "'{' to open switch body")
    cases: usize = self.nstack
    mut self.skipnl()
    for !self.at(Token.rbrace) {
        if self.at(Token.eof) {
            mut self.fail("unexpected end of file in switch body")
            break
        }
        c: u32 = mut self.nd(Kind.case)
        if self.at(Token.default) {
            self.i += 1
            self.nodes[c].flags |= F_DEFAULT
        } else if self.at(Token.else) {
            mut self.fail("'else' is not a switch case; use 'default'")
        } else {
            mark: usize = self.nstack
            line: u32 = self.line()
            multi: bool = self.case_list_at() // `(` patterns across lines `)`
            if multi { self.i += 1 }
            for {
                if self.variant_binder_at() {
                    mut self.push(mut self.variant_pattern())
                } else {
                    mut self.push(mut self.expr(NOSLIT))
                }
                if !self.at(Token.comma) { break }
                if !multi { mut self.bare_list_line(line) }
                self.i += 1
                if multi && self.at(Token.rparen) { break }
                if !multi { mut self.bare_list_line(line) }
                if self.failed { break }
            }
            if multi {
                if self.line() == line { mut self.fail("parentheses around case values are only for multiline lists") }
                mut self.expect(Token.rparen, "')' to close case values")
            }
            mut self.close(c, mark)
        }
        b: u32 = mut self.block()
        self.nodes[c].b = b
        // `fallthrough` is contextual only as a bare statement directly in a
        // case block; any other use is an identifier. Sema checks position.
        x: Node = self.nodes[b]
        for k: u32 in 0..x.nkids {
            st: u32 = self.kids[x.kids + k]
            if self.nodes[st].kind != Kind.exprstmt || !self.is_ident(self.nodes[st].a, "fallthrough") { continue }
            id: u32 = self.nodes[st].a
            self.nodes[st].kind = Kind.fallthrough
            self.nodes[st].a = 0
            mut self.named(st, self.nodes[id].text)
        }
        mut self.push(c)
        mut self.skipnl()
    }
    self.i += 1 // '}'
    mut self.close(n, cases)
    return n
}

Parser.parse_asm(mut self): u32 {
    n: u32 = mut self.nd(Kind.asm)
    mut self.expect(Token.asm, "'asm'")
    s: usize = mut self.expect(Token.string, "instruction string after 'asm'")
    mut self.named(n, self.toks[s].text)
    mut self.expect(Token.lbrace, "'{' to open asm bindings")
    binds: usize = self.nstack
    mut self.skipnl()
    for !self.at(Token.rbrace) {
        if self.at(Token.eof) {
            mut self.fail("unexpected end of file in asm block")
            break
        }
        kind: string = ""
        regs: bool = false // in/out bind registers to values
        if self.at(Token.in) { // `in` is a keyword; accept it as the binding kind
            kind = "in"
            regs = true
            self.i += 1
        } else if self.at(Token.ident) {
            kind = self.toks[self.i].text
            regs = mem.equal(kind, "out")
            if !regs && !mem.equal(kind, "clobbers") {
                mut self.fail_at(self.i, ["expected in/out/clobbers binding, got '", kind, "'"])
            }
            self.i += 1
        } else {
            mut self.fail_got("expected in/out/clobbers binding, got ")
        }
        bnd: u32 = mut self.nd(Kind.asmbind)
        mut self.named(bnd, kind)
        mut self.expect(Token.colon, "':' after binding kind")
        mark: usize = self.nstack
        for {
            reg: usize = mut self.expect(Token.ident, "register name")
            mut self.push(mut self.ident_node(Kind.ident, reg))
            if regs {
                mut self.expect(Token.assign, "'=' in register binding")
                if self.at(Token.int) { // x16 = 3: an immediate operand
                    imm: u32 = mut self.leaf(Kind.int_lit)
                    self.nodes[imm].ival = self.toks[self.i - 1].ival
                    mut self.push(imm)
                } else {
                    v: usize = mut self.expect(Token.ident, "value name")
                    mut self.push(mut self.ident_node(Kind.ident, v))
                }
            }
            if !mut self.eat(Token.comma) || self.at(Token.rbrace) || self.at(Token.newline) { break }
        }
        mut self.close(bnd, mark)
        mut self.push(bnd)
        if !mut self.eat(Token.newline) && !self.at(Token.rbrace) { mut self.fail("expected newline or '}' after asm binding") }
        mut self.skipnl()
    }
    self.i += 1 // '}'
    mut self.close(n, binds)
    return n
}

/* x: T = e | x: const T = e | n: T, m: U = f() (typed destructuring), after
 * the first name (token `first`).
 */
Parser.decl_stmt(mut self, first: usize): u32 {
    n: u32 = mut self.make(Kind.var, first)
    mark: usize = self.nstack
    is_const: bool = false
    name: usize = first
    for {
        if self.at(Token.colon) {
            self.i += 1
            if self.at(Token.const) {
                is_const = true
                self.i += 1
            }
            binder: u32 = mut self.ident_node(Kind.param, name)
            self.nodes[binder].a = mut self.parse_type()
            mut self.push(binder)
        } else {
            mut self.push(mut self.ident_node(Kind.ident, name))
            self.nodes[n].flags |= F_MIXED
        }
        if !self.at(Token.comma) || self.failed { break }
        mut self.bare_list_line(self.toks[first].line)
        self.i += 1
        mut self.bare_list_line(self.toks[first].line)
        name = mut self.expect(Token.ident, "binder name after ','")
    }
    if is_const { self.nodes[n].flags |= F_CONST }
    count: usize = self.nstack - mark
    staticmap: bool = count == 1 && self.nodes[self.stack[mark]].a != 0 &&
        self.nodes[self.nodes[self.stack[mark]].a].kind == Kind.staticmap_t
    mut self.close(n, mark)
    if mut self.eat(Token.assign) {
        if count > 1 { self.nodes[n].flags |= F_MIXED }
        b: u32 = 0
        if staticmap && self.at(Token.lbrace) {
            b = mut self.staticmaplit()
        } else {
            b = mut self.expr_list(0)
        }
        self.nodes[n].b = b
    } else if count > 1 || (self.nodes[n].flags & F_MIXED) != 0 {
        mut self.fail("destructuring declaration requires an initializer")
    }
    return n
}

/* A `break`/`continue` with its optional label. */
Parser.jump(mut self, kind: Kind): u32 {
    n: u32 = mut self.leaf(kind)
    if self.at(Token.ident) {
        mut self.named(n, self.toks[self.i].text)
        self.i += 1
    }
    return n
}

Parser.stmt(mut self): u32 {
    switch self.kth(0) {
        Token.if { return mut self.parse_if() }
        Token.for {
            n: u32 = mut self.nd(Kind.for)
            mut self.expect(Token.for, "'for'")
            return mut self.for_head(n)
        }
        Token.switch { return mut self.parse_switch() }
        Token.asm { return mut self.parse_asm() }
        Token.return {
            n: u32 = mut self.leaf(Kind.return)
            if !self.at(Token.newline) && !self.at(Token.rbrace) && !self.at(Token.eof) {
                self.nodes[n].a = mut self.expr_list(0)
            }
            return n
        }
        Token.break { return mut self.jump(Kind.break) }
        Token.continue { return mut self.jump(Kind.continue) }
        Token.defer {
            n: u32 = mut self.leaf(Kind.defer)
            mt: usize = self.i
            if mut self.eat(Token.mut) { // `defer mut c.scale(2.0)`: receiver-marked call
                e: u32 = mut self.expr(NOSLIT)
                if e == 0 || self.nodes[e].kind != Kind.call {
                    mut self.fail_at(mt, ["'mut' after 'defer' marks a call receiver"])
                    return n
                }
                self.nodes[e].flags |= F_MUT
                self.nodes[n].a = e
            } else {
                self.nodes[n].a = mut self.expr(NOSLIT)
            }
            return n
        }
        Token.mut { // `mut c.scale(2.0)`: receiver-marked call statement
            mt: usize = self.i
            n: u32 = mut self.leaf(Kind.exprstmt)
            e: u32 = mut self.expr(NOSLIT)
            if e == 0 || self.nodes[e].kind != Kind.call {
                mut self.fail_at(mt, ["'mut' at statement level marks a call receiver"])
                return n
            }
            self.nodes[e].flags |= F_MUT
            self.nodes[n].a = e
            return n
        }
        Token.ident {
            if self.kth(1) != Token.colon { return mut self.expr_stmt(0) }
            if self.kth(2) == Token.lbrace { // labeled block
                n: u32 = mut self.ident_node(Kind.label, self.i)
                self.i += 2
                self.nodes[n].a = mut self.block()
                return n
            }
            if self.kth(2) == Token.for { // labeled for: block-label namespace
                n: u32 = mut self.ident_node(Kind.for, self.i)
                self.i += 3 // label, ':', 'for'
                return mut self.for_head(n)
            }
            name: usize = self.i
            self.i += 1 // ident; decl_stmt consumes ':'
            return mut self.decl_stmt(name)
        }
        default { return mut self.expr_stmt(0) }
    }
}

is_assign_op(k: Token): bool {
    switch k {
        (
            Token.assign, Token.add_eq, Token.sub_eq, Token.mul_eq, Token.div_eq, Token.mod_eq,
            Token.and_eq, Token.or_eq, Token.xor_eq, Token.shl_eq, Token.shr_eq,
        ) { return true }
        default { return false }
    }
}

/* An expression-led statement: an assignment (single or destructuring) or a
 * bare expression. Shared with for-head clauses, which rely on it never
 * producing a declaration; they pass NOSLIT, as the body's '{' follows.
 */
Parser.expr_stmt(mut self, ctx: int): u32 {
    start: usize = self.i
    line: u32 = self.line()
    e: u32 = mut self.expr(ctx)
    if self.at(Token.comma) { // destructuring assignment, possibly mixed under `=`
        a: u32 = mut self.nd(Kind.assign)
        mark: usize = self.nstack
        mut self.push(e)
        for self.at(Token.comma) {
            mut self.bare_list_line(line)
            self.i += 1
            mut self.bare_list_line(line)
            if self.at(Token.ident) && self.kth(1) == Token.colon {
                binder: u32 = mut self.ident_node(Kind.param, self.i)
                self.i += 2
                self.nodes[binder].a = mut self.parse_type()
                mut self.push(binder)
                self.nodes[a].flags |= F_MIXED
            } else {
                mut self.push(mut self.expr(ctx))
            }
            if self.failed { break }
        }
        if (self.nodes[a].flags & F_MIXED) != 0 {
            for j: usize in mark..self.nstack {
                k: Kind = Kind.ident
                if self.stack[j] != 0 { k = self.nodes[self.stack[j]].kind }
                if k != Kind.ident && k != Kind.param { mut self.fail("mixed '=' left side accepts names only") }
            }
            self.nodes[a].kind = Kind.var
        }
        op: usize = mut self.expect(Token.assign, "'=' in assignment")
        self.nodes[a].op = self.kind_at(op)
        mut self.close(a, mark)
        r: u32 = mut self.expr_list(ctx)
        if self.nodes[a].kind == Kind.var {
            self.nodes[a].b = r
        } else {
            self.nodes[a].a = r
        }
        return a
    }
    if is_assign_op(self.kth(0)) { // single-target assignment, compound included
        a: u32 = mut self.nd(Kind.assign)
        self.nodes[a].op = self.kinds[self.i]
        if e != 0 && self.nodes[e].kind == Kind.unary && self.nodes[e].op == Token.volatile {
            if self.nodes[a].op != Token.assign { mut self.fail("volatile access supports only simple '=' assignment") }
            self.nodes[a].flags |= F_VOLATILE
            e = self.nodes[e].a
        }
        self.i += 1
        mark: usize = self.nstack
        mut self.push(e)
        mut self.close(a, mark)
        self.nodes[a].a = mut self.expr(ctx)
        return a
    }
    n: u32 = mut self.make(Kind.exprstmt, start)
    self.nodes[n].a = e
    return n
}

pub Parser.block(mut self): u32 {
    b: u32 = mut self.nd(Kind.block)
    mut self.expect(Token.lbrace, "'{'")
    mark: usize = self.nstack
    mut self.skipnl()
    for !self.at(Token.rbrace) {
        if self.at(Token.eof) {
            mut self.fail("unexpected end of file, expected '}'")
            break
        }
        mut self.push(mut self.stmt())
        mut self.stmt_end()
        mut self.skipnl()
    }
    self.i += 1 // '}'
    mut self.close(b, mark)
    return b
}

// --- declarations -------------------------------------------------------------

/* Token `ti`'s text, clamped to the last token. */
Parser.text(self, ti: usize): string {
    t: usize = ti
    if t >= self.ntok { t = self.ntok - 1 }
    return self.toks[t].text
}

/* The line of the token before the current one. */
Parser.prev_line(self): u32 {
    t: usize = self.i - 1
    if t >= self.ntok { t = self.ntok - 1 }
    return self.toks[t].line
}

/* Pushes a parameter list through its closing ')'. An explicit receiver
 * `self` / `mut self` is an untyped first parameter (a == 0); only a method
 * or contract method accepts one.
 */
Parser.params(mut self, closer: string, self_ok: bool) {
    mark: usize = self.nstack
    if !self.at(Token.rparen) {
        for {
            pa: u32 = mut self.nd(Kind.param)
            for {
                if mut self.eat(Token.mut) {
                    self.nodes[pa].flags |= F_MUT
                } else if mut self.eat(Token.noalias) {
                    self.nodes[pa].flags |= F_NOALIAS
                } else {
                    break
                }
            }
            if self.at(Token.self) {
                if !self_ok { mut self.fail("'self' is only the receiver of a method declaration") }
                if self.nstack != mark { mut self.fail("'self' must be the first parameter") }
                if (self.nodes[pa].flags & F_NOALIAS) != 0 { mut self.fail("'noalias' does not apply to the receiver 'self'") }
                self.i += 1
                if self.at(Token.colon) { mut self.fail("'self' takes no type; its type is the method's owner") }
                mut self.named(pa, "self")
                mut self.push(pa)
                if !mut self.eat(Token.comma) || self.at(Token.rparen) { break }
                continue
            }
            name: usize = mut self.expect(Token.ident, "parameter name")
            mut self.named(pa, self.text(name))
            mut self.expect(Token.colon, "':' after parameter name")
            self.nodes[pa].a = mut self.parse_type()
            mut self.push(pa)
            if !mut self.eat(Token.comma) || self.at(Token.rparen) { break } // trailing comma
        }
    }
    mut self.expect(Token.rparen, closer)
}

Parser.ret(mut self): u32 {
    if !mut self.eat(Token.colon) { return 0 }
    if self.at_void() {
        mut self.fail("a function with no return value omits its return clause; 'void' is only a function type's return")
        return 0
    }
    return mut self.parse_type()
}

/* At `@name`. */
Parser.named_attr_at(self, name: string): bool {
    return self.at(Token.at) && self.ident_at(1, name)
}

/* @align(expr) or @offset(expr), with its required terminating line. */
Parser.layout_attr(mut self, name: string): u32 {
    mut self.expect(Token.at, "'@' before a layout attribute")
    if !self.ident_at(0, name) { mut self.fail_at(self.i, ["expected @", name, " attribute"]) }
    self.i += 1
    mut self.expect(Token.lparen, "'(' after a layout attribute")
    value: u32 = mut self.expr(0)
    mut self.expect(Token.rparen, "')' after a layout attribute expression")
    line: u32 = self.prev_line()
    mut self.skipnl()
    if self.line() == line { mut self.fail_at(self.i, ["@", name, " must occupy its own line before a declaration or field"]) }
    return value
}

/* A type-parameter list `[T, U]` (identifiers only), when one starts here. */
Parser.tparams(mut self): u32 {
    if !self.at(Token.lbrack) || self.kth(1) != Token.ident { return 0 }
    j: usize = self.i + 1
    ok: bool = false
    for self.kind_at(j) == Token.ident {
        j += 1
        if self.kind_at(j) == Token.comma {
            j += 1
            continue
        }
        ok = self.kind_at(j) == Token.rbrack
        break
    }
    if !ok || self.failed { return 0 }
    tp: u32 = mut self.nd(Kind.tparams)
    mark: usize = self.nstack
    self.i += 1 // '['
    for {
        mut self.push(mut self.ident_node(Kind.ident, mut self.expect(Token.ident, "type parameter")))
        if !mut self.eat(Token.comma) || self.at(Token.rbrack) { break }
    }
    self.i += 1 // ']'
    mut self.close(tp, mark)
    return tp
}

/* `as "name"` after a C-boundary signature or type: the linker symbol when
 * it differs from the Ace-side name; "" when absent.
 */
Parser.link_name(mut self): string {
    if !self.ident_at(0, "as") { return "" } // an identifier fits: IDENT_MAX < 510
    self.i += 1
    link: string = self.text(mut self.expect(Token.string, "link name string after 'as'"))
    if link.len == 0 { mut self.fail("extern link name cannot be empty") }
    nul: usize, found: bool = str.find(link, '\0')
    if found { mut self.fail("extern link name cannot contain NUL") }
    // The emitter prefixes the Mach-O underscore in a 512-byte buffer.
    if link.len > 510 { mut self.fail("extern link name cannot exceed 510 bytes") }
    return link
}

Parser.func_rest(mut self, name: usize, tp: u32, pub_: bool, expo: bool, self_ok: bool): u32 {
    f: u32 = mut self.ident_node(Kind.func, name)
    if pub_ { self.nodes[f].flags |= F_PUB }
    if expo { self.nodes[f].flags |= F_EXPO }
    self.nodes[f].c = tp
    mut self.expect(Token.lparen, "'(' after function name")
    mark: usize = self.nstack
    mut self.params("')' to close parameters", self_ok)
    mut self.close(f, mark)
    self.nodes[f].a = mut self.ret()
    if expo { self.nodes[f].cname = mut self.link_name() } // an export's C symbol
    if mut self.eat(Token.specialized) {
        self.nodes[f].flags |= F_SPECIALIZED // no-default template: no body follows
        return f
    }
    if mut self.eat(Token.intrinsic) {
        self.nodes[f].flags |= F_INTRINSIC // compiler-owned implementation; no source body
        return f
    }
    self.nodes[f].b = mut self.block()
    return f
}

/* The owner `Name[T, ...]` as a type, its arguments the type parameters. */
Parser.owner_type(mut self, name: usize, tp: u32): u32 {
    t: u32 = mut self.ident_node(Kind.named, name)
    if tp != 0 {
        mark: usize = self.nstack
        for k: u32 in 0..self.nodes[tp].nkids {
            a: u32 = mut self.nd(Kind.named)
            mut self.named(a, self.nodes[self.kid(tp, k)].text)
            mut self.push(a)
        }
        mut self.close(t, mark)
    }
    return t
}

/* Type.name(...): a method when its first parameter is the receiver `self`
 * (typed here as the owner), otherwise an associated function.
 */
Parser.type_func_rest(mut self, owner: usize, tp: u32, pub_: bool): u32 {
    mut self.expect(Token.dot, "'.' after function owner")
    name: usize = mut self.expect_member("function name after '.'")
    f: u32 = mut self.func_rest(name, tp, pub_, false, true)
    d: u32 = mut self.owner_type(owner, tp)
    self.nodes[f].d = d
    if self.nodes[f].nkids != 0 && self.nodes[self.kid(f, 0)].a == 0 {
        recv: u32 = self.kid(f, 0)
        self.nodes[f].flags |= F_METHOD
        if (self.nodes[recv].flags & F_MUT) != 0 { self.nodes[f].flags |= F_MUT }
        self.nodes[recv].a = d
    } else {
        self.nodes[f].flags |= F_ASSOC
    }
    return f
}

Parser.signing_list_line(mut self, line: u32) {
    if self.line() != line { mut self.fail("bare signed-contract lists must stay on one line; use parentheses for a multiline list") }
}

Parser.signing(mut self, owner: usize, tp: u32, pub_: bool): u32 {
    n: u32 = mut self.make(Kind.signing, owner)
    self.nodes[n].a = mut self.owner_type(owner, tp)
    self.nodes[n].c = tp
    if pub_ { self.nodes[n].flags |= F_PUB }
    sline: u32 = self.line()
    mut self.expect(Token.signs, "'signs'")
    mark: usize = self.nstack
    if mut self.eat(Token.lparen) {
        if self.at(Token.rparen) { mut self.fail("a signing needs at least one contract") }
        for {
            c: u32 = mut self.nd(Kind.conformance)
            self.nodes[c].a = mut self.parse_type()
            mut self.push(c)
            if !mut self.eat(Token.comma) || self.at(Token.rparen) { break }
        }
        if self.line() == sline { mut self.fail("parentheses after 'signs' are only for multiline contract lists") }
        mut self.expect(Token.rparen, "')' to close signed contracts")
    } else {
        if self.at(Token.newline) || self.at(Token.eof) { mut self.fail("a signing needs at least one contract") }
        for {
            mut self.signing_list_line(sline)
            c: u32 = mut self.nd(Kind.conformance)
            self.nodes[c].a = mut self.parse_type()
            mut self.push(c)
            if self.prev_line() != sline {
                mut self.fail("bare signed-contract lists must stay on one line; use parentheses for a multiline list")
            }
            if !self.at(Token.comma) { break }
            mut self.signing_list_line(sline)
            self.i += 1
            mut self.signing_list_line(sline)
        }
    }
    mut self.close(n, mark)
    return n
}

Parser.bits_decl(mut self, name: usize, tp: u32, pub_: bool): u32 {
    if tp != 0 { mut self.fail("bits types are not generic") }
    self.i += 1
    n: u32 = mut self.ident_node(Kind.bits, name)
    if pub_ { self.nodes[n].flags |= F_PUB }
    self.nodes[n].a = mut self.parse_type()
    mut self.expect(Token.lbrace, "'{' after bits backing type")
    mark: usize = self.nstack
    if !self.at(Token.rbrace) {
        for {
            fl: u32 = mut self.ident_node(Kind.field, mut self.expect_member("bit-field name or '_'"))
            mut self.expect(Token.colon, "':' after bit-field name")
            if self.ident_at(0, "signed") {
                self.nodes[fl].flags |= F_CONST
                self.i += 1
            }
            width: usize = mut self.expect(Token.int, "positive bit-field width")
            if !self.failed { self.nodes[fl].ival = self.toks[width].ival }
            mut self.push(fl)
            if !mut self.eat(Token.comma) || self.at(Token.rbrace) { break }
        }
    }
    mut self.expect(Token.rbrace, "'}' to close bits type")
    mut self.close(n, mark)
    return n
}

Parser.struct_decl(mut self, name: usize, tp: u32, pub_: bool): u32 {
    self.i += 1
    n: u32 = mut self.ident_node(Kind.struct, name)
    self.nodes[n].c = tp
    if pub_ { self.nodes[n].flags |= F_PUB }
    mut self.expect(Token.lbrace, "'{' after 'struct'")
    mark: usize = self.nstack
    if !self.at(Token.rbrace) {
        for {
            offset: u32 = 0
            align: u32 = 0
            if self.named_attr_at("offset") {
                offset = mut self.layout_attr("offset")
                if self.named_attr_at("offset") { mut self.fail("a field accepts at most one @offset attribute") }
            }
            if self.named_attr_at("align") {
                align = mut self.layout_attr("align")
                if self.named_attr_at("align") { mut self.fail("a field accepts at most one @align attribute") }
                if self.named_attr_at("offset") { mut self.fail("@offset precedes @align on a field") }
            } else if self.at(Token.at) {
                mut self.fail("only @offset and @align may modify a struct field")
            }
            embedded: bool = self.at(Token.embed) && self.kth(1) != Token.colon && mut self.eat(Token.embed) // `embed: T` names a field
            fl: u32 = mut self.ident_node(Kind.field, mut self.expect_member("field name"))
            if embedded { self.nodes[fl].flags |= F_EMBED }
            self.nodes[fl].b = align
            self.nodes[fl].d = offset
            mut self.expect(Token.colon, "':' after field name")
            self.nodes[fl].a = mut self.parse_type()
            if mut self.eat(Token.assign) { self.nodes[fl].c = mut self.expr(0) }
            mut self.push(fl)
            if !mut self.eat(Token.comma) || self.at(Token.rbrace) { break } // trailing comma
        }
    }
    mut self.expect(Token.rbrace, "'}' to close struct")
    mut self.close(n, mark)
    return n
}

Parser.contract_decl(mut self, name: usize, tp: u32, pub_: bool): u32 {
    self.i += 1
    n: u32 = mut self.ident_node(Kind.contract, name)
    self.nodes[n].c = tp
    if pub_ { self.nodes[n].flags |= F_PUB }
    mut self.expect(Token.lbrace, "'{' after 'contract'")
    methods: usize = self.nstack
    mut self.skipnl()
    for !self.at(Token.rbrace) {
        if self.at(Token.eof) {
            mut self.fail("unexpected end of file in contract")
            break
        }
        m: u32 = mut self.nd(Kind.method)
        if self.at(Token.mut) { mut self.fail("a contract method takes no leading 'mut'; a mutating receiver is written 'mut self'") }
        mname: usize = mut self.expect_member("method name")
        mut self.named(m, self.text(mname))
        mut self.expect(Token.lparen, "'(' after method name")
        mark: usize = self.nstack
        mut self.params("')' to close method parameters", true)
        if self.nstack == mark || self.nodes[self.stack[mark]].a != 0 {
            mut self.fail_at(mname, ["a contract method's first parameter is its receiver 'self' or 'mut self'"])
        }
        if self.failed { break }
        // the receiver stays implied in the contract's method node
        if (self.nodes[self.stack[mark]].flags & F_MUT) != 0 { self.nodes[m].flags |= F_MUT }
        mut self.close(m, mark + 1)
        self.nstack = mark
        self.nodes[m].a = mut self.ret()
        mut self.push(m)
        if !mut self.eat(Token.newline) && !self.at(Token.rbrace) { mut self.fail("expected newline or '}' after method") }
        mut self.skipnl()
    }
    self.i += 1 // '}'
    mut self.close(n, methods)
    return n
}

Parser.enum_decl(mut self, name: usize, pub_: bool): u32 {
    self.i += 1
    n: u32 = mut self.ident_node(Kind.enum, name)
    if pub_ { self.nodes[n].flags |= F_PUB }
    if !self.at(Token.lbrace) { self.nodes[n].a = mut self.parse_type() }
    mut self.expect(Token.lbrace, "'{' after 'enum'")
    mark: usize = self.nstack
    if !self.at(Token.rbrace) {
        for {
            m: u32 = mut self.ident_node(Kind.ident, mut self.expect_member("enum member"))
            if mut self.eat(Token.assign) { self.nodes[m].a = mut self.expr(0) }
            mut self.push(m)
            if !mut self.eat(Token.comma) || self.at(Token.rbrace) { break } // trailing comma
        }
    }
    mut self.expect(Token.rbrace, "'}' to close enum")
    mut self.close(n, mark)
    return n
}

Parser.union_decl(mut self, name: usize, tp: u32, pub_: bool): u32 {
    self.i += 1
    n: u32 = mut self.ident_node(Kind.union, name)
    self.nodes[n].c = tp
    if pub_ { self.nodes[n].flags |= F_PUB }
    mut self.expect(Token.lbrace, "'{' after 'union'")
    mark: usize = self.nstack
    if !self.at(Token.rbrace) {
        for {
            v: u32 = mut self.ident_node(Kind.variant, mut self.expect_member("variant name"))
            if mut self.eat(Token.colon) { self.nodes[v].a = mut self.parse_type() } // payload: exactly one explicit type
            mut self.push(v)
            if !mut self.eat(Token.comma) || self.at(Token.rbrace) { break } // trailing comma
        }
    }
    mut self.expect(Token.rbrace, "'}' to close union")
    mut self.close(n, mark)
    return n
}

Parser.error_decl(mut self, name: usize, pub_: bool): u32 {
    self.i += 1
    n: u32 = mut self.ident_node(Kind.error, name)
    if pub_ { self.nodes[n].flags |= F_PUB }
    if !mut self.eat(Token.lbrace) { return n }
    mark: usize = self.nstack
    mut self.skipnl()
    for !self.at(Token.rbrace) {
        if self.at(Token.eof) {
            mut self.fail("unexpected end of file in error domain")
            break
        }
        entry: u32 = mut self.nd(Kind.field)
        self.nodes[entry].a = mut self.expr(0)
        mut self.expect(Token.colon, "':' after error code")
        mut self.named(entry, self.text(mut self.expect_member("error entry name")))
        mut self.expect(Token.assign, "'=' after error entry name")
        self.nodes[entry].b = mut self.expr(0)
        mut self.push(entry)
        mut self.skipnl()
        if !mut self.eat(Token.comma) {
            if !self.at(Token.rbrace) { mut self.fail("expected ',' after error entry") }
            break
        }
        mut self.skipnl()
    }
    self.i += 1 // '}'
    mut self.close(n, mark)
    return n
}

/* A global `Name: [const] T [= value]`. */
Parser.global_decl(mut self, name: usize, pub_: bool): u32 {
    n: u32 = mut self.make(Kind.var, name)
    if pub_ { self.nodes[n].flags |= F_PUB }
    is_const: bool = mut self.eat(Token.const)
    if self.at(Token.ident) && self.kth(1) == Token.lbrace {
        mut self.fail_at(self.i, ["unknown declaration type '", self.text(self.i), "'"])
    }
    binder: u32 = mut self.ident_node(Kind.param, name)
    self.nodes[binder].a = mut self.parse_type()
    mark: usize = self.nstack
    mut self.push(binder)
    if is_const { self.nodes[n].flags |= F_CONST }
    mut self.close(n, mark)
    if mut self.eat(Token.assign) {
        a: u32 = self.nodes[binder].a
        b: u32 = 0
        if a != 0 && self.nodes[a].kind == Kind.staticmap_t && self.at(Token.lbrace) {
            b = mut self.staticmaplit()
        } else {
            b = mut self.expr_list(0)
        }
        self.nodes[n].b = b
    } else if is_const {
        mut self.fail("const declaration requires an initializer")
    }
    return n
}

/* After `Name:`, the kind word decides; otherwise a global var or const. */
Parser.colon_decl(mut self, name: usize, tp: u32, pub_: bool): u32 {
    self.i += 1 // ':'
    if self.ident_at(0, "bits") { return mut self.bits_decl(name, tp, pub_) }
    switch self.kth(0) {
        Token.struct { return mut self.struct_decl(name, tp, pub_) }
        Token.contract { return mut self.contract_decl(name, tp, pub_) }
        Token.enum { return mut self.enum_decl(name, pub_) }
        Token.union { return mut self.union_decl(name, tp, pub_) }
        Token.distinct {
            self.i += 1
            n: u32 = mut self.ident_node(Kind.distinct, name)
            if pub_ { self.nodes[n].flags |= F_PUB }
            self.nodes[n].a = mut self.parse_type()
            return n
        }
        Token.type { // alias: Name: type = Existing
            self.i += 1
            n: u32 = mut self.ident_node(Kind.alias, name)
            self.nodes[n].c = tp
            if pub_ { self.nodes[n].flags |= F_PUB }
            mut self.expect(Token.assign, "'=' after 'type'")
            self.nodes[n].a = mut self.parse_type()
            return n
        }
        default {
            if self.ident_at(0, "error") { return mut self.error_decl(name, pub_) }
            return mut self.global_decl(name, pub_)
        }
    }
}

/* A C-ABI definition `name(params): R { body }` from token `start`; the body
 * makes it an export rather than an import.
 */
Parser.extern_def(mut self, start: usize, pub_: bool): u32 {
    self.i = start
    self.i += 1
    tp: u32 = mut self.tparams() // sema rejects generics
    return mut self.func_rest(start, tp, pub_, true, false)
}

/* An exported C global after `[mut] name: T`: an ordinary global with C
 * linkage, read-only unless mut.
 */
Parser.extern_global(mut self, name: usize, ty: u32, cname: string, mut_: bool, pub_: bool): u32 {
    n: u32 = mut self.make(Kind.var, name)
    binder: u32 = mut self.ident_node(Kind.param, name)
    self.nodes[binder].a = ty
    mark: usize = self.nstack
    mut self.push(binder)
    mut self.close(n, mark)
    flags: u32 = F_EXPO
    if mut_ { flags |= F_MUT }
    self.nodes[binder].flags |= flags
    if pub_ { flags |= F_PUB }
    self.nodes[n].flags |= flags
    self.nodes[n].cname = cname
    self.nodes[binder].cname = cname
    mut self.expect(Token.assign, "'=' and an initializer: a C global defined in Ace")
    self.nodes[n].b = mut self.expr_list(0)
    return n
}

Parser.export(mut self, x: u32) {
    if self.nexport == self.exports.len { self.exports = grow[u32](self.exports) }
    self.exports[self.nexport] = x
    self.nexport += 1
}

Parser.extern_end(mut self) {
    if !mut self.eat(Token.newline) && !self.at(Token.rbrace) { mut self.fail("expected newline or '}' after extern declaration") }
    mut self.skipnl()
}

Parser.extern_block(mut self): u32 {
    n: u32 = mut self.nd(Kind.extern)
    mut self.expect(Token.extern, "'extern'")
    mut self.named(n, self.text(mut self.expect(Token.string, "ABI string after 'extern'")))
    mut self.expect(Token.lbrace, "'{' to open extern block")
    fns: usize = self.nstack
    self.nexport = 0
    mut self.skipnl()
    for !self.at(Token.rbrace) {
        if self.at(Token.eof) {
            mut self.fail("unexpected end of file in extern block")
            break
        }
        f: u32 = mut self.nd(Kind.externfn)
        start: usize = self.i
        def: bool = false // a body follows: an Ace definition with C linkage
        if mut self.eat(Token.mut) { self.nodes[f].flags |= F_MUT }
        name: usize = mut self.expect(Token.ident, "name in extern block")
        mut self.named(f, self.text(name))
        if mut self.eat(Token.colon) { // a C global variable
            self.nodes[f].kind = Kind.externvar
            self.nodes[f].a = mut self.parse_type()
            self.nodes[f].cname = mut self.link_name()
            if self.at(Token.assign) {
                mut_: bool = (self.nodes[f].flags & F_MUT) != 0
                mut self.export(mut self.extern_global(name, self.nodes[f].a, self.nodes[f].cname, mut_, false))
                mut self.extern_end()
                continue
            }
        } else {
            if (self.nodes[f].flags & F_MUT) != 0 { mut self.fail("'mut' marks an extern variable: expected ':' after its name") }
            if self.at(Token.lbrack) {
                def = true // generic: reparsed as a definition for sema to reject
            } else {
                mut self.expect(Token.lparen, "'(' after extern function name")
            }
            if !def && !self.at(Token.rparen) {
                mark: usize = self.nstack
                for {
                    pa: u32 = mut self.nd(Kind.param)
                    if self.at(Token.mut) { // only a definition can say this; reparsed below
                        def = true
                        break
                    }
                    mut self.named(pa, self.text(mut self.expect(Token.ident, "parameter name")))
                    mut self.expect(Token.colon, "':' after parameter name")
                    self.nodes[pa].a = mut self.parse_type()
                    mut self.push(pa)
                    if !mut self.eat(Token.comma) { break }
                    if self.at(Token.dot_dot_dot) {
                        self.i += 1
                        self.nodes[f].flags |= F_VARARGS
                        break
                    }
                    if self.at(Token.rparen) { break } // trailing comma
                }
                mut self.close(f, mark)
            }
            if !def {
                mut self.expect(Token.rparen, "')' to close extern parameters")
                self.nodes[f].a = mut self.ret()
                self.nodes[f].cname = mut self.link_name()
                def = self.at(Token.lbrace)
            }
            if def {
                if (self.nodes[f].flags & F_VARARGS) != 0 { mut self.fail("variadic functions cannot be defined in Ace") }
                mut self.export(mut self.extern_def(start, false))
                mut self.extern_end()
                continue
            }
        }
        mut self.push(f)
        mut self.extern_end()
    }
    self.i += 1 // '}'
    mut self.close(n, fns)
    return n
}

/* `@name`, a compiler-reserved module, as a string node marked with '@'. */
Parser.internal_import(mut self): u32 {
    mut self.expect(Token.at, "'@'")
    name: usize = mut self.expect(Token.ident, "reserved module name after '@'")
    if self.at(Token.dot) { mut self.fail("reserved module imports omit the .ace suffix") }
    path: u32 = mut self.nd(Kind.str_lit)
    mut self.named(path, self.text(name))
    self.nodes[path].op = Token.at
    return path
}

/* A module path `a/b/c` from its consumed first segment: the chain head to
 * leaf, linked through each segment's `a`, and the leaf.
 */
Parser.import_path(mut self, first: usize): (u32, u32) {
    head: u32 = mut self.ident_node(Kind.ident, first)
    tail: u32 = head
    for self.at(Token.slash) {
        self.i += 1
        next: u32 = mut self.ident_node(Kind.ident, mut self.expect(Token.ident, "module path segment after '/'"))
        self.nodes[tail].a = next
        tail = next
    }
    return head, tail
}

/* An import's target after 'from' or ':': a module name, a path, or an
 * internal module; false when none is there.
 */
Parser.import_target(mut self, n: u32): bool {
    if self.at(Token.ident) {
        target: usize = self.i
        self.i += 1
        head: u32, leaf: u32 = mut self.import_path(target)
        self.nodes[n].c = head
        self.nodes[n].b = leaf
    } else if self.at(Token.string) {
        s: u32 = mut self.leaf(Kind.str_lit)
        mut self.named(s, self.text(self.i - 1))
        self.nodes[n].a = s
    } else if self.at(Token.at) {
        self.nodes[n].a = mut self.internal_import()
    } else {
        return false
    }
    return true
}

Parser.import(mut self): u32 {
    n: u32 = mut self.nd(Kind.import)
    mut self.expect(Token.import, "'import'")
    paren: bool = mut self.eat(Token.lparen)
    what: string = "module or member name after 'import'"
    if paren { what = "imported member name" }
    first: usize = mut self.expect(Token.ident, what)
    if paren || self.at(Token.comma) || self.ident_at(0, "from") {
        self.nodes[n].flags |= F_SELECT
        mark: usize = self.nstack
        mut self.push(mut self.ident_node(Kind.ident, first))
        if paren {
            for {
                if !mut self.eat(Token.comma) || self.at(Token.rparen) { break }
                mut self.push(mut self.ident_node(Kind.ident, mut self.expect(Token.ident, "imported member name")))
            }
            mut self.expect(Token.rparen, "')' after imported member list")
            if self.prev_line() == self.nodes[n].line {
                mut self.fail("parentheses in a selective import are only for a multiline member list")
            }
        } else {
            line: u32 = self.toks[first].line
            for self.at(Token.comma) {
                mut self.bare_list_line(line)
                self.i += 1
                mut self.bare_list_line(line)
                mut self.push(mut self.ident_node(Kind.ident, mut self.expect(Token.ident, "imported member name")))
            }
        }
        mut self.close(n, mark)
        if !self.ident_at(0, "from") { mut self.fail_got("expected 'from' after imported member list, got ") }
        self.i += 1
        if !mut self.import_target(n) { mut self.fail("expected module name, path, or internal module after 'from'") }
    } else {
        head: u32, leaf: u32 = mut self.import_path(first)
        self.nodes[n].c = head
        mut self.named(n, self.nodes[leaf].text)
    }
    if mut self.eat(Token.colon) {
        if (self.nodes[n].flags & F_SELECT) != 0 { mut self.fail("selective imports use 'from', not ':'") }
        // `m: math` alias, `util: "./util.ace"` path, `big: @bigint` reserved
        if !mut self.import_target(n) { mut self.fail("expected module name, path, or internal module after ':' in import") }
    }
    if !mut self.eat(Token.newline) && !self.at(Token.eof) { mut self.fail("expected newline after import") }
    return n
}

/* @when's deliberately closed evaluator: target/string comparisons,
 * booleans, and/or/not, and parentheses. Inactive declarations are still
 * parsed for syntax, then omitted from the file.
 */
Parser.when_primary(mut self): bool {
    if mut self.eat(Token.true) { return true }
    if mut self.eat(Token.false) { return false }
    if mut self.eat(Token.lparen) {
        value: bool = mut self.when_or()
        mut self.expect(Token.rparen, "')' after @when expression")
        return value
    }
    if self.ident_at(0, "target") {
        self.i += 1
        op: Token = self.kth(0)
        if op != Token.eq_eq && op != Token.bang_eq { mut self.fail("expected '==' or '!=' after target in @when expression") }
        self.i += 1
        value: string = self.text(mut self.expect(Token.string, "target string after comparison"))
        return mem.equal(self.target, value) == (op == Token.eq_eq)
    }
    if self.at(Token.ident) { mut self.fail_at(self.i, ["unknown @when compile-time name '", self.text(self.i), "'"]) }
    mut self.fail("expected target comparison, boolean, or parenthesized @when expression")
    return false
}

Parser.when_not(mut self): bool {
    if self.ident_at(0, "not") {
        self.i += 1
        return !mut self.when_not()
    }
    return mut self.when_primary()
}

Parser.when_and(mut self): bool {
    value: bool = mut self.when_not()
    for self.ident_at(0, "and") {
        self.i += 1
        rhs: bool = mut self.when_not() // parse even when the value is already false
        value = value && rhs
    }
    return value
}

Parser.when_or(mut self): bool {
    value: bool = mut self.when_and()
    for self.ident_at(0, "or") {
        self.i += 1
        rhs: bool = mut self.when_and() // parse even when the value is already true
        value = value || rhs
    }
    return value
}

Parser.when(mut self): bool {
    mut self.expect(Token.at, "'@'")
    if !self.ident_at(0, "when") { mut self.fail("only the @when attribute is supported") }
    self.i += 1
    mut self.expect(Token.lparen, "'(' after @when")
    active: bool = mut self.when_or()
    mut self.expect(Token.rparen, "')' after @when expression")
    line: u32 = self.prev_line()
    mut self.skipnl()
    if self.line() == line { mut self.fail("@when must occupy its own line before a declaration") }
    if self.at(Token.eof) { mut self.fail("@when must be followed by a top-level declaration") }
    return active
}

/* A bare attribute `@name` on its own line. */
Parser.own_line_attr(mut self, message: string) {
    self.i += 2
    line: u32 = self.prev_line()
    mut self.skipnl()
    if self.line() == line { mut self.fail(message) }
}

/* @cold, @packed, and @align(n) before a declaration: (packed, align, cold). */
Parser.layout_attrs(mut self): (bool, u32, bool) {
    packed: bool = false
    align: u32 = 0
    cold: bool = false
    for self.at(Token.at) {
        if self.named_attr_at("cold") {
            if cold { mut self.fail("a declaration accepts at most one @cold attribute") }
            mut self.own_line_attr("@cold must occupy its own line before a declaration")
            cold = true
            continue
        }
        if self.named_attr_at("packed") {
            if packed { mut self.fail("a declaration accepts at most one @packed attribute") }
            if align != 0 { mut self.fail("@packed must precede @align") }
            mut self.own_line_attr("@packed must occupy its own line before a declaration")
            packed = true
            continue
        }
        if self.named_attr_at("align") {
            if align != 0 { mut self.fail("a declaration accepts at most one @align attribute") }
            align = mut self.layout_attr("align")
            continue
        }
        if self.named_attr_at("when") { mut self.fail("@when must precede layout attributes") }
        mut self.fail("unknown top-level attribute")
    }
    return packed, align, cold
}

Parser.top(mut self): u32 {
    if self.at(Token.import) { mut self.fail("imports must precede declarations") }
    pub_: bool = false
    inl: bool = false
    for {
        if self.at(Token.pub) {
            if inl { mut self.fail("visibility must come before 'inline'") }
            if pub_ { mut self.fail("duplicate 'pub' modifier") }
            self.i += 1
            pub_ = true
        } else if self.at(Token.inline) {
            if inl { mut self.fail("duplicate 'inline' modifier") }
            self.i += 1
            inl = true
        } else if self.at(Token.mut) {
            mut self.fail("a top-level declaration takes no leading 'mut'; a mutating receiver is written 'mut self'")
        } else {
            break
        }
    }
    if self.at(Token.extern) && self.kth(1) == Token.string && (self.kth(2) == Token.ident || self.kth(2) == Token.mut) {
        // `extern "c" name(...) { body }` or `extern "c" [mut] name: T = value`
        self.i += 2
        gmut: bool = mut self.eat(Token.mut)
        if gmut || self.kth(1) == Token.colon {
            if inl { mut self.fail("'inline' applies only to function declarations") }
            name: usize = mut self.expect(Token.ident, "C global name")
            mut self.expect(Token.colon, "':' after C global name")
            ty: u32 = mut self.parse_type()
            cname: string = mut self.link_name()
            return mut self.extern_global(name, ty, cname, gmut, pub_)
        }
        if self.kth(1) == Token.dot { mut self.fail("methods and associated functions cannot use the C ABI") }
        f: u32 = mut self.extern_def(self.i, pub_)
        if inl { self.nodes[f].flags |= F_INLINE }
        return f
    }
    if self.at(Token.extern) {
        if pub_ || inl { mut self.fail("'extern' blocks take no pub/inline") }
        return mut self.extern_block()
    }
    if !self.at(Token.ident) { mut self.fail_got("expected declaration, got ") }
    start: usize = self.i
    d: u32 = mut self.top_named(pub_)
    if inl && !self.failed {
        if self.nodes[d].kind != Kind.func {
            mut self.fail_at(start, ["'inline' applies only to function declarations"]) // at the declaration's name
        }
        self.nodes[d].flags |= F_INLINE
    }
    return d
}

Parser.top_named(mut self, pub_: bool): u32 {
    name: usize = self.i
    self.i += 1
    if mem.equal(self.text(name), "static_assert") && self.at(Token.lparen) {
        self.i -= 1
        n: u32 = mut self.make(Kind.exprstmt, name)
        self.nodes[n].a = mut self.expr(0)
        return n
    }
    tp: u32 = mut self.tparams()
    if self.at(Token.signs) { return mut self.signing(name, tp, pub_) }
    if self.at(Token.dot) { return mut self.type_func_rest(name, tp, pub_) }
    if self.at(Token.lparen) { return mut self.func_rest(name, tp, pub_, false, false) }
    if self.at(Token.colon) { return mut self.colon_decl(name, tp, pub_) }
    mut self.fail_at(self.i, ["expected '(' or ':' after top-level name '", self.text(name), "'"])
    return 0
}

/* Parses the whole file for `target` (what @when compares against) and
 * returns its file node; on a syntax error, see `error`.
 */
pub Parser.parse(mut self, target: string): u32 {
    self.target = target
    file: u32 = mut self.make(Kind.file, 0)
    self.nodes[file].line = 1
    self.nodes[file].col = 1
    decls: usize = self.nstack
    mut self.skipnl()
    saw_declaration: bool = false
    for !self.at(Token.eof) {
        active: bool = true
        if self.named_attr_at("when") { active = mut self.when() }
        packed: bool, align: u32, cold: bool = mut self.layout_attrs()
        if self.at(Token.import) {
            if packed || align != 0 { mut self.fail("layout attributes do not apply to imports") }
            if cold { mut self.fail("@cold applies only to function declarations") }
            imp: u32 = mut self.import()
            if active {
                if saw_declaration { mut self.fail("imports must precede declarations") }
                mut self.push(imp)
            }
        } else {
            start: usize = self.i
            self.nexport = 0
            decl: u32 = mut self.top()
            if self.failed { break }
            x: Node = self.nodes[decl]
            if cold {
                if x.kind != Kind.func || (x.flags & F_EXPO) != 0 {
                    mut self.fail_at(start, ["@cold applies only to Ace function declarations"])
                }
                self.nodes[decl].flags |= F_COLD
            }
            if (packed || align != 0) && x.kind != Kind.struct {
                mut self.fail("layout attributes apply only to struct declarations")
            }
            if x.kind == Kind.struct {
                if packed { self.nodes[decl].flags |= F_PACKED }
                self.nodes[decl].b = align
            }
            if !mut self.eat(Token.newline) && !self.at(Token.eof) { mut self.fail_got("expected newline after declaration, got ") }
            if active {
                mut self.push(decl)
                if x.kind == Kind.extern {
                    for j: usize in 0..self.nexport { mut self.push(self.exports[j]) }
                }
                saw_declaration = true
            }
            self.nexport = 0
        }
        mut self.skipnl()
    }
    if self.failed {
        self.nstack = decls // C returns the file with no declarations
    }
    mut self.close(file, decls)
    return file
}

// --- dump ---------------------------------------------------------------------

/* Prints the tree at `n` as `ace --ast` does. */
pub Parser.dump(self, mut out: Out, n: u32, ind: usize) {
    for j: usize in 0..ind { mut out.printf(" ") }
    if n == 0 {
        mut out.printf("nil\n")
        return
    }
    x: Node = self.nodes[n]
    mut out.printf("(%s", x.kind.name)
    if (x.flags & F_TEXT) != 0 {
        // C prints with "%.*s", which stops at an embedded NUL.
        nul: usize, found: bool = str.find(x.text, '\0')
        text: string = x.text
        if found { text = x.text[..nul] }
        mut out.printf(" '%s'", text)
    }
    switch x.kind {
        Kind.int_lit, Kind.char_lit, Kind.bool { mut out.printf(" %u", uint(x.ival)) }
        Kind.float_lit { mut out.printf(" %g", x.fval) }
        Kind.binary, Kind.unary, Kind.assign, Kind.op { mut out.printf(" op='%s'", lexer.disp(x.op)) }
        default {}
    }
    for j: usize in 0..FLAG_BITS.len {
        if (x.flags & FLAG_BITS[j]) != 0 { mut out.printf("%s", FLAG_NAMES[j]) }
    }
    mut out.printf(" @%d:%d", int(x.line), int(x.col))
    // C tests the kids pointer: a contract method's points past its receiver.
    if x.a == 0 && x.b == 0 && x.c == 0 && x.d == 0 && x.nkids == 0 && x.kind != Kind.method {
        mut out.printf(")\n")
        return
    }
    mut out.printf("\n")
    if x.a != 0 { self.dump(mut out, x.a, ind + 1) }
    if x.b != 0 { self.dump(mut out, x.b, ind + 1) }
    if x.c != 0 { self.dump(mut out, x.c, ind + 1) }
    if x.d != 0 { self.dump(mut out, x.d, ind + 1) }
    for k: u32 in 0..x.nkids { self.dump(mut out, self.kids[x.kids + k], ind + 1) }
    for j: usize in 0..ind { mut out.printf(" ") }
    mut out.printf(")\n")
}
