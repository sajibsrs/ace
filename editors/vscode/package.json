{
  "name": "ace-language",
  "displayName": "Ace",
  "publisher": "sajibsrs",
  "description": "Ace language support: syntax highlighting, file icons, editor configuration, and an outline and go to definition from ace-lsp.",
  "author": "Sajidur Rahman",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "icon": "icons/ace-framed.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ace",
        "aliases": [
          "Ace",
          "ace"
        ],
        "extensions": [
          ".ace"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/ace.svg",
          "dark": "./icons/ace.svg"
        }
      },
      {
        "id": "ace-pkg",
        "aliases": [
          "Ace Package Manifest"
        ],
        "filenames": [
          "ace.pkg"
        ],
        "configuration": "./pkg-language-configuration.json",
        "icon": {
          "light": "./icons/ace-pkg.svg",
          "dark": "./icons/ace-pkg.svg"
        }
      },
      {
        "id": "acefmt",
        "aliases": [
          "Ace Format Rules"
        ],
        "filenames": [
          ".acefmt"
        ],
        "configuration": "./acefmt-language-configuration.json",
        "icon": {
          "light": "./icons/acefmt.svg",
          "dark": "./icons/acefmt.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ace",
        "scopeName": "source.ace",
        "path": "./syntaxes/ace.tmLanguage.json"
      },
      {
        "language": "ace-pkg",
        "scopeName": "source.ace-pkg",
        "path": "./syntaxes/ace-pkg.tmLanguage.json"
      },
      {
        "language": "acefmt",
        "scopeName": "source.acefmt",
        "path": "./syntaxes/acefmt.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Ace",
      "properties": {
        "ace.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to an ace-lsp executable to use instead of the one bundled with the extension."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "rm -rf bin && mkdir -p bin && ../../ace -o bin/ace-lsp ../../lsp/main.ace && rm -f bin/ace-lsp.o && cp -R ../../std bin/std"
  }
}
