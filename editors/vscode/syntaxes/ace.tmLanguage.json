{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ace",
  "scopeName": "source.ace",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#attributes" },
    { "include": "#imports" },
    { "include": "#externs" },
    { "include": "#generic-declarations" },
    { "include": "#type-declarations" },
    { "include": "#method-declarations" },
    { "include": "#function-declarations" },
    { "include": "#contextual-keywords" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#primitive-types" },
    { "include": "#constants" },
    { "include": "#namespaces" },
    { "include": "#type-parameters" },
    { "include": "#generic-instantiations" },
    { "include": "#named-types" },
    { "include": "#function-calls" },
    { "include": "#member-access" },
    { "include": "#operators" },
    { "include": "#identifiers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.when.ace",
          "match": "(@)(when|packed|align)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.ace" },
            "2": { "name": "support.function.attribute.ace" }
          }
        },
        {
          "name": "variable.language.target.ace",
          "match": "\\btarget\\b"
        },
        {
          "name": "keyword.operator.logical.ace",
          "match": "\\b(?:and|or|not)\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ace",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ace",
          "begin": "/\\*",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.ace" }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.ace" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ace",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.ace" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.ace" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.ace",
          "match": "\\\\(?:[\\\\\"'nrt0]|x[0-9A-Fa-f]{2})"
        },
        {
          "name": "invalid.illegal.escape.ace",
          "match": "\\\\."
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single.ace",
      "begin": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.ace" }
      },
      "end": "'",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.ace" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.ace",
          "match": "\\\\(?:[\\\\\"'nrt0]|x[0-9A-Fa-f]{2})"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ace",
          "match": "(?<![A-Za-z0-9_])(?:[0-9](?:_?[0-9])*)\\.(?:[0-9](?:_?[0-9])*)(?:[eE][+-]?[0-9](?:_?[0-9])*)?(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.ace",
          "match": "(?<![A-Za-z0-9_])0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.integer.binary.ace",
          "match": "(?<![A-Za-z0-9_])0b[01](?:_?[01])*(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.integer.decimal.ace",
          "match": "(?<![A-Za-z0-9_])[0-9](?:_?[0-9])*(?![A-Za-z0-9_])"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "(@)([A-Za-z_][A-Za-z0-9_]*)(\\.)(ace)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.module.ace" },
            "2": { "name": "entity.name.namespace.ace" },
            "3": { "name": "punctuation.accessor.ace" },
            "4": { "name": "support.constant.module-extension.ace" }
          }
        },
        {
          "begin": "\\b(import)\\b(?=[^\\n]*\\bfrom\\b)",
          "beginCaptures": {
            "1": { "name": "keyword.control.ace" }
          },
          "end": "\\b(from)\\b",
          "endCaptures": {
            "1": { "name": "keyword.control.ace" }
          },
          "patterns": [
            {
              "name": "variable.other.ace",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.ace",
              "match": ","
            }
          ]
        },
        {
          "begin": "\\b(import)\\b\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "keyword.control.ace" },
            "2": { "name": "punctuation.section.group.begin.ace" }
          },
          "end": "(\\))\\s*(from)\\b",
          "endCaptures": {
            "1": { "name": "punctuation.section.group.end.ace" },
            "2": { "name": "keyword.control.ace" }
          },
          "patterns": [
            {
              "name": "variable.other.ace",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.ace",
              "match": ","
            },
            { "include": "#comments" }
          ]
        },
        {
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(\"(?:\\\\.|[^\"])*\")",
          "captures": {
            "1": { "name": "keyword.control.ace" },
            "2": { "name": "entity.name.namespace.ace" },
            "3": { "name": "punctuation.separator.key-value.ace" },
            "4": { "name": "string.quoted.double.ace" }
          }
        },
        {
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.ace" },
            "2": { "name": "entity.name.namespace.ace" },
            "3": { "name": "punctuation.separator.key-value.ace" },
            "4": { "name": "entity.name.namespace.ace" }
          }
        },
        {
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*$",
          "captures": {
            "1": { "name": "keyword.control.ace" },
            "2": { "name": "entity.name.namespace.ace" }
          }
        }
      ]
    },
    "externs": {
      "patterns": [
        {
          "match": "\\b(extern)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.control.ace" },
            "2": { "name": "string.quoted.double.ace" }
          }
        }
      ]
    },
    "generic-declarations": {
      "patterns": [
        {
          "begin": "^\\s*(?:(pub)\\s+)?([A-Za-z_][A-Za-z0-9_]*)(\\[)(?=[^\\n]+\\]\\s*:\\s*(?:struct|contract|union|type)\\b)",
          "beginCaptures": {
            "1": { "name": "keyword.control.ace" },
            "2": { "name": "entity.name.type.ace" },
            "3": { "name": "punctuation.definition.typeparameters.begin.ace" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.end.ace" }
          },
          "patterns": [
            {
              "name": "entity.name.type.parameter.ace",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.ace",
              "match": ","
            }
          ]
        },
        {
          "begin": "^\\s*(?:(pub)\\s+)?([A-Za-z_][A-Za-z0-9_]*)(\\[)(?=[^\\n]+\\]\\s*\\([^\\n]*\\)(?:\\s*:\\s*[^{}\\n]+)?\\s*\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.ace" },
            "2": { "name": "entity.name.function.ace" },
            "3": { "name": "punctuation.definition.typeparameters.begin.ace" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.end.ace" }
          },
          "patterns": [
            {
              "name": "entity.name.type.parameter.ace",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.ace",
              "match": ","
            }
          ]
        },
        {
          "begin": "^\\s*(?:(pub)\\s+)?(?:(mut)\\s+)?([A-Za-z_][A-Za-z0-9_]*)(\\[)(?=[^\\n]+\\]\\s*\\.[A-Za-z_][A-Za-z0-9_]*\\s*\\()",
          "beginCaptures": {
            "1": { "name": "keyword.control.ace" },
            "2": { "name": "keyword.control.ace" },
            "3": { "name": "entity.name.type.ace" },
            "4": { "name": "punctuation.definition.typeparameters.begin.ace" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.end.ace" }
          },
          "patterns": [
            {
              "name": "entity.name.type.parameter.ace",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.ace",
              "match": ","
            }
          ]
        }
      ]
    },
    "type-declarations": {
      "patterns": [
        {
          "match": "^\\s*(?:(pub)\\s+)?([A-Za-z_][A-Za-z0-9_]*)(?:\\s*\\[[^\\n]+\\])?\\s*(?=:\\s*(?:struct|bits|contract|union|enum|type|distinct|error)\\b)",
          "captures": {
            "1": { "name": "keyword.control.ace" },
            "2": { "name": "entity.name.type.ace" }
          }
        },
        {
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\s*\\[[^\\n]+\\])?)\\s+(signs)\\b",
          "captures": {
            "1": { "name": "entity.name.type.ace" },
            "2": { "name": "keyword.control.ace" }
          }
        }
      ]
    },
    "method-declarations": {
      "patterns": [
        {
          "match": "^\\s*(?:(pub)\\s+)?(?:(mut)\\s+)?([A-Za-z_][A-Za-z0-9_]*(?:\\s*\\[[^\\n]+\\])?)\\.([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.control.ace" },
            "2": { "name": "keyword.control.ace" },
            "3": { "name": "entity.name.type.ace" },
            "4": { "name": "entity.name.function.ace" }
          }
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "^\\s*(?:(pub|export)\\s+)*([A-Za-z_][A-Za-z0-9_]*)(?:\\s*\\[[^\\n]+\\])?\\s*(?=\\([^\\n]*\\)(?:\\s*:\\s*[^{}\\n]+)?\\s*\\{)",
          "captures": {
            "1": { "name": "keyword.control.ace" },
            "2": { "name": "entity.name.function.ace" }
          }
        },
        {
          "match": "^\\s*(?:(export)\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\([^\\n]*\\)(?:\\s*:\\s*[^=\\n]+)?(?:\\s*=\\s*\"[^\"]+\")?\\s*$)",
          "captures": {
            "1": { "name": "keyword.control.ace" },
            "2": { "name": "entity.name.function.ace" }
          }
        }
      ]
    },
    "contextual-keywords": {
      "patterns": [
        {
          "name": "storage.type.ace",
          "match": "\\b(?:bits|signed)\\b(?=\\s+(?:u8|u16|u32|u64|[0-9]))"
        },
        {
          "match": "^(\\s*)(fallthrough)\\b(?=\\s*\\}\\s*(?:else\\b|[^{}\\n]+)\\s*\\{)",
          "captures": {
            "2": { "name": "keyword.control.ace" }
          }
        },
        {
          "match": "(?<=\\{)(\\s*)(fallthrough)\\b(?=\\s*\\}\\s*(?:else\\b|[^{}\\n]+)\\s*\\{)",
          "captures": {
            "2": { "name": "keyword.control.ace" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ace",
          "match": "\\b(?:out|clobbers)\\b(?=\\s*:)"
        },
        {
          "name": "storage.type.ace",
          "match": "\\berror\\b(?=\\s*(?:\\{|\\/\\/.*)?$)"
        },
        {
          "name": "keyword.control.ace",
          "match": "\\b(?:import|from|pub|mut|const|noalias|if|else|for|in|switch|return|break|continue|defer|asm|extern|export|contract|struct|embed|union|signs|specialized|intrinsic|distinct|type|enum|volatile)\\b"
        }
      ]
    },
    "primitive-types": {
      "name": "entity.name.type.ace support.type.builtin.ace",
      "match": "\\b(?:bool|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|float|string|char|usize|typeid|int|uint|Error|StaticMap|c_char|c_schar|c_uchar|c_short|c_ushort|c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong)\\b"
    },
    "builtins": {
      "name": "entity.name.function.ace support.function.builtin.ace",
      "match": "\\b(?:sizeof|alignof|offsetof|len|typeid|panic|assert|static_assert)\\b(?=\\s*\\()"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.ace",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "variable.other.ace",
          "match": "\\bself\\b"
        }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "name": "entity.name.namespace.ace",
          "match": "\\b(?:fmt|math|mem|sys)\\b(?=\\s*\\.)"
        },
        {
          "name": "entity.name.namespace.ace",
          "match": "(?<=\\bfrom\\s)[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "type-parameters": {
      "name": "entity.name.type.parameter.ace",
      "match": "\\b[A-Z]\\b"
    },
    "generic-instantiations": {
      "patterns": [
        {
          "begin": "\\b([a-z_][A-Za-z0-9_]*)(\\[)(?=[^\\n]+\\]\\s*\\()",
          "beginCaptures": {
            "1": { "name": "entity.name.function.ace" },
            "2": { "name": "punctuation.definition.typearguments.begin.ace" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.typearguments.end.ace" }
          },
          "patterns": [
            { "include": "#primitive-types" },
            { "include": "#type-parameters" },
            { "include": "#generic-instantiations" },
            { "include": "#named-types" },
            {
              "name": "entity.name.type.ace",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.ace",
              "match": ","
            },
            { "include": "#operators" }
          ]
        },
        {
          "begin": "\\b([A-Z][A-Za-z0-9_]*)(\\[)",
          "beginCaptures": {
            "1": { "name": "entity.name.type.ace" },
            "2": { "name": "punctuation.definition.typearguments.begin.ace" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.typearguments.end.ace" }
          },
          "patterns": [
            { "include": "#primitive-types" },
            { "include": "#type-parameters" },
            { "include": "#generic-instantiations" },
            { "include": "#named-types" },
            {
              "name": "entity.name.type.ace",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.ace",
              "match": ","
            },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "function-calls": {
      "name": "entity.name.function.ace",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*(?:\\[[^\\n]+\\])?\\s*\\()"
    },
    "named-types": {
      "name": "entity.name.type.ace",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "member-access": {
      "name": "variable.other.ace",
      "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
    },
    "identifiers": {
      "name": "variable.other.ace",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.ace",
          "match": ":=|<<=|>>=|[+\\-*/%&|^]=|(?<![=!<>])=(?!=)"
        },
        {
          "name": "keyword.operator.comparison.ace",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.range.ace",
          "match": "\\.\\.\\.?"
        },
        {
          "name": "keyword.operator.ace",
          "match": "&&|\\|\\||<<|>>|[+\\-*/%&|^!~]"
        },
        {
          "name": "keyword.control.ace",
          "match": "\\bstep\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.ace",
          "match": ","
        },
        {
          "name": "punctuation.accessor.ace",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.type.ace",
          "match": ":"
        },
        {
          "name": "punctuation.section.group.begin.ace",
          "match": "\\("
        },
        {
          "name": "punctuation.section.group.end.ace",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.ace",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.ace",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.block.begin.ace",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.ace",
          "match": "\\}"
        }
      ]
    }
  }
}
