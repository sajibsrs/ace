{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ace Package Manifest",
  "scopeName": "source.ace-pkg",
  "patterns": [
    { "include": "#comment" },
    { "include": "#header" },
    { "include": "#field" }
  ],
  "repository": {
    "comment": {
      "match": "^\\s*(//).*$",
      "name": "comment.line.double-slash.ace-pkg",
      "captures": {
        "1": { "name": "punctuation.definition.comment.ace-pkg" }
      }
    },
    "header": {
      "patterns": [
        {
          "match": "^\\s*(\\[\\[)\\s*(link)\\s*(\\]\\])\\s*$",
          "name": "meta.table-header.ace-pkg",
          "captures": {
            "1": { "name": "punctuation.definition.table.array.ace-pkg" },
            "2": { "name": "entity.name.section.ace-pkg" },
            "3": { "name": "punctuation.definition.table.array.ace-pkg" }
          }
        },
        {
          "match": "^\\s*(\\[)\\s*(dependencies)\\s*(\\])\\s*$",
          "name": "meta.section-header.ace-pkg",
          "captures": {
            "1": { "name": "punctuation.definition.table.ace-pkg" },
            "2": { "name": "entity.name.section.ace-pkg" },
            "3": { "name": "punctuation.definition.table.ace-pkg" }
          }
        },
        {
          "match": "^\\s*\\[.*$",
          "name": "invalid.illegal.header.ace-pkg"
        }
      ]
    },
    "field": {
      "begin": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*",
      "beginCaptures": {
        "1": { "patterns": [{ "include": "#key" }] },
        "2": { "name": "punctuation.separator.key-value.ace-pkg" }
      },
      "end": "$",
      "contentName": "string.unquoted.value.ace-pkg",
      "patterns": [{ "include": "#value" }]
    },
    "key": {
      "patterns": [
        {
          "match": "\\b(name|version|ace|type|root|description|author|license|repository)\\b",
          "name": "keyword.other.key.ace-pkg"
        },
        {
          "match": "\\b(path|framework)\\b",
          "name": "keyword.other.key.link.ace-pkg"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "entity.name.namespace.ace-pkg"
        }
      ]
    },
    "value": {
      "patterns": [
        {
          "match": "\\G(exe|lib)\\s*$",
          "captures": { "1": { "name": "constant.language.ace-pkg" } }
        },
        {
          "match": "\\b\\d+(\\.\\d+){0,2}\\b",
          "name": "constant.numeric.version.ace-pkg"
        },
        {
          "match": "<[^>\\s]+@[^>\\s]+>",
          "name": "markup.underline.link.ace-pkg"
        }
      ]
    }
  }
}
