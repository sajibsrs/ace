/* Go to definition: checks the program holding a file with the selfhost
 * loader and sema, then follows the name under the cursor to the symbol it
 * resolved to and that symbol's declaration.
 */

import mem
import sys

import module: "../selfhost/module.ace"
import package: "../selfhost/package.ace"
import parser: "../selfhost/parser.ace"
import path: "../selfhost/path.ace"
import sema: "../selfhost/sema.ace"

Node: type = parser.Node

TARGET: const string = "darwin-arm64"

/* A declaration's place: its canonical file, 1-based line and byte column,
 * its name's length in bytes, and the line whose doc comment describes it
 * (its function's for a parameter). `origin` and `origin_len` span what the
 * cursor named on its line when that is not one word (a quoted path); 0
 * otherwise. `file` is a string of the caller's pool.
 */
pub Location: struct {
    pub file: string,
    pub line: u32,
    pub col: u32,
    pub len: u32,
    pub doc: u32,
    pub origin: u32 = 0,
    pub origin_len: u32 = 0,
}

/* A program loaded and checked from one file: its loader, package graph,
 * and sema. `checked` says sema ran, which needs every module loaded; the
 * loader's and sema's `diags` hold what either reported. Call `wipe`.
 */
pub Program: struct {
    pub l: module.Loader,
    g: package.Graph,
    pub s: sema.Sema,
    pub checked: bool = false,
}

/* The program holding the file at canonical path `canon`, checked as far as
 * it loads; false when the loader cannot start or the package graph holding
 * the file does not resolve (its errors only on stderr).
 */
pub Program.new(pool: *path.Pool, canon: string): (Program, bool) {
    l: module.Loader, found: bool = module.Loader.new(TARGET)
    p: Program = Program { l = l, g = package.Graph.init(TARGET, l.std_dir), s = blank(sema.Sema) }
    if !found { return p, false }
    resolved: bool = false
    dir: string, in_package: bool = package_root(pool, path.dir(canon))
    if in_package {
        root: usize, ok: bool = p.g.resolve(dir)
        if !ok { return p, false }
        resolved = p.l.resolve_in(p.g, root, canon)
    } else {
        resolved = p.l.resolve(canon)
    }
    if !resolved { return p, true }
    p.s = sema.Sema.new(p.l)
    // Every stage `ace --check` runs; a name resolves even past an error.
    p.s.enter()
    p.s.complete()
    p.s.promoted_collisions()
    p.s.signatures()
    p.s.check_bodies()
    p.checked = true
    return p, true
}

pub Program.wipe(self) {
    if self.checked { self.s.wipe() }
    self.g.wipe()
    self.l.wipe()
}

/* The declaration of the name at 1-based `line` and byte `col` of the file
 * at `file_path`, whose text on disk is `src`; false when there is none or
 * the program cannot be loaded. The result's strings live in `pool`.
 */
pub find(pool: *path.Pool, file_path: string, src: string, line: u32, col: u32): (Location, bool) {
    none: Location = Location { file = "", line = 0, col = 0, len = 0, doc = 0 }
    canon: string, exists: bool = path.canonical(pool, file_path)
    if !exists { return none, false }
    prog: Program, loaded: bool = Program.new(pool, canon)
    defer prog.wipe()
    if !loaded || !prog.checked { return none, false }
    loc: Location, _, found: bool = prog.at(pool, canon, src, line, col)
    return loc, found
}

/* In checked program `self`, the declaration of the name at 1-based `line`
 * and byte `col` of its file at canonical path `canon`, whose text is `src`:
 * its place and its node, 0 when the name is a module (an import's name or
 * path, whose place is that module's start); false when there is none. The
 * place's strings live in `pool`.
 */
pub Program.at(self, pool: *path.Pool, canon: string, src: string, line: u32, col: u32): (Location, u32, bool) {
    none: Location = Location { file = "", line = 0, col = 0, len = 0, doc = 0 }
    l: *module.Loader = &self.l
    s: *sema.Sema = &self.s

    mods: []module.Module = l.mods.view()
    mi: usize = 0
    for i: usize in 0..mods.len {
        if mem.equal(mods[i].canon, canon) { mi = i }
    }
    // A name the import on this line selects: its declaration in its module.
    for sel: module.Select in mods[mi].sels.view() {
        if sel.line != line || col < sel.col || col >= sel.col + u32(sel.name.len) { continue }
        sym: u32 = sel.is_type ? s.type_named(sel.identity) : s.value_named(sel.identity)
        if sym == 0 { return none, 0, false }
        d: Node = s.node(s.sym(sym).decl)
        return Location { file = pool.copy(mods[l.module_of(s.sym(sym).decl)].canon), line = d.line, col = d.col, len = u32(source_name(d.text).len), doc = d.line }, s.sym(sym).decl, true
    }

    // An import's quoted path: the start of the module it loads.
    from: u32, to: u32, in_quotes: bool = quoted(src, line, col)
    if in_quotes {
        target: usize = 0
        found_import: bool = false
        for bind: module.Binding in mods[mi].binds.view() {
            if bind.line == line {
                target = bind.module
                found_import = true
            }
        }
        for sel: module.Select in mods[mi].sels.view() {
            if sel.line == line {
                target = sel.module
                found_import = true
            }
        }
        if found_import { return Location { file = pool.copy(mods[target].canon), line = 1, col = 1, len = 0, doc = 0, origin = from, origin_len = to - from }, 0, true }
    }

    // A module an import on this line binds: the start of its file.
    for bind: module.Binding in mods[mi].binds.view() {
        if bind.line != line { continue }
        at: u32 = name_col(src, line, bind.col, bind.name) // the binding sits at `import`
        if col < at || col >= at + u32(bind.name.len) { continue }
        return Location { file = pool.copy(mods[bind.module].canon), line = 1, col = 1, len = 0, doc = 0 }, 0, true
    }

    // The innermost name under the cursor, then what it resolved to.
    best: u32 = 0
    best_len: u32 = 0
    for id: u32 in 1..u32(mods[0].parser.nnode) {
        n: Node = s.node(id)
        if n.line != line || (n.flags & parser.F_TEXT) == 0 { continue }
        name: string = source_name(n.text)
        len: u32 = u32(name.len)
        if len == 0 || l.module_of(id) != mi { continue }
        at: u32 = name_col(src, n.line, n.col, name)
        if col < at || col >= at + len { continue }
        if best == 0 || len < best_len {
            best = id
            best_len = len
        }
    }
    if best == 0 { return none, 0, false }
    calls: []u32 = callees(s, u32(mods[0].parser.nnode))
    defer mem.release[u32](&calls)
    decl: u32 = target(s, best, calls)
    if decl == 0 { decl = self.imported(pool, mi, best) }
    if decl == 0 && declares(s.node(best).kind) { decl = best } // a declaration's own name
    if decl == 0 {
        // An import's name: the start of the module it binds.
        b: Node = s.node(best)
        for sel: module.Select in mods[mi].sels.view() {
            if sel.line == b.line { return Location { file = pool.copy(mods[sel.module].canon), line = 1, col = 1, len = 0, doc = 0 }, 0, true }
        }
        for bind: module.Binding in mods[mi].binds.view() {
            if (b.kind == parser.Kind.ident || b.kind == parser.Kind.named) && mem.equal(bind.name, b.text) {
                return Location { file = pool.copy(mods[bind.module].canon), line = 1, col = 1, len = 0, doc = 0 }, 0, true
            }
        }
        return none, 0, false
    }
    d: Node = s.node(decl)
    doc: u32 = d.line
    if d.kind == parser.Kind.param {
        // A function's parameters are its direct kids.
        for id: u32 in 1..u32(mods[0].parser.nnode) {
            f: Node = s.node(id)
            if f.kind != parser.Kind.func { continue }
            for k: u32 in 0..f.nkids {
                if s.kid(id, k) == decl { doc = f.line }
            }
        }
    }
    return Location { file = pool.copy(mods[l.module_of(decl)].canon), line = d.line, col = d.col, len = u32(source_name(d.text).len), doc = doc }, decl, true
}

/* The declaration selector `n` of module `mi` names when it is `mod.Name`
 * in an expression, `Name` in the module `mod` binds, or 0.
 */
pub Program.imported(self, pool: *path.Pool, mi: usize, n: u32): u32 {
    s: *sema.Sema = &self.s
    b: Node = s.node(n)
    if b.kind != parser.Kind.selector || b.a == 0 { return 0 }
    base: Node = s.node(b.a)
    if base.kind != parser.Kind.ident { return 0 }
    mods: []module.Module = self.l.mods.view()
    for bind: module.Binding in mods[mi].binds.view() {
        if !mem.equal(bind.name, base.text) { continue }
        identity: string = pool.join([mods[bind.module].prefix, source_name(b.text)])
        sym: u32 = s.type_named(identity)
        if sym == 0 { sym = s.value_named(identity) }
        if sym != 0 { return s.sym(sym).decl }
    }
    return 0
}

/* Whether a node of `kind` declares the name it carries. */
declares(kind: parser.Kind): bool {
    switch kind {
        parser.Kind.var, parser.Kind.func, parser.Kind.param, parser.Kind.struct, parser.Kind.bits, parser.Kind.field, parser.Kind.union, parser.Kind.variant, parser.Kind.contract, parser.Kind.method, parser.Kind.enum, parser.Kind.alias, parser.Kind.distinct, parser.Kind.error, parser.Kind.externfn, parser.Kind.externvar { return true }
    }
    return false
}

/* For each of the `count` nodes, the symbol of the call it is the callee
 * of, or 0: a callee's overload is resolved on its call node, a generic
 * one's on its `f[T]` callee. Release it
 * with `mem.release`.
 */
pub callees(s: *sema.Sema, count: u32): []u32 {
    calls: []u32 = mem.zalloc[u32](usize(count))
    for id: u32 in 1..count {
        c: Node = s.node(id)
        if c.kind != parser.Kind.call || c.a == 0 || c.a >= count { continue }
        calls[c.a] = s.node_sym(id)
        // A generic call `f[T](...)` resolves on its callee, whose base is the name.
        g: Node = s.node(c.a)
        if g.kind == parser.Kind.index && g.a != 0 && g.a < count { calls[g.a] = s.node_sym(c.a) }
    }
    return calls
}

/* The declaration node `n` names, or 0: its symbol's, the function a call
 * through it resolved to (`calls`, from `callees`), or the type it spells.
 */
pub target(s: *sema.Sema, n: u32, calls: []u32): u32 {
    sym: u32 = s.node_sym(n)
    if sym == 0 { sym = calls[n] }
    if sym != 0 { return s.sym(sym).decl }
    x: Node = s.node(n)
    if x.kind == parser.Kind.named || x.kind == parser.Kind.ident {
        sym = s.type_named(x.text)
        if sym != 0 { return s.sym(sym).decl }
    }
    if x.kind == parser.Kind.selector && x.a != 0 { return member(s, x.a, source_name(x.text)) }
    t: u32 = s.node_ty(n)
    if t == 0 { return 0 }
    ty: sema.SType = s.ty(t)
    // An ident spells a type only when it is that type's name.
    if x.kind == parser.Kind.ident && !mem.equal(source_name(ty.name), source_name(x.text)) { return 0 }
    if x.kind != parser.Kind.named && x.kind != parser.Kind.ident { return 0 }
    return ty.decl
}

/* The member `name` of the type of expression or type name `base`: a struct
 * or union field, an enum member, or an error entry. 0 when there is none.
 */
member(s: *sema.Sema, base: u32, name: string): u32 {
    owner: u32 = 0
    t: u32 = s.node_ty(base)
    for t != 0 && s.ty(t).kind == sema.TypeKind.ptr { t = s.ty(t).base }
    if t != 0 { owner = s.ty(t).decl }
    b: Node = s.node(base)
    if owner == 0 && (b.flags & parser.F_TEXT) != 0 {
        sym: u32 = s.type_named(b.text) // `Enum.member`: the base names a type
        if sym != 0 {
            named: u32 = s.sym(sym).ty // through an alias to the type it names
            owner = named != 0 ? s.ty(named).decl : s.sym(sym).decl
        }
    }
    if owner == 0 { return 0 }
    o: Node = s.node(owner)
    for k: u32 in 0..o.nkids {
        kid: u32 = s.kid(owner, k)
        if mem.equal(s.node(kid).text, name) { return kid }
    }
    return 0
}

/* Where `name` starts on `line` at or after byte `col`: a resolved
 * `mod.Name` sits at `mod`, its name after the dot.
 */
pub name_col(src: string, line: u32, col: u32, name: string): u32 {
    at: usize = 0
    for l: u32 = 1; l < line && at < src.len; {
        if src[at] == '\n' { l += 1 }
        at += 1
    }
    start: usize = at
    i: usize = at + usize(col - 1)
    for i + name.len <= src.len && src[i] != '\n' {
        if mem.equal(src[i..i + name.len], name) { return u32(i - start) + 1 }
        i += 1
    }
    return col
}

/* The 1-based byte columns of the `"..."` on `line` holding byte `col`,
 * its quotes included, as a start and an end past the closing quote; false
 * when `col` is outside any.
 */
quoted(src: string, line: u32, col: u32): (u32, u32, bool) {
    at: usize = 0
    for l: u32 = 1; l < line && at < src.len; {
        if src[at] == '\n' { l += 1 }
        at += 1
    }
    open_: usize = 0
    inside: bool = false
    for i: usize = at; i < src.len && src[i] != '\n'; {
        if src[i] == '"' {
            if !inside {
                open_ = i
            } else if usize(col) - 1 + at >= open_ && usize(col) - 1 + at <= i {
                return u32(open_ - at) + 1, u32(i - at) + 2, true
            }
            inside = !inside
        }
        i += 1
    }
    return 0, 0, false
}

/* The name as written: a resolved `mod.name` reads `mod$name`. */
pub source_name(text: string): string {
    at: usize = text.len
    for at > 0 && text[at - 1] != '$' { at -= 1 }
    return text[at..]
}

/* The nearest directory from `start` upward holding an ace.pkg, as `ace pkg`
 * finds it.
 */
package_root(pool: *path.Pool, start: string): (string, bool) {
    dir: string = start
    for {
        info: sys.FileInfo, err: Error = sys.stat(pool.join([dir, "/ace.pkg"]))
        if err == null && info.file_type == sys.FileType.regular { return dir, true }
        if mem.equal(dir, "/") || dir.len == 0 { return "", false }
        dir = path.dir(dir)
    }
    return "", false
}
