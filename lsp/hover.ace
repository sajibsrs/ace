/* Hover: a declaration's source line and the comment directly above it, as
 * Markdown, with comments from the selfhost lexer.
 */

import array
import str

import lexer: "../selfhost/lexer.ace"
import path: "../selfhost/path.ace"

Token: type = lexer.Token

/* The hover Markdown for the declaration at 1-based `line` of `src`: its
 * line in an `ace` code block, then the doc comment of line `doc`, the
 * comments on their own lines that end just above it. Lives in `pool`.
 */
pub text(pool: *path.Pool, src: string, line: u32, doc: u32): string {
    lx: lexer.Lexer = lexer.Lexer.new(src, true)
    defer lx.wipe()
    for lx.next() != Token.eof {}
    notes: []lexer.Comment = lx.comments()

    at: usize = 0
    for l: u32 = 1; l < line && at < src.len; {
        if src[at] == '\n' { l += 1 }
        at += 1
    }
    end: usize = at
    for end < src.len && src[end] != '\n' { end += 1 }
    head: string, braced: bool = str.trim(str.trim(src[at..end]), "{", true)

    parts: array.Array[string] = array.Array[string] {}
    defer parts.wipe()
    parts.push("```ace\n")
    parts.push(str.trim(head))
    parts.push("\n```")

    // Back from the line above, each comment ending on the line before the next.
    last: usize = 0
    for k: usize in 0..notes.len {
        if notes[k].last + 1 == doc && alone(src, notes[k].start) { last = k + 1 }
    }
    if last == 0 { return pool.join(parts.view()) }
    first: usize = last - 1
    for first > 0 && notes[first - 1].last + 1 == notes[first].line && alone(src, notes[first - 1].start) { first -= 1 }
    parts.push("\n\n")
    for k: usize in first..last {
        i: usize = notes[k].start
        for i < notes[k].end {
            j: usize = i
            for j < notes[k].end && src[j] != '\n' { j += 1 }
            t: string = strip(src[i..j])
            edge: bool = i == notes[k].start || j >= notes[k].end // a bare opener or closer
            if t.len > 0 || !edge {
                if parts.view().len > 4 { parts.push("\n") }
                parts.push(t)
            }
            i = j + 1
        }
    }
    return pool.join(parts.view())
}

/* Whether only blanks precede offset `at` on its line. */
alone(src: string, at: usize): bool {
    i: usize = at
    for i > 0 && src[i - 1] != '\n' {
        if src[i - 1] != ' ' && src[i - 1] != '\t' { return false }
        i -= 1
    }
    return true
}

// A comment line without its markers: an opener, closer, leading star or slashes.
strip(line: string): string {
    t: string = str.trim(line)
    t, _ = str.trim(t, "*/", true)
    t, _ = str.trim(t, "/*", false)
    t, _ = str.trim(t, "//", false)
    t, _ = str.trim(str.trim(t), '*', false)
    return str.trim(t)
}
