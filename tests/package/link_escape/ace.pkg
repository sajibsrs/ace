// A relative [[link]] path with ".." traversal is rejected: a package can
// only declare relative inputs it vendors inside its own directory.
// expect-err: [[link]] path '../outside.a' must be absolute or a relative path within the package

name: link_escape
version: 0.1.0
ace: 0.1
type: exe
root: main.ace

[[link]]
path: ../outside.a
