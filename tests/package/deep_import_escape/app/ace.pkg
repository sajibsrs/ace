// A relative import reaching into a dependency's internal (non-root) file
// escapes that dependency's canonical directory and must be rejected: a
// library's root module is its sole external import surface. app and lib
// are ordinary sibling directories, as packages always are (never nested
// inside one another).
// expect-check-err: escapes its package directory

name: app
version: 0.1.0
ace: 0.1
type: exe
root: main.ace

[dependencies]
lib: ../lib
