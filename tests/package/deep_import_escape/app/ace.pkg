// A relative import reaching into a dependency's internal (non-root) file
// escapes the importing package's canonical directory and must be rejected:
// a library's root module is its sole external import surface.
// expect-check-err: escapes its package directory

name: app
version: 0.1.0
ace: 0.1
type: exe
root: main.ace

[dependencies]
lib: 0.1.0
