// Relative and absolute [[link]] paths and a framework parse; resolving the graph does not
// check an absolute file, which only the link step uses.
// expect-ok: link_ok

name: link_ok
version: 0.1.0
ace: 0.1
type: exe
root: main.ace

[[link]]
path: vendor/libcrypto.a

[[link]]
path: vendor/x.a

[[link]]
path: /nonexistent-ace/libx.dylib

[[link]]
framework: Security
