// A [[link]] path resolves its library to the exact file the linker
// would pick, so a missing library is an Ace error, not a later ld one.
// expect-err: [[link]] library 'nonexistent_ace_library' not found in '/usr/lib'

name: link_path_not_found
version: 0.1.0
ace: 0.1
type: exe
root: main.ace

[[link]]
library: nonexistent_ace_library
path: /usr/lib
