/* A union switch loads the tag once and compares it against each arm in
   order: every variant must reach its own arm, the last arm and the default
   included, and each payload binder must read its own variant's payload. */

// expect-exit: 0

Op: union {
    halt,
    push: i64,
    add,
    jump: u32,
    mark: u8,
}

code(op: Op): i64 {
    result: i64 = -1

    switch op {
        Op.push(value: i64) {
            result = value
        }
        Op.add {
            result = 2
        }
        Op.jump(target: u32) {
            result = i64(target) + 100
        }
        Op.mark(tag: u8) {
            result = i64(tag) + 1000
        }
        default {}
    }
    return result
}

main(): int {
    ops: [5]Op = [Op.halt, Op.push(-7), Op.add, Op.jump(4000000000), Op.mark(255)]
    want: [5]i64 = [-1, -7, 2, 4000000100, 1255]
    view: []Op = ops[0..5]

    for i: usize in 0 .. 5 {
        if code(view[i]) != want[i] { return int(i) + 1 }
    }
    return 0
}
