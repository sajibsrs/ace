/* Regression: a union switch whose `else` case isn't written last must still
   dispatch a non-matching tag to `else`, not fall through into the wrong
   variant's case body and misread its payload binder. */

// expect-exit: 0

V: union {
    none,
    num: f64,
    arr: []V,
}

main(): int {
    v: V = V.num(7.0)
    switch v {
        V.arr(items: []V) {
            return 1
        }
        else {}
    }
    return 0
}
