/* Unions fixture. */

// expect-exit: 0

import fmt

Point: struct {
    x: int,
    y: int,
}

Event: union {
    none,
    quit,
    key: u32,
    cursor: Point,
}

Status: union {
    none,
    quit,
    key: u32,
}

Scalar: union {
    none,
    integer: int,
    decimal: f64,
    text: string,
}

Tiny: struct {
    a: u8,
    b: u8,
    c: u8,
}

Small: union {
    none,
    bytes: Tiny,
}

Result[T]: union {
    empty,
    value: T,
}

Inner: union {
    none,
    value: int,
}

Outer: union {
    none,
    inner: Inner,
}

default_status: Status
quit_status: const Status = Status.quit
key_status: const Status = Status.key(42)
text_value: const Scalar = Scalar.text("union")

round_trip(event: Event): Event {
    return event
}

main(): int {
    if default_status != Status.none {
        return 1
    }

    if quit_status != Status.quit {
        return 2
    }

    if key_status == Status.quit {
        return 3
    }
    key: u32 = 0

    switch key_status {
        Status.key(code: u32) {
            key = code
        }
        else {
            return 4
        }
    }

    if key != 42 {
        return 5
    }

    event: Event = Event.cursor({ x: 10, y: 20 })
    event = round_trip(event)

    switch event {
        Event.cursor(point: Point) {
            if point.x + point.y != 30 {
                return 6
            }
            point.x = 99
        }
        else {
            return 7
        }
    }

    switch event {
        Event.cursor(point: Point) {
            if point.x != 10 {
                return 8
            }
        }
        else {
            return 9
        }
    }

    switch text_value {
        Scalar.text(text: string) {
            if text.len != 5 || text[0] != u8(117) || text[4] != u8(110) {
                return 17
            }
        }
        else {
            return 18
        }
    }

    small: Small = Small.bytes({ a: 1, b: 2, c: 3 })

    switch small {
        Small.bytes(bytes: Tiny) {
            if bytes.a != 1 || bytes.b != 2 || bytes.c != 3 {
                return 12
            }
        }
        else {
            return 13
        }
    }

    result: Result[int] = Result[int].value(9)

    switch result {
        Result[int].value(value: int) {
            if value != 9 {
                return 14
            }
        }
        else {
            return 15
        }
    }

    if sizeof(Event) != 24 || sizeof(Small) != 8 {
        return 16
    }
    left: Outer = Outer.inner(Inner.value(1))
    left = Outer.inner(Inner.none)
    right: Outer = Outer.inner(Inner.value(2))
    right = Outer.inner(Inner.none)

    if left != right {
        return 19
    }
    fmt.println("union ok")
    return 0
}
