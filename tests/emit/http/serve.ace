/* Caller-driven nonblocking http.serve: accept, parse, respond, recycle. */

// expect-exit: 0

import http
import mem
import net
import str
import sys
import tcp

loopback(port: u16): net.Addr4 {
    return net.Addr4 {ip = [127, 0, 0, 1], port = port}
}

/* Plain blocking socket client: exercises the server without depending on
 * the http client machinery under test elsewhere.
 */
round_trip(port: u16, target: string, expected_body: string): int {
    sock: net.Socket, err: Error = net.socket(net.SocketKind.tcp)
    if err != null { return 1 }
    if net.connect(sock, loopback(port)) != null {
        sys.close(sock)
        return 2
    }

    parts: [4]string = ["GET ", target, " HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n", ""]
    request: [128]u8 = [0 : 128]
    request_count: usize, fit: bool = str.concat(parts[0..3], mut request[..])
    if !fit {
        sys.close(sock)
        return 3
    }
    sent: usize = 0
    for sent < request_count {
        count: int, send_err: Error = net.send(sock, request[sent..request_count])
        if send_err != null {
            sys.close(sock)
            return 4
        }
        sent += usize(count)
    }

    response: [256]u8 = [0 : 256]
    occupied: usize = 0
    for {
        count: int, recv_err: Error = net.receive(sock, mut response[occupied..])
        if recv_err != null {
            sys.close(sock)
            return 5
        }
        if count == 0 { break }
        occupied += usize(count)
        if occupied == response.len { break }
    }
    sys.close(sock)

    text: string = response[..occupied]
    if !str.has(text, "HTTP/1.1 200") || !str.has(text, expected_body) {
        return 6
    }
    return 0
}

client(port: u16): int {
    first: int = round_trip(port, "/a", "A")
    if first != 0 { return first }
    second: int = round_trip(port, "/b", "B")
    if second != 0 { return 10 + second }
    return 0
}

body_for(target: string): string {
    if mem.equal(target, "/a") { return "A" }
    if mem.equal(target, "/b") { return "B" }
    return "?"
}

main(): int {
    ctx: http.ServerContext, ctx_err: Error = http.server_context_new(
        "127.0.0.1:0", usize(8), usize(1), usize(1024), usize(8), usize(256), usize(1024))
    if ctx_err != null { return 10 }

    address: net.Addr4
    address, ctx_err = tcp.local(ctx.listener)
    if ctx_err != null || address.port == 0 {
        http.server_context_wipe(mut ctx)
        return 11
    }

    process: sys.Process, fork_err: Error = sys.fork()
    if fork_err != null || process == -1 {
        http.server_context_wipe(mut ctx)
        return 12
    }
    if process == 0 {
        sys.close(ctx.listener.socket)
        sys.close(sys.Fd(ctx.queue))
        sys.exit(client(address.port))
    }

    completed: usize = 0
    attempts: usize = 0
    failure: int = 0

    for completed < 2 && failure == 0 && attempts < 10000 {
        attempts += 1
        event: http.Event, serve_err: Error = http.serve(mut ctx, u64(2000000000))
        if serve_err != null {
            failure = 20
            break
        }
        switch event {
            http.Event.none {}
            http.Event.accepted(index: usize) {}
            http.Event.request(index: usize) {
                target: string = ctx.sessions[index].request.target
                if !mem.equal(ctx.sessions[index].request.method, http.method_get) {
                    failure = 21
                    break
                }
                response: http.Response = http.Response {status = 200, body = body_for(target)}
                if http.respond(mut ctx, index, response) != null {
                    failure = 22
                    break
                }
            }
            http.Event.sent(index: usize) {
                completed += 1
            }
            http.Event.disconnected(index: usize) {
                failure = 23
                break
            }
            http.Event.failed(fail: http.Failure) {
                failure = 24
                break
            }
        }
    }

    http.server_context_wipe(mut ctx)

    status: sys.ProcessStatus, wait_err: Error = sys.wait(process)
    if wait_err != null || !status.exited || status.code != 0 {
        if failure == 0 { failure = 30 }
    }
    if failure != 0 { return failure }
    if completed != 2 { return 40 }
    return 0
}
