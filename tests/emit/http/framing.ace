// expect-exit: 0

import http
import mem

new_state(): http.ResponseParser {
    return http.ResponseParser {
        input_offset: usize(0),
        line_start: usize(0),
        scan_offset: usize(0),
        line_stop: usize(0),
        line_next: usize(0),
        line_ready: false,
        header_count: usize(0),
        body_count: usize(0),
        content_length: usize(0),
        chunk_remaining: usize(0),
        version_minor: u8(0),
        status: u16(0),
        reason_start: usize(0),
        reason_count: usize(0),
        phase: http.ResponsePhase.status,
        framing: http.ResponseFraming.undecided,
        informational_count: usize(0),
    }
}

fragmented_length(): int {
    state: http.ResponseParser = new_state()
    headers: [2]http.Header
    body: [8]u8 = [0 : 8]
    result: http.ResponseResult = mut state.parse(
        "HTTP/1.1 200 OK\r\nContent-L",
        mut headers[..],
        mut body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.progress(value: http.ResponseProgress) {
            if value.body_written != 0 { return 1 }
        }
        else { return 2 }
    }
    result = mut state.parse(
        "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\na\xC3\xA9b",
        mut headers[..],
        mut body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.complete(response: http.Response) {
            if response.status != 200 || !mem.equal(response.body, "a\xC3\xA9b") {
                return 3
            }
        }
        else { return 4 }
    }
    return 0
}

chunked(): int {
    state: http.ResponseParser = new_state()
    headers: [3]http.Header
    body: [16]u8 = [0 : 16]
    message: string = "HTTP/1.1 200 OK\r\nTransfer-Encoding: Chunked\r\n\r\n3;foo=bar\r\nabc\r\n2\r\nde\r\n0\r\nX-End: yes\r\n\r\n"
    result: http.ResponseResult = mut state.parse(
        message, mut headers[..], mut body[..], false, false,
    )
    switch result {
        http.ResponseResult.complete(response: http.Response) {
            if !mem.equal(response.body, "abcde") {
                return 1
            }
        }
        else { return 2 }
    }
    return 0
}

informational_and_none(): int {
    state: http.ResponseParser = new_state()
    headers: [2]http.Header
    body: [1]u8 = [0]
    message: string = "HTTP/1.1 103 Early Hints\r\nLink: </x>\r\n\r\nHTTP/1.1 304 Not Modified\r\nContent-Length: 99\r\n\r\n"
    result: http.ResponseResult = mut state.parse(
        message, mut headers[..], mut body[..], false, false,
    )
    switch result {
        http.ResponseResult.complete(response: http.Response) {
            if response.status != 304 || response.body.len != 0 ||
                state.informational_count != 1 || response.headers.len != 1 {
                return 1
            }
        }
        else { return 2 }
    }
    return 0
}

close_body(): int {
    state: http.ResponseParser = new_state()
    headers: [1]http.Header
    body: [8]u8 = [0 : 8]
    message: string = "HTTP/1.0 200 OK\r\n\r\nbye"
    result: http.ResponseResult = mut state.parse(
        message, mut headers[..], mut body[..], true, false,
    )
    if state.body_count != 3 { return 8 }
    if body[0] != 98 { return int(body[0]) }
    if !mem.equal(body[..3], "bye") { return 9 }
    switch result {
        http.ResponseResult.complete(response: http.Response) {
            if response.status != 200 || !mem.equal(response.body, "bye") { return 3 }
            body[0] = 120
            if response.body[0] != 120 { return 5 }
        }
        else { return 4 }
    }
    return 0
}

failures(): int {
    state: http.ResponseParser = new_state()
    one_header: [1]http.Header
    no_headers: mut []http.Header = mut one_header[..0]
    body: [2]u8 = [0, 0]
    result: http.ResponseResult = mut state.parse(
        "HTTP/1.1 200 OK\r\nA: b\r\n\r\n",
        no_headers,
        mut body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.capacity(kind: http.ResponseCapacity) {
            if kind != http.ResponseCapacity.headers { return 1 }
        }
        else { return 2 }
    }
    state = new_state()
    result = mut state.parse(
        "HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\nabc",
        mut one_header[..],
        mut body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.capacity(kind: http.ResponseCapacity) {
            if kind != http.ResponseCapacity.body { return 3 }
        }
        else { return 4 }
    }
    state = new_state()
    result = mut state.parse(
        "HTTP/1.1 200 OK\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\nx",
        mut one_header[..],
        mut body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.framing {}
        else { return 5 }
    }
    state = new_state()
    result = mut state.parse(
        "HTTP/1.1 200 OK\r\nContent-Length: 1\r\nTransfer-Encoding: chunked\r\n\r\n",
        mut one_header[..],
        mut body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.framing {}
        else { return 6 }
    }
    state = new_state()
    result = mut state.parse(
        "HTTP/1.1 xxx Bad\r\n\r\n",
        mut one_header[..],
        mut body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.syntax {}
        else { return 7 }
    }
    state = new_state()
    result = mut state.parse(
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nz\r\n",
        mut one_header[..],
        mut body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.syntax {}
        else { return 8 }
    }
    state = new_state()
    result = mut state.parse(
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nA\r\n0123456789\r\n0\r\n\r\n",
        mut one_header[..],
        mut body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.capacity(kind: http.ResponseCapacity) {
            if kind != http.ResponseCapacity.body { return 10 }
        }
        else { return 11 }
    }
    state = new_state()
    result = mut state.parse(
        "HTTP/1.1 101 Switching Protocols\r\n\r\n",
        mut one_header[..],
        mut body[..],
        false,
        false,
    )
    switch result {
        http.ResponseResult.framing {}
        else { return 12 }
    }
    return 0
}

main(): int {
    code: int = fragmented_length()
    if code != 0 { return 10 + code }
    code = chunked()
    if code != 0 { return 20 + code }
    code = informational_and_none()
    if code != 0 { return 30 + code }
    code = close_body()
    if code != 0 { return 40 + code }
    code = failures()
    if code != 0 { return 50 + code }
    return 0
}
