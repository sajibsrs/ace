// expect-exit: 0

Counter: struct {
    value: int,
}

Counter.add(self, amount: int): int {
    self.value += amount
    return self.value
}

twice(value: int): int {
    return value * 2
}

main(): int {
    counter: Counter = Counter { value = 1 }
    result: int = counter.add(2)
    result = counter.add(3)
    nested: int = twice(counter.add(4))
    if result != 6 || nested != 20 || counter.value != 10 { return 1 }
    return 0
}
