// expect-exit: 42

/* p.m() auto-derefs like p.x, once per pointer level. */

Counter: struct {
    value: int,
}

Counter.get(self): int {
    return self.value
}

Counter.bump(self) {
    self.value += 1
}

main(): int {
    c: Counter = Counter{value = 40}
    p: *Counter = &c
    p.bump()
    pp: **Counter = &p
    pp.bump()
    return pp.get()
}
