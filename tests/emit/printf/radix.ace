/* Printf binary and octal fixture. */

/* expect-exit: 0 */
// expect-output: 0 1100101 145 1111111111111111111111111111111111111111111111111111111111111111 1777777777777777777777

import fmt

main(): int {
    value: uint = 101
    maximum: uint = uint(0xFFFFFFFFFFFFFFFF)
    written: int = fmt.printf("%b %b %o %b %o", uint(0), value, value, maximum, usize(maximum))

    if written != 101 {
        return 1
    }
    return 0
}
