/* Printf %e and %g fixture: defaults, explicit precisions, exact ties to
 * even, the %g switch points (X < -4, X >= P), signed zero, the smallest
 * denormal, DBL_MAX, non-finites, width and zero padding, and f32.
 */

// expect-exit: 0
// expect-output: 1.234568e+03 2e+00 1.12e+00 0e+00 -0e+00 4.940656e-324 1.797693e+308 1.000000e-300 1.000000e+01 1.234560e+05|1234.57 2 0.1 1.12 0.0001 9.999e-05 999999 1e+06 1e+06 0 -0 0.1|4.94066e-324 1.79769e+308 nan inf -inf nan -inf|[-1.500000e+00][-0001.50e+00][    3.25][-0003.25][   inf][     nan]|0.1 3.402823e+38 1.40129846e-45

import fmt

main(): int {
    zero: f64 = 0.0
    negative_zero: f64 = zero / (zero - 1.0)
    nan: f64 = zero / zero
    inf: f64 = 1.0 / zero
    written: int = fmt.printf(
        "%e %.0e %.2e %.0e %.0e %e %e %e %e %e|",
        1234.5678,
        2.5,
        1.125,
        0.0,
        negative_zero,
        4.9406564584124654e-324,
        1.7976931348623157e308,
        1.0e-300,
        9.9999996,
        123456.0,
    )
    written += fmt.printf(
        "%g %.0g %.1g %.3g %g %g %g %g %g %g %g %.10g|",
        1234.5678,
        2.5,
        0.15,
        1.125,
        0.0001,
        0.00009999,
        999999.0,
        999999.5,
        1.0e6,
        0.0,
        negative_zero,
        0.1,
    )
    written += fmt.printf(
        "%g %g %g %g %g %e %e|",
        4.9406564584124654e-324,
        1.7976931348623157e308,
        nan,
        inf,
        0.0 - inf,
        nan,
        0.0 - inf,
    )
    written += fmt.printf("[%12e][%012.2e][%8g][%08g][%06g][%08e]|", -1.5, -1.5, 3.25, -3.25, inf, nan)
    written += fmt.printf("%g %e %.9g", f32(0.1), f32(3.4028235e38), f32(1.0e-45))

    if written != 320 { return 1 }
    return 0
}
