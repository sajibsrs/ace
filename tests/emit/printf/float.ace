/* Printf float fixture. */

/* expect-exit: 0 */
// expect-link: -lm
// expect-output: 2 4 -0 -0.00 1.12 1.38 -0.000000 nan inf -inf 1.25

import fmt

@when(_PLATFORM_ == "darwin-arm64")
FE_DOWNWARD: const i32 = 0x00800000

@when(_PLATFORM_ == "linux-x64")
FE_DOWNWARD: const i32 = 0x400

extern "c" {
    fegetround(): i32
    fesetround(mode: i32): i32
}

main(): int {
    zero: f64 = 0.0
    one: f64 = 1.0
    negative_one: f64 = zero - one
    negative_zero: f64 = zero / negative_one
    nan: f64 = zero / zero
    inf: f64 = one / zero
    narrow: f32 = 1.25
    tiny_negative: f64 = zero - 0.001
    literal_negative_zero: f64 = zero / negative_one
    original_rounding: i32 = fegetround()
    fesetround(FE_DOWNWARD)
    written: int = fmt.printf(
        "%.0f %.0f %.0f %.2f %.2f %.2f %f %f %f %f %.2f",
        2.5,
        3.5,
        negative_zero,
        tiny_negative,
        1.125,
        1.375,
        literal_negative_zero,
        nan,
        inf,
        0.0 - inf,
        narrow,
    )
    fesetround(original_rounding)

    if written != 50 { return 1 }
    return 0
}
