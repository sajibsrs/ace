/* Printf failure fixture. */

// expect-exit: 0

import fmt

extern "c" {
    close(fd: i32): i32
}

counter: int = 0

capture(value: int): int {
    counter = counter * 10 + value
    return value
}

main(): int {
    ignored: i32 = close(1)
    result: int = fmt.printf("%d%d", capture(1), capture(2))

    if ignored != 0 {
        return 1
    }

    if result >= 0 {
        return 2
    }

    if counter != 12 {
        return 3
    }
    return 0
}
