/* Printf output longer than its 1024-byte frame storage: a width past the
 * storage streams as fill, and a string past it is written straight out,
 * both after the buffered bytes, in order.
 */

// expect-exit: 0

import fmt
import mem

main(): int {
    text: [3000]u8 = [0 : 3000]
    mem.fill(mut text[..], 'a')
    written: int = fmt.printf("<%2000d|%s>", 7, string(text[..]))
    if written != 5003 { return 1 }
    return 0
}
