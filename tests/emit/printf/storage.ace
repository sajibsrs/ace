/* fmt.printf into a storage-only fmt.Buffer: output stays in the storage,
 * bytes past its end are dropped, flush writes nothing, and empty storage
 * keeps nothing. Each call returns the bytes it kept; dropped counts the rest.
 */

// expect-exit: 0

import fmt
import mem

main(): int {
    storage: [10]u8
    b: fmt.Buffer = fmt.Buffer.init(storage[..])
    if b.printf("%s", "") != 0 || b.text().len != 0 { return 1 }
    if b.printf("%d:%c", -4, u8(';')) != 4 { return 2 }
    if b.printf("%s %u", "abcd", uint(12345)) != 6 { return 3 }
    if !mem.equal(b.text(), "-4:;abcd 1") || b.dropped() != 4 { return 4 }
    if b.printf("%5d", 7) != 0 || b.dropped() != 9 { return 5 }
    if b.flush() != 0 || !mem.equal(b.text(), "-4:;abcd 1") { return 6 }

    tail: [6]u8
    t: fmt.Buffer = fmt.Buffer.init(tail[..])
    if t.printf("ab%04d", 9) != 6 || !mem.equal(t.text(), "ab0009") || t.dropped() != 0 { return 7 }

    none: fmt.Buffer = fmt.Buffer.init(storage[0..0])
    if none.printf("x %d %8.3f %s", 7, 1.5, "y") != 0 || none.text().len != 0 || none.dropped() != 14 { return 8 }
    return 0
}
