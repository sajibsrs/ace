/* Public integer bit operations cover exact widths, zero, count reduction,
 * and ordinary callable symbols without runtime support. */

// expect-exit: 42

import bits

main(): int {
    if bits.popcount(u8(0xB1)) != 4 ||
       bits.popcount(u16(0xF00F)) != 8 ||
       bits.popcount(u32(0x80000001)) != 2 ||
       bits.popcount(u64(0xF00000000000000F)) != 8 {
        return 1
    }
    if bits.clz(u8(0)) != 8 ||
       bits.clz(u16(1)) != 15 ||
       bits.clz(u32(0x00010000)) != 15 ||
       bits.clz(u64(1)) != 63 {
        return 2
    }
    if bits.ctz(u8(0)) != 8 ||
       bits.ctz(u16(0x8000)) != 15 ||
       bits.ctz(u32(0x00010000)) != 16 ||
       bits.ctz(u64(0)) != 64 {
        return 3
    }
    if bits.bswap(u8(0xA5)) != u8(0xA5) ||
       bits.bswap(u16(0x1234)) != u16(0x3412) ||
       bits.bswap(u32(0x12345678)) != u32(0x78563412) ||
       bits.bswap(u64(0x0123456789ABCDEF)) !=
           u64(0xEFCDAB8967452301) {
        return 4
    }
    if bits.rotl(u8(0x81), uint(1)) != u8(0x03) ||
       bits.rotl(u16(0x8001), uint(17)) != u16(0x0003) ||
       bits.rotl(u32(0x80000001), uint(33)) != u32(0x00000003) ||
       bits.rotl(u64(0x8000000000000001), uint(65)) != 3 {
        return 5
    }
    if bits.rotr(u8(0x81), uint(9)) != u8(0xC0) ||
       bits.rotr(u16(0x8001), uint(17)) != u16(0xC000) ||
       bits.rotr(u32(0x80000001), uint(33)) != u32(0xC0000000) ||
       bits.rotr(u64(0x8000000000000001), uint(65)) !=
           u64(0xC000000000000000) {
        return 6
    }

    if bits.wradd(u8(250), u8(10)) != u8(4) ||
       bits.wrsub(u16(0), u16(1)) != u16(65535) ||
       bits.wrmul(u32(0x10001), u32(0x10001)) != u32(0x20001) ||
       bits.wrmul(u64(0x100000001), u64(0x100000001)) != u64(0x200000001) {
        return 8
    }

    pop: (u64): uint = bits.popcount
    lead: (u8): uint = bits.clz
    trail: (u16): uint = bits.ctz
    swap: (u32): u32 = bits.bswap
    left: (u64, uint): u64 = bits.rotl
    right: (u8, uint): u8 = bits.rotr
    add: (u16, u16): u16 = bits.wradd
    mul: (u64, u64): u64 = bits.wrmul

    if pop(u64(0x101)) != 2 || lead(u8(1)) != 7 ||
       trail(u16(8)) != 3 || swap(u32(0x01020304)) != u32(0x04030201) ||
       left(u64(1), uint(63)) != u64(0x8000000000000000) ||
       right(u8(1), uint(1)) != u8(0x80) ||
       add(u16(65535), u16(1)) != u16(0) ||
       mul(u64(0xFFFFFFFFFFFFFFFF), u64(2)) != u64(0xFFFFFFFFFFFFFFFE) {
        return 7
    }
    return 42
}
