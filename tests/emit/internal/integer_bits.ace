/* Public integer bit operations cover exact widths, zero, count reduction,
 * and ordinary callable symbols without runtime support. */

// expect-exit: 42

import bits

main(): int {
    if bits.pop_count(u8(0xB1)) != 4 ||
       bits.pop_count(u16(0xF00F)) != 8 ||
       bits.pop_count(u32(0x80000001)) != 2 ||
       bits.pop_count(u64(0xF00000000000000F)) != 8 {
        return 1
    }
    if bits.lead_zeros(u8(0)) != 8 ||
       bits.lead_zeros(u16(1)) != 15 ||
       bits.lead_zeros(u32(0x00010000)) != 15 ||
       bits.lead_zeros(u64(1)) != 63 {
        return 2
    }
    if bits.trail_zeros(u8(0)) != 8 ||
       bits.trail_zeros(u16(0x8000)) != 15 ||
       bits.trail_zeros(u32(0x00010000)) != 16 ||
       bits.trail_zeros(u64(0)) != 64 {
        return 3
    }
    if bits.byte_swap(u8(0xA5)) != u8(0xA5) ||
       bits.byte_swap(u16(0x1234)) != u16(0x3412) ||
       bits.byte_swap(u32(0x12345678)) != u32(0x78563412) ||
       bits.byte_swap(u64(0x0123456789ABCDEF)) !=
           u64(0xEFCDAB8967452301) {
        return 4
    }
    if bits.rotate_left(u8(0x81), uint(1)) != u8(0x03) ||
       bits.rotate_left(u16(0x8001), uint(17)) != u16(0x0003) ||
       bits.rotate_left(u32(0x80000001), uint(33)) != u32(0x00000003) ||
       bits.rotate_left(u64(0x8000000000000001), uint(65)) != 3 {
        return 5
    }
    if bits.rotate_right(u8(0x81), uint(9)) != u8(0xC0) ||
       bits.rotate_right(u16(0x8001), uint(17)) != u16(0xC000) ||
       bits.rotate_right(u32(0x80000001), uint(33)) != u32(0xC0000000) ||
       bits.rotate_right(u64(0x8000000000000001), uint(65)) !=
           u64(0xC000000000000000) {
        return 6
    }

    if bits.wrap_add(u8(250), u8(10)) != u8(4) ||
       bits.wrap_sub(u16(0), u16(1)) != u16(65535) ||
       bits.wrap_mul(u32(0x10001), u32(0x10001)) != u32(0x20001) ||
       bits.wrap_mul(u64(0x100000001), u64(0x100000001)) != u64(0x200000001) {
        return 8
    }

    pop: (u64): uint = bits.pop_count
    lead: (u8): uint = bits.lead_zeros
    trail: (u16): uint = bits.trail_zeros
    swap: (u32): u32 = bits.byte_swap
    left: (u64, uint): u64 = bits.rotate_left
    right: (u8, uint): u8 = bits.rotate_right
    add: (u16, u16): u16 = bits.wrap_add
    mul: (u64, u64): u64 = bits.wrap_mul

    if pop(u64(0x101)) != 2 || lead(u8(1)) != 7 ||
       trail(u16(8)) != 3 || swap(u32(0x01020304)) != u32(0x04030201) ||
       left(u64(1), uint(63)) != u64(0x8000000000000000) ||
       right(u8(1), uint(1)) != u8(0x80) ||
       add(u16(65535), u16(1)) != u16(0) ||
       mul(u64(0xFFFFFFFFFFFFFFFF), u64(2)) != u64(0xFFFFFFFFFFFFFFFE) {
        return 7
    }
    return 42
}
