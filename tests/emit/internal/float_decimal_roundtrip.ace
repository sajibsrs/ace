/* Native shortest formatting round-trips deterministic IEEE bit patterns. */

// expect-exit: 42

import str

main(): int {
    text: [64]u8 = [0 : 64]
    state64: u64 = u64(0x9E3779B97F4A7C15)

    for sample: int in 0 .. 4096 {
        state64 ^= state64 << 13
        state64 ^= state64 >> 7
        state64 ^= state64 << 17
        exponent: u64 = (state64 >> 52) & u64(0x7FF)

        if exponent != u64(0x7FF) {
            value: f64 = bitcast(f64, state64)
            count: usize, ok: bool = str.format(text[0..64], value)

            if !ok { return 1 }
            parsed: f64, parsed_ok: bool = str.parse[f64](text[0..count])

            if !parsed_ok || bitcast(u64, parsed) != state64 { return 2 }
        }
    }
    state32: u32 = u32(0x9E3779B9)

    for sample: int in 0 .. 4096 {
        state32 ^= state32 << 13
        state32 ^= state32 >> 17
        state32 ^= state32 << 5
        exponent: u32 = (state32 >> 23) & u32(0xFF)

        if exponent != u32(0xFF) {
            value: f32 = bitcast(f32, state32)
            count: usize, ok: bool = str.format(text[0..64], value)

            if !ok { return 3 }
            parsed: f32, parsed_ok: bool = str.parse[f32](text[0..count])

            if !parsed_ok || bitcast(u32, parsed) != state32 { return 4 }
        }
    }
    return 42
}
