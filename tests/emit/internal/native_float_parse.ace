/* Native decimal-to-float parsing covers exact midpoint rounding, extrema,
 * subnormals, overflow, signed underflow, and every fast-tier boundary
 * without a platform parser.
 */
// expect-exit: 0

import bits
import str

main(): int {
    d: f64, ok: bool = str.parse[f64]("1.00000000000000011102230246251565404236316680908203125")
    if !ok || bits.cast(d) != u64(0x3FF0000000000000) { return 1 }
    d, ok = str.parse[f64]("1.00000000000000033306690738754696212708950042724609375")
    if !ok || bits.cast(d) != u64(0x3FF0000000000002) { return 2 }
    d, ok = str.parse[f64]("2.4703282292062327e-324")
    if !ok || bits.cast(d) != 0 { return 3 }
    d, ok = str.parse[f64]("2.4703282292062328e-324")
    if !ok || bits.cast(d) != 1 { return 4 }
    d, ok = str.parse[f64]("-1e-999")
    if !ok || bits.cast(d) != u64(0x8000000000000000) { return 5 }
    d, ok = str.parse[f64]("1.7976931348623157e308")
    if !ok || bits.cast(d) != u64(0x7FEFFFFFFFFFFFFF) { return 6 }
    d, ok = str.parse[f64]("1.7976931348623159e308")
    if ok || bits.cast(d) != 0 { return 7 }
    f: f32, fok: bool = str.parse[f32]("1.000000059604644775390625")
    if !fok || bits.cast(f) != u32(0x3F800000) { return 8 }
    f, fok = str.parse[f32]("1.000000178813934326171875")
    if !fok || bits.cast(f) != u32(0x3F800002) { return 9 }
    f, fok = str.parse[f32]("7.00649232162408535461864791644958065640130970938257885878534141944895541342930300743319094181060791015625e-46")
    if !fok || bits.cast(f) != 0 { return 10 }
    f, fok = str.parse[f32]("7.006493e-46")
    if !fok || bits.cast(f) != 1 { return 11 }
    f, fok = str.parse[f32]("3.4028235e38")
    if !fok || bits.cast(f) != u32(0x7F7FFFFF) { return 12 }
    f, fok = str.parse[f32]("3.4028236e38")
    if fok || bits.cast(f) != 0 { return 13 }
    // Integers just past the exact-power tier round in the exact-small tier.
    d, ok = str.parse[f64]("9007199254740993")
    if !ok || bits.cast(d) != u64(0x4340000000000000) { return 14 }
    f, fok = str.parse[f32]("16777217")
    if !fok || bits.cast(f) != u32(0x4B800000) { return 15 }
    // The internal tier-selecting scan owns complete syntax validation.
    d, ok = str.parse[f64]("1.0e+")
    if ok || bits.cast(d) != 0 { return 16 }
    // A digit run ending inside an eight-byte word stops at its first non-digit.
    d, ok = str.parse[f64]("1.2345e100")
    if !ok || bits.cast(d) != u64(0x54B693878AAE8F8A) { return 38 }
    // Exact-power tier limits: 2^53 and |exponent10| 22 for f64, 2^24 and 10
    // for f32; neighbors fall through to the wider tiers.
    d, ok = str.parse[f64]("9007199254740992")
    if !ok || bits.cast(d) != u64(0x4340000000000000) { return 17 }
    d, ok = str.parse[f64]("9007199254740992e-22")
    if !ok || bits.cast(d) != u64(0x3EAE392010175EE6) { return 18 }
    d, ok = str.parse[f64]("9007199254740993e-22")
    if !ok || bits.cast(d) != u64(0x3EAE392010175EE7) { return 19 }
    d, ok = str.parse[f64]("1e22")
    if !ok || bits.cast(d) != u64(0x4480F0CF064DD592) { return 20 }
    d, ok = str.parse[f64]("1e23")
    if !ok || bits.cast(d) != u64(0x44B52D02C7E14AF6) { return 21 }
    d, ok = str.parse[f64]("1e-22")
    if !ok || bits.cast(d) != u64(0x3B5E392010175EE6) { return 22 }
    d, ok = str.parse[f64]("1e-23")
    if !ok || bits.cast(d) != u64(0x3B282DB34012B251) { return 23 }
    d, ok = str.parse[f64]("9007199254740991e22")
    if !ok || bits.cast(d) != u64(0x47D0F0CF064DD591) { return 24 }
    d, ok = str.parse[f64]("-3.141592653589793")
    if !ok || bits.cast(d) != u64(0xC00921FB54442D18) { return 25 }
    d, ok = str.parse[f64]("-0.0")
    if !ok || bits.cast(d) != u64(0x8000000000000000) { return 26 }
    d, ok = str.parse[f64]("-0e5")
    if !ok || bits.cast(d) != u64(0x8000000000000000) { return 27 }
    f, fok = str.parse[f32]("16777216")
    if !fok || bits.cast(f) != u32(0x4B800000) { return 28 }
    f, fok = str.parse[f32]("16777216e10")
    if !fok || bits.cast(f) != u32(0x5C1502F9) { return 29 }
    f, fok = str.parse[f32]("16777216e-10")
    if !fok || bits.cast(f) != u32(0x3ADBE6FF) { return 30 }
    f, fok = str.parse[f32]("16777217e-10")
    if !fok || bits.cast(f) != u32(0x3ADBE700) { return 31 }
    f, fok = str.parse[f32]("1e10")
    if !fok || bits.cast(f) != u32(0x501502F9) { return 32 }
    f, fok = str.parse[f32]("1e11")
    if !fok || bits.cast(f) != u32(0x51BA43B7) { return 33 }
    f, fok = str.parse[f32]("1e-10")
    if !fok || bits.cast(f) != u32(0x2EDBE6FF) { return 34 }
    f, fok = str.parse[f32]("1e-11")
    if !fok || bits.cast(f) != u32(0x2D2FEBFF) { return 35 }
    f, fok = str.parse[f32]("0.1")
    if !fok || bits.cast(f) != u32(0x3DCCCCCD) { return 36 }
    f, fok = str.parse[f32]("-0.0")
    if !fok || bits.cast(f) != u32(0x80000000) { return 37 }
    // The exact-small tier stops at 10^19; zero with any exponent is signed zero.
    d, ok = str.parse[f64]("1e19")
    if !ok || bits.cast(d) != u64(0x43E158E460913D00) { return 39 }
    d, ok = str.parse[f64]("1e20")
    if !ok || bits.cast(d) != u64(0x4415AF1D78B58C40) { return 40 }
    d, ok = str.parse[f64]("-2.5e100")
    if !ok || bits.cast(d) != u64(0xD4C6DC186EF9F45C) { return 41 }
    d, ok = str.parse[f64]("0e9999")
    if !ok || bits.cast(d) != u64(0x0000000000000000) { return 42 }
    d, ok = str.parse[f64]("-0e9999")
    if !ok || bits.cast(d) != u64(0x8000000000000000) { return 43 }
    f, fok = str.parse[f32]("1e19")
    if !fok || bits.cast(f) != u32(0x5F0AC723) { return 44 }
    f, fok = str.parse[f32]("1e20")
    if !fok || bits.cast(f) != u32(0x60AD78EC) { return 45 }
    f, fok = str.parse[f32]("-2.5e30")
    if !fok || bits.cast(f) != u32(0xF1FC6F7C) { return 46 }
    f, fok = str.parse[f32]("0e9999")
    if !fok || bits.cast(f) != u32(0x00000000) { return 47 }
    f, fok = str.parse[f32]("-0e9999")
    if !fok || bits.cast(f) != u32(0x80000000) { return 48 }
    return 0
}
