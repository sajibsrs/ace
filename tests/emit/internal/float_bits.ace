/* Public bits representation operations preserve every stored float bit. */

// expect-exit: 42

main(): int {
    if bitcast(u64, f64(1.0)) != u64(0x3FF0000000000000) { return 1 }
    negative: f64 = 0.0 - 1.0
    if bitcast(u64, negative) != u64(0xBFF0000000000000) { return 2 }
    if bitcast(u32, f32(0.5)) != u32(0x3F000000) { return 3 }
    negative_zero64: u64 = u64(0x8000000000000000)
    if bitcast(u64, bitcast(f64, negative_zero64)) != negative_zero64 { return 4 }
    payload64: u64 = u64(0x7FF8000000001234)
    if bitcast(u64, bitcast(f64, payload64)) != payload64 { return 5 }
    payload32: u32 = u32(0x7FC01234)
    if bitcast(u32, bitcast(f32, payload32)) != payload32 { return 6 }
    return 42
}
