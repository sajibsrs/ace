/* Darwin poll queue runtime coverage. */

// expect-exit: 0

import poll
import sys

extern "c" {
    c_pipe(fds: mut *i32): i32 = "pipe"
}

has_error(err: Error, domain: typeid): bool {
    return err != null && err.domain == domain
}

main(): int {
    q: poll.Queue, err: Error = poll.queue()

    if err != null || q == -1 {
        return 1
    }

    if !has_error(poll.watch(q, sys.Fd(0), false, false), typeid(poll.WatchErr)) ||
       sys.errno() != 22 {
        sys.close(sys.Fd(q))
        return 2
    }

    raw_fds: [2]i32 = [i32(0) : 2]

    if c_pipe(mut &raw_fds[0]) == -1 {
        sys.close(sys.Fd(q))
        return 3
    }
    read_fd: sys.Fd = sys.Fd(raw_fds[0])
    write_fd: sys.Fd = sys.Fd(raw_fds[1])

    if poll.watch(q, read_fd, true, false) != null ||
       poll.watch(q, read_fd, true, false) != null ||
       poll.watch(q, write_fd, false, true) != null {
        sys.close(read_fd)
        sys.close(write_fd)
        sys.close(sys.Fd(q))
        return 4
    }

    zero: poll.Event = poll.Event {
        fd: sys.Fd(0),
        readable: false,
        writable: false,
        error: false,
        hangup: false,
    }
    storage: [4]poll.Event = [zero : 4]
    events: []poll.Event = storage[0..4]
    count: usize, wait_err: Error = poll.wait(q, mut events, u64(0))

    if wait_err != null || count == 0 {
        sys.close(read_fd)
        sys.close(write_fd)
        sys.close(sys.Fd(q))
        return 5
    }
    writable: bool = false

    for index: usize in 0 .. count {
        if events[index].fd == write_fd && events[index].writable {
            writable = true
        }
    }

    if !writable {
        sys.close(read_fd)
        sys.close(write_fd)
        sys.close(sys.Fd(q))
        return 16
    }

    byte: [1]u8 = [u8(7)]
    written: int, write_err: Error = sys.write(write_fd, byte[0..1])

    if write_err != null || written != 1 {
        sys.close(read_fd)
        sys.close(write_fd)
        sys.close(sys.Fd(q))
        return 6
    }

    count, wait_err = poll.wait(q, mut events, u64(1000000000))

    if wait_err != null || count == 0 {
        sys.close(read_fd)
        sys.close(write_fd)
        sys.close(sys.Fd(q))
        return 7
    }
    readable: bool = false

    for index: usize in 0 .. count {
        if events[index].fd == read_fd && events[index].readable {
            readable = true
        }
    }

    if !readable {
        sys.close(read_fd)
        sys.close(write_fd)
        sys.close(sys.Fd(q))
        return 8
    }

    byte_view: []u8 = byte[0..1]
    received: int, read_err: Error = sys.read(read_fd, mut byte_view)

    if read_err != null || received != 1 {
        sys.close(read_fd)
        sys.close(write_fd)
        sys.close(sys.Fd(q))
        return 9
    }

    if poll.unwatch(q, write_fd) != null {
        sys.close(read_fd)
        sys.close(write_fd)
        sys.close(sys.Fd(q))
        return 10
    }
    sys.close(write_fd)

    count, wait_err = poll.wait(q, mut events, u64(1000000000))

    if wait_err != null || count == 0 {
        sys.close(read_fd)
        sys.close(sys.Fd(q))
        return 11
    }
    hung_up: bool = false

    for index: usize in 0 .. count {
        if events[index].fd == read_fd && events[index].readable &&
           events[index].hangup {
            hung_up = true
        }
    }

    if !hung_up {
        sys.close(read_fd)
        sys.close(sys.Fd(q))
        return 12
    }

    if poll.unwatch(q, read_fd) != null {
        sys.close(read_fd)
        sys.close(sys.Fd(q))
        return 13
    }

    if !has_error(poll.unwatch(q, read_fd), typeid(poll.UnwatchErr)) ||
       sys.errno() != 2 {
        sys.close(read_fd)
        sys.close(sys.Fd(q))
        return 14
    }

    empty: []poll.Event = null
    count, wait_err = poll.wait(q, mut empty, u64(0))

    if count != 0 || !has_error(wait_err, typeid(poll.WaitErr)) ||
       sys.errno() != 22 {
        sys.close(read_fd)
        sys.close(sys.Fd(q))
        return 15
    }

    sys.close(read_fd)
    sys.close(sys.Fd(q))
    return 0
}
