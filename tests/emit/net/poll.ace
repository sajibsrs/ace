/* Darwin poll queue runtime coverage. */

// expect-exit: 0

import mem
import poll
import sys

has_error(err: Error, domain: typeid): bool {
    return err != null && err.domain == domain && err.code != 0
}

main(): int {
    q: poll.Queue, err: Error = poll.queue()

    if err != null || q == -1 { return 1 }

    watch_err: Error = poll.watch(q, sys.Fd(0), false, false)
    if watch_err != poll.WatchErr.invalid || sys.errno() != 22 ||
       !mem.equal(watch_err.message, "at least one readiness interest is required") {
        sys.close(sys.Fd(q))
        return 2
    }

    read_fd: sys.Fd, write_fd: sys.Fd, pipe_err: Error = sys.pipe()

    if pipe_err != null {
        sys.close(sys.Fd(q))
        return 3
    }

    if poll.watch(q, read_fd, true, false) != null ||
       poll.watch(q, read_fd, true, false) != null ||
       poll.watch(q, write_fd, false, true) != null {
        sys.close(read_fd)
        sys.close(write_fd)
        sys.close(sys.Fd(q))
        return 4
    }

    zero: poll.Event = poll.Event {
        fd = sys.Fd(0),
        readable = false,
        writable = false,
        error = false,
        hangup = false,
    }
    storage: [4]poll.Event = [zero : 4]
    events: mut []poll.Event = mut storage[0..4]
    count: usize, wait_err: Error = poll.wait(q, events, u64(0))

    if wait_err != null || count == 0 {
        sys.close(read_fd)
        sys.close(write_fd)
        sys.close(sys.Fd(q))
        return 5
    }
    writable: bool = false

    for index: usize in 0 .. count {
        if events[index].fd == write_fd && events[index].writable { writable = true }
    }

    if !writable {
        sys.close(read_fd)
        sys.close(write_fd)
        sys.close(sys.Fd(q))
        return 16
    }

    byte: [1]u8 = [u8(7)]
    written: int, write_err: Error = sys.write(write_fd, byte[0..1])

    if write_err != null || written != 1 {
        sys.close(read_fd)
        sys.close(write_fd)
        sys.close(sys.Fd(q))
        return 6
    }

    count, wait_err = poll.wait(q, events, u64(1000000000))

    if wait_err != null || count == 0 {
        sys.close(read_fd)
        sys.close(write_fd)
        sys.close(sys.Fd(q))
        return 7
    }
    readable: bool = false

    for index: usize in 0 .. count {
        if events[index].fd == read_fd && events[index].readable { readable = true }
    }

    if !readable {
        sys.close(read_fd)
        sys.close(write_fd)
        sys.close(sys.Fd(q))
        return 8
    }

    byte_view: mut []u8 = mut byte[0..1]
    received: int, read_err: Error = sys.read(read_fd, byte_view)

    if read_err != null || received != 1 {
        sys.close(read_fd)
        sys.close(write_fd)
        sys.close(sys.Fd(q))
        return 9
    }

    if poll.unwatch(q, write_fd) != null {
        sys.close(read_fd)
        sys.close(write_fd)
        sys.close(sys.Fd(q))
        return 10
    }
    sys.close(write_fd)

    count, wait_err = poll.wait(q, events, u64(1000000000))

    if wait_err != null || count == 0 {
        sys.close(read_fd)
        sys.close(sys.Fd(q))
        return 11
    }
    hung_up: bool = false

    for index: usize in 0 .. count {
        if events[index].fd == read_fd && events[index].readable &&
           events[index].hangup {
            hung_up = true
        }
    }

    if !hung_up {
        sys.close(read_fd)
        sys.close(sys.Fd(q))
        return 12
    }

    if poll.unwatch(q, read_fd) != null {
        sys.close(read_fd)
        sys.close(sys.Fd(q))
        return 13
    }

    if !has_error(poll.unwatch(q, read_fd), typeid(poll.UnwatchErr)) {
        sys.close(read_fd)
        sys.close(sys.Fd(q))
        return 14
    }

    empty: mut []poll.Event = null
    count, wait_err = poll.wait(q, empty, u64(0))

    if count != 0 || wait_err != poll.WaitErr.invalid ||
       !mem.equal(wait_err.message, "event storage must not be empty") {
        sys.close(read_fd)
        sys.close(sys.Fd(q))
        return 15
    }

    sys.close(read_fd)
    sys.close(sys.Fd(q))
    return 0
}
