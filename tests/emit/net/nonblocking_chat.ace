/* Deterministic multi-client chat server over the allocation-free poll queue. */

// expect-exit: 0

import mem
import net
import poll
import sys

CLIENT_CAPACITY: const usize = 2
BUFFER_CAPACITY: const usize = 8

Client: struct {
    socket: net.Socket,
    input: [8]u8,
    input_count: usize,
    output: [8]u8,
    output_count: usize,
    output_sent: usize,
}

loopback(port: u16): net.Addr4 {
    return net.Addr4 {ip: [127, 0, 0, 1], port: port}
}

zero_client(): Client {
    return Client {
        socket: net.Socket(-1),
        input: [u8(0) : 8],
        input_count: 0,
        output: [u8(0) : 8],
        output_count: 0,
        output_sent: 0,
    }
}

write_token(fd: sys.Fd): bool {
    token: [1]u8 = [u8(1)]
    count: int, err: Error = sys.write(fd, token[0..1])
    return err == null && count == 1
}

read_token(fd: sys.Fd): bool {
    token: [1]u8 = [u8(0)]
    count: int, err: Error = sys.read(fd, mut token[0..1])
    return err == null && count == 1
}

send_fragmented(sock: net.Socket, text: string): bool {
    sent: usize = 0

    for sent < text.len {
        /* A one-byte view makes partial application progress deterministic;
         * net.send still performs exactly one kernel operation per attempt.
         */
        count: int, err: Error = net.send(sock, text[sent..sent + 1])

        if err != null || count != 1 {
            return false
        }
        sent += 1
    }
    return true
}

receive_exact(sock: net.Socket, expected: string): bool {
    storage: [8]u8 = [u8(0) : 8]
    received: usize = 0

    for received < expected.len {
        /* Bound each receive to one byte so message assembly necessarily
         * retains partial progress across multiple operations.
         */
        count: int, err: Error = net.receive(
            sock, mut storage[received..received + 1])

        if err != null || count != 1 {
            return false
        }
        received += 1
    }
    return mem.equal(storage[0..received], expected)
}

connect_client(port: u16): (net.Socket, bool) {
    sock: net.Socket, err: Error = net.socket(net.SocketKind.tcp)

    if err != null || net.connect(sock, loopback(port)) != null {
        if sock != -1 {
            sys.close(sock)
        }
        return net.Socket(-1), false
    }
    return sock, true
}

client_a(port: u16, gate: sys.Fd): int {
    sock: net.Socket, ok: bool = connect_client(port)

    if !ok {
        return 1
    }
    if !read_token(gate) || !send_fragmented(sock, "A!") ||
       !receive_exact(sock, "A!") {
        sys.close(sock)
        return 2
    }
    if !read_token(gate) || !receive_exact(sock, "B?") ||
       !read_token(gate) {
        sys.close(sock)
        return 3
    }
    if sys.close(sock) != null {
        return 4
    }
    return 0
}

client_b(port: u16, gate: sys.Fd): int {
    sock: net.Socket, ok: bool = connect_client(port)

    if !ok {
        return 1
    }
    if !read_token(gate) || !receive_exact(sock, "A!") ||
       !send_fragmented(sock, "B?") || !receive_exact(sock, "B?") {
        sys.close(sock)
        return 2
    }
    if !read_token(gate) || !send_fragmented(sock, "B2") ||
       !receive_exact(sock, "B2") || !receive_exact(sock, "C3") {
        sys.close(sock)
        return 3
    }
    if sys.close(sock) != null {
        return 4
    }
    return 0
}

client_c(port: u16, gate: sys.Fd): int {
    sock: net.Socket, ok: bool = connect_client(port)

    if !ok {
        return 1
    }
    if !read_token(gate) || !receive_exact(sock, "B2") ||
       !send_fragmented(sock, "C3") || !receive_exact(sock, "C3") {
        sys.close(sock)
        return 2
    }
    if sys.close(sock) != null {
        return 3
    }
    return 0
}

fork_client(kind: int, port: u16, gate_read: sys.Fd, gate_write: sys.Fd,
            q: poll.Queue, listener: net.Socket,
            clients: []Client): (sys.Process, Error) {
    process: sys.Process, err: Error = sys.fork()

    if err != null || process != 0 {
        return process, err
    }

    sys.close(gate_write)
    sys.close(sys.Fd(q))
    sys.close(listener)
    for client: Client in clients {
        if client.socket != -1 {
            sys.close(client.socket)
        }
    }

    code: int = 90
    if kind == 0 {
        code = client_a(port, gate_read)
    } else if kind == 1 {
        code = client_b(port, gate_read)
    } else {
        code = client_c(port, gate_read)
    }
    sys.close(gate_read)
    sys.exit(code)
    return sys.Process(0), null
}

find_client(clients: []Client, fd: sys.Fd): usize {
    for index: usize in 0 .. clients.len {
        if clients[index].socket == fd {
            return index
        }
    }
    return clients.len
}

find_free(clients: []Client): usize {
    for index: usize in 0 .. clients.len {
        if clients[index].socket == -1 {
            return index
        }
    }
    return clients.len
}

broadcast(clients: mut []Client, message: []u8): bool {
    for index: usize in 0 .. clients.len {
        if clients[index].socket != -1 {
            if clients[index].output_count != clients[index].output_sent ||
               message.len > BUFFER_CAPACITY {
                return false
            }
            for byte_index: usize in 0 .. message.len {
                clients[index].output[byte_index] = message[byte_index]
            }
            clients[index].output_count = message.len
            clients[index].output_sent = 0
        }
    }
    return true
}

set_interest(q: poll.Queue, client: Client): bool {
    writable: bool = client.output_sent < client.output_count
    return poll.watch(q, client.socket, true, writable) == null
}

close_client(q: poll.Queue, mut client: Client) {
    if client.socket != -1 {
        poll.unwatch(q, client.socket)
        sys.close(client.socket)
    }
    client = zero_client()
}

all_flushed(clients: []Client): bool {
    for client: Client in clients {
        if client.socket != -1 && client.output_sent < client.output_count {
            return false
        }
    }
    return true
}

all_closed(clients: []Client): bool {
    for client: Client in clients {
        if client.socket != -1 {
            return false
        }
    }
    return true
}

wait_child(process: sys.Process): bool {
    status: sys.ProcessStatus, err: Error = sys.wait(process)
    return err == null && status.exited && status.code == 0
}

main(): int {
    listener: net.Socket, err: Error = net.socket(net.SocketKind.tcp)

    if err != null {
        return 10
    }
    if net.reuse_addr(listener, true) != null {
        sys.close(listener)
        return 11
    }
    if net.bind(listener, loopback(u16(0))) != null {
        sys.close(listener)
        return 12
    }
    if net.listen(listener, usize(8)) != null {
        sys.close(listener)
        return 13
    }
    if net.nonblock(listener, true) != null {
        sys.close(listener)
        return 14
    }
    local: net.Addr4
    local, err = net.local(listener)
    if err != null || local.port == 0 {
        sys.close(listener)
        return 15
    }

    q: poll.Queue
    q, err = poll.queue()
    if err != null || poll.watch(q, listener, true, false) != null {
        sys.close(listener)
        if err == null {
            sys.close(sys.Fd(q))
        }
        return 16
    }

    clients: [2]Client = [zero_client() : 2]
    processes: [3]sys.Process = [sys.Process(-1) : 3]
    gates: [3]sys.Fd = [sys.Fd(-1) : 3]

    gate_read: sys.Fd
    gate_write: sys.Fd
    gate_read, gate_write, err = sys.pipe()
    if err != null {
        sys.close(listener)
        sys.close(sys.Fd(q))
        return 17
    }
    processes[0], err = fork_client(0, local.port, gate_read, gate_write,
                                    q, listener, clients[0..2])
    if err != null || processes[0] == -1 {
        sys.close(gate_read)
        sys.close(gate_write)
        sys.close(listener)
        sys.close(sys.Fd(q))
        return 18
    }
    sys.close(gate_read)
    gates[0] = gate_write

    zero_event: poll.Event = poll.Event {
        fd: sys.Fd(0), readable: false, writable: false,
        error: false, hangup: false,
    }
    event_storage: [4]poll.Event = [zero_event : 4]
    events: mut []poll.Event = mut event_storage[0..4]
    accepted_count: usize = 0
    stage: int = 0
    reused_slot: usize = CLIENT_CAPACITY
    first_slot: usize = CLIENT_CAPACITY
    failure: int = 0
    done: bool = false

    for !done && failure == 0 {
        count: usize, wait_err: Error = poll.wait(q, events, u64(1000000000))
        if wait_err != null || count == 0 {
            failure = 20
            break
        }

        for event_index: usize in 0 .. count {
            event: poll.Event = events[event_index]

            if event.fd == listener && event.readable {
                slot: usize = find_free(clients[0..2])
                accepted: net.Socket, address: net.Addr4, accept_err: Error = net.accept(listener)

                if slot == CLIENT_CAPACITY || accept_err != null || accepted == -1 ||
                   address.ip[0] != 127 || net.nonblock(accepted, true) != null {
                    if accepted != -1 {
                        sys.close(accepted)
                    }
                    failure = 21
                    break
                }
                clients[slot] = zero_client()
                clients[slot].socket = accepted
                if poll.watch(q, accepted, true, false) != null {
                    failure = 22
                    break
                }
                accepted_count += 1

                if accepted_count == 1 {
                    first_slot = slot
                    gate_read, gate_write, err = sys.pipe()
                    if err != null {
                        failure = 23
                        break
                    }
                    processes[1], err = fork_client(
                        1, local.port, gate_read, gate_write,
                        q, listener, clients[0..2])
                    if err != null || processes[1] == -1 {
                        failure = 24
                        break
                    }
                    sys.close(gate_read)
                    gates[1] = gate_write
                } else if accepted_count == 2 {
                    if !write_token(gates[0]) {
                        failure = 25
                        break
                    }
                    stage = 1
                } else if accepted_count == 3 {
                    reused_slot = slot
                    if reused_slot != first_slot || !write_token(gates[1]) {
                        failure = 26
                        break
                    }
                    stage = 6
                }
            } else {
                slot: usize = find_client(clients[0..2], event.fd)
                if slot == CLIENT_CAPACITY {
                    failure = 27
                    break
                }

                if event.readable {
                    room: usize = BUFFER_CAPACITY - clients[slot].input_count
                    if room == 0 {
                        failure = 28
                        break
                    }
                    /* One-byte receive views force the server to retain partial
                     * message state across readiness-driven operations.
                     */
                    begin: usize = clients[slot].input_count
                    amount: int, receive_err: Error = net.receive(
                        clients[slot].socket,
                        mut clients[slot].input[begin..begin + 1])

                    if receive_err != null {
                        if receive_err.code != sys.EWOULDBLOCK {
                            failure = 29
                            break
                        }
                    } else if amount == 0 {
                        old_slot: usize = slot
                        close_client(q, mut clients[slot])

                        if stage == 5 && old_slot == first_slot {
                            if !wait_child(processes[0]) {
                                failure = 30
                                break
                            }
                            sys.close(gates[0])
                            gate_read, gate_write, err = sys.pipe()
                            if err != null {
                                failure = 31
                                break
                            }
                            processes[2], err = fork_client(
                                2, local.port, gate_read, gate_write,
                                q, listener, clients[0..2])
                            if err != null || processes[2] == -1 {
                                failure = 32
                                break
                            }
                            sys.close(gate_read)
                            gates[2] = gate_write
                        } else if stage == 10 && all_closed(clients[0..2]) {
                            done = true
                        }
                    } else {
                        clients[slot].input_count += usize(amount)
                        if clients[slot].input_count == 2 {
                            if !broadcast(mut clients[0..2],
                                          clients[slot].input[0..2]) {
                                failure = 33
                                break
                            }
                            clients[slot].input_count = 0
                            for watch_index: usize in 0 .. CLIENT_CAPACITY {
                                if clients[watch_index].socket != -1 &&
                                   !set_interest(q, clients[watch_index]) {
                                    failure = 34
                                }
                            }
                            if failure != 0 {
                                break
                            }
                            if stage == 1 {
                                stage = 2
                            } else if stage == 6 {
                                stage = 7
                            } else if stage == 3 {
                                stage = 4
                            } else if stage == 8 {
                                stage = 9
                            } else {
                                failure = 35
                                break
                            }
                        }
                    }
                }

                if event.writable && clients[slot].socket != -1 &&
                   clients[slot].output_sent < clients[slot].output_count {
                    begin: usize = clients[slot].output_sent
                    /* One-byte send views deterministically exercise retained
                     * partial broadcast progress for every recipient.
                     */
                    amount: int, send_err: Error = net.send(
                        clients[slot].socket,
                        clients[slot].output[begin..begin + 1])
                    if send_err != null {
                        if send_err.code != sys.EWOULDBLOCK {
                            failure = 36
                            break
                        }
                    } else if amount != 1 {
                        failure = 37
                        break
                    } else {
                        clients[slot].output_sent += 1
                        if clients[slot].output_sent == clients[slot].output_count {
                            clients[slot].output_count = 0
                            clients[slot].output_sent = 0
                            if !set_interest(q, clients[slot]) {
                                failure = 38
                                break
                            }
                        }
                    }
                }
            }
        }

        if failure == 0 && all_flushed(clients[0..2]) {
            if stage == 2 {
                if !write_token(gates[1]) {
                    failure = 40
                } else {
                    stage = 3
                }
            } else if stage == 4 {
                if !write_token(gates[0]) || !write_token(gates[0]) {
                    failure = 41
                } else {
                    stage = 5
                }
            } else if stage == 7 {
                if !write_token(gates[2]) {
                    failure = 42
                } else {
                    stage = 8
                }
            } else if stage == 9 {
                stage = 10
            }
        }
    }

    for index: usize in 0 .. CLIENT_CAPACITY {
        close_client(q, mut clients[index])
    }
    poll.unwatch(q, listener)
    sys.close(listener)
    sys.close(sys.Fd(q))
    for index: usize in 0 .. usize(3) {
        if gates[index] != -1 {
            sys.close(gates[index])
        }
    }

    if processes[1] != -1 && !wait_child(processes[1]) {
        return 50
    }
    if processes[2] != -1 && !wait_child(processes[2]) {
        return 51
    }
    if failure != 0 {
        return failure
    }
    if reused_slot != first_slot {
        return 52
    }
    return 0
}
