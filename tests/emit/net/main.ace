/* Blocking TCP failure paths, localhost resolution, and a forked echo round trip. */

// expect-exit: 0

import mem
import net
import sys

loopback(port: u16): net.Addr4 {
    return net.Addr4 {
        ip = [127, 0, 0, 1],
        port = port,
    }
}

check_error(err: Error, domain: typeid): bool {
    return err != null && err.domain == domain && err.code != 0
}

check_failures(): int {
    invalid: net.Socket = net.Socket(-1)

    if !check_error(net.reuseaddr(invalid, true), typeid(net.ReuseaddrErr)) { return 1 }

    if !check_error(net.reuseport(invalid, true), typeid(net.ReuseportErr)) { return 2 }

    if !check_error(net.nonblock(invalid, true), typeid(net.NonblockErr)) { return 3 }

    if !check_error(net.bind(invalid, loopback(u16(1))), typeid(net.BindErr)) { return 4 }

    if !check_error(net.listen(invalid, usize(1)), typeid(net.ListenErr)) { return 5 }
    accepted: net.Socket, address: net.Addr4, aerr: Error = net.accept(invalid)

    if accepted != -1 { return 6 }

    if aerr == null { return 14 }

    if !check_error(aerr, typeid(net.AcceptErr)) { return 13 }

    if address.ip[0] != 0 || address.ip[1] != 0 || address.ip[2] != 0 ||
       address.ip[3] != 0 || address.port != 0 {
        return 7
    }

    if !check_error(net.connect(invalid, loopback(u16(1))), typeid(net.ConnectErr)) { return 8 }
    local: net.Addr4, local_err: Error = net.local(invalid)

    if local.ip[0] != 0 || local.ip[1] != 0 || local.ip[2] != 0 ||
       local.ip[3] != 0 || local.port != 0 ||
       !check_error(local_err, typeid(net.LocalErr)) {
        return 15
    }

    bytes: [1]u8 = [0]
    view: []u8 = bytes[0..1]
    count: int, rerr: Error = net.receive(invalid, view)

    if count != 0 || !check_error(rerr, typeid(net.ReceiveErr)) { return 9 }
    count, rerr = net.send(invalid, "x")

    if count != 0 || !check_error(rerr, typeid(net.SendErr)) { return 10 }
    count, rerr = net.send(invalid, view)

    if count != 0 || !check_error(rerr, typeid(net.SendErr)) { return 11 }
    return 0
}

check_resolution(): int {
    storage: [2]net.Addr4
    storage[0] = loopback(u16(1))
    storage[1] = loopback(u16(54321))
    first: []net.Addr4 = storage[0..1]

    count: usize, err: Error = net.resolve4("localhost", u16(8080), first)

    if err != null || count != 1 { return 1 }

    if storage[0].ip[0] != 127 || storage[0].ip[1] != 0 ||
       storage[0].ip[2] != 0 || storage[0].ip[3] != 1 ||
       storage[0].port != 8080 {
        return 2
    }

    if storage[1].port != 54321 { return 3 }

    empty: []net.Addr4 = null
    count, err = net.resolve4("localhost", u16(80), empty)

    if count != 0 || err != net.ResolveErr.invalid ||
       !mem.equal(err.message, "invalid name-resolution input or result") {
        return 4
    }

    count, err = net.resolve4("local\x00host", u16(80), first)

    if count != 0 || err != net.ResolveErr.invalid ||
       !mem.equal(err.message, "invalid name-resolution input or result") {
        return 5
    }
    return 0
}

child(port: u16): int {
    sock: net.Socket, err: Error = net.socket(net.SocketType.tcp)

    if err != null { return 1 }
    err = net.connect(sock, loopback(port))

    if err != null {
        sys.close(sock)
        return 2
    }
    count: int, ioerr: Error = net.send(sock, "ping")

    if ioerr != null || count != 4 {
        sys.close(sock)
        return 3
    }
    storage: [4]u8 = [0 : 4]
    reply: []u8 = storage[0..4]
    count, ioerr = net.receive(sock, reply)

    if ioerr != null || count != 4 || !mem.equal(storage, "pong") {
        sys.close(sock)
        return 4
    }

    if sys.close(sock) != null { return 5 }
    return 0
}

main(): int {
    failure: int = check_failures()

    if failure != 0 { return failure }
    failure = check_resolution()

    if failure != 0 { return 40 + failure }

    listener: net.Socket = net.Socket(-1)
    selected: u16 = 0
    err: Error
    listener, err = net.socket(net.SocketType.tcp)

    if err != null { return 20 }

    if net.reuseaddr(listener, true) != null ||
       net.reuseaddr(listener, false) != null ||
       net.reuseaddr(listener, true) != null ||
       net.reuseport(listener, true) != null ||
       net.reuseport(listener, false) != null ||
       net.bind(listener, loopback(u16(0))) != null {
        sys.close(listener)
        return 21
    }
    local: net.Addr4
    local, err = net.local(listener)

    if err != null || local.port == 0 {
        sys.close(listener)
        return 22
    }
    selected = local.port

    if net.nonblock(listener, true) != null ||
       net.nonblock(listener, false) != null {
        sys.close(listener)
        return 23
    }

    if net.listen(listener, usize(8)) != null {
        sys.close(listener)
        return 24
    }

    if !check_error(net.listen(listener, usize(0x80000000)), typeid(net.ListenErr)) {
        sys.close(listener)
        return 25
    }

    process: sys.Process, fork_err: Error = sys.fork()

    if fork_err != null || process == -1 {
        sys.close(listener)
        return 26
    }

    if process == 0 {
        code: int = child(selected)
        sys.exit(code)
    }

    peer: net.Socket, peer_address: net.Addr4, err = net.accept(listener)

    if err != null || peer == -1 {
        sys.close(listener)
        return 27
    }

    if peer_address.ip[0] != 127 || peer_address.ip[1] != 0 ||
       peer_address.ip[2] != 0 || peer_address.ip[3] != 1 ||
       peer_address.port == 0 {
        sys.close(peer)
        sys.close(listener)
        return 28
    }

    storage: [4]u8 = [0 : 4]
    request: []u8 = storage[0..4]
    count: int, ioerr: Error = net.receive(peer, request)

    if ioerr != null || count != 4 || !mem.equal(storage, "ping") {
        sys.close(peer)
        sys.close(listener)
        return 29
    }
    count, ioerr = net.send(peer, "pong")

    if ioerr != null || count != 4 {
        sys.close(peer)
        sys.close(listener)
        return 30
    }

    if sys.close(peer) != null || sys.close(listener) != null { return 31 }

    status: sys.ProcessStatus, wait_err: Error = sys.wait(process)

    if wait_err != null || !status.exited || status.code != 0 { return 32 }
    return 0
}
