/* Sequential/aggregate composition: direct nested arrays and slices retain
 * exact aggregate identity, copy semantics, mutability, parameter/return
 * behavior, and element-size addressing. */

// expect-exit: 0

Color: enum { red, green, blue }
Score: distinct i32
Point: struct { x: i32, y: i32 }
Box[T]: struct { value: T }
Choice[T]: union { none, value: T }

Points: type = [2][2]Point
Colors: type = [2][2]Color
Scores: type = [2][2]Score
Boxes: type = [2][2]Box[i32]
Choices: type = [2][2]Choice[i32]

id[T](value: T): T { return value }

replace[T](values: mut []T, index: int, value: T) {
    values[index] = value
}

make_points(): [2][2]Point {
    return [[Point { x = 1, y = 2 }, Point { x = 3, y = 4 }],
            [Point { x = 5, y = 6 }, Point { x = 7, y = 8 }]]
}

make_colors(): [2][2]Color {
    return [[Color.red, Color.green], [Color.blue, Color.red]]
}

make_scores(): [2][2]Score {
    return [[Score(1), Score(2)], [Score(3), Score(4)]]
}

make_boxes(): [2][2]Box[i32] {
    return [[Box[i32] { value = 1 }, Box[i32] { value = 2 }],
            [Box[i32] { value = 3 }, Box[i32] { value = 4 }]]
}

make_choices(): [2][2]Choice[i32] {
    return [[Choice[i32].value(1), Choice[i32].none],
            [Choice[i32].value(3), Choice[i32].value(4)]]
}

main(): int {
    points: [2][2]Point = id[Points](make_points())
    points_copy: [2][2]Point = points
    points_copy[0][0].x = 10
    point_view: mut []Point = mut points_copy[0][0..2]
    replace[Point](point_view, 1, Point { x = 20, y = 21 })
    if points[0][0].x != 1 || points_copy[0][0].x != 10 || point_view[1].y != 21 {
        return 1
    }

    colors: [2][2]Color = id[Colors](make_colors())
    color_view: mut []Color = mut colors[1][0..2]
    replace[Color](color_view, 1, Color.green)
    if colors[0][1] != Color.green || color_view[1] != Color.green {
        return 2
    }

    scores: [2][2]Score = id[Scores](make_scores())
    score_view: mut []Score = mut scores[1][0..2]
    replace[Score](score_view, 0, Score(30))
    if i32(scores[0][1]) != 2 || i32(score_view[0]) != 30 {
        return 3
    }

    boxes: [2][2]Box[i32] = id[Boxes](make_boxes())
    box_view: mut []Box[i32] = mut boxes[1][0..2]
    replace[Box[i32]](box_view, 1, Box[i32] { value = 40 })
    if boxes[0][0].value != 1 || box_view[1].value != 40 {
        return 4
    }

    choices: [2][2]Choice[i32] = id[Choices](make_choices())
    choice_view: mut []Choice[i32] = mut choices[0][0..2]
    replace[Choice[i32]](choice_view, 1, Choice[i32].value(20))
    switch choice_view[1] {
        Choice[i32].value(value: i32) {
            if value != 20 { return 5 }
        }
        default { return 6 }
    }
    return 0
}
