/* A template stamp created before its specialization is declared keeps the
 * template body; the two get distinct symbols (g-tag stamp, s-tag spec) and
 * calls checked after the specialization resolves to it. */

// expect-exit: 42

g[T](v: T): T {
    return v
}

stamp_first(): int {
    return g[int](1) // checked before the [int] specialization exists: stamps
}

g[int](v: int): int {
    return 100
}

main(): int {
    if stamp_first() != 1 {
        return 1 // the stamp runs the template body, not the later spec
    }
    if g[int](2) != 100 {
        return 2 // checked after the spec: exact-match resolution
    }
    return 42
}
