/* A declared function-value type selects among generic overloads with the
 * same type-argument count; the type arguments are still written. */

// expect-exit: 42

combine[T](a: T, b: T): T {
    return a + b
}

combine[T](a: T): T {
    return a + a
}

combine[int](a: int): int {
    return a * 10
}

apply(f: (int, int): int, a: int, b: int): int {
    return f(a, b)
}

main(): int {
    two: (int, int): int = combine[int]
    one: (int): int = combine[int]
    wide: (f64): f64 = combine[f64]
    if two(3, 4) != 7 { return 1 }
    if one(5) != 50 { return 2 }
    if wide(1.5) != 3.0 { return 3 }
    if apply(combine[int], 1, 2) != 3 { return 4 }
    return 42
}
