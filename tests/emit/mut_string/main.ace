/* Runtime surface of the mutable-string-bytes topic: the three exact view
 * conversions preserve descriptors byte-for-byte, indexed writes land in the
 * backing storage, and `in mut` iteration aliases the bytes. Each stage folds
 * its verdict into the exit code. expect-exit: 0 */

import mem

main(): int {
    storage: [12]u8
    view: mut []u8 = mut storage[0..]
    mem.fill(view, 0)
    // string and []u8 spell the same writable view by different intent
    view[0] = 'o'
    text: mut string = view
    if text.len != 12 || text[0] != 111 {
        return 1
    }
    text[1] = 'k' // indexed write through mut string (u8 or char)
    view[2] = 0
    if view[1] != 107 || text[2] != 0 {
        return 2
    }
    // the reverse conversion shares the descriptor: writes cross both ways
    back: mut []u8 = text
    back[3] = 'A'
    if text[3] != 65 {
        return 3
    }
    // conversion result follows the stated type; shrink stays implicit
    plain: string = view
    readonly: []u8 = back
    if plain.len != 12 || readonly[3] != 65 {
        return 4
    }
    // descriptor preservation: empty views stay non-null, zero stays zero
    empty: mut []u8 = mut storage[12..]
    hollow: mut string = empty
    if hollow == null || hollow.len != 0 {
        return 5
    }
    zview: []u8 = null
    ztext: string = zview
    if ztext != null {
        return 6
    }
    // `in mut` iteration aliases the bytes; writes land in storage
    total: usize = 0
    for i: usize, c: u8 in mut text {
        total += i
        if c == 107 {
            c = 'K'
        }
    }
    if total != 66 || text[1] != 75 {
        return 7
    }
    // iteration over a re-sliced mut string stays writable
    for c: u8 in mut text[4..8] {
        c = 1
    }
    if text[4] != 1 || text[7] != 1 || text[8] != 0 {
        return 8
    }
    // mem.fill through the view reaches every spelling of the same bytes
    mem.fill(view, 2)
    if text[11] != 2 || back[0] != 2 || plain[5] != 2 {
        return 9
    }
    mem.zero(view[3..7])
    if view[2] != 2 || view[3] != 0 || view[6] != 0 || view[7] != 2 {
        return 10
    }
    mem.fill(empty, 7)
    mem.zero(empty)
    return 0
}
