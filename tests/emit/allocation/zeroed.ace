/* mem.zalloc[T] returns zero-filled storage of the requested element count,
 * with the same null results as mem.alloc[T] for a zero count, an overflowing
 * size, and a zero-sized element. The object must reach the platform's
 * zero-filling allocator (checked by the suite, not this program).
 */

// expect-exit: 0

import mem

Slot: struct { key: u64, value: i32, used: bool }

Empty: struct {}

main(): int {
    slots: []Slot = mem.zalloc[Slot](1000)
    defer mem.release[Slot](&slots)
    if slots == null || slots.len != 1000 { return 1 }
    for i: usize in 0 .. slots.len {
        if slots[i].key != 0 || slots[i].value != 0 || slots[i].used { return 2 }
    }
    slots[999].used = true
    if !slots[999].used || slots[0].used { return 3 }

    bytes: []u8 = mem.zalloc[u8](4096)
    defer mem.release[u8](&bytes)
    if bytes == null || bytes.len != 4096 { return 4 }
    bytes[4095] = 7
    if bytes[0] != 0 || bytes[4095] != 7 { return 5 }

    none: []Slot = mem.zalloc[Slot](0)
    if none != null { return 6 }
    huge: []Slot = mem.zalloc[Slot](usize(0x2000000000000001))
    if huge != null { return 7 }
    unit: []Empty = mem.zalloc[Empty](8)
    if unit != null { return 8 }
    return 0
}
