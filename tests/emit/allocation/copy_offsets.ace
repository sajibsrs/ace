/* Large aggregate copies must preserve the loop counter when either side has
 * a nonzero subobject offset.
 */

// expect-exit: 0

Triple: struct {
    first: f64,
    second: f64,
    third: f64,
}

U17: union {
    none,
    bytes: [17]u8,
}

U24: union {
    none,
    triple: Triple,
}

global: const U24 = U24.triple({ first: 7.0, second: 8.0, third: 9.0 })

pair(value: Triple): (int, Triple) {
    return 11, value
}

main(): int {
    bytes: [17]u8 = [u8(3) : 17]
    u17: U17 = U17.bytes(bytes)

    switch u17 {
        U17.bytes(value: [17]u8) {
            if value[0] != 3 || value[16] != 3 {
                return 1
            }
        }
        else {
            return 2
        }
    }

    triple: Triple = { first: 1.0, second: 2.0, third: 3.0 }
    u24: U24 = U24.triple(triple)

    switch u24 {
        U24.triple(value: Triple) {
            if value.first != 1.0 || value.second != 2.0 || value.third != 3.0 {
                return 3
            }
        }
        else {
            return 4
        }
    }

    switch global {
        U24.triple(value: Triple) {
            if value.first != 7.0 || value.second != 8.0 || value.third != 9.0 {
                return 5
            }
        }
        else {
            return 6
        }
    }

    marker: int, copied: Triple = pair(triple)

    if marker != 11 || copied.first != 1.0 || copied.second != 2.0 || copied.third != 3.0 {
        return 7
    }
    return 0
}
