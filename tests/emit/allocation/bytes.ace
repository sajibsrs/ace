/* mem byte-operation runtime coverage. */

// expect-exit: 42

import copy, move, fill, zero, compare from mem

main(): int {
    source_array: [6]u8 = [1, 2, 3, 4, 5, 255]
    target_array: [8]u8 = [9, 9, 9, 9, 9, 9, 77, 88]
    source: []u8 = source_array[0..6]
    target: []u8 = target_array[0..6]
    copy(target, source)

    if compare(target, source) != 0 { return 1 }

    if target_array[6] != 77 || target_array[7] != 88 { return 2 }

    first_five: []u8 = target_array[0..5]
    fill(first_five, 42)

    if target_array[0] != 42 || target_array[4] != 42 || target_array[5] != 255 { return 3 }
    zero(first_five)

    if target_array[0] != 0 || target_array[4] != 0 || target_array[5] != 255 { return 4 }

    overlap: [6]u8 = [1, 2, 3, 4, 5, 6]
    forward_src: []u8 = overlap[0..5]
    forward_dst: []u8 = overlap[1..6]
    move(forward_dst, forward_src)

    if overlap[0] != 1 || overlap[1] != 1 || overlap[5] != 5 { return 5 }

    overlap[0] = 1
    overlap[1] = 2
    overlap[2] = 3
    overlap[3] = 4
    overlap[4] = 5
    overlap[5] = 6
    backward_src: []u8 = overlap[1..6]
    backward_dst: []u8 = overlap[0..5]
    move(backward_dst, backward_src)

    if overlap[0] != 2 || overlap[4] != 6 || overlap[5] != 6 { return 6 }

    empty_src: []u8 = source_array[0..0]
    empty_dst: []u8 = target_array[0..0]
    copy(empty_dst, empty_src)
    move(empty_dst, empty_src)
    fill(empty_dst, 7)
    zero(empty_dst)

    prefix: []u8 = source_array[0..3]
    longer: []u8 = source_array[0..4]

    if compare(prefix, longer) != -1 || compare(longer, prefix) != 1 { return 7 }
    lower: [3]u8 = [1, 2, 254]
    higher: [3]u8 = [1, 2, 255]
    lower_view: []u8 = lower[0..3]
    higher_view: []u8 = higher[0..3]

    if compare(lower_view, higher_view) != -1 || compare(higher_view, lower_view) != 1 { return 8 }
    return 42
}
