/* A user-defined 'specialized' template has no default body: only its exact
 * specializations are callable, and each is an ordinary typed body. */

// expect-exit: 42

count_of[T](v: T): int specialized

count_of[int](v: int): int {
    return 8
}

count_of[f64](v: f64): int {
    return 4
}

main(): int {
    if count_of[int](0) != 8 {
        return 1
    }
    if count_of[f64](0.5) != 4 {
        return 2
    }
    return 42
}
