/* map: the zero value is a usable empty map, set inserts and overwrites past
 * several growths, get and has report presence, unset shifts colliding
 * entries back so every survivor stays reachable, and string, narrow-integer,
 * and bool keys share the same contract.
 */

// expect-exit: 0

import map
import mem

Point: struct { x: int, y: int }

check(ok: bool, code: int): int {
    if ok { return 0 }
    return code
}

main(): int {
    r: int = 0
    err: Error

    // canonical zero: empty, lookups miss, first set allocates
    m: map.Map[int, int] = map.Map[int, int] {}
    r += check(m.len() == 0, 1)
    r += check(!m.has(1), 2)
    value: int, found: bool = m.get(1)
    r += check(value == 0 && !found, 3)
    r += check(!mut m.unset(1), 4)
    err = mut m.set(1, 10)
    r += check(err == null && m.len() == 1 && m.has(1), 5)
    value, found = m.get(1)
    r += check(value == 10 && found, 6)

    // overwrite keeps one entry
    err = mut m.set(1, 11)
    value, found = m.get(1)
    r += check(err == null && m.len() == 1 && value == 11 && found, 7)

    // growth well past the first allocation keeps every entry
    for i: int in 0 .. 5000 {
        err = mut m.set(i * 7 - 300, i)
        r += check(err == null, 8)
    }
    r += check(m.len() == 5000, 9) // key 1 is written twice: i = 43 and the first set
    ok: bool = true
    for i: int in 0 .. 5000 {
        v: int, f: bool = m.get(i * 7 - 300)
        if !f || v != i { ok = false }
    }
    r += check(ok, 10)
    r += check(!m.has(2), 11)

    // unset every other key: survivors stay reachable, removed keys miss
    for i: int in 0 .. 5000 {
        if i % 2 == 0 { r += check(mut m.unset(i * 7 - 300), 12) }
    }
    ok = true
    for i: int in 0 .. 5000 {
        v: int, f: bool = m.get(i * 7 - 300)
        if i % 2 == 0 && f { ok = false }
        if i % 2 == 1 && (!f || v != i) { ok = false }
    }
    r += check(ok, 13)
    r += check(!mut m.unset(-300), 14)

    // reinsert what was removed; everything is present again
    for i: int in 0 .. 5000 {
        if i % 2 == 0 { err = mut m.set(i * 7 - 300, i + 1) }
    }
    ok = true
    for i: int in 0 .. 5000 {
        v: int, f: bool = m.get(i * 7 - 300)
        want: int = i
        if i % 2 == 0 { want = i + 1 }
        if !f || v != want { ok = false }
    }
    r += check(ok, 15)

    // clear keeps storage, drops entries, and the map stays usable
    mut m.clear()
    r += check(m.len() == 0 && !m.has(7 - 300), 16)
    err = mut m.set(5, 50)
    value, found = m.get(5)
    r += check(err == null && value == 50 && found && m.len() == 1, 17)
    mut m.wipe()
    r += check(m.len() == 0, 18)

    // reserve and Map.new size the table once
    err = mut m.reserve(100)
    r += check(err == null && m.len() == 0, 19)
    for i: int in 0 .. 100 { err = mut m.set(i, i) }
    r += check(m.len() == 100, 20)
    mut m.wipe()
    sized: map.Map[int, int]
    sized, err = map.Map[int, int].new(10)
    r += check(err == null && sized.len() == 0, 21)
    mut sized.wipe()
    empty: map.Map[int, int]
    empty, err = map.Map[int, int].new(0)
    r += check(err == null && empty.len() == 0, 22)

    // string keys compare by content and values may be structs
    words: map.Map[string, Point] = map.Map[string, Point] {}
    words_ok: bool = true
    keys: [4]string = ["alpha", "beta", "gamma", "delta"]
    for i: int in 0 .. 4 {
        err = mut words.set(keys[i], Point {
            x = i,
            y = i * i,
        })
    }
    p: Point, seen: bool = words.get("gamma")
    r += check(seen && p.x == 2 && p.y == 4, 23)
    joined: [8]char = ['g', 'a', 'm', 'm', 'a', 0, 0, 0]
    p, seen = words.get(joined[0..5])
    r += check(seen && p.x == 2, 24)
    r += check(!words.has("gamm") && !words.has("gammas") && !words.has(""), 25)
    removed: bool = mut words.unset("beta")
    r += check(removed && !words.has("beta") && words.has("delta"), 26)
    r += check(words.len() == 3, 27)
    mut words.wipe()

    // a full narrow-integer key domain and bool keys
    bytes: map.Map[u8, u16] = map.Map[u8, u16] {}
    for i: int in 0 .. 256 { err = mut bytes.set(u8(i), u16(i * 3)) }
    ok = bytes.len() == 256
    for i: int in 0 .. 256 {
        v: u16, f: bool = bytes.get(u8(i))
        if !f || v != u16(i * 3) { ok = false }
    }
    r += check(ok, 28)
    mut bytes.wipe()
    flags: map.Map[bool, int] = map.Map[bool, int] {}
    err = mut flags.set(true, 1)
    err = mut flags.set(false, 2)
    t: int, tf: bool = flags.get(true)
    f: int, ff: bool = flags.get(false)
    r += check(tf && ff && t == 1 && f == 2 && flags.len() == 2, 29)
    mut flags.wipe()

    // signed and usize keys
    negatives: map.Map[i32, int] = map.Map[i32, int] {}
    err = mut negatives.set(-1, 1)
    err = mut negatives.set(1, 2)
    a: int, af: bool = negatives.get(-1)
    b: int, bf: bool = negatives.get(1)
    r += check(af && bf && a == 1 && b == 2, 30)
    mut negatives.wipe()
    sizes: map.Map[usize, int] = map.Map[usize, int] {}
    err = mut sizes.set(usize(0xFFFFFFFFFFFFFFFF), 9)
    c: int, cf: bool = sizes.get(usize(0xFFFFFFFFFFFFFFFF))
    r += check(cf && c == 9, 31)
    mut sizes.wipe()

    r += check(err == null, 32)
    return r
}
