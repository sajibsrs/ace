/* Contract methods fixture. */

// expect-exit: 42

Circle: struct {
    radius: i32,
}

Shape: contract {
    area(self): i32
    scale(self, k: i32)
}

Metric: contract {
    value(self, k: int): int
}

Circle signs (
    Shape,
    Metric,
)

Circle.area(self): i32 {
    return self.radius * self.radius * 3
}

Circle.scale(self, k: i32) {
    self.radius = self.radius * k
}

Circle.value(self, k: int): int {
    return int(self.radius) + k
}

Circle.value(self, k: f64): f64 {
    return k + 1.0
}

main(): int {
    circle: Circle = Circle { radius = 3 }
    shape: Shape = Shape(&circle)
    metric: Metric = Metric(&circle)
    shape.scale(2)
    circle.scale(1)
    direct: int = circle.value(36)
    measured: int = metric.value(36)
    floating: f64 = circle.value(1.0)

    if direct != 42 { return 1 }

    if int(floating) != 2 { return 2 }
    return measured
}
