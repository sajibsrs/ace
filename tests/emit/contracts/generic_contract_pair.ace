/* Generic contract pair fixture. */

// expect-exit: 42

Value[T]: contract {
    get(self): T
}

Box[T]: struct {
    value: T,
}

Box[T] signs Value[T]

Box[T].get(self): T {
    return self.value
}

main(): int {
    box: Box[int]
    box.value = 42
    value: Value[int] = Value[int](&box)
    return box.get() + value.get() - 42
}
