/* Generics contracts fixture. */

// expect-exit: 42

Point: struct { x: i32 }

Shape: contract {
    area(): i32
    mut scale(k: i32)
}

Point signs Shape

Point.area(): i32 {
    return self.x
}

mut Point.scale(k: i32) {
    self.x = self.x * k
}

bigger[T](a: T, b: T): T {
    if a < b { return b }
    return a
}

main(): int {
    p: Point = Point { x = 21 }
    shape: Shape = Shape(&p)
    mut shape.scale(2)
    return int(bigger[i32](shape.area(), 40))
}
