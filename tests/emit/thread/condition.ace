/* A producer hands 20000 values to the main thread through one slot, each
 * side waiting on a condition until the slot suits it; the sum shows every
 * value arrived once. Then three threads wait for a gate that one wake_all
 * opens; a missed wake would leave a join blocked. */

// expect-exit: 42

import thread

COUNT: const u64 = 20000

Channel: struct { guard: thread.Mutex, changed: thread.Condition, full: bool, value: u64 }

Gate: struct { guard: thread.Mutex, opened: thread.Condition, open: bool, waiting: u64 }

extern "c" produce(argument: *u8): *u8 {
    channel: *Channel = *Channel(argument)
    for value: u64 in 1 .. COUNT + 1 {
        channel.guard.lock()
        for channel.full { channel.changed.wait(&channel.guard) }
        channel.value = value
        channel.full = true
        channel.changed.wake_one()
        channel.guard.unlock()
    }
    return null
}

extern "c" pass(argument: *u8): *u8 {
    gate: *Gate = *Gate(argument)
    gate.guard.lock()
    gate.waiting += 1
    for !gate.open { gate.opened.wait(&gate.guard) }
    gate.guard.unlock()
    return null
}

main(): int {
    channel: Channel = blank(Channel)
    argument: *u8 = *u8(&channel)
    producer: thread.Thread, err: Error = thread.create(produce, argument)
    if err != null { return 1 }
    sum: u64 = 0
    for received: u64 in 0 .. COUNT {
        channel.guard.lock()
        for !channel.full { channel.changed.wait(&channel.guard) }
        sum += channel.value
        channel.full = false
        channel.changed.wake_one()
        channel.guard.unlock()
    }
    result: *u8, jerr: Error = thread.join(producer)
    if jerr != null { return 2 }
    if sum != COUNT * (COUNT + 1) / 2 { return 3 }

    gate: Gate = blank(Gate)
    gate_argument: *u8 = *u8(&gate)
    threads: [3]thread.Thread = [thread.Thread(0) : 3]
    for i: int in 0 .. 3 {
        t: thread.Thread, cerr: Error = thread.create(pass, gate_argument)
        if cerr != null { return 4 }
        threads[i] = t
    }
    ready: bool = false
    for !ready { // open only once all three wait, so one wake must reach them all
        gate.guard.lock()
        ready = gate.waiting == 3
        gate.guard.unlock()
    }
    gate.guard.lock()
    gate.open = true
    gate.opened.wake_all()
    gate.guard.unlock()
    for i: int in 0 .. 3 {
        done: *u8, perr: Error = thread.join(threads[i])
        if perr != null { return 5 }
    }
    return 42
}
