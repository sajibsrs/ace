/* Four threads, released at once by a gate, each add to one shared counter
 * and write a plain result into their own slot; join's synchronization makes
 * the plain writes visible. A lost update would leave the counter short. */

// expect-exit: 42

import atomic
import thread

Slot: struct { gate: *u32, counter: *u64, id: u64, done: u64 }

work(slot: *Slot) {
    for atomic.load_acquire(slot.gate) == 0 {}
    for step: int in 0 .. 200000 {
        atomic.add_relaxed(slot.counter, u64(1))
    }
    slot.done = slot.id * 10
}

main(): int {
    gate: u32 = 0
    counter: u64 = 0
    slots: [4]Slot = blank([4]Slot)
    threads: [4]thread.Thread = [thread.Thread {} : 4]
    for i: int in 0 .. 4 {
        slots[i] = Slot { gate = &gate, counter = &counter, id = u64(i + 1), done = 0 }
        argument: *u8 = *u8(&slots[i])
        t: thread.Thread, err: Error = thread.Thread.create(work, argument)
        if err != null {
            atomic.store_release(&gate, u32(1)) // let the threads already started finish
            return 1
        }
        threads[i] = t
    }
    atomic.store_release(&gate, u32(1))
    for i: int in 0 .. 4 {
        err: Error = threads[i].join()
        if err != null { return 2 }
        if slots[i].done != u64(i + 1) * 10 { return 4 }
    }
    if atomic.load(&counter) != 800000 { return 5 }

    missing: Error = thread.Thread {}.join()
    if missing != thread.JoinErr.not_found { return 6 }
    return 42
}
