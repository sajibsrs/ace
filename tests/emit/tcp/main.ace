/* High-level blocking TCP composition, transfer loops, cleanup, and domains. */

// expect-exit: 0

import mem
import net
import sys
import net/tcp

loopback(port: u16): net.Addr4 {
    return net.Addr4 {
        ip = [127, 0, 0, 1],
        port = port,
    }
}

is_error(err: Error, domain: typeid): bool {
    return err != null && err.domain == domain
}

client(port: u16): int {
    connection: tcp.Conn, err: Error = tcp.connect(loopback(port))
    if err != null { return 1 }

    // Separate sends let receive_all prove retained progress.
    sent: usize, ioerr: Error = tcp.send_all(connection, "pi")
    if ioerr != null || sent != 2 {
        tcp.close(mut connection)
        return 2
    }
    sent, ioerr = tcp.send_all(connection, "ng")
    if ioerr != null || sent != 2 {
        tcp.close(mut connection)
        return 3
    }

    reply_storage: [4]u8 = [0 : 4]
    reply: mut []u8 = mut reply_storage[0..]
    received: usize
    received, ioerr = tcp.receive_all(connection, reply)
    if ioerr != null || received != 4 || !mem.equal(reply_storage, "pong") {
        tcp.close(mut connection)
        return 4
    }
    if tcp.close(mut connection) != null { return 5 }
    return 0
}

eof_client(port: u16): int {
    connection: tcp.Conn, err: Error = tcp.connect(loopback(port))
    if err != null { return 1 }
    sent: usize
    sent, err = tcp.send_all(connection, "ok")
    if err != null || sent != 2 {
        tcp.close(mut connection)
        return 2
    }
    if tcp.close(mut connection) != null { return 3 }
    return 0
}

check_cleanup(): int {
    listener: tcp.Listener, err: Error = tcp.listen(loopback(u16(0)), usize(0x80000000))
    if err == null { return 1 }
    if err.domain != typeid(net.ListenErr) {
        if err.domain == typeid(net.ReuseaddrErr) { return 41 }
        if err.domain == typeid(net.BindErr) { return 42 }
        return 43
    }

    // A failed constructor closed its created fd: the next kernel allocation
    // reuses the lowest available descriptor deterministically in this process.
    first: net.Socket, socket_err: Error = net.socket(net.SocketType.tcp)
    if socket_err != null { return 4 }
    if sys.close(first) != null { return 5 }

    connection: tcp.Conn
    connection, err = tcp.connect(loopback(u16(0)))
    if !is_error(err, typeid(net.ConnectErr)) { return 6 }
    second: net.Socket
    second, socket_err = net.socket(net.SocketType.tcp)
    if socket_err != null || second != first {
        if socket_err == null { sys.close(second) }
        return 7
    }
    if sys.close(second) != null { return 8 }
    return 0
}

main(): int {
    cleanup: int = check_cleanup()
    if cleanup != 0 { return cleanup }

    // An empty send never touches the descriptor.
    count: usize, err: Error = tcp.send_all(tcp.Conn {}, "")
    if count != 0 || err != null { return 12 }

    listener: tcp.Listener
    listener, err = tcp.listen(loopback(u16(0)), usize(8))
    if err != null { return 20 }
    address: net.Addr4
    address, err = tcp.local(listener)
    if err != null || address.port == 0 {
        tcp.close(mut listener)
        return 21
    }
    process: sys.Process, fork_err: Error = sys.fork()
    if fork_err != null || process == -1 {
        tcp.close(mut listener)
        return 22
    }
    if process == 0 { sys.exit(client(address.port)) }

    connection: tcp.Conn, peer: net.Addr4, accept_err: Error = tcp.accept(listener)
    err = accept_err
    if err != null || peer.ip[0] != 127 || peer.port == 0 {
        tcp.close(mut listener)
        return 23
    }
    request_storage: [4]u8 = [0 : 4]
    request: mut []u8 = mut request_storage[0..]
    count, err = tcp.receive_all(connection, request)
    if err != null || count != 4 || !mem.equal(request_storage, "ping") {
        tcp.close(mut connection)
        tcp.close(mut listener)
        return 24
    }
    count, err = tcp.send_all(connection, "pong")
    if err != null || count != 4 {
        tcp.close(mut connection)
        tcp.close(mut listener)
        return 25
    }
    if tcp.close(mut connection) != null {
        tcp.close(mut listener)
        return 26
    }
    status: sys.ProcessStatus, wait_err: Error = sys.wait(process)
    if wait_err != null || !status.exited || status.code != 0 {
        tcp.close(mut listener)
        return 27
    }

    process, fork_err = sys.fork()
    if fork_err != null || process == -1 {
        tcp.close(mut listener)
        return 28
    }
    if process == 0 { sys.exit(eof_client(address.port)) }
    connection, peer, err = tcp.accept(listener)
    if err != null {
        tcp.close(mut listener)
        return 29
    }
    request_storage = [0 : 4]
    count, err = tcp.receive_all(connection, request)
    if count != 2 || err != tcp.ReceiveAllErr.incomplete ||
       !mem.equal(err.message, "connection closed before the requested bytes were received") ||
       !mem.equal(request_storage[0..2], "ok") {
        tcp.close(mut connection)
        tcp.close(mut listener)
        return 30
    }
    tcp.close(mut connection)
    status, wait_err = sys.wait(process)
    if wait_err != null || !status.exited || status.code != 0 {
        tcp.close(mut listener)
        return 31
    }
    if tcp.close(mut listener) != null { return 32 }
    return 0
}
