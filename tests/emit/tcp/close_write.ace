/* close_write ends only the sending half: the peer reads end of stream, and
 * the closing side still receives the peer's reply afterwards.
 */

// expect-exit: 0

import mem
import net
import sys
import net/tcp

loopback(port: u16): net.Addr4 {
    return net.Addr4 {
        ip = [127, 0, 0, 1],
        port = port,
    }
}

client(port: u16): int {
    connection: tcp.Conn, err: Error = tcp.connect(loopback(port))
    if err != null { return 1 }

    request: string = "half"
    sent: usize
    sent, err = tcp.send_all(connection, request)
    if err != null || sent != request.len {
        tcp.close(&connection)
        return 2
    }
    if tcp.close_write(connection) != null {
        tcp.close(&connection)
        return 3
    }

    storage: [4]u8 = [0 : 4]
    reply: []u8 = storage[0..]
    received: usize
    received, err = tcp.receive_all(connection, reply)
    if err != null || received != reply.len || !mem.equal(reply, "done") {
        tcp.close(&connection)
        return 4
    }
    if tcp.close(&connection) != null { return 5 }
    return 0
}

main(): int {
    unconnected: net.Socket, socket_err: Error = net.socket(net.SocketType.tcp)
    if socket_err != null { return 20 }
    refused: Error = net.close_write(unconnected)
    sys.close(unconnected)
    if refused != net.CloseWriteErr.not_connected { return 21 }

    listener: tcp.Listener, err: Error = tcp.listen(loopback(u16(0)), usize(8))
    if err != null { return 10 }
    address: net.Addr4
    address, err = tcp.local(listener)
    if err != null || address.port == 0 {
        tcp.close(&listener)
        return 11
    }

    process: sys.Process, fork_err: Error = sys.fork()
    if fork_err != null || process == -1 {
        tcp.close(&listener)
        return 12
    }
    if process == 0 {
        tcp.close(&listener)
        sys.exit(client(address.port))
    }

    connection: tcp.Conn, peer: net.Addr4, accept_err: Error = tcp.accept(listener)
    if accept_err != null {
        tcp.close(&listener)
        return 13
    }

    storage: [8]u8 = [0 : 8]
    total: usize = 0
    for {
        count: int, receive_err: Error = tcp.receive(connection, storage[total..])
        if receive_err != null || count < 0 {
            tcp.close(&connection)
            tcp.close(&listener)
            return 14
        }
        if count == 0 { break }
        total += usize(count)
    }
    if total != 4 || !mem.equal(storage[0..4], "half") {
        tcp.close(&connection)
        tcp.close(&listener)
        return 15
    }

    sent: usize
    sent, err = tcp.send_all(connection, "done")
    if err != null || sent != 4 {
        tcp.close(&connection)
        tcp.close(&listener)
        return 16
    }

    connection_close: Error = tcp.close(&connection)
    listener_close: Error = tcp.close(&listener)
    status: sys.ProcessStatus, wait_err: Error = sys.wait(process)
    if connection_close != null || listener_close != null || wait_err != null ||
       !status.exited || status.code != 0 {
        return 17
    }
    return 0
}
