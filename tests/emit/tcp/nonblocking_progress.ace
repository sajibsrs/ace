/* Stage 2 nonblocking connect, interest transitions, and buffered progress. */

// expect-exit: 0

import net
import poll
import sys
import net/tcp

loopback(port: u16): net.Addr4 {
    return net.Addr4 {
        ip = [127, 0, 0, 1],
        port = port,
    }
}

wait_one(q: poll.Queue, storage: []poll.Event): (poll.Event, Error) {
    count: usize, err: Error = poll.wait(q, storage, u64(1000000000))
    if err != null || count != 1 {
        zero: poll.Event = poll.Event {
            fd = sys.Fd(0),
            readable = false,
            writable = false,
            error = false,
            hangup = false,
        }
        if err == null { return zero, poll.WaitErr(0) }
        return zero, err
    }
    return storage[0], null
}

is_connected(event: tcp.Event): bool {
    switch event {
        tcp.Event.connected { return true }
        default { return false }
    }
}

sent_count(event: tcp.Event): (usize, bool) {
    switch event {
        tcp.Event.sent(count: usize) { return count, true }
        default { return usize(0), false }
    }
}

client(port: u16): int {
    connection: tcp.Conn, err: Error = tcp.connect_nonblock(loopback(port))
    if err != null { return 1 }
    q: poll.Queue, queue_err: Error = poll.queue()
    if queue_err != null {
        tcp.close(&connection)
        return 2
    }
    if tcp.interest(connection) == tcp.Interest.write {
        if tcp.watch(q, connection) != null {
            tcp.close(&connection)
            sys.close(sys.Fd(q))
            return 3
        }
        zero: poll.Event = poll.Event {
            fd = sys.Fd(0),
            readable = false,
            writable = false,
            error = false,
            hangup = false,
        }
        event_storage: [1]poll.Event = [zero]
        events: []poll.Event = event_storage[0..]
        ready: poll.Event, wait_err: Error = wait_one(q, events)
        if wait_err != null || !ready.writable ||
           !is_connected(tcp.progress_connect(&connection)) ||
           tcp.interest(connection) != tcp.Interest.read {
            tcp.close(&connection)
            sys.close(sys.Fd(q))
            return 4
        }
    }

    request: string = "stage2 echo"
    sent: usize = 0
    for sent < request.len {
        progress: tcp.Event = tcp.progress_send(&connection, request[sent..])
        advanced: bool = false
        switch progress {
            tcp.Event.sent(count: usize) {
                sent += count
                advanced = true
            }
            tcp.Event.none {}
            default { return 5 }
        }
        if !advanced {
            if tcp.watch(q, connection) != null {
                tcp.close(&connection)
                sys.close(sys.Fd(q))
                return 6
            }
            zero: poll.Event = poll.Event {
                fd = sys.Fd(0),
                readable = false,
                writable = false,
                error = false,
                hangup = false,
            }
            event_storage: [1]poll.Event = [zero]
            events: []poll.Event = event_storage[0..]
            ready: poll.Event, wait_err: Error = wait_one(q, events)
            if wait_err != null || !ready.writable {
                tcp.close(&connection)
                sys.close(sys.Fd(q))
                return 7
            }
        }
    }

    storage: [11]u8 = [0 : 11]
    received: usize = 0
    for received < storage.len {
        destination: []u8 = storage[received..]
        progress: tcp.Event = tcp.progress_receive(&connection, destination)
        receive_amount: usize = 0
        receive_advanced: bool = false
        switch progress {
            tcp.Event.data(count: usize) {
                receive_amount = count
                receive_advanced = true
            }
            tcp.Event.none {}
            default { return 7 }
        }
        if receive_advanced {
            received += receive_amount
        } else {
            if tcp.watch(q, connection) != null {
                tcp.close(&connection)
                sys.close(sys.Fd(q))
                return 7
            }
            zero: poll.Event = poll.Event {
                fd = sys.Fd(0),
                readable = false,
                writable = false,
                error = false,
                hangup = false,
            }
            event_storage: [1]poll.Event = [zero]
            events: []poll.Event = event_storage[0..]
            ready: poll.Event, wait_err: Error = wait_one(q, events)
            if wait_err != null || !ready.readable {
                tcp.close(&connection)
                sys.close(sys.Fd(q))
                return 8
            }
        }
    }
    for index: usize in 0 .. storage.len {
        if storage[index] != request[index] { return 50 + int(index) }
    }
    if tcp.close(&connection) != null { return 10 }
    if sys.close(sys.Fd(q)) != null { return 11 }
    return 0
}

main(): int {
    listener: tcp.Listener, err: Error = tcp.listen(loopback(u16(0)), usize(8))
    if err != null { return 10 }
    address: net.Addr4
    address, err = tcp.local(listener)
    if err != null || address.port == 0 {
        tcp.close(&listener)
        return 11
    }
    process: sys.Process, fork_err: Error = sys.fork()
    if fork_err != null || process == -1 {
        tcp.close(&listener)
        return 12
    }
    if process == 0 {
        tcp.close(&listener)
        sys.exit(client(address.port))
    }

    connection: tcp.Conn, peer: net.Addr4, accept_err: Error = tcp.accept_nonblock(listener)
    if accept_err != null {
        tcp.close(&listener)
        return 13
    }
    q: poll.Queue, queue_err: Error = poll.queue()
    if queue_err != null {
        tcp.close(&connection)
        tcp.close(&listener)
        return 14
    }

    storage: [11]u8 = [0 : 11]
    received: usize = 0
    for received < storage.len {
        destination: []u8 = storage[received..]
        progress: tcp.Event = tcp.progress_receive(&connection, destination)
        receive_amount: usize = 0
        receive_advanced: bool = false
        switch progress {
            tcp.Event.data(count: usize) {
                receive_amount = count
                receive_advanced = true
            }
            tcp.Event.none {}
            default { return 15 }
        }
        if receive_advanced {
            received += receive_amount
        } else {
            if tcp.watch(q, connection) != null { return 15 }
            zero: poll.Event = poll.Event {
                fd = sys.Fd(0),
                readable = false,
                writable = false,
                error = false,
                hangup = false,
            }
            event_storage: [1]poll.Event = [zero]
            events: []poll.Event = event_storage[0..]
            ready: poll.Event, wait_err: Error = wait_one(q, events)
            if wait_err != null || !ready.readable { return 16 }
        }
    }

    flushed: usize = 0
    source: []u8 = storage[0..]
    for flushed < source.len {
        send_amount: usize, send_advanced: bool = sent_count(tcp.progress_send(&connection, source[flushed..]))
        if send_advanced {
            flushed += send_amount
        } else {
            if tcp.watch(q, connection) != null { return 17 }
            zero: poll.Event = poll.Event {
                fd = sys.Fd(0),
                readable = false,
                writable = false,
                error = false,
                hangup = false,
            }
            event_storage: [1]poll.Event = [zero]
            events: []poll.Event = event_storage[0..]
            ready: poll.Event, wait_err: Error = wait_one(q, events)
            if wait_err != null || !ready.writable { return 18 }
        }
    }
    if tcp.interest(connection) != tcp.Interest.none { return 19 }

    tcp.close(&connection)
    tcp.close(&listener)
    sys.close(sys.Fd(q))
    status: sys.ProcessStatus, wait_err: Error = sys.wait(process)
    if wait_err != null || !status.exited { return 20 }
    if status.code != 0 { return status.code }

    return 0
}
