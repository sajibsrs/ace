/* expect-exit: 42 */

Pair: struct { first: int, second: int }

main(): int {
    values: [3]Pair
    pointer: mut *Pair = mut &values[0]
    writable: mut []Pair = mut []Pair(pointer, usize(3))
    writable[1].first = 40
    writable[1].second = 2
    plain: []Pair = []Pair(pointer, usize(3))
    empty: []Pair = []Pair(pointer + 3, usize(0))
    zero: []Pair = []Pair(null, usize(0))
    if plain.len != 3 || empty.len != 0 || empty == null || zero != null {
        return 1
    }
    return plain[1].first + plain[1].second
}
