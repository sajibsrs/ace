/* Writable pointer permission levels. */

// expect-exit: 42

Point: struct { x: int }

set_x(point: *Point, value: int) {
    point.x = value
}

retarget(point: **Point, replacement: *Point) {
    *point = replacement
}

modify_and_retarget(point: **Point, replacement: *Point) {
    point.x += 1
    *point = replacement
    point.x += 2
}

main(): int {
    first: Point = Point { x = 1 }
    second: Point = Point { x = 10 }

    /* A writable address may be passed directly; in a call `&first` is
     * one address expression. */
    set_x(&first, 20)

    if first.x != 20 { return 1 }

    writable: *Point = &first
    set_x(writable, 21)

    /* The outer pointer is read-only, but the inner pointer it exposes is
     * writable. Both automatic and explicit dereference honor only the level
     * that performs the final write. */
    read_outer: **Point = &writable
    read_outer.x += 1
    **read_outer = Point { x = 23 }

    if first.x != 23 { return 2 }

    /* Here only the outer level is writable: it may replace the stored
     * read-only pointer without gaining permission to write the Point. */
    readonly: *Point = &first
    write_outer: **Point = &readonly
    *write_outer = &second

    if readonly.x != 10 { return 3 }

    retarget(&readonly, &first)

    if readonly.x != 23 { return 4 }

    replacement: *Point = &second
    modify_and_retarget(&writable, replacement)

    if first.x != 24 { return 5 }

    if writable.x != 12 { return 6 }

    return 42
}
