/* Values of calls that resolve at end of file: forward calls, and calls whose
 * untyped argument waits for the complete overload set. Casts, nested
 * operators, and generic bodies use them at their resolved types, and the
 * end-of-file re-check sees only the declarations the first check saw. */

// expect-exit: 42

pair(a: u64): (u64, int) {
    return a, 1
}

g(a: u64): u64 {
    return a
}

// the single signature materializes 5 as u64
narrow(): int {
    return int(g(5)) + int(g(1) + 1) * 2
}

// typed names under '=' are new against what was declared before
use_pair(): int {
    tree: u64, n: int = pair(5)
    return int(tree) + n
}

// blank(T) stays the builtin although a function named blank follows
zero(): int {
    z: int = blank(int)
    return z + int(later() + 1)
}

f(a: u64): u64 {
    return a
}

// the untyped 5 selects the exact f(int) declared below
pick(): int {
    return int(f(5))
}

Box[T]: struct { v: T }

// a generic body using both kinds of values
get[T](b: Box[T]): int {
    return int(later()) + int(g(5))
}

tree(): int {
    return 100
}

blank(): int {
    return 0
}

later(): u64 {
    return 7
}

f(a: int): u64 {
    return u64(a + 1)
}

main(): int {
    b: Box[int] = Box[int] { v = 1 }
    if narrow() != 9 {
        return 1
    }
    if use_pair() != 6 {
        return 2
    }
    if zero() != 8 {
        return 3
    }
    if pick() != 6 {
        return 4
    }
    if get[int](b) != 12 {
        return 5
    }
    if f(5) + 1 == 7 && tree() == 100 {
        return 42
    }
    return 6
}
