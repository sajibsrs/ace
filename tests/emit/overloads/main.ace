/* Overloads fixture. */

// expect-exit: 42

score(value: int): int {
    return value + 1
}

score(value: string): int {
    return int(value.len)
}

score(value: f64): int {
    return int(value)
}

overload_type(value: i32): int {
    return 1
}

overload_type(value: int): int {
    return 2
}

overload_type(value: f32): int {
    return 4
}

overload_type(value: f64): int {
    return 8
}

touch(value: i32): i32 {
    return value
}

touch(value: *i32): i32 {
    *value += 1
    return *value
}

keep[T](value: T): T {
    return value
}

keep[T](first: T, second: T): T {
    return second
}

main(): int {
    x: i32 = 5
    plain: i32 = touch(x)
    changed: i32 = touch(&x)
    selected: (int): int = score
    return score(40) + score("ace") + score(1.0) + int(plain) +
        int(changed) + selected(1) + keep[int](7) + keep[int](1, 2) +
        overload_type(i32(1)) + overload_type(1) + overload_type(f32(1.0)) + overload_type(1.0) - 40
}
