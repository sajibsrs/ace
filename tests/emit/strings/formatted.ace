/* str.format(destination, format, ...): every fmt.printf conversion written
 * into caller storage, the byte count, and (0, false) when it does not fit.
 */

// expect-exit: 0
// expect-output: FPS 60, hi 7 ff FF 101 10 A 3.14 -0.500000 % end|48|12345|none|18446744073709551615

import fmt
import mem
import str

LABEL: const string = "none"

main(): int {
    buffer: [64]u8 = [0 : 64]
    n: usize, ok: bool = str.format(mut buffer[..], "FPS %d, %s %u %x %X %b %o %c %.2f %f %% end", 60, "hi",
                                    uint(7), uint(255), uint(255), uint(5), uint(8), u8(65), 3.14159, f32(-0.5))

    if !ok { return 1 }
    fmt.printf("%s|%u|", string(buffer[..n]), n)
    count: usize = 12345
    n, ok = str.format(mut buffer[..], "%u|", count)

    if !ok { return 2 }
    fmt.print(string(buffer[..n]))
    n, ok = str.format(mut buffer[..], LABEL)

    if !ok || n != 4 { return 3 }
    fmt.print(string(buffer[..n]))
    fmt.print("|")
    n, ok = str.format(mut buffer[..], "%u", uint(18446744073709551615))

    if !ok { return 4 }
    fmt.print(string(buffer[..n]))
    // a piece that does not fit ends the call, whatever came before it
    small: [4]u8 = [0 : 4]
    n, ok = str.format(mut small[..], "FPS %d", 60)

    if ok || n != 0 { return 5 }
    n, ok = str.format(mut small[..], "%s", "")

    if !ok || n != 0 { return 6 }
    // the value overloads are unaffected
    n, ok = str.format(mut buffer[..], 42)

    if !ok || !mem.equal(buffer[..n], "42") { return 7 }
    return 0
}
