/* str module: search, ordering, caller-storage copy, zero-copy split, and
 * boundary/whitespace trim, across the string and char overload sets.
 */
// expect-exit: 0

import str

main(): int {
    at: usize, ok: bool = str.find("hello world", "world")

    if !ok || at != 6 {
        return 1
    }
    at, ok = str.find("hello", 'l')

    if !ok || at != 2 {
        return 2
    }
    at, ok = str.find("hello", "x")

    if ok || at != 0 {
        return 3
    }
    at, ok = str.find("hello", "")

    if !ok || at != 0 {
        return 4
    }

    if !str.has("hello", "ell") || !str.has("hello", 'o') || str.has("hello", "zep") {
        return 5
    }

    if !str.has("prefix:", "prefix", false) || !str.has("x: suffix", "suffix", true) {
        return 6
    }

    if str.has("pre", "prefix", false) || str.has("text.", "suffix", true) {
        return 7
    }

    if !str.has("anything", "", false) || !str.has("anything", "", true) {
        return 8
    }

    if str.compare("abc", "abd") != -1 || str.compare("b", "a") != 1 ||
       str.compare("abc", "abc") != 0 {
        return 9
    }

    if str.compare("abc", "abcd") != -1 || str.compare("ab", "b") != -1 ||
       str.compare("", "") != 0 || str.compare("A", "a") != -1 {
        return 10
    }
    buf: [8]u8 = [0 : 8]
    dst: []u8 = buf[0..8]

    if !str.copy("hi", mut dst) {
        return 11
    }

    if buf[0] != u8('h') || buf[1] != u8('i') || buf[2] != 0 {
        return 12
    }
    short: [1]u8 = [0 : 1]
    sdst: []u8 = short[0..1]

    if str.copy("hi", mut sdst) {
        return 13
    }

    if short[0] != 0 {
        return 14
    }
    parts: [8]string = ["" : 8]
    sparts: []string = parts[0..8]
    n: usize, done: bool = str.split("a,b,c", ",", mut sparts)

    if !done || n != 3 || parts[0] != "a" || parts[1] != "b" || parts[2] != "c" {
        return 15
    }
    n, done = str.split(",a,,", ",", mut sparts)

    if !done || n != 4 || parts[0] != "" || parts[1] != "a" || parts[2] != "" ||
       parts[3] != "" {
        return 16
    }
    n, done = str.split("no-sep", ",", mut sparts)

    if !done || n != 1 || parts[0] != "no-sep" {
        return 17
    }
    n, done = str.split("", ",", mut sparts)

    if !done || n != 1 || parts[0] != "" {
        return 18
    }
    n, done = str.split("a::b", ":", mut sparts)

    if !done || n != 3 || parts[0] != "a" || parts[1] != "" || parts[2] != "b" {
        return 19
    }
    n, done = str.split("xyz", "", mut sparts)

    if done || n != 0 {
        return 20
    }
    two: [2]string = ["" : 2]
    stwo: []string = two[0..2]
    n, done = str.split("a,b,c", ",", mut stwo)

    if done || n != 2 || two[0] != "a" || two[1] != "b" {
        return 21
    }
    n, done = str.split("aaa", "aa", mut sparts)

    if !done || n != 2 || parts[0] != "" || parts[1] != "a" {
        return 22
    }
    n, done = str.split("1-2-3", '-', mut sparts)

    if !done || n != 3 || parts[1] != "2" {
        return 23
    }
    t: string, hit: bool = str.trim("prefix-value", "prefix-", false)

    if !hit || t != "value" {
        return 24
    }
    t, hit = str.trim("value.suffix", ".suffix", true)

    if !hit || t != "value" {
        return 25
    }
    t, hit = str.trim("other", "prefix-", false)

    if hit || t != "other" {
        return 26
    }
    t, hit = str.trim("anything", "", true)

    if !hit || t != "anything" {
        return 27
    }
    t, hit = str.trim("-x", '-', false)

    if !hit || t != "x" {
        return 28
    }
    t, hit = str.trim("x-", '-', true)

    if !hit || t != "x" {
        return 29
    }

    if str.trim("  \t mixed \n ") != "mixed" || str.trim("   ") != "" ||
       str.trim("") != "" || str.trim("plain") != "plain" {
        return 30
    }
    return 0
}
