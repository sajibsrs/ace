/* str module: search, ordering, caller-storage copy, zero-copy split, and
 * boundary/whitespace trim, across the string and char overload sets.
 */
// expect-exit: 0

import mem
import str

main(): int {
    at: usize, ok: bool = str.find("hello world", "world")

    if !ok || at != 6 {
        return 1
    }
    at, ok = str.find("hello", 'l')

    if !ok || at != 2 {
        return 2
    }
    at, ok = str.find("hello", "x")

    if ok || at != 0 {
        return 3
    }
    at, ok = str.find("hello", "")

    if !ok || at != 0 {
        return 4
    }

    if !str.has("hello", "ell") || !str.has("hello", 'o') || str.has("hello", "zep") {
        return 5
    }

    if !str.has("prefix:", "prefix", false) || !str.has("x: suffix", "suffix", true) {
        return 6
    }

    if str.has("pre", "prefix", false) || str.has("text.", "suffix", true) {
        return 7
    }

    if !str.has("anything", "", false) || !str.has("anything", "", true) {
        return 8
    }

    if str.compare("abc", "abd") != -1 || str.compare("b", "a") != 1 ||
       str.compare("abc", "abc") != 0 {
        return 9
    }

    if str.compare("abc", "abcd") != -1 || str.compare("ab", "b") != -1 ||
       str.compare("", "") != 0 || str.compare("A", "a") != -1 {
        return 10
    }
    buf: [8]u8 = [0 : 8]
    dst: mut []u8 = mut buf[0..8]

    if !str.copy("hi", dst) {
        return 11
    }

    if buf[0] != u8('h') || buf[1] != u8('i') || buf[2] != 0 {
        return 12
    }
    short: [1]u8 = [0 : 1]
    sdst: mut []u8 = mut short[0..1]

    if str.copy("hi", sdst) {
        return 13
    }

    if short[0] != 0 {
        return 14
    }
    concat_parts: [4]string = ["ace", "", " ", "lang"]
    concat_buffer: [12]u8 = [7 : 12]
    concat_count: usize, concat_ok: bool = str.concat(
        concat_parts[..],
        mut concat_buffer[..],
    )
    if !concat_ok || concat_count != 8 ||
       !mem.equal(concat_buffer[..concat_count], "ace lang") ||
       concat_buffer[8] != 7 || concat_buffer[11] != 7 {
        return 101
    }
    concat_short: [3]u8 = [9 : 3]
    concat_count, concat_ok = str.concat(concat_parts[..], mut concat_short[..])
    if concat_ok || concat_count != 0 || concat_short[0] != 9 || concat_short[2] != 9 {
        return 102
    }
    empty_parts: []string = null
    concat_count, concat_ok = str.concat(empty_parts, mut concat_buffer[..])
    if !concat_ok || concat_count != 0 || concat_buffer[0] != u8('a') {
        return 103
    }
    parts: [8]string = ["" : 8]
    sparts: mut []string = mut parts[0..8]
    n: usize, done: bool = str.split("a,b,c", ",", sparts)

    if !done || n != 3 || !mem.equal(parts[0], "a") ||
       !mem.equal(parts[1], "b") || !mem.equal(parts[2], "c") {
        return 15
    }
    n, done = str.split(",a,,", ",", sparts)

    if !done || n != 4 || !mem.equal(parts[0], "") || !mem.equal(parts[1], "a") ||
       !mem.equal(parts[2], "") || !mem.equal(parts[3], "") {
        return 16
    }
    n, done = str.split("no-sep", ",", sparts)

    if !done || n != 1 || !mem.equal(parts[0], "no-sep") {
        return 17
    }
    n, done = str.split("", ",", sparts)

    if !done || n != 1 || !mem.equal(parts[0], "") {
        return 18
    }
    n, done = str.split("a::b", ":", sparts)

    if !done || n != 3 || !mem.equal(parts[0], "a") ||
       !mem.equal(parts[1], "") || !mem.equal(parts[2], "b") {
        return 19
    }
    n, done = str.split("xyz", "", sparts)

    if done || n != 0 {
        return 20
    }
    two: [2]string = ["" : 2]
    stwo: mut []string = mut two[0..2]
    n, done = str.split("a,b,c", ",", stwo)

    if done || n != 2 || !mem.equal(two[0], "a") || !mem.equal(two[1], "b") {
        return 21
    }
    n, done = str.split("aaa", "aa", sparts)

    if !done || n != 2 || !mem.equal(parts[0], "") || !mem.equal(parts[1], "a") {
        return 22
    }
    // a multi-byte separator ending the text leaves the cursor past the last
    // possible match start
    n, done = str.split("ab::", "::", sparts)

    if !done || n != 2 || !mem.equal(parts[0], "ab") || !mem.equal(parts[1], "") {
        return 31
    }
    n, done = str.split("a::b::", "::", sparts)

    if !done || n != 3 || !mem.equal(parts[1], "b") || !mem.equal(parts[2], "") {
        return 32
    }
    n, done = str.split("1-2-3", '-', sparts)

    if !done || n != 3 || !mem.equal(parts[1], "2") {
        return 23
    }
    t: string, hit: bool = str.trim("prefix-value", "prefix-", false)

    if !hit || !mem.equal(t, "value") {
        return 24
    }
    t, hit = str.trim("value.suffix", ".suffix", true)

    if !hit || !mem.equal(t, "value") {
        return 25
    }
    t, hit = str.trim("other", "prefix-", false)

    if hit || !mem.equal(t, "other") {
        return 26
    }
    t, hit = str.trim("anything", "", true)

    if !hit || !mem.equal(t, "anything") {
        return 27
    }
    t, hit = str.trim("-x", '-', false)

    if !hit || !mem.equal(t, "x") {
        return 28
    }
    t, hit = str.trim("x-", '-', true)

    if !hit || !mem.equal(t, "x") {
        return 29
    }

    if !mem.equal(str.trim("  \t mixed \n "), "mixed") ||
       !mem.equal(str.trim("   "), "") || !mem.equal(str.trim(""), "") ||
       !mem.equal(str.trim("plain"), "plain") {
        return 30
    }
    return 0
}
