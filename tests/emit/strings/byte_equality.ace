/* Explicit pairwise mem.equal across arrays, slices, and strings. */

// expect-exit: 42

import mem

left_calls: int
right_calls: int

make_array(): [4]u8 {
    left_calls += 1
    return [65, 99, 101, 0]
}

make_string(): string {
    right_calls += 1
    return "Ace\x00"
}

main(): int {
    first: [4]u8 = [65, 99, 101, 0]
    second: [4]u8 = [65, 99, 101, 0]
    other: [4]u8 = [65, 99, 101, 255]
    longer: [5]u8 = [65, 99, 101, 0, 0]
    first_view: []u8 = first[0..4]
    second_view: []u8 = second[0..4]
    short_view: []u8 = first[0..3]
    text: string = "Ace\x00"
    empty_slice: []u8 = first[0..0]
    zero_slice: []u8 = null
    zero_text: string = null

    if !mem.equal(first, second) || mem.equal(first, other) {
        return 1
    }
    if mem.equal(first, longer) || mem.equal(longer, first) {
        return 2
    }
    if !mem.equal(first, second_view) || !mem.equal(second_view, first) {
        return 3
    }
    if !mem.equal(first, text) || !mem.equal(text, first) {
        return 4
    }
    if !mem.equal(first_view, second_view) || mem.equal(first_view, short_view) {
        return 5
    }
    if !mem.equal(first_view, text) || !mem.equal(text, first_view) {
        return 6
    }
    if !mem.equal(text, "Ace\x00") || mem.equal(text, "Ace\xFF") {
        return 7
    }
    if !mem.equal(other, "Ace\xFF") || !mem.equal("Ace\xFF", other) {
        return 8
    }
    if !mem.equal(empty_slice, zero_slice) || !mem.equal(empty_slice, zero_text) {
        return 9
    }
    if mem.equal(empty_slice, first) || mem.equal(zero_text, first) {
        return 10
    }
    if !mem.equal(make_array(), make_string()) || left_calls != 1 || right_calls != 1 {
        return 11
    }
    return 42
}
