/* Sequence-overlap carve implementation: string slicing, the string([]u8)
 * view conversion, string iteration, inline-type sizeof, and the char alias.
 */
// expect-exit: 0

import mem

greeting: const string = "hello"

sum(text: string): int {
    total: int = 0

    for c: u8 in text {
        total += int(c)
    }
    return total
}

main(): int {
    a: string = greeting[1..4]

    if !mem.equal(a, "ell") {
        return 1
    }

    if !mem.equal(greeting[..2], "he") || !mem.equal(greeting[3..], "lo") ||
       len(greeting[..]) != 5 {
        return 2
    }

    if len(greeting[2..2]) != 0 {
        return 3
    }

    if !mem.equal(greeting[5..], "") {
        return 4
    }

    if !mem.equal(greeting[1..4][1..], "ll") {
        return 5
    }
    arr: [3]u8 = [u8('o'), u8('k'), u8('!')]
    view: string = string(arr[0..3])

    if !mem.equal(view, "ok!") || len(view) != 3 {
        return 6
    }
    arr[0] = u8('n')

    if !mem.equal(view, "nk!") {
        return 7
    }

    if sum(view) != int('n') + int('k') + int('!') {
        return 8
    }
    total: int = 0

    for i: usize, c: char in view {
        total += int(c) + int(i)
    }

    if total != int('n') + int('k') + int('!') + 3 {
        return 9
    }

    if sizeof([]char) != 16 || sizeof([]u8) != 16 || sizeof([3]char) != 3 ||
       sizeof(char) != 1 {
        return 10
    }
    c: char = 'A'
    u: u8 = c

    if u != 65 || c != u {
        return 11
    }

    if !mem.equal("hello"[1..3], "el") {
        return 12
    }
    return 0
}
