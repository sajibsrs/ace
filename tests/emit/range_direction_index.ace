// expect-exit: 42
calls: int = 0

bound(value: i32): i32 {
    calls += 1
    return value
}

main(): int {
    forward: i32 = 0
    for i: i32 in 0 .. 4 {
        forward = forward * 10 + i
        i = 99
    }
    if forward != 123 {
        return 1
    }

    reverse: i32 = 0
    for i: i32 in bound(4) .. bound(0) {
        reverse = reverse * 10 + i
    }
    if reverse != 3210 || calls != 2 {
        return 2
    }

    empty: i32 = 7
    for i: i32 in 2 .. 2 {
        empty = i
    }
    if empty != 7 {
        return 3
    }

    values: [4]i32 = [1, 2, 3, 4]
    indices: usize = 0
    weighted: i32 = 0
    for index: usize, value: i32 in values {
        indices = indices * 10 + index
        weighted += i32(index) * value
        index = 99
        value = 99
    }
    if indices != 123 || weighted != 20 {
        return 4
    }
    if values[0] != 1 || values[3] != 4 {
        return 5
    }

    signed_low: i8 = -128
    signed_high: i8 = -123
    signed_sum: int = 0
    for item: i8 in signed_high .. signed_low {
        signed_sum += int(item)
    }
    if signed_sum != -630 {
        return 6
    }

    cross_low: i8 = -2
    cross_high: i8 = 3
    cross_count: int = 0
    cross_sum: int = 0
    for item: i8 in cross_low .. cross_high {
        cross_count += 1
        cross_sum += int(item)
    }
    if cross_count != 5 || cross_sum != 0 {
        return 9
    }

    unsigned_low: u8 = 250
    unsigned_high: u8 = 255
    unsigned_sum: int = 0
    for item: u8 in unsigned_high .. unsigned_low {
        unsigned_sum += int(item)
    }
    if unsigned_sum != 1260 {
        return 7
    }

    view: []i32 = values[1..4]
    view_score: i32 = 0
    for index: usize, item: i32 in view {
        view_score += i32(index) * 10 + item
    }
    if view_score != 39 {
        return 8
    }
    return 42
}
