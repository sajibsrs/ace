// expect-exit: 0
// expect-output: 01318446744073709551615
import fmt

main(): int {
    message: string = "Ace is pace!\n"
    zero_written: int = fmt.print(usize(0))
    len_written: int = fmt.print(message.len)
    max_written: int = fmt.print(usize(18446744073709551615))
    return zero_written + len_written + max_written - 23
}
