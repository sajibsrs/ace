/* Darwin ioctl wrappers preserve operation identity and immediate errno. */

// expect-exit: 0

import mem
import sys

main(): int {
    no_argument: Error = sys.ioctl(sys.Fd(-1), sys.BIOCPROMISC)
    if no_argument == null || no_argument.domain != typeid(sys.IoctlErr) ||
       no_argument.code != 9 {
        return 1
    }
    value: [4]u8 = [0 : 4]
    with_argument: Error = sys.ioctl(sys.Fd(-1), sys.BIOCGBLEN, mut value[0..4])
    if with_argument == null || with_argument.domain != typeid(sys.IoctlErr) ||
       with_argument.code != 9 {
        return 2
    }
    empty: mut []u8 = mut value[0..0]
    empty_error: Error = sys.ioctl(sys.Fd(-1), sys.BIOCGBLEN, empty)
    if empty_error != sys.IoctlErr.empty ||
       !mem.equal(empty_error.message, "device-control data storage must not be empty") {
        return 3
    }
    return 0
}
