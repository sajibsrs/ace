/* ioctl wrappers preserve operation identity and immediate errno. */

// expect-exit: 0

import mem
import sys

@when(_PLATFORM_ == "darwin-arm64")
NO_ARGUMENT: const uint = sys.BIOCPROMISC

@when(_PLATFORM_ == "darwin-arm64")
WITH_ARGUMENT: const uint = sys.BIOCGBLEN

@when(_PLATFORM_ == "linux-x64")
NO_ARGUMENT: const uint = 0x5451 // FIOCLEX

@when(_PLATFORM_ == "linux-x64")
WITH_ARGUMENT: const uint = 0x541B // FIONREAD

main(): int {
    no_argument: Error = sys.ioctl(sys.Fd(-1), NO_ARGUMENT)
    if no_argument == null || no_argument.domain != typeid(sys.IoctlErr) ||
       no_argument.code != 9 {
        return 1
    }
    value: [4]u8 = [0 : 4]
    with_argument: Error = sys.ioctl(sys.Fd(-1), WITH_ARGUMENT, value[0..4])
    if with_argument == null || with_argument.domain != typeid(sys.IoctlErr) ||
       with_argument.code != 9 {
        return 2
    }
    empty: []u8 = value[0..0]
    empty_error: Error = sys.ioctl(sys.Fd(-1), WITH_ARGUMENT, empty)
    if empty_error != sys.IoctlErr.empty ||
       !mem.equal(empty_error.message, "device-control data storage must not be empty") {
        return 3
    }
    return 0
}
