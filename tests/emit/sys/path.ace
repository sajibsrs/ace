/* Allocation-free path resolution: lstat, canonical, and executable. */

// expect-exit: 42

import sys

DIR_PATH: string = "/tmp/ace_sys_path_directory"
FILE_PATH: string = "/tmp/ace_sys_path_directory/entry"
DOTTED_PATH: string = "/tmp/ace_sys_path_directory/./../ace_sys_path_directory/entry"
// Components resolve in order, as realpath's do, so `..` cannot hide one
// that does not exist.
MISSING_PATH: string = "/tmp/ace_sys_path_directory/missing/../entry"

// A symlink each target always has.
@when(_PLATFORM_ == "darwin-arm64")
LINK_PATH: string = "/tmp"
@when(_PLATFORM_ == "linux-x64")
LINK_PATH: string = "/proc/self/exe"

same(a: []u8, b: []u8): bool {
    if a.len != b.len { return false }
    for i: usize in 0 .. a.len {
        if a[i] != b[i] { return false }
    }
    return true
}

main(): int {
    make_err: Error = sys.mkdir(DIR_PATH)
    if make_err != null && make_err.code != 17 { return 1 }
    fd: sys.Fd, open_err: Error = sys.open(FILE_PATH, sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC, sys.S_IRUSR | sys.S_IWUSR)
    if open_err != null || sys.close(fd) != null { return 2 }

    link_info: sys.FileInfo, link_err: Error = sys.lstat(LINK_PATH)
    if link_err != null || link_info.file_type != sys.FileType.symlink { return 3 }
    target_info: sys.FileInfo, target_err: Error = sys.stat(LINK_PATH)
    if target_err != null || target_info.file_type == sys.FileType.symlink { return 4 }

    plain: [4096]u8 = blank([4096]u8)
    dotted: [4096]u8 = blank([4096]u8)
    n: usize, err: Error = sys.canonical(FILE_PATH, mut plain[0..4096])
    if err != null || n == 0 || plain[0] != '/' { return 5 }
    m: usize, derr: Error = sys.canonical(DOTTED_PATH, mut dotted[0..4096])
    if derr != null || !same(plain[..n], dotted[..m]) { return 6 }

    _, missing_err: Error = sys.canonical(MISSING_PATH, mut dotted[0..4096])
    if missing_err == null || missing_err.domain != typeid(sys.CanonicalErr) { return 7 }

    small: [4]u8 = blank([4]u8)
    _, small_err: Error = sys.canonical(FILE_PATH, mut small[0..4])
    if small_err != sys.CanonicalErr.capacity { return 8 }

    exe: [4096]u8 = blank([4096]u8)
    e: usize, exe_err: Error = sys.executable(mut exe[0..4096])
    if exe_err != null || e == 0 { return 9 }
    exe_info: sys.FileInfo, exe_stat_err: Error = sys.lstat(exe[..e])
    if exe_stat_err != null || exe_info.file_type != sys.FileType.regular { return 10 }
    _, exe_small_err: Error = sys.executable(mut small[0..4])
    if exe_small_err != sys.ExecutableErr.capacity { return 11 }

    if sys.unlink(FILE_PATH) != null { return 12 }
    return 42
}
