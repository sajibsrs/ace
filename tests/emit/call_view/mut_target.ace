/* A leading mut marks the last call of its chain, so a field of an element
 * reached through a mut call result is assigned in one statement; the right
 * side runs first, so growing the array there leaves no stale target.
 */

// expect-exit: 0

import array

P: struct { x: i32, y: i32 }

grow(a: mut *array.Array[P]): i32 {
    i: i32 = 0
    for i < 64 {
        _ = mut a.push(P { x = 9, y = 9 })
        i += 1
    }
    return 7
}

main(): int {
    a: array.Array[P] = array.Array[P] {}
    defer mut a.wipe()
    _ = mut a.push(P { x = 1, y = 2 })
    mut a.view()[0].x = 5
    if a.get(0).x != 5 { return 1 }
    mut a.view()[0].y += 3
    if a.get(0).y != 5 { return 2 }
    mut a.view()[0].x = grow(mut &a)
    if a.get(0).x != 7 || a.len != 65 { return 3 }
    y: i32 = mut a.view()[0].x
    if y != 7 { return 4 }
    return 0
}
