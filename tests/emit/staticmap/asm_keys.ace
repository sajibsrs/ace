// expect-exit: 0

// An asm statement keeps main on the AST emitter, whose lookup must hash a
// narrow signed key sign-extended to 64 bits, as the table was laid out.

small: StaticMap[i16]u32 = { -5: 1, 5: 2, 300: 3, -300: 4, 1: 5, -1: 6, -2: 7, 7: 8, -9: 9, -100: 10 }
wide: StaticMap[i32]u32 = { -70000: 1, 70000: 2, -1: 3 }
bytes: StaticMap[u8]u32 = { 200: 1, 255: 2, 0: 3 }

main(): int {
    asm "nop" {}
    if small[i16(-5)] != 1 || small[i16(5)] != 2 || small[i16(300)] != 3 { return 1 }
    if small[i16(-300)] != 4 || small[i16(-1)] != 6 || small[i16(-2)] != 7 { return 2 }
    if small[i16(-9)] != 9 || small[i16(-100)] != 10 || small[i16(-3)] != 0 { return 3 }
    k: i32 = -5
    if small[i16(k)] != 1 { return 4 }
    if wide[i32(-70000)] != 1 || wide[i32(70000)] != 2 || wide[i32(-1)] != 3 || wide[i32(9)] != 0 { return 5 }
    if bytes[u8(200)] != 1 || bytes[u8(255)] != 2 || bytes[u8(0)] != 3 || bytes[u8(7)] != 0 { return 6 }
    return 0
}
