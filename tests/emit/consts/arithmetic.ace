/* Global initializers fold constant arithmetic at the destination's width:
 * integer + - * / % & | ^ << >> and unary - ~, float + - * / and unary -
 * (f32 rounded after every operation), named const operands, and casts over
 * either, including an int cast to float. Each global equals the same
 * expression evaluated at runtime.
 */

// expect-exit: 0

import fmt

base: const int = 6
mask: const u32 = 1 << 4

prod: const int = 2 * base
quot: const int = -(7 / 2)
rem: const i32 = -7 % 4
bits: const u32 = (mask | 0xF) ^ 0x3
shr: const i32 = -64 >> 3
inv: const u8 = ~u8(0x0F)
wrap: const u8 = u8(1) << 7
pos: int = 10 % 4 * 3

neg: const f64 = 0.0 - 1.0
half: const f64 = f64(2 * base) / 8.0
single: const f32 = 0.1 + 0.2
lit: const f32 = f32(-3)
mixed: const f64 = f64(base) * -2.5
narrow: const f32 = f32(f64(1) / 3.0)

check(ok: bool, code: int): int {
    if ok { return 0 }
    return code
}

main(): int {
    a: int = 6
    f: f32 = 0.1
    g: f32 = 0.2
    third: f64 = 1.0
    third = third / 3.0
    r: int = 0
    r += check(prod == 2 * a, 1)
    r += check(quot == -(7 / 2), 2)
    r += check(rem == -7 % 4, 3)
    r += check(bits == ((u32(16) | 0xF) ^ 0x3), 4)
    r += check(shr == -8, 5)
    r += check(inv == 0xF0, 6)
    r += check(wrap == 128, 7)
    r += check(pos == 6, 8)
    r += check(neg == -1.0, 9)
    r += check(half == 1.5, 10)
    r += check(single == f + g, 11)
    r += check(lit == -3.0, 12)
    r += check(mixed == -15.0, 13)
    r += check(narrow == f32(third), 14)
    return r
}
