/* time — elapsed and awake clocks with runtime advancement checks. */

// expect-exit: 42

import time
import awake from time

/* Harness-only wait: an ordinary process sleep proving the clocks advance
 * while this process sits idle. usleep is not part of the tested surface.
 */
extern "c" {
    c_usleep(micros: u32): i32 = "usleep"
}

wait_us(micros: u32) {
    c_usleep(micros)
}

check_nondecreasing(): int {
    asleep1: u64 = time.elapsed()
    asleep2: u64 = time.elapsed()

    if asleep2 < asleep1 { return 1 }
    awake1: u64 = time.awake()
    awake2: u64 = time.awake()

    if awake2 < awake1 { return 2 }
    return 0
}

check_elapsed_advance(): int {
    before: u64 = time.elapsed()
    wait_us(150_000)
    after: u64 = time.elapsed()
    elapsed: u64 = after - before

    /* The 150 ms wait must move the clock; the bounds stay generous for
     * loaded CI machines. */
    if elapsed < 100_000_000 { return 1 }

    if elapsed > 5_000_000_000 { return 2 }
    return 0
}

check_awake_advance(): int {
    before: u64 = awake()
    wait_us(150_000)
    after: u64 = awake()
    elapsed: u64 = after - before

    /* The 150 ms wait must move the clock; the bounds stay generous for
     * loaded CI machines. */
    if elapsed < 100_000_000 { return 1 }

    if elapsed > 5_000_000_000 { return 2 }
    return 0
}

check_selective(): int {
    start: u64 = awake()
    end: u64 = awake()

    if end < start { return 1 }
    return 0
}

main(): int {
    code: int = check_nondecreasing()

    if code != 0 { return code }
    code = check_elapsed_advance()

    if code != 0 { return 100 + code }
    code = check_awake_advance()

    if code != 0 { return 200 + code }
    code = check_selective()

    if code != 0 { return 300 + code }
    return 42
}
