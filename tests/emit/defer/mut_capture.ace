/*
 * Defer mut-capture fixture: `mut` arguments and `mut` method receivers
 * capture the lvalue address, so the exit-time call reads final storage and
 * its writes stay visible after the function returns.
 */

// expect-exit: 0
// expect-output: address 4
// expect-output: after-return 5
// expect-output: recv-snapshot 1
// expect-output: recv-address 2
// expect-output: recv-write 15

import fmt

seen: int
total: int
gs: int
gm: int

snatch_ref(mut x: int) {
    seen = x
}

bump(mut x: int, by: int) {
    x = x + by
}

Counter: struct { n: int }

Counter.note(): int {
    gs = self.n
    return 0
}

mut Counter.note_mut(): int {
    gm = self.n
    return 0
}

mut Counter.add(by: int) {
    self.n = self.n + by
}

gc: Counter = Counter { n: 0 }

mut_arg(): int {
    v: int = 2
    defer snatch_ref(mut v) // address capture: reads final storage
    defer bump(mut v, 2)    // LIFO: runs first, writes v = 4
    return 0
}

global_mut(): int {
    defer bump(mut total, 5) // the write lands in the caller-visible global
    return total             // returns 0: the write happens at exit
}

recv_snapshot(): int {
    c: Counter = Counter { n: 1 }
    defer c.note() // read-only receiver: snapshot, sees n = 1
    c.n = 2
    return 0
}

recv_address(): int {
    c: Counter = Counter { n: 1 }
    defer mut c.note_mut() // mut receiver: address, sees final n = 2
    c.n = 2
    return 0
}

recv_write(): int {
    defer mut gc.add(10) // mut receiver: the write lands after the return
    gc.n = 5
    return 0
}

main(): int {
    mut_arg()
    fmt.print("address ")
    fmt.println(seen)
    if seen != 4 {
        return 1
    }
    global_mut()
    fmt.print("after-return ")
    fmt.println(total)
    if total != 5 {
        return 2
    }
    recv_snapshot()
    fmt.print("recv-snapshot ")
    fmt.println(gs)
    if gs != 1 {
        return 3
    }
    recv_address()
    fmt.print("recv-address ")
    fmt.println(gm)
    if gm != 2 {
        return 4
    }
    recv_write()
    fmt.print("recv-write ")
    fmt.println(gc.n)
    if gc.n != 15 {
        return 5
    }
    return 0
}
