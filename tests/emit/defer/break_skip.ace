/* Defer break fixture: labeled break does not fire defers. */

// expect-exit: 0
// expect-output: inside
// expect-output: after
// expect-output: at-return

import fmt

work(): int {
    defer fmt.println("at-return")
    outer: {
        fmt.println("inside")
        break outer
    }
    // the function keeps running after the break; the defer waits
    fmt.println("after")
    return 0
}

main(): int {
    if work() != 0 {
        return 1
    }
    return 0
}
