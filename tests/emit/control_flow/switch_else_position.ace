/* Regression: an unmatched scrutinee must dispatch to `else` regardless of
   where `else` sits among the cases, never fall through into whichever case
   happens to be written first. */

// expect-exit: 42

main(): int {
    x: int = 3
    total: int = 0
    switch x {
        1 { total = 1 }
        else { total = 42 }
        2 { total = 2 }
    }
    return total
}
