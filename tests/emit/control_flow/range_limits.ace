/* Range loops that ascend by one with no direction test or trip count (a
 * constant zero start over an unsigned type, or constant endpoints in order)
 * visit the same values as the general lowering, including endpoints at the
 * type limits, empty ranges, and an end evaluated once. Descending, signed,
 * and stepped ranges keep the general lowering. */

// expect-exit: 42

calls: int = 0

count(n: usize): usize {
    calls += 1
    return n
}

Header: struct {
    tag: u8,
    len: u16,
}

// the end lives in a register: no count, step, or frame slot
lean(n: usize): usize {
    s: usize = 0
    for i: usize in 0 .. n {
        s += i
    }
    return s
}

// a constant end within 4095 is a cmp immediate
fixed(): u32 {
    s: u32 = 0
    for i: u32 in 0 .. 4 {
        s = s * 10 + i
    }
    return s
}

limits(): int {
    // unsigned ends at the type maximum
    a: int = 0
    for i: u8 in 250 .. 255 {
        a = a * 10 + int(i - 250)
    }
    if a != 1234 { return 1 }
    b: u64 = 0
    for i: u64 in 0xFFFFFFFFFFFFFFFA .. 0xFFFFFFFFFFFFFFFF {
        b += 0xFFFFFFFFFFFFFFFF - i
    }
    if b != 15 { return 2 }
    // signed ends at both limits
    c: int = 0
    for i: i8 in -128 .. -125 {
        c = c * 10 + int(i) + 129
    }
    if c != 123 { return 3 }
    d: i64 = 0
    for i: i64 in 9223372036854775804 .. 9223372036854775807 {
        d = d * 10 + (i - 9223372036854775803)
    }
    if d != 123 { return 4 }
    e: int = 0
    for i: i32 in 2147483645 .. 2147483647 {
        e = e * 10 + int(i - 2147483644)
    }
    if e != 12 { return 5 }
    // a full u8 range from a variable end
    top: u8 = 255
    f: int = 0
    for i: u8 in 0 .. top {
        f += 1
    }
    if f != 255 { return 6 }
    return 0
}

ends(): int {
    // an end narrowed from a wider value, and one loaded from a u16 field
    wide: u64 = 0x100000003
    g: int = 0
    for i: u32 in 0 .. u32(wide) {
        g = g * 10 + int(i) + 1
    }
    if g != 123 { return 7 }
    h: Header = Header {
        tag = 9,
        len = 5,
    }
    k: int = 0
    for i: u16 in 0 .. h.len {
        k += int(i)
    }
    if k != 10 { return 8 }
    // empty ranges
    z: usize = 0
    m: int = 0
    for i: usize in 0 .. z {
        m += 1
    }
    for i: u8 in 7 .. 7 {
        m += 1
    }
    if m != 0 { return 9 }
    // the end is evaluated once
    calls = 0
    p: usize = 0
    for i: usize in 0 .. count(4) {
        p += i
    }
    if p != 6 || calls != 1 { return 10 }
    return 0
}

general(): int {
    // descending constants, a negative signed end, and explicit steps
    a: int = 0
    for i: u8 in 5 .. 0 {
        a = a * 10 + int(i)
    }
    if a != 43210 { return 11 }
    n: int = -3
    b: int = 0
    for i: int in 0 .. n {
        b = b * 10 - i
    }
    if b != 123 { return 12 }
    c: usize = 0
    for i: usize in 0 .. 5 step 1 {
        c += i
    }
    if c != 10 { return 13 }
    d: usize = 0
    for i: usize in 0 .. 7 step 2 {
        d = d * 10 + i
    }
    if d != 246 { return 14 }
    return 0
}

control(): int {
    // continue runs the increment, break leaves, the binder is a copy
    s: int = 0
    outer: for i: usize in 0 .. 6 {
        if i == 1 { continue }
        for j: usize in 0 .. 3 {
            if j == 2 { break }
            if i == 4 { continue outer }
            s += int(i * 10 + j)
        }
        if i == 5 { break }
        i = 99
    }
    return s // (0+1) + (20+21) + (30+31) + (50+51)
}

main(): int {
    if lean(5) != 10 || lean(0) != 0 { return 20 }
    if fixed() != 123 { return 21 }
    r: int = limits()
    if r != 0 { return r }
    r = ends()
    if r != 0 { return r }
    r = general()
    if r != 0 { return r }
    if control() != 204 { return 22 }
    return 42
}
