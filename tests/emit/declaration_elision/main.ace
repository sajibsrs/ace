// expect-exit: 0

import mem

main(): int {
    integer := 40
    floating := 1.5
    byte := 'A'
    text := "ace"
    storage := mem.alloc(2, 1)
    if storage == null {
        return 1
    }
    storage[0] = 2
    tail := storage[0..1]
    tail[0] += 0
    for i := 0; i < 2; i += 1 {
        integer += i
    }
    ok := floating == 1.5 && byte == u8('A') && text == "ace"
    result := integer + int(tail[0]) - 43
    mem.release(mut storage)
    if !ok || storage != null {
        return 2
    }
    return result
}
