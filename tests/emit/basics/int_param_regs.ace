// expect-exit: 42
// A call-free function reads a by-value struct parameter's 8-byte integer
// leaves from registers when every use is a constant leaf read; a whole-value
// use, a runtime index, a call in the body, a packed or mixed-class leaf, or
// too many leaves keeps the slot.

Small: struct {
    v: usize,
}

Pair: struct {
    a: usize,
    b: usize,
}

Nest: struct {
    inner: Small,
    w: usize,
}

Wide: struct {
    a: usize,
    b: u32,
}

Packed: struct {
    a: u32,
    b: u32,
}

Mix: struct {
    a: usize,
    b: f64,
}

Arr: struct {
    v: [2]usize,
}

// The object's first function label is the section, so it stays a dummy.
first(): usize {
    return 0
}

small_step(s: Small): Small {
    return Small { v = (s.v * 3 + 1) & 0xFFFF }
}

pair_step(p: Pair): Pair {
    return Pair {
        a = (p.a * 3 + p.b) & 0xFFFF,
        b = (p.b + 1) & 0xFFFF,
    }
}

// result registers x0-x1 are the incoming argument registers
swap(p: Pair): Pair {
    return Pair {
        a = p.b,
        b = p.a,
    }
}

second(p: Pair): usize {
    return p.b
}

unused(p: Pair, q: Pair): usize {
    return q.a
}

order(p: Pair): usize {
    return (p.a - 3) / 7 + p.b % 5 + (p.a << 2) - (p.b >> 1)
}

bigger(p: Pair, q: Pair): bool {
    return p.a > q.b && p.b != q.a
}

branchy(p: Pair): usize {
    if p.a > p.b {
        return p.a - p.b
    }
    if p.a == 0 {
        return 100
    }
    return p.b - p.a
}

nested(n: Nest): usize {
    return n.inner.v * 10 + n.w
}

// only the 8-byte leaf is read; the u32 tail never is
wide_a(w: Wide): usize {
    return w.a + 1
}

// reading the u32 leaf keeps the slot
wide_b(w: Wide): usize {
    return w.a + usize(w.b)
}

packed(p: Packed): u32 {
    return p.a + p.b
}

mixed(m: Mix): f64 {
    return f64(m.a) + m.b
}

// a whole-value use keeps the slot; the other parameter still qualifies
pass(p: Pair): Pair {
    return p
}

copy_sum(p: Pair, q: Pair): usize {
    c: Pair = q
    return p.a + c.b
}

// a runtime index needs the array in memory
pick(a: Arr, i: usize): usize {
    return a.v[i]
}

// a homed leaf as an index
lookup(p: Pair): usize {
    t: [4]usize = [10, 20, 30, 40]
    return t[p.a] + t[p.b]
}

// a call clobbers the registers, so a non-leaf keeps its slots
twice(x: usize): usize {
    return x * 2
}

after_call(p: Pair): usize {
    return twice(p.a) + p.b
}

// four parameters exceed the register budget: the last keeps its slot
sum4(a: Pair, b: Pair, c: Pair, d: Pair): usize {
    return a.a + a.b + b.a + b.b + c.a + c.b + d.a * 100 + d.b * 1000
}

// promoted locals and homed leaves share x14 down
in_loop(p: Pair): usize {
    acc: usize = 0
    k: usize = 1
    for i: usize in 0 .. 4 {
        acc = acc + p.a * i + p.b + k
        k = k + 1
    }
    return acc
}

deep(p: Pair): usize {
    return p.a * (p.b + (p.a * (p.b + (p.a * (p.b + (p.a * (p.b + p.a)))))))
}

main(): int {
    s: Small = small_step(Small { v = 5 })
    if s.v != 16 {
        return 1
    }
    p: Pair = pair_step(Pair {
        a = 2,
        b = 7,
    })
    if p.a != 13 || p.b != 8 {
        return 2
    }
    w: Pair = swap(Pair {
        a = 3,
        b = 9,
    })
    if w.a != 9 || w.b != 3 {
        return 3
    }
    if second(Pair {
        a = 1,
        b = 6,
    }) != 6 || unused(Pair {
        a = 1,
        b = 2,
    }, Pair {
        a = 8,
        b = 9,
    }) != 8 {
        return 4
    }
    // (50 - 3) / 7 + 12 % 5 + (50 << 2) - (12 >> 1) = 6 + 2 + 200 - 6
    if order(Pair {
        a = 50,
        b = 12,
    }) != 202 {
        return 5
    }
    if !bigger(Pair {
        a = 5,
        b = 1,
    }, Pair {
        a = 2,
        b = 4,
    }) || bigger(Pair {
        a = 5,
        b = 1,
    }, Pair {
        a = 1,
        b = 4,
    }) {
        return 6
    }
    if branchy(Pair {
        a = 9,
        b = 4,
    }) != 5 || branchy(Pair {
        a = 0,
        b = 4,
    }) != 100 || branchy(Pair {
        a = 2,
        b = 9,
    }) != 7 {
        return 7
    }
    if nested(Nest {
        inner = Small { v = 4 },
        w = 3,
    }) != 43 {
        return 8
    }
    if wide_a(Wide {
        a = 10,
        b = 99,
    }) != 11 || wide_b(Wide {
        a = 10,
        b = 99,
    }) != 109 {
        return 9
    }
    if packed(Packed {
        a = 3,
        b = 4,
    }) != 7 {
        return 10
    }
    if mixed(Mix {
        a = 3,
        b = 0.5,
    }) != 3.5 {
        return 11
    }
    q: Pair = pass(Pair {
        a = 6,
        b = 7,
    })
    if q.a != 6 || q.b != 7 {
        return 12
    }
    if copy_sum(Pair {
        a = 1,
        b = 2,
    }, Pair {
        a = 30,
        b = 40,
    }) != 41 {
        return 13
    }
    arr: Arr = Arr { v = [3, 5] }
    if pick(arr, 0) != 3 || pick(arr, 1) != 5 {
        return 14
    }
    if lookup(Pair {
        a = 1,
        b = 3,
    }) != 60 {
        return 15
    }
    if after_call(Pair {
        a = 4,
        b = 5,
    }) != 13 {
        return 16
    }
    if sum4(Pair {
        a = 1,
        b = 2,
    }, Pair {
        a = 3,
        b = 4,
    }, Pair {
        a = 5,
        b = 6,
    }, Pair {
        a = 7,
        b = 8,
    }) != 21 + 700 + 8000 {
        return 17
    }
    // sum over i in 0..4 of (a*i + b + k), k = 1..4: 3*6 + 4*5 + 10
    if in_loop(Pair {
        a = 3,
        b = 5,
    }) != 18 + 20 + 10 {
        return 18
    }
    if deep(Pair {
        a = 2,
        b = 3,
    }) != 2 * (3 + (2 * (3 + (2 * (3 + (2 * (3 + 2))))))) {
        return 19
    }
    return 42
}
