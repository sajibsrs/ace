/* A float read from a byte offset the scaled imm12 cannot reach falls back to
 * the register-offset form, with the offset materialized in x16. Tuple members
 * past 32 KiB (f64) and 16 KiB (f32) take that path. */

// expect-exit: 42

pair64(): ([5000]f64, f64) {
    a: [5000]f64 = [1.0 : 5000]
    return (a, 2.5)
}

pair32(): ([5000]f32, f32) {
    a: [5000]f32 = [0.25 : 5000]
    return (a, 1.5)
}

main(): int {
    xs: [5000]f64, d: f64 = pair64() // member at 40000, imm12 unit 8
    if d != 2.5 { return 1 }
    if xs[0] != 1.0 || xs[4999] != 1.0 { return 2 }

    ys: [5000]f32, s: f32 = pair32() // member at 20000, imm12 unit 4
    if s != 1.5 { return 3 }
    if ys[0] != 0.25 || ys[4999] != 0.25 { return 4 }
    return 42
}
