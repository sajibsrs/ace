/* math.pow is within 1 ULP over the whole finite domain, exact for representable integer powers, and follows the C99
 * Annex F special cases, for both widths.
 */

// expect-exit: 42

import bits
import math

close64(got: f64, want: u64): bool {
    have: u64 = bits.from_float(got)
    if have > want {
        return have - want <= 1
    }
    return want - have <= 1
}

close32(got: f32, want: u32): bool {
    have: u32 = bits.from_float(got)
    if have > want {
        return have - want <= 1
    }
    return want - have <= 1
}

main(): int {
    infinity: f64 = bits.to_float(u64(0x7FF0000000000000))
    negative_infinity: f64 = bits.to_float(u64(0xFFF0000000000000))
    negative_zero: f64 = bits.to_float(u64(0x8000000000000000))
    quiet_nan: f64 = bits.to_float(u64(0x7FF8000000000000))

    // A zero exponent and a base of 1 win over every other case, a NaN included.
    if bits.from_float(math.pow(quiet_nan, 0.0)) != u64(0x3FF0000000000000) ||
       bits.from_float(math.pow(infinity, negative_zero)) != u64(0x3FF0000000000000) ||
       bits.from_float(math.pow(1.0, quiet_nan)) != u64(0x3FF0000000000000) ||
       bits.from_float(math.pow(-1.0, infinity)) != u64(0x3FF0000000000000) ||
       bits.from_float(math.pow(-1.0, negative_infinity)) != u64(0x3FF0000000000000) {
        return 1
    }
    // A NaN anywhere else propagates; a negative base with a fractional exponent makes one.
    if !math.isnan(math.pow(quiet_nan, 2.0)) || !math.isnan(math.pow(2.0, quiet_nan)) ||
       !math.isnan(math.pow(-2.0, 0.5)) || !math.isnan(math.pow(-0.5, 1.5)) {
        return 2
    }
    // Signed zero bases split on odd integer exponents.
    if bits.from_float(math.pow(negative_zero, -3.0)) != u64(0xFFF0000000000000) ||
       bits.from_float(math.pow(negative_zero, -2.0)) != u64(0x7FF0000000000000) ||
       bits.from_float(math.pow(negative_zero, 3.0)) != u64(0x8000000000000000) ||
       bits.from_float(math.pow(negative_zero, 2.0)) != u64(0) ||
       bits.from_float(math.pow(0.0, -3.0)) != u64(0x7FF0000000000000) ||
       bits.from_float(math.pow(0.0, 3.0)) != u64(0) {
        return 3
    }
    // Infinite bases and exponents are limits, not powers.
    if bits.from_float(math.pow(0.5, infinity)) != u64(0) ||
       bits.from_float(math.pow(0.5, negative_infinity)) != u64(0x7FF0000000000000) ||
       bits.from_float(math.pow(2.0, infinity)) != u64(0x7FF0000000000000) ||
       bits.from_float(math.pow(2.0, negative_infinity)) != u64(0) ||
       bits.from_float(math.pow(negative_infinity, -3.0)) != u64(0x8000000000000000) ||
       bits.from_float(math.pow(negative_infinity, -2.0)) != u64(0) ||
       bits.from_float(math.pow(negative_infinity, 3.0)) != u64(0xFFF0000000000000) ||
       bits.from_float(math.pow(negative_infinity, 2.0)) != u64(0x7FF0000000000000) ||
       bits.from_float(math.pow(infinity, -2.0)) != u64(0) ||
       bits.from_float(math.pow(infinity, 2.0)) != u64(0x7FF0000000000000) {
        return 4
    }
    // Every representable integer power is exact, for either base sign.
    for base: int in 2 .. 21 {
        exact: f64 = 1.0
        for power: int in 0 .. 60 {
            if exact < 9007199254740992.0 {
                negated: f64 = exact
                if power % 2 == 1 {
                    negated = -exact
                }
                if math.pow(f64(base), f64(power)) != exact ||
                   math.pow(-f64(base), f64(power)) != negated {
                    return 5
                }
            }
            exact = exact * f64(base)
        }
    }
    // Ordinary arguments across the exponent range, against platform libm.
    if !close64(math.pow(3.0, 7.2999999999999998), u64(0x40A7C18FEE5E49AC)) ||
       !close64(math.pow(0.5, -13.699999999999999), u64(0x40C9FDF8BCCE533A)) ||
       !close64(math.pow(6.7398165136447767e+284, -0.54907143148602389), u64(0x1F764EA1C483A940)) ||
       !close64(math.pow(7.0000000000000005e-200, -1.5), u64(0x7DF4A3EE7F17699E)) ||
       !close64(math.pow(10.0, 308.0), u64(0x7FE1CCF385EBC8A0)) ||
       !close64(math.pow(2.0, 0.33333333333333331), u64(0x3FF428A2F98D728B)) ||
       !close64(math.pow(-3.0, 7.0), u64(0xC0A1160000000000)) {
        return 6
    }
    // Exponents 2, 1, -1, and 0.5 are exact forms with the Annex F special values intact, for both widths.
    if bits.from_float(math.pow(negative_zero, 0.5)) != u64(0) ||
       bits.from_float(math.pow(negative_infinity, 0.5)) != u64(0x7FF0000000000000) ||
       bits.from_float(math.pow(negative_zero, -0.5)) != u64(0x7FF0000000000000) ||
       bits.from_float(math.pow(negative_infinity, -0.5)) != u64(0) ||
       bits.from_float(math.pow(negative_zero, 1.5)) != u64(0) ||
       bits.from_float(math.pow(negative_infinity, -2.5)) != u64(0) ||
       bits.from_float(math.pow(negative_zero, 0.3)) != u64(0) ||
       bits.from_float(math.pow(negative_infinity, 4503599627370497.5)) != u64(0x7FF0000000000000) ||
       bits.from_float(math.pow(bits.to_float(u32(0x80000000)), f32(0.5))) != u32(0) ||
       bits.from_float(math.pow(-f32(infinity), f32(0.5))) != u32(0x7F800000) ||
       bits.from_float(math.pow(bits.to_float(u32(0x80000000)), f32(-1.5))) != u32(0x7F800000) ||
       !math.isnan(math.pow(-1.0, 0.5)) || !math.isnan(math.pow(-1.0, 1.5)) ||
       !math.isnan(math.pow(f32(-1.0), f32(0.5))) {
        return 16
    }
    if bits.from_float(math.pow(infinity, 0.5)) != u64(0x7FF0000000000000) ||
       bits.from_float(math.pow(0.0, 0.5)) != u64(0) ||
       !math.isnan(math.pow(-4.0, 0.5)) || !math.isnan(math.pow(quiet_nan, 0.5)) ||
       bits.from_float(math.pow(6.25, 0.5)) != u64(0x4004000000000000) ||
       bits.from_float(math.pow(negative_zero, -1.0)) != u64(0xFFF0000000000000) ||
       bits.from_float(math.pow(negative_infinity, -1.0)) != u64(0x8000000000000000) ||
       bits.from_float(math.pow(0.0, -1.0)) != u64(0x7FF0000000000000) ||
       bits.from_float(math.pow(4.0, -1.0)) != u64(0x3FD0000000000000) ||
       bits.from_float(math.pow(bits.to_float(u64(1)), -1.0)) != u64(0x7FF0000000000000) ||
       bits.from_float(math.pow(negative_zero, 2.0)) != u64(0) ||
       bits.from_float(math.pow(negative_infinity, 2.0)) != u64(0x7FF0000000000000) ||
       bits.from_float(math.pow(1.5, 2.0)) != u64(0x4002000000000000) ||
       bits.from_float(math.pow(1.0e200, 2.0)) != u64(0x7FF0000000000000) ||
       bits.from_float(math.pow(negative_zero, 1.0)) != u64(0x8000000000000000) ||
       bits.from_float(math.pow(-3.5, 1.0)) != u64(0xC00C000000000000) ||
       bits.from_float(math.pow(0.1, 2.0)) != bits.from_float(0.1 * 0.1) ||
       bits.from_float(math.pow(0.3, -1.0)) != bits.from_float(1.0 / 0.3) ||
       bits.from_float(math.pow(0.3, 0.5)) != bits.from_float(math.sqrt(0.3)) ||
       !math.isnan(math.pow(f32(-4.0), f32(0.5))) ||
       bits.from_float(math.pow(f32(6.25), f32(0.5))) != u32(0x40200000) ||
       bits.from_float(math.pow(f32(0.0), f32(-1.0))) != u32(0x7F800000) ||
       bits.from_float(math.pow(f32(4.0), f32(-1.0))) != u32(0x3E800000) ||
       bits.from_float(math.pow(f32(-3.5), f32(2.0))) != u32(0x41440000) ||
       bits.from_float(math.pow(f32(-3.5), f32(1.0))) != u32(0xC0600000) ||
       bits.from_float(math.pow(f32(0.3), f32(2.0))) != bits.from_float(f32(0.3) * f32(0.3)) {
        return 15
    }
    // A finite negative base takes the inline path: a fractional exponent is a NaN, an odd integer
    // exponent flips the sign, and exponents past 2^52 are even integers.
    if !close64(math.pow(-2.5, 3.0), u64(0xC02F400000000000)) ||
       !close64(math.pow(-2.5, -3.0), u64(0xBFB0624DD2F1A9FC)) ||
       !close64(math.pow(-2.5, 2.0), u64(0x4019000000000000)) ||
       bits.from_float(math.pow(-2.0, 1.0)) != u64(0xC000000000000000) ||
       bits.from_float(math.pow(-2.0, -1.0)) != u64(0xBFE0000000000000) ||
       bits.from_float(math.pow(-1.0, 4503599627370497.0)) != u64(0xBFF0000000000000) ||
       bits.from_float(math.pow(-1.0, 4503599627370496.0)) != u64(0x3FF0000000000000) ||
       bits.from_float(math.pow(-1.0, 9007199254740993.0)) != u64(0x3FF0000000000000) ||
       !close64(math.pow(-1.0000000000000002, 9.0e15), u64(0x401D824ECC67D8C6)) ||
       !math.isnan(math.pow(-2.0, 0.999999999999)) || !math.isnan(math.pow(-2.0, 2.5)) ||
       !math.isnan(math.pow(-2.0, -4503599627370495.5)) {
        return 14
    }
    // A base within 2^-20 of 1 with an exponent past 2^31 takes the series path.
    if !close64(math.pow(1.0000001000000001, 3000000000.0), u64(0x5AFC05A56D6753A4)) ||
       !close64(math.pow(0.99999998999999995, -2500000000.0), u64(0x4230C3D3D8872ECF)) {
        return 7
    }
    // Underflow stays gradual, and overflow saturates with the right sign.
    if !close64(math.pow(1.5, -1800.0), u64(0x0000000000218862)) ||
       bits.from_float(math.pow(2.0, -1074.0)) != u64(1) ||
       bits.from_float(math.pow(2.0, -1200.0)) != u64(0) ||
       bits.from_float(math.pow(-2.0, -1201.0)) != u64(0x8000000000000000) ||
       bits.from_float(math.pow(10.0, 400.0)) != u64(0x7FF0000000000000) ||
       bits.from_float(math.pow(-10.0, 401.0)) != u64(0xFFF0000000000000) {
        return 8
    }
    // Subnormal and extreme bases, and bases on the edges of the logarithm table's intervals.
    if !close64(math.pow(bits.to_float(u64(1)), 0.5), u64(0x1E60000000000000)) ||
       !close64(math.pow(1.7976931348623157e+308, 1.0), u64(0x7FEFFFFFFFFFFFFF)) ||
       !close64(math.pow(bits.to_float(u64(0x000FFFFFFFFFFFFF)), 0.9), u64(0x0672611186BAE622)) ||
       !close64(math.pow(bits.to_float(u64(0x3FE7100000000000)), 3.7), u64(0x3FD30C9DEC7D51AB)) ||
       !close64(math.pow(bits.to_float(u64(0x3FF70FFFFFFFFFFF)), -2.3), u64(0x3FDB9A9C8CE1807B)) ||
       !close64(math.pow(bits.to_float(u64(0x3FEFFC0000000000)), 1000.5), u64(0x3FE3A17119A09233)) ||
       !close64(math.pow(bits.to_float(u64(0x3FF0000000000001)), 1000000000000000.0), u64(0x3FF3FA60615291EE)) ||
       !close64(math.pow(bits.to_float(u64(0x3FEFFFFFFFFFFFFF)), -1000000000000000.0), u64(0x3FF1E0F39D042FAF)) ||
       !close64(math.pow(10.0, -320.5), u64(0x0000000000000280)) ||
       !close64(math.pow(2.0, 1023.9999999999999), u64(0x7FEFFFFFFFFFFD3A)) ||
       !close64(math.pow(bits.to_float(u64(0x0010000000000000)), -0.99999), u64(0x7FCFC62C58B5C2B4)) ||
       !close64(math.pow(1.0000000000000002, -1.0e+18), u64(0x2BE93C23BAB34B75)) {
        return 11
    }
    // The f32 overload has its own kernel: near-overflow, subnormal, huge-exponent, and exact cases.
    huge: f32 = bits.to_float(u32(0x7F7FFFFF))
    tiny: f32 = bits.to_float(u32(1))
    if bits.from_float(math.pow(f32(2.0), f32(128.0))) != u32(0x7F800000) ||
       bits.from_float(math.pow(f32(2.0), f32(-150.0))) != u32(0) ||
       bits.from_float(math.pow(f32(2.0), f32(-149.0))) != u32(1) ||
       bits.from_float(math.pow(f32(1.0), f32(3.0e38))) != u32(0x3F800000) ||
       bits.from_float(math.pow(f32(1.0000001), f32(3.0e38))) != u32(0x7F800000) ||
       bits.from_float(math.pow(f32(0.99999988), f32(3.0e38))) != u32(0) ||
       bits.from_float(math.pow(huge, f32(1.0))) != u32(0x7F7FFFFF) ||
       bits.from_float(math.pow(tiny, f32(1.0))) != u32(1) ||
       bits.from_float(math.pow(f32(4.0), f32(0.5))) != u32(0x40000000) ||
       bits.from_float(math.pow(f32(0.5), f32(10.0))) != u32(0x3A800000) ||
       bits.from_float(math.pow(f32(-3.0), f32(3.0))) != u32(0xC1D80000) ||
       !math.isnan(math.pow(f32(-3.0), f32(0.5))) {
        return 12
    }
    for base: int in 2 .. 40 {
        exact: f64 = 1.0
        for power: int in 0 .. 60 {
            if exact < 16777216.0 {
                negated: f32 = f32(exact)
                if power % 2 == 1 {
                    negated = -negated
                }
                if math.pow(f32(base), f32(power)) != f32(exact) ||
                   math.pow(-f32(base), f32(power)) != negated {
                    return 13
                }
            }
            exact = exact * f64(base)
        }
    }
    // The f32 overload agrees with the f64 one within 1 ULP.
    if !close32(math.pow(f32(3.0), f32(7.3)), u32(0x453E0C82)) ||
       !close32(math.pow(f32(0.5), f32(-13.7)), u32(0x464FEFC4)) ||
       !close32(math.pow(f32(1.0000001), f32(30000.0)), u32(0x3F807566)) ||
       bits.from_float(math.pow(f32(2.0), f32(10.0))) != u32(0x44800000) ||
       bits.from_float(math.pow(f32(-2.0), f32(3.0))) != u32(0xC1000000) {
        return 9
    }
    // Function values select the same overloads.
    pow64: (f64, f64): f64 = math.pow
    pow32: (f32, f32): f32 = math.pow
    if bits.from_float(pow64(2.0, 10.0)) != u64(0x4090000000000000) ||
       bits.from_float(pow32(f32(2.0), f32(10.0))) != u32(0x44800000) {
        return 10
    }
    return 42
}
