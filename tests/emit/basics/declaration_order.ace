/* Top-level declarations are order-independent within a file: types,
 * aliases, distinct types, enums, unions, constants, globals, functions,
 * specializations, and signings may name declarations written after them,
 * inline or through a pointer, and layouts come out as if declared in order.
 */
// expect-exit: 0
// expect-output: 42

import fmt
import mem

Circle signs Shape

main(): int {
    a: A = A { b = null, arr = [null : 1], pa = null, inl = B { value = 4 } }
    a.b = &a.inl
    if read(&a) != 4 { return 1 }
    if sizeof(A) != 32 { return 2 }
    p: Pair = Pair { key = "k", value = Json.none }
    if p.key.len != 1 || sizeof(Pair) != 40 || sizeof(Json) != 24 { return 3 }
    pairs: mut []Pair = mem.alloc[Pair](2)
    defer mem.release[Pair](mut pairs)
    if pairs.len != 2 { return 9 }
    n: Node = Node { next = null, v = LIMIT, buf = [0 : WIDTH] }
    if n.v != 7 || n.buf.len != 6 { return 4 }
    box: Alias = Box { items = [Id(9) : COUNT] }
    if sizeof(Box) != 24 || u64(box.items[2]) != 9 { return 5 }
    if int(Kind.b) != 1 { return 6 }
    c: Circle = Circle { r = 3 }
    s: Shape = Shape(&c)
    if s.area() != 3 { return 7 }
    if counter != 5 { return 8 }
    op: (int): int = later
    if op(1) != 1 || gen[int](3) != 3 { return 10 }
    if pick[int](1, 2) != 2 || pick[u8](5, 6) != 5 { return 11 }
    cell: Cell = Cell { v = 1 }
    if run(one) + twice(one) + cell.after(one) + Cell.made(one).v != 32 { return 12 }
    sq: Square = Square { side = 2 }
    t: Shape = Shape(&sq)
    if t.area() != 4 { return 13 }
    fmt.printf("%u\n", g(41))
    return 0
}

later(x: int): int {
    return x
}

gen[T](x: T): T {
    return x
}

pick[int](a: int, b: int): int {
    return b
}

pick[T](a: T, b: T): T {
    return a
}

run(f: (int): int): int {
    return f(7)
}

twice(f: (int): int): int {
    return f(7)
}

Cell: struct {
    v: int,
}

Cell.after(self, f: (int): int): int {
    return f(self.v)
}

Cell.made(f: (int): int): Cell {
    return Cell { v = f(1) }
}

one(x: int): int {
    return x * 2
}

Square: struct {
    side: int,
}

Square.area(self): int {
    return self.side * self.side
}

Square signs Shape

g(a: usize): usize {
    return a + 1
}

read(a: *A): int {
    return a.b.value
}

A: struct {
    b: *B,
    arr: [1]*B,
    pa: *[1]B,
    inl: B,
}

B: struct {
    value: int,
}

Json: union {
    none,
    object: []Pair,
}

Pair: struct {
    key: string,
    value: Json,
}

Node: struct {
    next: *Node,
    v: int,
    buf: [WIDTH]u8,
}

Alias: type = Box

Box: struct {
    items: [COUNT]Id,
}

Id: distinct u64

COUNT: const usize = WIDTH / 2
WIDTH: const usize = 6
LIMIT: const int = 7

Kind: enum {
    a,
    b,
}

Shape: contract {
    area(self): int
}

Circle: struct {
    r: int,
}

Circle.area(self): int {
    return self.r
}

counter: int = 5
