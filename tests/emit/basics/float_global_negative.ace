/* Negated float literals fold into global initializers, directly, through a const, and under a float cast. */

// expect-exit: 42

Point: struct { x: f32, y: f32 }
Meters: distinct f32

STEP: const f64 = -0.25

G64: f64 = -2.5
G32: f32 = -1.5
CAST32: f32 = f32(-2.5)
CAST64: f64 = f64(-0.75)
ZERO: f64 = -0.0
FROM_CONST: f64 = STEP
LENGTH: Meters = -3.5
ORIGIN: Point = Point {
    x = -1.0,
    y = 2.0,
}
TABLE: [3]f32 = [-1.0, 0.5, -0.5]

main(): int {
    if bitcast(u64, G64) != u64(0xC004000000000000) { return 1 }
    if bitcast(u32, G32) != u32(0xBFC00000) ||
       bitcast(u32, CAST32) != u32(0xC0200000) {
        return 2
    }
    if bitcast(u64, CAST64) != u64(0xBFE8000000000000) ||
       bitcast(u64, ZERO) != u64(0x8000000000000000) {
        return 3
    }
    if bitcast(u64, FROM_CONST) != u64(0xBFD0000000000000) { return 4 }
    if bitcast(u32, f32(LENGTH)) != u32(0xC0600000) { return 5 }
    if bitcast(u32, ORIGIN.x) != u32(0xBF800000) || bitcast(u32, ORIGIN.y) != u32(0x40000000) { return 6 }
    if bitcast(u32, TABLE[0]) != u32(0xBF800000) || bitcast(u32, TABLE[2]) != u32(0xBF000000) { return 7 }
    return 42
}
