/* Float conversions at their edges: a NaN converts to 0; a float to a 64-bit
 * integer saturates at 64 bits, to a narrower one at 32 bits and then wraps;
 * a u64 at or past 2^63 converts both ways, rounding to nearest even. */

// expect-exit: 0

to_i64(x: f64): i64 { return i64(x) }
to_u64(x: f64): u64 { return u64(x) }
to_i32(x: f64): i32 { return i32(x) }
to_u32(x: f64): u32 { return u32(x) }
to_i8(x: f64): i8 { return i8(x) }
to_u8(x: f64): u8 { return u8(x) }
to_i16(x: f64): i16 { return i16(x) }
to_u16(x: f64): u16 { return u16(x) }
f_u64(x: f32): u64 { return u64(x) }
f_i32(x: f32): i32 { return i32(x) }
f_u32(x: f32): u32 { return u32(x) }
u_f64(x: u64): f64 { return f64(x) }
u_f32(x: u64): f32 { return f32(x) }
i_f64(x: i64): f64 { return f64(x) }
u32_f32(x: u32): f32 { return f32(x) }
narrow(x: f64): f32 { return f32(x) }

main(): int {
    zero: f64 = 0.0
    one: f64 = 1.0
    nan: f64 = zero / zero
    inf: f64 = one / zero
    ninf: f64 = zero - inf
    two63: f64 = 9223372036854775808.0
    two64: f64 = 18446744073709551616.0
    if to_i64(nan) != 0 || to_u64(nan) != 0 || to_i32(nan) != 0 || to_u32(nan) != 0 || to_u8(nan) != 0 || to_i8(nan) != 0 { return 1 }
    if to_i64(inf) != i64(0x7FFFFFFFFFFFFFFF) || to_u64(inf) != u64(0xFFFFFFFFFFFFFFFF) { return 2 }
    if to_i32(inf) != i32(0x7FFFFFFF) || to_u32(inf) != u32(0xFFFFFFFF) || to_i8(inf) != i8(-1) || to_u8(inf) != u8(255) { return 3 }
    if to_i16(inf) != i16(-1) || to_u16(inf) != u16(65535) { return 4 }
    if to_i64(ninf) != i64(-9223372036854775807) - 1 || to_u64(ninf) != 0 || to_i32(ninf) != i32(-2147483647) - 1 { return 5 }
    if to_u32(ninf) != 0 || to_i8(ninf) != 0 || to_i16(ninf) != 0 || to_u8(ninf) != 0 { return 6 }
    if to_i64(two63) != i64(0x7FFFFFFFFFFFFFFF) || to_u64(two63) != u64(0x8000000000000000) { return 7 }
    if to_u64(two64) != u64(0xFFFFFFFFFFFFFFFF) || to_u64(18446744073709549568.0) != u64(18446744073709549568) { return 8 }
    if to_u64(zero - one) != 0 || to_u32(zero - one) != 0 || to_u8(zero - one) != 0 || to_i64(zero - one) != -1 { return 9 }
    if to_u64(zero - 0.5) != 0 || to_i32(zero - 0.5) != 0 { return 10 }
    if to_u32(4294967296.0) != u32(0xFFFFFFFF) || to_i32(4294967296.0) != i32(0x7FFFFFFF) || to_u8(4294967296.0) != u8(255) { return 11 }
    if to_i64(4294967296.0) != 4294967296 || to_i32(3000000000.0) != i32(2147483647) || to_u32(3000000000.0) != u32(3000000000) { return 12 }
    if to_i32(zero - 3000000000.0) != i32(-2147483647) - 1 || to_u32(zero - 3000000000.0) != 0 { return 13 }
    if to_i64(zero - two63) != i64(-9223372036854775807) - 1 { return 14 }
    if to_u8(300.7) != u8(44) || to_i8(300.7) != i8(44) || to_i8(zero - 300.7) != i8(-44) { return 15 }
    if to_u64(1234567.9) != 1234567 || to_i64(zero - 1234567.9) != -1234567 { return 16 }
    fnan: f32 = f32(nan)
    finf: f32 = f32(inf)
    if f_u64(fnan) != 0 || f_i32(fnan) != 0 || f_u32(fnan) != 0 { return 17 }
    if f_u64(finf) != u64(0xFFFFFFFFFFFFFFFF) || f_i32(finf) != i32(0x7FFFFFFF) || f_u32(finf) != u32(0xFFFFFFFF) { return 18 }
    if f_u64(f32(two63)) != u64(0x8000000000000000) || f_u64(f32(3.5)) != 3 || f_u32(f32(3000000000.0)) != u32(3000000000) { return 19 }
    if u_f64(u64(0xFFFFFFFFFFFFFFFF)) != two64 || u_f32(u64(0xFFFFFFFFFFFFFFFF)) != f32(two64) { return 20 }
    if u_f64(u64(0x8000000000000401)) != 9223372036854777856.0 || u_f64(u64(0x8000000000000400)) != two63 { return 21 }
    if u_f64(u64(0x8000000000000C00)) != 9223372036854779904.0 || u_f64(u64(12345)) != 12345.0 { return 22 }
    if u_f32(u64(0x8000008000000000)) != f32(two63) || u_f32(u64(0x8000008000000001)) != f32(9223373136366403584.0) { return 23 }
    if i_f64(i64(-9223372036854775807) - 1) != zero - two63 || u32_f32(u32(0xFFFFFFFF)) != f32(4294967296.0) { return 24 }
    if narrow(1.0e40) != finf || narrow(zero - 1.0e40) != f32(ninf) || f64(narrow(0.1)) == 0.1 { return 25 }
    return 0
}
