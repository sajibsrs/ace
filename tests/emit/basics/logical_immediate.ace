    if (p | 0x80000000) != or32(p, 0x80000000) { bad += 1 }
    if (p ^ 0x80000000) != xor32(p, 0x80000000) { bad += 1 }
    if (p & 0x55555555) != and32(p, 0x55555555) { bad += 1 }
    if (p | 0x55555555) != or32(p, 0x55555555) { bad += 1 }
    if (p ^ 0x55555555) != xor32(p, 0x55555555) { bad += 1 }
