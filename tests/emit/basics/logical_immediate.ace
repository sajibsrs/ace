probe8(p: u8): int {
    bad: int = 0
    if (p & 0x1) != and8(p, 0x1) { bad += 1 }
    if (p | 0x1) != or8(p, 0x1) { bad += 1 }
    if (p ^ 0x1) != xor8(p, 0x1) { bad += 1 }
    if (p & 0x3) != and8(p, 0x3) { bad += 1 }
    if (p | 0x3) != or8(p, 0x3) { bad += 1 }
    if (p ^ 0x3) != xor8(p, 0x3) { bad += 1 }
    if (p & 0xf) != and8(p, 0xf) { bad += 1 }
    if (p | 0xf) != or8(p, 0xf) { bad += 1 }
    if (p ^ 0xf) != xor8(p, 0xf) { bad += 1 }
    if (p & 0x80) != and8(p, 0x80) { bad += 1 }
    if (p | 0x80) != or8(p, 0x80) { bad += 1 }
    if (p ^ 0x80) != xor8(p, 0x80) { bad += 1 }
    if (p & 0xf0) != and8(p, 0xf0) { bad += 1 }
    if (p | 0xf0) != or8(p, 0xf0) { bad += 1 }
    if (p ^ 0xf0) != xor8(p, 0xf0) { bad += 1 }
    if (p & 0x55) != and8(p, 0x55) { bad += 1 }
    if (p | 0x55) != or8(p, 0x55) { bad += 1 }
    if (p ^ 0x55) != xor8(p, 0x55) { bad += 1 }
    if (p & 0xfe) != and8(p, 0xfe) { bad += 1 }
    if (p | 0xfe) != or8(p, 0xfe) { bad += 1 }
    if (p ^ 0xfe) != xor8(p, 0xfe) { bad += 1 }
    if (p & 0x7f) != and8(p, 0x7f) { bad += 1 }
    if (p | 0x7f) != or8(p, 0x7f) { bad += 1 }
    if (p ^ 0x7f) != xor8(p, 0x7f) { bad += 1 }
    if (p & 0x24) != and8(p, 0x24) { bad += 1 }
    if (p | 0x24) != or8(p, 0x24) { bad += 1 }
    if (p ^ 0x24) != xor8(p, 0x24) { bad += 1 }
    return bad
}

main(): int {
    bad: int = 0
    bad += probe64(u64(0x0))
    bad += probe64(u64(0x1))
    bad += probe64(u64(0xffffffffffffffff))
    bad += probe64(u64(0x123456789abcdef0))
    bad += probe64(u64(0x8000000000000000))
    bad += probe64(u64(0xf0f0f0f0f0f0f0f))
    bad += probe64(u64(0xdeadbeefcafef00d))
    bad += probe32(u32(0x0))
    bad += probe32(u32(0x1))
    bad += probe32(u32(0xffffffff))
    bad += probe32(u32(0x12345678))
    bad += probe32(u32(0x80000000))
    bad += probe32(u32(0xf0f0f0f))
    bad += probe32(u32(0xdeadbeef))
    bad += probe8(u8(0x0))
    bad += probe8(u8(0x1))
    bad += probe8(u8(0xff))
    bad += probe8(u8(0x5a))
    bad += probe8(u8(0x80))
    bad += probe8(u8(0xf))
    bad += probe8(u8(0xa5))
    if bad != 0 { return 1 + bad % 200 }
    return 42
}
