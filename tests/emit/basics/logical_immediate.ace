// expect-exit: 42
// Bitwise operators with a constant operand use the bitmask-immediate form
// when it encodes; each result is checked against the register form through
// a helper, for 64-, 32-, and 8-bit operands.

and64(a: u64, b: u64): u64 { return a & b }

or64(a: u64, b: u64): u64 { return a | b }

xor64(a: u64, b: u64): u64 { return a ^ b }

and32(a: u32, b: u32): u32 { return a & b }

or32(a: u32, b: u32): u32 { return a | b }

xor32(a: u32, b: u32): u32 { return a ^ b }

and8(a: u8, b: u8): u8 { return a & b }

or8(a: u8, b: u8): u8 { return a | b }

xor8(a: u8, b: u8): u8 { return a ^ b }

probe64(p: u64): int {
    bad: int = 0
    if (p & 0x1) != and64(p, 0x1) { bad += 1 }
    if (p | 0x1) != or64(p, 0x1) { bad += 1 }
    if (p ^ 0x1) != xor64(p, 0x1) { bad += 1 }
    if (p & 0x3) != and64(p, 0x3) { bad += 1 }
    if (p | 0x3) != or64(p, 0x3) { bad += 1 }
    if (p ^ 0x3) != xor64(p, 0x3) { bad += 1 }
    if (p & 0xff) != and64(p, 0xff) { bad += 1 }
    if (p | 0xff) != or64(p, 0xff) { bad += 1 }
    if (p ^ 0xff) != xor64(p, 0xff) { bad += 1 }
    if (p & 0x7fffffff) != and64(p, 0x7fffffff) { bad += 1 }
    if (p | 0x7fffffff) != or64(p, 0x7fffffff) { bad += 1 }
    if (p ^ 0x7fffffff) != xor64(p, 0x7fffffff) { bad += 1 }
    if (p & 0xffffffff) != and64(p, 0xffffffff) { bad += 1 }
    if (p | 0xffffffff) != or64(p, 0xffffffff) { bad += 1 }
    if (p ^ 0xffffffff) != xor64(p, 0xffffffff) { bad += 1 }
    if (p & 0x8000000000000000) != and64(p, 0x8000000000000000) { bad += 1 }
    if (p | 0x8000000000000000) != or64(p, 0x8000000000000000) { bad += 1 }
    if (p ^ 0x8000000000000000) != xor64(p, 0x8000000000000000) { bad += 1 }
    if (p & 0x5555555555555555) != and64(p, 0x5555555555555555) { bad += 1 }
    if (p | 0x5555555555555555) != or64(p, 0x5555555555555555) { bad += 1 }
    if (p ^ 0x5555555555555555) != xor64(p, 0x5555555555555555) { bad += 1 }
    if (p & 0xaaaaaaaaaaaaaaaa) != and64(p, 0xaaaaaaaaaaaaaaaa) { bad += 1 }
    if (p | 0xaaaaaaaaaaaaaaaa) != or64(p, 0xaaaaaaaaaaaaaaaa) { bad += 1 }
    if (p ^ 0xaaaaaaaaaaaaaaaa) != xor64(p, 0xaaaaaaaaaaaaaaaa) { bad += 1 }
    if (p & 0xf0f0f0f0f0f0f0f0) != and64(p, 0xf0f0f0f0f0f0f0f0) { bad += 1 }
    if (p | 0xf0f0f0f0f0f0f0f0) != or64(p, 0xf0f0f0f0f0f0f0f0) { bad += 1 }
    if (p ^ 0xf0f0f0f0f0f0f0f0) != xor64(p, 0xf0f0f0f0f0f0f0f0) { bad += 1 }
    if (p & 0xff00ff00ff00ff) != and64(p, 0xff00ff00ff00ff) { bad += 1 }
    if (p | 0xff00ff00ff00ff) != or64(p, 0xff00ff00ff00ff) { bad += 1 }
    if (p ^ 0xff00ff00ff00ff) != xor64(p, 0xff00ff00ff00ff) { bad += 1 }
    if (p & 0xffff0000ffff) != and64(p, 0xffff0000ffff) { bad += 1 }
    if (p | 0xffff0000ffff) != or64(p, 0xffff0000ffff) { bad += 1 }
    if (p ^ 0xffff0000ffff) != xor64(p, 0xffff0000ffff) { bad += 1 }
    if (p & 0xfffffffffffffffe) != and64(p, 0xfffffffffffffffe) { bad += 1 }
    if (p | 0xfffffffffffffffe) != or64(p, 0xfffffffffffffffe) { bad += 1 }
    if (p ^ 0xfffffffffffffffe) != xor64(p, 0xfffffffffffffffe) { bad += 1 }
    if (p & 0x7fffffffffffffff) != and64(p, 0x7fffffffffffffff) { bad += 1 }
    if (p | 0x7fffffffffffffff) != or64(p, 0x7fffffffffffffff) { bad += 1 }
    if (p ^ 0x7fffffffffffffff) != xor64(p, 0x7fffffffffffffff) { bad += 1 }
    if (p & 0xffff0000) != and64(p, 0xffff0000) { bad += 1 }
    if (p | 0xffff0000) != or64(p, 0xffff0000) { bad += 1 }
    if (p ^ 0xffff0000) != xor64(p, 0xffff0000) { bad += 1 }
    if (p & 0xff0) != and64(p, 0xff0) { bad += 1 }
    if (p | 0xff0) != or64(p, 0xff0) { bad += 1 }
    if (p ^ 0xff0) != xor64(p, 0xff0) { bad += 1 }
    if (p & 0x123456789) != and64(p, 0x123456789) { bad += 1 }
    if (p | 0x123456789) != or64(p, 0x123456789) { bad += 1 }
    if (p ^ 0x123456789) != xor64(p, 0x123456789) { bad += 1 }
    if (p & 0x12345) != and64(p, 0x12345) { bad += 1 }
    if (p | 0x12345) != or64(p, 0x12345) { bad += 1 }
    if (p ^ 0x12345) != xor64(p, 0x12345) { bad += 1 }
    if (p & 0xc0000000) != and64(p, 0xc0000000) { bad += 1 }
    if (p | 0xc0000000) != or64(p, 0xc0000000) { bad += 1 }
    if (p ^ 0xc0000000) != xor64(p, 0xc0000000) { bad += 1 }
    if (p & 0xffffffff00000000) != and64(p, 0xffffffff00000000) { bad += 1 }
    if (p | 0xffffffff00000000) != or64(p, 0xffffffff00000000) { bad += 1 }
    if (p ^ 0xffffffff00000000) != xor64(p, 0xffffffff00000000) { bad += 1 }
    if (p & 0x3333333333333333) != and64(p, 0x3333333333333333) { bad += 1 }
    if (p | 0x3333333333333333) != or64(p, 0x3333333333333333) { bad += 1 }
    if (p ^ 0x3333333333333333) != xor64(p, 0x3333333333333333) { bad += 1 }
    if (p & 0x8000000000000001) != and64(p, 0x8000000000000001) { bad += 1 }
    if (p | 0x8000000000000001) != or64(p, 0x8000000000000001) { bad += 1 }
    if (p ^ 0x8000000000000001) != xor64(p, 0x8000000000000001) { bad += 1 }
    return bad
}

probe32(p: u32): int {
    bad: int = 0
    if (p & 0x1) != and32(p, 0x1) { bad += 1 }
    if (p | 0x1) != or32(p, 0x1) { bad += 1 }
    if (p ^ 0x1) != xor32(p, 0x1) { bad += 1 }
    if (p & 0x3) != and32(p, 0x3) { bad += 1 }
    if (p | 0x3) != or32(p, 0x3) { bad += 1 }
    if (p ^ 0x3) != xor32(p, 0x3) { bad += 1 }
    if (p & 0xff) != and32(p, 0xff) { bad += 1 }
    if (p | 0xff) != or32(p, 0xff) { bad += 1 }
    if (p ^ 0xff) != xor32(p, 0xff) { bad += 1 }
