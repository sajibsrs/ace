    if (p | 0xaaaaaaaa) != or32(p, 0xaaaaaaaa) { bad += 1 }
    if (p ^ 0xaaaaaaaa) != xor32(p, 0xaaaaaaaa) { bad += 1 }
    if (p & 0xf0f0f0f0) != and32(p, 0xf0f0f0f0) { bad += 1 }
    if (p | 0xf0f0f0f0) != or32(p, 0xf0f0f0f0) { bad += 1 }
    if (p ^ 0xf0f0f0f0) != xor32(p, 0xf0f0f0f0) { bad += 1 }
    if (p & 0xff00ff) != and32(p, 0xff00ff) { bad += 1 }
    if (p | 0xff00ff) != or32(p, 0xff00ff) { bad += 1 }
    if (p ^ 0xff00ff) != xor32(p, 0xff00ff) { bad += 1 }
    if (p & 0xffff) != and32(p, 0xffff) { bad += 1 }
    if (p | 0xffff) != or32(p, 0xffff) { bad += 1 }
    if (p ^ 0xffff) != xor32(p, 0xffff) { bad += 1 }
    if (p & 0xfffffffe) != and32(p, 0xfffffffe) { bad += 1 }
    if (p | 0xfffffffe) != or32(p, 0xfffffffe) { bad += 1 }
    if (p ^ 0xfffffffe) != xor32(p, 0xfffffffe) { bad += 1 }
    if (p & 0xffff0000) != and32(p, 0xffff0000) { bad += 1 }
    if (p | 0xffff0000) != or32(p, 0xffff0000) { bad += 1 }
    if (p ^ 0xffff0000) != xor32(p, 0xffff0000) { bad += 1 }
    if (p & 0x12345) != and32(p, 0x12345) { bad += 1 }
    if (p | 0x12345) != or32(p, 0x12345) { bad += 1 }
    if (p ^ 0x12345) != xor32(p, 0x12345) { bad += 1 }
    if (p & 0xff0) != and32(p, 0xff0) { bad += 1 }
    if (p | 0xff0) != or32(p, 0xff0) { bad += 1 }
    if (p ^ 0xff0) != xor32(p, 0xff0) { bad += 1 }
    if (p & 0xc0000000) != and32(p, 0xc0000000) { bad += 1 }
    if (p | 0xc0000000) != or32(p, 0xc0000000) { bad += 1 }
    if (p ^ 0xc0000000) != xor32(p, 0xc0000000) { bad += 1 }
    if (p & 0x33333333) != and32(p, 0x33333333) { bad += 1 }
    if (p | 0x33333333) != or32(p, 0x33333333) { bad += 1 }
    if (p ^ 0x33333333) != xor32(p, 0x33333333) { bad += 1 }
    if (p & 0x80000001) != and32(p, 0x80000001) { bad += 1 }
    if (p | 0x80000001) != or32(p, 0x80000001) { bad += 1 }
