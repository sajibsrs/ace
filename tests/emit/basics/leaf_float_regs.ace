/*
 * A function that emits no call keeps its float locals in the caller-saved
 * d24-d31, then d8-d15, then slots, and saves no callee-saved register it does
 * not use. A call that expands in place counts as no call; a function that may
 * reach the byte-operation routines, which clobber d24-d31, keeps the
 * callee-saved registers only.
 */

// expect-exit: 42

import mem

Big: struct { a: f64, b: f64, c: f64, d: f64, e: f64 }

half(x: f64): f64 {
    return x * 0.5
}

quarter(x: f64): f64 {
    return half(half(x))
}

// three levels of expansion: the innermost call stays a call
eighth(x: f64): f64 {
    return half(quarter(x))
}

// only expanded calls: call-free, so its locals take d24-d31
leaf_inlined(n: int): f64 {
    a: f64 = 1.0
    b: f64 = 2.0
    c: f64 = 3.0
    for i: int in 0 .. n {
        a += half(b)
        b += half(c) + f64(i)
        c += half(a)
    }
    return a + b + c
}

// an eighth() call leaves one real call, so this function is not call-free
leaf_nested(n: int): f64 {
    t: f64 = 0.0
    u: f64 = 1.0
    for i: int in 0 .. n {
        t += quarter(u)
        u += eighth(t) + f64(i)
    }
    return t + u
}

// more hot float locals than the sixteen registers: the rest keep their slots
fspill(n: int): f64 {
    v0: f64 = 1.0
    v1: f64 = 2.0
    v2: f64 = 3.0
    v3: f64 = 4.0
    v4: f64 = 5.0
    v5: f64 = 6.0
    v6: f64 = 7.0
    v7: f64 = 8.0
    v8: f64 = 9.0
    v9: f64 = 10.0
    v10: f64 = 11.0
    v11: f64 = 12.0
    v12: f64 = 13.0
    v13: f64 = 14.0
    v14: f64 = 15.0
    v15: f64 = 16.0
    v16: f64 = 17.0
    v17: f64 = 18.0
    for i: int in 0 .. n {
        v0 += 1.0
        v1 += v0
        v2 += v1
        v3 += v2
        v4 += v3
        v5 += v4
        v6 += v5
        v7 += v6
        v8 += v7
        v9 += v8
        v10 += v9
        v11 += v10
        v12 += v11
        v13 += v12
        v14 += v13
        v15 += v14
        v16 += v15
        v17 += v16 + f64(i)
    }
    return v17
}

// a large aggregate copy may go through the byte routines
mix(n: int): f64 {
    src: Big = Big { a = 1.0, b = 2.0, c = 3.0, d = 4.0, e = 5.0 }
    dst: Big = src
    x: f64 = 0.5
    y: f64 = 0.25
    for i: int in 0 .. n {
        x += dst.a + dst.e
        y += x
    }
    return y
}

// so may a byte comparison
tally(a: string, b: string, n: int): f64 {
    x: f64 = 0.5
    y: f64 = 0.25
    for i: int in 0 .. n {
        if mem.equal(a, b) {
            x += 1.0
        }
        y += x
    }
    return y
}

main(): int {
    if leaf_inlined(3) != 27.8125 {
        return 1
    }
    if leaf_nested(4) != 9.571999549865723 {
        return 2
    }
    if fspill(3) != 6178.0 {
        return 3
    }
    if mix(3) != 37.75 {
        return 4
    }
    if tally("ab", "ab", 3) != 7.75 {
        return 5
    }
    return 42
}
