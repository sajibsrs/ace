/* A compound untyped constant under a float cast materializes like a plain literal: float math at the target type, integer math as int. */

// expect-exit: 42

Meters: distinct f32

main(): int {
    if bitcast(u32, f32(-1.0)) != u32(0xBF800000) { return 1 }
    if bitcast(u32, f32(0.0 - 1.0)) != u32(0xBF800000) ||
       bitcast(u32, f32(1.0 - 0.5)) != u32(0x3F000000) ||
       bitcast(u32, f32(-1.0 + 2.5)) != u32(0x3FC00000) {
        return 2
    }
    if bitcast(u64, f64(-1.0)) != u64(0xBFF0000000000000) ||
       bitcast(u64, f64(0.0 - 1.5)) != u64(0xBFF8000000000000) {
        return 3
    }
    // Integer constant expressions are evaluated as int, then converted.
    if bitcast(u32, f32(-3)) != u32(0xC0400000) ||
       bitcast(u32, f32(2 * 3)) != u32(0x40C00000) ||
       bitcast(u64, f64(7 / 2)) != u64(0x4008000000000000) {
        return 4
    }
    if bitcast(u32, f32(-1.5)) != u32(0xBFC00000) ||
       bitcast(u32, f32(0.5)) != u32(0x3F000000) ||
       bitcast(u32, f32(3)) != u32(0x40400000) {
        return 5
    }
    length: Meters = Meters(-1.5)
    if bitcast(u32, f32(length)) != u32(0xBFC00000) { return 6 }
    // Float arithmetic runs at the target width, as in a typed declaration.
    third: f32 = 1.0 / 3.0
    if bitcast(u32, f32(1.0 / 3.0)) != bitcast(u32, third) { return 7 }
    return 42
}
