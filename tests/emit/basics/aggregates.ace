/* Aggregates fixture. */

// expect-exit: 42

Point: struct { x: i32, y: i32 }

Big: struct { a: i64, b: i64, c: i64 }

sum_point(p: Point): i32 {
    return p.x + p.y
}

sum_big(b: Big): i64 {
    return b.a + b.b + b.c
}

main(): int {
    p: Point = Point {
        x = 10,
        y = 20,
    }
    q: Point = p
    q.x = 12
    values: [4]i32 = [1, 2, 3, 4]
    middle: []i32 = values[1..3]
    big: Big = Big {
        a = 1,
        b = 2,
        c = 3,
    }
    return int(sum_point(q) + middle[0] + middle[1] + i32(sum_big(big)) - 1)
}
