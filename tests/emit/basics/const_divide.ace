    if x / 16 != x / d16 || x % 16 != x % d16 { return false }
    if x / 25 != x / d25 || x % 25 != x % d25 { return false }
    if x / 60 != x / d60 || x % 60 != x % d60 { return false }
    if x / 64 != x / d64 || x % 64 != x % d64 { return false }
    if x / 100 != x / d100 || x % 100 != x % d100 { return false }
    if x / 127 != x / d127 || x % 127 != x % d127 { return false }
    if x / 128 != x / d128 || x % 128 != x % d128 { return false }
    if x / 200 != x / d200 || x % 200 != x % d200 { return false }
    if x / 255 != x / d255 || x % 255 != x % d255 { return false }
    q: u8 = x
    r: u8 = x
    q /= 7
    r %= 7
    seven: u8 = 7
    return q == x / seven && r == x % seven
}

run_u8(): bool {
    edges: [9]u8 = [0, 1, 2, 3, 5, 6, 97, 254, 255]
    for value: u8 in edges {
        if !check_u8(value) { return false }
    }
    for i: usize in 0 .. 3000 {
        if !check_u8(u8(next() & 0xff)) { return false }
    }
    return true
}

