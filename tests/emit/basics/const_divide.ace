/* Constant-divisor lowering: shifts, masks, and multiply-high reciprocals
 * must match the hardware divide that a runtime divisor still uses, for every
 * integer width and signedness, in `/`, `%`, `/=`, and `%=`.
 */

// expect-exit: 42

TEN: u32 = 10

state: u64 = 88172645463325252

// xorshift64, shifted right by a varying amount to spread magnitudes.
next(): u64 {
    state ^= state << 13
    state ^= state >> 7
    state ^= state << 17
    return state >> (state % 61)
}

check_u8(x: u8): bool {
    d1: u8 = 1
    d2: u8 = 2
    d3: u8 = 3
    d5: u8 = 5
    d6: u8 = 6
    d7: u8 = 7
    d8: u8 = 8
    d10: u8 = 10
    d16: u8 = 16
