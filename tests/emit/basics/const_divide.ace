main(): int {
    code: int = 1
    if !run_u8() { return code }
    code += 1
    if !run_u16() { return code }
    code += 1
    if !run_u32() { return code }
    code += 1
    if !run_u64() { return code }
    code += 1
    if !run_i8() { return code }
    code += 1
    if !run_i16() { return code }
    code += 1
    if !run_i32() { return code }
    code += 1
    if !run_i64() { return code }
    x: u32 = 123456789
    ten: u32 = 10
    if x / TEN != x / ten || x % TEN != x % ten { return 20 }
    return 42
}
