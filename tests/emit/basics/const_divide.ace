// xorshift64, shifted right by a varying amount to spread magnitudes.
next(): u64 {
    state ^= state << 13
    state ^= state >> 7
    state ^= state << 17
    return state >> (state % 61)
}

check_u8(x: u8): bool {
    if x / 1 != x / u8_d1 || x % 1 != x % u8_d1 { return false }
    if x / 2 != x / u8_d2 || x % 2 != x % u8_d2 { return false }
    if x / 3 != x / u8_d3 || x % 3 != x % u8_d3 { return false }
