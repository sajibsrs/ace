    d64: u8 = 64
    d100: u8 = 100
    d127: u8 = 127
    d128: u8 = 128
    d200: u8 = 200
    d255: u8 = 255
    if x / 1 != x / d1 || x % 1 != x % d1 { return false }
    if x / 2 != x / d2 || x % 2 != x % d2 { return false }
    if x / 3 != x / d3 || x % 3 != x % d3 { return false }
    if x / 5 != x / d5 || x % 5 != x % d5 { return false }
