    return q == x / i32_seven && r == x % i32_seven
}

run_i32(): bool {
    edges: [11]i32 = [-2147483648, -2147483647, -2, -1, 0, 1, 2, 3, 97, 2147483646, 2147483647]
    for value: i32 in edges {
        if !check_i32(value) { return false }
    }
    for i: usize in 0 .. 3000 {
        if !check_i32(i32(i64(next() & 0xffffffff) - 2147483648)) { return false }
    }
    return true
}

check_i64(x: i64): bool {
