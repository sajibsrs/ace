    q: u8 = x
    r: u8 = x
    q /= 7
    r %= 7
    return q == x / u8_seven && r == x % u8_seven
}

run_u8(): bool {
    edges: [9]u8 = [0, 1, 2, 3, 5, 6, 97, 254, 255]
    for value: u8 in edges {
