/* Defer LIFO fixture: multiple defers run in reverse order at the exit. */

// expect-exit: 0
// expect-output: third
// expect-output: second
// expect-output: first

import fmt

work(): int {
    defer fmt.println("first")
    defer fmt.println("second")
    defer fmt.println("third")
    return 5
}

main(): int {
    if work() != 5 {
        return 1
    }
    return 0
}
