// expect-exit: 42
Point: struct { x: i32 }

Shape: interface {
    area(): i32
    mut scale(k: i32)
}

point_area(p: *Point): i32 {
    return p.x
}

point_scale(mut p: *Point, k: i32) {
    p.x = p.x * k
}

point_shape: impl(Point, Shape) {
    area: point_area,
    mut scale: point_scale,
}

bigger[T](a: T, b: T): T {
    if a < b {
        return b
    }
    return a
}

main(): int {
    p: Point = Point{ x: 21 }
    shape: Shape = point_shape(&p)
    mut shape.scale(2)
    return int(bigger[i32](shape.area(), 40))
}
