/* `wait` takes blocked signals synchronously. A thread created after main
 * blocks a signal inherits that mask and waits for one sent to it; a forked
 * child waits for one sent to its process.
 */

// expect-exit: 42

import atomic
import signal
import sys
import thread

inherited: u32
received: u32

extern "c" waiter(argument: *u8): *u8 {
    set: signal.Set = blank(signal.Set)
    set.add(signal.SIGUSR1)
    if signal.mask().has(signal.SIGUSR1) { atomic.store_relaxed(&inherited, u32(1)) }
    s: signal.Signal, err: Error = signal.wait(set)
    if err == null { atomic.store_relaxed(&received, u32(i32(s))) }
    return null
}

main(): int {
    set: signal.Set = blank(signal.Set)
    set.add(signal.SIGUSR1)
    set.add(signal.SIGUSR2)
    signal.block(set)

    t: thread.Thread, err: Error = thread.create(waiter, null)
    if err != null { return 1 }
    if signal.send(t, signal.SIGUSR1) != null { return 2 }
    result: *u8, join_err: Error = thread.join(t)
    if join_err != null { return 3 }
    if atomic.load_relaxed(&inherited) != 1 { return 4 }
    if atomic.load_relaxed(&received) != u32(i32(signal.SIGUSR1)) { return 5 }

    child: sys.Process, fork_err: Error = sys.fork()
    if fork_err != null { return 6 }
    if child == sys.Process(0) {
        only: signal.Set = blank(signal.Set)
        only.add(signal.SIGUSR2)
        s: signal.Signal, wait_err: Error = signal.wait(only)
        if wait_err != null { sys.exit(1) }
        sys.exit(int(i32(s)))
    }
    if signal.send(child, signal.SIGUSR2) != null { return 7 }
    status: sys.ProcessStatus, status_err: Error = sys.wait(child)
    if status_err != null || !status.exited || status.code != int(i32(signal.SIGUSR2)) { return 8 }

    s: signal.Signal, empty_err: Error = signal.wait(blank(signal.Set))
    if empty_err != signal.WaitErr.invalid { return 9 }
    return 42
}
