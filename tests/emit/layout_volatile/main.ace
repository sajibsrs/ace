// expect-exit: 0

@packed
Registers: struct { prefix: u32, status: u8, control: u32 }

address_calls: int
value_calls: int

address(pointer: mut *u8): mut *u8 {
    address_calls += 1
    return pointer
}

value(): u8 {
    value_calls += 1
    return 0xa5
}

main(): int {
    registers: Registers = Registers {
        prefix = 0,
        status = 1,
        control = 2,
    }

    if registers.control != 2 { return 4 }

    volatile *(address(mut &registers.status)) = value()
    if address_calls != 1 || value_calls != 1 { return 5 }
    status: u8 = volatile registers.status
    if status != 0xa5 { return 1 }
    if registers.control != 2 { return 2 }

    pointer: mut *u32 = mut &registers.control
    volatile *pointer = 0x11223344
    if volatile *pointer != 0x11223344 { return 3 }
    return 0
}
