Flags: bits u8 { value: 3, signed_value: signed 3, _: 2 }

dynamic_unsigned(): u8 { return 10 }
dynamic_signed(): i8 { return 5 }

main(): int {
    flags: Flags = Flags {}
    flags.value = dynamic_unsigned()
    flags.signed_value = dynamic_signed()
    if flags.value != 2 || flags.signed_value != -3 { return 1 }
    return 0
}
