/* A root declaration named like an imported generic's type parameter
 * (`T`) must not turn that generic into a specialization.
 */

/* expect-exit: 7 */

import mem

T: type = int

main(): int {
    s: mut []u8 = mem.alloc[u8](4)
    defer mem.release[u8](mut s)
    s[0] = 7
    x: T = 7
    if s[0] != 7 { return 1 }
    return x
}
