// Diamond dependency: a and b both import shared; the module (and its
// global) must be loaded and emitted exactly once.
import fmt
import a: "./a.ace"
import b: "./b.ace"
// expect-exit: 0
// expect-output: 9363
main(): int {
    x: int = a.f()
    y: int = b.g()
    fmt.print(x * 100 + y)
    return 0
}
