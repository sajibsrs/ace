import math

pub Kind: enum { square, circle }

pub Box: struct { area: int, floor: int }

pub area(): int {
    return 100
}

/* The imported file shadows its own `math` binding: `math.floor` names the
 * local's field, and `math.sqrt` the module function once the block ends. */
pub inner(): int {
    total: int = 0
    if total == 0 {
        math: Box = Box{area = 0, floor = 3}
        total += math.floor
    }
    return total + int(math.sqrt(16.0))
}
