// expect-exit: 0
import errors: "./error_lib.ace"

main(): int {
    error: Error = errors.fail(2)
    if error.domain != typeid(errors.FileError) || error.code != 2 {
        return 1
    }
    if typeid(errors.FileError) != typeid(errors.Alias) {
        return 2
    }
    if errors.Alias.not_found != error || len(error.name) != 9 ||
       len(error.message) != 14 {
        return 3
    }
    return 0
}
