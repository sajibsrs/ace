// expect-exit: 0

@when(_PLATFORM_ == "never-supported")
import os: "./missing.ace"

@when(_PLATFORM_ == "darwin-arm64")
import os: "./darwin.ace"

@when(_PLATFORM_ == "linux-x64")
import os: "./linux.ace"

@when(not (_PLATFORM_ == "darwin-arm64" or _PLATFORM_ == "linux-x64"))
selected(): int {
    return missing_name
}

@when(_PLATFORM_ == "darwin-arm64" or _PLATFORM_ == "linux-x64")
selected(): int {
    return os.value()
}

main(): int {
    return selected() - 17
}
