/* Union public module fixture. */

// expect-exit: 0

import events: "./events.ace"

main(): int {
    switch events.greeting {
        events.Status.text(text: string) {
            if len(text) != 5 || text[0] != u8(104) || text[4] != u8(111) {
                return 6
            }
        }
        else {
            return 7
        }
    }

    switch events.origin {
        events.Event.cursor(point: events.Point) {
            if point.x != 3 || point.y != 4 {
                return 8
            }
        }
        else {
            return 9
        }
    }
    event: events.Event = events.cursor(10, 20)

    switch event {
        events.Event.cursor(point: events.Point) {
            if point.x + point.y != 30 {
                return 4
            }
        }
        else {
            return 5
        }
    }
    return 0
}
