/* Companion module for the Selective fixture. */

pub Point: struct {
    pub x: int,
    pub y: int,
}

pub Color: enum { red, blue }

pub origin: Point = Point {
    x = 10,
    y = 20,
}

pub score(value: int): int {
    return value + 1
}

pub score(value: usize): int {
    return int(value) + 2
}

pub Thing: struct {
    pub value: int,
}

pub TypeOnly: struct {
    pub value: int,
}

pub ValueOnly(value: int): int {
    return value
}

private_value: int = 7
