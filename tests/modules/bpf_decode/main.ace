/* Deterministic Darwin BPF and Ethernet/IPv4 decoding fixture. */

// expect-exit: 0

import bpf: "../../../demo/darwin-packet-sniffer/packet.ace"

put_native_u16(data: mut []u8, at: usize, value: u16) {
    data[at] = u8(value)
    data[at + 1] = u8(value >> 8)
}

put_native_u32(data: mut []u8, at: usize, value: u32) {
    data[at] = u8(value)
    data[at + 1] = u8(value >> 8)
    data[at + 2] = u8(value >> 16)
    data[at + 3] = u8(value >> 24)
}

put_frame(data: mut []u8, frame: usize, protocol: u8) {
    for i: usize in 0 .. 6 {
        data[frame + i] = u8(0x10 + i)
        data[frame + 6 + i] = u8(0x20 + i)
    }
    data[frame + 12] = 0x08
    data[frame + 13] = 0x00
    data[frame + 14] = 0x45
    data[frame + 16] = 0
    data[frame + 17] = 20
    data[frame + 23] = protocol
    data[frame + 26] = 192
    data[frame + 27] = 0
    data[frame + 28] = 2
    data[frame + 29] = 1
    data[frame + 30] = 198
    data[frame + 31] = 51
    data[frame + 32] = 100
    data[frame + 33] = 9
}

main(): int {
    bytes: [176]u8 = [0 : 176]
    view: mut []u8 = mut bytes[0..176]

    // Native-endian Darwin header: caplen@8, datalen@12, hdrlen@16.
    put_native_u32(view, 8, 34)
    put_native_u32(view, 12, 34)
    put_native_u16(view, 16, 18)
    put_frame(view, 18, 6)
    first: bpf.Record, ok: bool = bpf.decode_record(bytes[0..52], 0)
    if !ok || first.frame_start != 18 || first.captured_length != 34 || first.next != 52 {
        return 1
    }
    tcp: bpf.Packet, tcp_ok: bool = bpf.decode_ipv4(bytes[0..52], first)
    if !tcp_ok || tcp.protocol != 6 || tcp.source_mac[0] != 0x20 ||
       tcp.destination_mac[5] != 0x15 || tcp.source_ip[2] != 2 ||
       tcp.destination_ip[3] != 9 || tcp.captured_length != 34 {
        return 2
    }

    // A 35-byte capture makes total record size 55 and advances to 56.
    put_native_u32(view, 60, 35)
    put_native_u32(view, 64, 35)
    put_native_u16(view, 68, 18)
    put_frame(view, 70, 17)
    second: bpf.Record, second_ok: bool = bpf.decode_record(bytes[0..108], 52)
    if !second_ok || second.frame_start != 70 || second.next != 108 {
        return 3
    }
    udp: bpf.Packet, udp_ok: bool = bpf.decode_ipv4(bytes[0..108], second)
    if !udp_ok || udp.protocol != 17 {
        return 4
    }

    put_native_u32(view, 116, 34)
    put_native_u16(view, 124, 18)
    put_frame(view, 126, 1)
    third: bpf.Record, third_ok: bool = bpf.decode_record(bytes[0..160], 108)
    if !third_ok {
        return 5
    }
    icmp: bpf.Packet, icmp_ok: bool = bpf.decode_ipv4(bytes[0..160], third)
    if !icmp_ok || icmp.protocol != 1 {
        return 6
    }

    ignored: bpf.Record, valid: bool = bpf.decode_record(bytes[0..19], 0)
    if valid {
        return 7
    }
    put_native_u16(view, 16, 17)
    ignored, valid = bpf.decode_record(bytes[0..52], 0)
    if valid {
        return 8
    }
    put_native_u16(view, 16, 18)
    put_native_u32(view, 8, 80)
    ignored, valid = bpf.decode_record(bytes[0..52], 0)
    if valid {
        return 9
    }
    put_native_u32(view, 8, 34)
    first, valid = bpf.decode_record(bytes[0..51], 0)
    if valid {
        return 10
    }

    first, valid = bpf.decode_record(bytes[0..52], 0)
    if !valid {
        return 11
    }

    bytes[30] = 0x86
    bytes[31] = 0xdd
    ignored_packet: bpf.Packet, packet_ok: bool = bpf.decode_ipv4(bytes[0..52], first)
    if packet_ok {
        return 12
    }
    bytes[30] = 0x08
    bytes[31] = 0x00
    bytes[32] = 0x46
    ignored_packet, packet_ok = bpf.decode_ipv4(bytes[0..52], first)
    if packet_ok {
        return 13
    }
    return 0
}
