/* A module that hands out typed allocations through selective mem imports. */

import alloc, release from mem

pub Point: struct { x: i32, y: i32 }

pub make_points(count: usize): mut []Point {
    points: mut []Point = alloc[Point](count)
    return points
}

pub drop_points(mut points: []Point) {
    release[Point](mut points)
}
