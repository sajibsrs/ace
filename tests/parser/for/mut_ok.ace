/* `in mut` iteration: one- and two-binder forms over arrays and slices,
 * labels on mut loops, and a mut loop inside a labeled block. */

adjust(mut n: i32) {
    n += 1
}

main(): int {
    xs: [3]i32 = [1, 2, 3]
    view: []i32 = xs[0..3]

    // one-binder mut over an array and over a slice
    for v: i32 in mut xs {
        v *= 2
    }
    for v: i32 in mut view {
        adjust(mut v)
    }

    // two-binder mut
    for i: usize, v: i32 in mut xs {
        v += i32(i)
    }
    for i: usize, v: i32 in mut view {
        v -= i32(i)
    }

    // labels on mut loops of every binder shape
    outer: for v: i32 in mut xs {
        if v == 2 {
            continue outer
        }
        inner: for w: i32 in mut view {
            if w < 0 {
                break inner
            }
            w = 0
        }
    }
    scan: for i: usize, v: i32 in mut xs {
        if i == 1 {
            break scan
        }
        v = 9
    }

    return 0
}
