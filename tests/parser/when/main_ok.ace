@when(target == "darwin-arm64")
import m: math

@when(true and not false)
Enabled: struct { value: int }

@when((target != "linux-arm64") or false)
chosen(): int {
    return m.max[int](1, 2)
}

@when(false)
discarded(value: Unknown): Unknown {
    return value
}

main(): int {
    return chosen()
}
