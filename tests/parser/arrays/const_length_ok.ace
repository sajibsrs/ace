/* array_type and array_repeat lengths admit the same compile-time constant
 * expression surface as @align(N): identifiers and arithmetic, not only a
 * bare integer literal. */

COUNT: const usize = 3

main(): int {
    values: [COUNT]i32 = [7 : COUNT]
    return int(values[0] + values[1] + values[2]) - 21
}
