/* Function-type parameters may be named, as a declaration writes them; the
   names document and are ignored for identity. A parameter is named. */

Box: struct { n: int }

bump(b: *Box) {
    b.n += 1
}

add(a: int, b: int): int {
    return a + b
}

view(text: *[]u8, bytes: []u8, label: string) {
}

main(): int {
    f: (b: *Box): void = bump
    g: (other: *Box): void = f
    named: (a: int, b: int): int = add
    mixed: (int, b: int): int = named
    plain: (int, int): int = mixed
    v: (text: *[]u8, []u8, label: string): void = view
    return plain(1, 2) - 3
}
