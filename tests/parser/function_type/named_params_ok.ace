/* Function-type parameters may be named, as a declaration writes them; the
   names document and are ignored for identity. A mut parameter is named. */

Box: struct { n: int }

bump(mut b: Box) {
    b.n += 1
}

add(a: int, b: int): int {
    return a + b
}

view(mut text: []u8, bytes: mut []u8, label: mut string) {
}

main(): int {
    f: (mut b: Box): void = bump
    g: (mut other: Box): void = f
    named: (a: int, b: int): int = add
    mixed: (int, b: int): int = named
    plain: (int, int): int = mixed
    v: (mut text: []u8, mut []u8, label: mut string): void = view
    return plain(1, 2) - 3
}
