// lib_a and lib_b hint different [[link]] paths for one library; the
// build refuses to pick one (Package System #14) and names both, whether or
// not either directory exists, until the root gives its own path.
// expect-build-err: path '/opt/ace-hint-b' conflicts with

name: link_path_hint_conflict
version: 0.1.0
ace: 0.1
type: exe
root: src/main.ace

[dependencies]
lib_a: 0.1.0
lib_b: 0.1.0
