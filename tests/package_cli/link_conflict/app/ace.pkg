// lib_a and lib_b each vendor their own "shared.a" at a different path;
// same file name, different path, so `pkg build` must
// fail at the link-collection stage (Package System #14) rather than
// silently picking one or merging them. Checking alone (`pkg check`) never
// reaches this, since it never links.
// expect-build-err: conflicts with

name: link_conflict
version: 0.1.0
ace: 0.1
type: exe
root: src/main.ace

[dependency]
lib_a: 0.1.0
lib_b: 0.1.0
