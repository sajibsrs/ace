/* Checked bounds: dynamic array/slice/string reads and writes remain valid. */

array_read(values: [4]i32, index: i32): i32 {
    return values[index]
}

array_write(values: *[4]i32, index: i32, value: i32) {
    (*values)[index] = value
}

slice_read(values: []i32, index: i32): i32 {
    return values[index]
}

slice_write(values: []i32, index: i32, value: i32) {
    values[index] = value
}

string_read(text: string, index: i32): u8 {
    return text[index]
}

string_write(text: string, index: i32, value: u8) {
    text[index] = value
}

main(): int {
    values: [4]i32 = [10, 20, 30, 40]
    array_write(&values, 2, 31)
    view: []i32 = values[0..4]
    slice_write(view, 1, 21)
    bytes: [4]u8 = ['a', 'b', 'c', 'd']
    text: string = bytes[0..4]
    string_write(text, 3, 'D')
    if array_read(values, 2) != 31 || slice_read(view, 1) != 21 ||
       string_read(text, 3) != 'D' {
        return 1
    }
    return 0
}
