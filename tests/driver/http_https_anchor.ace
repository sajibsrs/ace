import http
import net
import sys

// expect-exit: 0

main(): int {
    anchor: [4096]u8
    fd: sys.Fd, open_err: Error = sys.open(
        "vendor/bearssl/isrg-root-x1.der", sys.O_RDONLY)
    if open_err != null { return 1 }
    count: int, read_err: Error = sys.read(fd, mut anchor[..])
    close_err: Error = sys.close(fd)
    if read_err != null || close_err != null || count <= 0 { return 2 }

    addresses: [4]net.Addr4
    output: [2048]u8
    target: [1024]u8
    input: [131072]u8
    headers: [64]http.Header
    body: [131072]u8
    tls_context: [12000]u8
    tls_records: [16709]u8
    storage: http.Storage = http.Storage {
        addresses = mut addresses[..],
        output = mut output[..],
        target = mut target[..],
        input = mut input[..],
        headers = mut headers[..],
        body = mut body[..],
        tls_context = mut tls_context[..],
        tls_records = mut tls_records[..],
    }
    client: http.Client = http.client_new()
    client.tls = http.TlsConfig {
        trust_anchor = anchor[..usize(count)],
    }
    response: http.Response, err: Error = http.get(
        "https://example.org/", mut client)
    http.client_wipe(mut client)
    if err != null { return 3 }
    if response.status != 200 { return 4 }
    return 0
}
