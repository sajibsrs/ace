/* Pinned BearSSL 0.6 opaque-adapter ABI proof. */

// expect-exit: 0

import mem

extern "c" {
    ace_bearssl_client_size(): usize
    ace_bearssl_client_align(): usize
    ace_bearssl_record_buffer_size(): usize
    ace_bearssl_version_min(): u32
    ace_bearssl_version_max(): u32
    ace_bearssl_client_init(
        storage: mut *u8, record_buffer: mut *u8,
        record_buffer_len: usize, entropy: *u8,
        entropy_len: usize): i32
    ace_bearssl_client_random(storage: mut *u8, output: mut *u8, output_len: usize): i32
    ace_bearssl_system_rng_disabled(storage: *u8): i32
    ace_bearssl_client_state(storage: *u8): u32
    ace_bearssl_client_error(storage: *u8): i32
}

main(): int {
    context_size: usize = ace_bearssl_client_size()
    context_align: usize = ace_bearssl_client_align()
    buffer_size: usize = ace_bearssl_record_buffer_size()

    if context_size != 6888 || context_align != 8 || context_align > 16 ||
       buffer_size != 16709 || ace_bearssl_version_min() != 0x0303 ||
       ace_bearssl_version_max() != 0x0303 {
        return 1
    }

    context: mut []u8 = mem.alloc(int(context_size), int(context_align))
    context_again: mut []u8 = mem.alloc(int(context_size), int(context_align))
    buffer: mut []u8 = mem.alloc(int(buffer_size), 1)
    buffer_again: mut []u8 = mem.alloc(int(buffer_size), 1)

    if context == null || context_again == null || buffer == null ||
       buffer_again == null {
        if context != null { mem.release(mut context) }
        if context_again != null { mem.release(mut context_again) }
        if buffer != null { mem.release(mut buffer) }
        if buffer_again != null { mem.release(mut buffer_again) }
        return 2
    }

    seed: [32]u8
    for i: usize in 0 .. seed.len { seed[i] = u8(i) }

    if ace_bearssl_client_init(mut &context[0], mut &buffer[0], buffer.len, &seed[0], seed.len - 1) != 0 {
        mem.release(mut buffer_again)
        mem.release(mut buffer)
        mem.release(mut context_again)
        mem.release(mut context)
        return 3
    }
    initialized: i32 = ace_bearssl_client_init(mut &context[0], mut &buffer[0], buffer.len, &seed[0], seed.len)
    initialized_again: i32 = ace_bearssl_client_init(
        mut &context_again[0], mut &buffer_again[0], buffer_again.len,
        &seed[0], seed.len)

    if initialized != 1 || initialized_again != 1 {
        mem.release(mut buffer_again)
        mem.release(mut buffer)
        mem.release(mut context_again)
        mem.release(mut context)
        return 4
    }
    if ace_bearssl_client_state(&context[0]) != 4 {
        mem.release(mut buffer_again)
        mem.release(mut buffer)
        mem.release(mut context_again)
        mem.release(mut context)
        return 5
    }
    if ace_bearssl_client_error(&context[0]) != 0 ||
       ace_bearssl_system_rng_disabled(&context[0]) != 1 {
        mem.release(mut buffer_again)
        mem.release(mut buffer)
        mem.release(mut context_again)
        mem.release(mut context)
        return 6
    }

    random: [32]u8 = [u8(0) : 32]
    random_again: [32]u8 = [u8(0) : 32]
    if ace_bearssl_client_random(mut &context[0], mut &random[0], random.len) != 1 ||
       ace_bearssl_client_random(mut &context_again[0], mut &random_again[0], random_again.len) != 1 {
        mem.release(mut buffer_again)
        mem.release(mut buffer)
        mem.release(mut context_again)
        mem.release(mut context)
        return 7
    }
    for i: usize in 0 .. random.len {
        if random[i] != random_again[i] {
            mem.release(mut buffer_again)
            mem.release(mut buffer)
            mem.release(mut context_again)
            mem.release(mut context)
            return 8
        }
    }

    mem.release(mut buffer_again)
    mem.release(mut buffer)
    mem.release(mut context_again)
    mem.release(mut context)
    return 0
