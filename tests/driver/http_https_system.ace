import http

// expect-exit: 0

main(): int {
    client: http.Client = http.client_new()
    response: http.Response, err: Error = http.get("https://example.com/", mut client)
    status: u16 = response.status
    http.client_wipe(mut client)
    if err != null { return 1 }
    if status != 200 { return 2 }
    return 0
}
