import mem

touch(noalias dst: []u8, src: []u8) {
    if dst.len > 0 && src.len > 0 { dst[0] = src[0] }
}

main(): int {
    data: []u8 = mem.alloc(8, 1)
    if data == null { return 2 }
    data[4] = 42
    touch(data[..4], data[4..])
    result: int = int(data[0])
    mem.release(&data)
    return result
}
