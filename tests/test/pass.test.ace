/* Every check passes: `test.run` prints `ok` per case and exits 0. */

import test

pub numbers(mut t: test.T) {
    mut t.equal(2 + 2, 4)
    mut t.equal(uint(7), uint(7))
    mut t.equal(usize(3), usize(3))
}

pub text(mut t: test.T) {
    mut t.equal("ace", "ace")
    mut t.equal(true, 1 < 2)
}
