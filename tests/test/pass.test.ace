/* Every check passes: `test.run` prints `ok` per case and exits 0. */

import test

Level: enum u8 { low, high }

pub numbers(t: *test.T) {
    t.equal(2 + 2, 4)
    t.equal(uint(7), uint(7))
    t.equal(usize(3), usize(3))
}

pub text(t: *test.T) {
    t.equal("ace", "ace")
    t.equal(true, 1 < 2)
    test.equal[Level](t, Level.high, Level.high)
}
