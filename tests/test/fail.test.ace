/* Failing checks report their index and values; later checks still run, the
 * other cases still run, and `test.run` exits 1. */

import test

Facing: enum { north, east }

pub good(t: *test.T) {
    t.equal(1, 1)
}

pub bad(t: *test.T) {
    t.equal(1, 1)
    t.equal(-3, 4)
    t.equal(uint(5), uint(6))
    t.equal(usize(0), usize(1))
    t.equal(false, true)
    t.equal("got", "want")
    test.equal[Facing](t, Facing.east, Facing.north)
    t.fail("unreachable state")
}
