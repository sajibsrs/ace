/* Failing checks report their location and values; later checks still run, the
 * other cases still run, and `test.run` exits 1. */

import test

Facing: enum { north, east }

pub good(t: *test.T) {
    t.equal(1, 1, @file, @line)
}

pub bad(t: *test.T) {
    t.equal(1, 1, @file, @line)
    t.equal(-3, 4, @file, @line)
    t.equal(uint(5), uint(6), @file, @line)
    t.equal(usize(0), usize(1), @file, @line)
    t.equal(false, true, @file, @line)
    t.equal("got", "want", @file, @line)
    test.equal[Facing](t, Facing.east, Facing.north, @file, @line)
    t.fail("unreachable state", @file, @line)
}
