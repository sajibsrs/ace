above(u16): i64 {
b0:
    %0 = param u16 0
    %1 = const u16 3
    %2 = gt bool %0, %1
    br %2, b3, b2
b1: ; preds b3
    %4 = const i64 1
    ret %4
b2: ; preds b0, b3
    %6 = const i64 0
    ret %6
b3: ; preds b0
    %8 = const u16 9
    %9 = ge bool %0, %8
    br %9, b1, b2
}

chained(u8, u8): i64 {
b0:
    %0 = param u8 0
    %1 = param u8 1
    %2 = const u8 3
    %3 = eq bool %0, %2
    br %3, b3, b1
b1: ; preds b0, b4
    %5 = const i64 1
    ret %5
b2: ; preds b3, b4
    %7 = const i64 0
