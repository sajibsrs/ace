}

untrailed({ptr, u64}): u64 {
b0:
    %0 = param ptr 0
    %1 = param u64 1
    jmp b1
b1: ; preds b0, b5
    %3 = phi u64 [%1, b0], [%9, b5]
    %4 = const u64 0
    %5 = gt bool %3, %4
    br %5, b3, b2
b2: ; preds b1, b4
    ret %3
b3: ; preds b1
    %8 = const u64 1
    %9 = sub u64 %3, %8
    %10 = padd ptr %0, %9 * 1
    %11 = load u8 [%10]
    %12 = cast u32 %11
    %13 = const u32 9
    %14 = sub u32 %12, %13
    %15 = const u32 4
    %16 = le bool %14, %15
    br %16, b5, b4
b4: ; preds b3
    %18 = const u8 32
    %19 = eq bool %11, %18
    br %19, b5, b2
b5: ; preds b4, b3
    jmp b1
}

main(): i64 {
b0:
    %0 = str ptr "abc"
    %1 = const u64 3
    %2 = call i64 letters(%0, %1)
    %3 = const i64 3
    %4 = add i64 %2, %3
    %5 = const i64 1
    %6 = add i64 %4, %5
    %7 = const i64 1
    %8 = add i64 %6, %7
    %9 = str ptr "a \x0a"
    %10 = const u64 3
    %11 = call u64 untrailed(%9, %10)
    %12 = cast i64 %11
    %13 = add i64 %8, %12
    %14 = const u8 3
    %15 = const u8 10
    %16 = call i64 chained(%14, %15)
    %17 = add i64 %13, %16
    ret %17
}

