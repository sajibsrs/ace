letters({ptr, u64}): i64 {
b0:
    %0 = param ptr 0
    %1 = param u64 1
    %2 = const i64 0
    %3 = const u64 0
    jmp b1
b1: ; preds b0, b5
    %5 = phi u64 [%3, b0], [%23, b5]
    %6 = phi i64 [%2, b0], [%21, b5]
    %7 = lt bool %5, %1
    br %7, b2, b3
b2: ; preds b1
    %9 = padd ptr %0, %5 * 1
    %10 = load u8 [%9]
    %11 = cast u32 %10
    %12 = const u32 97
    %13 = sub u32 %11, %12
    %14 = const u32 25
    %15 = le bool %13, %14
    br %15, b4, b5
b3: ; preds b1
    ret %6
b4: ; preds b2
    %18 = const i64 1
    %19 = add i64 %6, %18
    jmp b5
b5: ; preds b2, b4
    %21 = phi i64 [%6, b2], [%19, b4]
    %22 = const u64 1
    %23 = add u64 %5, %22
    jmp b1
}

clamp(i32): i32 {
b0:
    %0 = param i32 0
    %1 = cast u32 %0
    %2 = const u32 5
    %3 = add u32 %1, %2
    %4 = const u32 10
    %5 = le bool %3, %4
    br %5, b2, b1
b1: ; preds b0
    %7 = const i32 0
    ret %7
b2: ; preds b0
    ret %0
}

wide(i64): i64 {
b0:
    %0 = param i64 0
