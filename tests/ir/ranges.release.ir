b3: ; preds b0
    %9 = cast u32 %1
    %10 = const u32 2
    %11 = sub u32 %9, %10
    %12 = const u32 7
    %13 = le bool %11, %12
    br %13, b2, b4
b4: ; preds b3
    %15 = const u8 12
    %16 = ge bool %1, %15
    br %16, b2, b1
}

space(u8): bool {
b0:
    %0 = param u8 0
    %1 = cast u32 %0
    %2 = const u32 9
    %3 = sub u32 %1, %2
    %4 = const u32 4
    %5 = le bool %3, %4
    br %5, b2, b1
b1: ; preds b0
    %7 = const u8 32
    %8 = eq bool %0, %7
    jmp b3
b2: ; preds b0
    %10 = const bool true
    jmp b3
b3: ; preds b1, b2
    %12 = phi bool [%8, b1], [%10, b2]
