spin(ptr, u32): u32 {
b0:
    %0 = param ptr 0
    %1 = param u32 1
    %2 = const u32 0
    %3 = const u32 0
    jmp b1
b1: ; preds b0, b2
    %5 = phi u32 [%3, b0], [%13, b2]
    %6 = phi u32 [%2, b0], [%10, b2]
    %7 = lt bool %5, %1
    br %7, b2, b3
b2: ; preds b1
    %9 = const u32 1
    %10 = atomic u32 add.relaxed %0, %9
    atomic fence.release
    %12 = const u32 1
    %13 = add u32 %5, %12
    jmp b1
b3: ; preds b1
    atomic store.release %0, %6
    %16 = const u32 0
    %17 = atomic u32 cas.seq_cst %0, %6, %16
    %18 = eq bool %17, %6
    br %18, b4, b5
b4: ; preds b3
    %20 = atomic u32 load.acquire %0
    ret %20
b5: ; preds b3
    ret %17
}

main(): i64 {
b0:
    %0 = slot ptr 4, 4
    %1 = const u32 0
    store [%0], %1
    %3 = const u32 3
    %4 = call u32 spin(%0, %3)
    %5 = cast i64 %4
    ret %5
}

