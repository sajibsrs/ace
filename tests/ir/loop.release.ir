gcd(u64, u64): u64 {
b0:
    %0 = param u64 0
    %1 = param u64 1
    jmp b1
b1: ; preds b0, b2
    %3 = phi u64 [%1, b0], [%8, b2]
    %4 = phi u64 [%0, b0], [%3, b2]
    %5 = const u64 0
    %6 = ne bool %3, %5
    br %6, b2, b3
b2: ; preds b1
    %8 = rem u64 %4, %3
    jmp b1
b3: ; preds b1
    ret %4
}

main(): i64 {
b0:
    %0 = const u64 12
    %1 = const u64 18
    %2 = call u64 gcd(%0, %1)
    %3 = const u64 6
    %4 = ne bool %2, %3
    br %4, b1, b2
b1: ; preds b0
    %6 = const i64 1
    ret %6
b2: ; preds b0
    %8 = const i64 0
    ret %8
}

