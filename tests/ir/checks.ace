/* Release removes a bounds check that a dominating comparison implies: the
 * same index checked again, a loop bound, a guard on either branch edge, an
 * offset index under a tighter bound, and a narrower counter. A check the
 * comparisons do not imply stays: an unknown loop bound over a fixed array. */
table: [8]i32

repeated(i: usize): i32 {
    return table[i] + table[i] * table[i]
}

counted(s: []i32): i32 {
    t: i32 = 0
    for i: usize in 0 .. s.len { t += s[i] }
    return t
}

guarded(i: usize): i32 {
    if i < 8 { return table[i] }
    return 0
}

early(s: []i32, i: usize): i32 {
    if i >= s.len { return 0 }
    return s[i]
}

shifted() {
    for i: usize in 0 .. 7 { table[i] = table[i + 1] }
}

narrow(): i32 {
    t: i32 = 0
    for i: i32 in 0 .. 8 { t += table[i] }
    return t
}

unknown(n: usize): i32 {
    t: i32 = 0
    for i: usize in 0 .. n { t += table[i] }
    return t
}

main(): int {
    shifted()
    return int(repeated(1) + counted(table[..]) + guarded(9) + early(table[..], 2) + narrow() + unknown(8))
}
