    %6 = const i64 590
    %7 = ne bool %5, %6
    br %7, b1, b2
b1: ; preds b0
    %9 = const i64 1
    ret %9
b2: ; preds b0
    %11 = const u8 1
    store [%2], %11
    %13 = const u8 2
