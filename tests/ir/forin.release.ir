sum({ptr, u64}): i64 {
b0:
    %0 = param ptr 0
    %1 = param u64 1
    %2 = const i64 0
    %3 = padd ptr %0, %1 * 1
    %4 = const u64 0
    jmp b1
b1: ; preds b0, b2
    %6 = phi ptr [%0, b0], [%19, b2]
    %7 = phi u64 [%4, b0], [%14, b2]
    %8 = phi i64 [%2, b0], [%17, b2]
    %9 = lt bool %6, %3
    br %9, b2, b3
b2: ; preds b1
    %11 = load u8 [%6]
    %12 = cast i64 %11
    %13 = const u64 1
    %14 = add u64 %7, %13
    %15 = cast i64 %14
    %16 = mul i64 %12, %15
    %17 = add i64 %8, %16
    %18 = const u64 1
    %19 = padd ptr %6, %18 * 1
    jmp b1
b3: ; preds b1
    ret %8
}

double(ptr): void {
b0:
    %0 = param ptr 0
    %1 = const u64 3
    %2 = padd ptr %0, %1 * 1
    jmp b1
b1: ; preds b0, b2
    %4 = phi ptr [%0, b0], [%12, b2]
    %5 = lt bool %4, %2
    br %5, b2, b3
b2: ; preds b1
    %7 = load u8 [%4]
    %8 = const u8 2
    %9 = mul u8 %7, %8
    store [%4], %9
    %11 = const u64 1
    %12 = padd ptr %4, %11 * 1
    jmp b1
b3: ; preds b1
    ret
}

pairs({ptr, u64}): i64 {
b0:
    %0 = param ptr 0
    %1 = param u64 1
    %2 = const i64 0
    %3 = padd ptr %0, %1 * 8
    jmp b1
b1: ; preds b0, b2
    %5 = phi ptr [%0, b0], [%16, b2]
    %6 = phi i64 [%2, b0], [%14, b2]
    %7 = lt bool %5, %3
    br %7, b2, b3
b2: ; preds b1
    %9 = load i32 [%5]
    %10 = load i32 [%5 + 4]
    %11 = cast i64 %9
    %12 = cast i64 %10
    %13 = sub i64 %11, %12
    %14 = add i64 %6, %13
    %15 = const u64 1
    %16 = padd ptr %5, %15 * 8
    jmp b1
b3: ; preds b1
    ret %6
}

first({u8, u8, u8, u8}, u8): i64 {
b0:
    %0 = slot ptr 4, 1
    %1 = param u8 0
    %2 = param u8 1
    %3 = param u8 2
    %4 = param u8 3
    store [%0], %1
    store [%0 + 1], %2
    store [%0 + 2], %3
    store [%0 + 3], %4
    %9 = param u8 4
    %10 = const i64 0
    %11 = const u64 4
    %12 = padd ptr %0, %11 * 1
    jmp b1
b1: ; preds b0, b4
    %14 = phi ptr [%0, b0], [%25, b4]
    %15 = phi i64 [%10, b0], [%23, b4]
    %16 = lt bool %14, %12
    br %16, b2, b3
b2: ; preds b1
    %18 = load u8 [%14]
    %19 = eq bool %18, %9
    br %19, b3, b4
b3: ; preds b1, b2
    ret %15
b4: ; preds b2
    %22 = const i64 1
    %23 = add i64 %15, %22
    %24 = const u64 1
    %25 = padd ptr %14, %24 * 1
    jmp b1
}

main(): i64 {
b0:
    %0 = slot ptr 4, 1
    %1 = slot ptr 16, 4
    %2 = slot ptr 3, 1
    %3 = str ptr "abc"
    %4 = const u64 3
