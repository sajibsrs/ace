/* Release folds constants through locals and phis and prunes the arm a
 * constant condition never takes; debug keeps every operation and branch. */

pick(x: int): int {
    mode: int = 3
    n: int = 0
    if mode > 2 {
        n = x + 1
    } else {
        n = x - 1
    }
    return n
}

wrap(): u8 {
    a: u8 = 31
    return a << 4
}

same(x: int): int {
    k: int = 4
    i: int = 0
    for i < 3 {
        k = k * 1
        i = i + 1
    }
    return x + k
}

keep(x: int, y: int): int {
    z: int = 0
    return x / y + z
}

main(): int {
    if pick(1) != 2 { return 1 }
    if wrap() != 240 { return 2 }
    if same(1) != 5 { return 3 }
    if keep(9, 3) != 3 { return 4 }
    return 0
}
