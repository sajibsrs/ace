/* An array local or struct field lives in memory: a constant index is a
 * fixed offset from its place, any other one padd, checked in debug below
 * the fixed length (a signed one first nonnegative). A slice's length is
 * the array's. Up to 16 leaves an array travels in its elements' leaves;
 * past that by address, as a copy, and a copy or a repeated fill of it
 * loops over words. Float bits are a bitcast. */

Grid: struct {
    w: i32,
    cells: [4]u8,
}

get(a: [4]i64, i: i32): i64 {
    return a[i] + a[3]
}

set(g: *Grid, i: usize, v: u8) {
    g.cells[i] = v
    g.cells[0] += 1
}

window(a: [4]i64, lo: usize, hi: usize): usize {
    return a[lo..hi].len
}

sum(b: [64]u8): u64 {
    t: u64 = 0
    for i: usize in 0 .. 64 {
        t += u64(b[i])
    }
    return t
}

pair(x: i64): [2]i64 {
    return [x, x + 1]
}

bits32(f: f32): u32 {
    return bitcast(u32, f)
}

main(): int {
    a: [4]i64 = [1, 2, 3, 4]
    g: Grid = Grid { w = 1, cells = [0 : 4] }
    set(&g, 2, 7)
    b: [64]u8 = [1 : 64]
    c: [64]u8 = b
    c[63] = 2
    p: [2]i64 = pair(5)
    if get(a, 1) != 6 || g.cells[2] != 7 || window(a, 1, 3) != 2 || sum(c) != 65 || p[1] != 6 {
        return 1
    }
    if bits32(1.0) != 0x3F800000 { return 2 }
    return 0
}
