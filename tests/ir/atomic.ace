import atomic

// Atomic operations stay in order and are never removed, merged, or hoisted,
// even with an unused result inside a loop.
spin(p: mut *u32, n: u32): u32 {
    seen: u32 = 0
    i: u32 = 0
    for i < n {
        seen = atomic.add_relaxed(p, u32(1))
        atomic.fence_release()
        i = i + 1
    }
    atomic.store_release(p, seen)
    old: u32, ok: bool = atomic.cas(p, seen, u32(0))
    if ok { return atomic.load_acquire(p) }
    return old
}

main(): int {
    w: u32 = 0
    return int(spin(mut &w, u32(3)))
}
