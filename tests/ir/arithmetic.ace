/* Debug builds check +, -, *, unary -, /, %, and shifts (the .chk forms);
 * release builds do not. Casts truncate or extend; bitwise operations and
 * casts are never checked. */

MASK: const u32 = 0xFF

mix(a: i32, b: u32, n: i64): u32 {
    s: i32 = a * 3 - 7
    s /= 2
    t: u32 = (u32(s) ^ b) & MASK
    u: i64 = -n % 5
    return t << 2 | u32(u)
}

main(): int {
    if mix(5, 1, 0) != 20 { return 1 }
    return 0
}
