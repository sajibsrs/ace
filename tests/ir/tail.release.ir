sum(u64, u64, u64): u64 {
b0:
    %0 = param u64 0
    %1 = param u64 1
    %2 = param u64 2
    jmp b1
b1: ; preds b0, b3
    %4 = phi u64 [%0, b0], [%11, b3]
    %5 = phi u64 [%1, b0], [%12, b3]
    %6 = const u64 0
    %7 = eq bool %4, %6
    br %7, b2, b3
b2: ; preds b1
    ret %5
b3: ; preds b1
    %10 = const u64 1
    %11 = sub u64 %4, %10
    %12 = add u64 %5, %2
    jmp b1
}

main(): i64 {
b0:
    %0 = const u64 10
    %1 = const u64 0
    %2 = const u64 2
    %3 = call u64 sum(%0, %1, %2)
    %4 = const u64 20
    %5 = ne bool %3, %4
    br %5, b1, b2
b1: ; preds b0
    %7 = const i64 1
    ret %7
b2: ; preds b0
    %9 = const i64 0
    ret %9
}

