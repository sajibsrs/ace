/* A function outside the IR's current subset is left to the AST emitter,
 * with the first construct that kept it out. */

norm(s: string): i64 {
    return i64(s[0])
}

sign(x: i64): i64 {
    switch x {
        0 { return 0 }
        default { return 1 }
    }
}

bump(mut n: i64) {
    n += 1
}

main(): int {
    n: i64 = norm("abc")
    bump(mut n)
    if sign(4) != 1 || n != 98 { return 1 }
    return 0
}
