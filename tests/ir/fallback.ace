/* A function outside the IR's current subset is left to the AST emitter,
 * with the first construct that kept it out: here an asm binding naming an
 * address-taken local, which the IR binds only as an SSA value. */

sign(x: i64): i64 {
    k: i64 = x
    bump(mut k)
    asm "nop" { in: x9 = k }
    if k == 1 { return 0 }
    return 1
}

bump(mut n: i64) {
    n += 1
}

main(): int {
    n: i64 = 97
    bump(mut n)
    if sign(4) != 1 || n != 98 { return 1 }
    return 0
}
