/* A function outside the IR's current subset is left to the AST emitter,
 * with the first construct that kept it out. */

norm(s: string): i64 {
    for b: u8 in s {
        return i64(b)
    }
    return 0
}

sign(x: i64): i64 {
    asm "nop" {}
    if x == 0 { return 0 }
    return 1
}

bump(mut n: i64) {
    n += 1
}

main(): int {
    n: i64 = norm("abc")
    bump(mut n)
    if sign(4) != 1 || n != 98 { return 1 }
    return 0
}
