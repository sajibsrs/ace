/* A function outside the IR's current subset is left to the AST emitter,
 * with the first construct that kept it out. */

Point: struct {
    x: i64,
    y: i64,
}

norm(p: Point): i64 {
    return p.x + p.y
}

half(x: f64): f64 {
    return x / 2.0
}

bump(mut n: i64) {
    n += 1
}

main(): int {
    n: i64 = norm(Point{x = 1, y = 2})
    bump(mut n)
    if half(4.0) != 2.0 || n != 4 { return 1 }
    return 0
}
