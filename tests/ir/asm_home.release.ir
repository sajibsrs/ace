sign(i64): i64 {
b0:
    %0 = param i64 0
    %1 = const i64 1
    %2 = add i64 %0, %1
    asm "nop" x9=%2, clobbers 0x200
    %4 = const i64 1
    %5 = eq bool %2, %4
    br %5, b1, b2
b1: ; preds b0
    %7 = const i64 0
    ret %7
b2: ; preds b0
    %9 = const i64 1
    ret %9
}

bump(ptr): void {
b0:
    %0 = param ptr 0
    %1 = load i64 [%0]
    %2 = const i64 1
    %3 = add i64 %1, %2
    store [%0], %3
    ret
}

main(): i64 {
b0:
    %0 = const i64 4
    %1 = call i64 sign(%0)
    %2 = const i64 1
    %3 = ne bool %1, %2
    br %3, b1, b2
b1: ; preds b0
    %5 = const i64 1
    ret %5
b2: ; preds b0
    %7 = const i64 0
    ret %7
}

