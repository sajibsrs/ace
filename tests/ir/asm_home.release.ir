sign(i64): i64 {
b0:
    %0 = slot ptr 8, 8
    %1 = param i64 0
    store [%0], %1
    %3 = const i64 1
    %4 = load i64 [%0]
    %5 = add i64 %4, %3
    store [%0], %5
    %7 = load i64 [%0]
    asm "nop" x9=%7, clobbers 0x200
    %9 = load i64 [%0]
    %10 = const i64 1
    %11 = eq bool %9, %10
    br %11, b1, b2
b1: ; preds b0
    %13 = const i64 0
    ret %13
b2: ; preds b0
    %15 = const i64 1
    ret %15
}

bump(ptr): void {
b0:
    %0 = param ptr 0
    %1 = const i64 1
    %2 = load i64 [%0]
    %3 = add i64 %2, %1
    store [%0], %3
    ret
}

main(): i64 {
b0:
    %0 = const i64 4
    %1 = call i64 sign(%0)
    %2 = const i64 1
    %3 = ne bool %1, %2
    br %3, b1, b2
b1: ; preds b0
    %5 = const i64 1
    ret %5
b2: ; preds b0
    %7 = const i64 0
    ret %7
}

