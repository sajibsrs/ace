main(): i64 {
b0:
    %0 = const i64 5
    %1 = call i64 restart(%0)
    %2 = const i64 114
    %3 = ne bool %1, %2
    br %3, b1, b2
b1: ; preds b0
    %5 = const i64 3
    ret %5
b2: ; preds b0
    %7 = const u32 3
