b4: ; preds b2
    %16 = const i64 20
    %17 = eq bool %11, %16
    br %17, b5, b6
b5: ; preds b4
    jmp b1
b6: ; preds b4
    %20 = const i64 100
    %21 = add i64 %9, %20
