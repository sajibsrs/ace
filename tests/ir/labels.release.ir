b12: ; preds b8
    %35 = const i64 1
    %36 = add i64 %24, %35
    %37 = const i64 3
    %38 = rem i64 %36, %37
    %39 = const i64 0
    %40 = eq bool %38, %39
    br %40, b13, b14
b13: ; preds b12
    jmp b11
b14: ; preds b12
    %43 = const i64 200
    %44 = lt bool %36, %43
    br %44, b15, b16
b15: ; preds b14
    jmp b10
b16: ; preds b14
    %47 = const i64 10
    %48 = add i64 %36, %47
