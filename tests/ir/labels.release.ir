    jmp b5
b9: ; preds b6
    jmp b4
b10: ; preds b6
    %26 = add u32 %4, %15
    %27 = const u32 7
    %28 = eq bool %26, %27
    br %28, b11, b12
b11: ; preds b10
    jmp b3
b12: ; preds b10
    %31 = const u32 1
    %32 = add u32 %16, %31
    jmp b8
b13: ; preds b15, b16
    %34 = phi u32 [%10, b15], [%40, b16]
    ret %34
b14: ; preds b3
    %36 = const u32 5
    %37 = gt bool %10, %36
    br %37, b15, b16
b15: ; preds b14
    jmp b13
b16: ; preds b14
    %40 = const u32 0
    jmp b13
}

restart(i64): i64 {
b0:
    %0 = param i64 0
    %1 = const i64 0
    %2 = const i64 0
