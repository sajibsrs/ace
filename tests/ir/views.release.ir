pick({ptr, u64}, {ptr, u64}, bool): {ptr, u64} {
b0:
    %0 = param ptr 0
    %1 = param u64 1
    %2 = param ptr 2
    %3 = param u64 3
    %4 = param bool 4
    br %4, b1, b2
b1: ; preds b0
    ret %0, %1
b2: ; preds b0
    ret %2, %3
}

