pick({ptr, u64}, {ptr, u64}, bool): {ptr, u64} {
b0:
    %0 = param ptr 0
    %1 = param u64 1
    %2 = param ptr 2
    %3 = param u64 3
    %4 = param bool 4
    br %4, b1, b2
b1: ; preds b0
    ret %0, %1
b2: ; preds b0
    ret %2, %3
}

; larger: not lowered (generic)

; twice: not lowered (generic)

twice(i64): i64 {
b0:
    %0 = param i64 0
    %1 = const i64 3
    %2 = mul i64 %0, %1
    ret %2
}

main(): i64 {
b0:
    %0 = str ptr "ir"
    %1 = const ptr 0
    %2 = eq bool %0, %1
    br %2, b1, b2
b1: ; preds b0
    %4 = const i64 1
    ret %4
b2: ; preds b0
    %6 = const i64 2
    %7 = const i64 1
    %8 = call i64 larger(%6, %7)
    %9 = global ptr larger
    %10 = const i64 1
    %11 = call i64 twice(%10)
    %12 = calli i64 %9(%8, %11)
    %13 = const i64 3
    %14 = ne bool %12, %13
    br %14, b3, b4
b3: ; preds b2
    %16 = const i64 2
    ret %16
b4: ; preds b2
    %18 = const i64 5
    ret %18
}

