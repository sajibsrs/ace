pick({ptr, u64}, {ptr, u64}, bool): {ptr, u64} {
b0:
    %0 = param ptr 0
    %1 = param u64 1
    %2 = param ptr 2
    %3 = param u64 3
    %4 = param bool 4
    br %4, b1, b2
b1: ; preds b0
    ret %0, %1
b2: ; preds b0
    ret %2, %3
}

; larger: not lowered (generic)

; twice: not lowered (generic)

twice(i64): i64 {
b0:
    %0 = param i64 0
    %1 = const i64 3
    %2 = mul i64 %0, %1
    ret %2
}

main(): i64 {
b0:
    %0 = str ptr "ir"
    %1 = const ptr 0
    %2 = eq bool %0, %1
    br %2, b1, b2
b1: ; preds b0
    %4 = const i64 1
    ret %4
b2: ; preds b0
    %6 = const i64 2
    %7 = global ptr larger
    %8 = const i64 1
    %9 = call i64 twice(%8)
    %10 = calli i64 %7(%6, %9)
    %11 = const i64 3
    %12 = ne bool %10, %11
    br %12, b3, b4
b3: ; preds b2
    %14 = const i64 2
    ret %14
b4: ; preds b2
    %16 = const i64 5
    ret %16
}

