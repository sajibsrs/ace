/* A string or slice is two leaves, its ptr and a u64 length: a literal is
 * the address of its bytes (str) and a constant length, .len is the second
 * leaf, and a null check tests the first. A call to a stamped generic or a
 * written specialization targets that body's symbol, as does one taken as a
 * value. */

TAG: const string = "ir"

Named: struct {
    name: string,
    n: i64,
}

pick(a: string, b: []u8, first: bool): string {
    if first { return a }
    return string(b)
}

larger[T](a: T, b: T): T {
    if a > b { return a }
    return b
}

twice[T](x: T): T {
    return x + x
}

twice[i64](x: i64): i64 {
    return x * 3
}

main(): int {
    s: string = pick("abc", TAG, false)
    none: string = null
    if none != null || s == null { return 1 }
    v: Named = Named{name = s, n = larger[i64](i64(s.len), 1)}
    f: (i64, i64): i64 = larger[i64]
    if f(v.n, twice[i64](1)) != 3 { return 2 }
    return int(v.name.len + "xyz".len)
}
