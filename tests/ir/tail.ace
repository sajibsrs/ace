/* Release turns a self tail call into a branch back to the head; a parameter
 * the call passes through unchanged needs no phi. Debug keeps the call. main
 * reports allocator leaks before returning in debug builds. */

sum(n: u64, acc: u64, step: u64): u64 {
    if n == 0 { return acc }
    return sum(n - 1, acc + step, step)
}

main(): int {
    if sum(10, 0, 2) != 20 { return 1 }
    return 0
}
