spin(ptr, u32): u32 {
b0:
    %0 = param ptr 0
    %1 = param u32 1
    %2 = const u32 0
    %3 = const u32 0
    jmp b1
b1: ; preds b0, b2
    %5 = phi u32 [%3, b0], [%19, b2]
    %6 = phi u32 [%2, b0], [%16, b2]
    %7 = lt bool %5, %1
    br %7, b2, b3
b2: ; preds b1
    %9 = cast u64 %0
    %10 = const u64 3
    %11 = and u64 %9, %10
    %12 = const u64 0
    %13 = eq bool %11, %12
    check %13, 9:14 misaligned atomic access
    %15 = const u32 1
    %16 = atomic.chk u32 add.relaxed %0, %15
    atomic fence.release
    %18 = const u32 1
    %19 = add.chk u32 %5, %18
    jmp b1
b3: ; preds b1
    %21 = cast u64 %0
    %22 = const u64 3
    %23 = and u64 %21, %22
    %24 = const u64 0
    %25 = eq bool %23, %24
    check %25, 13:5 misaligned atomic access
    atomic.chk store.release %0, %6
    %28 = cast u64 %0
    %29 = const u64 3
    %30 = and u64 %28, %29
    %31 = const u64 0
    %32 = eq bool %30, %31
    check %32, 14:5 misaligned atomic access
    %34 = const u32 0
    %35 = atomic.chk u32 cas.seq_cst %0, %6, %34
    %36 = eq bool %35, %6
    br %36, b4, b5
b4: ; preds b3
    %38 = cast u64 %0
    %39 = const u64 3
    %40 = and u64 %38, %39
    %41 = const u64 0
    %42 = eq bool %40, %41
    check %42, 15:13 misaligned atomic access
    %44 = atomic.chk u32 load.acquire %0
    ret %44
b5: ; preds b3
    ret %35
}

main(): i64 {
b0:
    %0 = slot ptr 4, 4
    %1 = const u32 0
    store [%0], %1
    %3 = const u32 3
    %4 = call u32 spin(%0, %3)
    %5 = cast i64 %4
    call @__ace$registry_leaks()
    ret %5
}

