/* Release gives an innermost counted loop of lane-wise f32, i32, or f64
 * arithmetic over independent elements a vector loop ahead of it, four
 * elements per iteration (two for f64), counting whole vectors; the original
 * loop runs the remainder.
 * Accepted: global arrays with a constant or variable count, integer lanes
 * with negation, float division, a stack array, a call inline expansion
 * removes, two slices once inlined over a global and a stack array, and
 * branches on an i32 index (selects over its lanes; a count of whole vectors
 * leaves no remainder loop), and f64 elements with a constant or variable
 * count. Kept scalar: a reduction, a neighbouring element, two slices that may
 * overlap, a call that stays, f64 beside 32-bit lanes, an f64 compare, and a
 * load under a branch. A struct array whose same-typed fields all get the
 * same computation vectorizes as its flat fields, with a pointer for a size
 * that is no power of two or a scaled offset for one that is; fields computed
 * differently, a field left unstored, or a field read into another stay
 * scalar. Debug keeps every loop scalar. */

xs: [64]f32
ys: [64]f32
ks: [64]i32
ds: [64]f64

scale(n: usize) {
    for i: usize in 0 .. n { ys[i] = xs[i] / ys[i] - 2.5 }
}

negate() {
    for i: usize in 0 .. 64 { ks[i] = -ks[i] * 3 + ks[i] }
}

local(): f32 {
    tmp: [16]f32 = [0.0 : 16]
    for i: usize in 0 .. 16 { tmp[i] = xs[i] * xs[i] }
    return tmp[3]
}

sum(): f32 {
    s: f32 = 0.0
    for i: usize in 0 .. 64 { s += xs[i] }
    return s
}

shift() {
    for i: usize in 0 .. 63 { ys[i] = ys[i + 1] }
}

slices(a: []f32, b: []f32) {
    for i: usize in 0 .. 64 { b[i] = a[i] + 1.0 }
}

twice(x: f32): f32 {
    return x * 2.0
}

calls() {
    for i: usize in 0 .. 64 { ys[i] = twice(xs[i]) + xs[i] }
}

halve(x: f32, n: int): f32 {
    if n == 0 { return x }
    return halve(x * 0.5, n - 1)
}

stays() {
    for i: usize in 0 .. 64 { ys[i] = halve(xs[i], 2) }
}

wide(n: usize) {
    for i: usize in 0 .. 64 { ds[i] = ds[i] * 2.0 }
    for i: usize in 0 .. n { ds[i] = -ds[i] / 3.0 }
}

mixed() {
    for i: usize in 0 .. 64 {
        ds[i] = ds[i] * 2.0
        ys[i] = ys[i] * 2.0
    }
}

clamped() {
    for i: usize in 0 .. 64 {
        d: f64 = ds[i]
        if d > 1.0 { d = 1.0 }
        ds[i] = d
    }
}

sign(i: i32, bit: i32): f32 {
    if ((i >> bit) & 1) == 1 { return 1.0 }
    return -1.0
}

corners() {
    for i: i32 in 0 .. 64 { ys[i] = sign(i, 0) * xs[i] + sign(i, 2) }
}

guarded() {
    for i: usize in 0 .. 64 {
        y: f32 = 0.0
        if ks[i] > 0 { y = xs[i] }
        ys[i] = y
    }
}

Vec3: struct { x: f32, y: f32, z: f32 }
Vec2: struct { x: f32, y: f32 }
ps: [64]Vec3
vs: [64]Vec3
qs: [64]Vec2

particles(n: usize) {
    for i: usize in 0 .. n {
        ps[i].x += vs[i].x * 0.5
        ps[i].y += vs[i].y * 0.5
        ps[i].z += vs[i].z * 0.5
    }
}

pairs() {
    for i: usize in 0 .. 64 {
        qs[i].x = qs[i].x * 2.0 - 1.0
        qs[i].y = qs[i].y * 2.0 - 1.0
    }
}

uneven() {
    for i: usize in 0 .. 64 {
        qs[i].x = qs[i].x * 2.0
        qs[i].y = qs[i].y * 3.0
    }
}

partial() {
    for i: usize in 0 .. 64 {
        ps[i].x = vs[i].x
        ps[i].y = vs[i].y
    }
}

crossed() {
    for i: usize in 0 .. 64 {
        qs[i].x = qs[i].y
        qs[i].y = qs[i].x
    }
}

main(): int {
    scale(64)
    negate()
    b: [64]f32 = [0.0 : 64]
    slices(xs[..], b[..])
    calls()
    stays()
    wide(64)
    mixed()
    clamped()
    shift()
    corners()
    guarded()
    particles(64)
    pairs()
    uneven()
    partial()
    crossed()
    return int(local() + sum())
}
