/* Structs and tuples are their scalar leaves: a local is one SSA value per
 * leaf, a literal is its fields' values, and a parameter, argument, or
 * result is its leaves ({...} in a signature), a call's read by proj. One
 * whose address is taken lives in a slot, read and written by leaf. An Error
 * is a u64: its domain id above the raw bits of its i32 code. */

Point: struct {
    x: i64,
    y: f64,
}

Parse: error

shift(p: Point, by: i64): Point {
    q: Point = p
    q.x += by
    return q
}

check(n: i64): (i64, Error) {
    if n < 0 { return 0, Parse(i32(n)) }
    return n, null
}

bump(p: *Point) {
    p.x += 1
}

main(): int {
    a: Point = shift(Point{x = 1, y = 0.5}, 2)
    b: Point = a
    bump(&b)
    n: i64, err: Error = check(shift(b, 1).x)
    if err != null { return int(err.code) }
    return int(n - a.x)
}
