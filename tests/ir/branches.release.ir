pick(i64, i64, bool): i64 {
b0:
    %0 = param i64 0
    %1 = param i64 1
    %2 = param bool 2
    br %2, b2, b3
b1: ; preds b2, b4
    %4 = phi i64 [%1, b2], [%10, b4]
    ret %4
b2: ; preds b0
    %6 = lt bool %0, %1
    br %6, b1, b5
b3: ; preds b5, b0
    %8 = neg i64 %0
    jmp b4
b4: ; preds b5, b3
    %10 = phi i64 [%0, b5], [%8, b3]
    jmp b1
b5: ; preds b2
    %12 = eq bool %0, %1
    br %12, b3, b4
}

both(i32, i32): bool {
b0:
    %0 = param i32 0
    %1 = param i32 1
    %2 = const i32 0
    %3 = gt bool %0, %2
    br %3, b1, b2
b1: ; preds b0
    %5 = const i32 0
    %6 = gt bool %1, %5
    jmp b3
b2: ; preds b0
    %8 = const bool false
    jmp b3
b3: ; preds b1, b2
    %10 = phi bool [%6, b1], [%8, b2]
    ret %10
}

within(u8, u8, u8): bool {
b0:
    %0 = param u8 0
    %1 = param u8 1
    %2 = param u8 2
    %3 = le bool %0, %1
    %4 = lt bool %1, %2
    %5 = and bool %3, %4
    ret %5
}

main(): i64 {
b0:
    %0 = const i64 1
    %1 = const i64 2
    %2 = const bool true
    %3 = call i64 pick(%0, %1, %2)
    %4 = const i64 2
    %5 = ne bool %3, %4
    br %5, b1, b2
b1: ; preds b0
    %7 = const i64 1
    ret %7
b2: ; preds b0
    %9 = const i64 0
    ret %9
}

