/* A loop's variables meet at the head in phis; one the loop never changes
 * gets none. */

gcd(a: u64, b: u64): u64 {
    x: u64 = a
    y: u64 = b
    for y != 0 {
        t: u64 = x % y
        x = y
        y = t
    }
    return x
}

main(): int {
    if gcd(12, 18) != 6 { return 1 }
    return 0
}
