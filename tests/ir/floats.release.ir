mix(f64, f32, i32): f64 {
b0:
    %0 = param f64 0
    %1 = param f32 1
    %2 = param i32 2
    %3 = const f64 2.0
    %4 = mul f64 %0, %3
    %5 = cast f64 %1
    %6 = const f64 3.0
    %7 = div f64 %5, %6
    %8 = add f64 %4, %7
    %9 = const f64 -2.5
    %10 = lt bool %8, %9
    br %10, b1, b3
b1: ; preds b0, b3
    %12 = neg f64 %8
    jmp b2
b2: ; preds b3, b1
    %14 = phi f64 [%8, b3], [%12, b1]
    %15 = cast f64 %2
    %16 = add f64 %14, %15
    %17 = const f64 0.1
    %18 = sub f64 %16, %17
    ret %18
b3: ; preds b0
    %20 = const f64 1e+300
    %21 = ge bool %0, %20
    br %21, b2, b1
}

narrow(f32): u8 {
b0:
    %0 = param f32 0
    %1 = cast u8 %0
    ret %1
}

show(f32, ptr, ptr): i32 {
b0:
    %0 = param f32 0
    %1 = param ptr 1
    %2 = param ptr 2
    %3 = const u64 8
    %4 = cast f64 %0
    %5 = call i32 snprintf(%1, %3, %2, ... %4)
    ret %5
}

main(): i64 {
b0:
    %0 = const f64 1.25
    %1 = const f32 0.5
    %2 = const i32 7
    %3 = call f64 mix(%0, %1, %2)
    %4 = const f64 0.0
    %5 = gt bool %3, %4
    br %5, b1, b2
b1: ; preds b0
    %7 = const i64 1
    ret %7
b2: ; preds b0
    %9 = const f32 300.5
    %10 = call u8 narrow(%9)
    %11 = const u8 44
    %12 = ne bool %10, %11
    br %12, b3, b4
b3: ; preds b2
    %14 = const i64 2
    ret %14
b4: ; preds b2
    %16 = const i64 0
    ret %16
}

