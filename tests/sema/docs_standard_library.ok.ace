/*
Mirrors docs/standard-library.md fmt and sys examples (sema check only;
runtime coverage lives in tests/emit/print_*.ace, tests/emit/sys.ace, and
tests/emit/sys_time.ace).
*/
import fmt
import sys

write_note(): int {
    fd: sys.Fd, err: Error = sys.open("/tmp/notes.txt",
                                      sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC,
                                      u32(0x1A4))
    if err != null {
        return 1
    }
    n: int, werr: Error = sys.write(fd, "hello sys")
    if werr != null {
        return 2
    }
    if sys.close(fd) != null {
        return 3
    }
    return 0
}

check_missing(): int {
    fd: sys.Fd, err: Error = sys.open("/tmp/missing", sys.O_RDONLY)
    if err != null {
        if sys.errno() == 2 {
            return 1
        }
    }
    return 0
}

print_examples(): int {
    fmt.print("ready")
    fmt.print(42)
    fmt.print(uint(7))
    fmt.print(usize(7))
    fmt.print(0.5)
    fmt.print(1.0e21)
    narrow: u16 = 7
    return int(fmt.print(uint(narrow)) - 1)
}

println_examples(): int {
    fmt.println("ready")
    fmt.println(42)
    fmt.println(0.5)
    if fmt.println("") != 1 {
        return 1
    }
    narrow: u16 = 7
    if fmt.println(int(narrow)) != 3 {
        return 2
    }
    return 0
}

printf_examples(): int {
    name: string = "Ace"
    count: int = 3
    ratio: f64 = 1.25
    written: int = fmt.printf("name=%s count=%d ratio=%.2f\n",
                              name, count, ratio)
    if written != 28 {
        return 1
    }
    byte: u8 = u8(65)
    fmt.printf("%u %x %X %f %c %%", uint(7), usize(15), uint(15),
               f32(0.5), byte)
    return 0
}

time_mono_example(): int {
    start: u64 = sys.time_mono(false)
    sum: int = 0
    for i: int in 0 .. 1_000_000 {
        sum += i
    }
    elapsed_ns: u64 = sys.time_mono(false) - start
    if elapsed_ns == 0 {
        return 1
    }
    return 0
}

main(): int {
    code: int = write_note()
    if code != 0 {
        return code
    }
    code = check_missing()
    if code != 0 {
        return 10 + code
    }
    code = print_examples()
    if code != 0 {
        return 20 + code
    }
    code = println_examples()
    if code != 0 {
        return 30 + code
    }
    code = printf_examples()
    if code != 0 {
        return 40 + code
    }
    return time_mono_example()
}
