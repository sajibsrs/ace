// Mirrors docs/standard-library.md sys examples (sema check only; runtime
// coverage lives in tests/emit/sys.ace and tests/emit/sys_time.ace).
import sys

write_note(): int {
    fd: sys.Fd, err: Error = sys.open("/tmp/notes.txt",
                                      sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC,
                                      u32(0x1A4))
    if err != null {
        return 1
    }
    n: int, werr: Error = sys.write(fd, "hello sys")
    if werr != null {
        return 2
    }
    if sys.close(fd) != null {
        return 3
    }
    return 0
}

check_missing(): int {
    fd: sys.Fd, err: Error = sys.open("/tmp/missing", sys.O_RDONLY)
    if err != null {
        if sys.errno() == 2 {
            return 1
        }
    }
    return 0
}

time_mono_example(): int {
    start: u64 = sys.time_mono(false)
    sum: int = 0
    for i: int in 0 .. 1_000_000 {
        sum += i
    }
    elapsed_ns: u64 = sys.time_mono(false) - start
    if elapsed_ns == 0 {
        return 1
    }
    return 0
}

main(): int {
    code: int = write_note()
    if code != 0 {
        return code
    }
    code = check_missing()
    if code != 0 {
        return 10 + code
    }
    return time_mono_example()
}
