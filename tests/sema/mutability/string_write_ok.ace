/* Indexed byte writes exist only through a mut string (Sequences #11): one
 * byte per write, u8 or char, through locals, re-sliced views, unmarked
 * parameters of type mut string, and writable pointers into the bytes. */

set_bytes(text: mut string) { // content permission rides the view's type
    text[0] = 'H'
    text[1] = 105
}

bump(pointer: mut *u8) { // mut &item yields mut *u8 over the byte storage
    ~pointer = ~pointer + 1
}

main(): int {
    storage: [8]u8
    text: mut string = string(mut storage[0..])
    set_bytes(text)
    if text[0] != 72 || text[1] != 105 {
        return 1
    }
    tail: mut string = text[2..] // slicing propagates the permission
    tail[0] = '!'
    if text[2] != 33 {
        return 2
    }
    text[3] += 1 // compound writes re-read through the view
    if text[3] != 1 {
        return 3
    }
    bump(mut &text[4]) // mut & yields a writable pointer into the bytes
    if text[4] != 1 {
        return 4
    }
    return 0
}
