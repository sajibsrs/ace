/* err: a plain string is a read-only view regardless of the descriptor axis —
 * indexed byte writes exist only through 'mut string' (Sequences #11). */

write_byte(text: string) { // even writable local storage proves nothing
    text[0] = 'x'
}

main(): int {
    s: string = "abc"
    s[1] = 'y'
    return 0
}
