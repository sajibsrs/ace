/* Type-position mutability (Mutability #9-11, Sequences #1): mut []T and
 * mut string as distinct view types, implicit permission shrink, slicing
 * propagation, the mut x[lo..hi] establishment form, and distinct
 * instantiations through overloads, generics, and struct fields. */

import mem

Box[T]: struct { v: T }

Store: struct { bytes: mut []u8, text: mut string }

plain_len(s: string): int {
    return int(s.len)
}

mut_len(s: mut string): int {
    return int(s.len)
}

pick(s: string): int {
    return 1
}

pick(s: mut string): int {
    return 2
}

first[T](values: []T): T {
    return values[0]
}

id(text: string): string {
    return text
}

main(): int {
    // Establishment from writable-lvalue sources; literals cannot establish.
    backing: []u8 = mem.alloc(4, 1)
    w: mut []u8 = mut backing[0..4]
    w[0] = 40
    w[1] = 2

    // Permission shrink is implicit; widening is not.
    r: []u8 = w
    if plain_len_of(w) != 0 {
        return 1
    }

    // Slicing propagates permission in the type, no new marker.
    tail: mut []u8 = w[2..4]
    tail[0] = 42
    if backing[2] != 42 {
        return 2
    }
    plain_tail: []u8 = w[2..4]

    // mut string exists: same .len, equality, and null semantics.
    source: string = id("ace")
    ms: mut string = mut source[0..]
    if ms.len != 3 {
        return 3
    }
    if ms != source || source != ms {
        return 4
    }
    if ms == null {
        return 5
    }
    ms_slice: mut string = ms[1..]
    if plain_len(ms_slice) != 2 {
        return 6
    }
    if mut_len(ms) != 3 {
        return 7
    }

    // Overloads distinguish the mut-qualified type distinctly.
    if pick(source) != 1 || pick(ms) != 2 {
        return 8
    }

    // Generic instantiations are distinct types.
    a: Box[string] = Box[string] { v: source }
    b: Box[mut string] = Box[mut string] { v: ms }
    if a.v.len != 3 || b.v.len != 3 {
        return 9
    }

    // Struct fields hold mut-qualified views.
    store: Store = Store { bytes: mut backing[0..4], text: ms }
    if store.bytes.len != 4 || store.text.len != 3 {
        return 10
    }

    // in mut iteration over a mut slice aliases without a storage check.
    total: int = 0
    for x: u8 in mut w {
        total += int(x)
    }
    if total != 84 {
        return 11
    }

    // Plain and mut byte views compare by content.
    if w != r || tail != plain_tail {
        return 12
    }

    // Generic function instantiation keeps explicit type arguments.
    names: [1]string = ["x"]
    if first[string](names[0..1]) != "x" {
        return 13
    }
    return 0
}

plain_len_of(v: []u8): int {
    return int(v.len)
}
