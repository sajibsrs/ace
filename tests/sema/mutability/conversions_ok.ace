/* string, []char, and []u8 are intent spellings of one view type; writable
 * spellings likewise share identity and permission. */

alias_view(views: []char): string {
    return views
}

from_call_result(view: []u8): string { // selection is type-driven
    return view
}

round_trip(text: string): []u8 {
    return text
}

shrink(text: string): string {
    return text // permission shrink is implicit; widening never
}

main(): int {
    storage: [6]u8
    view: []u8 = storage[0..6]
    text: string = view
    w: string = text
    plain: string = view[0..3]
    p: string = plain
    back: []u8 = text
    b: []u8 = back // and its result shrinks like any writable view
    chars: []char = view
    same: string = chars
    if w.len != 6 || back.len != 6 || b.len != 6 { return 1 }
    if plain.len != 3 || p.len != 3 || same.len != 6 || alias_view(view).len != 3 { return 2 }
    return 0
}
