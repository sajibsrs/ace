/* The three exact view conversions (Sequences #4, #6): string over []u8 and
 * mut []u8 with the result following the argument's stated type, []u8 over
 * mut string only, and no other spelling in either direction. */

alias_view(views: []char): string { // transparent aliases convert identically
    return string(views)
}

from_call_result(view: mut []u8): mut string { // selection is type-driven
    return string(view) // a call result is not an lvalue; the stated type rules
}

round_trip(text: mut string): mut []u8 {
    return []u8(text)
}

shrink(text: mut string): string {
    return text // permission shrink is implicit; widening never
}

main(): int {
    storage: [6]u8
    view: mut []u8 = mut storage[0..6]
    text: mut string = string(view) // mut []u8 carries its permission across
    w: mut string = text
    plain: string = string(view[0..3]) // a plain view yields a plain string
    p: string = plain
    back: mut []u8 = []u8(text) // the reverse conversion requires mut string
    b: []u8 = back // and its result shrinks like any writable view
    chars: []char = view
    same: string = string(chars)
    if len(w) != 6 || len(back) != 6 || len(b) != 6 {
        return 1
    }
    if len(plain) != 3 || len(p) != 3 || len(same) != 6 || len(alias_view(view)) != 3 {
        return 2
    }
    return 0
}
