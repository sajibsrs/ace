/* err: `in mut` requires a mut string view to alias string bytes — a plain
 * string is a read-only view, so iteration may not opt it into aliasing
 * (Iterations #16, Mutability #9). */

main(): int {
    s: string = "abc"
    total: int = 0
    for c: u8 in mut s { total += int(c) }
    return 0
}
