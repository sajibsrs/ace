/* An array literal selects an overload by its candidate element type. */

take(xs: []u8): int { return 1 }
take(x: int): int { return 2 }

both(xs: []f64): int { return 1 }
both(xs: []int): int { return 2 }

main(): int {
    a: int = take([1, 2])
    b: int = both([1, 2.5])
    c: int = both([])
    d: int = take(['a', 300])
    x: int = 10
    e: int = take(['a', x])
    return a + b + c + d + e
}
