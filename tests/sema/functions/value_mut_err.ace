/* A function value's mut positions are part of its type and checked at calls. */

Box: struct { n: int }

bump(mut b: Box) {
    b.n += 1
}

look(b: Box) {
}

main(): int {
    plain: (Box): void = bump
    marked: (mut b: Box): void = look
    f: (mut b: Box): void = bump
    b: Box = blank(Box)
    f(b)
    g: (Box): void = look
    g(mut b)
    return 0
}
