/* Unary dereference, complement, and negation have distinct operand types. */

main(): int {
    left: int = 6
    right: int = 7
    left_pointer: mut *int = mut &left
    right_pointer: *int = &right
    outer: *mut *int = &left_pointer

    **outer += 1
    alias: *int = &*left_pointer
    product: int = *alias * *right_pointer
    inverted: u32 = ~u32(0xFFFFFFD5)
    running: bool = false
    stopped: bool = !running

    if product != 49 || inverted != 42 || !stopped {
        return 1
    }
    return 0
}
