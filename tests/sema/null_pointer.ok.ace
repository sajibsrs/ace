// Plain pointer values carry null directly; the branch is an explicit runtime check.
Point: struct { x: f32 }

maybe(p: *Point): f32 {
    if p != null {
        return p.x
    }
    return 0.0
}

later(p: *Point): f32 {
    if p == null {
        return 0.0
    } else {
        return p.x
    }
}
