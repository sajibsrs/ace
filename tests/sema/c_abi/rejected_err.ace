/* C ABI rejected fixture. */

Flag: enum { off, on }
Shape: contract { area(self): f64 }
Event: union { none, value: i32 }
BadDistinct: distinct string
BadField: struct { text: string }
Box[T]: struct { value: T }

extern "c" {
    bad_enum(value: Flag)
    bad_string(value: string)
    bad_slice(value: []u8)
    bad_contract(value: Shape)
    bad_union(value: Event)
    bad_error(value: Error)
    bad_typeid(value: typeid)
    bad_tuple(): (i32, i32)
    bad_function(value: (i32): i32)
    bad_array(value: [4]i32): [4]i32
    bad_pointer(value: *string)
    bad_distinct(value: BadDistinct)
    bad_field(value: BadField)
    bad_stamp(value: Box[i32])
}

extern "c" bad_mut(mut value: i32) {
}

extern "c" bad_generic[T](value: T) {
}

plain(value: mut *u8): mut *u8 {
    return value
}

bad_callback_param: extern "c" (string): i32 = null
bad_callback_return: extern "c" (): string = null
wrong_convention: extern "c" (mut *u8): mut *u8 = plain
