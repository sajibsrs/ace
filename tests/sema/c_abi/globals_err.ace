/* C global variables (C Interop #6): C-ABI types at struct-field position,
 * writable like any global.
 */

extern "c" {
    bad_text: string
    bad_bytes: []u8
    limit: i32
    names: [4]i32
}

main(): int {
    limit = 3
    pointer: *i32 = &limit
    view: []i32 = names[0..4]
    names[0] = 1
    return 0
}
