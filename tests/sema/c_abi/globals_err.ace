/* C global variables (C Interop #6): C-ABI types at struct-field position,
 * read-only unless mut.
 */

extern "c" {
    bad_text: string
    bad_bytes: []u8
    limit: i32
    names: [4]i32
}

main(): int {
    limit = 3
    pointer: mut *i32 = mut &limit
    view: mut []i32 = mut names[0..4]
    names[0] = 1
    return 0
}
