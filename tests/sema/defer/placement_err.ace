/* `defer` is only valid as a direct statement of the function's top-level
 * body block. Every defer below sits in a nested block — if, for, a switch
 * case, and a labeled block — so each must be rejected. */

touch(): int {
    return 1
}

main(): int {
    if true { defer touch() }
    for i: int in 0 .. 2 { defer touch() }
    switch 1 {
        1 {
            defer touch()
        }
        default {
        }
    }
    outer: {
        defer touch()
    }
    return 0
}
