/* `defer` is valid as a direct statement of a function's top-level body
 * block: function calls, method calls through the receiver-marked `mut`
 * form, and multi-return calls discarded like ordinary call statements. */

Counter: struct { value: int }

mut Counter.add(amount: int) {
    self.value = self.value + amount
}

record(): (int, Error) {
    return 0, null
}

begin(): int {
    defer record()
    return 1
}

solo(): int {
    defer record()
    return 2
}

several(): int {
    defer record()
    counter: Counter = Counter { value = 5 }
    defer mut counter.add(1)
    if false { return 9 }
    defer record()
    return 3
}

main(): int {
    defer record()
    begin()
    solo()
    several()
    return 0
}
