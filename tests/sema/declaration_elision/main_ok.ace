/* := adopts one initializer's independently determined type. */

Point: struct { x: int, y: int }

identity(value: int): int {
    return value
}

main(): int {
    base: int = 40
    answer := identity(base + 2)
    text := "ace"
    byte := 'A'
    ratio := 1.5
    point := Point { x: 20, y: 22 }
    if text.len != 3 || byte != u8('A') || ratio != 1.5 ||
        point.x + point.y != 42 {
        return 1
    }
    scope: {
        answer := answer + 1
        if answer != 43 {
            return 2
        }
    }
    return answer - 42
}
