/* Fallthrough context fixture. */

fallthrough(): int {
    return 1
}

ordinary_identifier(): int {
    fallthrough: int = 1

    if fallthrough == 1 {
        fallthrough
    }
    return fallthrough
}

main(): int {
    value: int = fallthrough()
    value += ordinary_identifier()

    switch value {
        0 {
            fallthrough()
        }
        else {}
    }
    return value
}
