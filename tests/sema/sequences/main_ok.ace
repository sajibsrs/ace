/* Sequence-overlap carve implementation (Sequences #1-9): string slicing,
 * shared string/[]char/[]u8 view identity, byte iteration, and the
 * constant-provable slice-bounds compile check. */

import mem

greeting: const string = "hello"

sum(text: string): int {
    total: int = 0

    for c: u8 in text { total += int(c) }
    return total
}

main(): int {
    a: string = greeting[0..5]

    if !mem.equal(a, "hello") { return 1 }

    if a.len != 5 || a[0] != 'h' || a[4] != 'o' { return 2 }

    if !mem.equal(greeting[..], "hello") || !mem.equal(greeting[1..], "ello") ||
       !mem.equal(greeting[..4], "hell") || greeting[2..2].len != 0 {
        return 3
    }

    if sum("abc") != int('a') + int('b') + int('c') { return 4 }
    total: int = 0
    at: usize = 0

    for i: usize, c: char in greeting[1..3] {
        total += int(c) + int(i)
        at += i
    }

    if total != int('e') + int('l') + 1 { return 5 }
    arr: [3]u8 = [u8('o'), u8('k'), u8('!')]
    view: string = arr[0..3]

    if !mem.equal(view, "ok!") { return 6 }
    arr[0] = u8('n')

    if !mem.equal(view, "nk!") { return 7 }

    if arr[0..1][0] != u8('n') { return 8 }

    if !mem.equal("hello"[1..3], "el") || "hello".len != 5 { return 9 }
    base: string = "hello"
    re: string = base[1..4]

    if !mem.equal(re[1..], "ll") { return 10 }
    return 0
}
