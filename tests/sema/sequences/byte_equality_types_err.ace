/* Sequential values have no == or != operators. */

Bytes: union { none, data: []u8 }

main(): int {
    bytes: [2]u8 = [65, 66]
    other_bytes: [2]u8 = [65, 66]
    words: [2]u16 = [65, 66]
    other_words: [2]u16 = [65, 66]
    byte_view: []u8 = bytes[0..2]
    other_byte_view: []u8 = other_bytes[0..2]
    text: string = "AB"

    if bytes == other_bytes {}
    if words != other_words {}
    if byte_view == other_byte_view {}
    if text != "AB" {}

    left: Bytes = Bytes.data(byte_view)
    right: Bytes = Bytes.data(other_byte_view)
    if left == right {}
    return 0
}
