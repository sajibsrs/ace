/* Compiler-checked examples from docs/memory.md. */

import array
import mem

@packed
Packet: struct {
    packet_type: u8,

    @align(4)
    length: u32,
    tail: u16,
}

static_assert(offsetof(Packet, length) == 4)
static_assert(offsetof(Packet, tail) == 8)
static_assert(sizeof(Packet) == 12)
static_assert(alignof(Packet) == 4)

ViewP: struct { x: i32 }

write_through_view() {
    a: array.Array[ViewP] = array.Array[ViewP] {}
    defer a.wipe()
    _ = a.push(ViewP { x = 1 })
    a.view()[0].x = 5 // marks view(), writes element 0 in place
}

main(): int {
    packet: Packet = Packet {
        packet_type = 0,
        length = 1,
        tail = 2,
    }
    volatile packet.packet_type = 3
    packet_type: u8 = volatile packet.packet_type
    if packet_type != 3 { return 4 }
    values: [4]u8 = [10, 20, 30, 40]
    count: usize = values.len
    pointer: *u8 = &values[0]
    address: usize = usize(pointer)
    restored: *u8 = *u8(address)
    constructed: []u8 = []u8(restored, count)

    if count != 4 || constructed.len != 4 { return 1 }

    storage: []u8 = mem.alloc(16, 8)

    if storage != null {
        bytes: usize = storage.len

        if bytes != 16 {
            mem.release(&storage)
            return 2
        }
        mem.release(&storage)

        if storage != null { return 3 }
    }

    source_array: [3]u8 = [10, 20, 30]
    target_array: [4]u8 = [0, 0, 0, 99]
    source: []u8 = source_array[0..3]
    target: []u8 = target_array[0..3]
    mem.copy(target, source)

    if mem.compare(target, source) != 0 { return 4 }
    if !mem.equal(target, source_array) { return 9 }
    mem.fill(target, 7)
    mem.zero(target)

    overlap_src: []u8 = target_array[0..2]
    overlap_dst: []u8 = target_array[1..3]
    mem.move(overlap_dst, overlap_src)

    numbers: []usize = mem.alloc[usize](4)

    if numbers != null {
        if numbers.len != 4 {
            mem.release[usize](&numbers)
            return 5
        }
        numbers[0] = 42

        if numbers[0] != 42 {
            mem.release[usize](&numbers)
            return 6
        }
        mem.release[usize](&numbers)

        if numbers != null { return 7 }
    }

    empty: []usize = mem.alloc[usize](0)

    if empty != null { return 8 }
    return 0
}
