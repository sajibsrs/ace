/* Compiler-checked examples from docs/memory.md. */

import mem

@packed
Packet: struct {
    kind: u8,

    @align(4)
    length: u32,
    tail: u16,
}

static_assert(offsetof(Packet, length) == 4)
static_assert(offsetof(Packet, tail) == 8)
static_assert(sizeof(Packet) == 12)
static_assert(alignof(Packet) == 4)

main(): int {
    packet: Packet = Packet { kind = 0, length = 1, tail = 2 }
    volatile packet.kind = 3
    kind: u8 = volatile packet.kind
    if kind != 3 {
        return 4
    }
    values: [4]u8 = [10, 20, 30, 40]
    count: usize = values.len
    pointer: mut *u8 = mut &values[0]
    address: usize = usize(pointer)
    restored: mut *u8 = mut *u8(address)
    constructed: mut []u8 = mut []u8(restored, count)

    if count != 4 || constructed.len != 4 {
        return 1
    }

    storage: mut []u8 = mem.alloc(16, 8)

    if storage != null {
        bytes: usize = storage.len

        if bytes != 16 {
            mem.release(mut storage)
            return 2
        }
        mem.release(mut storage)

        if storage != null {
            return 3
        }
    }

    source_array: [3]u8 = [10, 20, 30]
    target_array: [4]u8 = [0, 0, 0, 99]
    source: []u8 = source_array[0..3]
    target: mut []u8 = mut target_array[0..3]
    mem.copy(target, source)

    if mem.compare(target, source) != 0 {
        return 4
    }
    if !mem.equal(target, source_array) {
        return 9
    }
    mem.fill(target, 7)
    mem.zero(target)

    overlap_src: []u8 = target_array[0..2]
    overlap_dst: mut []u8 = mut target_array[1..3]
    mem.move(overlap_dst, overlap_src)

    numbers: mut []usize = mem.alloc[usize](4)

    if numbers != null {
        if numbers.len != 4 {
            mem.release[usize](mut numbers)
            return 5
        }
        numbers[0] = 42

        if numbers[0] != 42 {
            mem.release[usize](mut numbers)
            return 6
        }
        mem.release[usize](mut numbers)

        if numbers != null {
            return 7
        }
    }

    empty: []usize = mem.alloc[usize](0)

    if empty != null {
        return 8
    }
    return 0
}
