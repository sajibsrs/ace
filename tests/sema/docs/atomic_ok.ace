/* Compiler-checked examples from docs/std/atomic.md. */
import atomic

count: u32

bump(): u32 {
    return atomic.add(&count, 1)
}

claim(flag: *u32): bool {
    seen: u32 = 0
    won: bool = false
    seen, won = atomic.cas_acq_rel(flag, 0, 1)
    return won
}

main(): int {
    flag: u32 = 0
    if !claim(&flag) || claim(&flag) { return 1 }
    return int(bump())
}
