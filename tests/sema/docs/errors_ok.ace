FileError: error {
    0: unknown = "unknown file failure"
    2: not_found = "file not found"
}
Alias: type = FileError
fs_read(path: string): ([]u8, Error) {
    if len(path) == 0 {
        return null, FileError(2)
    }
    return null, null
}
main(): int {
    data: []u8, error: Error = fs_read("")
    if error != null && error.domain == typeid(FileError) && error.code == 2 {
        data = null
    }
    if sizeof(Error) != 8 || typeid(FileError) != typeid(Alias) {
        panic("invalid Error representation")
    }
    if FileError.not_found != FileError(2) || FileError.unknown == null {
        panic("invalid named Error entry")
    }
    if len(error.name) != 9 || len(error.message) != 14 {
        panic("invalid Error description")
    }
    return int(len(data))
}
