/* Compiler-checked examples from docs/function.md. */

add(a: int, b: int): int {
    return a + b
}

log_ready() {
}

increment(mut value: int) {
    value += 1
}

divide(value: int, by: int): (int, int) {
    return (value / by, value % by)
}

long_parameter_list(url: string, config: int, policy: int, mut client: int): int {
    client += config + policy
    return int(url.len) + client
}

render(value: string): int {
    return int(value.len)
}

render(value: int): int {
    return value
}

twice(value: int): int {
    return value * 2
}

twice(value: f64): f64 {
    return value * 2.0
}

choose[T](first: T, second: T): T {
    return second
}

pick[T](a: T, b: T): T {
    return a
}

pick[int](a: int, b: int): int {
    return b
}

count_of[T](v: T): int specialized

count_of[int](v: int): int {
    return 8
}

count_of[f64](v: f64): int {
    return 4
}

inline mix(value: u64): u64 {
    x: u64 = value ^ (value >> 31)
    return x * 3
}

Buffer: struct { at: usize }

pub inline mut Buffer.skip(n: usize) {
    self.at += n
}

count_down(n: usize, total: usize): usize {
    if n == 0 { return total }
    return count_down(n - 1, total + n)
}

main(): int {
    b: Buffer = Buffer{ at = 0 }
    mut b.skip(2)
    count: int = 12 + int(mix(u64(b.at))) - 6
    increment(mut count)
    quotient: int, remainder: int = divide(count, 5)
    operation: (int): int = twice
    counted: int = count_of[int](0) + count_of[f64](0.5)
    return add(render("ace"), render(13)) + quotient + remainder +
        operation(5) + choose[int](1, 2) + pick[int](3, 4) +
        int(pick[string]("a", "b")[0] - 'a') + later(1) - 29 + counted - 12
}

later(value: int): int {
    return value
}

Point: struct { x: f32, y: f32 }

extern "c" {
    translate(point: Point, dx: f32, dy: f32): Point
    c_variadic(tag: i32, ...): i32
}

export increment_c(value: mut *i32): i32 {
    *value += 1
    return *value
}

check_c_variadic(): i32 {
    value: i32 = 11
    return c_variadic(0, i32(9), f32(1.25), &value)
}
