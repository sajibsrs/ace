/* Compiler-checked examples from docs/primitives.md. */

import fmt

Point: struct { x: int, y: int }

dynamic_byte(text: string, index: i32): u8 {
    return text[index]
}

main(): int {
    signed_word: int = 13
    unsigned_word: uint = 13
    small: i8 = 13
    byte_value: u8 = 255
    wide: int = int(small)
    unsigned: uint = uint(wide)
    single: f32 = 1.5
    double: f64 = 1.5
    default_width: float = 1.5
    same_identity: float = double
    same_identity_back: f64 = default_width
    converted: f64 = f64(single)
    ready: bool = true
    stopped: bool = !ready
    letter: u8 = 'A'
    newline: u8 = '\n'
    hex_escape: u8 = '\x41'
    direct: char = 'A'
    as_byte: u8 = direct
    back: char = as_byte
    bytes: [2]char = [direct, newline]
    message: string = "Welcome Ace!\n"
    length: usize = message.len
    fmt.print(length)
    first: u8 = message[0]
    second: u8 = dynamic_byte(message, 1)
    id: typeid = null
    n: int = 7
    max: int = 5
    limit: int = n > max ? max : n
    empty: bool = false
    data: string = message
    view: []u8 = empty ? null : data[..2]
    flipped: bool = true
    origin: Point = flipped ? { x = 1, y = 0 } : { x = 0, y = 1 }
    nested: int = empty ? 1 : (flipped ? 2 : 3)
    repeated: [3]int = [(flipped ? limit : max) : 3]

    if int(as_byte) != 65 || back != direct { return 90 }
    if view.len != 2 || origin.x != 1 || nested != 2 || repeated[2] != 5 { return 91 }
    return signed_word + int(unsigned_word) + int(byte_value) + wide +
        int(unsigned) + int(double) + int(default_width) - int(same_identity) +
        int(same_identity_back) + int(converted) + int(letter) +
        int(newline) + int(hex_escape) + int(length) + int(first) + int(small) +
        int(bytes[1]) + int(second)
}
