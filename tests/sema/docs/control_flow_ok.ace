/* Compiler-checked examples from docs/control-flow.md. */

main(): int {
    values: [4]i32 = [10, 20, 30, 40]
    category: i32 = 0
    value: i32 = 3
    limit: i32 = 5

    if value < 0 {
        category = -1
    } else if value == 0 {
        category = 0
    } else {
        category = 1
    }
    inside: bool = 0 <= value < limit

    switch value {
        3 {
            category += 1
            fallthrough
        }
        4 {
            category += 1
        }
        default {}
    }

    for i: int in 0 .. 4 {
        i = 0
    }

    for i: int in 4 .. 0 {
        i = 0
    }
    step: int = 2

    for i: int in 0 .. 4 step step {
        i = 0
    }

    for item: i32 in values {
        value = item
    }

    for index: usize, item: i32 in values {
        values[index] = item + 1
    }

    for index: usize in 0 .. values.len {
        index = 0
    }

    work: {
        for item: i32 in values {
            if item < 0 {
                break work
            }
        }
    }
    repeats: int = 0

    retry: {
        repeats += 1

        if repeats < 2 {
            continue retry
        }
    }

    if inside && category == 3 {
        return 0
    }
    text: string = "héllo"
    total: usize = 0

    for c: u8 in text {
        total += usize(c)
    }

    for index: usize, byte: char in text {
        total += usize(byte) + index
    }

    if total == 0 {
        return 1
    }

    // Loop heads: condition-only, infinite, and three-clause forms
    running: bool = true
    for running {
        running = false
    }

    for {
        break
    }

    for i: int = 0; i < 4; i += 1 {
        total += usize(i)
    }

    n: int = 0
    for n = 1; n < 3; n += 1 {
        total += usize(n)
    }

    // Labels on loops: nearest-loop binding, labeled continue advances
    outer: for i: int in 0 .. 3 {
        inner: for j: int in 0 .. 3 {
            if j == 2 {
                continue inner
            }
            if i == 1 {
                continue outer
            }
            if i == 2 {
                break outer
            }
        }
    }

    // Mutating iteration: the value binder aliases the element, so writes
    // land in the backing array; the index binder stays a plain copy
    xs: [4]i32 = [1, 2, 3, 4]
    for item: i32 in mut xs {
        item *= 10
    }
    if xs[0] != 10 || xs[3] != 40 {
        return 1
    }

    for index: usize, item: i32 in mut xs {
        item += i32(index)
    }
    if xs[3] != 43 {
        return 1
    }

    // A plain loop keeps its per-iteration copy
    for item: i32 in xs {
        item = 0
    }
    if xs[0] != 10 {
        return 1
    }
    return 0
}
