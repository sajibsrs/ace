/*
 * Mirrors docs/standard-library.md mem, fmt, sys, net, and str examples (sema
 * check only; runtime coverage lives in tests/emit/fmt/*.ace,
 * tests/emit/sys/main.ace, tests/emit/sys/standard_descriptors.ace,
 * tests/emit/sys/time.ace, tests/emit/sys/process_control.ace,
 * tests/emit/net/main.ace,
 * tests/emit/net/poll.ace, tests/emit/allocation/typed.ace, and tests/emit/strings/*.ace).
 */

import fmt
import mem
import net
import poll
import str
import sys

WOULD_BLOCK: const i32 = sys.EWOULDBLOCK
TRY_AGAIN: const i32 = sys.EAGAIN

str_examples(): int {
    at: usize, found: bool = str.find("hello world", "world")

    if !found {
        return 1
    }
    trimmed: string, hit: bool = str.trim("hello world", "world", true)

    if !hit || !mem.equal(trimmed, "hello ") {
        return 2
    }
    n: int, ok: bool = str.parse[int]("-42")

    if !ok || n != -42 {
        return 3
    }
    r: usize, radix_ok: bool = str.parse[usize]("ff", u8(16))

    if !radix_ok || r != 255 {
        return 4
    }
    buf: [32]u8 = [0 : 32]
    dst: mut []u8 = mut buf[0..32]
    count: usize, fit: bool = str.format(dst, n)

    if !fit || count != 4 {
        return 5
    }
    return 0
}

mem_examples(): int {
    data: mut []u8 = mem.alloc(64, 8)

    if data == null {
        return 1
    }
    mem.release(mut data)

    numbers: mut []usize = mem.alloc[usize](4)

    if numbers == null {
        return 2
    }

    numbers[0] = 42
    mem.release[usize](mut numbers)
    return 0
}

write_note(): int {
    fd: sys.Fd, err: Error = sys.open("/tmp/notes.txt",
                                      sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC,
                                      sys.S_IRUSR | sys.S_IWUSR |
                                      sys.S_IRGRP | sys.S_IROTH)

    if err != null {
        return 1
    }
    n: int, werr: Error = sys.write(fd, "hello sys")

    if werr != null {
        return 2
    }

    if sys.close(fd) != null {
        return 3
    }
    return 0
}

standard_descriptors(): int {
    storage: [8]u8 = [0 : 8]
    buf: mut []u8 = mut storage[0..8]
    n: int, rerr: Error = sys.read(sys.stdin, buf)

    if rerr != null {
        return 1
    }
    w: int, werr: Error = sys.write(sys.stderr, "oops")

    if werr != null || w != 4 {
        return 2
    }
    return 0
}

check_missing(): int {
    fd: sys.Fd, err: Error = sys.open("/tmp/missing", sys.O_RDONLY)

    if err != null {
        if sys.errno() == 2 {
            return 1
        }
    }
    return 0
}

filesystem_examples(): int {
    info: sys.FileInfo, stat_err: Error = sys.stat("/tmp")
    if stat_err != null || info.kind != sys.FileKind.directory {
        return 1
    }
    make_err: Error = sys.mkdir("/tmp/example")
    move_err: Error = sys.rename("/tmp/old", "/tmp/new")
    remove_err: Error = sys.unlink("/tmp/new")
    if make_err != null || move_err != null || remove_err != null {
        return 2
    }

    dir: sys.Dir, open_err: Error = sys.open_dir("/tmp")
    if open_err != null {
        return 3
    }
    storage: [256]u8 = [0 : 256]
    name: mut []u8 = mut storage[0..256]
    count: usize, kind: sys.FileKind, done: bool, read_err: Error = sys.readdir(mut dir, name)
    if read_err != null || (!done && count == 0) || kind == sys.FileKind.symlink {
        sys.close_dir(mut dir)
        return 4
    }
    if sys.close_dir(mut dir) != null {
        return 5
    }
    return 0
}

print_examples(): int {
    fmt.print("ready")
    fmt.print(42)
    fmt.print(uint(7))
    fmt.print(usize(7))
    fmt.print(0.5)
    fmt.print(1.0e21)
    narrow: u16 = 7
    return int(fmt.print(uint(narrow)) - 1)
}

println_examples(): int {
    fmt.println("ready")
    fmt.println(42)
    fmt.println(0.5)

    if fmt.println("") != 1 {
        return 1
    }
    narrow: u16 = 7

    if fmt.println(int(narrow)) != 3 {
        return 2
    }
    return 0
}

printf_examples(): int {
    name: string = "Ace"
    count: int = 3
    ratio: f64 = 1.25
    written: int = fmt.printf("name=%s count=%d ratio=%.2f\n",
                              name, count, ratio)

    if written != 28 {
        return 1
    }
    byte: u8 = u8(65)
    fmt.printf("%u %x %X %f %c %%", uint(7), usize(15), uint(15),
               f32(0.5), byte)
    return 0
}

time_awake_example(): int {
    start: u64 = sys.time_awake()
    sum: int = 0

    for i: int in 0 .. 1_000_000 {
        sum += i
    }
    elapsed_ns: u64 = sys.time_awake() - start

    if elapsed_ns == 0 {
        return 1
    }
    return 0
}

process_example(): int {
    process: sys.Process, fork_err: Error = sys.fork()

    if fork_err != null {
        return 1
    }

    if process == 0 {
        sys.exit(0)
    }
    status: sys.ProcessStatus, wait_err: Error = sys.wait(process)

    if wait_err != null || !status.exited {
        return 2
    }
    return status.code
}

net_example(): int {
    sock: net.Socket, err: Error = net.socket(net.SocketKind.tcp)

    if err != null {
        return 1
    }
    ip: [4]u8 = [u8(127), u8(0), u8(0), u8(1)]
    address: net.Address4 = net.Address4 {ip: ip, port: u16(0)}

    if net.set_reuse_address(sock, true) != null ||
       net.bind(sock, address) != null ||
       net.listen(sock, usize(128)) != null {
        sys.close(sock)
       return 2
    }
    local: net.Address4, local_err: Error = net.local(sock)

    if local_err != null || local.port == 0 {
        sys.close(sock)
        return 4
    }

    if sys.close(sock) != null {
        return 3
    }

    storage: [8]net.Address4
    addresses: mut []net.Address4 = mut storage[0..8]
    count: usize, resolve_err: Error = net.resolve4("example.com", u16(80), addresses)

    if resolve_err == null && count != 0 {
        client: net.Socket, socket_err: Error = net.socket(net.SocketKind.tcp)

        if socket_err == null {
            socket_err = net.connect(client, addresses[0])
            sys.close(client)
        }
    }
    return 0
}

readiness_example(fd: sys.Fd): int {
    q: poll.Queue, err: Error = poll.queue()

    if err != null {
        return 1
    }

    if poll.watch(q, fd, true, false) != null {
        sys.close(sys.Fd(q))
        return 2
    }

    zero: poll.Event = poll.Event {
        fd: sys.Fd(0),
        readable: false,
        writable: false,
        error: false,
        hangup: false,
    }
    storage: [16]poll.Event = [zero : 16]
    events: mut []poll.Event = mut storage[0..16]
    count: usize, wait_err: Error = poll.wait(q, events, poll.wait_forever)

    if wait_err == null {
        for index: usize in 0 .. count {
            if events[index].readable {
                count = index
            }
        }
    }

    poll.unwatch(q, fd)
    sys.close(sys.Fd(q))
    return 0
}

main(): int {
    code: int = mem_examples()

    if code != 0 {
        return code
    }
    code = write_note()

    if code != 0 {
        return code
    }
    code = check_missing()

    if code != 0 {
        return 10 + code
    }
    code = standard_descriptors()

    if code != 0 {
        return 60 + code
    }
    argument_count: usize = sys.argc()
    if argument_count > 0 {
        program: string = sys.arg(0)
        if len(program) == 0 {
            return 61
        }
    }
    environment_count: usize = sys.envc()
    if environment_count > 0 {
        entry: string = sys.env(0)
        if len(entry) == 0 {
            return 62
        }
    }
    code = print_examples()

    if code != 0 {
        return 20 + code
    }
    code = println_examples()

    if code != 0 {
        return 30 + code
    }
    code = printf_examples()

    if code != 0 {
        return 40 + code
    }
    code = str_examples()

    if code != 0 {
        return 50 + code
    }
    return time_awake_example()
}
