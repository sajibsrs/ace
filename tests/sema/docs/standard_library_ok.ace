/*
 * Mirrors docs/std/{bits,fmt,sys,net,tcp,str}.md examples (sema
 * check only; runtime coverage lives in tests/emit/fmt/*.ace,
 * tests/emit/sys/main.ace, tests/emit/sys/standard_descriptors.ace,
 * tests/emit/sys/time.ace, tests/emit/sys/process_control.ace,
 * tests/emit/net/main.ace, tests/emit/tcp/main.ace,
 * tests/emit/net/poll.ace, tests/emit/net/nonblocking_echo.ace,
 * tests/emit/net/nonblocking_chat.ace, tests/emit/allocation/typed.ace,
 * and tests/emit/strings/*.ace).
 */

import bits
import fmt
import math
import mem
import net
import poll
import str
import sys
import time
import net/tcp

WOULD_BLOCK: const i32 = sys.EWOULDBLOCK
TRY_AGAIN: const i32 = sys.EAGAIN

bits_examples(): int {
    raw: u32 = bitcast(u32, f32(1.0))
    ones: uint = bits.popcount(u32(0xF00F))
    high: uint = bits.clz(u16(1))
    low: uint = bits.ctz(u64(8))
    reversed: u32 = bits.bswap(u32(0x12345678))
    rotated: u8 = bits.rotl(u8(0x81), uint(1))
    wrapped: u8 = bits.wradd(u8(250), u8(10))

    if bitcast(u32, bitcast(f32, raw)) != raw || ones != 8 || high != 15 ||
       low != 3 || reversed != u32(0x78563412) || rotated != u8(3) ||
       wrapped != u8(4) {
        return 1
    }
    return 0
}

fast_inverse_sqrt_seed(value: f32): f32 {
    raw: u32 = bitcast(u32, value)
    raw = u32(0x5F3759DF) - (raw >> 1)
    return bitcast(f32, raw)
}

math_examples(value: f64): bool {
    return math.isnan(value) || math.isinf(value) || math.isfinite(value)
}

rounding_examples(value: f64, single: f32): f64 {
    length: f32 = math.sqrt(single)
    return math.floor(value) + math.ceil(value) + f64(length)
}

exponential_examples(value: f64, single: f32): f64 {
    return math.exp(value) + math.log(value) + f64(math.exp(single)) + f64(math.log(single))
}

power_examples(value: f64, single: f32): f64 {
    return math.pow(2.0, value) + f64(math.pow(single, f32(0.5)))
}

trigonometry_examples(angle: f64, single: f32): f64 {
    return math.sin(angle) + math.cos(angle) + f64(math.sin(single)) + f64(math.cos(single))
}

str_examples(): int {
    at: usize, found: bool = str.find("hello world", "world")

    if !found { return 1 }
    trimmed: string, hit: bool = str.trim("hello world", "world", true)

    if !hit || !mem.equal(trimmed, "hello ") { return 2 }
    n: int, ok: bool = str.parse[int]("-42")

    if !ok || n != -42 { return 3 }
    r: usize, radix_ok: bool = str.parse[usize]("ff", u8(16))

    if !radix_ok || r != 255 { return 4 }
    buf: [32]u8 = [0 : 32]
    dst: mut []u8 = mut buf[0..32]
    count: usize, fit: bool = str.format(dst, n)

    if !fit || count != 3 { return 5 }
    fps: int = 60
    frame_ms: f64 = 16.67
    line: [64]u8 = [0 : 64]
    written: usize, ok_line: bool = str.format(mut line[..], "FPS %d, %.2f ms", fps, frame_ms)

    if !ok_line || written != 16 { return 6 }
    return 0
}

mem_examples(): int {
    data: mut []u8 = mem.alloc(64, 8)

    if data == null { return 1 }
    mem.release(mut data)

    numbers: mut []usize = mem.alloc[usize](4)

    if numbers == null { return 2 }

    numbers[0] = 42
    mem.release[usize](mut numbers)
    return 0
}

write_note(): int {
    fd: sys.Fd, err: Error = sys.open(
        "/tmp/notes.txt",
        sys.O_WRONLY | sys.O_CREAT | sys.O_TRUNC,
        sys.S_IRUSR | sys.S_IWUSR | sys.S_IRGRP | sys.S_IROTH,
    )

    if err != null { return 1 }
    n: int, werr: Error = sys.write(fd, "hello sys")

    if werr != null { return 2 }

    if sys.close(fd) != null { return 3 }
    return 0
}

standard_descriptors(): int {
    storage: [8]u8 = [0 : 8]
    buf: mut []u8 = mut storage[0..8]
    n: int, rerr: Error = sys.read(sys.stdin, buf)

    if rerr != null { return 1 }
    w: int, werr: Error = sys.write(sys.stderr, "oops")

    if werr != null || w != 4 { return 2 }
    return 0
}

check_missing(): int {
    fd: sys.Fd, err: Error = sys.open("/tmp/missing", sys.O_RDONLY)

    if err != null {
        if sys.errno() == 2 { return 1 }
    }
    return 0
}

filesystem_examples(): int {
    info: sys.FileInfo, stat_err: Error = sys.stat("/tmp")
    if stat_err != null || info.file_type != sys.FileType.directory { return 1 }
    make_err: Error = sys.mkdir("/tmp/example")
    move_err: Error = sys.rename("/tmp/old", "/tmp/new")
    remove_err: Error = sys.unlink("/tmp/new")
    if make_err != null || move_err != null || remove_err != null { return 2 }

    dir: sys.Dir, open_err: Error = sys.opendir("/tmp")
    if open_err != null { return 3 }
    storage: [256]u8 = [0 : 256]
    name: mut []u8 = mut storage[0..256]
    count: usize, file_type: sys.FileType, done: bool, read_err: Error = sys.readdir(mut dir, name)
    if read_err != null || (!done && count == 0) || file_type == sys.FileType.symlink {
        sys.closedir(mut dir)
        return 4
    }
    if sys.closedir(mut dir) != null { return 5 }
    return 0
}

print_examples(): int {
    fmt.print("ready")
    fmt.print(42)
    fmt.print(uint(7))
    fmt.print(usize(7))
    fmt.print(0.5)
    fmt.print(1.0e21)
    narrow: u16 = 7
    return int(fmt.print(uint(narrow)) - 1)
}

println_examples(): int {
    fmt.println("ready")
    fmt.println(42)
    fmt.println(0.5)

    if fmt.println("") != 1 { return 1 }
    narrow: u16 = 7

    if fmt.println(int(narrow)) != 2 { return 2 }
    return 0
}

printf_examples(): int {
    name: string = "Ace"
    count: int = 3
    ratio: f64 = 1.25
    written: int = fmt.printf("name=%s count=%d ratio=%.2f\n", name, count, ratio)

    if written != 28 { return 1 }
    byte: u8 = u8(65)
    fmt.printf("%u %x %X %f %c %%", uint(7), usize(15), uint(15), f32(0.5), byte)
    warned: int = fmt.printf(sys.stderr, "warning: %d retries\n", 3)
    if warned != 19 { return 2 }
    return 0
}

awake_example(): int {
    start: u64 = time.awake()
    sum: int = 0

    for i: int in 0 .. 1_000_000 { sum += i }
    elapsed_ns: u64 = time.awake() - start

    if elapsed_ns == 0 { return 1 }
    return 0
}

process_example(): int {
    process: sys.Process, fork_err: Error = sys.fork()

    if fork_err != null { return 1 }

    if process == 0 { sys.exit(0) }
    status: sys.ProcessStatus, wait_err: Error = sys.wait(process)

    if wait_err != null || !status.exited { return 2 }
    return status.code
}

net_example(): int {
    sock: net.Socket, err: Error = net.socket(net.SocketType.tcp)

    if err != null { return 1 }
    ip: [4]u8 = [u8(127), u8(0), u8(0), u8(1)]
    address: net.Addr4 = net.Addr4 {
        ip = ip,
        port = u16(0),
    }

    if net.reuseaddr(sock, true) != null ||
       net.bind(sock, address) != null ||
       net.listen(sock, usize(128)) != null {
        sys.close(sock)
       return 2
    }
    local: net.Addr4, local_err: Error = net.local(sock)

    if local_err != null || local.port == 0 {
        sys.close(sock)
        return 4
    }

    if sys.close(sock) != null { return 3 }

    storage: [8]net.Addr4
    addresses: mut []net.Addr4 = mut storage[0..8]
    count: usize, resolve_err: Error = net.resolve4("example.com", u16(80), addresses)

    if resolve_err == null && count != 0 {
        client: net.Socket, socket_err: Error = net.socket(net.SocketType.tcp)

        if socket_err == null {
            socket_err = net.connect(client, addresses[0])
            sys.close(client)
        }
    }
    return 0
}

tcp_example(address: net.Addr4): int {
    listener: tcp.Listener, err: Error = tcp.listen(address, usize(128))
    if err != null { return 1 }
    local: net.Addr4, local_err: Error = tcp.local(listener)
    if local_err != null || local.port == 0 {
        tcp.close(mut listener)
        return 2
    }
    connection: tcp.Conn, peer: net.Addr4, accept_err: Error = tcp.accept(listener)
    if accept_err == null {
        storage: [4]u8 = [0 : 4]
        buffer: mut []u8 = mut storage[0..]
        count: usize, ioerr: Error = tcp.receive_all(connection, buffer)
        if ioerr == null && count == 4 { count, ioerr = tcp.send_all(connection, "pong") }
        tcp.close(mut connection)
    }
    tcp.close(mut listener)
    return 0
}

tcp_nonblocking_example(address: net.Addr4): int {
    connection: tcp.Conn, err: Error = tcp.connect_nonblock(address)
    if err != null { return 1 }
    if tcp.interest(connection) == tcp.Interest.write {
        event: tcp.Event = tcp.progress_connect(mut connection)
        switch event {
            tcp.Event.connected {}
            tcp.Event.failed(connect_err: Error) {
                if connect_err != null {
                    tcp.close(mut connection)
                    return 2
                }
            }
            default {}
        }
    }
    tcp.close(mut connection)
    return 0
}

readiness_example(fd: sys.Fd): int {
    q: poll.Queue, err: Error = poll.queue()

    if err != null { return 1 }

    if poll.watch(q, fd, true, false) != null {
        sys.close(sys.Fd(q))
        return 2
    }

    zero: poll.Event = poll.Event {
        fd = sys.Fd(0),
        readable = false,
        writable = false,
        error = false,
        hangup = false,
    }
    storage: [16]poll.Event = [zero : 16]
    events: mut []poll.Event = mut storage[0..16]
    count: usize, wait_err: Error = poll.wait(q, events, poll.FOREVER)

    if wait_err == null {
        for index: usize in 0 .. count {
            if events[index].readable { count = index }
        }
    }

    poll.unwatch(q, fd)
    sys.close(sys.Fd(q))
    return 0
}

main(): int {
    code: int = mem_examples()

    if code != 0 { return code }
    code = write_note()

    if code != 0 { return code }
    code = check_missing()

    if code != 1 { return 10 + code }
    code = standard_descriptors()

    if code != 0 { return 60 + code }
    argument_count: usize = sys.argc()
    if argument_count > 0 {
        program: string = sys.arg(0)
        if program.len == 0 { return 61 }
    }
    environment_count: usize = sys.envc()
    if environment_count > 0 {
        entry: string = sys.env(0)
        if entry.len == 0 { return 62 }
    }
    code = bits_examples()

    if code != 0 { return 70 + code }
    code = print_examples()

    if code != 0 { return 20 + code }
    code = println_examples()

    if code != 0 { return 30 + code }
    code = printf_examples()

    if code != 0 { return 40 + code }
    code = str_examples()

    if code != 0 { return 50 + code }
    return awake_example()
}
