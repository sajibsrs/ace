/* Compiler-checked examples from docs/types.md. */

import mem

limit: const int = 1024
buffer_size: const usize = 8

A: type = u8

size: const A = A(5)
mask: const u32 = u32(255)
ratio: const f64 = f64(0.5)

Count: type = int
Meters: distinct f64

Point: struct { x: int, y: int }
State: enum { idle, running, stopped }
Box[T]: struct { value: T }
Event: union { none, quit, point: Point }
Result[T]: union { empty, value: T }

Node: struct { next: *Node }
Left: struct { right: *Right }
Right: struct { left: *Left }
Json: union { none, object: []Pair }
Pair: struct { key: string, value: Json }

order_buffer: [ORDER_SIZE]u8

ORDER_SIZE: const usize = 2 * ORDER_LINE
ORDER_LINE: const usize = 64

Button: struct { on_click: (int): int }

twice(n: int): int {
    return n * 2
}

add(a: int, b: int): int {
    return a + b
}

read_x(point: *Point): int {
    return point.x
}

set_x(point: mut *Point, value: int) {
    point.x = value
}

retarget(mut point: *Point, replacement: *Point) {
    point = replacement
}

fill(data: mut []u8, value: u8) {
    for i: usize in 0 .. data.len { data[i] = value }
}

keep(text: string): string {
    return text
}

Value: contract {
    get(self): int
}

Number: struct { value: int }

Number signs Value

Number.get(self): int {
    return self.value
}

Number.set(mut self, value: int) {
    self.value = value
}

Number.zero(): Number {
    return Number{ value = 0 }
}

Named: struct { text: string }

Named.name(self): string {
    return self.text
}

Human: struct {
    embed named: Named,
}

fill_prefix(bytes: mut []u8): usize {
    bytes[0] = u8(97)
    return 1
}

view_initialized(): int {
    storage: [16]u8
    bytes: mut []u8 = mut storage[0..16] // storage is now initialized
    count: usize = fill_prefix(bytes)
    return int(string(bytes[0..count]).len)
}

main(): int {
    explicit: int = 4
    number: int, message: string = 1, "old"
    written: int, message = 2, "new"
    number, message = written, "newer"
    a: int = number
    b: int = 3
    a, b = b, a
    members: (int, f64) = (20, 22.0)
    members = (21, 23.0)
    narrow: (i32, u8) = (-1, 'z')
    button: Button = Button{ on_click = twice }
    clicked: int = button.on_click(3)
    held: *Button = &button
    again: int = (held.on_click)(4)

    count: Count = 13
    distance: Meters = Meters(12.5)
    raw: f64 = f64(distance)
    point: Point = Point {
        x = 13,
        y = 29,
    }
    pointer: *Point = &point
    writable: mut *Point = mut &point
    set_x(writable, 14)
    other: Point = Point {
        x = 15,
        y = 31,
    }
    retarget(mut pointer, &other)
    outer: *mut *Point = &writable
    outer.x = 16
    maybe: *Point = null
    node: Node = { next = null }
    left: Left = { right = null }
    right: Right = { left = &left }
    node.next = &node
    left.right = &right
    pair: Pair = { key = "k", value = Json.none }
    object: Json = Json.object(null)
    values: [4]int = [10, 20, 30, 40]
    zeros: [4]int = [0 : 4]
    middle: []int = values[1..3]
    sized: [buffer_size]u8 = [0 : buffer_size]
    bytes: [4]u8 = [65, 99, 101, 33]
    byte_view: []u8 = bytes[0..4]
    byte_match: bool = mem.equal(bytes, "Ace!") && mem.equal("Ace!", byte_view)

    if byte_match { count += 1 }
    operation: (int, int): int = add
    state: State = State.running
    event: Event = Event.point( { x = 3, y = 4 })

    switch event {
        Event.point(payload: Point) {
            point.x = payload.x
        }
        default {}
    }
    result: Result[int] = Result[int].value(7)

    switch result {
        Result[int].value(payload: int) {
            count += payload
        }
        default {}
    }
    box: Box[int]
    box.value = 13
    partial: Point
    partial.x = 40
    partial.y = 2
    number_object: Number = Number { value = 13 }
    zero_number: Number = Number.zero()
    mut zero_number.set(21)
    value: Value = Value(&number_object)
    human: Human = Human { named = Named { text = "Ada" } }
    promoted_name: string = human.name()
    ok_bytes: [3]u8 = [u8('o'), u8('k'), u8('!')]
    view: string = ok_bytes[0..3]
    tail: string = view[1..]
    buffer: [4]u8 = [0, 0, 0, 0]
    fill(mut buffer[0..4], 7)
    w: mut []u8 = mut buffer[0..4]
    w[0] = 42
    plain: []u8 = w
    letters: [3]u8 = [u8('a'), u8('c'), u8('e')]
    writable_view: mut string = mut letters[0..]

    if sizeof([]char) != 16 || sizeof([3]char) != 3 { return 90 }
    return count + int(raw) + read_x(pointer) + middle[0] + middle[1] +
        operation(1, 2) + int(state) + box.value + value.get() +
        partial.x + partial.y + int(view.len) + int(tail.len) +
        int(plain[1]) + int(writable_view.len) + explicit - 7
}
