Point: struct { x: f32 }

Shape: interface {
    area(): f32
    mut scale(k: f32)
}

circle_area(c: *Point): f32 {
    return c.x
}

circle_scale(mut c: *Point, k: f32) {
    c.x = c.x * k
}

circle_shape: impl(Point, Shape) {
    area: circle_area,
    mut scale: circle_scale,
}

f(s: Shape) {
    s.scale(1.0)
}
