/* A module-level const usize backs a fixed array length and an array
 * repetition count, exactly as safely as a literal. */

INPUT_SIZE: const usize = 8192
ROUTE_COUNT: const usize = 4

Router: struct {
    input: [INPUT_SIZE]u8,
    hits: [ROUTE_COUNT]i32 = [0 : ROUTE_COUNT],
}

main(): int {
    r: Router
    return int(r.input.len) - 8192 + int(r.hits.len) - 4
}
