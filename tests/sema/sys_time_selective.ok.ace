/* sys time — selective import and exact signature typing (sema check only;
 * runtime coverage lives in tests/emit/sys_time.ace).
 */

import time_awake, time_elapsed from sys

same_mode_difference(): int {
    start: u64 = time_awake()
    end: u64 = time_awake()

    if end < start {
        return 1
    }
    return 0
}

main(): int {
    elapsed: u64 = time_elapsed()
    awake: u64 = time_awake()

    if elapsed == 0 || awake == 0 {
        return 2
    }
    return same_mode_difference()
}
