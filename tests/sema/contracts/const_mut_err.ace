/* Contract const mut fixture. */

Thing: struct { value: int }
Writable: contract { write(mut self, value: int) }

Thing signs Writable

Thing.write(mut self, value: int) {
    self.value = value
}

main(): int {
    thing: const Thing = Thing { value = 1 }
    writable: Writable = Writable(&thing)
    mut writable.write(2)
    return 0
}
