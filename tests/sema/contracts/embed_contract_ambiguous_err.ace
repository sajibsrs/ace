/* Two embedded contract providers cannot choose a receiver adjustment. */

Value: contract {
    value(self): int
}

A: struct {}

A signs Value

A.value(self): int {
    return 1
}

B: struct {}

B signs Value

B.value(self): int {
    return 2
}

Both: struct {
    embed a: A,
    embed b: B,
}

Both signs Value
