/* Contract const return fixture. */

Thing: struct { value: int }
Writable: contract { write(self, value: int) }

Thing signs Writable

Thing.write(self, value: int) {
    self.value = value
}

identity(value: Writable): Writable {
    return value
}

main(): int {
    thing: const Thing = Thing { value = 1 }
    first: Writable = Writable(&thing)
    second: Writable = identity(first)
    second.write(2)
    return 0
}
