/* Contract const mutarg fixture. */

Thing: struct { value: int }
Writable: contract { mut write(value: int) }

Thing signs Writable

mut Thing.write(value: int) {
    self.value = value
}

change(mut value: Writable) {
    mut value.write(2)
}

main(): int {
    thing: const Thing = Thing { value: 1 }
    writable: Writable = Writable(&thing)
    change(mut writable)
    return 0
}
