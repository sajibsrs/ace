/* Compiler-checked examples from docs/types.md. */

limit: const int = 1024

Count: type = int
Meters: distinct f64

Point: struct { x: int, y: int }
State: enum { idle, running, stopped }
Box[T]: struct { value: T }
Event: union { none, quit, point: Point }
Result[T]: union { empty, value: T }

Node: struct { next: *Node }
Left: struct { right: *Right }
Right: struct { left: *Left }

add(a: int, b: int): int {
    return a + b
}

read_x(point: *Point): int {
    return point.x
}

set_x(point: mut *Point, value: int) {
    point.x = value
}

retarget(mut point: *Point, replacement: *Point) {
    point = replacement
}

Value: contract {
    get(): int
}

Number: struct { value: int }

Number signs Value

Number.get(): int {
    return self.value
}

Named: struct { name: string }

Named.name(): string {
    return self.name
}

Human: struct {
    embed named: Named,
}

main(): int {
    number: int, message: string = 1, "old"
    number, message = 2, "new"
    a: int = number
    b: int = 3
    a, b = b, a

    count: Count = 13
    distance: Meters = Meters(12.5)
    raw: f64 = f64(distance)
    point: Point = Point { x: 13, y: 29 }
    pointer: *Point = &point
    writable: mut *Point = mut &point
    set_x(writable, 14)
    other: Point = Point { x: 15, y: 31 }
    retarget(mut pointer, &other)
    outer: *mut *Point = &writable
    outer.x = 16
    maybe: *Point = null
    node: Node = { next: null }
    left: Left = { right: null }
    right: Right = { left: &left }
    node.next = &node
    left.right = &right
    values: [4]int = [10, 20, 30, 40]
    zeros: [4]int = [0 : 4]
    middle: []int = values[1..3]
    bytes: [4]u8 = [65, 99, 101, 33]
    byte_view: []u8 = bytes[0..4]
    byte_match: bool = bytes == "Ace!" && "Ace!" == byte_view

    if byte_match {
        count += 1
    }
    operation: (int, int): int = add
    state: State = State.running
    event: Event = Event.point({ x: 3, y: 4 })

    switch event {
        Event.point(payload: Point) {
            point.x = payload.x
        }
        else {}
    }
    result: Result[int] = Result[int].value(7)

    switch result {
        Result[int].value(payload: int) {
            count += payload
        }
        else {}
    }
    box: Box[int]
    box.value = 13
    partial: Point
    partial.x = 40
    partial.y = 2
    number_object: Number = Number { value: 13 }
    value: Value = Value(&number_object)
    human: Human = Human { named: Named { name: "Ada" } }
    promoted_name: string = human.name()
    ok_bytes: [3]u8 = [u8('o'), u8('k'), u8('!')]
    view: string = string(ok_bytes[0..3])
    tail: string = view[1..]

    if sizeof([]char) != 16 || sizeof([3]char) != 3 {
        return 90
    }
    return count + int(raw) + read_x(pointer) + middle[0] + middle[1] +
        operation(1, 2) + int(state) + box.value + value.get() +
        partial.x + partial.y + int(view.len) + int(tail.len)
}
