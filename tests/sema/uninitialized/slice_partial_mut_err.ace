/* Partial writable slice fixture: only a full-range mut view initializes. */

Span: struct { start: usize, end: usize }

fill(spans: mut []Span) {
    for i: usize in usize(0) .. spans.len {
        spans[i] = Span { start = i, end = i }
    }
}

main(): int {
    spans: [4]Span
    fill(mut spans[0..2])
    fill(mut spans[2..4])
    return int(spans[0].start)
}
