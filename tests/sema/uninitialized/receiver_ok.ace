/* A receiver is passed by address, as `&x` is: the call may
 * initialize it, and it counts as initialized afterwards. */

Pair: struct { x: int, y: int }
Outer: struct { pair: Pair, tag: int }

Pair.fill(self): bool {
    self.x = 1
    self.y = 2
    return true
}

main(): int {
    pair: Pair
    for pair.fill() { break }

    outer: Outer
    outer.pair.fill()
    outer.tag = 3
    return pair.x + outer.pair.y + outer.tag
}
