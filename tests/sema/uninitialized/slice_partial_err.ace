/* A slice initializes only the elements it covers: spans[3] stays uninitialized. */

Span: struct { start: usize, end: usize }

first(spans: []Span): usize {
    return spans[0].start
}

main(): int {
    spans: [4]Span
    total: usize = first(spans[0..1])
    return int(total + spans[3].start)
}
