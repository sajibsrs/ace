/* Partially initialized slice fixture: a read-only view requires the whole array. */

Span: struct { start: usize, end: usize }

first(spans: []Span): usize { return spans[0].start }

main(): int {
    spans: [4]Span
    spans[0] = Span {
        start = 1,
        end = 1,
    }
    return int(first(spans[0..1]))
}
