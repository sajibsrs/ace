/* Initialized view fixture. */

Span: struct { start: usize, end: usize }

first(spans: []Span): usize {
    return spans[0].start
}

fill(spans: []Span) {
    for i: usize in usize(0) .. spans.len {
        spans[i] = Span {
            start = i,
            end = i,
        }
    }
}

set(value: *usize) {
    *value = 1
}

peek(value: *usize): usize {
    return *value
}

render(spans: []Span, out: []u8): usize {
    out[0] = u8(48 + spans[0].start)
    return 1
}

main(): int {
    spans: [4]Span
    fill(spans[0..4])
    total: usize = spans[3].start + first(spans[0..1])

    span: Span
    set(&span.start)
    total += peek(&span.start) + span.start

    buffer: [8]u8
    text: string = string(buffer[0..render(spans[0..4], buffer[0..8])])

    storage: [16]u8
    bytes: []u8 = storage[0..16]
    count: usize = 0

    for i: usize in usize(0) .. usize(3) {
        bytes[count] = u8(97)
        count += 1
    }
    return int(total + text.len + string(bytes[0..count]).len)
}
