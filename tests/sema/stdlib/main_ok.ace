/* Net selective fixture. */

import Addr4, LocalErr, ResolveErr, Socket, SocketType, local, resolve4, send, socket from net

check(address: Addr4, socket_value: Socket): int {
    if address.port == 0 { return 0 }
    sent: int, err: Error = send(socket_value, "")

    if err != null { return 1 }
    bound: Addr4, local_err: Error = local(socket_value)

    if local_err != null && local_err.domain != typeid(LocalErr) { return 3 }
    return sent
}

main(): int {
    ip: [4]u8 = [u8(127), u8(0), u8(0), u8(1)]
    address: Addr4 = Addr4 {
        ip = ip,
        port = u16(80),
    }
    value: Socket, err: Error = socket(SocketType.tcp)

    if err != null { return 1 }
    storage: [1]Addr4 = [address]
    addresses: []Addr4 = storage[0..1]
    count: usize, resolve_err: Error = resolve4("localhost", u16(80), addresses)

    if count == 0 && resolve_err != null && resolve_err.domain != typeid(ResolveErr) { return 2 }
    return check(address, value)
}
