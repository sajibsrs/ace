import http
import net

check_client(mut context: http.ClientContext, mut client: http.Client) {
    response: http.Response, err: Error = http.get("http://example.com/", mut context)
    response, err = http.get("http://example.com/", mut client)
    response, err = http.get("https://example.com/", mut client)
}

check(
    mut state: http.ResponseParser,
    mut request_parser: http.RequestParser,
    headers: mut []http.Header,
    body: mut []u8,
    output: mut []u8,
): int {
    address: net.Addr4, valid: bool = net.parse4("127.0.0.1:80")
    url: http.Url, err: Error = http.parse_url("http://example.com/?q=1")
    request_headers: [1]http.Header = [
        http.Header {name = "Host", value = "example.com"},
    ]
    request: http.Request = http.Request {
        method = http.method_get,
        target = "/",
        headers = request_headers[..],
    }
    empty_request: http.Request = http.Request {method = http.method_head, target = "/"}
    default_response: http.Response = http.Response {}
    not_found: http.Response = http.Response {status = 404}
    fresh_request_parser: http.RequestParser = http.RequestParser {
        phase = http.RequestPhase.request,
        framing = http.RequestFraming.undecided,
    }
    fresh_response_parser: http.ResponseParser = http.ResponseParser {
        phase = http.ResponsePhase.status,
        framing = http.ResponseFraming.undecided,
    }
    count: usize
    count, err = request.format(output)
    if err != null && err.domain != typeid(http.FormatErr) { return 2 }
    request_result: http.RequestResult = mut request_parser.parse(
        "GET / HTTP/1.1\r\n\r\n",
        headers,
        body,
        false,
    )
    result: http.ResponseResult = mut state.parse(
        "HTTP/1.1 204 No Content\r\n\r\n",
        headers,
        body,
        false,
        false,
    )
    switch result {
        http.ResponseResult.complete(response: http.Response) {
            count += usize(response.status)
            response_count: usize
            response_count, err = response.format(output)
            count += response_count
        }
        else {}
    }
    switch request_result {
        http.RequestResult.complete(parsed: http.Request) {
            count += parsed.method.len
        }
        else {}
    }
    if valid && address.port == 80 && url.port == 80 && err == null {
        count += empty_request.body.len + usize(default_response.status - 200)
        count += usize(not_found.status - 404)
        count += fresh_request_parser.input_offset + fresh_response_parser.input_offset
        return int(count - count)
    }
    return 1
}

check_server(mut ctx: http.ServerContext): int {
    event: http.Event, err: Error = http.serve(mut ctx, u64(1000000000))
    switch event {
        http.Event.none { return 0 }
        http.Event.accepted(index: usize) { return int(index) }
        http.Event.request(index: usize) {
            target: string = ctx.sessions[index].request.target
            method: string = ctx.sessions[index].request.method
            response: http.Response = http.Response {status = 200, body = "ok"}
            respond_err: Error = http.respond(mut ctx, index, response)
            if respond_err != null && respond_err.domain != typeid(http.ServerErr) { return 1 }
            return int(target.len + method.len)
        }
        http.Event.sent(index: usize) { return int(index) }
        http.Event.disconnected(index: usize) { return int(index) }
        http.Event.failed(fail: http.Failure) {
            if fail.err != null { return 1 }
            return int(fail.index)
        }
    }
    if err != null && err.domain != typeid(http.ServerErr) { return 1 }
    return 0
}

main(): int {
    context: http.ClientContext = http.client_context_new()
    context.redirects = http.RedirectPolicy {limit = 10}
    client: http.Client = http.client_new()
    client.context.redirects = http.RedirectPolicy {limit = 10}
    client.tls = http.TlsConfig{}
    check_client(mut context, mut client)
    http.client_context_wipe(mut context)
    http.client_wipe(mut client)

    server_ctx: http.ServerContext, server_err: Error = http.server_context_new(
        "127.0.0.1:0", usize(8), usize(4), usize(1024), usize(8), usize(256), usize(1024))
    if server_err == null {
        check_server(mut server_ctx)
        http.server_context_wipe(mut server_ctx)
    }
    return 0
}
