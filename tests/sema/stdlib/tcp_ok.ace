/* Blocking TCP public surface, mut close, byte-view identity, and domains. */

import net
import sys
import (
    Event,
    Conn,
    Listener,
    Interest,
    ReceiveAllErr,
    SendAllErr,
    accept,
    close,
    connect,
    connect_nonblock,
    listen,
    local,
    interest,
    progress_connect,
    progress_receive,
    progress_send,
    receive_all,
    send_all,
) from net/tcp

check(address: net.Addr4, listener: Listener, connection: Conn, bytes: mut []u8, text: string): int {
    bound: net.Addr4, local_err: Error = local(listener)
    accepted: Conn, peer: net.Addr4, accept_err: Error = accept(listener)
    received: usize, receive_err: Error = receive_all(connection, bytes)
    sent: usize, send_err: Error = send_all(connection, text)
    interest: Interest = interest(connection)

    if receive_err != null && receive_err.domain == typeid(ReceiveAllErr) {
        received = usize(receive_err.code)
    }
    if send_err != null && send_err.domain == typeid(SendAllErr) {
        sent = usize(send_err.code)
    }
    if local_err != null || accept_err != null || bound.port == peer.port {
        return int(received + sent)
    }
    if interest == Interest.none {
        event: Event = progress_receive(mut accepted, bytes)
        switch event {
            Event.data(count: usize) { received = count }
            Event.failed(err: Error) { send_err = err }
            else {}
        }
        event = progress_send(mut accepted, text)
        event = progress_connect(mut accepted)
    }
    close(mut accepted)
    return 0
}

main(): int {
    address: net.Addr4 = net.Addr4 {ip = [127, 0, 0, 1], port = u16(0)}
    listener: Listener, listen_err: Error = listen(address, usize(8))
    connection: Conn, connect_err: Error = connect(address)
    pending: Conn, pending_err: Error = connect_nonblock(address)
    if listen_err == null {
        close(mut listener)
    }
    if connect_err == null {
        close(mut connection)
    }
    if pending_err == null {
        close(mut pending)
    }
    interrupted: i32 = sys.EINTR
    return int(interrupted - interrupted)
}
