/* Blocking TCP public surface, mut close, byte-view identity, and domains. */

import net
import sys
import ConnEvent, Connection, Listener, PollInterest, ReceiveExactErr, SendAllErr, accept, close, connect, connect_nonblocking, listen, local, poll_interest, progress_connect, progress_receive, progress_send, receive_exact, send_all from tcp

check(address: net.Addr4, listener: Listener, connection: Connection,
      bytes: mut []u8, text: string): int {
    bound: net.Addr4, local_err: Error = local(listener)
    accepted: Connection, peer: net.Addr4, accept_err: Error = accept(listener)
    received: usize, receive_err: Error = receive_exact(connection, bytes)
    sent: usize, send_err: Error = send_all(connection, text)
    interest: PollInterest = poll_interest(connection)

    if receive_err != null && receive_err.domain == typeid(ReceiveExactErr) {
        received = usize(receive_err.code)
    }
    if send_err != null && send_err.domain == typeid(SendAllErr) {
        sent = usize(send_err.code)
    }
    if local_err != null || accept_err != null || bound.port == peer.port {
        return int(received + sent)
    }
    if interest == PollInterest.none {
        event: ConnEvent = progress_receive(mut accepted, bytes)
        switch event {
            ConnEvent.data(count: usize) { received = count }
            ConnEvent.failed(err: Error) { send_err = err }
            else {}
        }
        event = progress_send(mut accepted, text)
        event = progress_connect(mut accepted)
    }
    close(mut accepted)
    return 0
}

main(): int {
    address: net.Addr4 = net.Addr4 {ip: [127, 0, 0, 1], port: u16(0)}
    listener: Listener, listen_err: Error = listen(address, usize(8))
    connection: Connection, connect_err: Error = connect(address)
    pending: Connection, pending_err: Error = connect_nonblocking(address)
    if listen_err == null {
        close(mut listener)
    }
    if connect_err == null {
        close(mut connection)
    }
    if pending_err == null {
        close(mut pending)
    }
    interrupted: i32 = sys.EINTR
    return int(interrupted - interrupted)
}
