import tls
import tcp

check(connection: tcp.Conn, anchor: []u8, storage: tls.Storage) {
    secured: tls.Conn, err: Error = tls.connect(connection, "example.com", anchor, storage)
    if err != null { return }
    sent: usize
    sent, err = tls.send_all(secured, "GET / HTTP/1.1\r\n\r\n")
    output: [1]u8
    received: int
    received, err = tls.receive(secured, mut output[..])
}
