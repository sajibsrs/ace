/* Selective poll surface coverage. */

import sys
import (
    Event,
    Queue,
    WaitErr,
    WatchErr,
    queue,
    wait,
    wait_forever,
    watch,
) from poll

check(fd: sys.Fd): int {
    q: Queue, queue_err: Error = queue()

    if queue_err != null {
        return 1
    }
    watch_err: Error = watch(q, fd, true, false)

    if watch_err != null && watch_err.domain != typeid(WatchErr) {
        return 2
    }
    zero: Event = Event {
        fd: fd,
        readable: false,
        writable: false,
        error: false,
        hangup: false,
    }
    storage: [1]Event = [zero]
    events: mut []Event = mut storage[0..1]
    count: usize, wait_err: Error = wait(q, events, wait_forever)

    if count == 0 && wait_err != null && wait_err.domain != typeid(WaitErr) {
        return 3
    }
    return 0
}

main(): int {
    return 0
}
