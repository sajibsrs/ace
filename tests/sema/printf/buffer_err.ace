/* Buffer.printf fixture: printf's checks apply to its format and values.
 */

import fmt
import sys

bad(storage: []u8, held: fmt.Buffer): int {
    b: fmt.Buffer = fmt.Buffer.init(sys.stdout, storage)
    n: int = b.printf("%d", 1)
    n = held.printf("%d", 1)
    n = b.printf("%d", "text")
    n = b.printf("%d %d", 1)
    n = b.printf(b, "%d", 1)
    return n
}
