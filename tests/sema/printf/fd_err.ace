/* fmt.printf(fd, ...) fixture: printf's checks, with value arguments counted
 * after the descriptor and format; neither printf form nor str.format's
 * formatted form is a function value.
 */

import fmt
import str
import sys

bad(): int {
    n: int = fmt.printf(sys.stderr, "%d\n", "text")
    n = fmt.printf(sys.stderr, "%d %d\n", 1)
    n = fmt.printf(mut sys.stderr, "x\n")
    n = fmt.printf(sys.stderr)
    to_fd: (sys.Fd, string): int = fmt.printf
    plain: (string): int = fmt.printf
    into: (mut []char, string): (usize, bool) = str.format
    return n
}

main(): int {
    return bad()
}
