/*
 * fmt.println mirrors the print overload policy: integer widths narrower than
 * the platform word have no overload; conversion is explicit at the call site
 * (fmt.println(uint(n))).
 */

import fmt

main(): int {
    small: u16 = 4660
    medium: i32 = 70
    fmt.println(small)
    fmt.println(medium)
    return 0
}
