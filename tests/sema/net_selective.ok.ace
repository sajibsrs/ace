import Address4, ResolveErr, Socket, SocketKind, resolve4, send, socket from net

check(address: Address4, socket_value: Socket): int {
    if address.port == 0 {
        return 0
    }
    sent: int, err: Error = send(socket_value, "")
    if err != null {
        return 1
    }
    return sent
}

main(): int {
    ip: [4]u8 = [u8(127), u8(0), u8(0), u8(1)]
    address: Address4 = Address4{
        ip: ip,
        port: u16(80),
    }
    value: Socket, err: Error = socket(SocketKind.tcp)
    if err != null {
        return 1
    }
    storage: [1]Address4 = [address]
    addresses: []Address4 = storage[0..1]
    count: usize, resolve_err: Error = resolve4("localhost", u16(80), mut addresses)
    if count == 0 && resolve_err != null && resolve_err.domain != typeid(ResolveErr) {
        return 2
    }
    return check(address, value)
}
