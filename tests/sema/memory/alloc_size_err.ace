/* mem.alloc_size diagnostics fixture. */

import mem

main(): int {
    data: mut []u8 = mem.alloc(16, 8)
    words: []usize = mem.alloc[usize](4)
    a: usize = mem.alloc_size()
    b: usize = mem.alloc_size(data, data)
    c: usize = mem.alloc_size(mut data)
    d: usize = mem.alloc_size(words)
    return 0
}
