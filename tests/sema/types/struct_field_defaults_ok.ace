/* Struct defaults permit omission only at literal construction sites. */

origin: const int = 7

Point: struct { x: int = origin, y: int }
All: struct { enabled: bool = true, count: u8 = u8(3) }
Box[T]: struct { value: T = 4 }

global: All = All {}
zero: All

main(): int {
    a: Point = Point { y: 9 }
    b: Point = { x: 2, y: 5 }
    c: All = All {}
    d: All = All { count: u8(8) }
    box: Box[int] = { }
    if a.x != 7 || a.y != 9 || b.x != 2 || b.y != 5 { return 1 }
    if !c.enabled || c.count != 3 || !d.enabled || d.count != 8 { return 2 }
    if !global.enabled || global.count != 3 || zero.enabled || zero.count != 0 { return 3 }
    return box.value - 4
}
