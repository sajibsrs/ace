/* Inline forward type fixture. */

A: struct {
    b: B,
}

B: struct {
    value: int,
}

C: struct {
    d: [1]*D,
}

D: struct {
    value: int,
}

E: struct {
    f: *[1]F,
}

F: struct {
    value: int,
}

/* A slice reached through a preceding pointer is still rejected: the []Later
 * fixup (Types & Declarations #5) applies only at the field/variant root
 * itself, not once a pointer has already led into it.
 */
G: struct {
    h: *[]H,
}

H: struct {
    value: int,
}

main(): int { return 0 }
