/* Selective imports carry the typed allocation overloads beside the raw
 * forms of the same names. */
import alloc, realloc, release from mem

Item: struct { tag: u32 }

main(): int {
    numbers: []usize = alloc[usize](4)
    if numbers == null {
        return 1
    }
    if numbers.len != 4 {
        release[usize](mut numbers)
        return 2
    }

    grown: []usize = realloc[usize](numbers, 8)
    if grown == null || grown.len != 8 {
        return 3
    }
    release[usize](mut grown)

    items: []Item = alloc[Item](2)
    if items == null {
        return 4
    }
    items[0] = Item { tag: 7 }
    if items[0].tag != 7 {
        release[Item](mut items)
        return 5
    }
    release[Item](mut items)

    raw: []u8 = alloc(8, 8)
    if raw == null {
        return 6
    }
    release(mut raw)
    return 0
}
