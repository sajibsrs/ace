main(): int {
    values: [4]i32 = [10, 20, 30, 40]
    category: i32 = 0
    value: i32 = 3
    limit: i32 = 5
    if value < 0 {
        category = -1
    } else if value == 0 {
        category = 0
    } else {
        category = 1
    }
    inside: bool = 0 <= value < limit

    for i: int in 0 .. 4 {
        i = 0
    }
    for i: int in 4 .. 0 {
        i = 0
    }
    step: int = 2
    for i: int in 0 .. 4 step step {
        i = 0
    }
    for item: i32 in values {
        value = item
    }
    for index: usize, item: i32 in values {
        values[index] = item + 1
    }
    for index: usize in 0 .. values.len {
        index = 0
    }

    work: {
        for item: i32 in values {
            if item < 0 {
                break work
            }
        }
    }
    repeats: int = 0
    retry: {
        repeats += 1
        if repeats < 2 {
            continue retry
        }
    }
    if inside && category == 1 {
        return 0
    }
    return 1
}
