Flags: bits u32 { enabled: 1, mode: signed 3, _: 28 }
Other: bits u32 { enabled: 1, mode: signed 3, _: 28 }

Box: struct { flags: Flags, values: [2]Flags }

copy(value: Flags): Flags {
    return value
}

main(): int {
    flags: Flags = Flags { enabled = 1 }
    raw: u32 = u32(flags)
    same: Flags = Flags(raw)
    box: Box = Box {
        flags = same,
        values = [flags, copy(flags)],
    }
    if box.flags == box.values[0] && box.flags != Flags(u32(0)) { return 0 }
    return 1
}
