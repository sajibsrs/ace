/* Mut markers are checked at signatures and call sites. */

Point: struct { x: f32 }

Shape: contract {
    area(self): f32
    scale(mut self, k: f32)
}

Point signs Shape

Point.area(self): f32 {
    return self.x
}

Point.scale(mut self, k: f32) {
    self.x = self.x * k
}

f(s: Shape) {
    s.scale(1.0)
}
