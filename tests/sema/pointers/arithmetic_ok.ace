/* Typed pointer arithmetic preserves pointee permission and uses usize offsets. */

Pair: struct { first: int, second: int }

read(pointer: *Pair, offset: usize): int { return (pointer + offset).first }

write(pointer: mut *Pair, offset: usize, value: int) { (pointer + offset).first = value }

main(): int {
    values: [3]Pair
    pointer: mut *Pair = mut &values[0]
    pointer += 1
    pointer -= usize(1)
    plain: *Pair = pointer + 2
    write(pointer, 2, 42)
    return read(plain - 0, usize(0))
}
