runtime_i64(value: i64): i64 { return value }

main(): int {
    a: i64 = runtime_i64(40)
    b: i64 = runtime_i64(2)
    if a + b != 42 || a - b != 38 {
        return 1
    }
    if a * b != 80 || a / b != 20 {
        return 2
    }
    if a % b != 0 || a << b != 160 || a >> b != 10 {
        return 3
    }
    return 0
}
