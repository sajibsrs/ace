import file
import mem
import test
import grid: "./grid.ace"
import sim: "./sim.ace"
import diagram: "./diagram.ace"

/* Places a row of blocks starting at (x, y), one per cell eastward. */
row(g: *grid.Grid, x: int, y: int, blocks: []grid.Block) {
    for i: usize in 0 .. blocks.len { g.place(x + int(i), y, blocks[i]) }
}

high(t: *test.T, s: sim.Sim, x: int, y: int) {
    test.equal[sim.Level](t, s.level(x, y), sim.Level.high)
}

low(t: *test.T, s: sim.Sim, x: int, y: int) {
    test.equal[sim.Level](t, s.level(x, y), sim.Level.low)
}

error(t: *test.T, s: sim.Sim, x: int, y: int) {
    test.equal[sim.Level](t, s.level(x, y), sim.Level.error)
}

/* Sources (0,0) and (0,2) feed wires into read pins (2,0) and (2,2) above and
 * below a gate at (2,1); its write pin (3,1) drives a wire into an LED at
 * (5,1). */
two_input(block: grid.Block): sim.Sim {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.source, grid.Block.wire, grid.Block.read])
    row(&g, 2, 1, [block, grid.Block.write, grid.Block.wire, grid.Block.led])
    row(&g, 0, 2, [grid.Block.source, grid.Block.wire, grid.Block.read])
    return sim.Sim.init(g)
}

result(block: grid.Block, a: bool, b: bool): sim.Level {
    s: sim.Sim = two_input(block)
    s.toggle(0, 0, a)
    s.toggle(0, 2, b)
    s.tick()
    return s.level(5, 1)
}

pub and_truth_table(t: *test.T) {
    test.equal[sim.Level](t, result(grid.Block.and, false, false), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.and, true, false), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.and, false, true), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.and, true, true), sim.Level.high)
}

pub or_truth_table(t: *test.T) {
    test.equal[sim.Level](t, result(grid.Block.or, false, false), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.or, true, false), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.or, false, true), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.or, true, true), sim.Level.high)
}

pub nand_truth_table(t: *test.T) {
    test.equal[sim.Level](t, result(grid.Block.nand, false, false), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.nand, true, false), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.nand, false, true), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.nand, true, true), sim.Level.low)
}

pub nor_truth_table(t: *test.T) {
    test.equal[sim.Level](t, result(grid.Block.nor, false, false), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.nor, true, false), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.nor, false, true), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.nor, true, true), sim.Level.low)
}

pub xor_truth_table(t: *test.T) {
    test.equal[sim.Level](t, result(grid.Block.xor, false, false), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.xor, true, false), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.xor, false, true), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.xor, true, true), sim.Level.low)
}

pub xnor_truth_table(t: *test.T) {
    test.equal[sim.Level](t, result(grid.Block.xnor, false, false), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.xnor, true, false), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.xnor, false, true), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.xnor, true, true), sim.Level.high)
}

/* A five-cell XOR column with pins on rows 0, 2 and 4 is high on an odd count of
 * high inputs. */
pub xor_is_parity(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    for y: int in 0 .. 5 { g.place(3, y, grid.Block.xor) }
    for y: int in [0, 2, 4] { row(&g, 0, y, [grid.Block.source, grid.Block.wire, grid.Block.read]) }
    row(&g, 4, 2, [grid.Block.write, grid.Block.wire, grid.Block.led])
    s: sim.Sim = sim.Sim.init(g)
    s.toggle(0, 0, true)
    s.toggle(0, 2, true)
    s.tick()
    low(t, s, 6, 2)
    s.toggle(0, 4, true)
    s.tick()
    high(t, s, 6, 2)
}

pub xor_with_one_pin_is_an_error(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.source, grid.Block.wire, grid.Block.read, grid.Block.xor])
    s: sim.Sim = sim.Sim.init(g)
    s.tick()
    error(t, s, 3, 0)
}

pub source_drives_wire_without_delay(t: *test.T) {
    s: sim.Sim = two_input(grid.Block.and)
    s.toggle(0, 0, true)
    high(t, s, 1, 0)
    high(t, s, 2, 0)
    low(t, s, 1, 2)
}

pub gate_adds_one_tick(t: *test.T) {
    s: sim.Sim = two_input(grid.Block.and)
    s.toggle(0, 0, true)
    s.toggle(0, 2, true)
    low(t, s, 5, 1)
    s.tick()
    high(t, s, 2, 1)
    high(t, s, 5, 1)
}

/* A gate without an write pin still shows its output but drives nothing. */
pub gate_without_output_pin_drives_nothing(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.source, grid.Block.wire, grid.Block.read, grid.Block.or, grid.Block.wire, grid.Block.led])
    s: sim.Sim = sim.Sim.init(g)
    s.toggle(0, 0, true)
    s.tick()
    high(t, s, 3, 0)
    low(t, s, 5, 0)
}

/* S W I ! O W I ! O W L: each NOT adds a tick. */
pub chained_gates_delay_per_gate(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [
        grid.Block.source, grid.Block.wire, grid.Block.read, grid.Block.not, grid.Block.write,
        grid.Block.wire, grid.Block.read, grid.Block.not, grid.Block.write, grid.Block.wire,
        grid.Block.led,
    ])
    s: sim.Sim = sim.Sim.init(g)
    s.tick()
    s.tick()
    low(t, s, 10, 0)
    s.toggle(0, 0, true)
    s.tick()
    low(t, s, 3, 0)
    low(t, s, 10, 0)
    s.tick()
    high(t, s, 10, 0)
}

pub lone_gate_is_idle(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    g.place(0, 0, grid.Block.not)
    s: sim.Sim = sim.Sim.init(g)
    s.tick()
    low(t, s, 0, 0)
}

pub and_with_one_pin_is_an_error(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.source, grid.Block.wire, grid.Block.read, grid.Block.and, grid.Block.write, grid.Block.wire])
    s: sim.Sim = sim.Sim.init(g)
    s.tick()
    error(t, s, 3, 0)
    error(t, s, 5, 0)
}

pub not_with_two_pins_is_an_error(t: *test.T) {
    s: sim.Sim = two_input(grid.Block.not)
    s.tick()
    error(t, s, 2, 1)
}

/* Cells of one gate type merge: two AND cells with a pin each are one AND. */
pub merged_gate_counts_all_pins(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.source, grid.Block.wire, grid.Block.read, grid.Block.and])
    row(&g, 0, 1, [grid.Block.source, grid.Block.wire, grid.Block.read, grid.Block.and, grid.Block.write, grid.Block.wire, grid.Block.led])
    s: sim.Sim = sim.Sim.init(g)
    s.toggle(0, 0, true)
    s.toggle(0, 1, true)
    s.tick()
    high(t, s, 3, 0)
    high(t, s, 6, 1)
}

/* Two sources on one wire: agreeing is fine, disagreeing is contention. */
pub contention_is_an_error(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.source, grid.Block.wire, grid.Block.source])
    g.place(1, 1, grid.Block.led)
    s: sim.Sim = sim.Sim.init(g)
    low(t, s, 1, 0)
    s.toggle(0, 0, true)
    error(t, s, 1, 0)
    error(t, s, 1, 1)
    s.toggle(2, 0, true)
    high(t, s, 1, 0)
}

/* An error on a gate's input spreads to its output a tick later. */
pub error_propagates(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.source, grid.Block.wire, grid.Block.read, grid.Block.not, grid.Block.write, grid.Block.wire])
    g.place(1, 1, grid.Block.source)
    s: sim.Sim = sim.Sim.init(g)
    s.toggle(1, 1, true)
    s.tick()
    error(t, s, 3, 0)
    error(t, s, 5, 0)
}

/* One read pin touching two gates feeds both. */
pub pin_fans_out(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 1, [grid.Block.source, grid.Block.wire, grid.Block.read])
    g.place(2, 0, grid.Block.or)
    g.place(2, 2, grid.Block.not)
    s: sim.Sim = sim.Sim.init(g)
    s.toggle(0, 1, true)
    s.tick()
    high(t, s, 2, 0)
    low(t, s, 2, 2)
}

/* A NOT whose output wire loops back to its read pin oscillates. */
pub not_loop_oscillates(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.wire, grid.Block.wire, grid.Block.wire])
    row(&g, 0, 1, [grid.Block.read, grid.Block.not, grid.Block.write])
    s: sim.Sim = sim.Sim.init(g)
    s.tick()
    high(t, s, 1, 1)
    s.tick()
    low(t, s, 1, 1)
    s.tick()
    high(t, s, 1, 1)
}

pub toggle_rejects_non_source(t: *test.T) {
    s: sim.Sim = two_input(grid.Block.and)
    t.equal(s.toggle(2, 1, true), false)
}

ticks(s: *sim.Sim, n: int) {
    for i: int in 0 .. n { s.tick() }
}

/* An SR latch around one toggle, centered on the board as diagram/latch.bnbx
 * stores it. The toggle (34,15) flips when its input rises, and the input is
 * (S AND NOT Q) OR (R AND Q): high only when the latch must change. Q (output
 * pin (35,15)) runs down column 36 and back along rows 18 and 12; LED at
 * (37,15). Source S (26,15) feeds the upper AND (28,15), the NOT (28,12)
 * feeds its other pin (28,14); source R (29,18) feeds the lower AND (31,18),
 * whose other pin (32,18) reads Q. The ANDs' outputs meet at the OR (31,15). */
latch(): sim.Sim {
    g: grid.Grid = grid.Grid {}
    row(&g, 28, 12, [
        grid.Block.not, grid.Block.read, grid.Block.wire, grid.Block.wire,
        grid.Block.wire, grid.Block.wire, grid.Block.wire, grid.Block.wire,
        grid.Block.wire,
    ])
    g.place(28, 13, grid.Block.write)
    g.place(28, 14, grid.Block.read)
    row(&g, 26, 15, [
        grid.Block.source, grid.Block.read, grid.Block.and, grid.Block.write,
        grid.Block.read, grid.Block.or, grid.Block.write, grid.Block.read,
        grid.Block.toggle, grid.Block.write, grid.Block.wire, grid.Block.led,
    ])
    g.place(31, 16, grid.Block.read)
    g.place(31, 17, grid.Block.write)
    row(&g, 29, 18, [
        grid.Block.source, grid.Block.read, grid.Block.and, grid.Block.read,
        grid.Block.wire, grid.Block.wire, grid.Block.wire, grid.Block.wire,
    ])
    for y: int in 12 .. 19 { g.place(36, y, grid.Block.wire) }
    return sim.Sim.init(g)
}

/* The latch as diagram/latch.bnbx stores it. */
pub latch_matches_file(t: *test.T) {
    data: []u8, err: Error = file.read("diagram/latch.bnbx")
    defer mem.release[u8](&data)
    t.equal(err == null, true)
    stored: sim.Sim, derr: Error = diagram.decode(data)
    t.equal(derr == null, true)
    built: sim.Sim = latch()
    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            test.equal[grid.Block](t, stored.g.get(x, y), built.g.get(x, y))
        }
    }
}

/* Set, reset, and the no-op pulses: S on a set latch and R on a reset one. */
pub sr_latch_holds_a_bit(t: *test.T) {
    s: sim.Sim = latch()
    ticks(&s, 8)
    low(t, s, 37, 15)

    s.toggle(26, 15, true)
    ticks(&s, 8)
    s.toggle(26, 15, false)
    ticks(&s, 8)
    high(t, s, 37, 15)

    s.toggle(26, 15, true)
    ticks(&s, 8)
    s.toggle(26, 15, false)
    ticks(&s, 8)
    high(t, s, 37, 15)

    s.toggle(29, 18, true)
    ticks(&s, 8)
    s.toggle(29, 18, false)
    ticks(&s, 8)
    low(t, s, 37, 15)

    s.toggle(29, 18, true)
    ticks(&s, 8)
    s.toggle(29, 18, false)
    ticks(&s, 8)
    low(t, s, 37, 15)
}

/* S and R together on a latch that is set leave it set, and on a reset one
 * leave it set too: S wins by being seen first, then R holds the input high. */
pub sr_latch_both_inputs(t: *test.T) {
    s: sim.Sim = latch()
    s.toggle(26, 15, true)
    s.toggle(29, 18, true)
    ticks(&s, 12)
    high(t, s, 37, 15)
    s.toggle(26, 15, false)
    s.toggle(29, 18, false)
    ticks(&s, 12)
    high(t, s, 37, 15)
}

/* Source (0,0), pin (1,0), toggle (2,0), write pin (3,0), LED (4,0). */
flipper(): sim.Sim {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [
        grid.Block.source, grid.Block.read, grid.Block.toggle, grid.Block.write,
        grid.Block.led,
    ])
    return sim.Sim.init(g)
}

/* Q flips on each rising edge of the input and holds through a high level and
 * a falling edge. */
pub toggle_flips_on_rising_edge(t: *test.T) {
    s: sim.Sim = flipper()
    ticks(&s, 3)
    low(t, s, 4, 0)
    s.toggle(0, 0, true)
    s.tick()
    high(t, s, 4, 0)
    ticks(&s, 5)
    high(t, s, 4, 0)
    s.toggle(0, 0, false)
    ticks(&s, 5)
    high(t, s, 4, 0)
    s.toggle(0, 0, true)
    s.tick()
    low(t, s, 4, 0)
    s.toggle(0, 0, false)
    ticks(&s, 3)
    low(t, s, 4, 0)
}

/* A toggle with no pins never flips. */
pub toggle_without_a_pin_is_idle(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.toggle, grid.Block.write, grid.Block.led])
    s: sim.Sim = sim.Sim.init(g)
    ticks(&s, 4)
    low(t, s, 2, 0)
}

/* An read pin reading an error makes the toggle's output an error; its Q
 * comes back when the error clears. */
pub toggle_keeps_q_through_an_error(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [
        grid.Block.source, grid.Block.wire, grid.Block.read, grid.Block.toggle,
        grid.Block.write, grid.Block.led,
    ])
    g.place(1, 1, grid.Block.source)
    s: sim.Sim = sim.Sim.init(g)
    s.toggle(0, 0, true)
    s.toggle(1, 1, true)
    s.tick()
    high(t, s, 5, 0)
    s.toggle(1, 1, false)
    s.tick()
    error(t, s, 5, 0)
    s.toggle(0, 0, false)
    ticks(&s, 3)
    high(t, s, 5, 0)
    s.toggle(0, 0, true)
    s.toggle(1, 1, true)
    s.tick()
    low(t, s, 5, 0)
}

/* Placing a block elsewhere regroups the board but keeps a toggle's Q and what
 * it last read, so a held input does not flip it again. */
pub toggle_survives_an_edit(t: *test.T) {
    s: sim.Sim = flipper()
    s.toggle(0, 0, true)
    ticks(&s, 3)
    high(t, s, 4, 0)
    s.place(10, 10, grid.Block.wire)
    ticks(&s, 3)
    high(t, s, 4, 0)
}

/* Sources, pins and LEDs connect by touching; wire only spans distance. */
pub touching_blocks_need_no_wire(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [
        grid.Block.source, grid.Block.read, grid.Block.not, grid.Block.write,
        grid.Block.read, grid.Block.not, grid.Block.write, grid.Block.led,
    ])
    g.place(0, 1, grid.Block.led)
    s: sim.Sim = sim.Sim.init(g)
    s.toggle(0, 0, true)
    high(t, s, 0, 1)
    high(t, s, 1, 0)
    s.tick()
    s.tick()
    high(t, s, 7, 0)
    s.toggle(0, 0, false)
    s.tick()
    s.tick()
    low(t, s, 7, 0)
}

/* Source A runs east and source B runs south through a bridge at (2, 2); each
 * reaches only its own LED. */
pub bridge_crosses_signals(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 2, [grid.Block.source, grid.Block.wire, grid.Block.bridge, grid.Block.wire, grid.Block.led])
    g.place(2, 0, grid.Block.source)
    g.place(2, 1, grid.Block.wire)
    g.place(2, 3, grid.Block.wire)
    g.place(2, 4, grid.Block.led)
    s: sim.Sim = sim.Sim.init(g)
    s.toggle(0, 2, true)
    high(t, s, 4, 2)
    low(t, s, 2, 4)
    v: sim.Level, h: sim.Level = s.cross(2, 2)
    test.equal[sim.Level](t, v, sim.Level.low)
    test.equal[sim.Level](t, h, sim.Level.high)
    high(t, s, 2, 2)
    s.toggle(0, 2, false)
    s.toggle(2, 0, true)
    low(t, s, 4, 2)
    high(t, s, 2, 4)
}

/* A clock at (0, 0) feeding an LED at (1, 0), set to span 3 (8 ticks a half
 * cycle). */
clocked(): sim.Sim {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.clock, grid.Block.led])
    g.span(0, 0, 3)
    return sim.Sim.init(g)
}

pub new_clock_flips_every_tick(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.clock, grid.Block.led])
    s: sim.Sim = sim.Sim.init(g)
    low(t, s, 1, 0)
    ticks(&s, 1)
    high(t, s, 1, 0)
    ticks(&s, 1)
    low(t, s, 1, 0)
}

pub clock_flips_every_half_cycle(t: *test.T) {
    s: sim.Sim = clocked()
    low(t, s, 0, 0)
    low(t, s, 1, 0)
    ticks(&s, 7)
    low(t, s, 1, 0)
    ticks(&s, 1)
    high(t, s, 0, 0)
    high(t, s, 1, 0)
    ticks(&s, 7)
    high(t, s, 1, 0)
    ticks(&s, 1)
    low(t, s, 1, 0)
}

pub clock_drives_a_wire(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.clock, grid.Block.wire, grid.Block.wire, grid.Block.led])
    s: sim.Sim = sim.Sim.init(g)
    ticks(&s, 1)
    high(t, s, 1, 0)
    high(t, s, 3, 0)
}

pub span_sets_a_clock_s_half_cycle(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.clock, grid.Block.led])
    s: sim.Sim = sim.Sim.init(g)
    t.equal(s.span(0, 0, 2), true)
    t.equal(s.g.span(0, 0), 2)
    ticks(&s, 3)
    low(t, s, 1, 0)
    ticks(&s, 1)
    high(t, s, 1, 0)
    t.equal(s.span(1, 0, 2), false)
}

pub toggle_rejects_a_clock(t: *test.T) {
    s: sim.Sim = clocked()
    t.equal(s.toggle(0, 0, true), false)
}

/* Placing elsewhere regroups but keeps the time, so clocks stay in step. */
pub clock_keeps_time_across_a_place(t: *test.T) {
    s: sim.Sim = clocked()
    ticks(&s, 8)
    s.place(5, 5, grid.Block.wire)
    high(t, s, 1, 0)
    ticks(&s, 8)
    low(t, s, 1, 0)
}

/* The shipped ripple counter: its LEDs (row 26) count up by one every 16 ticks. */
pub counter_counts(t: *test.T) {
    data: []u8, err: Error = file.read("diagram/ripple-counter.bnbx")
    defer mem.release[u8](&data)
    s: sim.Sim, derr: Error = diagram.decode(data)
    t.equal(err == null && derr == null, true)
    last: int = -1
    for k: int in 0 .. 30 {
        ticks(&s, 16)
        v: int = 0
        for i: int in 0 .. 8 {
            if s.level(10 + 7 * i, 26) == sim.Level.high { v += 1 << i }
        }
        if k > 1 { t.equal(v, (last + 1) % 256) }
        last = v
    }
}
