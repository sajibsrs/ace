/* binbox: a logic-gate sandbox in an SDL3 window: square blocks on a grid.
 *
 * Build and run from this directory (Homebrew SDL3 on Apple arm64):
 *   ace pkg run
 *
 * A source feeds a gate's read pin (I); the gate's write pin (O) feeds the
 * next read pin or an LED. Each connects by touching, or through wire when
 * apart.
 *
 * Edit builds the board: left-click places the selected block (drag to
 * paint), right-click (or drag) removes. Simulate simulates it (F1 toggles the
 * two): left-click flips
 * a source, space or Auto toggles auto-ticking at the Speed slider's rate, and
 * Step ticks once. Keys
 * select a block: s source, e wire, r read pin, w write pin, 1 AND, 2 OR,
 * 3 NOT, 4 NAND, 5 NOR, 6 XOR, 7 XNOR, l LED, b bridge, k clock, t toggle. The wheel zooms the
 * board about the pointer; the window resizes and goes full screen. Cmd+Q
 * quits. The side panel at the board's right holds the tools: the
 * pencil (above) and box select: drag over blocks to select them, drag the selection to
 * move it, Delete removes it, Escape or a click elsewhere drops it. Cmd+C
 * copies the selection, Cmd+X cuts it, and Cmd+V pastes it as a floating
 * selection at the pointer to drag and drop. Cmd+Z undoes an edit (20 are
 * kept) and Cmd+Shift+Z redoes it; all of these are Edit only. A selection
 * being carried shows the move cursor.
 *
 * Diagrams live in diagram/ as .bnbx files, relative to where it runs. The bar
 * has New, Open (a list of diagram/), Save, and Save as (a name box: a-z, 0-9,
 * - and _; Enter saves, Escape cancels). Cmd+S saves and Cmd+O opens.
 */
import fmt
import time
import (
    init, quit, error, Window, Renderer, Event, InitFlags, WindowFlags, BLEND_ALPHA,
) from sdl
import bar: "./bar.ace"
import grid: "./grid.ace"
import sim: "./sim.ace"
import ui: "./ui.ace"
import app: "./app.ace"
import input: "./input.ace"
import render: "./render.ace"
import view: "./view.ace"

fail(context: string): int {
    fmt.printf("%s: %s\n", context, error())
    return 1
}

main(): int {
    if !init(InitFlags { video = 1 }) { return fail("SDL_Init") }
    defer quit()

    window: Window = Window.new("Binbox", i32(bar.WIDTH), i32(bar.TOP + 16.0 * view.CELL + bar.BELOW), WindowFlags { resizable = 1 })
    defer window.wipe()
    if !window.ok() { return fail("SDL_CreateWindow") }
    window.maximize()

    renderer: Renderer = Renderer.new(window)
    defer renderer.wipe()
    if !renderer.ok() { return fail("SDL_CreateRenderer") }
    renderer.vsync(1)
    /* Icon edges fade out through vertex alpha. */
    renderer.blend(BLEND_ALPHA)

    mouse: input.Input = input.Input.new()
    defer mouse.wipe()

    editor: app.App = app.App { s = sim.Sim.init(grid.Grid {}) }
    if editor.store.locate() != null {
        fmt.println("binbox: cannot find the executable's path")
        return 1
    }
    canvas: ui.Canvas = ui.Canvas {}
    w: f32 = 0.0
    h: f32 = 0.0
    running: bool = true
    for running {
        /* The window may be resized or made full screen. */
        rw: i32, rh: i32, sized: bool = renderer.size()
        if sized {
            w = f32(rw)
            h = f32(rh)
            editor.view.resize(w, h)
        }
        event: Event
        for event.poll() {
            running = mouse.event(&editor, &event) && running
        }
        editor.refresh(window.refresh())
        editor.pace()
        drawing: u64 = time.elapsed()
        render.draw(&editor, &canvas, renderer)
        editor.drawn = time.elapsed() - drawing
        renderer.present()
    }
    return 0
}
