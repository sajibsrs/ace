/* sidebar — the panel at the board's right: its fold button and widgets. */

import fmt
import bar: "./bar.ace"
import theme: "./theme.ace"
import grid: "./grid.ace"
import sim: "./sim.ace"
import speed: "./speed.ace"
import ui
import icon: "./icon.ace"
import app: "./app.ace"
import style: "./style.ace"

pub Sidebar: struct {
    pub g: *app.App = null,
}

/* A widget's header, set apart from its body. */
open(title: string) {
    ui.heading(title)
    ui.space(bar.INSET / 2.0)
}

/* The space after a widget's body. */
close() { ui.space(bar.INSET) }

/* The tools widget: one button per tool, its icon larger than a label's. */
Sidebar.tools(self) {
    g: *app.App = self.g
    plain: ui.Theme = g.ui.theme
    g.ui.theme.icon = bar.TOOL_ICON
    ui.grid(bar.COLS, members(bar.Tool).len)
    for i: usize in 0 .. members(bar.Tool).len {
        each: bar.Tool = members(bar.Tool)[i]
        if ui.button(bar.shape(bar.STRIP_ICON[each]), "", each == g.pick) { g.use(each) }
    }
    g.ui.theme = plain
}

/* The blocks widget: icons alone in rows of COLS, the selected one in its
 * block's color, the rest dimmer. */
Sidebar.blocks(self) {
    g: *app.App = self.g
    plain: ui.Theme = g.ui.theme
    ui.grid(bar.COLS, members(grid.Block).len - 1)
    for i: usize in 1 .. members(grid.Block).len {
        each: grid.Block = members(grid.Block)[i]
        ink: u32 = theme.LOW[each]
        if each == g.block { ink = theme.HIGH[each] }
        /* The wire's and bridge's muted board colors vanish on the panel. */
        if each == grid.Block.wire || each == grid.Block.bridge {
            which: usize = 0
            if each == grid.Block.bridge { which = 1 }
            if each == g.block { which += 2 }
            ink = theme.PANEL_BRIGHT[which]
        }
        g.ui.theme.icon = bar.block_icon(each)
        if ui.swatch(bar.shape(bar.BLOCK_ICON[each]), ui.color(ink), each == g.block) { g.block = each }
    }
    g.ui.theme = plain
}

/* The clock widget: its span in a muted line over the slider. */
Sidebar.clock(self) {
    g: *app.App = self.g
    ticks: *fmt.Buffer = ui.line()
    if g.clock == 0 {
        ticks.printf("1 tick")
    } else {
        ticks.printf("%d ticks", 1 << g.clock)
    }
    ui.muted(ticks.text())
    ui.slider(&g.clock, 0, grid.SPANS - 1)
}

/* The simulation widget: Step, Play/Pause, Reset, and the speed in a muted
 * line over its slider. */
Sidebar.sim(self) {
    g: *app.App = self.g
    ui.row(2)
    if ui.button(bar.shape(icon.Id.step), "Step") { g.step() }
    if g.auto {
        ui.toggle(bar.shape(icon.Id.pause), "Pause", &g.auto)
    } else {
        ui.toggle(bar.shape(icon.Id.run), "Play", &g.auto)
    }
    if ui.button(bar.shape(icon.Id.reset), "Reset") { g.reset() }
    setting: *fmt.Buffer = ui.line()
    setting.printf("Speed ")
    speed.show(setting, speed.hz(g.stop))
    ui.muted(setting.text())
    ui.slider(&g.stop, 0, speed.STOPS - 1)
}

/* The info widget: the cell under the cursor, its block and level, and the
 * board's size. */
Sidebar.info(self, edit: bool) {
    g: *app.App = self.g
    info: *fmt.Buffer = ui.line()
    if g.hx >= 0 { info.printf("X %d, Y %d", g.hx, g.hy) } else { info.printf("X -, Y -") }
    ui.muted(info.text())
    info = ui.line()
    if g.hx >= 0 {
        here: grid.Block = g.s.g.get(g.hx, g.hy)
        info.printf("Block %s", theme.NAME[here])
        if !edit && here != grid.Block.empty {
            level: sim.Level = g.s.level(g.hx, g.hy)
            if level == sim.Level.high { info.printf(" high") }
            if level == sim.Level.low { info.printf(" low") }
            if level == sim.Level.error { info.printf(" error") }
        }
    } else {
        info.printf("Block -")
    }
    ui.muted(info.text())
    info = ui.line()
    info.printf("Grid %d x %d", grid.WIDTH, grid.HEIGHT)
    ui.muted(info.text())
}

/* The header, its fold button and the panel's title on the header color out
 * to the window's edge, then the widgets that apply: the tools in Edit, the
 * blocks with the pencil, the clock's span when it holds the clock, the
 * simulation controls in Simulate, and the info always. */
pub Sidebar.draw(self) {
    g: *app.App = self.g
    side: ui.Rect = g.view.side()
    head: ui.Rect = side.cut_top(bar.BAR)
    reach: f32 = bar.GAP - bar.BORDER
    g.ui.canvas.fill(ui.Rect { x = head.x - reach, y = head.y, w = head.w + bar.GAP + reach, h = head.h }, ui.color(theme.DEEP))
    top: ui.Area = ui.area(head, ui.Flow.across)
    fold_icon: icon.Id = icon.Id.panel_right
    if g.view.shut { fold_icon = icon.Id.panel_left }
    plain: ui.Theme = g.ui.theme
    g.ui.theme.button.rest = ui.color(theme.DEEP)
    if ui.button(bar.shape(fold_icon)) { g.view.fold() }
    g.ui.theme = plain
    edit: bool = g.phase == app.Phase.edit
    if !g.view.shut {
        ui.space(style.HEADING_PAD - g.ui.theme.gap)
        if edit { ui.text("Editor") } else { ui.text("Simulation") }
    }
    top.end()
    if g.view.shut { return }

    body: ui.Area = ui.area(side.inset(ui.Insets { top = bar.GAP, left = bar.INSET, right = bar.INSET }))
    defer body.end()
    pencil: bool = g.pick == bar.Tool.pencil
    if edit {
        open("Tools")
        self.tools()
        close()
    }
    if edit && pencil {
        open("Blocks")
        self.blocks()
        close()
    }
    if edit && pencil && g.block == grid.Block.clock {
        open("Clock")
        self.clock()
        close()
    }
    if !edit {
        open("Simulate")
        self.sim()
        close()
    }
    open("Info")
    self.info(edit)
}
