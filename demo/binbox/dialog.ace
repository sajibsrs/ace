/* dialog — the Open list and the Save-as box, over everything else. */

import Keycode from sdl
import bar: "./bar.ace"
import theme: "./theme.ace"
import diagram: "./diagram.ace"
import ui
import app: "./app.ace"
import style: "./style.ace"

/* What a diagram's name may hold. */
NAME_CHARS: const string = "abcdefghijklmnopqrstuvwxyz0123456789-_"

pub OpenList: struct {
    pub g: *app.App = null,
}

/* A press on a row opens it; any press closes the list. `live` is false in the
 * frame the list opens, whose press belongs to the toolbar. The list hangs
 * under the Open button, keeps to the window, and scrolls when it
 * overflows. */
pub OpenList.draw(self, live: bool) {
    g: *app.App = self.g
    if !live { g.ui.mouse.pressed = false }
    names: []string = g.store.list.names[0..g.store.list.count]
    /* The rows that fit under the toolbar, at least one. */
    room: f32 = g.view.height() - (bar.GAP + bar.BAR)
    rows: usize = names.len
    for rows > 1 && ui.rows(rows) > room { rows -= 1 }
    if rows == 0 { rows = 1 }
    panel: ui.Rect = ui.Rect { x = g.opener.x, y = bar.GAP + bar.BAR, w = bar.LIST_W, h = ui.rows(rows) }
    list: ui.Area = ui.popup(panel)
    defer list.end()
    chosen: usize = names.len
    if names.len == 0 { ui.text("no diagrams in diagram/", style.muted(&g.ui.theme)) }
    if ui.list(names, &chosen, rows, &g.scroll) { g.load(names[chosen]) }
    if g.ui.mouse.pressed { g.mode = app.Mode.none }
}

pub SaveDialog: struct {
    pub g: *app.App = null,
}

/* Esc is read ahead of the field, which takes every other key; the box is
 * modal, so its field always has the keyboard. */
pub SaveDialog.draw(self) {
    g: *app.App = self.g
    if ui.key(Keycode.escape) { g.mode = app.Mode.none }
    panel: ui.Rect = g.view.panel()
    box: ui.Area = ui.popup(panel)
    defer box.end()
    inside: ui.Area = ui.area(panel.inset(ui.Insets.all(style.DIALOG_PAD)))
    defer inside.end()
    ui.text("Save as     Enter saves, Esc cancels")
    input: ui.TextInput = ui.TextInput { buffer = g.draft.bytes[..], len = g.draft.len, caret = g.draft.at }
    ui.focus()
    ui.field(&input, NAME_CHARS)
    g.draft.len = input.len
    g.draft.at = input.caret
    /* The extension, dimmed: it is added, not typed. */
    pad: f32 = g.ui.theme.field.box.padding.left + ui.text_width(string(g.draft.bytes[0..g.draft.len]))
    g.ui.canvas.text(ui.last().rect.inset(ui.Insets { left = pad }), diagram.EXTENSION, g.ui.theme.font.in(ui.color(theme.DIM)))
    if ui.last().submit && g.draft.len > 0 {
        g.mode = app.Mode.none
        g.write()
    }
}
