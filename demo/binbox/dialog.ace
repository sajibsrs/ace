/* dialog — the Open list and the Save-as box, over everything else. */

import fmt
import bar: "./bar.ace"
import theme: "./theme.ace"
import diagram: "./diagram.ace"
import ui
import app: "./app.ace"
import style: "./style.ace"

ID_ROW: const u32 = 200

pub OpenList: struct {
    pub g: *app.App = null,
}

/* A press on a row opens it; any press closes the list. `live` is false in the
 * frame the list opens, whose press belongs to the toolbar. */
pub OpenList.draw(self, ctx: *ui.Ctx, live: bool) {
    g: *app.App = self.g
    canvas: *ui.Canvas = ctx.canvas
    ctx.blocked = false
    if !live { ctx.pressed = false }
    rows: usize = g.store.list.count
    if rows == 0 { rows = 1 }
    canvas.round(bar.list(rows), style.RADIUS, ui.color(theme.BUTTON))
    pad: f32 = bar.LIST_PAD + style.TEXT_PAD
    if g.store.list.count == 0 {
        canvas.left(bar.row(0), pad, "no diagrams in diagram/", theme.DIM)
    }
    chosen: usize = g.store.list.count
    for i: usize in 0 .. g.store.list.count {
        look: ui.ButtonStyle = ui.ButtonStyle { rest = theme.BUTTON, hover = theme.ACTIVE, press = theme.PRESS, ink = theme.INK }
        if i % 2 == 1 { look.rest = theme.STRIPE }
        if ctx.row(ID_ROW + u32(i), bar.row(i), pad, g.store.list.names[i], look).press { chosen = i }
    }
    if ctx.pressed { g.mode = app.Mode.none }
    if chosen < g.store.list.count { g.load(g.store.list.names[chosen]) }
}

pub SaveDialog: struct {
    pub g: *app.App = null,
}

pub SaveDialog.draw(self, canvas: *ui.Canvas) {
    g: *app.App = self.g
    panel: ui.Rect = g.view.panel()
    field: ui.Rect = ui.Rect { x = panel.x + style.DIALOG_PAD, y = panel.y + style.FIELD_Y, w = panel.w - 2.0 * style.DIALOG_PAD, h = style.FIELD_H }
    canvas.round(panel, style.RADIUS, ui.color(theme.DIM))
    canvas.round(panel.inset(ui.Insets.all(1.0)), style.RADIUS - 1.0, ui.color(theme.BUTTON))
    canvas.round(field, style.RADIUS, ui.color(theme.CHROME))
    /* The cursor: a bar before byte `at`. */
    caret: f32 = field.x + style.TEXT_PAD + f32(g.draft.at) * ui.GLYPH
    canvas.fill(ui.Rect { x = caret - style.CARET_W / 2.0, y = field.y + style.CARET_PAD, w = style.CARET_W, h = field.h - 2.0 * style.CARET_PAD }, ui.color(theme.INK))
    title: ui.Rect = ui.Rect { x = panel.x, y = panel.y + style.DIALOG_TITLE_Y, w = panel.w, h = style.DIALOG_TITLE_H }
    canvas.left(title, style.DIALOG_PAD, "Save as     Enter saves, Esc cancels", theme.INK)
    storage: [64]u8
    b: fmt.Buffer = fmt.Buffer.init(storage[..])
    b.printf("%s", g.draft.text())
    canvas.left(field, style.TEXT_PAD, b.text(), theme.INK)
    /* The extension, dimmed: it is added, not typed. */
    canvas.left(field, style.TEXT_PAD + ui.GLYPH * f32(g.draft.len), diagram.EXTENSION, theme.DIM)
}
