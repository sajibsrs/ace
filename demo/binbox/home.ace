/* home — the screen binbox starts on: one tile for each screen to open.
 *
 * Also the events every screen but the editor shares: quitting and the
 * pointer.
 */

import math
import Renderer, Event, EventType, Keycode, KeyboardEvent, MouseButton, MouseButtonEvent, MouseMotionEvent, Color from sdl
import ui: "./ui.ace"
import icon: "./icon.ace"
import theme: "./theme.ace"

/* The screens binbox shows: the home screen it starts on, and the two it opens. */
pub Screen: enum u8 { home, diagram, program }

/* SDL_KMOD_GUI: either side's Command (Windows) key. */
KMOD_GUI: const u16 = 0x0c00

/* A tile's size in a wide window, the gap between the two, and the margin
 * kept to the window's left and right edges, which narrows the tiles. */
TILE_W: const f32 = 320.0
TILE_H: const f32 = 300.0
TILE_GAP: const f32 = 24.0
MARGIN: const f32 = 20.0
/* The tile icon's side, and its distance above the tile's middle. */
TILE_ICON: const f32 = 112.0
/* The text scales: debug text is 8 pixels, drawn this many times larger. */
TITLE_SCALE: const f32 = 3.0
NOTE_SCALE: const f32 = 2.0

/* Each tile's color, and the lighter one under the pointer. */
FILL: [Screen]u32 = [
    Screen.home = 0x000000,
    Screen.diagram = 0x2a517e,
    Screen.program = 0x2a6851,
]
HOVER: [Screen]u32 = [
    Screen.home = 0x000000,
    Screen.diagram = 0x3a6aa0,
    Screen.program = 0x3a8566,
]

/* The window title of each screen. */
pub TITLE: [Screen]string = [
    Screen.home = "Binbox",
    Screen.diagram = "Binbox - Diagram",
    Screen.program = "Binbox - Program",
]

NAME: [Screen]string = [
    Screen.home = "",
    Screen.diagram = "Diagram",
    Screen.program = "Program",
]

NOTE: [Screen]string = [
    Screen.home = "",
    Screen.diagram = "Logic gates",
    Screen.program = "Coming soon...",
]

TILE_ICONS: [Screen]icon.Id = [
    Screen.home = icon.Id.home,
    Screen.diagram = icon.Id.and,
    Screen.program = icon.Id.bars,
]

/* Whether `event` asks to quit: closing the window, or Cmd+Q. */
pub quits(event: *Event): bool {
    if event.type == EventType.quit || event.type == EventType.window_close_requested { return true }
    key: KeyboardEvent, is_key: bool = event.key()
    return is_key && key.down && (key.mod & KMOD_GUI) != 0 && key.key == Keycode.q
}

/* The tile that opens `screen` in a window of `w` x `h`: the two sit side by
 * side, centered. */
tile(screen: Screen, w: f32, h: f32): ui.Rect {
    side: f32 = math.min[f32](TILE_W, (w - 2.0 * MARGIN - TILE_GAP) / 2.0)
    left: f32 = (w - 2.0 * side - TILE_GAP) / 2.0
    return ui.Rect { x = left + f32(int(screen) - 1) * (side + TILE_GAP), y = (h - TILE_H) / 2.0, w = side, h = TILE_H }
}

/* `text` centered in `box`, drawn `scale` times larger than the debug font. */
big(r: Renderer, box: ui.Rect, text: string, ink: u32, scale: f32) {
    r.scale(scale, scale)
    ui.center(r, ui.Rect { x = box.x / scale, y = box.y / scale, w = box.w / scale, h = box.h / scale }, text, ink)
    r.scale(1.0, 1.0)
}

/* Where the pointer is, so the tile under it lights. */
pub Home: struct {
    mx: f32 = -1.0,
    my: f32 = -1.0,
}

/* Handles one event in a window of `w` x `h`; returns the screen a click
 * opened, or `Screen.home` when it opened none. */
pub Home.event(self, event: *Event, w: f32, h: f32): Screen {
    m: MouseMotionEvent, is_motion: bool = event.mouse_motion()
    if is_motion {
        self.mx = m.x
        self.my = m.y
    }
    b: MouseButtonEvent, is_button: bool = event.mouse_button()
    if is_button && b.down && b.button == MouseButton.left {
        if tile(Screen.diagram, w, h).has(b.x, b.y) { return Screen.diagram }
        if tile(Screen.program, w, h).has(b.x, b.y) { return Screen.program }
    }
    return Screen.home
}

pub Home.draw(self, canvas: *ui.Canvas, r: Renderer, w: f32, h: f32) {
    r.color(Color.hex(theme.WINDOW))
    r.clear()
    for i: usize in 1 .. members(Screen).len {
        each: Screen = members(Screen)[i]
        at: ui.Rect = tile(each, w, h)
        rgb: u32 = FILL[each]
        if at.has(self.mx, self.my) { rgb = HOVER[each] }
        canvas.fill(at, Color.hex(rgb))
    }
    canvas.flush(r)
    for i: usize in 1 .. members(Screen).len {
        each: Screen = members(Screen)[i]
        at: ui.Rect = tile(each, w, h)
        top: f32 = at.y + at.h / 2.0 - TILE_ICON + 8.0
        canvas.icon(r, TILE_ICONS[each], ui.Rect { x = at.x + (at.w - TILE_ICON) / 2.0, y = top, w = TILE_ICON, h = TILE_ICON }, Color.hex(theme.INK))
    }
    canvas.flush(r)
    for i: usize in 1 .. members(Screen).len {
        each: Screen = members(Screen)[i]
        at: ui.Rect = tile(each, w, h)
        big(r, ui.Rect { x = at.x, y = at.y + at.h / 2.0 + 28.0, w = at.w, h = 24.0 }, NAME[each], theme.INK, TITLE_SCALE)
        big(r, ui.Rect { x = at.x, y = at.y + at.h / 2.0 + 72.0, w = at.w, h = 16.0 }, NOTE[each], 0xb8c4d0, NOTE_SCALE)
    }
    r.present()
}
