/* render — draws the editor: the board, the bars, and the Open and Save-as
 * panels, over a Canvas flushed in layers.
 */

import math
import Renderer, Texture, Point, Color, BLEND_NONE, BLEND_ADD from sdl
import bar: "./bar.ace"
import theme: "./theme.ace"
import grid: "./grid.ace"
import sim: "./sim.ace"
import ui
import app: "./app.ace"
import select: "./select.ace"
import toolbar: "./toolbar.ace"
import sidebar: "./sidebar.ace"
import footer: "./footer.ace"
import dialog: "./dialog.ace"

ERROR: const u32 = 0xb030b0

/* `from` moved `percent` of the way to `to`, channel by channel. */
mix(from: u32, to: u32, percent: u32): u32 {
    r: u32 = ((from / 0x10000) % 0x100 * (100 - percent) + (to / 0x10000) % 0x100 * percent) / 100
    g: u32 = ((from / 0x100) % 0x100 * (100 - percent) + (to / 0x100) % 0x100 * percent) / 100
    b: u32 = (from % 0x100 * (100 - percent) + to % 0x100 * percent) / 100
    return r * 0x10000 + g * 0x100 + b
}

/* How far an icon sits from its block's fill, toward black: the icon keeps
 * the block's own hue, so no icon stands out from the rest. */
SHADE: const u32 = 25

/* The color of block `b`'s icon while it shows `level`. */
icon_ink(b: grid.Block, level: sim.Level): u32 {
    if level == sim.Level.error { return mix(ERROR, 0x000000, SHADE) }
    if level == sim.Level.high { return mix(theme.HIGH[b], 0x000000, SHADE) }
    return mix(theme.LOW[b], 0x000000, SHADE)
}

/* Block icons show only above this zoom; at it and below, a block is its
 * color alone. */
ICON_ZOOM: const f32 = 0.5

/* How far a block's sides reach down and to the left of its cell, and how
 * far toward black each is shaded; the top face stays on the grid. */
RISE: const f32 = 0.14
/* The opacity of the block that follows the pointer. */
GHOST: const f32 = 0.5
SIDE_LEFT: const u32 = 30
SIDE_BOTTOM: const u32 = 50

/* `rgb` at opacity `alpha`. */
shade(rgb: u32, alpha: f32): Color {
    c: Color = Color.hex(rgb)
    return Color { r = c.r, g = c.g, b = c.b, a = alpha }
}

/* The sides of the block in `cell`, on whichever of its left and bottom edges
 * nothing else covers: each a slanted strip from the top face's edge. */
extrude(canvas: *ui.Canvas, cell: ui.Rect, rgb: u32, alpha: f32, left: bool, bottom: bool) {
    d: f32 = cell.w * RISE
    x1: f32 = cell.x + cell.w
    y1: f32 = cell.y + cell.h
    tl: Point = Point { x = cell.x, y = cell.y }
    bl: Point = Point { x = cell.x, y = y1 }
    br: Point = Point { x = x1, y = y1 }
    sl: Point = Point { x = cell.x - d, y = cell.y + d }
    sb: Point = Point { x = cell.x - d, y = y1 + d }
    sr: Point = Point { x = x1 - d, y = y1 + d }
    if left {
        c: Color = shade(mix(rgb, 0x000000, SIDE_LEFT), alpha)
        canvas.triangle(tl, bl, sb, c)
        canvas.triangle(tl, sb, sl, c)
    }
    if bottom {
        c: Color = shade(mix(rgb, 0x000000, SIDE_BOTTOM), alpha)
        canvas.triangle(bl, br, sr, c)
        canvas.triangle(bl, sr, sb, c)
    }
}

/* The fill of the block at (x, y): its level's color, or ERROR. */
face(g: *app.App, b: grid.Block, x: int, y: int): u32 {
    /* Edit shows only how the board is built: no levels. */
    v: sim.Level = sim.Level.low
    if g.phase == app.Phase.run { v = g.s.level(x, y) }
    if v == sim.Level.error && b != grid.Block.empty { return ERROR }
    if v == sim.Level.high { return theme.HIGH[b] }
    return theme.LOW[b]
}

/* An icon's box inside `cell`, with a margin. */
icon_box(cell: ui.Rect): ui.Rect {
    m: f32 = cell.w * 0.12
    return cell.inset(ui.Insets.all(m))
}

/* Whether the board has no block at (x, y), off the board included. */
bare(g: *app.App, x: int, y: int): bool {
    if x < 0 || y < 0 || x >= grid.WIDTH || y >= grid.HEIGHT { return true }
    return g.s.g.get(x, y) == grid.Block.empty
}

/* The sizes bloom blurs through: full, then halved down to 1/32. */
PASSES: const usize = 6
/* How strongly the blurred image lights the board. */
GLOW: const f32 = 0.08

/* The offscreen images of bloom, sized to the window. */
pub Bloom: struct {
    pass: [PASSES]Texture,
    w: i32,
    h: i32,
}

pub Bloom.wipe(self) {
    for i: usize in 0 .. PASSES { self.pass[i].wipe() }
}

/* Makes the images match a w x h window; false when it cannot. */
Bloom.fit(self, r: Renderer, w: i32, h: i32): bool {
    if w != self.w || h != self.h {
        self.wipe()
        self.w = w
        self.h = h
        for i: usize in 0 .. PASSES {
            self.pass[i] = Texture.new(r, math.max[i32](w >> i32(i), 1), math.max[i32](h >> i32(i), 1))
            if !self.pass[i].ok() { return false }
        }
    }
    return self.pass[PASSES - 1].ok()
}

/* Lights the board with its high blocks, blurred as one image so neighbors
 * melt together: halved down the passes, then each added back up into the
 * next larger one, which is smoother than one stretch to full size. The
 * images start opaque black, so only GLOW scales what is added. */
draw_bloom(g: *app.App, canvas: *ui.Canvas, r: Renderer, bloom: *Bloom, a: ui.Rect) {
    w: i32, h: i32, sized: bool = r.size()
    if !sized || !bloom.fit(r, w, h) { return }
    r.target(bloom.pass[0])
    r.color(Color {})
    r.clear()
    lit: bool = false
    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            b: grid.Block = g.s.g.get(x, y)
            if b == grid.Block.empty || g.s.level(x, y) != sim.Level.high || !g.view.shows(x, y, a) { continue }
            canvas.fill(g.view.box(x, y), Color.hex(theme.HIGH[b]))
            lit = true
        }
    }
    canvas.flush(r)
    if lit {
        for i: usize in 1 .. PASSES {
            r.target(bloom.pass[i])
            bloom.pass[i - 1].blend(BLEND_NONE)
            r.copy(bloom.pass[i - 1])
        }
        for i: usize in 1 .. PASSES - 1 {
            at: usize = PASSES - 1 - i
            r.target(bloom.pass[at])
            bloom.pass[at + 1].blend(BLEND_ADD)
            r.copy(bloom.pass[at + 1])
        }
    }
    r.target(blank(Texture))
    if lit {
        bloom.pass[1].blend(BLEND_ADD)
        bloom.pass[1].alpha(GLOW)
        r.copy(bloom.pass[1])
        bloom.pass[1].alpha(1.0)
    }
}

draw_board(g: *app.App, canvas: *ui.Canvas, r: Renderer, bloom: *Bloom) {
    a: ui.Rect = g.view.area()
    /* The board's panel; nothing below is drawn outside it. */
    canvas.fill(a, Color.hex(theme.PANEL))
    canvas.flush(r)
    r.clip(i32(a.x), i32(a.y), i32(a.w), i32(a.h))
    /* Empty cells keep a gap so the grid shows. Block sides go down next, then
     * every top face over them, so a side shows only where no block covers it. */
    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            if !g.view.shows(x, y, a) { continue }
            box: ui.Rect = g.view.box(x, y)
            b: grid.Block = g.s.g.get(x, y)
            if b == grid.Block.empty {
                canvas.fill(box.inset(ui.Insets.all(theme.CELL_GAP)), Color.hex(theme.LOW[b]))
            }
        }
    }
    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            b: grid.Block = g.s.g.get(x, y)
            if b == grid.Block.empty || !g.view.shows(x, y, a) { continue }
            if g.depth { extrude(canvas, g.view.box(x, y), face(g, b, x, y), 1.0, bare(g, x - 1, y), bare(g, x, y + 1)) }
        }
    }
    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            b: grid.Block = g.s.g.get(x, y)
            if b == grid.Block.empty || !g.view.shows(x, y, a) { continue }
            canvas.fill(g.view.box(x, y), Color.hex(face(g, b, x, y)))
        }
    }
    /* Icons next, then whatever follows the pointer, each over all before it. */
    icons: bool = g.view.level() > ICON_ZOOM
    if icons {
        for y: int in 0 .. grid.HEIGHT {
            for x: int in 0 .. grid.WIDTH {
                b: grid.Block = g.s.g.get(x, y)
                if b == grid.Block.empty || b == grid.Block.wire || !g.view.shows(x, y, a) { continue }
                level: sim.Level = sim.Level.low
                if g.phase == app.Phase.run { level = g.s.level(x, y) }
                canvas.icon(bar.shape(bar.BLOCK_ICON[b]), icon_box(g.view.box(x, y)), Color.hex(icon_ink(b, level)))
            }
        }
    }
    canvas.flush(r)
    if g.phase == app.Phase.run { draw_bloom(g, canvas, r, bloom, a) }
    if g.sel.drag == select.Drag.move || g.sel.held {
        draw_lifted(g, canvas, r, false)
        if icons { draw_lifted(g, canvas, r, true) }
    }
    if hovers(g) {
        at: ui.Rect = g.view.box(g.hx, g.hy)
        if !g.snap { at = ui.Rect { x = g.mx - at.w / 2.0, y = g.my - at.h / 2.0, w = at.w, h = at.h } }
        /* It floats over the board, half see-through and half size, centered
         * on the pointer or the snapped cell, with no sides. */
        at = ui.Rect { x = at.x + at.w / 4.0, y = at.y + at.h / 4.0, w = at.w / 2.0, h = at.h / 2.0 }
        canvas.fill(at, shade(theme.LOW[g.block], GHOST))
        if icons && g.block != grid.Block.wire { canvas.icon(bar.shape(bar.BLOCK_ICON[g.block]), icon_box(at), shade(icon_ink(g.block, sim.Level.low), GHOST)) }
    }
    /* The box being drawn, or the selection, carried along while it moves. */
    if g.sel.drag == select.Drag.box {
        canvas.dashed(g.view.span(math.min[int](g.sel.ax, g.sel.bx), math.min[int](g.sel.ay, g.sel.by), math.max[int](g.sel.ax, g.sel.bx), math.max[int](g.sel.ay, g.sel.by)), 2.0, Color.hex(theme.DIM), a)
    }
    if g.sel.on && g.sel.drag != select.Drag.box {
        canvas.dashed(g.view.span(g.sel.x0 + g.sel.dx, g.sel.y0 + g.sel.dy, g.sel.x1 + g.sel.dx, g.sel.y1 + g.sel.dy), 2.0, Color.hex(theme.DIM), a)
    }
    canvas.flush(r)
    r.unclip()
}

/* The block carried at (x, y) of the selection, empty off its edge. */
carried(g: *app.App, x: int, y: int): grid.Block {
    if x < g.sel.x0 || y < g.sel.y0 || x > g.sel.x1 || y > g.sel.y1 { return grid.Block.empty }
    return g.sel.pad[0].lift[(y - g.sel.y0) * (g.sel.x1 - g.sel.x0 + 1) + x - g.sel.x0]
}

/* The blocks being carried, `icons` or their fills, at the drag's offset. */
draw_lifted(g: *app.App, canvas: *ui.Canvas, r: Renderer, icons: bool) {
    /* Fills go down in two passes, as on the board: sides, then top faces. */
    for pass: int in 0 .. 2 {
        for y: int in g.sel.y0 .. g.sel.y1 + 1 {
            for x: int in g.sel.x0 .. g.sel.x1 + 1 {
                b: grid.Block = carried(g, x, y)
                if b == grid.Block.empty { continue }
                cell: ui.Rect = g.view.box(x + g.sel.dx, y + g.sel.dy)
                if icons {
                    if pass == 0 && b != grid.Block.wire { canvas.icon(bar.shape(bar.BLOCK_ICON[b]), icon_box(cell), Color.hex(icon_ink(b, sim.Level.low))) }
                } else if pass == 0 {
                    if g.depth { extrude(canvas, cell, theme.LOW[b], 1.0, carried(g, x - 1, y) == grid.Block.empty, carried(g, x, y + 1) == grid.Block.empty) }
                } else {
                    canvas.fill(cell, Color.hex(theme.LOW[b]))
                }
            }
        }
    }
}

/* Whether the pencil's block shows under the pointer, as a preview of where
 * a click puts it. */
hovers(g: *app.App): bool {
    return g.mode == app.Mode.none && g.phase == app.Phase.edit && g.pick == bar.Tool.pencil && g.hx >= 0
}

draw_bars(g: *app.App, canvas: *ui.Canvas, r: Renderer) {
    foot: ui.Rect = g.view.foot()
    top: ui.Rect = g.view.head()
    panel: ui.Rect = g.view.side()
    /* Each bar fills out to the window's edge; the window color shows only as
     * bar.BORDER-wide lines under the header, above the footer, and left of the
     * panel. */
    chrome: Color = Color.hex(theme.CHROME)
    reach: f32 = bar.GAP - bar.BORDER
    wide: f32 = top.w + 2.0 * bar.GAP
    canvas.fill(ui.Rect { x = 0.0, y = 0.0, w = wide, h = top.y + top.h + reach }, chrome)
    canvas.fill(ui.Rect { x = 0.0, y = foot.y - reach, w = wide, h = foot.h + bar.GAP + reach }, chrome)
    canvas.fill(ui.Rect { x = panel.x - reach, y = panel.y, w = panel.w + bar.GAP + reach, h = panel.h }, chrome)
    canvas.flush(r)
    bar_top: toolbar.Toolbar = toolbar.Toolbar { g = g }
    bar_top.draw(&g.ctx)
    panel_side: sidebar.Sidebar = sidebar.Sidebar { g = g }
    panel_side.draw(&g.ctx)
    status: footer.Footer = footer.Footer { g = g }
    status.draw(canvas)
    canvas.flush(r)
}

pub draw(g: *app.App, canvas: *ui.Canvas, r: Renderer, bloom: *Bloom) {
    /* A dialog takes the pointer from what lies under it. */
    listing: bool = g.mode == app.Mode.open
    g.ctx.blocked = g.mode != app.Mode.none
    g.ctx.canvas = canvas
    g.ctx.x = g.mx
    g.ctx.y = g.my
    r.color(Color.hex(theme.WINDOW))
    r.clear()
    draw_board(g, canvas, r, bloom)
    draw_bars(g, canvas, r)
    if g.mode == app.Mode.open {
        list: dialog.OpenList = dialog.OpenList { g = g }
        list.draw(&g.ctx, listing)
    }
    if g.mode == app.Mode.save_as {
        ask: dialog.SaveDialog = dialog.SaveDialog { g = g }
        ask.draw(&g.ctx)
    }
    canvas.flush(r)
}
