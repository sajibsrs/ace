/* render — draws the editor: the board, the bars, and the Open and Save-as
 * panels, over a Canvas flushed in layers.
 */

import fmt
import math
import Renderer, Point, Color from sdl
import bar: "./bar.ace"
import theme: "./theme.ace"
import grid: "./grid.ace"
import sim: "./sim.ace"
import diagram: "./diagram.ace"
import ui: "./ui.ace"
import app: "./app.ace"
import select: "./select.ace"

NAME: [grid.Block]string = [
    grid.Block.empty = "empty",
    grid.Block.source = "source",
    grid.Block.wire = "wire",
    grid.Block.input = "input",
    grid.Block.output = "output",
    grid.Block.and = "AND",
    grid.Block.or = "OR",
    grid.Block.not = "NOT",
    grid.Block.nand = "NAND",
    grid.Block.nor = "NOR",
    grid.Block.xor = "XOR",
    grid.Block.xnor = "XNOR",
    grid.Block.led = "LED",
    grid.Block.bridge = "bridge",
]

/* Low and high colors of each block; any block on an error is ERROR. */
LOW: [grid.Block]u32 = [
    grid.Block.empty = 0x171b20,
    grid.Block.source = 0x478f59,
    grid.Block.wire = 0x4d5b6c,
    grid.Block.input = 0x4e6da3,
    grid.Block.output = 0x8c4d51,
    grid.Block.and = 0xb59b45,
    grid.Block.or = 0x42ad9f,
    grid.Block.not = 0xd871b2,
    grid.Block.nand = 0x926a35,
    grid.Block.nor = 0x2f7b8a,
    grid.Block.xor = 0xa66ee6,
    grid.Block.xnor = 0xb142b8,
    grid.Block.led = 0x8c8c8c,
    grid.Block.bridge = 0x504e68,
]

HIGH: [grid.Block]u32 = [
    grid.Block.empty = 0x171b20,
    grid.Block.source = 0x55d675,
    grid.Block.wire = 0x6e8db3,
    grid.Block.input = 0x598eea,
    grid.Block.output = 0xd14f58,
    grid.Block.and = 0xfcd247,
    grid.Block.or = 0x45f4dd,
    grid.Block.not = 0xff6cc9,
    grid.Block.nand = 0xd99439,
    grid.Block.nor = 0x32b7d1,
    grid.Block.xor = 0xaa60ff,
    grid.Block.xnor = 0xf442ff,
    grid.Block.led = 0xffffff,
    grid.Block.bridge = 0x7772af,
]

ERROR: const u32 = 0xb030b0

/* `from` moved `percent` of the way to `to`, channel by channel. */
mix(from: u32, to: u32, percent: u32): u32 {
    r: u32 = ((from / 0x10000) % 0x100 * (100 - percent) + (to / 0x10000) % 0x100 * percent) / 100
    g: u32 = ((from / 0x100) % 0x100 * (100 - percent) + (to / 0x100) % 0x100 * percent) / 100
    b: u32 = (from % 0x100 * (100 - percent) + to % 0x100 * percent) / 100
    return r * 0x10000 + g * 0x100 + b
}

/* How far an icon sits from its block's fill, toward black: the icon keeps
 * the block's own hue, so no icon stands out from the rest. */
SHADE: const u32 = 35

/* The color of block `b`'s icon while it shows `level`. */
icon_ink(b: grid.Block, level: sim.Level): u32 {
    if level == sim.Level.error { return mix(ERROR, 0x000000, SHADE) }
    if level == sim.Level.high { return mix(HIGH[b], 0x000000, SHADE) }
    return mix(LOW[b], 0x000000, SHADE)
}

/* How far a block's sides reach down and to the left of its cell, and how
 * far toward black each is shaded; the top face stays on the grid. */
RISE: const f32 = 0.14
/* The opacity of the block that follows the pointer. */
GHOST: const f32 = 0.5
SIDE_LEFT: const u32 = 30
SIDE_BOTTOM: const u32 = 50

/* `rgb` at opacity `alpha`. */
shade(rgb: u32, alpha: f32): Color {
    c: Color = Color.hex(rgb)
    return Color { r = c.r, g = c.g, b = c.b, a = alpha }
}

/* The sides of the block in `cell`, on whichever of its left and bottom edges
 * nothing else covers: each a slanted strip from the top face's edge. */
extrude(canvas: *ui.Canvas, cell: ui.Rect, rgb: u32, alpha: f32, left: bool, bottom: bool) {
    d: f32 = cell.w * RISE
    x1: f32 = cell.x + cell.w
    y1: f32 = cell.y + cell.h
    tl: Point = Point { x = cell.x, y = cell.y }
    bl: Point = Point { x = cell.x, y = y1 }
    br: Point = Point { x = x1, y = y1 }
    sl: Point = Point { x = cell.x - d, y = cell.y + d }
    sb: Point = Point { x = cell.x - d, y = y1 + d }
    sr: Point = Point { x = x1 - d, y = y1 + d }
    if left {
        c: Color = shade(mix(rgb, 0x000000, SIDE_LEFT), alpha)
        canvas.triangle(tl, bl, sb, c)
        canvas.triangle(tl, sb, sl, c)
    }
    if bottom {
        c: Color = shade(mix(rgb, 0x000000, SIDE_BOTTOM), alpha)
        canvas.triangle(bl, br, sr, c)
        canvas.triangle(bl, sr, sb, c)
    }
}

/* The fill of the block at (x, y): its level's color, or ERROR. */
face(g: *app.App, b: grid.Block, x: int, y: int): u32 {
    /* Edit shows only how the board is built: no levels. */
    v: sim.Level = sim.Level.low
    if g.phase == app.Phase.run { v = g.s.level(x, y) }
    if v == sim.Level.error && b != grid.Block.empty { return ERROR }
    if v == sim.Level.high { return HIGH[b] }
    return LOW[b]
}

/* An icon's box inside `cell`, with a margin. */
icon_box(cell: ui.Rect): ui.Rect {
    m: f32 = cell.w * 0.12
    return ui.Rect { x = cell.x + m, y = cell.y + m, w = cell.w - 2.0 * m, h = cell.h - 2.0 * m }
}

/* Whether the board has no block at (x, y), off the board included. */
bare(g: *app.App, x: int, y: int): bool {
    if x < 0 || y < 0 || x >= grid.WIDTH || y >= grid.HEIGHT { return true }
    return g.s.g.get(x, y) == grid.Block.empty
}

draw_board(g: *app.App, canvas: *ui.Canvas, r: Renderer) {
    a: ui.Rect = g.view.area()
    /* The board's panel; nothing below is drawn outside it. */
    canvas.fill(a, Color.hex(theme.PANEL))
    canvas.flush(r)
    r.clip(i32(a.x), i32(a.y), i32(a.w), i32(a.h))
    /* Empty cells keep a gap so the grid shows. Block sides go down next, then
     * every top face over them, so a side shows only where no block covers it. */
    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            if !g.view.shows(x, y, a) { continue }
            box: ui.Rect = g.view.box(x, y)
            b: grid.Block = g.s.g.get(x, y)
            if b == grid.Block.empty {
                canvas.fill(ui.Rect { x = box.x + 1.0, y = box.y + 1.0, w = box.w - 2.0, h = box.h - 2.0 }, Color.hex(LOW[b]))
            }
        }
    }
    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            b: grid.Block = g.s.g.get(x, y)
            if b == grid.Block.empty || !g.view.shows(x, y, a) { continue }
            if g.depth { extrude(canvas, g.view.box(x, y), face(g, b, x, y), 1.0, bare(g, x - 1, y), bare(g, x, y + 1)) }
        }
    }
    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            b: grid.Block = g.s.g.get(x, y)
            if b == grid.Block.empty || !g.view.shows(x, y, a) { continue }
            canvas.fill(g.view.box(x, y), Color.hex(face(g, b, x, y)))
        }
    }
    /* Icons next, then whatever follows the pointer, each over all before it. */
    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            b: grid.Block = g.s.g.get(x, y)
            if b == grid.Block.empty || b == grid.Block.wire || !g.view.shows(x, y, a) { continue }
            level: sim.Level = sim.Level.low
            if g.phase == app.Phase.run { level = g.s.level(x, y) }
            canvas.icon(r, bar.BLOCK_ICON[b], icon_box(g.view.box(x, y)), Color.hex(icon_ink(b, level)))
        }
    }
    if g.sel.drag == select.Drag.move || g.sel.held {
        draw_lifted(g, canvas, r, false)
        draw_lifted(g, canvas, r, true)
    }
    if hovers(g) {
        at: ui.Rect = g.view.box(g.hx, g.hy)
        /* It floats over the board, half see-through, both its sides always
         * showing. */
        if g.depth { extrude(canvas, at, LOW[g.block], GHOST, true, true) }
        canvas.fill(at, shade(LOW[g.block], GHOST))
        if g.block != grid.Block.wire { canvas.icon(r, bar.BLOCK_ICON[g.block], icon_box(at), shade(icon_ink(g.block, sim.Level.low), GHOST)) }
    }
    /* The box being drawn, or the selection, carried along while it moves. */
    if g.sel.drag == select.Drag.box {
        canvas.dashed(g.view.span(math.min[int](g.sel.ax, g.sel.bx), math.min[int](g.sel.ay, g.sel.by), math.max[int](g.sel.ax, g.sel.bx), math.max[int](g.sel.ay, g.sel.by)), 2.0, Color.hex(theme.DIM), a)
    }
    if g.sel.on && g.sel.drag != select.Drag.box {
        canvas.dashed(g.view.span(g.sel.x0 + g.sel.dx, g.sel.y0 + g.sel.dy, g.sel.x1 + g.sel.dx, g.sel.y1 + g.sel.dy), 2.0, Color.hex(theme.DIM), a)
    }
    canvas.flush(r)
    r.unclip()
}

/* The block carried at (x, y) of the selection, empty off its edge. */
carried(g: *app.App, x: int, y: int): grid.Block {
    if x < g.sel.x0 || y < g.sel.y0 || x > g.sel.x1 || y > g.sel.y1 { return grid.Block.empty }
    return g.sel.lift[(y - g.sel.y0) * (g.sel.x1 - g.sel.x0 + 1) + x - g.sel.x0]
}

/* The blocks being carried, `icons` or their fills, at the drag's offset. */
draw_lifted(g: *app.App, canvas: *ui.Canvas, r: Renderer, icons: bool) {
    /* Fills go down in two passes, as on the board: sides, then top faces. */
    for pass: int in 0 .. 2 {
        for y: int in g.sel.y0 .. g.sel.y1 + 1 {
            for x: int in g.sel.x0 .. g.sel.x1 + 1 {
                b: grid.Block = carried(g, x, y)
                if b == grid.Block.empty { continue }
                cell: ui.Rect = g.view.box(x + g.sel.dx, y + g.sel.dy)
                if icons {
                    if pass == 0 && b != grid.Block.wire { canvas.icon(r, bar.BLOCK_ICON[b], icon_box(cell), Color.hex(icon_ink(b, sim.Level.low))) }
                } else if pass == 0 {
                    if g.depth { extrude(canvas, cell, LOW[b], 1.0, carried(g, x - 1, y) == grid.Block.empty, carried(g, x, y + 1) == grid.Block.empty) }
                } else {
                    canvas.fill(cell, Color.hex(LOW[b]))
                }
            }
        }
    }
}

/* Whether the pencil's block shows under the pointer, as a preview of where
 * a click puts it. */
hovers(g: *app.App): bool {
    return g.mode == app.Mode.none && g.phase == app.Phase.edit && g.pick == bar.Tool.pencil && g.hx >= 0
}

/* Whether `button` is unusable in the current phase: Step and Auto only work
 * in Sim. */
disabled(g: *app.App, button: bar.Button): bool {
    return g.phase == app.Phase.edit && (button == bar.Button.step || button == bar.Button.auto)
}

draw_bars(g: *app.App, canvas: *ui.Canvas, r: Renderer) {
    foot: ui.Rect = g.view.foot()
    canvas.fill(g.view.head(), Color.hex(theme.CHROME))
    canvas.fill(g.view.blocks(), Color.hex(theme.CHROME))
    /* Block buttons: with the pencil each in its block's low color, the
     * selected one lit; in Sim and with the select tool all grey. */
    live: bool = g.phase == app.Phase.edit && g.pick == bar.Tool.pencil
    for i: usize in 1 .. members(grid.Block).len {
        each: grid.Block = members(grid.Block)[i]
        rgb: u32 = theme.DISABLED
        ink: u32 = theme.DIM
        if live {
            rgb = LOW[each]
            if each == g.block { rgb = HIGH[each] }
            level: sim.Level = sim.Level.low
            if each == g.block { level = sim.Level.high }
            ink = icon_ink(each, level)
        }
        canvas.fill(bar.tool(each), Color.hex(rgb))
        at: ui.Rect = bar.tool(each)
        canvas.icon(r, bar.BLOCK_ICON[each], ui.Rect { x = at.x + bar.TOOL_PAD, y = at.y + bar.TOOL_PAD, w = at.w - 2.0 * bar.TOOL_PAD, h = at.h - 2.0 * bar.TOOL_PAD }, Color.hex(ink))
    }
    canvas.fill(foot, Color.hex(theme.CHROME))
    canvas.fill(g.view.side(), Color.hex(theme.CHROME))
    canvas.flush(r)
    /* The group titles, dim, before the buttons they head. */
    for i: usize in 0 .. members(bar.Button).len {
        each: bar.Button = members(bar.Button)[i]
        if bar.heading(each).len == 0 { continue }
        at: ui.Rect = bar.place(each)
        ui.left(r, at, -(f32(bar.heading(each).len) * ui.GLYPH + 6.0), bar.heading(each), theme.DIM)
    }
    ui.left(r, g.view.blocks(), 6.0, bar.COMPONENTS, theme.DIM)
    for i: usize in 0 .. members(bar.Tool).len {
        each: bar.Tool = members(bar.Tool)[i]
        rgb: u32 = theme.DISABLED
        ink: u32 = theme.DIM
        if g.phase == app.Phase.edit {
            rgb = theme.BUTTON
            ink = theme.INK
            if bar.strip_at(each).has(g.mx, g.my) { rgb = theme.ACTIVE }
            if each == g.pick { rgb = theme.ACTIVE }
        }
        canvas.fill(bar.strip_at(each), Color.hex(rgb))
        at: ui.Rect = bar.strip_at(each)
        canvas.icon(r, bar.STRIP_ICON[each], ui.Rect { x = at.x + bar.TOOL_PAD, y = at.y + bar.TOOL_PAD, w = at.w - 2.0 * bar.TOOL_PAD, h = at.h - 2.0 * bar.TOOL_PAD }, Color.hex(ink))
    }
    for i: usize in 0 .. members(bar.Button).len {
        each: bar.Button = members(bar.Button)[i]
        rgb: u32 = theme.BUTTON
        if bar.place(each).has(g.mx, g.my) || (each == bar.Button.open && g.mode == app.Mode.open) {
            rgb = theme.ACTIVE
        }
        if (each == bar.Button.edit && g.phase == app.Phase.edit) || (each == bar.Button.run && g.phase == app.Phase.run) ||
            (each == bar.Button.auto && g.auto) || (each == bar.Button.depth && g.depth) {
            rgb = theme.ACTIVE
        }
        if disabled(g, each) { rgb = theme.DISABLED }
        canvas.fill(bar.place(each), Color.hex(rgb))
        ink: u32 = theme.INK
        if disabled(g, each) { ink = theme.DIM }
        at: ui.Rect = bar.place(each)
        /* A lone icon is centred in its square, the size of a labelled one. */
        inset: f32 = bar.PAD
        if bar.LABEL[each].len == 0 { inset = (at.w - bar.GLYPH_SIDE) / 2.0 }
        canvas.icon(r, bar.ICON[each], ui.Rect { x = at.x + inset, y = at.y + (at.h - bar.GLYPH_SIDE) / 2.0, w = bar.GLYPH_SIDE, h = bar.GLYPH_SIDE }, Color.hex(ink))
    }
    canvas.flush(r)

    for i: usize in 0 .. members(bar.Button).len {
        each: bar.Button = members(bar.Button)[i]
        ink: u32 = theme.INK
        if disabled(g, each) { ink = theme.DIM }
        ui.left(r, bar.place(each), bar.PAD + bar.GLYPH_SIDE + bar.LABEL_GAP, bar.LABEL[each], ink)
    }
    title: string = g.name.text()
    if title.len == 0 { title = "untitled" }
    storage: [128]u8
    status: fmt.Buffer = fmt.Buffer.init(storage[..])
    if g.phase == app.Phase.edit {
        if g.pick == bar.Tool.select {
            status.printf("select")
        } else {
            status.printf("%s", NAME[g.block])
        }
    } else {
        status.printf("tick %d", g.count)
    }
    ui.left(r, foot, 8.0, status.text(), theme.INK)
    /* The hovered block's name, in either phase. */
    if g.hx >= 0 {
        here: grid.Block = g.s.g.get(g.hx, g.hy)
        if here != grid.Block.empty { ui.center(r, foot, NAME[here], theme.INK) }
    }
    bar: ui.Rect = g.view.head()
    ui.left(r, bar, bar.w - 8.0 - ui.GLYPH * f32(title.len), title, theme.INK)
    note: string = g.status()
    ui.left(r, foot, foot.w - 8.0 - ui.GLYPH * f32(note.len), note, theme.DIM)
}

draw_list(g: *app.App, canvas: *ui.Canvas, r: Renderer) {
    rows: usize = g.store.list.count
    if rows == 0 { rows = 1 }
    for i: usize in 0 .. rows {
        rgb: u32 = theme.BUTTON
        if i < g.store.list.count && bar.row(i).has(g.mx, g.my) { rgb = theme.ACTIVE }
        canvas.fill(bar.row(i), Color.hex(rgb))
    }
    canvas.flush(r)

    if g.store.list.count == 0 { ui.left(r, bar.row(0), 8.0, "no diagrams in diagram/", theme.DIM) }
    for i: usize in 0 .. g.store.list.count {
        ui.left(r, bar.row(i), 8.0, g.store.list.names[i], theme.INK)
    }
}

draw_ask(g: *app.App, canvas: *ui.Canvas, r: Renderer) {
    panel: ui.Rect = g.view.panel()
    field: ui.Rect = ui.Rect { x = panel.x + 12.0, y = panel.y + 32.0, w = panel.w - 24.0, h = 28.0 }
    canvas.fill(panel, Color.hex(theme.BUTTON))
    canvas.outline(panel, 1.0, Color.hex(theme.DIM))
    canvas.fill(field, Color.hex(theme.CHROME))
    /* The cursor: a bar before byte `at`. */
    caret: f32 = field.x + 8.0 + f32(g.draft.at) * ui.GLYPH
    canvas.fill(ui.Rect { x = caret - 1.0, y = field.y + 6.0, w = 2.0, h = field.h - 12.0 }, Color.hex(theme.INK))
    canvas.flush(r)

    title: ui.Rect = ui.Rect { x = panel.x, y = panel.y + 4.0, w = panel.w, h = 24.0 }
    ui.left(r, title, 12.0, "Save as     Enter saves, Esc cancels", theme.INK)
    storage: [64]u8
    b: fmt.Buffer = fmt.Buffer.init(storage[..])
    b.printf("%s", g.draft.text())
    ui.left(r, field, 8.0, b.text(), theme.INK)
    /* The extension, dimmed: it is added, not typed. */
    ui.left(r, field, 8.0 + ui.GLYPH * f32(g.draft.len), diagram.EXTENSION, theme.DIM)
}

pub draw(g: *app.App, canvas: *ui.Canvas, r: Renderer) {
    r.color(Color.hex(theme.WINDOW))
    r.clear()
    draw_board(g, canvas, r)
    draw_bars(g, canvas, r)
    if g.mode == app.Mode.open { draw_list(g, canvas, r) }
    if g.mode == app.Mode.save_as { draw_ask(g, canvas, r) }
    r.present()
}
