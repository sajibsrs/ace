/* speed — how fast Auto ticks: a slider stop and the rate it stands for.
 *
 * The slider has STOPS equal zones. The first nine step 1 .. 9 Hz and every
 * decade after steps nine times by its power of ten (10 .. 90, 100 .. 900,
 * 1000 .. 9000, and so on to 900000); the last is the top of the last decade, 1 MHz.
 */

import fmt
import math

/* Decades above 1 Hz the stops reach. */
DECADES: const int = 6
/* Stops per decade, and in all: 1 Hz to 1 MHz. */
PER: const int = 9
pub STOPS: const int = PER * DECADES + 1

/* Ticks per second at `stop`: 1 .. 9, then 10 .. 90, and so on. */
pub hz(stop: int): f64 {
    rate: f64 = f64(stop % PER + 1)
    for d: int in 0 .. stop / PER { rate *= 10.0 }
    return rate
}

/* The stop under fraction `t` (0 .. 1) of the slider's width. */
pub stop_at(t: f32): int {
    return math.max[int](0, math.min[int](STOPS - 1, int(t * f32(STOPS))))
}

/* How much of the slider's width is filled when `stop` is picked, 0 .. 1. */
pub fill(stop: int): f32 {
    return f32(stop + 1) / f32(STOPS)
}

/* Writes `rate` ticks per second to `b` with a unit (Hz, kHz or MHz) and at
 * most three significant digits. */
pub show(b: *fmt.Buffer, rate: f64) {
    /* Units switch where three digits round up to the next one: 999.5 kHz is 1 MHz. */
    if rate >= 999500.0 {
        b.printf("%.3g MHz", rate / 1000000.0)
    } else if rate >= 999.5 {
        b.printf("%.3g kHz", rate / 1000.0)
    } else {
        b.printf("%.3g Hz", rate)
    }
}
