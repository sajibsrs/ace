/* footer — the status line: the tool or tick count, and the last note. */

import fmt
import bar: "./bar.ace"
import theme: "./theme.ace"
import speed: "./speed.ace"
import ui
import app: "./app.ace"

pub Footer: struct {
    pub g: *app.App = null,
}

pub Footer.draw(self) {
    g: *app.App = self.g
    row: ui.Area = ui.area(g.view.foot().inset(ui.Insets { left = bar.EDGE, right = bar.EDGE }), ui.Flow.across)
    defer row.end()
    status: *fmt.Buffer = ui.line()
    if g.phase == app.Phase.edit {
        if g.pick == bar.Tool.select {
            status.printf("select")
        } else if g.pick == bar.Tool.dropper {
            status.printf("dropper")
        } else {
            status.printf("%s", theme.NAME[g.block])
        }
    } else {
        status.printf("tick %d", g.count)
        /* The rate reached, which falls short of the setting when the frames cannot keep up. */
        if g.auto && g.rate > 0.0 {
            status.printf(" | ")
            speed.show(status, g.rate)
        }
    }
    ui.text(status.text())
    ui.fill()
    ui.muted(g.status())
}
