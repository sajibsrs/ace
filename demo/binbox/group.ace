/* group — connected groups of cells.
 *
 * Touching cells (north, east, south, west) of one kind form one group, so a
 * signal travels over a whole net and a gate, LED, source, or clock acts as
 * one block however many cells it covers. Wire, read pins, and write pins are
 * one kind, the conductors, so a net runs through all three. Gates merge by
 * type and clocks by span. A wire continues straight through a run of bridges
 * to the wire beyond, so a bridge carries two nets that never meet. A bridge
 * and an empty cell have no group.
 */

import grid: "./grid.ace"

NONE: const int = -1

DX: [4]int = [0, 1, 0, -1]
DY: [4]int = [-1, 0, 1, 0]

/* Whether cells of `block` belong to a group. */
pub joins(block: grid.Block): bool {
    return block != grid.Block.empty && block != grid.Block.bridge
}

/* Whether `block` is wire, a read pin, or a write pin. */
pub conducts(block: grid.Block): bool {
    return block == grid.Block.wire || block == grid.Block.read || block == grid.Block.write
}

/* Whether the touching cells (ax, ay) and (bx, by) are one group. */
same(g: grid.Grid, ax: int, ay: int, bx: int, by: int): bool {
    a: grid.Block = g.get(ax, ay)
    b: grid.Block = g.get(bx, by)
    if conducts(a) && conducts(b) { return true }
    if a != b { return false }
    if a == grid.Block.clock { return g.span(ax, ay) == g.span(bx, by) }
    return true
}

pub Groups: struct {
    /* The group number of each cell, or NONE for a cell in no group. */
    ids: [grid.HEIGHT][grid.WIDTH]int = [[NONE : grid.WIDTH] : grid.HEIGHT],
    /* The first cell of each group, packed as y * WIDTH + x. */
    heads: [grid.CELLS]int = [0 : grid.CELLS],
    /* How many groups there are; numbers run 0 .. count-1. */
    pub count: int = 0,
}

/* Numbers the groups of `g` in row-major order of each group's first cell. */
pub Groups.init(g: grid.Grid): Groups {
    groups: Groups = Groups {}
    /* Cells still to visit, each packed as y * WIDTH + x. */
    stack: [grid.CELLS]int = [0 : grid.CELLS]

    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            block: grid.Block = g.get(x, y)
            if !joins(block) || groups.ids[y][x] != NONE { continue }

            id: int = groups.count
            groups.count += 1
            groups.heads[id] = y * grid.WIDTH + x
            groups.ids[y][x] = id
            stack[0] = y * grid.WIDTH + x
            top: int = 1
            for top > 0 {
                top -= 1
                at: int = stack[top]
                ax: int = at % grid.WIDTH
                ay: int = at / grid.WIDTH
                a: grid.Block = g.get(ax, ay)
                for d: int in 0 .. 4 {
                    nx: int = ax + DX[d]
                    ny: int = ay + DY[d]
                    bridged: bool = false
                    for conducts(a) && g.get(nx, ny) == grid.Block.bridge {
                        nx += DX[d]
                        ny += DY[d]
                        bridged = true
                    }
                    if !grid.inside(nx, ny) || !same(g, ax, ay, nx, ny) { continue }
                    /* A run of bridges joins conductors only: a gate, LED, or
                     * source never crosses it. */
                    if bridged && !conducts(g.get(nx, ny)) { continue }
                    if groups.ids[ny][nx] != NONE { continue }
                    groups.ids[ny][nx] = id
                    stack[top] = ny * grid.WIDTH + nx
                    top += 1
                }
            }
        }
    }
    return groups
}

/* The group at (x, y), or -1 when the cell is off the board or in no group. */
pub Groups.of(const self, x: int, y: int): int {
    if !grid.inside(x, y) { return NONE }
    return self.ids[y][x]
}

/* The first cell of group `id`. */
pub Groups.head(const self, id: int): (int, int) {
    at: int = self.heads[id]
    return at % grid.WIDTH, at / grid.WIDTH
}
