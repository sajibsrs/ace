/* grid — the board of square blocks.
 *
 * The grid is a fixed WIDTH x HEIGHT array of cells, each empty or holding one
 * block. Blocks have no direction: what a block touches decides its role.
 */

pub WIDTH: const int = 64
pub HEIGHT: const int = 32

pub Block: enum u8 {
    empty,
    /* A 0/1 switch; drives the wires, input pins and LEDs it touches. */
    source,
    wire,
    /* A gate's input pin: reads the wires, sources and output pins it touches. */
    input,
    /* A gate's output pin: drives its gates' output onto the wires, input
     * pins and LEDs it touches. */
    output,
    and,
    or,
    not,
    nand,
    nor,
    /* High on an odd number of high inputs; XNOR on an even number. */
    xor,
    xnor,
    /* Shows the level of the wires, sources and output pins it touches. */
    led,
    /* Joins the wires on opposite sides: north with south, east with west,
     * the two pairs kept apart. A run of bridges passes straight through. */
    bridge,
    /* A source that flips itself: low for 1 << span ticks, then high for as many,
     * from the first tick of the simulation. Touching works as for a source. */
    clock,
}

/* How many spans a clock has, 0 .. SPANS - 1: 1, 2, 4 .. 128 ticks a half
 * cycle. A new clock gets span 0. */
pub SPANS: const int = 8

pub Grid: struct {
    cells: [32][64]Block = [[Block.empty : 64] : 32],
    /* Each clock's span; zero for every other cell. */
    spans: [32][64]u8 = [[0 : 64] : 32],
}

/* Whether (x, y) lies on the board. */
pub inside(x: int, y: int): bool {
    return x >= 0 && x < WIDTH && y >= 0 && y < HEIGHT
}

/* Whether the block is a gate. */
pub is_gate(block: Block): bool {
    return block == Block.and || block == Block.or || block == Block.not ||
        block == Block.nand || block == Block.nor || block == Block.xor || block == Block.xnor
}

/* The block at (x, y); off the board it is empty. */
pub Grid.get(const self, x: int, y: int): Block {
    if !inside(x, y) { return Block.empty }
    return self.cells[y][x]
}

/* Puts `block` at (x, y), replacing what is there. False off the board. */
pub Grid.place(self, x: int, y: int, block: Block): bool {
    if !inside(x, y) { return false }
    self.cells[y][x] = block
    self.spans[y][x] = 0
    return true
}

/* The span of the clock at (x, y); zero for any other cell. */
pub Grid.span(const self, x: int, y: int): int {
    if !inside(x, y) { return 0 }
    return int(self.spans[y][x])
}

/* Sets the span of the clock at (x, y), taken modulo SPANS. Other cells keep
 * zero. */
pub Grid.span(self, x: int, y: int, span: int) {
    if self.get(x, y) != Block.clock { return }
    self.spans[y][x] = u8(span % SPANS)
}

/* Empties (x, y). False off the board. */
pub Grid.remove(self, x: int, y: int): bool {
    return self.place(x, y, Block.empty)
}
