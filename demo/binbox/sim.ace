/* sim — signal levels and the tick.
 *
 * The stored state is each source's switch, each gate's output, and the tick
 * count that sets every clock. Everything else is derived from it. Gates,
 * sources, clocks, and LEDs connect only through pins. Wire, read pins, and
 * write pins form nets (see group). A write pin drives its net with the output
 * of the gates, sources, and clocks it touches; a read pin feeds the gates and
 * LEDs it touches with its net. A net's level joins the write pins in it: none
 * is low, agreeing drivers give their level, and disagreeing ones are an
 * error. A run of read and write pins touching no gate, LED, source, or clock
 * is wire in disguise and makes its net an error. A tick computes every gate's
 * next output from the current state, so each gate adds one tick of delay and
 * wire adds none.
 */

import grid: "./grid.ace"
import group: "./group.ace"

pub Level: enum u8 { low, high, error }

DX: [4]int = [0, 1, 0, -1]
DY: [4]int = [-1, 0, 1, 0]

/* Cells on the board. */
CELLS: const int = 32 * 64
/* Index into `val` of the cell (x, y): a source's switch or a write pin's drive. */
cell(x: int, y: int): int { return CELLS + y * grid.WIDTH + x }
/* The slot of `val` that is never written, so always low. */
LOW: const int = 2 * CELLS
/* Gate number that soaks up the unused slots of a pin's gate list. */
SINK: const int = CELLS

/* The share of a pin's reading in a tally: one pin, plus one high or one error. */
WEIGHT: [Level]u64 = [Level.low = 1, Level.high = 1 + (1 << 16), Level.error = 1 + (1 << 32)]
/* One bit per level, so joining drivers is an or. */
BIT: [Level]u8 = [Level.low = 1, Level.high = 2, Level.error = 4]
/* The level of a net from the bits of its drivers: none or low is low, high
 * alone is high, any mix is an error. */
JOINED: [8]Level = [
    Level.low, Level.low, Level.high, Level.error,
    Level.error, Level.error, Level.error, Level.error,
]

/* Sim keeps the board compiled into flat lists, built by `compile` whenever
 * the grid changes, so a tick loops over pins and gates instead of cells. Every
 * list slot holds 4 entries, padded by repeating the first (joining is
 * idempotent) or, for gate lists, with SINK. */
pub Sim: struct {
    pub g: grid.Grid = grid.Grid {},
    groups: group.Groups = group.Groups {},
    /* Output of each gate cell; kept only so gates survive regrouping in
     * `place`, which flushes `gout` here before and `compile` reloads it. */
    outs: [32][64]Level = [[Level.low : 64] : 32],
    /* What terms read: the level of each net by group number, then each source
     * switch and write pin drive by `cell`, then LOW. */
    val: [2 * CELLS + 1]Level = [Level.low : 2 * CELLS + 1],
    /* Gate number of each group, -1 for a net. Sources and clocks are gates
     * too, after the `nlogic` that a tick evaluates; their output is their
     * level in `val`. */
    gate_of: [CELLS]i16 = [-1 : CELLS],
    ngates: int = 0,
    nlogic: int = 0,
    kinds: [CELLS]grid.Block = [grid.Block.empty : CELLS],
    gout: [CELLS]Level = [Level.low : CELLS],
    /* What each gate's pins read during a tick, see WEIGHT. */
    tally: [CELLS + 1]u64 = [0 : CELLS + 1],
    /* Read pins that feed a gate: the net each reads, the gates fed. */
    npins: int = 0,
    pin_t: [CELLS]i16 = [0 : CELLS],
    pin_g: [CELLS][4]i16 = [[0 : 4] : CELLS],
    /* Write pins that touch a gate, source, or clock: the gates driving each
     * and the net it drives. */
    nops: int = 0,
    op_n: [CELLS]i16 = [0 : CELLS],
    op_g: [CELLS][4]i16 = [[0 : 4] : CELLS],
    /* Read pins that touch an LED: the net each reads, the LEDs it feeds. */
    nleds: int = 0,
    led_t: [CELLS]i16 = [0 : CELLS],
    led_n: [CELLS][4]i16 = [[0 : 4] : CELLS],
    /* What each LED group shows, and the bits of the nets feeding it. */
    shown: [CELLS]Level = [Level.low : CELLS],
    lacc: [CELLS]u8 = [0 : CELLS],
    /* Nets holding a run of pins that touches no device: BIT of an error. */
    bad: [CELLS]u8 = [0 : CELLS],
    /* Ticks run since `init`; a clock is high while bit `span` of it is set. */
    time: u64 = 0,
    /* Sources and clocks: the `val` index of each group's first cell, and its gate. */
    nsources: int = 0,
    src_t: [CELLS]i16 = [0 : CELLS],
    src_g: [CELLS]i16 = [0 : CELLS],
    /* Clocks: the `val` index each sets, and its span. */
    nclocks: int = 0,
    clk_t: [CELLS]i16 = [0 : CELLS],
    clk_s: [CELLS]u8 = [0 : CELLS],
    /* Bits of the drivers joined into each net during `settle`. */
    acc: [CELLS]u8 = [0 : CELLS],
    /* A toggle's memory (bit 0: its Q, bit 1: its input as of the last tick),
     * kept per cell like `outs` and per gate in `gmem`. */
    mems: [32][64]u8 = [[0 : 64] : 32],
    gmem: [CELLS]u8 = [0 : CELLS],
    /* The gate numbers of the toggles. */
    ntogs: int = 0,
    tog_g: [CELLS]i16 = [0 : CELLS],
}

/* The distinct gates beside one cell, sources and clocks included for a
 * write pin. */
Near: struct {
    ids: [4]int = [0 : 4],
    count: int = 0,
}

/* A simulation of `g` with every switch and gate output off. */
pub Sim.init(g: grid.Grid): Sim {
    s: Sim = Sim { g = g }
    s.groups = group.Groups.init(g)
    s.compile()
    s.settle()
    return s
}

level(on: bool): Level {
    if on { return Level.high }
    return Level.low
}

/* A gate's next output from what its read pins read: the packed tally of
 * WEIGHT. A gate with no read pin is idle; one with too few (AND, NAND, XOR,
 * XNOR: 2) or too many (NOT: 1) is an error. */
evaluate(block: grid.Block, t: u64): Level {
    pins: u64 = t & 0xFFFF
    highs: u64 = (t >> 16) & 0xFFFF
    errors: u64 = t >> 32
    if pins == 0 { return Level.low }
    pair: bool = block == grid.Block.and || block == grid.Block.nand ||
        block == grid.Block.xor || block == grid.Block.xnor
    if (pair && pins < 2) || (block == grid.Block.not && pins != 1) {
        return Level.error
    }
    if errors > 0 { return Level.error }
    if block == grid.Block.and { return level(highs == pins) }
    if block == grid.Block.nand { return level(highs != pins) }
    if block == grid.Block.or { return level(highs > 0) }
    if block == grid.Block.xor { return level((highs & 1) == 1) }
    if block == grid.Block.xnor { return level((highs & 1) == 0) }
    /* NOT and NOR. */
    return level(highs == 0)
}

/* The distinct gates beside (x, y), and the sources and clocks too when
 * `sources`. */
Sim.near(const self, x: int, y: int, sources: bool): Near {
    near: Near = Near {}
    for d: int in 0 .. 4 {
        nx: int = x + DX[d]
        ny: int = y + DY[d]
        b: grid.Block = self.g.get(nx, ny)
        if !grid.is_gate(b) && !(sources && grid.is_source(b)) { continue }
        id: int = self.groups.of(nx, ny)
        seen: bool = false
        for k: int in 0 .. near.count { seen = seen || near.ids[k] == id }
        if seen { continue }
        near.ids[near.count] = id
        near.count += 1
    }
    return near
}

/* Builds the lists from the grid and groups, and loads each gate's output
 * from `outs`. */
Sim.compile(self) {
    self.ngates = 0
    self.ntogs = 0
    self.nsources = 0
    for id: int in 0 .. self.groups.count {
        hx: int, hy: int = self.groups.head(id)
        b: grid.Block = self.g.get(hx, hy)
        if !grid.is_gate(b) {
            self.gate_of[id] = -1
            continue
        }
        self.gate_of[id] = i16(self.ngates)
        self.kinds[self.ngates] = b
        self.gout[self.ngates] = self.outs[hy][hx]
        self.gmem[self.ngates] = self.mems[hy][hx]
        if b == grid.Block.toggle {
            self.tog_g[self.ntogs] = i16(self.ngates)
            self.ntogs += 1
        }
        self.ngates += 1
    }
    self.nlogic = self.ngates
    for id: int in 0 .. self.groups.count {
        hx: int, hy: int = self.groups.head(id)
        b: grid.Block = self.g.get(hx, hy)
        if !grid.is_source(b) { continue }
        self.gate_of[id] = i16(self.ngates)
        self.kinds[self.ngates] = b
        self.src_t[self.nsources] = i16(cell(hx, hy))
        self.src_g[self.nsources] = i16(self.ngates)
        self.nsources += 1
        self.ngates += 1
    }
    self.npins = 0
    self.nops = 0
    self.nleds = 0
    self.nclocks = 0
    for id: int in 0 .. self.groups.count {
        hx: int, hy: int = self.groups.head(id)
        if self.g.get(hx, hy) == grid.Block.clock { self.compile_clock(hx, hy) }
    }
    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            b: grid.Block = self.g.get(x, y)
            if b == grid.Block.read {
                self.compile_pin(x, y)
            } else if b == grid.Block.write {
                self.compile_output(x, y)
            }
        }
    }
    self.compile_unused()
}

/* Marks each net holding a run of read and write pins that touches no gate,
 * LED, source, or clock: such a run is only wire, which has a block of its own. */
Sim.compile_unused(self) {
    for n: int in 0 .. self.groups.count { self.bad[n] = 0 }
    seen: [32][64]bool = [[false : 64] : 32]
    stack: [32 * 64]int = [0 : 32 * 64]
    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            if !is_pin(self.g.get(x, y)) || seen[y][x] { continue }
            seen[y][x] = true
            stack[0] = y * grid.WIDTH + x
            top: int = 1
            used: bool = false
            for top > 0 {
                top -= 1
                at: int = stack[top]
                for d: int in 0 .. 4 {
                    nx: int = at % grid.WIDTH + DX[d]
                    ny: int = at / grid.WIDTH + DY[d]
                    b: grid.Block = self.g.get(nx, ny)
                    if grid.is_gate(b) || grid.is_source(b) || b == grid.Block.led { used = true }
                    if !is_pin(b) || seen[ny][nx] { continue }
                    seen[ny][nx] = true
                    stack[top] = ny * grid.WIDTH + nx
                    top += 1
                }
            }
            if !used { self.bad[self.groups.of(x, y)] = BIT[Level.error] }
        }
    }
}

/* Whether `b` is a read or write pin. */
is_pin(b: grid.Block): bool { return b == grid.Block.read || b == grid.Block.write }

/* Lists the clock at (x, y) and sets its level for the current time. */
Sim.compile_clock(self, x: int, y: int) {
    k: int = self.nclocks
    self.nclocks += 1
    self.clk_t[k] = i16(cell(x, y))
    self.clk_s[k] = u8(self.g.span(x, y))
    self.val[cell(x, y)] = self.clocked(k)
}

/* The level clock number `k` has at the current time. */
Sim.clocked(const self, k: int): Level {
    return level(((self.time >> u64(self.clk_s[k])) & 1) == 1)
}

/* Lists the read pin at (x, y) if it feeds a gate or an LED. */
Sim.compile_pin(self, x: int, y: int) {
    net: int = self.groups.of(x, y)
    near: Near = self.near(x, y, false)
    if near.count > 0 {
        p: int = self.npins
        self.npins += 1
        self.pin_t[p] = i16(net)
        for k: int in 0 .. 4 {
            if k < near.count {
                self.pin_g[p][k] = self.gate_of[near.ids[k]]
            } else {
                self.pin_g[p][k] = i16(SINK)
            }
        }
    }
    ids: [4]int = [0 : 4]
    count: int = 0
    for d: int in 0 .. 4 {
        nx: int = x + DX[d]
        ny: int = y + DY[d]
        if self.g.get(nx, ny) != grid.Block.led { continue }
        id: int = self.groups.of(nx, ny)
        seen: bool = false
        for k: int in 0 .. count { seen = seen || ids[k] == id }
        if seen { continue }
        ids[count] = id
        count += 1
    }
    if count == 0 { return }
    l: int = self.nleds
    self.nleds += 1
    self.led_t[l] = i16(net)
    for k: int in 0 .. 4 { self.led_n[l][k] = i16(ids[k % count]) }
}

/* Lists the write pin at (x, y) if it touches a gate, source, or clock. */
Sim.compile_output(self, x: int, y: int) {
    near: Near = self.near(x, y, true)
    if near.count == 0 { return }
    o: int = self.nops
    self.nops += 1
    self.op_n[o] = i16(self.groups.of(x, y))
    for k: int in 0 .. 4 {
        self.op_g[o][k] = self.gate_of[near.ids[k % near.count]]
    }
}

/* Recomputes every net and LED from the switches and gate outputs. */
Sim.settle(self) {
    for k: int in 0 .. self.nsources { self.gout[self.src_g[k]] = self.val[self.src_t[k]] }
    for n: int in 0 .. self.groups.count {
        self.acc[n] = self.bad[n]
        self.lacc[n] = 0
    }
    for o: int in 0 .. self.nops {
        v: Level = self.gout[self.op_g[o][0]]
        if v != self.gout[self.op_g[o][1]] || v != self.gout[self.op_g[o][2]] ||
            v != self.gout[self.op_g[o][3]] {
            v = Level.error
        }
        self.acc[self.op_n[o]] |= BIT[v]
    }
    for n: int in 0 .. self.groups.count { self.val[n] = JOINED[int(self.acc[n])] }
    for l: int in 0 .. self.nleds {
        bit: u8 = BIT[self.val[self.led_t[l]]]
        for k: int in 0 .. 4 { self.lacc[self.led_n[l][k]] |= bit }
    }
    for n: int in 0 .. self.groups.count { self.shown[n] = JOINED[int(self.lacc[n])] }
}

/* Advances one tick: every gate reads the current state and outputs next. */
pub Sim.tick(self) {
    for i: int in 0 .. self.ngates { self.tally[i] = 0 }
    self.tally[SINK] = 0
    for p: int in 0 .. self.npins {
        w: u64 = WEIGHT[self.val[self.pin_t[p]]]
        for k: int in 0 .. 4 { self.tally[self.pin_g[p][k]] += w }
    }
    for i: int in 0 .. self.nlogic { self.gout[i] = evaluate(self.kinds[i], self.tally[i]) }
    for k: int in 0 .. self.ntogs { self.flip(int(self.tog_g[k])) }
    self.time += 1
    for k: int in 0 .. self.nclocks { self.val[self.clk_t[k]] = self.clocked(k) }
    self.settle()
}

/* Steps toggle gate `i`: its input is high when no pin reads an error and any
 * reads high; Q flips when the input is high now and was low at the last tick.
 * The output is Q, or an error while an read pin reads one (Q is kept). */
Sim.flip(self, i: int) {
    t: u64 = self.tally[i]
    high: bool = (t >> 32) == 0 && ((t >> 16) & 0xFFFF) > 0
    m: u8 = self.gmem[i] & 1
    if high {
        if (self.gmem[i] & 2) == 0 { m ^= 1 }
        m |= 2
    }
    self.gmem[i] = m
    if (t >> 32) > 0 {
        self.gout[i] = Level.error
    } else {
        self.gout[i] = level((m & 1) == 1)
    }
}

/* Sets the span of the clock at (x, y). False when the cell is not a clock. */
pub Sim.span(self, x: int, y: int, span: int): bool {
    if self.g.get(x, y) != grid.Block.clock { return false }
    self.flush()
    self.g.span(x, y, span)
    self.regroup()
    return true
}

/* Sets the source at (x, y), and so every source touching it. False when the
 * cell is not a source. */
pub Sim.toggle(self, x: int, y: int, on: bool): bool {
    if self.g.get(x, y) != grid.Block.source { return false }
    hx: int, hy: int = self.groups.head(self.groups.of(x, y))
    self.val[cell(hx, hy)] = level(on)
    self.settle()
    return true
}

/* The level shown at (x, y): a source's switch or a clock's level, a net's
 * level at a wire or pin, a gate's output, or what an LED shows. A bridge
 * carries two levels (see Sim.cross) and shows the higher: error over high
 * over low. */
pub Sim.level(const self, x: int, y: int): Level {
    b: grid.Block = self.g.get(x, y)
    if !group.joins(b) {
        if b == grid.Block.bridge {
            v: Level, h: Level = self.cross(x, y)
            if v == Level.error || h == Level.error { return Level.error }
            if v == Level.high || h == Level.high { return Level.high }
        }
        return Level.low
    }
    id: int = self.groups.of(x, y)
    if grid.is_source(b) {
        hx: int, hy: int = self.groups.head(id)
        return self.val[cell(hx, hy)]
    }
    if grid.is_gate(b) { return self.gout[self.gate_of[id]] }
    if b == grid.Block.led { return self.shown[id] }
    return self.val[id]
}

/* Copies every gate's output to its cells in `outs`, where it survives a
 * regrouping. */
Sim.flush(self) {
    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            id: int = self.groups.of(x, y)
            if id >= 0 && self.gate_of[id] >= 0 {
                self.outs[y][x] = self.gout[self.gate_of[id]]
                self.mems[y][x] = self.gmem[self.gate_of[id]]
            }
        }
    }
}

/* Puts `block` at (x, y) with its switch and output off, then regroups; a gate
 * or source it merges into keeps its output or switch. False off the board. */
pub Sim.place(self, x: int, y: int, block: grid.Block): bool {
    if !grid.inside(x, y) { return false }
    self.flush()
    self.g.place(x, y, block)
    self.val[cell(x, y)] = Level.low
    self.outs[y][x] = Level.low
    self.mems[y][x] = 0
    self.regroup()
    return true
}

/* Regroups the board after a change, keeping what `flush` saved: each gate cell
 * takes the output of its group's first cell, and a source group is on when any
 * of its cells was. */
Sim.regroup(self) {
    self.groups = group.Groups.init(self.g)
    for gy: int in 0 .. grid.HEIGHT {
        for gx: int in 0 .. grid.WIDTH {
            b: grid.Block = self.g.get(gx, gy)
            if grid.is_gate(b) {
                hx: int, hy: int = self.groups.head(self.groups.of(gx, gy))
                self.outs[gy][gx] = self.outs[hy][hx]
                self.mems[gy][gx] = self.mems[hy][hx]
            } else if b == grid.Block.source {
                self.val[cell(gx, gy)] = Level.low
            }
        }
    }
    for gy: int in 0 .. grid.HEIGHT {
        for gx: int in 0 .. grid.WIDTH {
            if self.g.get(gx, gy) != grid.Block.source || self.outs[gy][gx] != Level.high { continue }
            hx: int, hy: int = self.groups.head(self.groups.of(gx, gy))
            self.val[cell(hx, hy)] = Level.high
        }
    }
    self.compile()
    self.settle()
}

/* The level a bridge at (x, y) carries in direction `d` and its opposite: the
 * net of the wire past the run of bridges either way, low when neither end is
 * a wire. */
Sim.carries(const self, x: int, y: int, d: int): Level {
    for k: int in 0 .. 2 {
        nx: int = x + DX[d]
        ny: int = y + DY[d]
        for self.g.get(nx, ny) == grid.Block.bridge {
            nx += DX[d]
            ny += DY[d]
        }
        if self.g.get(nx, ny) == grid.Block.wire { return self.val[self.groups.of(nx, ny)] }
        d = (d + 2) % 4
    }
    return Level.low
}

/* The levels a bridge at (x, y) carries north-south and east-west. Both are
 * low when the cell is not a bridge. */
pub Sim.cross(const self, x: int, y: int): (Level, Level) {
    if self.g.get(x, y) != grid.Block.bridge { return Level.low, Level.low }
    return self.carries(x, y, 0), self.carries(x, y, 1)
}
