import time
import test
import ui: "./ui.ace"
import bar: "./bar.ace"
import grid: "./grid.ace"
import sim: "./sim.ace"
import speed: "./speed.ace"
import app: "./app.ace"

/* Pace's work is timed, so these check ranges wide enough for a busy machine. */

/* An editor running Sim at slider stop `stop`, with Auto just turned on:
 * the frame before it, the clock was noted. */
running(stop: int): app.App {
    a: app.App = app.App { s = sim.Sim.new(grid.Grid {}) }
    a.switch(app.Phase.run)
    a.stop = stop
    a.pace()
    a.auto = true
    return a
}

/* Calls `pace` flat out for `ns` nanoseconds. */
spin(a: *app.App, ns: u64) {
    begin: u64 = time.elapsed()
    for time.elapsed() - begin < ns { a.pace() }
}

pub slice_leaves_room_for_drawing(t: *test.T) {
    a: app.App = app.App {}
    t.equal(a.slice() == 14600000, true)
    a.drawn = 5000000
    t.equal(a.slice() == 9600000, true)
    a.drawn = 40000000
    t.equal(a.slice() == 2000000, true)
    /* A 120 Hz display leaves half the room. */
    a.drawn = 1000000
    a.refresh(120.0)
    t.equal(a.slice() > 5000000 && a.slice() < 5400000, true)
    a.refresh(0.0)
    t.equal(a.frame == app.FRAME, true)
}

pub fixed_rate_is_kept(t: *test.T) {
    /* Stop 18 is 100 Hz. */
    a: app.App = running(18)
    spin(&a, 700000000)
    t.equal(a.count >= 50 && a.count <= 90, true)
    t.equal(a.rate >= 90.0 && a.rate <= 110.0, true)
}

pub high_rate_is_kept(t: *test.T) {
    /* Stop 45 is 100 kHz. */
    a: app.App = running(45)
    spin(&a, 700000000)
    /* 100 kHz for 0.7 s; the empty board ticks faster than that. */
    t.equal(a.count > 30000 && a.count <= 75000, true)
    t.equal(a.rate > 30000.0 && a.rate <= 110000.0, true)
}

pub pausing_stops_ticks_and_clears_the_rate(t: *test.T) {
    a: app.App = running(speed.STOPS - 1)
    spin(&a, 600000000)
    a.auto = false
    count: int = a.count
    spin(&a, 50000000)
    t.equal(a.count, count)
    t.equal(a.rate == 0.0, true)
}

pub reset_restores_the_state_simulate_was_entered_with(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    g.place(0, 0, grid.Block.source)
    g.place(1, 0, grid.Block.wire)
    g.place(2, 0, grid.Block.not)
    g.place(3, 0, grid.Block.write)
    a: app.App = app.App { s = sim.Sim.new(g) }
    a.s.toggle(0, 0, true)
    a.switch(app.Phase.run)
    for i: int in 0 .. 5 { a.tick() }
    a.s.toggle(0, 0, false)
    for i: int in 0 .. 5 { a.tick() }
    a.auto = true
    a.reset()
    t.equal(a.count, 0)
    t.equal(a.auto, true)
    t.equal(a.s.level(0, 0) == sim.Level.high, true)
    t.equal(a.s.level(2, 0) == sim.Level.high, false)
    t.equal(a.s.g.get(2, 0) == grid.Block.not, true)
    /* The same ticks give the same result as the first time. */
    for i: int in 0 .. 5 { a.tick() }
    t.equal(a.s.level(2, 0) == sim.Level.high, false)
}

pub clock_slider_picks_a_span(t: *test.T) {
    a: app.App = app.App {}
    at: ui.Rect = bar.clock_at(a.view.side())
    t.equal(a.clock, 0)
    a.slide_clock(at.x + at.w - 1.0)
    t.equal(a.clock, grid.SPANS - 1)
    a.slide_clock(at.x - 50.0)
    t.equal(a.clock, 0)
    a.slide_clock(at.x + at.w / 2.0 + 1.0)
    t.equal(a.clock, grid.SPANS / 2)
}

/* The dropper takes the block under the pointer, and a clock's span, and
 * switches to the pencil; an empty cell, or Sim, changes nothing. */
pub dropper_picks_the_block_under_the_pointer(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    g.place(3, 2, grid.Block.xor)
    g.place(4, 2, grid.Block.clock)
    g.span(4, 2, 5)
    a: app.App = app.App { s = sim.Sim.new(g) }
    a.pick = bar.Tool.select
    a.drop(3, 2)
    t.equal(a.block == grid.Block.xor, true)
    t.equal(a.pick == bar.Tool.pencil, true)
    a.pick = bar.Tool.dropper
    a.drop(4, 2)
    t.equal(a.block == grid.Block.clock, true)
    t.equal(a.clock, 5)
    t.equal(a.pick == bar.Tool.pencil, true)
    a.pick = bar.Tool.dropper
    a.drop(0, 0)
    t.equal(a.block == grid.Block.clock, true)
    t.equal(a.pick == bar.Tool.dropper, true)
    a.switch(app.Phase.run)
    a.drop(3, 2)
    t.equal(a.block == grid.Block.clock, true)
}
