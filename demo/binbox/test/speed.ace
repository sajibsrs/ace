import fmt
import test
import speed: "../speed.ace"

/* Checks that `rate` shows as `want`. */
shows(t: *test.T, rate: f64, want: string) {
    storage: [32]u8
    b: fmt.Buffer = fmt.Buffer.init(storage[..])
    speed.show(&b, rate)
    t.equal(b.text(), want, @file, @line)
}

pub steps_by_decade(t: *test.T) {
    shows(t, speed.hz(0), "1 Hz")
    shows(t, speed.hz(8), "9 Hz")
    shows(t, speed.hz(9), "10 Hz")
    shows(t, speed.hz(10), "20 Hz")
    shows(t, speed.hz(18), "100 Hz")
    shows(t, speed.hz(27), "1 kHz")
    shows(t, speed.hz(35), "9 kHz")
    shows(t, speed.hz(36), "10 kHz")
    shows(t, speed.hz(44), "90 kHz")
    shows(t, speed.hz(45), "100 kHz")
    shows(t, speed.hz(53), "900 kHz")
    shows(t, speed.hz(54), "1 MHz")
}

/* The last stop is the top of the last decade. */
pub tops_out(t: *test.T) {
    shows(t, speed.hz(speed.STOPS - 1), "1 MHz")
}

pub units(t: *test.T) {
    shows(t, 250.0, "250 Hz")
    shows(t, 2000.0, "2 kHz")
    shows(t, 41263.0, "41.3 kHz")
    shows(t, 2500000.0, "2.5 MHz")
    shows(t, 1023000.0, "1.02 MHz")
    shows(t, 999.6, "1 kHz")
    shows(t, 999400.0, "999 kHz")
    shows(t, 999600.0, "1 MHz")
}
