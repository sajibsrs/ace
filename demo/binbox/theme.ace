/* theme — the bar and panel colors, and each block's name and colors. */

import grid: "./grid.ace"

/* Bar and panel colors. */
pub CHROME: const u32 = 0x22262b
/* A panel's or widget's header, deeper than the panel under it. */
pub DEEP: const u32 = 0x0f1215
/* The board panel's background. */
pub PANEL: const u32 = 0x101214
/* The Edit button, and the Simulate button: resting, then lit (current
 * phase or under the pointer). */
pub EDIT: const u32 = 0xe56b6b
pub EDIT_LIT: const u32 = 0xf58282
pub SIM: const u32 = 0x3d9a66
pub SIM_LIT: const u32 = 0x41bb77
pub DIM: const u32 = 0x888888

/* An empty cell's gap, which lets the grid show. */
pub CELL_GAP: const f32 = 1.0

pub NAME: [grid.Block]string = [
    grid.Block.empty = "empty",
    grid.Block.source = "source",
    grid.Block.wire = "wire",
    grid.Block.read = "read",
    grid.Block.write = "write",
    grid.Block.and = "AND",
    grid.Block.or = "OR",
    grid.Block.not = "NOT",
    grid.Block.nand = "NAND",
    grid.Block.nor = "NOR",
    grid.Block.xor = "XOR",
    grid.Block.xnor = "XNOR",
    grid.Block.led = "LED",
    grid.Block.bridge = "bridge",
    grid.Block.clock = "clock",
    grid.Block.toggle = "toggle",
]

