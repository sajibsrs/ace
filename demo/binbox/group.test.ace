import test
import grid: "./grid.ace"
import group: "./group.ace"

wire(g: *grid.Grid, x: int, y: int) {
    g.place(x, y, grid.Block.wire)
}

pub separate_runs(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    wire(&g, 0, 0)
    wire(&g, 1, 0)
    wire(&g, 5, 5)
    n: group.Groups = group.Groups.init(g)
    t.equal(n.count, 2)
    t.equal(n.of(0, 0), 0)
    t.equal(n.of(1, 0), 0)
    t.equal(n.of(5, 5), 1)
    t.equal(n.of(2, 2), -1)
}

pub diagonal_does_not_join(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    wire(&g, 0, 0)
    wire(&g, 1, 1)
    t.equal(group.Groups.init(g).count, 2)
}

pub bend_and_loop_are_one_net(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    for i: int in 0 .. 4 {
        wire(&g, i, 0)
        wire(&g, i, 3)
    }
    wire(&g, 0, 1)
    wire(&g, 0, 2)
    wire(&g, 3, 1)
    wire(&g, 3, 2)
    n: group.Groups = group.Groups.init(g)
    t.equal(n.count, 1)
    t.equal(n.of(2, 3), 0)
}

/* Pins and LEDs have no group; each source and clock cell is a group of its
 * own, even beside another. */
pub pins_and_leds_have_no_group(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    g.place(0, 0, grid.Block.source)
    wire(&g, 1, 0)
    g.place(2, 0, grid.Block.read)
    g.place(3, 0, grid.Block.write)
    g.place(4, 0, grid.Block.led)
    g.place(0, 1, grid.Block.source)
    g.place(1, 1, grid.Block.clock)
    n: group.Groups = group.Groups.init(g)
    t.equal(n.count, 4)
    t.equal(n.of(0, 0) != n.of(0, 1), true)
    t.equal(n.of(0, 1) != n.of(1, 1), true)
    t.equal(n.of(2, 0), -1)
    t.equal(n.of(3, 0), -1)
    t.equal(n.of(4, 0), -1)
}

/* Touching cells of one gate type are one gate; other blocks stay apart. */
pub same_gates_merge(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    g.place(0, 0, grid.Block.and)
    g.place(1, 0, grid.Block.and)
    g.place(1, 1, grid.Block.and)
    g.place(2, 0, grid.Block.or)
    wire(&g, 0, 1)
    n: group.Groups = group.Groups.init(g)
    t.equal(n.count, 3)
    t.equal(n.of(1, 1), n.of(0, 0))
    t.equal(n.of(2, 0) == n.of(1, 0), false)
    t.equal(n.of(0, 1) == n.of(0, 0), false)
    hx: int, hy: int = n.head(n.of(1, 1))
    t.equal(hx, 0)
    t.equal(hy, 0)
}

pub full_board(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH { wire(&g, x, y) }
    }
    t.equal(group.Groups.init(g).count, 1)
}

/* Wire from (1, 2) runs east through bridges (2..4, 2) to (5, 2); wire from
 * (3, 1) crosses south through the middle one to (3, 3). Two nets. */
pub bridge_keeps_crossing_nets_apart(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    for x: int in 2 .. 5 { g.place(x, 2, grid.Block.bridge) }
    wire(&g, 1, 2)
    wire(&g, 5, 2)
    wire(&g, 3, 1)
    wire(&g, 3, 3)
    n: group.Groups = group.Groups.init(g)
    t.equal(n.count, 2)
    t.equal(n.of(1, 2), n.of(5, 2))
    t.equal(n.of(3, 1), n.of(3, 3))
    t.equal(n.of(1, 2) != n.of(3, 1), true)
    t.equal(n.of(3, 2), -1)
}

/* A bridge passes only wire to wire: gate cells on either side stay apart. */
pub bridge_does_not_join_gates(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    g.place(0, 0, grid.Block.and)
    g.place(1, 0, grid.Block.bridge)
    g.place(2, 0, grid.Block.and)
    t.equal(group.Groups.init(g).count, 2)
}
