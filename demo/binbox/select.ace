/* select — the select tool's box, the blocks it carries, and the clipboard.
 *
 * A selection is a box of cells (corners inclusive). Picking it up lifts its
 * blocks off the board into `lift`; they are carried by (dx, dy) and put down
 * when the selection goes. Until then they float above the board, `held`
 * between drags, so they merge with nothing. A paste floats the same way, its
 * blocks never on the board.
 */

import math
import mem
import grid: "./grid.ace"
import sim: "./sim.ace"
import history: "./history.ace"

/* How a select-tool drag is going: none, drawing the box, or moving the
 * selected blocks, which are lifted off the board until the drop. */
pub Drag: enum u8 { none, box, move }

/* The cells of the selection box and the blocks lifted from them, row by row
 * over the box, and which sources were on. */
/* The per-cell arrays of a Selection: too big for the stack. */
pub Pad: struct {
    pub lift: [grid.CELLS]grid.Block = [grid.Block.empty : grid.CELLS],
    lifton: [grid.CELLS]bool = [false : grid.CELLS],
    liftspan: [grid.CELLS]int = [0 : grid.CELLS],
    /* The clipboard: copied blocks, row by row over a `clipw` by `cliph` box,
     * and which sources were on. */
    clip: [grid.CELLS]grid.Block = [grid.Block.empty : grid.CELLS],
    clipon: [grid.CELLS]bool = [false : grid.CELLS],
    clipspan: [grid.CELLS]int = [0 : grid.CELLS],
}

pub Selection: struct {
    /* Whether a box is selected, and its corners. */
    pub on: bool = false,
    pub x0: int = 0,
    pub y0: int = 0,
    pub x1: int = 0,
    pub y1: int = 0,
    /* The drag in progress: its anchor cell, the cell it is at, and for a move
     * how far the selection has been carried. */
    pub drag: Drag = Drag.none,
    pub ax: int = 0,
    pub ay: int = 0,
    pub bx: int = 0,
    pub by: int = 0,
    pub dx: int = 0,
    pub dy: int = 0,
    /* The lifted blocks and the clipboard, on the heap, allocated by `need`. */
    pub pad: []Pad = null,
    /* Set while `lift` floats between drags (moved blocks, or a paste), so a
     * press inside the selection carries them instead of lifting from the board. */
    pub held: bool = false,
    /* Whether the floating blocks came off the board, so removing them is an
     * edit; a paste's never were on it, nor are a clone's. */
    lifted: bool = false,
    /* Whether the move in progress carries a copy and leaves the board as it is. */
    cloning: bool = false,
    /* The clipboard: copied blocks, row by row over a `clipw` by `cliph` box,
     * and which sources were on; `clipw` is zero when nothing was copied. */
    pub clipw: int = 0,
    cliph: int = 0,
    /* The board before a carried selection was lifted. */
    pre: history.Snap = history.Snap {},
}

/* Whether a carried selection is in the air: lifted blocks, or a paste. */
pub Selection.carrying(const self): bool {
    return self.drag == Drag.move || self.held
}

/* Drops the selection; floating blocks land where they are. */
pub Selection.deselect(self, s: *sim.Sim, h: *history.History) {
    if self.on && self.held && self.drag != Drag.move { self.drop(s, h) }
    self.on = false
    self.drag = Drag.none
}

/* Whether cell (x, y) is inside the selection. */
pub Selection.has(const self, x: int, y: int): bool {
    return self.on && x >= self.x0 && x <= self.x1 && y >= self.y0 && y <= self.y1
}

/* Lifts the selected blocks off the board into `lift`, remembering which
 * sources are on, to be carried and dropped. */
/* Allocates the lift and clipboard arrays on first use. */
Selection.need(self) {
    if self.pad == null { self.pad = mem.zalloc[Pad](1) }
}

/* Releases the arrays. */
pub Selection.wipe(self) {
    mem.release[Pad](&self.pad)
}

Selection.lift_up(self, s: *sim.Sim) {
    self.need()
    g: grid.Grid = s.g
    w: int = self.x1 - self.x0 + 1
    for y: int in self.y0 .. self.y1 + 1 {
        for x: int in self.x0 .. self.x1 + 1 {
            i: int = (y - self.y0) * w + x - self.x0
            b: grid.Block = g.get(x, y)
            self.pad[0].lift[i] = b
            self.pad[0].lifton[i] = b == grid.Block.source && s.level(x, y) == sim.Level.high
            self.pad[0].liftspan[i] = g.span(x, y)
            g.remove(x, y)
        }
    }
    s.wipe()
    *s = sim.Sim.new(g)
}

/* Copies the selected blocks into `lift` as `lift_up` does, leaving the board
 * as it is, to be carried and dropped as a clone. */
Selection.clone_up(self, s: *sim.Sim) {
    self.need()
    g: grid.Grid = s.g
    w: int = self.x1 - self.x0 + 1
    for y: int in self.y0 .. self.y1 + 1 {
        for x: int in self.x0 .. self.x1 + 1 {
            i: int = (y - self.y0) * w + x - self.x0
            b: grid.Block = g.get(x, y)
            self.pad[0].lift[i] = b
            self.pad[0].lifton[i] = b == grid.Block.source && s.level(x, y) == sim.Level.high
            self.pad[0].liftspan[i] = g.span(x, y)
        }
    }
}

/* Puts the lifted blocks down `dx`, `dy` cells over: they replace what is
 * there, and empty cells of the selection leave the board as it is. */
Selection.drop(self, s: *sim.Sim, h: *history.History) {
    if self.held || self.dx != 0 || self.dy != 0 { h.record(self.pre) }
    g: grid.Grid = s.g
    w: int = self.x1 - self.x0 + 1
    for y: int in self.y0 .. self.y1 + 1 {
        for x: int in self.x0 .. self.x1 + 1 {
            b: grid.Block = self.pad[0].lift[(y - self.y0) * w + x - self.x0]
            if b != grid.Block.empty {
                g.place(x + self.dx, y + self.dy, b)
                g.span(x + self.dx, y + self.dy, self.pad[0].liftspan[(y - self.y0) * w + x - self.x0])
            }
        }
    }
    s.wipe()
    *s = sim.Sim.new(g)
    for y: int in self.y0 .. self.y1 + 1 {
        for x: int in self.x0 .. self.x1 + 1 {
            if self.pad[0].lifton[(y - self.y0) * w + x - self.x0] { s.toggle(x + self.dx, y + self.dy, true) }
        }
    }
    self.x0 += self.dx
    self.x1 += self.dx
    self.y0 += self.dy
    self.y1 += self.dy
    self.dx = 0
    self.dy = 0
    self.drag = Drag.none
    self.held = false
    self.lifted = false
    self.cloning = false
}

/* Puts the floating blocks back where they were lifted from: the board before
 * the lift or paste. */
pub Selection.cancel(self, s: *sim.Sim) {
    if !self.held { return }
    s.wipe()
    *s = self.pre.sim()
    self.held = false
    self.lifted = false
    self.on = false
    self.drag = Drag.none
}

/* Removes every selected block. */
pub Selection.erase(self, s: *sim.Sim, h: *history.History) {
    if !self.on { return }
    if self.held {
        /* Floating blocks are not on the board: they just go away. */
        if self.lifted { h.record(self.pre) }
        self.held = false
        self.lifted = false
        self.deselect(s, h)
        return
    }
    h.record(history.Snap.of(*s))
    g: grid.Grid = s.g
    for y: int in self.y0 .. self.y1 + 1 {
        for x: int in self.x0 .. self.x1 + 1 { g.remove(x, y) }
    }
    s.wipe()
    *s = sim.Sim.new(g)
    self.deselect(s, h)
}

/* Copies the selected blocks, and which sources are on, to the clipboard. */
pub Selection.copy(self, s: *sim.Sim, h: *history.History) {
    self.need()
    if !self.on { return }
    self.clipw = self.x1 - self.x0 + 1
    self.cliph = self.y1 - self.y0 + 1
    if self.held {
        /* Floating blocks are copied as they float, not merged first. */
        for i: int in 0 .. self.clipw * self.cliph {
            self.pad[0].clip[i] = self.pad[0].lift[i]
            self.pad[0].clipon[i] = self.pad[0].lifton[i]
            self.pad[0].clipspan[i] = self.pad[0].liftspan[i]
        }
        return
    }
    g: grid.Grid = s.g
    for y: int in self.y0 .. self.y1 + 1 {
        for x: int in self.x0 .. self.x1 + 1 {
            i: int = (y - self.y0) * self.clipw + x - self.x0
            b: grid.Block = g.get(x, y)
            self.pad[0].clip[i] = b
            self.pad[0].clipon[i] = b == grid.Block.source && s.level(x, y) == sim.Level.high
            self.pad[0].clipspan[i] = g.span(x, y)
        }
    }
}

/* Copies the selection, then removes it. */
pub Selection.cut(self, s: *sim.Sim, h: *history.History) {
    if !self.on { return }
    self.copy(s, h)
    self.erase(s, h)
}

/* Pastes the clipboard as a floating selection with its top-left corner at
 * cell (cx, cy), kept on the board. */
pub Selection.paste(self, s: *sim.Sim, cx: int, cy: int) {
    self.need()
    self.x0 = math.min[int](cx, grid.WIDTH - self.clipw)
    self.y0 = math.min[int](cy, grid.HEIGHT - self.cliph)
    self.x1 = self.x0 + self.clipw - 1
    self.y1 = self.y0 + self.cliph - 1
    for i: int in 0 .. self.clipw * self.cliph {
        self.pad[0].lift[i] = self.pad[0].clip[i]
        self.pad[0].lifton[i] = self.pad[0].clipon[i]
        self.pad[0].liftspan[i] = self.pad[0].clipspan[i]
    }
    self.dx = 0
    self.dy = 0
    self.on = true
    self.held = true
    self.pre = history.Snap.of(*s)
}

/* A left press on cell (cx, cy), or off the board when `cx` is negative:
 * inside the selection it picks the blocks up, or with `clone` a copy of them
 * (floating blocks are put down first, and the copy is carried on), elsewhere
 * it starts a new box. */
pub Selection.press(self, s: *sim.Sim, h: *history.History, cx: int, cy: int, clone: bool) {
    if cx < 0 {
        self.deselect(s, h)
        return
    }
    self.ax = cx
    self.ay = cy
    self.bx = cx
    self.by = cy
    if self.has(cx, cy) {
        if clone && self.held { self.drop(s, h) }
        self.drag = Drag.move
        self.dx = 0
        self.dy = 0
        self.cloning = clone
        if !self.held {
            self.pre = history.Snap.of(*s)
            if clone { self.clone_up(s) } else { self.lift_up(s) }
        }
    } else {
        self.deselect(s, h)
        self.drag = Drag.box
    }
}

/* The pointer moved to cell (cx, cy), the one nearest it, during a drag. */
pub Selection.sweep(self, cx: int, cy: int) {
    if self.drag == Drag.box {
        self.bx = cx
        self.by = cy
    }
    if self.drag == Drag.move {
        /* The selection stays on the board. */
        self.dx = math.min[int](math.max[int](cx - self.ax, -self.x0), grid.WIDTH - 1 - self.x1)
        self.dy = math.min[int](math.max[int](cy - self.ay, -self.y0), grid.HEIGHT - 1 - self.y1)
    }
}

/* The left button went up: a box becomes the selection (a click on an empty
 * cell selects nothing), a move leaves its blocks floating where they are; a
 * click that moved nothing puts them back. */
pub Selection.release(self, s: *sim.Sim, h: *history.History) {
    if self.drag == Drag.move {
        if !self.held && self.dx == 0 && self.dy == 0 {
            self.drop(s, h)
        } else {
            if !self.held { self.lifted = !self.cloning }
            self.x0 += self.dx
            self.x1 += self.dx
            self.y0 += self.dy
            self.y1 += self.dy
            self.dx = 0
            self.dy = 0
            self.held = true
            self.drag = Drag.none
        }
    }
    if self.drag == Drag.box {
        self.x0 = math.min[int](self.ax, self.bx)
        self.x1 = math.max[int](self.ax, self.bx)
        self.y0 = math.min[int](self.ay, self.by)
        self.y1 = math.max[int](self.ay, self.by)
        lone: bool = self.ax == self.bx && self.ay == self.by
        self.on = !lone || s.g.get(self.ax, self.ay) != grid.Block.empty
        self.drag = Drag.none
    }
}
