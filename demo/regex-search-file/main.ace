/* Lists every `Decision:` line of the repository's spec/types.md with
 * pkg/regex.
 *
 * The file is opened relative to the current working directory, not to this
 * source file, so run from this directory:
 *   ace pkg run
 */

import file
import fmt
import mem
import regex

PATH: string = "../../spec/types.md"

main(): int {
    data: []u8, err: Error = file.read(PATH)
    defer mem.release[u8](&data)
    if err != null {
        fmt.printf("failed to read %s: %s\n", PATH, err.message)
        return 1
    }

    re: regex.Regex, rerr: Error = regex.Regex.compile("\nDecision: ([^\n]+)")
    defer re.wipe()
    if rerr != null { return 1 }

    text: string = string(data)
    at: usize = 0
    for re.next(text, &at) { fmt.println(re.group(1)) }
    return 0
}
