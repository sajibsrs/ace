/* Lists every `Decision:` line of the repository's SPEC.md with pkg/regex.
 *
 * SPEC.md is opened relative to the current working directory, not to this
 * source file, so run from this directory:
 *   ace pkg run
 */

import file
import fmt
import mem
import regex

PATH: string = "../../SPEC.md"

main(): int {
    data: mut []u8, err: Error = file.read(PATH)
    defer mem.release[u8](mut data)
    if err != null {
        fmt.printf("failed to read %s: %s\n", PATH, err.message)
        return 1
    }

    re: regex.Regex, rerr: Error = regex.Regex::new("\nDecision: ([^\n]+)")
    defer mut re.wipe()
    if rerr != null { return 1 }

    text: string = string(data)
    at: usize = 0
    for mut re.next(text, mut at) { fmt.println(re.group(1)) }
    return 0
}
