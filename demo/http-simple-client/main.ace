/* Minimal HTTP/1.1 client proof of concept over pkg/http's blocking
 * `http.get(url, context)` overload: an allocation-lazy `ClientContext`,
 * one GET, and the response status/body — no redirects, no TLS.
 *
 * Build and run (from this directory):
 *   ace pkg run
 */

import fmt
import http

main(): int {
    url: string = "http://example.com/"

    context: http.ClientContext = http.client_context_new()
    defer http.client_context_wipe(mut context)

    response: http.Response, err: Error = http.get(url, mut context)
    if err != null {
        fmt.printf("failed to fetch %s: error %d\n", url, int(err.code))
        return 1
    }

    fmt.printf("%d %s\n", int(response.status), response.reason)
    fmt.printf("%s\n", response.body)
    return 0
}
