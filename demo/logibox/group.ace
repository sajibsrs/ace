/* group — connected groups of cells.
 *
 * Touching cells (north, east, south, west) of the same joining block form one
 * group: wire cells form a net, and cells of one gate type form one gate. A
 * signal travels over a whole net, and a gate acts as one block however many
 * cells it covers. Every other block has no group.
 */

import grid: "./grid.ace"

NONE: const int = -1

DX: [4]int = [0, 1, 0, -1]
DY: [4]int = [-1, 0, 1, 0]

/* Whether touching cells of `block` merge into one group. */
pub joins(block: grid.Block): bool {
    return block == grid.Block.wire || grid.is_gate(block)
}

pub Groups: struct {
    /* The group number of each cell, or NONE for a cell in no group. */
    ids: [16][16]int = [[NONE : 16] : 16],
    /* The first cell of each group, packed as y * WIDTH + x. */
    heads: [16 * 16]int = [0 : 16 * 16],
    /* How many groups there are; numbers run 0 .. count-1. */
    pub count: int = 0,
}

/* Numbers the groups of `g` in row-major order of each group's first cell. */
pub Groups.init(g: grid.Grid): Groups {
    groups: Groups = Groups {}
    /* Cells still to visit, each packed as y * WIDTH + x. */
    stack: [16 * 16]int = [0 : 16 * 16]

    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            block: grid.Block = g.get(x, y)
            if !joins(block) || groups.ids[y][x] != NONE { continue }

            id: int = groups.count
            groups.count += 1
            groups.heads[id] = y * grid.WIDTH + x
            groups.ids[y][x] = id
            stack[0] = y * grid.WIDTH + x
            top: int = 1
            for top > 0 {
                top -= 1
                at: int = stack[top]
                for d: int in 0 .. 4 {
                    nx: int = at % grid.WIDTH + DX[d]
                    ny: int = at / grid.WIDTH + DY[d]
                    if !grid.inside(nx, ny) || g.get(nx, ny) != block { continue }
                    if groups.ids[ny][nx] != NONE { continue }
                    groups.ids[ny][nx] = id
                    stack[top] = ny * grid.WIDTH + nx
                    top += 1
                }
            }
        }
    }
    return groups
}

/* The group at (x, y), or -1 when the cell is off the board or in no group. */
pub Groups.of(const self, x: int, y: int): int {
    if !grid.inside(x, y) { return NONE }
    return self.ids[y][x]
}

/* The first cell of group `id`. */
pub Groups.head(const self, id: int): (int, int) {
    at: int = self.heads[id]
    return at % grid.WIDTH, at / grid.WIDTH
}
