import file
import mem
import test
import grid: "./grid.ace"
import sim: "./sim.ace"
import diagram: "./diagram.ace"

/* Places a row of blocks starting at (x, y), one per cell eastward. */
row(g: *grid.Grid, x: int, y: int, blocks: []grid.Block) {
    for i: usize in 0 .. blocks.len { g.place(x + int(i), y, blocks[i]) }
}

high(t: *test.T, s: sim.Sim, x: int, y: int) {
    test.equal[sim.Level](t, s.level(x, y), sim.Level.high)
}

low(t: *test.T, s: sim.Sim, x: int, y: int) {
    test.equal[sim.Level](t, s.level(x, y), sim.Level.low)
}

error(t: *test.T, s: sim.Sim, x: int, y: int) {
    test.equal[sim.Level](t, s.level(x, y), sim.Level.error)
}

/* Sources (0,0) and (0,2) feed wires into input pins (2,0) and (2,2) above and
 * below a gate at (2,1); its output pin (3,1) drives a wire into a light at
 * (5,1). */
two_input(block: grid.Block): sim.Sim {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.source, grid.Block.wire, grid.Block.input])
    row(&g, 2, 1, [block, grid.Block.output, grid.Block.wire, grid.Block.light])
    row(&g, 0, 2, [grid.Block.source, grid.Block.wire, grid.Block.input])
    return sim.Sim.init(g)
}

result(block: grid.Block, a: bool, b: bool): sim.Level {
    s: sim.Sim = two_input(block)
    s.toggle(0, 0, a)
    s.toggle(0, 2, b)
    s.tick()
    return s.level(5, 1)
}

pub and_truth_table(t: *test.T) {
    test.equal[sim.Level](t, result(grid.Block.and, false, false), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.and, true, false), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.and, false, true), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.and, true, true), sim.Level.high)
}

pub or_truth_table(t: *test.T) {
    test.equal[sim.Level](t, result(grid.Block.or, false, false), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.or, true, false), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.or, false, true), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.or, true, true), sim.Level.high)
}

pub nand_truth_table(t: *test.T) {
    test.equal[sim.Level](t, result(grid.Block.nand, false, false), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.nand, true, false), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.nand, false, true), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.nand, true, true), sim.Level.low)
}

pub nor_truth_table(t: *test.T) {
    test.equal[sim.Level](t, result(grid.Block.nor, false, false), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.nor, true, false), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.nor, false, true), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.nor, true, true), sim.Level.low)
}

pub xor_truth_table(t: *test.T) {
    test.equal[sim.Level](t, result(grid.Block.xor, false, false), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.xor, true, false), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.xor, false, true), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.xor, true, true), sim.Level.low)
}

pub xnor_truth_table(t: *test.T) {
    test.equal[sim.Level](t, result(grid.Block.xnor, false, false), sim.Level.high)
    test.equal[sim.Level](t, result(grid.Block.xnor, true, false), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.xnor, false, true), sim.Level.low)
    test.equal[sim.Level](t, result(grid.Block.xnor, true, true), sim.Level.high)
}

/* A five-cell XOR column with pins on rows 0, 2 and 4 is high on an odd count of
 * high inputs. */
pub xor_is_parity(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    for y: int in 0 .. 5 { g.place(3, y, grid.Block.xor) }
    for y: int in [0, 2, 4] { row(&g, 0, y, [grid.Block.source, grid.Block.wire, grid.Block.input]) }
    row(&g, 4, 2, [grid.Block.output, grid.Block.wire, grid.Block.light])
    s: sim.Sim = sim.Sim.init(g)
    s.toggle(0, 0, true)
    s.toggle(0, 2, true)
    s.tick()
    low(t, s, 6, 2)
    s.toggle(0, 4, true)
    s.tick()
    high(t, s, 6, 2)
}

pub xor_with_one_pin_is_an_error(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.source, grid.Block.wire, grid.Block.input, grid.Block.xor])
    s: sim.Sim = sim.Sim.init(g)
    s.tick()
    error(t, s, 3, 0)
}

pub source_drives_wire_without_delay(t: *test.T) {
    s: sim.Sim = two_input(grid.Block.and)
    s.toggle(0, 0, true)
    high(t, s, 1, 0)
    high(t, s, 2, 0)
    low(t, s, 1, 2)
}

pub gate_adds_one_tick(t: *test.T) {
    s: sim.Sim = two_input(grid.Block.and)
    s.toggle(0, 0, true)
    s.toggle(0, 2, true)
    low(t, s, 5, 1)
    s.tick()
    high(t, s, 2, 1)
    high(t, s, 5, 1)
}

/* A gate without an output pin still shows its output but drives nothing. */
pub gate_without_output_pin_drives_nothing(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.source, grid.Block.wire, grid.Block.input, grid.Block.or, grid.Block.wire, grid.Block.light])
    s: sim.Sim = sim.Sim.init(g)
    s.toggle(0, 0, true)
    s.tick()
    high(t, s, 3, 0)
    low(t, s, 5, 0)
}

/* S W I ! O W I ! O W L: each NOT adds a tick. */
pub chained_gates_delay_per_gate(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [
        grid.Block.source, grid.Block.wire, grid.Block.input, grid.Block.not, grid.Block.output,
        grid.Block.wire, grid.Block.input, grid.Block.not, grid.Block.output, grid.Block.wire,
        grid.Block.light,
    ])
    s: sim.Sim = sim.Sim.init(g)
    s.tick()
    s.tick()
    low(t, s, 10, 0)
    s.toggle(0, 0, true)
    s.tick()
    low(t, s, 3, 0)
    low(t, s, 10, 0)
    s.tick()
    high(t, s, 10, 0)
}

pub lone_gate_is_idle(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    g.place(0, 0, grid.Block.not)
    s: sim.Sim = sim.Sim.init(g)
    s.tick()
    low(t, s, 0, 0)
}

pub and_with_one_pin_is_an_error(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.source, grid.Block.wire, grid.Block.input, grid.Block.and, grid.Block.output, grid.Block.wire])
    s: sim.Sim = sim.Sim.init(g)
    s.tick()
    error(t, s, 3, 0)
    error(t, s, 5, 0)
}

pub not_with_two_pins_is_an_error(t: *test.T) {
    s: sim.Sim = two_input(grid.Block.not)
    s.tick()
    error(t, s, 2, 1)
}

/* Cells of one gate type merge: two AND cells with a pin each are one AND. */
pub merged_gate_counts_all_pins(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.source, grid.Block.wire, grid.Block.input, grid.Block.and])
    row(&g, 0, 1, [grid.Block.source, grid.Block.wire, grid.Block.input, grid.Block.and, grid.Block.output, grid.Block.wire, grid.Block.light])
    s: sim.Sim = sim.Sim.init(g)
    s.toggle(0, 0, true)
    s.toggle(0, 1, true)
    s.tick()
    high(t, s, 3, 0)
    high(t, s, 6, 1)
}

/* Two sources on one wire: agreeing is fine, disagreeing is contention. */
pub contention_is_an_error(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.source, grid.Block.wire, grid.Block.source])
    g.place(1, 1, grid.Block.light)
    s: sim.Sim = sim.Sim.init(g)
    low(t, s, 1, 0)
    s.toggle(0, 0, true)
    error(t, s, 1, 0)
    error(t, s, 1, 1)
    s.toggle(2, 0, true)
    high(t, s, 1, 0)
}

/* An error on a gate's input spreads to its output a tick later. */
pub error_propagates(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.source, grid.Block.wire, grid.Block.input, grid.Block.not, grid.Block.output, grid.Block.wire])
    g.place(1, 1, grid.Block.source)
    s: sim.Sim = sim.Sim.init(g)
    s.toggle(1, 1, true)
    s.tick()
    error(t, s, 3, 0)
    error(t, s, 5, 0)
}

/* One input pin touching two gates feeds both. */
pub pin_fans_out(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 1, [grid.Block.source, grid.Block.wire, grid.Block.input])
    g.place(2, 0, grid.Block.or)
    g.place(2, 2, grid.Block.not)
    s: sim.Sim = sim.Sim.init(g)
    s.toggle(0, 1, true)
    s.tick()
    high(t, s, 2, 0)
    low(t, s, 2, 2)
}

/* A NOT whose output wire loops back to its input pin oscillates. */
pub not_loop_oscillates(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [grid.Block.wire, grid.Block.wire, grid.Block.wire])
    row(&g, 0, 1, [grid.Block.input, grid.Block.not, grid.Block.output])
    s: sim.Sim = sim.Sim.init(g)
    s.tick()
    high(t, s, 1, 1)
    s.tick()
    low(t, s, 1, 1)
    s.tick()
    high(t, s, 1, 1)
}

pub toggle_rejects_non_source(t: *test.T) {
    s: sim.Sim = two_input(grid.Block.and)
    t.equal(s.toggle(2, 1, true), false)
}

ticks(s: *sim.Sim, n: int) {
    for i: int in 0 .. n { s.tick() }
}

/* Two NORs cross-coupled: Q = NOR(R, Q'), and Q' = NOR(S, Q), centered on the
 * board as diagram/latch.lgbx stores it. Sources R (5,6) and S (5,9) touch the
 * NORs' input pins; light Q at (10,6). Q' needs no wire: the lower NOR's output
 * pin (7,8) touches the upper NOR's input pin (7,7). Q runs down column 9 to
 * the lower NOR's input pin (8,9). */
latch(): sim.Sim {
    g: grid.Grid = grid.Grid {}
    row(&g, 5, 6, [
        grid.Block.source, grid.Block.input, grid.Block.nor, grid.Block.output,
        grid.Block.wire, grid.Block.light,
    ])
    g.place(7, 7, grid.Block.input)
    g.place(7, 8, grid.Block.output)
    g.place(9, 7, grid.Block.wire)
    g.place(9, 8, grid.Block.wire)
    row(&g, 5, 9, [grid.Block.source, grid.Block.input, grid.Block.nor, grid.Block.input, grid.Block.wire])
    return sim.Sim.init(g)
}

/* The latch as diagram/latch.lgbx stores it. */
pub latch_matches_file(t: *test.T) {
    data: []u8, err: Error = file.read("diagram/latch.lgbx")
    defer mem.release[u8](&data)
    t.equal(err == null, true)
    stored: sim.Sim, derr: Error = diagram.decode(data)
    t.equal(derr == null, true)
    built: sim.Sim = latch()
    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            test.equal[grid.Block](t, stored.g.get(x, y), built.g.get(x, y))
        }
    }
}

pub sr_latch_holds_a_bit(t: *test.T) {
    s: sim.Sim = latch()
    s.toggle(5, 9, true)
    ticks(&s, 8)
    s.toggle(5, 9, false)
    ticks(&s, 8)
    high(t, s, 10, 6)
    low(t, s, 7, 8)

    s.toggle(5, 6, true)
    ticks(&s, 8)
    s.toggle(5, 6, false)
    ticks(&s, 8)
    low(t, s, 10, 6)
    high(t, s, 7, 8)
}

/* Sources, pins and lights connect by touching; wire only spans distance. */
pub touching_blocks_need_no_wire(t: *test.T) {
    g: grid.Grid = grid.Grid {}
    row(&g, 0, 0, [
        grid.Block.source, grid.Block.input, grid.Block.not, grid.Block.output,
        grid.Block.input, grid.Block.not, grid.Block.output, grid.Block.light,
    ])
    g.place(0, 1, grid.Block.light)
    s: sim.Sim = sim.Sim.init(g)
    s.toggle(0, 0, true)
    high(t, s, 0, 1)
    high(t, s, 1, 0)
    s.tick()
    s.tick()
    high(t, s, 7, 0)
    s.toggle(0, 0, false)
    s.tick()
    s.tick()
    low(t, s, 7, 0)
}
