/* logibox: a logic-gate sandbox: square blocks on a grid, in an SDL3 window.
 *
 * Build and run from this directory (Homebrew SDL3 on Apple arm64):
 *   ace pkg run
 *
 * A source feeds a gate's input pin (I); the gate's output pin (O) feeds the
 * next input pin or an LED. Each connects by touching, or through wire when
 * apart.
 *
 * Edit (F1) builds the board: left-click places the selected block (drag to
 * paint), right-click (or drag) removes. Run (F2) simulates it: left-click flips
 * a source, space or Auto toggles auto-ticking, and Step ticks once. Letters
 * select a block: s source, w wire, i input pin, o output pin, a AND, r OR,
 * n NOT, z NAND, v NOR, x XOR, c XNOR, l LED, b bridge. The wheel zooms the
 * board about the pointer; the window resizes and goes full screen. Cmd+Q
 * quits. The strip at the board's left holds the tools, picked by 1 and 2: the
 * pencil (above) and box select: drag over blocks to select them, drag the selection to
 * move it, Delete removes it, Escape or a click elsewhere drops it.
 *
 * Diagrams live in diagram/ as .lgbx files, relative to where it runs. The bar
 * has New, Open (a list of diagram/), Save, and Save as (a name box: a-z, 0-9,
 * - and _; Enter saves, Escape cancels). Ctrl+S saves and Ctrl+O opens.
 */

import file
import fmt
import math
import mem
import sort
import str
import sys
import (
    init, quit, error, ticks, Window, Renderer, Event, Color, InitFlags, WindowFlags,
    EventType, Keycode, MouseButton, MouseButtonEvent, MouseMotionEvent, MouseWheelEvent,
    KeyboardEvent, Cursor, SystemCursor, cursor, BLEND_ALPHA,
) from sdl
import grid: "./grid.ace"
import sim: "./sim.ace"
import diagram: "./diagram.ace"
import ui: "./ui.ace"
import icon: "./icon.ace"

/* A cell's side at 1x; the window is created 16 x 16 cells at 1x. */
CELL: const f32 = 40.0
/* The most and least zoom, as multiples of 1x, and the factor one wheel step
 * applies. A window too small for the least zoom to show the board still
 * fits it. */
ZOOM_MAX: const f32 = 4.0
ZOOM_MIN: const f32 = 0.25
/* The zoom at start. */
ZOOM_START: const f32 = 0.5
ZOOM_STEP: const f32 = 1.25
BAR: const f32 = 28.0
FOOT: const f32 = 24.0
/* Space between panels, and between a panel and the window's edge. */
GAP: const f32 = 8.0
/* Top to bottom the window holds the toolbar, the block row, then the sidebar
 * beside the board, and the footer: TOP is where the sidebar and board start,
 * BELOW the space under them. */
TOP: const f32 = 3.0 * GAP + 2.0 * BAR
BELOW: const f32 = 2.0 * GAP + FOOT
/* The tool strip down the board's left side, and a tool button in it. */
STRIP: const f32 = 40.0
PICK: const f32 = 32.0
WIDTH: const f32 = 16.0 * 40.0
AUTO_MS: const u64 = 250

/* Where diagrams are listed, read and written, relative to the folder that
 * holds the executable's build/ folder. */
FOLDER: const string = "../diagram"
/* Longest diagram name, without the extension. */
NAME_MAX: const usize = 32
/* Most diagrams the Open list shows. */
LIST_MAX: const usize = 24
ROW: const f32 = 20.0

/* SDL keycodes the binding leaves unnamed. */
KEY_DELETE: const u32 = 0x7f
KEY_HOME: const u32 = 0x4000_004a
KEY_END: const u32 = 0x4000_004d
KEY_F1: const u32 = 0x4000_003a
KEY_F2: const u32 = 0x4000_003b

/* SDL_KMOD_SHIFT and SDL_KMOD_CTRL: either side's key. */
KMOD_SHIFT: const u16 = 0x0003
KMOD_CTRL: const u16 = 0x00c0
/* SDL_KMOD_GUI: either side's Command (Windows) key. */
KMOD_GUI: const u16 = 0x0c00

NAME: [grid.Block]string = [
    grid.Block.empty = "empty",
    grid.Block.source = "source",
    grid.Block.wire = "wire",
    grid.Block.input = "input",
    grid.Block.output = "output",
    grid.Block.and = "AND",
    grid.Block.or = "OR",
    grid.Block.not = "NOT",
    grid.Block.nand = "NAND",
    grid.Block.nor = "NOR",
    grid.Block.xor = "XOR",
    grid.Block.xnor = "XNOR",
    grid.Block.led = "LED",
    grid.Block.bridge = "bridge",
]

/* Low and high colors of each block; any block on an error is ERROR. */
LOW: [grid.Block]u32 = [
    grid.Block.empty = 0x2d3238,
    grid.Block.source = 0x7e5119,
    grid.Block.wire = 0x434343,
    grid.Block.input = 0x3b513b,
    grid.Block.output = 0x513b68,
    grid.Block.and = 0x2a517e,
    grid.Block.or = 0x2a6851,
    grid.Block.not = 0x68512a,
    grid.Block.nand = 0x3b3b7e,
    grid.Block.nor = 0x2a6868,
    grid.Block.xor = 0x682a40,
    grid.Block.xnor = 0x51512a,
    grid.Block.led = 0x682222,
    grid.Block.bridge = 0x3e3e3e,
]
HIGH: [grid.Block]u32 = [
    grid.Block.empty = 0x2d3238,
    grid.Block.source = 0xffa225,
    grid.Block.wire = 0x7c8470,
    grid.Block.input = 0x9bcf62,
    grid.Block.output = 0xd894e8,
    grid.Block.and = 0x57b4ff,
    grid.Block.or = 0x51eba7,
    grid.Block.not = 0xffd44d,
    grid.Block.nand = 0x7d7dff,
    grid.Block.nor = 0x51d8e0,
    grid.Block.xor = 0xff6793,
    grid.Block.xnor = 0xc1d851,
    grid.Block.led = 0xff4545,
    grid.Block.bridge = 0x70786a,
]
ERROR: const u32 = 0xb030b0

/* `from` moved `percent` of the way to `to`, channel by channel. */
mix(from: u32, to: u32, percent: u32): u32 {
    r: u32 = ((from / 0x10000) % 0x100 * (100 - percent) + (to / 0x10000) % 0x100 * percent) / 100
    g: u32 = ((from / 0x100) % 0x100 * (100 - percent) + (to / 0x100) % 0x100 * percent) / 100
    b: u32 = (from % 0x100 * (100 - percent) + to % 0x100 * percent) / 100
    return r * 0x10000 + g * 0x100 + b
}

/* How far an icon sits from its block's fill: a lit block's icon goes this
 * far toward the block's dark color, an unlit block's toward its bright one.
 * Both stay in the block's own hue, so no icon stands out from the rest. */
LIT: const u32 = 55
UNLIT: const u32 = 28

/* The color of block `b`'s icon while it shows `level`. */
icon_ink(b: grid.Block, level: sim.Level): u32 {
    if level == sim.Level.error { return mix(ERROR, 0x000000, LIT) }
    if level == sim.Level.high { return mix(HIGH[b], LOW[b], LIT) }
    return mix(LOW[b], HIGH[b], UNLIT)
}

/* Bar and panel colors. */
CHROME: const u32 = 0x181b1f
/* The board panel's background, and what shows between the panels. */
PANEL: const u32 = 0x101214
WINDOW: const u32 = 0x0a0b0c
BUTTON: const u32 = 0x2c3238
ACTIVE: const u32 = 0x3d4f63
/* A button the current phase cannot use. */
DISABLED: const u32 = 0x22262b
INK: const u32 = 0xdddddd
DIM: const u32 = 0x888888
/* The selection's outline. */
SELECT: const u32 = 0x57b4ff

/* What the bar has open over the board: nothing, the Open list, or the
 * Save-as box. */
Mode: enum u8 { none, open, save_as }

/* Whether the board is being built (blocks placed, no ticks) or simulated
 * (sources flip, ticks run). */
Phase: enum u8 { edit, run }

/* What the left mouse button does on the board in Edit: place the selected
 * block, or box-select blocks and drag them. */
Tool: enum u8 { pencil, select }

/* How a select-tool drag is going: none, drawing the box, or moving the
 * selected blocks, which are lifted off the board until the drop. */
Drag: enum u8 { none, box, move }

/* The strip button of `pick`. */
strip_at(pick: Tool): ui.Rect {
    return ui.Rect { x = GAP + (STRIP - PICK) / 2.0, y = TOP + 6.0 + f32(int(pick)) * (PICK + 6.0), w = PICK, h = PICK }
}

STRIP_ICON: [Tool]icon.Id = [
    Tool.pencil = icon.Id.edit,
    Tool.select = icon.Id.select,
]

/* The bar's buttons, left to right. */
Button: enum u8 { new, open, save, save_as, edit, run, step, auto, zoom_out, zoom_in }

LABEL: [Button]string = [
    Button.new = "New",
    Button.open = "Open",
    Button.save = "Save",
    Button.save_as = "Save as",
    Button.edit = "Edit",
    Button.run = "Run",
    Button.step = "Step",
    Button.auto = "Auto",
    Button.zoom_out = "",
    Button.zoom_in = "",
]

/* A button's inset before its icon and after its text, the icon's side, and
 * the gap between icon and label. */
PAD: const f32 = 6.0
GLYPH_SIDE: const f32 = 18.0
LABEL_GAP: const f32 = 4.0

ICON: [Button]icon.Id = [
    Button.new = icon.Id.new,
    Button.open = icon.Id.open,
    Button.save = icon.Id.save,
    Button.save_as = icon.Id.save_as,
    Button.edit = icon.Id.edit,
    Button.run = icon.Id.run,
    Button.step = icon.Id.step,
    Button.auto = icon.Id.auto,
    Button.zoom_out = icon.Id.zoom_out,
    Button.zoom_in = icon.Id.zoom_in,
]

/* The block each letter key selects, lowercase as SDL reports it. */
LETTER: [grid.Block]u8 = [
    grid.Block.empty = 0,
    grid.Block.source = 's',
    grid.Block.wire = 'w',
    grid.Block.input = 'i',
    grid.Block.output = 'o',
    grid.Block.and = 'a',
    grid.Block.or = 'r',
    grid.Block.not = 'n',
    grid.Block.nand = 'z',
    grid.Block.nor = 'v',
    grid.Block.xor = 'x',
    grid.Block.xnor = 'c',
    grid.Block.led = 'l',
    grid.Block.bridge = 'b',
]

/* The bar rectangle of `button`: its icon and label, 6 pixels apart. The zoom
 * buttons hold an icon alone. */
place(button: Button): ui.Rect {
    x: f32 = GAP + 6.0
    for i: usize in 0 .. members(Button).len {
        each: Button = members(Button)[i]
        /* Icon, gap, and label, inset by PAD. */
        w: f32 = 2.0 * PAD + GLYPH_SIDE
        if LABEL[each].len > 0 { w += LABEL_GAP + f32(LABEL[each].len) * ui.GLYPH }
        /* Gaps set the phase and zoom buttons apart. */
        if each == Button.edit || each == Button.zoom_out { x += 18.0 }
        if each == button { return ui.Rect { x = x, y = GAP + 4.0, w = w, h = BAR - 8.0 } }
        x += w + 6.0
    }
    return ui.Rect {}
}

/* The block row's button for `block` in a window `width` wide: one equal slot
 * for each block. */
tool(block: grid.Block, width: f32): ui.Rect {
    slot: f32 = (width - 2.0 * GAP - 6.0) / f32(members(grid.Block).len - 1)
    i: f32 = f32(int(block) - 1)
    return ui.Rect { x = GAP + 6.0 + i * slot, y = 2.0 * GAP + BAR + 4.0, w = slot - 6.0, h = BAR - 8.0 }
}

/* The block row's icons; the empty block has none. */
BLOCK_ICON: [grid.Block]icon.Id = [
    grid.Block.empty = icon.Id.source,
    grid.Block.source = icon.Id.source,
    grid.Block.wire = icon.Id.wire,
    grid.Block.input = icon.Id.input,
    grid.Block.output = icon.Id.output,
    grid.Block.and = icon.Id.and,
    grid.Block.or = icon.Id.or,
    grid.Block.not = icon.Id.not,
    grid.Block.nand = icon.Id.nand,
    grid.Block.nor = icon.Id.nor,
    grid.Block.xor = icon.Id.xor,
    grid.Block.xnor = icon.Id.xnor,
    grid.Block.led = icon.Id.led,
    grid.Block.bridge = icon.Id.bridge,
]

/* Row `i` of the Open list. */
row(i: usize): ui.Rect {
    at: ui.Rect = place(Button.open)
    return ui.Rect { x = at.x, y = GAP + BAR + f32(i) * ROW, w = 280.0, h = ROW }
}

/* The Save-as panel's size; it sits centered in the window. */
PANEL_W: const f32 = 320.0
PANEL_H: const f32 = 72.0

before(a: string, b: string): bool {
    return str.compare(a, b) < 0
}

/* A name typed or chosen for a diagram, without folder or extension, with
 * the cursor before byte `at`. */
Name: struct {
    bytes: [32]u8 = [0 : 32],
    len: usize = 0,
    at: usize = 0,
}

Name.text(self): string {
    return self.bytes[0..self.len]
}

/* Inserts `c` at the cursor and moves past it. */
Name.add(self, c: u8) {
    if self.len == NAME_MAX { return }
    for i: usize = self.len; i > self.at; i -= 1 { self.bytes[i] = self.bytes[i - 1] }
    self.bytes[self.at] = c
    self.len += 1
    self.at += 1
}

/* Removes the byte at `i`, before the cursor or after it. */
Name.cut(self, i: usize) {
    for j: usize in i .. self.len - 1 { self.bytes[j] = self.bytes[j + 1] }
    self.len -= 1
    if self.at > i { self.at -= 1 }
}

/* Backspace: removes the byte before the cursor. */
Name.back(self) {
    if self.at > 0 { self.cut(self.at - 1) }
}

/* Delete: removes the byte after the cursor. */
Name.forward(self) {
    if self.at < self.len { self.cut(self.at) }
}

/* Replaces the name with `text`, the cursor at its end. */
Name.copy(self, text: string) {
    self.len = 0
    self.at = 0
    for i: usize in 0 .. text.len { self.add(text[i]) }
}

/* The diagrams in a folder, by name without the extension, sorted. */
Listing: struct {
    pool: [24 * 32]u8 = [0 : 24 * 32],
    names: [24]string = ["" : 24],
    count: usize = 0,
}

/* Rereads `folder`; a missing folder lists nothing. The names view the pool,
 * so a Listing stays where it was scanned. */
Listing.scan(self, folder: string): Error {
    self.count = 0
    dir: sys.Dir, err: Error = sys.opendir(folder)
    defer sys.closedir(&dir)
    if err != null { return err }

    entry: [256]u8
    used: usize = 0
    for self.count < LIST_MAX {
        n: usize, kind: sys.FileType, done: bool, rerr: Error = sys.readdir(&dir, entry[..])
        if rerr != null { return rerr }
        if done { break }
        if kind != sys.FileType.regular { continue }
        stem: string, ok: bool = str.trim(entry[0..n], diagram.EXTENSION, true)
        if !ok || stem.len == 0 || stem.len > NAME_MAX { continue }
        for i: usize in 0 .. stem.len { self.pool[used + i] = stem[i] }
        self.names[self.count] = self.pool[used .. used + stem.len]
        used += stem.len
        self.count += 1
    }
    sort.unstable[string](self.names[0..self.count], before)
    return null
}

/* The editor: the simulation, what the player has selected, and the file. */
Game: struct {
    s: sim.Sim = sim.Sim {},
    block: grid.Block = grid.Block.wire,
    auto: bool = false,
    count: int = 0,
    mode: Mode = Mode.none,
    phase: Phase = Phase.edit,
    /* The open diagram's name; empty until it is saved or opened. */
    name: Name = Name {},
    /* The name being typed in the Save-as box. */
    draft: Name = Name {},
    list: Listing = Listing {},
    /* The diagram folder's path, from `locate`. */
    folders: [1024]u8 = [0 : 1024],
    folder: usize = 0,
    /* The last file result, shown in the status line. */
    notes: [96]u8 = [0 : 96],
    note: usize = 0,
    /* Mouse position, and the hovered cell or -1 off the board. */
    mx: f32 = -1.0,
    my: f32 = -1.0,
    hx: int = -1,
    hy: int = -1,
    /* Window size, and the board view: a cell's side and the board's top-left
     * corner, in window points. `fit` is the least cell side, which shows the
     * whole board in its area; zero until the first `resize`. */
    w: f32 = 0.0,
    h: f32 = 0.0,
    cell: f32 = CELL * ZOOM_START,
    fit: f32 = 0.0,
    ox: f32 = 0.0,
    oy: f32 = 0.0,
    /* The tool in use, and the selected cells' box (corners inclusive) when `sel`. */
    pick: Tool = Tool.pencil,
    sel: bool = false,
    sx0: int = 0,
    sy0: int = 0,
    sx1: int = 0,
    sy1: int = 0,
    /* The drag in progress: its anchor cell, the cell it is at, and for a move
     * how far the selection has been carried; `lift` holds the lifted blocks,
     * row by row over the box, and `lifton` which sources were on. */
    drag: Drag = Drag.none,
    ax: int = 0,
    ay: int = 0,
    bx: int = 0,
    by: int = 0,
    dx: int = 0,
    dy: int = 0,
    lift: [32 * 64]grid.Block = [grid.Block.empty : 32 * 64],
    lifton: [32 * 64]bool = [false : 32 * 64],
    /* Cell the current drag last painted, so a drag paints each cell once. */
    px: int = -1,
    py: int = -1,
}

/* A buffer that replaces the status note. */
Game.say(self): fmt.Buffer {
    return fmt.Buffer.init(self.notes[..])
}

/* Keeps what `b` wrote as the status note. */
Game.said(self, b: fmt.Buffer) {
    self.note = b.text().len
}

/* Notes that `what` failed for `name` with `err`. */
Game.failed(self, what: string, name: string, err: Error) {
    b: fmt.Buffer = self.say()
    if err.message.len > 0 {
        b.printf("%s %s: %s", what, name, err.message)
    } else {
        b.printf("%s %s: error %d", what, name, int(err.code))
    }
    self.said(b)
}

/* Finds the diagram folder beside the executable's folder, so it does not
 * depend on where the program starts. */
Game.locate(self): Error {
    exe: [1024]u8
    n: usize, err: Error = sys.executable(exe[..])
    if err != null { return err }
    end: usize = n
    for end > 0 && exe[end - 1] != '/' { end -= 1 }
    b: fmt.Buffer = fmt.Buffer.init(self.folders[..])
    b.printf("%s%s", exe[0..end], FOLDER)
    if b.dropped() > 0 { return sys.ExecutableErr.capacity }
    self.folder = b.text().len
    return null
}

/* The diagram folder's path. */
Game.where(self): string {
    return self.folders[0..self.folder]
}

/* The path of diagram `name` in `out`. */
Game.path(self, name: string, out: []u8): string {
    b: fmt.Buffer = fmt.Buffer.init(out)
    b.printf("%s/%s%s", self.where(), name, diagram.EXTENSION)
    return b.text()
}

/* The board's area: the window between the bars. */
Game.area(const self): ui.Rect {
    return ui.Rect { x = 2.0 * GAP + STRIP, y = TOP, w = self.w - 3.0 * GAP - STRIP, h = self.h - TOP - BELOW }
}

/* Keeps the board in reach: at any zoom, any cell, the corner ones too, can
 * be panned to the area's center, so the board may leave empty space of half
 * the area at either end. */
Game.clamp(self) {
    a: ui.Rect = self.area()
    wide: f32 = f32(grid.WIDTH) * self.cell
    high: f32 = f32(grid.HEIGHT) * self.cell
    mx: f32 = a.x + a.w / 2.0
    my: f32 = a.y + a.h / 2.0
    self.ox = math.min[f32](math.max[f32](self.ox, mx - wide + self.cell / 2.0), mx - self.cell / 2.0)
    self.oy = math.min[f32](math.max[f32](self.oy, my - high + self.cell / 2.0), my - self.cell / 2.0)
}

/* Follows a window of `w` x `h`, keeping the zoom and the board point at the
 * area's center; the first call centers the board. */
Game.resize(self, w: f32, h: f32) {
    if w == self.w && h == self.h { return }
    old: ui.Rect = self.area()
    bx: f32 = f32(grid.WIDTH) / 2.0
    by: f32 = f32(grid.HEIGHT) / 2.0
    if self.fit > 0.0 {
        bx = (old.x + old.w / 2.0 - self.ox) / self.cell
        by = (old.y + old.h / 2.0 - self.oy) / self.cell
    }
    self.w = w
    self.h = h
    a: ui.Rect = self.area()
    self.fit = math.max[f32](math.min[f32](a.w / f32(grid.WIDTH), a.h / f32(grid.HEIGHT)), 1.0)
    self.cell = math.max[f32](self.cell, math.min[f32](self.fit, CELL * ZOOM_MIN))
    self.ox = a.x + a.w / 2.0 - bx * self.cell
    self.oy = a.y + a.h / 2.0 - by * self.cell
    self.clamp()
}

/* Moves the board by (dx, dy) window points, as a middle-button drag does. */
Game.pan(self, dx: f32, dy: f32) {
    self.ox += dx
    self.oy += dy
    self.clamp()
}

/* Zooms by `steps` wheel steps (positive in) about window point (x, y), which
 * stays over the same spot on the board. */
Game.zoom(self, steps: f32, x: f32, y: f32) {
    want: f32 = self.cell
    if steps > 0.0 { want *= ZOOM_STEP }
    if steps < 0.0 { want /= ZOOM_STEP }
    want = math.min[f32](math.max[f32](want, math.min[f32](self.fit, CELL * ZOOM_MIN)), CELL * ZOOM_MAX)
    self.ox = x - (x - self.ox) * want / self.cell
    self.oy = y - (y - self.oy) * want / self.cell
    self.cell = want
    self.clamp()
}

/* Cell (x, y)'s rectangle on screen. */
Game.box(const self, x: int, y: int): ui.Rect {
    return ui.Rect { x = self.ox + f32(x) * self.cell, y = self.oy + f32(y) * self.cell, w = self.cell, h = self.cell }
}

/* Whether cell (x, y) shows at all in area `a`; the rest is not drawn. */
Game.shows(const self, x: int, y: int, a: ui.Rect): bool {
    box: ui.Rect = self.box(x, y)
    return box.x + box.w > a.x && box.x < a.x + a.w && box.y + box.h > a.y && box.y < a.y + a.h
}

/* The cell under window point (x, y), or (-1, -1) off the board or its area. */
Game.cell_at(const self, x: f32, y: f32): (int, int) {
    if !self.area().has(x, y) { return -1, -1 }
    fx: f32 = (x - self.ox) / self.cell
    fy: f32 = (y - self.oy) / self.cell
    if fx < 0.0 || fy < 0.0 { return -1, -1 }
    cx: int = int(fx)
    cy: int = int(fy)
    if !grid.inside(cx, cy) { return -1, -1 }
    return cx, cy
}

/* The Save-as panel, centered in the window. */
Game.panel(const self): ui.Rect {
    return ui.Rect { x = (self.w - PANEL_W) / 2.0, y = (self.h - PANEL_H) / 2.0, w = PANEL_W, h = PANEL_H }
}

Game.tick(self) {
    self.s.tick()
    self.count += 1
}

/* Switches to `phase`; leaving Run stops auto-ticking. Levels and the tick
 * count carry over, so an edit continues from where the run stopped. */
Game.switch(self, phase: Phase) {
    self.phase = phase
    if phase == Phase.run { self.deselect() }
    if phase == Phase.edit { self.auto = false }
}

/* Starts a new, unnamed diagram. */
Game.clear(self) {
    self.deselect()
    self.s = sim.Sim.init(grid.Grid {})
    self.count = 0
    self.name.len = 0
    b: fmt.Buffer = self.say()
    b.printf("new diagram")
    self.said(b)
}

/* Writes the board as the draft's name, which then becomes the diagram's. */
Game.write(self) {
    storage: [1200]u8
    bytes: [diagram.SIZE]u8
    /* A folder that exists already is fine; any real failure shows on write. */
    sys.mkdir(self.where())
    n: usize, err: Error = diagram.encode(self.s, bytes[..])
    if err == null { err = file.write(self.path(self.draft.text(), storage[..]), bytes[0..n]) }
    if err != null {
        self.failed("cannot save", self.draft.text(), err)
        return
    }
    self.name.copy(self.draft.text())
    b: fmt.Buffer = self.say()
    b.printf("saved %s", self.name.text())
    self.said(b)
}

/* Saves under the diagram's name, or asks for one. */
Game.save(self) {
    if self.name.len == 0 {
        self.ask()
        return
    }
    self.draft.copy(self.name.text())
    self.write()
}

/* Opens the Save-as box, starting from the current name. */
Game.ask(self) {
    self.draft.copy(self.name.text())
    self.mode = Mode.save_as
}

/* Opens the Open list, or closes it when it is showing. */
Game.browse(self) {
    if self.mode == Mode.open {
        self.mode = Mode.none
        return
    }
    /* A missing folder (ENOENT) just lists nothing. */
    err: Error = self.list.scan(self.where())
    if err != null && err.code != 2 { self.failed("cannot list", self.where(), err) }
    self.mode = Mode.open
}

/* Replaces the board with diagram `name`. */
Game.load(self, name: string) {
    storage: [1200]u8
    data: []u8, err: Error = file.read(self.path(name, storage[..]))
    defer mem.release[u8](&data)
    s: sim.Sim = sim.Sim {}
    if err == null { s, err = diagram.decode(data) }
    if err != null {
        self.failed("cannot open", name, err)
        return
    }
    self.deselect()
    self.s = s
    self.count = 0
    self.name.copy(name)
    b: fmt.Buffer = self.say()
    b.printf("opened %s", self.name.text())
    self.said(b)
}

/* Drops the selection. */
Game.deselect(self) {
    self.sel = false
    self.drag = Drag.none
}

/* The cell nearest window point (x, y), kept on the board. */
Game.cell_near(const self, x: f32, y: f32): (int, int) {
    fx: f32 = math.min[f32](math.max[f32]((x - self.ox) / self.cell, 0.0), f32(grid.WIDTH - 1))
    fy: f32 = math.min[f32](math.max[f32]((y - self.oy) / self.cell, 0.0), f32(grid.HEIGHT - 1))
    return int(fx), int(fy)
}

/* Whether cell (x, y) is inside the selection. */
Game.selected(const self, x: int, y: int): bool {
    return self.sel && x >= self.sx0 && x <= self.sx1 && y >= self.sy0 && y <= self.sy1
}

/* The window rectangle that covers cells (x0, y0) to (x1, y1), inclusive. */
Game.span(const self, x0: int, y0: int, x1: int, y1: int): ui.Rect {
    a: ui.Rect = self.box(x0, y0)
    b: ui.Rect = self.box(x1, y1)
    return ui.Rect { x = a.x, y = a.y, w = b.x + b.w - a.x, h = b.y + b.h - a.y }
}

/* Lifts the selected blocks off the board into `lift`, remembering which
 * sources are on, to be carried and dropped. */
Game.lift_up(self) {
    g: grid.Grid = self.s.g
    w: int = self.sx1 - self.sx0 + 1
    for y: int in self.sy0 .. self.sy1 + 1 {
        for x: int in self.sx0 .. self.sx1 + 1 {
            i: int = (y - self.sy0) * w + x - self.sx0
            b: grid.Block = g.get(x, y)
            self.lift[i] = b
            self.lifton[i] = b == grid.Block.source && self.s.level(x, y) == sim.Level.high
            g.remove(x, y)
        }
    }
    self.s = sim.Sim.init(g)
}

/* Puts the lifted blocks down `dx`, `dy` cells over: they replace what is
 * there, and empty cells of the selection leave the board as it is. */
Game.drop(self) {
    g: grid.Grid = self.s.g
    w: int = self.sx1 - self.sx0 + 1
    for y: int in self.sy0 .. self.sy1 + 1 {
        for x: int in self.sx0 .. self.sx1 + 1 {
            b: grid.Block = self.lift[(y - self.sy0) * w + x - self.sx0]
            if b != grid.Block.empty { g.place(x + self.dx, y + self.dy, b) }
        }
    }
    self.s = sim.Sim.init(g)
    for y: int in self.sy0 .. self.sy1 + 1 {
        for x: int in self.sx0 .. self.sx1 + 1 {
            if self.lifton[(y - self.sy0) * w + x - self.sx0] { self.s.toggle(x + self.dx, y + self.dy, true) }
        }
    }
    self.sx0 += self.dx
    self.sx1 += self.dx
    self.sy0 += self.dy
    self.sy1 += self.dy
    self.drag = Drag.none
}

/* Removes every selected block. */
Game.erase(self) {
    if !self.sel { return }
    g: grid.Grid = self.s.g
    for y: int in self.sy0 .. self.sy1 + 1 {
        for x: int in self.sx0 .. self.sx1 + 1 { g.remove(x, y) }
    }
    self.s = sim.Sim.init(g)
    self.deselect()
}

/* A left press at window point (x, y) with the select tool: inside the
 * selection it picks the blocks up, elsewhere it starts a new box. */
Game.select_press(self, x: f32, y: f32) {
    cx: int, cy: int = self.cell_at(x, y)
    if cx < 0 {
        self.deselect()
        return
    }
    self.ax = cx
    self.ay = cy
    self.bx = cx
    self.by = cy
    if self.selected(cx, cy) {
        self.drag = Drag.move
        self.dx = 0
        self.dy = 0
        self.lift_up()
    } else {
        self.sel = false
        self.drag = Drag.box
    }
}

/* The pointer moved to window point (x, y) during a select-tool drag. */
Game.select_drag(self, x: f32, y: f32) {
    cx: int, cy: int = self.cell_near(x, y)
    if self.drag == Drag.box {
        self.bx = cx
        self.by = cy
    }
    if self.drag == Drag.move {
        /* The selection stays on the board. */
        self.dx = math.min[int](math.max[int](cx - self.ax, -self.sx0), grid.WIDTH - 1 - self.sx1)
        self.dy = math.min[int](math.max[int](cy - self.ay, -self.sy0), grid.HEIGHT - 1 - self.sy1)
    }
}

/* The left button went up: a box becomes the selection (a click on an empty
 * cell selects nothing), a move drops its blocks. */
Game.select_release(self) {
    if self.drag == Drag.move { self.drop() }
    if self.drag == Drag.box {
        self.sx0 = math.min[int](self.ax, self.bx)
        self.sx1 = math.max[int](self.ax, self.bx)
        self.sy0 = math.min[int](self.ay, self.by)
        self.sy1 = math.max[int](self.ay, self.by)
        lone: bool = self.ax == self.bx && self.ay == self.by
        self.sel = !lone || self.s.g.get(self.ax, self.ay) != grid.Block.empty
        self.drag = Drag.none
    }
}

/* A press or drag over (x, y) with `button`; `press` is true on the click. */
Game.paint(self, x: int, y: int, button: MouseButton, press: bool) {
    if x < 0 || (!press && x == self.px && y == self.py) { return }
    self.px = x
    self.py = y
    if self.phase == Phase.run {
        /* Running, the layout is fixed: a left click only flips a source. */
        if press && button == MouseButton.left && self.s.g.get(x, y) == grid.Block.source {
            self.s.toggle(x, y, self.s.level(x, y) != sim.Level.high)
        }
        return
    }
    if button == MouseButton.right {
        self.s.place(x, y, grid.Block.empty)
        return
    }
    if button != MouseButton.left { return }
    if self.s.g.get(x, y) == self.block { return }
    self.s.place(x, y, self.block)
}

/* Switches to tool `pick`, leaving no selection behind. */
Game.use(self, pick: Tool) {
    if self.phase != Phase.edit { return }
    self.pick = pick
    self.deselect()
}

/* The panels: the toolbar and the block row across the top, the sidebar down
 * the board's left, and the footer. */
Game.head(const self): ui.Rect {
    return ui.Rect { x = GAP, y = GAP, w = self.w - 2.0 * GAP, h = BAR }
}

Game.blocks(const self): ui.Rect {
    return ui.Rect { x = GAP, y = 2.0 * GAP + BAR, w = self.w - 2.0 * GAP, h = BAR }
}

Game.side(const self): ui.Rect {
    return ui.Rect { x = GAP, y = TOP, w = STRIP, h = self.h - TOP - BELOW }
}

Game.foot(const self): ui.Rect {
    return ui.Rect { x = GAP, y = self.h - GAP - FOOT, w = self.w - 2.0 * GAP, h = FOOT }
}

/* A press at window point (x, y). True when the bar or a panel took it, so it
 * paints nothing. */
Game.click(self, x: f32, y: f32, button: MouseButton): bool {
    if self.mode == Mode.save_as || self.drag == Drag.move { return true }
    if self.mode == Mode.open {
        self.mode = Mode.none
        for i: usize in 0 .. self.list.count {
            if row(i).has(x, y) && button == MouseButton.left {
                self.load(self.list.names[i])
            }
        }
        return true
    }
    if self.side().has(x, y) {
        if button != MouseButton.left || self.phase != Phase.edit { return true }
        for i: usize in 0 .. members(Tool).len {
            each: Tool = members(Tool)[i]
            if strip_at(each).has(x, y) { self.use(each) }
        }
        return true
    }
    if y >= TOP { return false }
    if y >= 2.0 * GAP + BAR {
        if button != MouseButton.left || self.phase != Phase.edit { return true }
        for i: usize in 1 .. members(grid.Block).len {
            each: grid.Block = members(grid.Block)[i]
            if tool(each, self.w).has(x, y) {
                self.use(Tool.pencil)
                self.block = each
            }
        }
        return true
    }
    if button != MouseButton.left { return true }
    if place(Button.new).has(x, y) { self.clear() }
    if place(Button.open).has(x, y) { self.browse() }
    if place(Button.save).has(x, y) { self.save() }
    if place(Button.save_as).has(x, y) { self.ask() }
    if place(Button.edit).has(x, y) { self.switch(Phase.edit) }
    if place(Button.run).has(x, y) { self.switch(Phase.run) }
    if place(Button.step).has(x, y) && self.phase == Phase.run { self.tick() }
    if place(Button.auto).has(x, y) && self.phase == Phase.run { self.auto = !self.auto }
    /* The zoom buttons zoom about the board area's center. */
    a: ui.Rect = self.area()
    if place(Button.zoom_out).has(x, y) { self.zoom(-1.0, a.x + a.w / 2.0, a.y + a.h / 2.0) }
    if place(Button.zoom_in).has(x, y) { self.zoom(1.0, a.x + a.w / 2.0, a.y + a.h / 2.0) }
    return true
}

/* A key typed into the Save-as box. */
Game.type(self, e: KeyboardEvent) {
    k: u32 = u32(e.key)
    shift: bool = (e.mod & KMOD_SHIFT) != 0
    if e.key == Keycode.escape {
        self.mode = Mode.none
    } else if e.key == Keycode.enter {
        if self.draft.len == 0 { return }
        self.mode = Mode.none
        self.write()
    } else if e.key == Keycode.backspace {
        self.draft.back()
    } else if k == KEY_DELETE {
        self.draft.forward()
    } else if e.key == Keycode.left {
        if self.draft.at > 0 { self.draft.at -= 1 }
    } else if e.key == Keycode.right {
        if self.draft.at < self.draft.len { self.draft.at += 1 }
    } else if k == KEY_HOME {
        self.draft.at = 0
    } else if k == KEY_END {
        self.draft.at = self.draft.len
    } else if k == '-' && shift {
        self.draft.add('_')
    } else if !shift && ((k >= 'a' && k <= 'z') || (k >= '0' && k <= '9') || k == '-') {
        self.draft.add(u8(k))
    }
}

/* A key press; false to quit. A held key repeats only in the Save-as box. */
Game.key(self, e: KeyboardEvent): bool {
    if self.mode == Mode.save_as {
        self.type(e)
        return true
    }
    if self.drag == Drag.move { return true }
    if (e.mod & KMOD_GUI) != 0 && e.key == Keycode.q { return false }
    if e.repeat { return true }
    if (e.mod & KMOD_CTRL) != 0 {
        if e.key == Keycode.s { self.save() }
        if e.key == Keycode.o { self.browse() }
        return true
    }
    if e.key == Keycode.escape {
        if self.mode != Mode.none {
            self.mode = Mode.none
        } else {
            self.deselect()
        }
        return true
    }
    k: u32 = u32(e.key)
    if k == '1' { self.use(Tool.pencil) }
    if k == '2' { self.use(Tool.select) }
    if (e.key == Keycode.backspace || k == KEY_DELETE) && self.pick == Tool.select && self.mode == Mode.none { self.erase() }
    if k == KEY_F1 { self.switch(Phase.edit) }
    if k == KEY_F2 { self.switch(Phase.run) }
    if e.key == Keycode.space && self.phase == Phase.run { self.auto = !self.auto }
    for i: usize in 1 .. members(grid.Block).len {
        each: grid.Block = members(grid.Block)[i]
        if k == u32(LETTER[each]) {
            self.use(Tool.pencil)
            self.block = each
        }
    }
    return true
}

Game.draw_board(self, canvas: *ui.Canvas, r: Renderer) {
    a: ui.Rect = self.area()
    /* The board's panel; nothing below is drawn outside it. */
    canvas.fill(a, Color.hex(PANEL))
    canvas.flush(r)
    r.clip(i32(a.x), i32(a.y), i32(a.w), i32(a.h))
    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            if !self.shows(x, y, a) { continue }
            b: grid.Block = self.s.g.get(x, y)
            /* Edit shows only how the board is built: no levels. */
            v: sim.Level = sim.Level.low
            if self.phase == Phase.run { v = self.s.level(x, y) }
            rgb: u32 = LOW[b]
            if v == sim.Level.high { rgb = HIGH[b] }
            if v == sim.Level.error && b != grid.Block.empty { rgb = ERROR }
            /* Blocks fill their cell; empty cells keep a gap so the grid shows. */
            inset: f32 = 0.0
            if b == grid.Block.empty { inset = 1.0 }
            box: ui.Rect = self.box(x, y)
            box = ui.Rect { x = box.x + inset, y = box.y + inset, w = box.w - 2.0 * inset, h = box.h - 2.0 * inset }
            canvas.fill(box, Color.hex(rgb))
        }
    }
    if self.drag == Drag.move { self.draw_lifted(canvas, r, false) }
    if self.mode == Mode.none && self.phase == Phase.edit && self.pick == Tool.pencil && self.hx >= 0 {
        box: ui.Rect = self.box(self.hx, self.hy)
        canvas.outline(box, 2.0, Color.hex(0xffffff))
    }
    /* The box being drawn, or the selection, carried along while it moves. */
    if self.drag == Drag.box {
        canvas.outline(self.span(math.min[int](self.ax, self.bx), math.min[int](self.ay, self.by), math.max[int](self.ax, self.bx), math.max[int](self.ay, self.by)), 2.0, Color.hex(SELECT))
    }
    if self.sel && self.drag != Drag.box {
        canvas.outline(self.span(self.sx0 + self.dx, self.sy0 + self.dy, self.sx1 + self.dx, self.sy1 + self.dy), 2.0, Color.hex(SELECT))
    }
    canvas.flush(r)

    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            b: grid.Block = self.s.g.get(x, y)
            if b == grid.Block.empty || !self.shows(x, y, a) { continue }
            level: sim.Level = sim.Level.low
            if self.phase == Phase.run { level = self.s.level(x, y) }
            ink: u32 = icon_ink(b, level)
            /* Each icon sits inside its cell with a margin. */
            cell: ui.Rect = self.box(x, y)
            m: f32 = cell.w * 0.12
            box: ui.Rect = ui.Rect { x = cell.x + m, y = cell.y + m, w = cell.w - 2.0 * m, h = cell.h - 2.0 * m }
            canvas.icon(r, BLOCK_ICON[b], box, Color.hex(ink))
        }
    }
    if self.drag == Drag.move { self.draw_lifted(canvas, r, true) }
    canvas.flush(r)
    r.unclip()
}

/* The blocks being carried, `icons` or their fills, at the drag's offset. */
Game.draw_lifted(self, canvas: *ui.Canvas, r: Renderer, icons: bool) {
    w: int = self.sx1 - self.sx0 + 1
    for y: int in self.sy0 .. self.sy1 + 1 {
        for x: int in self.sx0 .. self.sx1 + 1 {
            b: grid.Block = self.lift[(y - self.sy0) * w + x - self.sx0]
            if b == grid.Block.empty { continue }
            cell: ui.Rect = self.box(x + self.dx, y + self.dy)
            if !icons {
                canvas.fill(cell, Color.hex(LOW[b]))
            } else {
                m: f32 = cell.w * 0.12
                canvas.icon(r, BLOCK_ICON[b], ui.Rect { x = cell.x + m, y = cell.y + m, w = cell.w - 2.0 * m, h = cell.h - 2.0 * m }, Color.hex(icon_ink(b, sim.Level.low)))
            }
        }
    }
}

/* Whether `button` is unusable in the current phase: Step and Auto only work
 * in Run. */
Game.disabled(const self, button: Button): bool {
    return self.phase == Phase.edit && (button == Button.step || button == Button.auto)
}

Game.draw_bars(self, canvas: *ui.Canvas, r: Renderer) {
    foot: ui.Rect = self.foot()
    canvas.fill(self.head(), Color.hex(CHROME))
    canvas.fill(self.blocks(), Color.hex(CHROME))
    /* Block buttons: in Edit each in its block's low color, the selected one
     * lit; in Run all disabled. */
    for i: usize in 1 .. members(grid.Block).len {
        each: grid.Block = members(grid.Block)[i]
        rgb: u32 = DISABLED
        if self.phase == Phase.edit {
            rgb = LOW[each]
            if each == self.block { rgb = HIGH[each] }
        }
        canvas.fill(tool(each, self.w), Color.hex(rgb))
        level: sim.Level = sim.Level.low
        if self.phase == Phase.edit && each == self.block { level = sim.Level.high }
        canvas.icon(r, BLOCK_ICON[each], tool(each, self.w), Color.hex(icon_ink(each, level)))
    }
    canvas.fill(foot, Color.hex(CHROME))
    canvas.fill(self.side(), Color.hex(CHROME))
    for i: usize in 0 .. members(Tool).len {
        each: Tool = members(Tool)[i]
        rgb: u32 = DISABLED
        ink: u32 = DIM
        if self.phase == Phase.edit {
            rgb = BUTTON
            ink = INK
            if strip_at(each).has(self.mx, self.my) { rgb = ACTIVE }
            if each == self.pick { rgb = ACTIVE }
        }
        canvas.fill(strip_at(each), Color.hex(rgb))
        canvas.icon(r, STRIP_ICON[each], strip_at(each), Color.hex(ink))
    }
    for i: usize in 0 .. members(Button).len {
        each: Button = members(Button)[i]
        rgb: u32 = BUTTON
        if place(each).has(self.mx, self.my) || (each == Button.open && self.mode == Mode.open) {
            rgb = ACTIVE
        }
        if (each == Button.edit && self.phase == Phase.edit) || (each == Button.run && self.phase == Phase.run) ||
            (each == Button.auto && self.auto) {
            rgb = ACTIVE
        }
        if self.disabled(each) { rgb = DISABLED }
        canvas.fill(place(each), Color.hex(rgb))
        ink: u32 = INK
        if self.disabled(each) { ink = DIM }
        at: ui.Rect = place(each)
        canvas.icon(r, ICON[each], ui.Rect { x = at.x + PAD, y = at.y + (at.h - GLYPH_SIDE) / 2.0, w = GLYPH_SIDE, h = GLYPH_SIDE }, Color.hex(ink))
    }
    canvas.flush(r)

    for i: usize in 0 .. members(Button).len {
        each: Button = members(Button)[i]
        ink: u32 = INK
        if self.disabled(each) { ink = DIM }
        ui.left(r, place(each), PAD + GLYPH_SIDE + LABEL_GAP, LABEL[each], ink)
    }
    title: string = self.name.text()
    if title.len == 0 { title = "untitled" }
    storage: [128]u8
    status: fmt.Buffer = fmt.Buffer.init(storage[..])
    if self.phase == Phase.edit {
        if self.pick == Tool.select {
            status.printf("select")
        } else {
            status.printf("%s", NAME[self.block])
        }
    } else {
        status.printf("tick %d", self.count)
    }
    ui.left(r, foot, 8.0, status.text(), INK)
    /* The hovered block's name, in either phase. */
    if self.hx >= 0 {
        here: grid.Block = self.s.g.get(self.hx, self.hy)
        if here != grid.Block.empty { ui.center(r, foot, NAME[here], INK) }
    }
    bar: ui.Rect = self.head()
    ui.left(r, bar, bar.w - 8.0 - ui.GLYPH * f32(title.len), title, INK)
    note: string = self.notes[0..self.note]
    ui.left(r, foot, foot.w - 8.0 - ui.GLYPH * f32(note.len), note, DIM)
}

Game.draw_list(self, canvas: *ui.Canvas, r: Renderer) {
    rows: usize = self.list.count
    if rows == 0 { rows = 1 }
    for i: usize in 0 .. rows {
        rgb: u32 = BUTTON
        if i < self.list.count && row(i).has(self.mx, self.my) { rgb = ACTIVE }
        canvas.fill(row(i), Color.hex(rgb))
    }
    canvas.flush(r)

    if self.list.count == 0 { ui.left(r, row(0), 8.0, "no diagrams in diagram/", DIM) }
    for i: usize in 0 .. self.list.count {
        ui.left(r, row(i), 8.0, self.list.names[i], INK)
    }
}

Game.draw_ask(self, canvas: *ui.Canvas, r: Renderer) {
    panel: ui.Rect = self.panel()
    field: ui.Rect = ui.Rect { x = panel.x + 12.0, y = panel.y + 32.0, w = panel.w - 24.0, h = 28.0 }
    canvas.fill(panel, Color.hex(BUTTON))
    canvas.outline(panel, 1.0, Color.hex(DIM))
    canvas.fill(field, Color.hex(CHROME))
    /* The cursor: a bar before byte `at`. */
    caret: f32 = field.x + 8.0 + f32(self.draft.at) * ui.GLYPH
    canvas.fill(ui.Rect { x = caret - 1.0, y = field.y + 6.0, w = 2.0, h = field.h - 12.0 }, Color.hex(INK))
    canvas.flush(r)

    title: ui.Rect = ui.Rect { x = panel.x, y = panel.y + 4.0, w = panel.w, h = 24.0 }
    ui.left(r, title, 12.0, "Save as     Enter saves, Esc cancels", INK)
    storage: [64]u8
    b: fmt.Buffer = fmt.Buffer.init(storage[..])
    b.printf("%s", self.draft.text())
    ui.left(r, field, 8.0, b.text(), INK)
    /* The extension, dimmed: it is added, not typed. */
    ui.left(r, field, 8.0 + ui.GLYPH * f32(self.draft.len), diagram.EXTENSION, DIM)
}

Game.draw(self, canvas: *ui.Canvas, r: Renderer) {
    r.color(Color.hex(WINDOW))
    r.clear()
    self.draw_board(canvas, r)
    self.draw_bars(canvas, r)
    if self.mode == Mode.open { self.draw_list(canvas, r) }
    if self.mode == Mode.save_as { self.draw_ask(canvas, r) }
    r.present()
}

fail(context: string): int {
    fmt.printf("%s: %s\n", context, error())
    return 1
}

main(): int {
    if !init(InitFlags { video = 1 }) { return fail("SDL_Init") }
    defer quit()

    window: Window = Window.new("logibox", i32(WIDTH), i32(TOP + 16.0 * CELL + BELOW), WindowFlags { resizable = 1 })
    defer window.wipe()
    if !window.ok() { return fail("SDL_CreateWindow") }
    window.maximize()

    renderer: Renderer = Renderer.new(window)
    defer renderer.wipe()
    if !renderer.ok() { return fail("SDL_CreateRenderer") }
    renderer.vsync(1)
    /* Icon edges fade out through vertex alpha. */
    renderer.blend(BLEND_ALPHA)

    /* The arrow, and the closed hand a middle-button drag shows while it pans. */
    arrow: Cursor = Cursor.new(SystemCursor.default)
    defer arrow.wipe()
    grab: Cursor = Cursor.new(SystemCursor.move)
    defer grab.wipe()

    game: Game = Game { s = sim.Sim.init(grid.Grid {}) }
    if game.locate() != null {
        fmt.println("logibox: cannot find the executable's path")
        return 1
    }
    canvas: ui.Canvas = ui.Canvas {}
    held: MouseButton = MouseButton.none
    last: u64 = ticks()
    running: bool = true
    for running {
        event: Event
        for event.poll() {
            if event.type == EventType.quit || event.type == EventType.window_close_requested {
                running = false
            }
            key: KeyboardEvent, is_key: bool = event.key()
            if is_key && key.down {
                running = running && game.key(key)
            }
            b: MouseButtonEvent, is_button: bool = event.mouse_button()
            if is_button {
                if b.down {
                    clicked: bool = game.click(b.x, b.y, b.button)
                    if !clicked {
                        held = b.button
                        x: int, y: int = game.cell_at(b.x, b.y)
                        if held == MouseButton.middle {
                            cursor(grab)
                        } else if game.pick == Tool.select && game.phase == Phase.edit {
                            if held == MouseButton.left { game.select_press(b.x, b.y) }
                        } else {
                            game.paint(x, y, held, true)
                        }
                    }
                } else if b.button == held {
                    if held == MouseButton.middle { cursor(arrow) }
                    if held == MouseButton.left { game.select_release() }
                    held = MouseButton.none
                    game.px = -1
                    game.py = -1
                }
            }
            m: MouseMotionEvent, is_motion: bool = event.mouse_motion()
            if is_motion {
                /* A middle-button drag pans the board, in either phase. */
                if held == MouseButton.middle { game.pan(m.xrel, m.yrel) }
                x: int, y: int = game.cell_at(m.x, m.y)
                game.mx = m.x
                game.my = m.y
                game.hx = x
                game.hy = y
                if held == MouseButton.left && game.drag != Drag.none { game.select_drag(m.x, m.y) }
                if held != MouseButton.none && held != MouseButton.middle && game.drag == Drag.none && game.pick == Tool.pencil {
                    game.paint(x, y, held, false)
                }
            }
            /* The wheel zooms the board about the pointer, in either phase. */
            wh: MouseWheelEvent, is_wheel: bool = event.mouse_wheel()
            if is_wheel && game.mode == Mode.none {
                game.zoom(wh.y, wh.mouse_x, wh.mouse_y)
                x: int, y: int = game.cell_at(wh.mouse_x, wh.mouse_y)
                game.hx = x
                game.hy = y
            }
        }
        /* The window may be resized or made full screen. */
        rw: i32, rh: i32, sized: bool = renderer.size()
        if sized { game.resize(f32(rw), f32(rh)) }
        now: u64 = ticks()
        if game.auto && now - last >= AUTO_MS {
            game.tick()
            last = now
        }
        if !game.auto { last = now }
        game.draw(&canvas, renderer)
    }
    return 0
}
