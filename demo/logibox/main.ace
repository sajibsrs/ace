/* logibox: a logic-gate sandbox: square blocks on a grid, in an SDL3 window.
 *
 * Build and run from this directory (Homebrew SDL3 on Apple arm64):
 *   ace pkg run
 *
 * A source feeds a gate's input pin (I); the gate's output pin (O) feeds the
 * next input pin or a light. Each connects by touching, or through wire when
 * apart.
 *
 * Edit (1) builds the board: left-click places the selected block (drag to
 * paint), right-click (or drag) removes. Run (2) simulates it: left-click flips
 * a source, space toggles auto-ticking, and Step ticks once. Letters select a
 * block: s source, w wire, i input pin, o output pin, a AND, r OR, n NOT,
 * l light. Escape quits.
 *
 * Diagrams live in diagram/ as .lgbx files, relative to where it runs. The bar
 * has New, Open (a list of diagram/), Save, and Save as (a name box: a-z, 0-9,
 * - and _; Enter saves, Escape cancels). Ctrl+S saves and Ctrl+O opens.
 */

import file
import fmt
import mem
import sort
import str
import sys
import (
    init, quit, error, ticks, Window, Renderer, Event, Color, InitFlags, WindowFlags,
    EventType, Keycode, MouseButton, MouseButtonEvent, MouseMotionEvent, KeyboardEvent,
) from sdl
import grid: "./grid.ace"
import sim: "./sim.ace"
import diagram: "./diagram.ace"
import ui: "./ui.ace"

CELL: const f32 = 40.0
BAR: const f32 = 28.0
/* The bar and, under it, the block row; the board starts below both. */
TOP: const f32 = 2.0 * BAR
FOOT: const f32 = 24.0
WIDTH: const f32 = 16.0 * 40.0
AUTO_MS: const u64 = 250

/* Where diagrams are listed, read and written, relative to the folder that
 * holds the executable's build/ folder. */
FOLDER: const string = "../diagram"
/* Longest diagram name, without the extension. */
NAME_MAX: const usize = 32
/* Most diagrams the Open list shows. */
LIST_MAX: const usize = 24
ROW: const f32 = 20.0

/* SDL keycodes the binding leaves unnamed. */
KEY_DELETE: const u32 = 0x7f
KEY_HOME: const u32 = 0x4000_004a
KEY_END: const u32 = 0x4000_004d

/* SDL_KMOD_SHIFT and SDL_KMOD_CTRL: either side's key. */
KMOD_SHIFT: const u16 = 0x0003
KMOD_CTRL: const u16 = 0x00c0

NAME: [grid.Block]string = [
    grid.Block.empty = "empty",
    grid.Block.source = "source",
    grid.Block.wire = "wire",
    grid.Block.input = "input pin",
    grid.Block.output = "output pin",
    grid.Block.and = "AND",
    grid.Block.or = "OR",
    grid.Block.not = "NOT",
    grid.Block.light = "light",
]

/* Low and high colors of each block; any block on an error is ERROR. */
LOW: [grid.Block]u32 = [
    grid.Block.empty = 0x202428,
    grid.Block.source = 0x5a3a12,
    grid.Block.wire = 0x303030,
    grid.Block.input = 0x2a3a2a,
    grid.Block.output = 0x3a2a4a,
    grid.Block.and = 0x1e3a5a,
    grid.Block.or = 0x1e4a3a,
    grid.Block.not = 0x4a3a1e,
    grid.Block.light = 0x4a1818,
]
HIGH: [grid.Block]u32 = [
    grid.Block.empty = 0x202428,
    grid.Block.source = 0xc07a1c,
    grid.Block.wire = 0xb4b48c,
    grid.Block.input = 0x6f9446,
    grid.Block.output = 0x9a6aa6,
    grid.Block.and = 0x3f82b8,
    grid.Block.or = 0x3aa877,
    grid.Block.not = 0xc0a03a,
    grid.Block.light = 0xc03434,
]
ERROR: const u32 = 0xb030b0

/* Bar and panel colors. */
CHROME: const u32 = 0x181b1f
BUTTON: const u32 = 0x2c3238
ACTIVE: const u32 = 0x3d4f63
INK: const u32 = 0xdddddd
DIM: const u32 = 0x888888

/* What the bar has open over the board: nothing, the Open list, or the
 * Save-as box. */
Mode: enum u8 { none, open, save_as }

/* Whether the board is being built (blocks placed, no ticks) or simulated
 * (sources flip, ticks run). */
Phase: enum u8 { edit, run }

/* The bar's buttons, left to right. */
Button: enum u8 { new, open, save, save_as, edit, run, step }

LABEL: [Button]string = [
    Button.new = "New",
    Button.open = "Open",
    Button.save = "Save",
    Button.save_as = "Save as",
    Button.edit = "Edit",
    Button.run = "Run",
    Button.step = "Step",
]

/* The block each letter key selects, lowercase as SDL reports it. */
LETTER: [grid.Block]u8 = [
    grid.Block.empty = 0,
    grid.Block.source = 's',
    grid.Block.wire = 'w',
    grid.Block.input = 'i',
    grid.Block.output = 'o',
    grid.Block.and = 'a',
    grid.Block.or = 'r',
    grid.Block.not = 'n',
    grid.Block.light = 'l',
]

/* The bar rectangle of `button`: each fits its label, 6 pixels apart. */
place(button: Button): ui.Rect {
    x: f32 = 6.0
    for i: usize in 0 .. members(Button).len {
        each: Button = members(Button)[i]
        w: f32 = f32(LABEL[each].len) * ui.GLYPH + 16.0
        /* A gap sets the phase buttons apart from the file buttons. */
        if each == Button.edit { x += 18.0 }
        if each == button { return ui.Rect { x = x, y = 4.0, w = w, h = BAR - 8.0 } }
        x += w + 6.0
    }
    return ui.Rect {}
}

/* The block row's button for `block`: eight equal slots across the window. */
TOOL_W: const f32 = (WIDTH - 6.0) / 8.0

tool(block: grid.Block): ui.Rect {
    i: f32 = f32(int(block) - 1)
    return ui.Rect { x = 6.0 + i * TOOL_W, y = BAR, w = TOOL_W - 6.0, h = BAR - 4.0 }
}

/* The block row's labels. */
TOOL: [grid.Block]string = [
    grid.Block.empty = "",
    grid.Block.source = "Source",
    grid.Block.wire = "Wire",
    grid.Block.input = "Input",
    grid.Block.output = "Output",
    grid.Block.and = "AND",
    grid.Block.or = "OR",
    grid.Block.not = "NOT",
    grid.Block.light = "Light",
]

/* Row `i` of the Open list. */
row(i: usize): ui.Rect {
    at: ui.Rect = place(Button.open)
    return ui.Rect { x = at.x, y = BAR + f32(i) * ROW, w = 280.0, h = ROW }
}

/* The Save-as panel, centered on the board. */
PANEL: const ui.Rect = ui.Rect { x = 160.0, y = 280.0, w = 320.0, h = 72.0 }

/* The cell under window point (x, y), or (-1, -1). */
cell_at(x: f32, y: f32): (int, int) {
    if x < 0.0 || y < TOP { return -1, -1 }
    cx: int = int(x / CELL)
    cy: int = int((y - TOP) / CELL)
    if !grid.inside(cx, cy) { return -1, -1 }
    return cx, cy
}

before(a: string, b: string): bool {
    return str.compare(a, b) < 0
}

/* A name typed or chosen for a diagram, without folder or extension, with
 * the cursor before byte `at`. */
Name: struct {
    bytes: [32]u8 = [0 : 32],
    len: usize = 0,
    at: usize = 0,
}

Name.text(self): string {
    return self.bytes[0..self.len]
}

/* Inserts `c` at the cursor and moves past it. */
Name.add(self, c: u8) {
    if self.len == NAME_MAX { return }
    for i: usize = self.len; i > self.at; i -= 1 { self.bytes[i] = self.bytes[i - 1] }
    self.bytes[self.at] = c
    self.len += 1
    self.at += 1
}

/* Removes the byte at `i`, before the cursor or after it. */
Name.cut(self, i: usize) {
    for j: usize in i .. self.len - 1 { self.bytes[j] = self.bytes[j + 1] }
    self.len -= 1
    if self.at > i { self.at -= 1 }
}

/* Backspace: removes the byte before the cursor. */
Name.back(self) {
    if self.at > 0 { self.cut(self.at - 1) }
}

/* Delete: removes the byte after the cursor. */
Name.forward(self) {
    if self.at < self.len { self.cut(self.at) }
}

/* Replaces the name with `text`, the cursor at its end. */
Name.copy(self, text: string) {
    self.len = 0
    self.at = 0
    for i: usize in 0 .. text.len { self.add(text[i]) }
}

/* The diagrams in a folder, by name without the extension, sorted. */
Listing: struct {
    pool: [24 * 32]u8 = [0 : 24 * 32],
    names: [24]string = ["" : 24],
    count: usize = 0,
}

/* Rereads `folder`; a missing folder lists nothing. The names view the pool,
 * so a Listing stays where it was scanned. */
Listing.scan(self, folder: string): Error {
    self.count = 0
    dir: sys.Dir, err: Error = sys.opendir(folder)
    defer sys.closedir(&dir)
    if err != null { return err }

    entry: [256]u8
    used: usize = 0
    for self.count < LIST_MAX {
        n: usize, kind: sys.FileType, done: bool, rerr: Error = sys.readdir(&dir, entry[..])
        if rerr != null { return rerr }
        if done { break }
        if kind != sys.FileType.regular { continue }
        stem: string, ok: bool = str.trim(entry[0..n], diagram.EXTENSION, true)
        if !ok || stem.len == 0 || stem.len > NAME_MAX { continue }
        for i: usize in 0 .. stem.len { self.pool[used + i] = stem[i] }
        self.names[self.count] = self.pool[used .. used + stem.len]
        used += stem.len
        self.count += 1
    }
    sort.unstable[string](self.names[0..self.count], before)
    return null
}

/* The editor: the simulation, what the player has selected, and the file. */
Game: struct {
    s: sim.Sim = sim.Sim {},
    block: grid.Block = grid.Block.wire,
    auto: bool = false,
    count: int = 0,
    mode: Mode = Mode.none,
    phase: Phase = Phase.edit,
    /* The open diagram's name; empty until it is saved or opened. */
    name: Name = Name {},
    /* The name being typed in the Save-as box. */
    draft: Name = Name {},
    list: Listing = Listing {},
    /* The diagram folder's path, from `locate`. */
    folders: [1024]u8 = [0 : 1024],
    folder: usize = 0,
    /* The last file result, shown in the status line. */
    notes: [96]u8 = [0 : 96],
    note: usize = 0,
    /* Mouse position, and the hovered cell or -1 off the board. */
    mx: f32 = -1.0,
    my: f32 = -1.0,
    hx: int = -1,
    hy: int = -1,
    /* Cell the current drag last painted, so a drag paints each cell once. */
    px: int = -1,
    py: int = -1,
}

/* A buffer that replaces the status note. */
Game.say(self): fmt.Buffer {
    return fmt.Buffer.init(self.notes[..])
}

/* Keeps what `b` wrote as the status note. */
Game.said(self, b: fmt.Buffer) {
    self.note = b.text().len
}

/* Notes that `what` failed for `name` with `err`. */
Game.failed(self, what: string, name: string, err: Error) {
    b: fmt.Buffer = self.say()
    if err.message.len > 0 {
        b.printf("%s %s: %s", what, name, err.message)
    } else {
        b.printf("%s %s: error %d", what, name, int(err.code))
    }
    self.said(b)
}

/* Finds the diagram folder beside the executable's folder, so it does not
 * depend on where the program starts. */
Game.locate(self): Error {
    exe: [1024]u8
    n: usize, err: Error = sys.executable(exe[..])
    if err != null { return err }
    end: usize = n
    for end > 0 && exe[end - 1] != '/' { end -= 1 }
    b: fmt.Buffer = fmt.Buffer.init(self.folders[..])
    b.printf("%s%s", exe[0..end], FOLDER)
    if b.dropped() > 0 { return sys.ExecutableErr.capacity }
    self.folder = b.text().len
    return null
}

/* The diagram folder's path. */
Game.where(self): string {
    return self.folders[0..self.folder]
}

/* The path of diagram `name` in `out`. */
Game.path(self, name: string, out: []u8): string {
    b: fmt.Buffer = fmt.Buffer.init(out)
    b.printf("%s/%s%s", self.where(), name, diagram.EXTENSION)
    return b.text()
}

Game.tick(self) {
    self.s.tick()
    self.count += 1
}

/* Switches to `phase`; leaving Run stops auto-ticking. Levels and the tick
 * count carry over, so an edit continues from where the run stopped. */
Game.switch(self, phase: Phase) {
    self.phase = phase
    if phase == Phase.edit { self.auto = false }
}

/* Starts a new, unnamed diagram. */
Game.clear(self) {
    self.s = sim.Sim.init(grid.Grid {})
    self.count = 0
    self.name.len = 0
    b: fmt.Buffer = self.say()
    b.printf("new diagram")
    self.said(b)
}

/* Writes the board as the draft's name, which then becomes the diagram's. */
Game.write(self) {
    storage: [1200]u8
    bytes: [diagram.SIZE]u8
    /* A folder that exists already is fine; any real failure shows on write. */
    sys.mkdir(self.where())
    n: usize, err: Error = diagram.encode(self.s, bytes[..])
    if err == null { err = file.write(self.path(self.draft.text(), storage[..]), bytes[0..n]) }
    if err != null {
        self.failed("cannot save", self.draft.text(), err)
        return
    }
    self.name.copy(self.draft.text())
    b: fmt.Buffer = self.say()
    b.printf("saved %s", self.name.text())
    self.said(b)
}

/* Saves under the diagram's name, or asks for one. */
Game.save(self) {
    if self.name.len == 0 {
        self.ask()
        return
    }
    self.draft.copy(self.name.text())
    self.write()
}

/* Opens the Save-as box, starting from the current name. */
Game.ask(self) {
    self.draft.copy(self.name.text())
    self.mode = Mode.save_as
}

/* Opens the Open list, or closes it when it is showing. */
Game.browse(self) {
    if self.mode == Mode.open {
        self.mode = Mode.none
        return
    }
    /* A missing folder (ENOENT) just lists nothing. */
    err: Error = self.list.scan(self.where())
    if err != null && err.code != 2 { self.failed("cannot list", self.where(), err) }
    self.mode = Mode.open
}

/* Replaces the board with diagram `name`. */
Game.load(self, name: string) {
    storage: [1200]u8
    data: []u8, err: Error = file.read(self.path(name, storage[..]))
    defer mem.release[u8](&data)
    s: sim.Sim = sim.Sim {}
    if err == null { s, err = diagram.decode(data) }
    if err != null {
        self.failed("cannot open", name, err)
        return
    }
    self.s = s
    self.count = 0
    self.name.copy(name)
    b: fmt.Buffer = self.say()
    b.printf("opened %s", self.name.text())
    self.said(b)
}

/* A press or drag over (x, y) with `button`; `press` is true on the click. */
Game.paint(self, x: int, y: int, button: MouseButton, press: bool) {
    if x < 0 || (!press && x == self.px && y == self.py) { return }
    self.px = x
    self.py = y
    if self.phase == Phase.run {
        /* Running, the layout is fixed: a left click only flips a source. */
        if press && button == MouseButton.left && self.s.g.get(x, y) == grid.Block.source {
            self.s.toggle(x, y, self.s.level(x, y) != sim.Level.high)
        }
        return
    }
    if button == MouseButton.right {
        self.s.place(x, y, grid.Block.empty)
        return
    }
    if button != MouseButton.left { return }
    if self.s.g.get(x, y) == self.block { return }
    self.s.place(x, y, self.block)
}

/* A press at window point (x, y). True when the bar or a panel took it, so it
 * paints nothing. */
Game.click(self, x: f32, y: f32, button: MouseButton): bool {
    if self.mode == Mode.save_as { return true }
    if self.mode == Mode.open {
        self.mode = Mode.none
        for i: usize in 0 .. self.list.count {
            if row(i).has(x, y) && button == MouseButton.left {
                self.load(self.list.names[i])
            }
        }
        return true
    }
    if y >= TOP { return false }
    if y >= BAR {
        if button != MouseButton.left || self.phase != Phase.edit { return true }
        for i: usize in 1 .. members(grid.Block).len {
            each: grid.Block = members(grid.Block)[i]
            if tool(each).has(x, y) { self.block = each }
        }
        return true
    }
    if button != MouseButton.left { return true }
    if place(Button.new).has(x, y) { self.clear() }
    if place(Button.open).has(x, y) { self.browse() }
    if place(Button.save).has(x, y) { self.save() }
    if place(Button.save_as).has(x, y) { self.ask() }
    if place(Button.edit).has(x, y) { self.switch(Phase.edit) }
    if place(Button.run).has(x, y) { self.switch(Phase.run) }
    if place(Button.step).has(x, y) && self.phase == Phase.run { self.tick() }
    return true
}

/* A key typed into the Save-as box. */
Game.type(self, e: KeyboardEvent) {
    k: u32 = u32(e.key)
    shift: bool = (e.mod & KMOD_SHIFT) != 0
    if e.key == Keycode.escape {
        self.mode = Mode.none
    } else if e.key == Keycode.enter {
        if self.draft.len == 0 { return }
        self.mode = Mode.none
        self.write()
    } else if e.key == Keycode.backspace {
        self.draft.back()
    } else if k == KEY_DELETE {
        self.draft.forward()
    } else if e.key == Keycode.left {
        if self.draft.at > 0 { self.draft.at -= 1 }
    } else if e.key == Keycode.right {
        if self.draft.at < self.draft.len { self.draft.at += 1 }
    } else if k == KEY_HOME {
        self.draft.at = 0
    } else if k == KEY_END {
        self.draft.at = self.draft.len
    } else if k == '-' && shift {
        self.draft.add('_')
    } else if !shift && ((k >= 'a' && k <= 'z') || (k >= '0' && k <= '9') || k == '-') {
        self.draft.add(u8(k))
    }
}

/* A key press; false to quit. A held key repeats only in the Save-as box. */
Game.key(self, e: KeyboardEvent): bool {
    if self.mode == Mode.save_as {
        self.type(e)
        return true
    }
    if e.repeat { return true }
    if (e.mod & KMOD_CTRL) != 0 {
        if e.key == Keycode.s { self.save() }
        if e.key == Keycode.o { self.browse() }
        return true
    }
    if e.key == Keycode.escape {
        if self.mode == Mode.none { return false }
        self.mode = Mode.none
        return true
    }
    k: u32 = u32(e.key)
    if k == '1' { self.switch(Phase.edit) }
    if k == '2' { self.switch(Phase.run) }
    if e.key == Keycode.space && self.phase == Phase.run { self.auto = !self.auto }
    for i: usize in 1 .. members(grid.Block).len {
        each: grid.Block = members(grid.Block)[i]
        if k == u32(LETTER[each]) { self.block = each }
    }
    return true
}

Game.draw_board(self, canvas: *ui.Canvas, r: Renderer) {
    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            b: grid.Block = self.s.g.get(x, y)
            v: sim.Level = self.s.level(x, y)
            rgb: u32 = LOW[b]
            if v == sim.Level.high { rgb = HIGH[b] }
            if v == sim.Level.error && b != grid.Block.empty { rgb = ERROR }
            /* Blocks fill their cell; empty cells keep a gap so the grid shows. */
            inset: f32 = 0.0
            if b == grid.Block.empty { inset = 1.0 }
            box: ui.Rect = ui.Rect {
                x = f32(x) * CELL + inset, y = TOP + f32(y) * CELL + inset,
                w = CELL - 2.0 * inset, h = CELL - 2.0 * inset,
            }
            canvas.fill(box, Color.hex(rgb))
        }
    }
    if self.mode == Mode.none && self.phase == Phase.edit && self.hx >= 0 {
        box: ui.Rect = ui.Rect { x = f32(self.hx) * CELL, y = TOP + f32(self.hy) * CELL, w = CELL, h = CELL }
        canvas.outline(box, 2.0, Color.hex(0xffffff))
    }
    canvas.flush(r)

    for y: int in 0 .. grid.HEIGHT {
        for x: int in 0 .. grid.WIDTH {
            b: grid.Block = self.s.g.get(x, y)
            if b == grid.Block.empty { continue }
            /* Dark text on a lit block, light text on a dark one. */
            ink: u32 = INK
            if self.s.level(x, y) != sim.Level.low { ink = 0x000000 }
            box: ui.Rect = ui.Rect { x = f32(x) * CELL, y = TOP + f32(y) * CELL, w = CELL, h = CELL }
            ui.center(r, box, grid.SYMBOL[b], ink)
        }
    }
}

Game.draw_bars(self, canvas: *ui.Canvas, r: Renderer) {
    foot: ui.Rect = ui.Rect { x = 0.0, y = TOP + 16.0 * CELL, w = WIDTH, h = FOOT }
    canvas.fill(ui.Rect { x = 0.0, y = 0.0, w = WIDTH, h = TOP }, Color.hex(CHROME))
    /* Block buttons show in Edit only: each in its block's low color, the
     * selected one lit. */
    if self.phase == Phase.edit {
        for i: usize in 1 .. members(grid.Block).len {
            each: grid.Block = members(grid.Block)[i]
            rgb: u32 = LOW[each]
            if each == self.block { rgb = HIGH[each] }
            canvas.fill(tool(each), Color.hex(rgb))
        }
    }
    canvas.fill(foot, Color.hex(CHROME))
    for i: usize in 0 .. members(Button).len {
        each: Button = members(Button)[i]
        rgb: u32 = BUTTON
        if place(each).has(self.mx, self.my) || (each == Button.open && self.mode == Mode.open) {
            rgb = ACTIVE
        }
        if (each == Button.edit && self.phase == Phase.edit) || (each == Button.run && self.phase == Phase.run) {
            rgb = ACTIVE
        }
        canvas.fill(place(each), Color.hex(rgb))
    }
    canvas.flush(r)

    for i: usize in 0 .. members(Button).len {
        each: Button = members(Button)[i]
        /* Step only ticks in Run; its label dims in Edit. */
        ink: u32 = INK
        if each == Button.step && self.phase == Phase.edit { ink = DIM }
        ui.center(r, place(each), LABEL[each], ink)
    }
    if self.phase == Phase.edit {
        for i: usize in 1 .. members(grid.Block).len {
            each: grid.Block = members(grid.Block)[i]
            ink: u32 = INK
            if each == self.block { ink = 0x000000 }
            ui.center(r, tool(each), TOOL[each], ink)
        }
    }
    title: string = self.name.text()
    if title.len == 0 { title = "untitled" }
    storage: [128]u8
    status: fmt.Buffer = fmt.Buffer.init(storage[..])
    auto: string = "off"
    if self.auto { auto = "on" }
    status.printf("%s   tick %d   auto %s", NAME[self.block], self.count, auto)
    ui.left(r, foot, 8.0, status.text(), INK)
    bar: ui.Rect = ui.Rect { x = 0.0, y = 0.0, w = WIDTH, h = BAR }
    ui.left(r, bar, WIDTH - 8.0 - ui.GLYPH * f32(title.len), title, INK)
    note: string = self.notes[0..self.note]
    ui.left(r, foot, WIDTH - 8.0 - ui.GLYPH * f32(note.len), note, DIM)
}

Game.draw_list(self, canvas: *ui.Canvas, r: Renderer) {
    rows: usize = self.list.count
    if rows == 0 { rows = 1 }
    for i: usize in 0 .. rows {
        rgb: u32 = BUTTON
        if i < self.list.count && row(i).has(self.mx, self.my) { rgb = ACTIVE }
        canvas.fill(row(i), Color.hex(rgb))
    }
    canvas.flush(r)

    if self.list.count == 0 { ui.left(r, row(0), 8.0, "no diagrams in diagram/", DIM) }
    for i: usize in 0 .. self.list.count {
        ui.left(r, row(i), 8.0, self.list.names[i], INK)
    }
}

Game.draw_ask(self, canvas: *ui.Canvas, r: Renderer) {
    field: ui.Rect = ui.Rect { x = PANEL.x + 12.0, y = PANEL.y + 32.0, w = PANEL.w - 24.0, h = 28.0 }
    canvas.fill(PANEL, Color.hex(BUTTON))
    canvas.outline(PANEL, 1.0, Color.hex(DIM))
    canvas.fill(field, Color.hex(CHROME))
    /* The cursor: a bar before byte `at`. */
    caret: f32 = field.x + 8.0 + f32(self.draft.at) * ui.GLYPH
    canvas.fill(ui.Rect { x = caret - 1.0, y = field.y + 6.0, w = 2.0, h = field.h - 12.0 }, Color.hex(INK))
    canvas.flush(r)

    title: ui.Rect = ui.Rect { x = PANEL.x, y = PANEL.y + 4.0, w = PANEL.w, h = 24.0 }
    ui.left(r, title, 12.0, "Save as     Enter saves, Esc cancels", INK)
    storage: [64]u8
    b: fmt.Buffer = fmt.Buffer.init(storage[..])
    b.printf("%s", self.draft.text())
    ui.left(r, field, 8.0, b.text(), INK)
    /* The extension, dimmed: it is added, not typed. */
    ui.left(r, field, 8.0 + ui.GLYPH * f32(self.draft.len), diagram.EXTENSION, DIM)
}

Game.draw(self, canvas: *ui.Canvas, r: Renderer) {
    r.color(Color.hex(0x101214))
    r.clear()
    self.draw_board(canvas, r)
    self.draw_bars(canvas, r)
    if self.mode == Mode.open { self.draw_list(canvas, r) }
    if self.mode == Mode.save_as { self.draw_ask(canvas, r) }
    r.present()
}

fail(context: string): int {
    fmt.printf("%s: %s\n", context, error())
    return 1
}

main(): int {
    if !init(InitFlags { video = 1 }) { return fail("SDL_Init") }
    defer quit()

    window: Window = Window.new("logibox", i32(WIDTH), i32(TOP + 16.0 * CELL + FOOT), WindowFlags {})
    defer window.wipe()
    if !window.ok() { return fail("SDL_CreateWindow") }

    renderer: Renderer = Renderer.new(window)
    defer renderer.wipe()
    if !renderer.ok() { return fail("SDL_CreateRenderer") }
    renderer.vsync(1)

    game: Game = Game { s = sim.Sim.init(grid.Grid {}) }
    if game.locate() != null {
        fmt.println("logibox: cannot find the executable's path")
        return 1
    }
    canvas: ui.Canvas = ui.Canvas {}
    held: MouseButton = MouseButton.none
    last: u64 = ticks()
    running: bool = true
    for running {
        event: Event
        for event.poll() {
            if event.type == EventType.quit || event.type == EventType.window_close_requested {
                running = false
            }
            key: KeyboardEvent, is_key: bool = event.key()
            if is_key && key.down {
                running = running && game.key(key)
            }
            b: MouseButtonEvent, is_button: bool = event.mouse_button()
            if is_button {
                if b.down {
                    if !game.click(b.x, b.y, b.button) {
                        held = b.button
                        x: int, y: int = cell_at(b.x, b.y)
                        game.paint(x, y, held, true)
                    }
                } else if b.button == held {
                    held = MouseButton.none
                    game.px = -1
                    game.py = -1
                }
            }
            m: MouseMotionEvent, is_motion: bool = event.mouse_motion()
            if is_motion {
                x: int, y: int = cell_at(m.x, m.y)
                game.mx = m.x
                game.my = m.y
                game.hx = x
                game.hy = y
                if held != MouseButton.none { game.paint(x, y, held, false) }
            }
        }
        now: u64 = ticks()
        if game.auto && now - last >= AUTO_MS {
            game.tick()
            last = now
        }
        if !game.auto { last = now }
        game.draw(&canvas, renderer)
    }
    return 0
}
