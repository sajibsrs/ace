/* Complete HTTP/1.1 server proof of concept over std/http's caller-driven,
 * nonblocking `serve` core.
 *
 * Build and run:
 *   ./ace demo/http-complete-server/main.ace -o http-complete-server
 *   ./http-complete-server
 *
 * Listens on 127.0.0.1:8080. Uses the low-effort `server_context_new(endpoint)`
 * overload, so session count and buffer capacities are the library's built-in
 * defaults rather than caller-tuned; see docs/std/http.md for the
 * explicit, fully-parameterized form.
 */

import fmt
import http
import mem

respond_to(mut ctx: http.ServerContext, index: usize, target: string): Error {
    content_type: [1]http.Header = [http.Header {name = "Content-Type", value = "text/plain"}]
    if mem.equal(target, "/") {
        return http.respond(mut ctx, index, http.Response {
            status = 200,
            headers = content_type[..],
            body = "Hello from Ace!\n",
        })
    }
    return http.respond(mut ctx, index, http.Response {
        status = 404,
        headers = content_type[..],
        body = "not found\n",
    })
}

main(): int {
    endpoint: string = "127.0.0.1:8080"
    poll_timeout_ms: u64 = 1000

    ctx: http.ServerContext, ctx_err: Error = http.server_context_new(endpoint)
    if ctx_err != null {
        fmt.printf("failed to start server on %s: error %d\n", endpoint, int(ctx_err.code))
        return 1
    }
    fmt.printf("listening on %s (Ctrl+C to stop)\n", endpoint)

    for {
        event: http.Event, serve_err: Error = http.serve(mut ctx, poll_timeout_ms * 1000000)
        if serve_err != null {
            fmt.printf("serve failed: error %d\n", int(serve_err.code))
            break
        }
        switch event {
            http.Event.none {}
            http.Event.accepted(index: usize) {
                fmt.printf("session %d: accepted\n", int(index))
            }
            http.Event.request(index: usize) {
                request: http.Request = ctx.sessions[index].request
                fmt.printf("session %d: %s %s\n", int(index), request.method, request.target)
                if respond_to(mut ctx, index, request.target) != null {
                    fmt.printf("session %d: failed to format response\n", int(index))
                }
            }
            http.Event.sent(index: usize) {
                fmt.printf("session %d: response sent\n", int(index))
            }
            http.Event.disconnected(index: usize) {
                fmt.printf("session %d: disconnected\n", int(index))
            }
            http.Event.failed(fail: http.Failure) {
                fmt.printf("session %d: failed, error %d\n", int(fail.index), int(fail.err.code))
            }
        }
    }

    http.server_context_wipe(mut ctx)
    return 0
}
