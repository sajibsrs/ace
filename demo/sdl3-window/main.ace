/* SDL3 proof of concept with pkg/sdl: a window, a renderer, and a classic
 * PollEvent loop.
 *
 * Build and run from this directory (Homebrew SDL3 on Apple arm64):
 *   ace pkg run
 *
 * Closing the window or pressing Escape quits.
 */

import fmt
import sdl

fail(context: string): int {
    fmt.printf("%s: %s\n", context, sdl.error())
    return 1
}

main(): int {
    if !sdl.init(sdl.InitFlags { video = 1 }) { return fail("SDL_Init") }
    defer sdl.quit()

    window: sdl.Window = sdl.Window::new("Ace + SDL3\0", 640, 480, sdl.WindowFlags { resizable = 1 })
    defer mut window.wipe()
    if !window.ok() { return fail("SDL_CreateWindow") }

    renderer: sdl.Renderer = sdl.Renderer::new(window)
    defer mut renderer.wipe()
    if !renderer.ok() { return fail("SDL_CreateRenderer") }

    shade: f32 = 0.0
    running: bool = true
    for running {
        event: sdl.Event
        for sdl.poll_event(mut &event) {
            if event.kind == sdl.EventType.quit || event.kind == sdl.EventType.window_close_requested {
                running = false
            } else if event.kind == sdl.EventType.key_down && event.keyboard.key == sdl.Keycode.escape {
                running = false
            }
        }

        shade += 1.0 / 255.0
        if shade > 1.0 { shade = 0.0 }
        renderer.color(sdl.Color { r = shade, g = 0.25, b = 1.0 - shade })
        renderer.clear()
        renderer.present()
        sdl.delay(16)
    }
    return 0
}
