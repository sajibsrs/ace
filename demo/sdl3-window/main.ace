/* SDL3 proof of concept with pkg/sdl: a window, a renderer, and a classic
 * PollEvent loop.
 *
 * Build and run from this directory (Homebrew SDL3 on Apple arm64):
 *   ace pkg run
 *
 * Closing the window or pressing Escape quits.
 */

import printf from fmt
import (
    init, quit, error, delay, Window, Renderer, Event,
    InitFlags, WindowFlags, EventType, Keycode, Color,
) from sdl

fail(context: string): int {
    printf("%s: %s\n", context, error())
    return 1
}

main(): int {
    if !init(InitFlags { video = 1 }) { return fail("SDL_Init") }
    defer quit()

    window: Window = Window.new("Ace + SDL3", 640, 480, WindowFlags { resizable = 1 })
    defer mut window.wipe()
    if !window.ok() { return fail("SDL_CreateWindow") }

    renderer: Renderer = Renderer.new(window)
    defer mut renderer.wipe()
    if !renderer.ok() { return fail("SDL_CreateRenderer") }

    shade: f32 = 0.0
    running: bool = true
    for running {
        event: Event
        for mut event.poll() {
            if event.kind == EventType.quit || event.kind == EventType.window_close_requested {
                running = false
            } else if event.kind == EventType.key_down && event.keyboard.key == Keycode.escape {
                running = false
            }
        }

        shade += 1.0 / 255.0
        if shade > 1.0 { shade = 0.0 }
        renderer.color(Color { r = shade, g = 0.25, b = 1.0 - shade })
        renderer.clear()
        renderer.present()
        delay(16)
    }
    return 0
}
