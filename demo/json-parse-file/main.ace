/* Reads data.json with pkg/json and prints a few fields by JSON Pointer.
 *
 * data.json is opened relative to the current working directory, not to this
 * source file, so run from this directory:
 *   ace pkg run
 */

import file
import fmt
import json
import mem

PATH: string = "data.json"

main(): int {
    data: mut []u8, err: Error = file.read(PATH)
    defer mem.release[u8](mut data)
    if err != null {
        fmt.printf("failed to read %s: %s\n", PATH, err.message)
        return 1
    }

    doc: json.Json = json.Json.new()
    defer mut doc.wipe()
    storage: [256]u8
    diag: fmt.Buffer = fmt.Buffer.init(mut storage[..])
    perr: Error = mut doc.parse(data, mut diag)
    if perr != null {
        fmt.printf("failed to parse %s: %s\n%s", PATH, perr.message, diag.text())
        return 1
    }

    fmt.println(doc.string("/first_name"))
    fmt.println(doc.number("/age"))
    fmt.println(doc.string("/address/city"))
    fmt.println(doc.string("/phone_numbers/1/number"))
    return 0
}
