/* Formats runtime-computed readings with pkg/json and writes the text to
 * output.json.
 *
 * output.json is created relative to the current working directory, not to
 * this source file, so run from this directory:
 *   ace pkg run
 */

import file
import fmt
import json

PATH: string = "output.json"

SENSORS: [4]string = ["north", "east", "south", "west"]

Reading: struct {
    sensor: string,
    sample: int,
    celsius: f64,
    ok: bool,
}

/* Each type writes itself: the compiler picks the value overload from each
 * field's type, so the call sites name no JSON types.
 */
write_reading(mut f: json.Formatter, r: Reading) {
    mut f.object()
    mut f.field("sensor", r.sensor)
    mut f.field("sample", r.sample)
    mut f.field("celsius", r.celsius)
    mut f.field("ok", r.ok)
    mut f.end()
}

main(): int {
    count: int = 12
    f: json.Formatter = json.Formatter::new()
    defer mut f.wipe()
    mut f.array()

    for i: int in 0 .. count {
        reading: Reading = Reading{
            sensor = SENSORS[i % 4],
            sample = i,
            celsius = 15.0 + 1.5 * f64(i),
            ok = i % 5 != 0,
        }
        write_reading(mut f, reading)
    }
    mut f.end()
    text: string, ferr: Error = f.finish()

    if ferr != null {
        fmt.printf("failed to format: error %d\n", int(ferr.code))
        return 1
    }
    werr: Error = file.write(PATH, text)

    if werr != null {
        fmt.printf("failed to write %s: %s\n", PATH, werr.message)
        return 1
    }
    fmt.printf("wrote %d bytes to %s:\n%s\n", int(text.len), PATH, text)
    return 0
}
