/* Formats runtime-computed readings with pkg/json and writes the text to
 * output.json.
 *
 * output.json is created relative to the current working directory, not to
 * this source file, so run from this directory:
 *   ace pkg run
 */

import file
import fmt
import json

PATH: string = "output.json"

SENSORS: [4]string = ["north", "east", "south", "west"]

main(): int {
    doc: json.Json = json.Json::new()
    defer mut doc.wipe()
    mut doc.array()

    for i: int in 0 .. 12 {
        mut doc.object()
        mut doc.field("sensor", SENSORS[i % 4])
        mut doc.field("sample", i)
        mut doc.field("celsius", 15.0 + 1.5 * f64(i))
        mut doc.field("ok", i % 5 != 0)
        mut doc.end()
    }
    mut doc.end()
    text: string, err: Error = doc.format()
    if err != null { return 1 }

    werr: Error = file.write(PATH, text)
    if werr != null {
        fmt.printf("failed to write %s: %s\n", PATH, werr.message)
        return 1
    }

    fmt.printf("wrote %d bytes to %s:\n%s\n", int(text.len), PATH, text)
    return 0
}
