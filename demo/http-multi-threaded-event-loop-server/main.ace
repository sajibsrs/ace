/* Multi-threaded event-loop HTTP/1.1 server: WORKERS threads each wait on
 * their own poll queue over non-blocking sockets, so an idle or slow client
 * holds a heap `Connection` rather than a thread. Each connection is an explicit
 * state machine around `http.ServerConnection`: it reads until requests
 * complete, writes each response, and stays open for the next request unless
 * either side asked to close. Each connection allocates its own state, found
 * through its `poll` context, and releases it on close.
 *
 * Every worker watches the one shared listener and accepts one connection per
 * readiness event. A connection stays on the worker that accepted it, so its
 * state needs no lock; the queue is level-triggered, so connections left in
 * the backlog wake the next wait, on any worker. Handlers run on the event
 * loop and must not block.
 *
 * Build and run (from this directory):
 *   ace pkg run
 *
 * Listens on 127.0.0.1:8080.
 */

import fmt
import http
import mem
import net
import net/tcp
import poll
import sys
import thread
import time

WORKERS: const usize = 4
BACKLOG: const usize = 512
EVENTS: const usize = 64
MAX_REQUEST: const usize = 65536
NS_PER_SECOND: const u64 = 1000000000
IDLE_TIMEOUT: const u64 = 5 * NS_PER_SECOND // waiting for a next request
REQUEST_TIMEOUT: const u64 = 10 * NS_PER_SECOND // first request byte to last response byte
LINGER_TIMEOUT: const u64 = NS_PER_SECOND // after the final response, until the client closes

Server: struct {
    listener: tcp.Listener,
    router: *http.Router,
}

/* One client's progress, allocated at accept and released at close. Its
 * worker links it into a list so expiry can reach idle connections.
 */
Connection: struct {
    storage: []Connection,
    conn: tcp.Conn,
    previous: *Connection,
    next: *Connection,
    writing: bool,
    lingering: bool,
    deadline: u64,
    http: http.ServerConnection,
}

/* One thread's event loop. */
Worker: struct {
    queue: poll.Queue,
    server: *Server,
    first: *Connection,
    accepting: bool,
}

Worker.wipe(self) {
    for self.first != null { finish(&self, self.first) }
}

handle(request: http.Request): http.Response {
    if mem.equal(request.target, "/") {
        return http.Response {
            status = 200,
            body = "Hello from Ace event loops!\n",
        }
    }
    return http.Response {
        status = 404,
        body = "not found\n",
    }
}

/* Closes and releases `connection`. Closing the descriptor also removes it
 * from the queue.
 */
finish(worker: *Worker, connection: *Connection) {
    if connection.previous != null {
        connection.previous.next = connection.next
    } else {
        worker.first = connection.next
    }
    if connection.next != null { connection.next.previous = connection.previous }

    tcp.close(&connection.conn)
    connection.http.wipe()
    storage: []Connection = connection.storage
    mem.release[Connection](&storage)
}

/* Waits for the socket to become readable or writable, not both. */
watch(worker: *Worker, connection: *Connection, writing: bool): bool {
    connection.writing = writing
    interest: tcp.Interest = tcp.Interest.read
    if writing { interest = tcp.Interest.write }

    tcp.interest(&connection.conn, interest)
    return tcp.watch(worker.queue, connection.conn, *u8(connection)) == null
}

/* Half-closes and discards input until the client closes, so closing with
 * unread bytes cannot reset the connection before it reads the response.
 */
linger(worker: *Worker, connection: *Connection) {
    if tcp.close_write(connection.conn) != null || !watch(worker, connection, false) {
        finish(worker, connection)
        return
    }
    connection.lingering = true
    connection.deadline = time.elapsed() + LINGER_TIMEOUT
}

/* Writes the pending response. True means it is out and the connection is
 * ready for its next request; otherwise it was finished or waits to write.
 */
flush(worker: *Worker, connection: *Connection): bool {
    for {
        output: []u8 = connection.http.output()
        if output.len == 0 { break }

        switch tcp.progress_send(&connection.conn, output) {
            tcp.Event.sent(count: usize) {
                connection.http.sent(count)
            }
            tcp.Event.none {
                if !connection.writing && !watch(worker, connection, true) { finish(worker, connection) }
                return false
            }
            default {
                finish(worker, connection)
                return false
            }
        }
    }
    if !connection.http.persistent() {
        linger(worker, connection)
        return false
    }
    if connection.writing && !watch(worker, connection, false) {
        finish(worker, connection)
        return false
    }
    timeout: u64 = REQUEST_TIMEOUT
    if connection.http.idle() { timeout = IDLE_TIMEOUT }

    connection.deadline = time.elapsed() + timeout
    return true
}

/* Answers every request already received, then waits for more input. */
drain(worker: *Worker, connection: *Connection) {
    for {
        switch connection.http.next() {
            http.ServerStep.request(request: http.Request) {
                response: http.Response = worker.server.router.dispatch(request)
                if connection.http.respond(request, response) != null {
                    finish(worker, connection)
                    return
                }
                if !flush(worker, connection) { return }
            }
            http.ServerStep.send {
                if !flush(worker, connection) { return }
            }
            http.ServerStep.need_input {
                return
            }
            http.ServerStep.failed {
                finish(worker, connection)
                return
            }
        }
    }
}

/* Receives once; the level-triggered queue reports any bytes left, so one
 * busy connection takes turns with the others.
 */
read_ready(worker: *Worker, connection: *Connection) {
    discard: [512]u8 = [u8(0) : 512]
    room: []u8 = discard[..]
    if !connection.lingering { room = connection.http.room() }
    if room == null {
        finish(worker, connection)
        return
    }
    switch tcp.progress_receive(&connection.conn, room) {
        tcp.Event.data(count: usize) {
            if connection.lingering { return }
            if connection.http.idle() { connection.deadline = time.elapsed() + REQUEST_TIMEOUT }

            connection.http.received(count)
            drain(worker, connection)
        }
        tcp.Event.none {
        }
        default {
            finish(worker, connection)
        }
    }
}

write_ready(worker: *Worker, connection: *Connection) {
    if flush(worker, connection) { drain(worker, connection) }
}

/* Starts a connection on `conn`, linked into the worker's list. */
open(worker: *Worker, conn: tcp.Conn): bool {
    storage: []Connection = mem.zalloc[Connection](1)
    if storage == null { return false }

    connection: *Connection = &storage[0]
    if tcp.watch(worker.queue, conn, *u8(connection)) != null {
        mem.release[Connection](&storage)
        return false
    }
    connection.storage = storage
    connection.conn = conn
    connection.deadline = time.elapsed() + IDLE_TIMEOUT
    connection.http = http.ServerConnection.new(MAX_REQUEST)
    connection.next = worker.first
    if worker.first != null { worker.first.previous = connection }

    worker.first = connection
    return true
}

/* A failure other than `pending`, such as running out of descriptors, leaves
 * the listener readable, so it stops being watched until the next expiry tick
 * rather than spinning this level-triggered loop.
 */
accept_ready(worker: *Worker) {
    conn: tcp.Conn, _, err: Error = tcp.accept_nonblock(worker.server.listener)
    if err == tcp.AcceptErr.pending { return } // another worker won it, or the client left
    if err != null {
        worker.accepting = tcp.unwatch(worker.queue, worker.server.listener) != null
        return
    }
    if !open(worker, conn) { tcp.close(&conn) }
}

/* Closes every connection past its deadline. */
expire(worker: *Worker) {
    now: u64 = time.elapsed()
    connection: *Connection = worker.first
    for connection != null {
        next: *Connection = connection.next
        if now >= connection.deadline { finish(worker, connection) }

        connection = next
    }
}

work(server: *Server) {
    queue: poll.Queue, queue_err: Error = poll.queue()
    if queue_err != null {
        fmt.printf("failed to create queue: error %d\n", int(queue_err.code))
        sys.exit(1)
    }
    defer sys.close(sys.Fd(queue))

    worker: Worker = Worker { queue = queue, server = server, first = null, accepting = true }
    defer worker.wipe()

    watch_err: Error = tcp.watch(queue, server.listener)
    if watch_err != null {
        fmt.printf("failed to watch listener: error %d\n", int(watch_err.code))
        sys.exit(1)
    }

    events: [EVENTS]poll.Event = [blank(poll.Event) : EVENTS]
    next_expiry: u64 = time.elapsed() + NS_PER_SECOND
    for {
        count: usize, wait_err: Error = poll.wait(queue, events[..], NS_PER_SECOND)
        if wait_err == poll.WaitErr.interrupted { continue }
        if wait_err != null {
            fmt.printf("failed to wait: error %d\n", int(wait_err.code))
            sys.exit(1)
        }

        for i: usize in 0 .. count {
            connection: *Connection = *Connection(events[i].context)
            if connection == null {
                accept_ready(&worker)
                continue
            }

            if connection.writing {
                write_ready(&worker, connection)
            } else {
                read_ready(&worker, connection)
            }
        }

        if time.elapsed() >= next_expiry {
            expire(&worker)
            if !worker.accepting { worker.accepting = tcp.watch(queue, server.listener) == null }

            next_expiry = time.elapsed() + NS_PER_SECOND
        }
    }
}

main(): int {
    address: net.Addr4, parsed: bool = net.parse4("127.0.0.1:8080")
    if !parsed { return 1 }

    listener: tcp.Listener, listen_err: Error = tcp.listen_nonblock(address, BACKLOG)
    if listen_err != null {
        fmt.printf("failed to listen: error %d\n", int(listen_err.code))
        return 1
    }

    router: http.Router = http.Router.new()
    defer router.wipe()
    route_err: Error = router.handle(http.GET, "/", handle)
    if route_err != null {
        fmt.printf("failed to register route: error %d\n", int(route_err.code))
        return 1
    }

    server: Server = Server { listener = listener, router = &router }
    threads: [WORKERS]thread.Thread = [thread.Thread {} : WORKERS]
    for i: usize in 0 .. WORKERS {
        t: thread.Thread, err: Error = thread.Thread.create(work, *u8(&server))
        if err != null {
            fmt.printf("failed to start worker: error %d\n", int(err.code))
            sys.exit(1) // running workers still use the router and listener
        }
        threads[i] = t
    }
    fmt.printf("listening on 127.0.0.1:8080 with %d workers (Ctrl+C to stop)\n", int(WORKERS))

    for i: usize in 0 .. WORKERS {
        threads[i].join()
    }
    return 0
}
