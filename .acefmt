# acefmt — Ace source formatting rules

[file]
charset = utf-8
line-end = lf
final-newline = always
trailing-whitespace = trimmed

[layout]
line-length = 120
indent-style = space
indent-width = 4
continuation-alignment = open-delimiter
delimited-list = single-line-if-fits
multiline-trailing-comma = always
dense-list = whole-items-per-row
dense-list-columns = aligned
struct-literal = field-per-line
struct-literal-in-bare-list = named-local
nested-overlong-list = named-local

[declarations]
public-before-private = dependency-order
specialized-marker = line-final
intrinsic-marker = line-final
error-domain-entries = line-oriented-no-commas

[attributes]
top-level = own-line
field = own-line

[blank-lines]
before-top-level-attribute = always
before-body = always
declaration-group = preserve
nested-first-body = never
after-closing-brace = only-before-next-body
inside-if-chain = never
result-group = adjacent
after-result-group = always

[braces]
space-before-open = always
inner-space = one-line-nonempty
empty-body = same-line
single-statement-body = same-line-if-fits

[comments]
file-header = block
multi-line = block
single-line = slash-slash
doc-multiline = star-own-close
inline-multiline = star-same-close
doc-adjacency = strict

[tokens]
range-in-for = spaced
slice-range = tight
paren-bracket-inner = tight
array-repeat = spaced
declaration-elision = spaced
assoc-function-ref = tight
