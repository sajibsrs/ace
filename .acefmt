# acefmt — Ace source formatting rules

[file]
charset = utf-8
line-end = lf
final-newline = always
trailing-whitespace = trimmed

[layout]
line-length = 120
indent-style = space
indent-width = 4
continuation-alignment = open-delimiter

[declarations]
public-before-private = always
specialized-marker = line-final

[blank-lines]
before-body = always
declaration-group = preserve
nested-first-body = never
after-closing-brace = only-before-next-body
inside-if-chain = never

[braces]
space-before-open = always
empty-body = same-line

[comments]
file-header = block
multi-line = block
single-line = slash-slash
doc-multiline = star-own-close
inline-multiline = star-same-close
doc-adjacency = strict

[tokens]
range-in-for = spaced
slice-range = tight
array-repeat = spaced
declaration-elision = spaced
