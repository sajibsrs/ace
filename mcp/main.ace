/* ace-mcp: the Ace server for coding agents. Speaks the Model Context
 * Protocol over stdin and stdout, one JSON-RPC message per line, and offers
 * ace-lsp's lookups as tools over files on disk. Diagnostics go to stderr.
 */

import array
import file
import fmt
import json: "../pkg/json/mod.ace"
import mem
import str
import sys

import path: "../selfhost/path.ace"

import definition: "../lsp/definition.ace"
import examples: "./examples.ace"
import hover: "../lsp/hover.ace"
import lookup: "./lookup.ace"
import references: "../lsp/references.ace"
import module: "../selfhost/module.ace"
import spec: "./spec.ace"

/* The MCP revision this server implements. */
PROTOCOL: const string = "2025-06-18"

/* This server's version, as `initialize` reports it in `serverInfo`. */
VERSION: const string = "0.1.0"

/* The message stream on stdin: one message per newline-terminated line. */
Reader: struct {
    buf: []u8 = null,
    start: usize = 0,
    end: usize = 0,
}

Reader.wipe(self) {
    mem.release[u8](&self.buf)
}

/* Reads more of stdin; false at end of input or on a read error. */
Reader.fill(self): bool {
    if self.start > 0 {
        mem.move(self.buf[..self.end - self.start], self.buf[self.start..self.end])
        self.end -= self.start
        self.start = 0
    }
    if self.end == self.buf.len {
        size: usize = self.buf.len == 0 ? 4096 : self.buf.len * 2
        self.buf = mem.realloc[u8](self.buf, size)
    }
    n: int, err: Error = sys.read(sys.stdin, self.buf[self.end..])
    if err != null || n <= 0 { return false }
    self.end += usize(n)
    return true
}

/* The next non-empty line, valid until the next call; false at end of input. */
Reader.next(self): (string, bool) {
    for {
        nl: usize, found: bool = str.find(self.buf[self.start..self.end], "\n")
        if !found {
            if !self.fill() { return "", false }
            continue
        }
        line: string = str.trim(self.buf[self.start..self.start + nl])
        self.start += nl + 1
        if line.len > 0 { return line, true }
    }
    return "", false
}

write_all(data: []u8) {
    at: usize = 0
    for at < data.len {
        n: int, err: Error = sys.write(sys.stdout, data[at..])
        if err != null || n <= 0 { return }
        at += usize(n)
    }
}

/* The declaration named at 1-based `line` and byte `column` of `file_path`
 * and the text of its file, or false. Strings live in `pool`.
 */
resolve(pool: *path.Pool, file_path: string, line: u32, column: u32): (definition.Location, string, bool) {
    none: definition.Location = blank(definition.Location)
    canon: string, found: bool = path.canonical(pool, file_path)
    if !found { return none, "", false }
    src: []u8, err: Error = file.read(canon)
    defer mem.release[u8](&src)
    if err != null { return none, "", false }
    loc: definition.Location, hit: bool = definition.find(pool, canon, src, line, column)
    if !hit { return none, "", false }
    target: []u8, terr: Error = file.read(loc.file)
    defer mem.release[u8](&target)
    if terr != null { return none, "", false }
    return loc, pool.copy(target), true
}

/* Every use of the declaration named at `line` and `column` of `file_path`
 * in the program holding that file, one `path:line:column` per line, or
 * why there is none and true. Lives in `pool`.
 */
uses(pool: *path.Pool, file_path: string, line: u32, column: u32): (string, bool) {
    canon: string, found: bool = path.canonical(pool, file_path)
    if !found { return pool.join(["cannot open '", file_path, "'"]), true }
    src: []u8, err: Error = file.read(canon)
    defer mem.release[u8](&src)
    if err != null { return pool.join(["cannot open '", file_path, "'"]), true }
    prog: definition.Program, loaded: bool = definition.Program.new(pool, canon)
    defer prog.wipe()
    if !loaded || !prog.checked { return "the program does not load", true }
    _, decl: u32, hit: bool = prog.at(pool, canon, src, line, column)
    if !hit || decl == 0 { return "no declaration there", true }
    found_uses: array.Array[definition.Location] = array.Array[definition.Location] {}
    defer found_uses.wipe()
    references.uses(&prog, pool, decl, false, 0, &found_uses)
    if found_uses.len == 0 { return "no uses", false }
    parts: array.Array[string] = array.Array[string] {}
    defer parts.wipe()
    for loc: definition.Location in found_uses.view() { parts.push(place(pool, loc)) }
    return pool.join(parts.view()), false
}

/* `loc` as a `path:line:column` line, in `pool`. */
place(pool: *path.Pool, loc: definition.Location): string {
    num: [32]char
    n: usize, _ = str.format(num[..], usize(loc.line))
    m: usize, _ = str.format(num[n..], usize(loc.col))
    return pool.join([loc.file, ":", num[..n], ":", num[n..n + m], "\n"])
}

/* Every error the loader and sema report for the program holding
 * `file_path`, one `path:line:column: message` per line (0 where there is
 * no position), or "no errors". The text lives in `pool`.
 */
diagnostics(pool: *path.Pool, file_path: string): (string, bool) {
    canon: string, found: bool = path.canonical(pool, file_path)
    if !found { return pool.join(["cannot open '", file_path, "'"]), true }
    prog: definition.Program, loaded: bool = definition.Program.new(pool, canon)
    defer prog.wipe()
    if !loaded { return "the program's package graph does not resolve", true }
    parts: array.Array[string] = array.Array[string] {}
    defer parts.wipe()
    report(pool, &parts, prog.l.diags.view())
    if prog.checked { report(pool, &parts, prog.s.diags.view()) }
    if parts.len == 0 { return "no errors", false }
    return pool.join(parts.view()), false
}

/* Appends each of `diags` to `parts` as a line. */
report(pool: *path.Pool, parts: *array.Array[string], diags: []module.Diagnostic) {
    for d: module.Diagnostic in diags {
        num: [32]char
        n: usize, _ = str.format(num[..], usize(d.line))
        m: usize, _ = str.format(num[n..], usize(d.col))
        parts.push(pool.join([d.path, ":", num[..n], ":", num[n..n + m], ": ", d.message, "\n"]))
    }
}

/* Runs tool `name` on the arguments in `req` and returns its text and
 * whether it failed. The text lives in `pool`.
 */
call(pool: *path.Pool, req: *json.Json, name: string): (string, bool) {
    file_path: string = req.string("/params/arguments/file")
    if mem.equal(name, "diagnostics") {
        if file_path == null { return "needs file", true }
        return diagnostics(pool, file_path)
    }
    if mem.equal(name, "std_lookup") {
        qualified: string = req.string("/params/arguments/name")
        if qualified == null { return "needs name", true }
        text: string, ok: bool = lookup.text(pool, qualified)
        return text, !ok
    }
    if mem.equal(name, "spec_section") {
        ref: string = req.string("/params/arguments/ref")
        if ref == null { return "needs ref", true }
        text: string, ok: bool = spec.text(pool, ref)
        return text, !ok
    }
    line: f64 = req.number("/params/arguments/line")
    column: f64 = req.number("/params/arguments/column")
    if !mem.equal(name, "definition") && !mem.equal(name, "hover") && !mem.equal(name, "references") && !mem.equal(name, "examples") { return "unknown tool", true }
    if file_path == null || line < 1.0 || column < 1.0 { return "needs file, and line and column from 1", true }
    if mem.equal(name, "references") { return uses(pool, file_path, u32(line), u32(column)) }
    if mem.equal(name, "examples") {
        text: string, ok: bool = examples.text(pool, file_path, u32(line), u32(column))
        return text, !ok
    }
    loc: definition.Location, target: string, ok: bool = resolve(pool, file_path, u32(line), u32(column))
    if !ok { return "no declaration there, or the program does not load", true }
    if mem.equal(name, "hover") { return hover.text(pool, target, loc.line, loc.doc), false }
    num: [32]char
    n: usize, nok: bool = str.format(num[..], usize(loc.line))
    m: usize, mok: bool = str.concat([":"], num[n..])
    k: usize, kok: bool = str.format(num[n + m..], usize(loc.col))
    return pool.join([loc.file, ":", num[..n + m + k]]), false
}

/* Writes one tool's description: `name`, `about`, and its inputs `keys`,
 * each one of `file`, `line`, `column`, `name`, or `ref`, all required.
 */
tool(out: *json.Json, name: string, about: string, keys: []string) {
    out.object()
    out.field("name", name)
    out.field("description", about)
    out.key("inputSchema")
    out.object()
    out.field("type", "object")
    out.key("properties")
    out.object()
    for key: string in keys {
        out.key(key)
        out.object()
        if mem.equal(key, "file") {
            out.field("type", "string")
            out.field("description", "path of an .ace file")
        } else if mem.equal(key, "line") {
            out.field("type", "integer")
            out.field("description", "1-based line")
        } else if mem.equal(key, "column") {
            out.field("type", "integer")
            out.field("description", "1-based byte column of the name")
        } else if mem.equal(key, "ref") {
            out.field("type", "string")
            out.field("description", "a spec reference: Section #N, such as Memory #15 or Stdlib #12")
        } else {
            out.field("type", "string")
            out.field("description", "a qualified std name: module.name or module.Type.method")
        }
        out.end()
    }
    out.end()
    out.key("required")
    out.array()
    for key: string in keys { out.value(key) }
    out.end()
    out.end()
    out.end()
}

main(): int {
    reader: Reader = Reader {}
    defer reader.wipe()
    req: json.Json = json.Json.new()
    defer req.wipe()
    out: json.Json = json.Json.new()
    defer out.wipe()
    for {
        line: string, ok: bool = reader.next()
        if !ok { return 0 }
        if req.parse(line) != null {
            fmt.printf(sys.stderr, "ace-mcp: malformed message\n")
            continue
        }
        method: string = req.string("/method")
        id: json.Value, has_id: bool = req.get("/id")
        if method == null || !has_id { continue } // responses and notifications
        out.reset()
        out.object()
        out.field("jsonrpc", "2.0")
        out.field("id", id)
        if mem.equal(method, "initialize") {
            out.key("result")
            out.object()
            out.field("protocolVersion", PROTOCOL)
            out.key("capabilities")
            out.object()
            out.key("tools")
            out.object()
            out.end()
            out.end()
            out.key("serverInfo")
            out.object()
            out.field("name", "ace-mcp")
            out.field("version", VERSION)
            out.end()
            out.end()
        } else if mem.equal(method, "ping") {
            out.key("result")
            out.object()
            out.end()
        } else if mem.equal(method, "tools/list") {
            out.key("result")
            out.object()
            out.key("tools")
            out.array()
            tool(&out, "definition", "Where the Ace name at a position is declared, as file:line:column. Resolves through sema: locals, overloads, fields, imports, std.", ["file", "line", "column"])
            tool(&out, "hover", "The declaration line and doc comment of the Ace name at a position, as Markdown.", ["file", "line", "column"])
            tool(&out, "diagnostics", "Every compile error in the Ace program holding a file, as path:line:column: message lines (line and byte column 1-based), or 'no errors'.", ["file"])
            tool(&out, "std_lookup", "Every public std declaration a qualified name names (str.format, mem.copy, fmt.Buffer.printf), all overloads, each as file:line then its signature and doc comment in Markdown; a bare module (str) lists each public declaration as file:line and its signature line.", ["name"])
            tool(&out, "spec_section", "The spec item a reference such as 'Memory #15' names: its spec/ file:line, any [open] or [controversial] marker, its text, then each spec/queue.md and changelog/ line citing it; a bare section ('Naming') gives the whole section.", ["ref"])
            tool(&out, "references", "Every use of the declaration named at a position (or of the declaration itself, with the cursor on it) within the program rooted at that file, resolved through sema, as path:line:column lines.", ["file", "line", "column"])
            tool(&out, "examples", "Up to 10 real uses of the declaration named at a position, from tests/, demo/, std/, and selfhost/ in that order, each file checked as its own program so only uses sema resolves to that declaration count; each as path:line:column: source line.", ["file", "line", "column"])
            out.end()
            out.end()
        } else if mem.equal(method, "tools/call") {
            pool: path.Pool = blank(path.Pool)
            defer pool.wipe()
            text: string, failed: bool = call(&pool, &req, req.string("/params/name"))
            out.key("result")
            out.object()
            out.key("content")
            out.array()
            out.object()
            out.field("type", "text")
            out.field("text", text)
            out.end()
            out.end()
            out.field("isError", failed)
            out.end()
        } else {
            out.key("error")
            out.object()
            out.field("code", 0 - 32601)
            out.field("message", "method not found")
            out.end()
        }
        out.end()
        text: string, err: Error = out.format()
        if err != null {
            fmt.printf(sys.stderr, "ace-mcp: cannot format a response to %s\n", method)
            continue
        }
        write_all(text)
        write_all("\n")
    }
    return 0
}
