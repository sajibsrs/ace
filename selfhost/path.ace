/* path — file-system paths for the module loader, as src/module.c's helpers
 * handle them: canonical (realpath) identities, the directory of a path, the
 * directory of the running executable, and a pool that owns built strings.
 */

import array
import mem
import sys

/* The longest path the loader handles, one NUL included, as C's PATH_MAX. */
pub MAX: const usize = 4096

extern "c" {
    c_realpath(path: *u8, out: mut *u8): mut *u8 as "realpath"
    c_stat(path: *u8, buf: mut *u8): i32 as "stat"
}

/* Where `struct stat` keeps st_mode, and its width in bytes. */
@when(target == "darwin-arm64")
MODE_AT: const usize = 4
@when(target == "darwin-arm64")
MODE_SIZE: const usize = 2
@when(target == "linux-x64")
MODE_AT: const usize = 24
@when(target == "linux-x64")
MODE_SIZE: const usize = 4

@when(target == "darwin-arm64")
extern "c" {
    c_executable(buf: mut *u8, size: mut *u32): i32 as "_NSGetExecutablePath"
}

@when(target == "linux-x64")
extern "c" {
    c_readlink(path: *u8, buf: mut *u8, size: usize): i64 as "readlink"
}

/* Strings built while loading; the pool owns them until `wipe`, so a built
 * string stays valid for as long as the loader that asked for it.
 */
pub Pool: struct {
    blocks: array.Array[mut []u8],
}

pub Pool.wipe(mut self) {
    for i: usize in 0..self.blocks.len {
        block: mut []u8 = self.blocks.get(i)
        mem.release[u8](mut block)
    }
    mut self.blocks.wipe()
}

/* `parts` concatenated into a pool-owned string. */
pub Pool.join(mut self, parts: []string): string {
    total: usize = 0
    for part: string in parts { total += part.len }
    block: mut []u8 = mem.alloc[u8](total + 1)
    if block == null || mut self.blocks.push(block) != null {
        fmt_abort()
    }
    at: usize = 0
    for part: string in parts {
        mem.copy(block[at..at + part.len], part)
        at += part.len
    }
    block[total] = 0
    return block[..total]
}

pub Pool.copy(mut self, text: string): string {
    return mut self.join([text])
}

fmt_abort() {
    sys.exit(1)
}

/* `text` NUL-terminated into `buf`; false when it does not fit or holds a NUL. */
pub cstring(text: string, buf: mut []u8): bool {
    if text.len >= buf.len { return false }
    for i: usize in 0..text.len {
        if text[i] == 0 { return false }
        buf[i] = text[i]
    }
    buf[text.len] = 0
    return true
}

/* The bytes of a NUL-terminated buffer before its NUL. */
pub cview(buf: []u8): string {
    n: usize = 0
    for n < buf.len && buf[n] != 0 { n += 1 }
    return buf[..n]
}

/* The canonical (symlinks and `.`/`..` resolved) form of `path` in a pool
 * string, or false when it does not exist.
 */
pub canonical(mut pool: Pool, path: string): (string, bool) {
    in_buf: [4096]u8 = blank([4096]u8)
    out_buf: [4096]u8 = blank([4096]u8)
    if !cstring(path, mut in_buf[0..4096]) { return "", false }
    if c_realpath(&in_buf[0], mut &out_buf[0]) == null { return "", false }
    return mut pool.copy(cview(out_buf[0..4096])), true
}

/* The file-type bits of `path`'s st_mode, following symlinks; 0 when it does
 * not exist.
 */
pub kind(path: string): u32 {
    in_buf: [4096]u8 = blank([4096]u8)
    st: [256]u8 = blank([256]u8)
    if !cstring(path, mut in_buf[0..4096]) { return 0 }
    if c_stat(&in_buf[0], mut &st[0]) != 0 { return 0 }
    mode: u32 = 0
    for i: usize in 0..MODE_SIZE { mode |= u32(st[MODE_AT + i]) << u32(8 * i) }
    return mode & 0xF000
}

/* Whether `path` names a directory, as C's S_ISDIR. */
pub is_dir(path: string): bool {
    return kind(path) == 0x4000
}

/* Whether `path` names a regular file, as C's S_ISREG. */
pub is_file(path: string): bool {
    return kind(path) == 0x8000
}

/* The directory part of `path` as a view into it: "dir/file.ace" is "dir",
 * "file.ace" is ".", "/file.ace" is "/".
 */
pub dir(path: string): string {
    i: usize = path.len
    for i > 0 && path[i - 1] != '/' { i -= 1 }
    if i == 0 { return "." }
    if i == 1 { return path[..1] }
    return path[..i - 1]
}

/* True only for descendants, with a path-component boundary after `base`. */
pub beneath(path: string, base: string): bool {
    return path.len > base.len && mem.equal(path[..base.len], base) && path[base.len] == '/'
}

/* The running executable's path, NUL-terminated into `buf`; false when the
 * OS cannot say.
 */
@when(target == "darwin-arm64")
executable(buf: mut []u8): bool {
    size: u32 = u32(buf.len)
    return c_executable(mut &buf[0], mut &size) == 0
}

@when(target == "linux-x64")
executable(buf: mut []u8): bool {
    link: [16]u8 = blank([16]u8)
    cstring("/proc/self/exe", mut link[0..16])
    n: i64 = c_readlink(&link[0], mut &buf[0], buf.len - 1)
    if n <= 0 { return false }
    buf[usize(n)] = 0
    return true
}

/* The directory of the running executable, symlinks resolved (std/ sits
 * beside the real binary, never beside argv[0]); false when the OS cannot
 * say.
 */
pub executable_dir(mut pool: Pool): (string, bool) {
    raw: [4096]u8 = blank([4096]u8)
    if !executable(mut raw[0..4096]) { return "", false }
    real: string, found: bool = canonical(mut pool, cview(raw[0..4096]))
    if !found { return "", false }
    return dir(real), true
}

/* Where `@file` paths are shown from, as src/module.c's build_roots: the
 * compiler's std/ and the build root directory, both canonical ("" when
 * absent).
 */
pub Roots: struct {
    std_root: string = "",
    root_dir: string = "",
}

/* The roots for a build whose root file lives in `root_dir`. */
pub Roots.init(mut pool: Pool, root_dir: string): Roots {
    r: Roots = Roots {}
    exe: string, ok: bool = executable_dir(mut pool)
    if ok {
        s: string, found: bool = canonical(mut pool, mut pool.join([exe, "/std"]))
        if found { r.std_root = s }
    }
    d: string, found: bool = canonical(mut pool, root_dir)
    if found { r.root_dir = d }
    return r
}

/* `path` as src/module.c's build_path shows it: `std/<rest>` under the std
 * root, else relative to the root directory (the longest shared prefix at a
 * component boundary, one `../` per level climbed). Never absolute; `path`
 * itself when it does not exist or there is no root directory.
 */
pub Roots.show(self, mut pool: Pool, path: string): string {
    canon: string, found: bool = canonical(mut pool, path)
    if !found { return path }
    if self.std_root.len > 0 && beneath(canon, self.std_root) {
        return mut pool.join(["std/", canon[self.std_root.len + 1..]])
    }
    root: string = self.root_dir
    if root.len == 0 { return path }
    common: usize = 0
    i: usize = 0
    for i < canon.len && i < root.len && canon[i] == root[i] {
        if canon[i] == '/' { common = i }
        i += 1
    }
    if beneath(canon, root) { common = root.len }
    up: usize = 0
    if common < root.len {
        up = 1
        for j: usize in common + 1..root.len {
            if root[j] == '/' { up += 1 }
        }
    }
    climb: mut []u8 = mem.alloc[u8](up * 3)
    defer mem.release[u8](mut climb)
    for k: usize in 0..up { mem.copy(climb[k * 3..k * 3 + 3], "../") }
    return mut pool.join([climb, canon[common + 1..]])
}
