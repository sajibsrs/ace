/* parser — the Ace parser written in Ace, mirroring src/parser.c node for node.
 *
 * The whole file is lexed up front into `kinds` (one Token per entry) and
 * `toks` (positions and values), so lookahead is index arithmetic. Nodes live
 * in one flat array, addressed by u32 index; index 0 is the absent node. A
 * node's variable-length children are a run in the shared `kids` array, built
 * on `stack` while the list is open. Per-kind layout follows src/parser.c.
 *
 * The first syntax error stops the parse: from then on every token reads as
 * eof, so each loop ends without further checks.
 */

import array
import fmt
import mem
import str
import sys

import lexer: "./lexer.ace"

pub Token: type = lexer.Token
Out: type = fmt.Buffer

pub Kind: enum u8 {
    file,
    named, ptr, slice_t, array_t, tuple_t, func_t, const_t, tparams, staticmap_t,
    import, var, func, param, struct, bits, field, union, variant, contract,
    method, enum, alias, distinct, error, signing, conformance, extern,
    externfn, externvar,
    block, exprstmt, assign, if, for, range, switch, case, varpat, return,
    break, continue, fallthrough, asm, asmbind, label, defer,
    int_lit, float_lit, str_lit, char_lit, bool, null, ident, tuple,
    binary, cmpchain, ops, cond, op, unary, call, placearg, index, slice, selector,
    arraylit, structlit, fieldinit, staticmaplit, mapentry,
}

/* Node flags, with src/ace.h's values. */
pub F_PUB: const u32 = 1
pub F_EXPO: const u32 = 2
pub F_BYADDR: const u32 = 4
pub F_NOALIAS: const u32 = 8
pub F_CONST: const u32 = 16
pub F_DEFAULT: const u32 = 32
pub F_VARARGS: const u32 = 64
pub F_METHOD: const u32 = 128
pub F_SELECT: const u32 = 256
pub F_EMBED: const u32 = 512
pub F_SPECIALIZED: const u32 = 1024
pub F_FORGEN: const u32 = 2048
pub F_MIXED: const u32 = 4096
pub F_INTRINSIC: const u32 = 16384
pub F_PACKED: const u32 = 32768
pub F_VOLATILE: const u32 = 65536
pub F_CABI: const u32 = 131072
pub F_ASSOC: const u32 = 262144
pub F_INLINE: const u32 = 1048576
pub F_COLD: const u32 = 4194304
pub F_GROUPED: const u32 = 33554432
pub F_MEMBERS: const u32 = 67108864 // an ident rewritten from members(E); a = the type operand
pub F_SHADOWED: const u32 = 268435456
pub F_OPEN: const u32 = 536870912 // an enum whose member list ends with `_`
pub F_THREADLOCAL: const u32 = 1073741824 // a module variable with one copy per thread
pub F_TEXT: const u32 = 0x80000000 // `text` is set (it may still be empty)

/* Flag dump names, in `ace --ast` order. */
FLAG_BITS: [21]u32 = [
    F_PUB, F_EXPO, F_BYADDR, F_NOALIAS, F_CONST, F_DEFAULT, F_VARARGS, F_METHOD,
    F_ASSOC, F_SELECT, F_EMBED, F_SPECIALIZED, F_INTRINSIC, F_INLINE, F_COLD,
    F_PACKED, F_VOLATILE, F_CABI, F_SHADOWED, F_OPEN, F_THREADLOCAL,
]
FLAG_NAMES: [21]string = [
    " pub", " extern-c", " byaddr", " noalias", " const", " default", " varargs",
    " method", " assoc", " select", " embed", " specialized", " intrinsic",
    " inline", " cold", " packed", " volatile", " c_abi", " shadowed", " open",
    " threadlocal",
]

NOSLIT: const int = 1 // no struct literal at this expression level

pub Node: struct {
    pub kind: Kind,
    pub op: Token,     // binary/unary/assign/op operator
    pub flags: u32,
    pub line: u32,
    pub col: u32,
    pub text: string,  // name or string bytes, when F_TEXT is set
    pub cname: string, // C link name, when a C-boundary declaration renames it
    pub ival: u64,     // int/char/bool literal
    pub fval: f64,     // float literal
    pub a: u32,
    pub b: u32,
    pub c: u32,
    pub d: u32,
    pub kids: u32,     // first child in Parser.kids
    pub nkids: u32,
}

/* A token's position and value; its kind lives in Parser.kinds. */
Tok: struct {
    line: u32,
    col: u32,
    ival: u64,
    fval: f64,
    text: string, // ident: source view; string: decoded bytes in `pool`
}

pub Parser: struct {
    path: string,
    pub file: string,          // what @file writes; `path`'s base name until set
    kinds: []Token = null,
    toks: []Tok = null,
    ntok: usize,
    pool: []u8 = null, // decoded string literals; never reallocated
    i: usize,
    nodes: []Node = null,
    pub nnode: usize,
    kids: []u32 = null,
    nkid: usize,
    stack: []u32 = null,
    nstack: usize,
    failed: bool,              // unwinding to the innermost statement or declaration
    stopped: bool,             // the error limit was reached: abandon the file
    last: usize,               // the latest error's token; another there is a cascade
    msg: []u8 = null,      // storage of `err`
    err: fmt.Buffer,           // every error's message, back to back
    errs: array.Array[SyntaxError],
    exports: []u32 = null, // an extern block's Ace-defined C symbols
    nexport: usize,
    target: string,            // what @when compares `_PLATFORM_` against
}

/* A syntax error; `message` views the parser's message storage. */
pub SyntaxError: struct {
    pub line: u32,
    pub col: u32,
    pub message: string,
}

/* Errors reported per file before the parser gives up, as in C. */
pub ERROR_LIMIT: const usize = 10

/* Lexes `src` (which must outlive the parser) into a parser over `path`.
 * Lex errors are reported on stderr as `ace --tokens` reports them; the
 * returned count is how many there were. Call `wipe` when done.
 */
pub Parser.new(src: string, path: string): (Parser, int) {
    msg: []u8 = mem.alloc[u8](256 * ERROR_LIMIT) // the longest message, one name included
    p: Parser = Parser { path = path, file = base_name(path), ntok = 0, i = 0, nnode = 1, nkid = 0, nstack = 0, failed = false, stopped = false, last = 0, msg = msg, err = fmt.Buffer.init(msg), errs = array.Array[SyntaxError] {}, nexport = 0, target = "" }
    p.pool = mem.alloc[u8](src.len + 1)
    p.kinds = mem.alloc[Token](64)
    p.toks = mem.alloc[Tok](64)
    p.nodes = mem.alloc[Node](256)
    p.kids = mem.alloc[u32](256)
    p.stack = mem.alloc[u32](64)
    p.exports = mem.alloc[u32](8)
    used: usize = 0
    lx: lexer.Lexer = lexer.Lexer.new(src)
    defer lx.wipe()
    for {
        t: Token = lx.next()
        line: u32, col: u32 = lx.pos()
        tok: Tok = Tok { line = line, col = col, ival = lx.int(), fval = lx.float(), text = "" }
        switch t {
            Token.string {
                text: string = lx.lit()
                mem.copy(p.pool[used..used + text.len], text)
                tok.text = p.pool[used..used + text.len]
                used += text.len
            }
            default { tok.text = lx.lit() }
        }
        if p.ntok == p.kinds.len {
            p.kinds = grow[Token](p.kinds)
            p.toks = grow[Tok](p.toks)
        }
        p.kinds[p.ntok] = t
        p.toks[p.ntok] = tok
        p.ntok += 1
        if t == Token.eof { break }
    }
    for d: lexer.Diag in lx.errors() { lexer.report(path, d) }
    return p, int(lx.errors().len)
}

/* The tokens lexed, EOF excluded. */
pub Parser.tokens(self): usize {
    return self.ntok - 1
}

pub Parser.wipe(self) {
    mem.release[Token](&self.kinds)
    mem.release[Tok](&self.toks)
    mem.release[u8](&self.pool)
    mem.release[Node](&self.nodes)
    mem.release[u32](&self.kids)
    mem.release[u32](&self.stack)
    mem.release[u32](&self.exports)
    mem.release[u8](&self.msg)
    self.errs.wipe()
}

/* `s` with doubled capacity; aborts when out of memory, as the C parser's
 * arena does.
 */
grow[T](s: []T): []T {
    g: []T, ok: bool = mem.grow[T](s, s.len * 2)
    if !ok {
        report("ace", 0, 0, "out of memory")
        sys.exit(1)
    }
    return g
}

/* `path` relative to its own directory: a root file's `@file` when the caller
 * sets no other (path.Roots.show gives C's build_path form).
 */
base_name(path: string): string {
    i: usize = path.len
    for i > 0 && path[i - 1] != '/' { i -= 1 }
    return path[i..]
}

report(path: string, line: u32, col: u32, message: string) {
    fmt.printf(sys.stderr, "%s:%d:%d: error: %s\n", path, int(line), int(col), message)
}

/* Every syntax error, in source order, and whether the limit cut them off. */
pub Parser.errors(self): ([]SyntaxError, bool) {
    assert(self.err.dropped() == 0) // sized to fit any message
    return self.errs.view(), self.stopped
}

/* Node `n` in place, so a later pass can rename or retag it; the pointer
 * dangles once a node is added.
 */
pub Parser.node(const self, n: u32): *Node {
    return &self.nodes[n]
}

pub Parser.kid(const self, n: u32, k: u32): u32 {
    return self.kids[self.nodes[n].kids + k]
}

/* Replaces node `n`, so a later pass can rename or retag it in place. */
pub Parser.update(self, n: u32, x: Node) {
    self.nodes[n] = x
}

/* Appends node `x`; its id. */
pub Parser.add(self, x: Node): u32 {
    if self.nnode == self.nodes.len { self.nodes = grow[Node](self.nodes) }
    n: u32 = u32(self.nnode)
    self.nodes[n] = x
    self.nnode += 1
    return n
}

/* Appends every node of `other` to this tree, ids and child links rebased;
 * the number to add to one of `other`'s ids to name it here. Node text still
 * views `other`'s storage, which must outlive this parser.
 */
pub Parser.adopt(self, other: Parser): u32 {
    off: u32 = u32(self.nnode) - 1
    koff: u32 = u32(self.nkid)
    for self.nnode + other.nnode - 1 > self.nodes.len { self.nodes = grow[Node](self.nodes) }
    for self.nkid + other.nkid > self.kids.len { self.kids = grow[u32](self.kids) }
    for i: usize in 1..other.nnode {
        x: Node = other.nodes[i]
        if x.a != 0 { x.a += off }
        if x.b != 0 { x.b += off }
        if x.c != 0 { x.c += off }
        if x.d != 0 { x.d += off }
        if x.nkids != 0 { x.kids += koff }
        self.nodes[self.nnode] = x
        self.nnode += 1
    }
    for j: usize in 0..other.nkid {
        k: u32 = other.kids[j]
        if k != 0 { k += off }
        self.kids[self.nkid + j] = k
    }
    self.nkid += other.nkid
    return off
}

/* Makes `ids` the children of node `n`. */
pub Parser.relink(self, n: u32, ids: []u32) {
    for self.nkid + ids.len > self.kids.len { self.kids = grow[u32](self.kids) }
    mem.copy[u32](self.kids[self.nkid..self.nkid + ids.len], ids)
    self.nodes[n].kids = u32(self.nkid)
    self.nodes[n].nkids = u32(ids.len)
    self.nkid += ids.len
}

// --- cursor -------------------------------------------------------------------

/* The kind of the token `k` ahead; eof past the end or after an error. */
inline Parser.kth(self, k: usize): Token {
    j: usize = self.i + k
    if self.failed || j >= self.ntok { return Token.eof }
    return self.kinds[j]
}

pub inline Parser.at(self, k: Token): bool {
    return self.kth(0) == k
}

pub inline Parser.eat(self, k: Token): bool {
    if self.kth(0) == k {
        self.i += 1
        return true
    }
    return false
}

/* The current token is the identifier `s`. */
Parser.ident_at(self, k: usize, s: string): bool {
    return self.kth(k) == Token.ident && mem.equal(self.toks[self.i + k].text, s)
}

/* Records an error at token `ti` as the concatenation of `parts` and unwinds
 * to the innermost statement or declaration, which `resume` skips; errors
 * while unwinding, or at the latest error's token, are dropped. No tree is
 * repaired: any error blocks every later phase.
 */
Parser.fail_at(self, ti: usize, parts: []string) {
    if self.failed { return }
    self.failed = true
    t: usize = ti
    if t >= self.ntok { t = self.ntok - 1 }
    if self.errs.view().len > 0 && t == self.last { return }
    self.last = t
    from: usize = self.err.text().len
    for part: string in parts { self.err.printf("%s", part) }
    e: SyntaxError = SyntaxError { line = self.toks[t].line, col = self.toks[t].col, message = self.err.text()[from..] }
    if self.errs.push(e) != null {
        report("ace", 0, 0, "out of memory")
        sys.exit(1)
    }
    if self.errs.view().len == ERROR_LIMIT { self.stopped = true }
}

/* After an error in the construct starting at token `start`, drops its
 * partial nodes down to stack `mark` and skips it, bracket-balanced, to the
 * newline that ends it or its block's unmatched '}'. In formatted code a
 * token at column 1 starts a declaration or is the '}' ending one, so the
 * skip also stops there whatever the depth; a declaration's skip (`top`)
 * takes such a '}' as its own end, a statement's leaves it. Past the error
 * limit the parser stays failed, so the whole file unwinds.
 */
Parser.resume(self, start: usize, mark: usize, top: bool) {
    self.nstack = mark
    if self.stopped { return }
    self.failed = false
    self.i = start
    depth: usize = 0
    for ; ; self.i += 1 {
        k: Token = self.kinds[self.i]
        if k != Token.newline && k != Token.eof && self.toks[self.i].col == 1 && self.i > start {
            if !top || k != Token.rbrace { return }
            depth = 0
            continue
        }
        switch k {
            Token.eof { return }
            Token.lparen, Token.lbrack, Token.lbrace { depth += 1 }
            Token.rparen, Token.rbrack { if depth > 0 { depth -= 1 } }
            Token.rbrace {
                if depth == 0 {
                    if self.i > start { return }
                } else {
                    depth -= 1
                }
            }
            Token.newline { if depth == 0 { return } }
            default {}
        }
    }
}

Parser.fail(self, message: string) {
    self.fail_at(self.i, [message])
}

/* `prefix` then the current token's description, as C's gdesc writes it. */
Parser.fail_got(self, prefix: string) {
    self.fail_got(prefix, "", "")
}

/* `lead`, `what`, then `prefix` and the current token. */
Parser.fail_got(self, lead: string, what: string, prefix: string) {
    if self.failed { return }
    switch self.kinds[self.i] {
        Token.ident { self.fail_at(self.i, [lead, what, prefix, "'", self.toks[self.i].text, "'"]) }
        Token.string { self.fail_at(self.i, [lead, what, prefix, "string literal"]) }
        default { self.fail_at(self.i, [lead, what, prefix, "'", lexer.disp(self.kinds[self.i]), "'"]) }
    }
}

/* "expected <what>, got <current token>". */
Parser.fail_expected(self, what: string) {
    self.fail_got("expected ", what, ", got ")
}

/* A member name (field, enum member, variant, error entry, method) may be a
 * keyword: it is declared in its list or written after '.', never bare.
 */
member_kind(k: Token): bool {
    return k == Token.ident || (u8(k) >= u8(Token.import) && u8(k) <= u8(Token.false))
}

/* Consumes a member name and returns its index, or fails. */
Parser.expect_member(self, what: string): usize {
    if !member_kind(self.kth(0)) { self.fail_expected(what) }
    t: usize = self.i
    if !self.failed { self.i += 1 }
    return t
}

/* Consumes a `k` token and returns its index, or fails. */
Parser.expect(self, k: Token, what: string): usize {
    if !self.at(k) { self.fail_expected(what) }
    t: usize = self.i
    if !self.failed { self.i += 1 }
    return t
}


// --- nodes --------------------------------------------------------------------

/* A new node of `kind` at token `ti`'s position. */
Parser.make(self, kind: Kind, ti: usize): u32 {
    if self.nnode == self.nodes.len { self.nodes = grow[Node](self.nodes) }
    t: usize = ti >= self.ntok ? self.ntok - 1 : ti
    n: u32 = u32(self.nnode)
    self.nodes[n] = Node {
        kind = kind, op = Token.eof, flags = 0, line = self.toks[t].line, col = self.toks[t].col,
        text = "", cname = "", ival = 0, fval = 0.0, a = 0, b = 0, c = 0, d = 0, kids = 0, nkids = 0,
    }
    self.nnode += 1
    return n
}

/* A new node at the current token. */
Parser.nd(self, kind: Kind): u32 {
    return self.make(kind, self.i)
}

Parser.named(self, n: u32, text: string) {
    self.nodes[n].text = text
    self.nodes[n].flags |= F_TEXT
}

/* An identifier node for token `ti`. */
Parser.ident_node(self, kind: Kind, ti: usize): u32 {
    n: u32 = self.make(kind, ti)
    self.named(n, self.toks[ti].text)
    return n
}

Parser.push(self, x: u32) {
    if self.nstack == self.stack.len { self.stack = grow[u32](self.stack) }
    self.stack[self.nstack] = x
    self.nstack += 1
}

/* Moves the children pushed since `mark` into `n`'s kids. */
Parser.close(self, n: u32, mark: usize) {
    count: usize = self.nstack - mark
    for self.nkid + count > self.kids.len { self.kids = grow[u32](self.kids) }
    mem.copy[u32](self.kids[self.nkid..self.nkid + count], self.stack[mark..self.nstack])
    self.nodes[n].kids = u32(self.nkid)
    self.nodes[n].nkids = u32(count)
    self.nkid += count
    self.nstack = mark
}

// --- types --------------------------------------------------------------------

/* At `void` used as a type (not `void.x`). */
Parser.at_void(self): bool {
    return self.ident_at(0, "void") && self.kth(1) != Token.dot
}

/* A function type's return after its ':': a type, or 'void' for none. */
Parser.func_type_ret(self): u32 {
    if self.at_void() {
        self.i += 1
        return 0
    }
    return self.parse_type()
}

/* A type argument: a type, or 'void'. */
Parser.type_arg(self): u32 {
    if !self.at_void() { return self.parse_type() }
    v: u32 = self.ident_node(Kind.named, self.i)
    self.i += 1
    return v
}

/* A function type's parameter list up to `close`, trailing comma allowed: each
 * entry a bare type or a declaration's `name: T`. The name documents and is
 * dropped; the result reports a written name, which a tuple rejects.
 */
Parser.func_type_params(self, close: Token): bool {
    named: bool = false
    if self.at(close) { return named }
    for {
        if self.at(Token.ident) && self.kth(1) == Token.colon {
            self.i += 2
            named = true
        }
        self.push(self.parse_type())
        if !self.eat(Token.comma) || self.at(close) { break }
    }
    return named
}

pub Parser.parse_type(self): u32 {
    if self.at(Token.const) {
        t: u32 = self.nd(Kind.const_t)
        self.i += 1
        self.nodes[t].a = self.parse_type()
        return t
    }
    if self.at(Token.star) {
        t: u32 = self.nd(Kind.ptr)
        self.i += 1
        self.nodes[t].a = self.parse_type()
        return t
    }
    if self.at(Token.lbrack) {
        self.i += 1
        if self.eat(Token.rbrack) { // []T
            t: u32 = self.nd(Kind.slice_t)
            self.nodes[t].a = self.parse_type()
            return t
        }
        t: u32 = self.nd(Kind.array_t) // [N]T
        self.nodes[t].b = self.expr(0)
        self.expect(Token.rbrack, "']' after array length")
        self.nodes[t].a = self.parse_type()
        return t
    }
    if self.at(Token.extern) { // extern "c" (params): ret
        f: u32 = self.nd(Kind.func_t)
        self.nodes[f].flags |= F_CABI
        self.i += 1
        abi: usize = self.expect(Token.string, "ABI string after 'extern'")
        if !self.failed && !mem.equal(self.toks[abi].text, "c") { self.fail("function types support only the 'c' ABI") }
        self.expect(Token.lparen, "'(' after function type ABI")
        mark: usize = self.nstack
        _ = self.func_type_params(Token.rparen)
        self.expect(Token.rparen, "')' to close function parameter types")
        self.close(f, mark)
        self.expect(Token.colon, "':' and a return type or 'void' after C function parameter types")
        self.nodes[f].a = self.func_type_ret()
        return f
    }
    if self.at(Token.lparen) { // tuple or function type
        t: u32 = self.nd(Kind.tuple_t)
        self.i += 1
        mark: usize = self.nstack
        named: bool = self.func_type_params(Token.rparen)
        self.expect(Token.rparen, "')' to close type list")
        if self.eat(Token.colon) { // (params): ret
            f: u32 = self.nd(Kind.func_t)
            self.close(f, mark)
            self.nodes[f].a = self.func_type_ret()
            return f
        }
        if named {
            self.fail("tuple members have no names; only a function type's parameters may be named")
            self.nstack = mark
            return 0
        }
        count: usize = self.nstack - mark
        if count < 2 {
            if count == 0 {
                self.fail("'()' is not a type: a tuple has two or more members, and a function type needs ': R' or ': void'")
            } else {
                self.fail("'(T)' is not a type: a tuple has two or more members, and a function type needs ': R' or ': void'")
            }
            self.nstack = mark
            return 0
        }
        self.close(t, mark)
        return t
    }
    if self.at(Token.ident) { // named, qualified, generic-instantiated
        if self.ident_at(0, "StaticMap") && self.kth(1) == Token.lbrack {
            m: u32 = self.nd(Kind.staticmap_t)
            self.i += 2
            self.nodes[m].a = self.parse_type()
            if self.eat(Token.comma) { self.fail("StaticMap type is spelled StaticMap[K]V, not StaticMap[K, V]") }
            self.expect(Token.rbrack, "']' after StaticMap key type")
            self.nodes[m].b = self.parse_type()
            return m
        }
        if self.at_void() {
            self.fail("'void' is allowed only as a function type's return or a type argument")
            return 0
        }
        named: u32 = self.ident_node(Kind.named, self.i)
        self.i += 1
        for self.at(Token.dot) {
            self.i += 1
            m: usize = self.expect(Token.ident, "type name after '.'")
            outer: u32 = self.ident_node(Kind.named, m)
            self.nodes[outer].a = named
            named = outer
        }
        if self.at(Token.lbrack) { // generic instantiation
            self.i += 1
            mark: usize = self.nstack
            for {
                self.push(self.type_arg())
                if !self.eat(Token.comma) || self.at(Token.rbrack) { break }
            }
            self.expect(Token.rbrack, "']' to close type arguments")
            self.close(named, mark)
        }
        return named
    }
    self.fail_got("expected type, got ")
    return 0
}

// --- expressions --------------------------------------------------------------

/* Binary operator levels, loosest first: || && | ^ & ==/!= (comparison
 * chains) <</>> +/- * / %; 0 when `k` is no binary operator.
 */
level(k: Token): int {
    switch k {
        Token.or_or { return 1 }
        Token.and_and { return 2 }
        Token.pipe { return 3 }
        Token.caret { return 4 }
        Token.amp { return 5 }
        Token.eq_eq, Token.bang_eq { return 6 }
        Token.lt, Token.le, Token.gt, Token.ge { return 7 }
        Token.shl, Token.shr { return 8 }
        Token.plus, Token.minus { return 9 }
        Token.star, Token.slash, Token.percent { return 10 }
        default { return 0 }
    }
}

CMP_LEVEL: const int = 7

/* A conditional `c ? a : b`, loosest of all; `:` binds the nearest `?`.
 * At `?`. A conditional nested in another needs parentheses.
 */
pub Parser.expr(self, ctx: int): u32 {
    c: u32, top: int = self.binary(1, ctx)
    if self.kth(0) != Token.question { return c }
    n: u32 = self.nd(Kind.cond)
    self.i += 1
    self.nodes[n].a = c
    self.nodes[n].b = self.branch(ctx)
    self.expect(Token.colon, "':' after the conditional's first branch")
    self.nodes[n].c = self.branch(ctx)
    return n
}

/* A conditional's branch, which is no unparenthesized conditional. */
Parser.branch(self, ctx: int): u32 {
    r: u32, top: int = self.binary(1, ctx)
    if self.kth(0) == Token.question { self.fail("a nested conditional needs parentheses") }
    return r
}

/* Whether level `lv` is an equality or comparison's, which a bitwise operator
 * (| ^ &, levels 3-5) never takes as an operand unparenthesized.
 */
compare_level(lv: int): bool {
    return lv == 6 || lv == CMP_LEVEL
}

/* Left-associative operators of level `min` and tighter, by precedence
 * climbing: one level lookup per operator, not one call per level. Also
 * returns the level of the result's outermost operator, 0 for none.
 */
Parser.binary(self, min: int, ctx: int): (u32, int) {
    l: u32 = self.unary(ctx)
    ltop: int = 0
    for {
        lv: int = level(self.kth(0))
        if lv < min || lv == 0 { break }
        if lv == CMP_LEVEL {
            l = self.chain(l, ctx)
            ltop = lv
            continue
        }
        op: usize = self.i
        self.i += 1
        r: u32, rtop: int = self.binary(lv + 1, ctx)
        if lv >= 3 && lv <= 5 && (compare_level(ltop) || compare_level(rtop)) {
            self.fail_at(op, ["a bitwise operator and a comparison need parentheses to mix"])
        }
        b: u32 = self.make(Kind.binary, op)
        self.nodes[b].op = self.kinds[op]
        self.nodes[b].a = l
        self.nodes[b].b = r
        l = b
        ltop = lv
    }
    return l, ltop
}

/* The comparison chain whose first operand is `l`. */
Parser.chain(self, l: u32, ctx: int): u32 {
    ch: u32 = self.nd(Kind.cmpchain)
    ops: u32 = self.nd(Kind.ops)
    mark: usize = self.nstack
    self.push(l)
    opmark: usize = 0
    // Operands and operators interleave on the stack; split them after.
    for level(self.kth(0)) == CMP_LEVEL {
        on: u32 = self.nd(Kind.op)
        self.nodes[on].op = self.kinds[self.i]
        self.push(on)
        self.i += 1
        operand: u32, top: int = self.binary(CMP_LEVEL + 1, ctx)
        self.push(operand)
    }
    count: usize = self.nstack - mark
    // Reorder [x0, op1, x1, op2, x2] into operands then operators.
    tmp: []u32 = mem.alloc[u32](count)
    nx: usize = 0
    j: usize = 0
    for j < count {
        tmp[nx] = self.stack[mark + j]
        nx += 1
        j += 2
    }
    opmark = nx
    j = 1
    for j < count {
        tmp[opmark] = self.stack[mark + j]
        opmark += 1
        j += 2
    }
    mem.copy[u32](self.stack[mark..self.nstack], tmp)
    mem.release[u32](&tmp)
    self.close(ops, mark + nx)
    self.close(ch, mark)
    self.nodes[ch].a = ops
    return ch
}

/* A prefix operator node over the unary expression that follows. */
Parser.prefix(self, op: Token, flags: u32, skip: usize, ctx: int): u32 {
    u: u32 = self.nd(Kind.unary)
    self.nodes[u].op = op
    self.nodes[u].flags |= flags
    self.i += skip
    self.nodes[u].a = self.unary(ctx)
    return u
}

/* Non-diagnostic type lookahead from token `i`: the index after the type,
 * or 0 when no type starts there.
 */
Parser.scan_type(self, i: usize): usize {
    k: Token = self.kind_at(i)
    switch k {
        Token.const, Token.star { return self.scan_type(i + 1) }
        Token.lbrack {
            j: usize = i + 1
            if self.kind_at(j) == Token.rbrack {
                j += 1
            } else {
                if self.kind_at(j) != Token.int || self.kind_at(j + 1) != Token.rbrack { return 0 }
                j += 2
            }
            return self.scan_type(j)
        }
        Token.ident {
            j: usize = i + 1
            for self.kind_at(j) == Token.dot {
                if self.kind_at(j + 1) != Token.ident { return 0 }
                j += 2
            }
            if self.kind_at(j) == Token.lbrack {
                j = self.scan_types(j + 1)
                if j == 0 || self.kind_at(j) != Token.rbrack { return 0 }
                j += 1
            }
            return j
        }
        Token.lparen {
            j: usize = self.scan_types(i + 1)
            if j == 0 || self.kind_at(j) != Token.rparen { return 0 }
            j += 1
            if self.kind_at(j) == Token.colon { return self.scan_type(j + 1) }
            return j
        }
        default { return 0 }
    }
}

/* A comma list of scanned types: the index after it, or 0. */
Parser.scan_types(self, i: usize): usize {
    j: usize = i
    for {
        j = self.scan_type(j)
        if j == 0 { return 0 }
        if self.kind_at(j) != Token.comma { return j }
        j += 1
    }
}

/* Token `j`'s kind, eof past the end (scans ignore the error state). */
inline Parser.kind_at(self, j: usize): Token {
    if j >= self.ntok { return Token.eof }
    return self.kinds[j]
}

/* A bracketed argument in expression position: a function type can only be
 * a type argument, never an index.
 */
Parser.bracket_arg(self): u32 {
    if self.at(Token.extern) { return self.parse_type() }
    if self.at(Token.lparen) {
        j: usize = self.i
        depth: int = 0
        for j < self.ntok {
            k: Token = self.kinds[j]
            if k == Token.lparen {
                depth += 1
            } else if k == Token.rparen {
                depth -= 1
                if depth == 0 { break }
            }
            j += 1
        }
        if self.kind_at(j + 1) == Token.colon { return self.parse_type() }
    }
    return self.expr(0)
}

Parser.unary(self, ctx: int): u32 {
    k: Token = self.kth(0)
    if k == Token.bang || k == Token.tilde || k == Token.minus { return self.prefix(k, 0, 1, ctx) }
    if k == Token.star {
        // `*T(address)` is a pointer conversion; any other '*' dereferences.
        after: usize = self.failed ? 0 : self.scan_type(self.i)
        if after != 0 && self.kind_at(after) == Token.lparen { return self.postfix(ctx, self.parse_type()) }
        self.i += 1
        u: u32 = self.nd(Kind.unary)
        self.nodes[u].op = Token.star
        self.nodes[u].a = self.unary(ctx)
        return u
    }
    if k == Token.amp { return self.prefix(Token.amp, 0, 1, ctx) }
    if k == Token.volatile { return self.prefix(Token.volatile, 0, 1, ctx) }
    return self.postfix(ctx, self.primary(ctx))
}

Parser.structlit(self, base: u32): u32 {
    lit: u32 = self.nd(Kind.structlit)
    self.nodes[lit].a = base
    self.i += 1 // '{'
    mark: usize = self.nstack
    if !self.at(Token.rbrace) {
        for {
            fi: u32 = self.nd(Kind.fieldinit)
            if member_kind(self.kth(0)) && self.kth(1) == Token.colon {
                self.fail("struct literal field initialization uses '='; ':' is for declarations and type annotations")
            }
            if member_kind(self.kth(0)) && self.kth(1) == Token.assign {
                self.named(fi, self.toks[self.i].text)
                self.i += 2
            }
            self.nodes[fi].a = self.expr(0)
            self.push(fi)
            if !self.eat(Token.comma) || self.at(Token.rbrace) { break }
        }
    }
    self.expect(Token.rbrace, "'}' to close struct literal")
    self.close(lit, mark)
    return lit
}

pub Parser.staticmaplit(self): u32 {
    lit: u32 = self.nd(Kind.staticmaplit)
    self.expect(Token.lbrace, "'{' to open StaticMap literal")
    mark: usize = self.nstack
    for !self.at(Token.rbrace) {
        entry: u32 = self.nd(Kind.mapentry)
        self.nodes[entry].a = self.expr(0)
        self.expect(Token.colon, "':' between StaticMap key and value")
        self.nodes[entry].b = self.expr(0)
        self.push(entry)
        if !self.eat(Token.comma) || self.at(Token.rbrace) { break }
    }
    self.expect(Token.rbrace, "'}' to close StaticMap literal")
    self.close(lit, mark)
    return lit
}

/* `base` is an identifier node spelled `s`. */
Parser.is_ident(self, base: u32, s: string): bool {
    return base != 0 && self.nodes[base].kind == Kind.ident && mem.equal(self.nodes[base].text, s)
}

/* A call's arguments after its '(' (consumed). */
Parser.call_args(self, call: u32, base: u32) {
    mark: usize = self.nstack
    if self.is_ident(base, "sizeof") || self.is_ident(base, "alignof") || self.is_ident(base, "blank") || self.is_ident(base, "members") {
        self.push(self.parse_type())
        self.expect(Token.rparen, "')' after layout type")
        self.close(call, mark)
        return
    }
    if self.is_ident(base, "bitcast") {
        self.push(self.parse_type())
        self.expect(Token.comma, "',' after bitcast type")
        self.push(self.expr(0))
        self.expect(Token.rparen, "')' after bitcast value")
        self.close(call, mark)
        return
    }
    if self.is_ident(base, "offsetof") {
        self.push(self.parse_type())
        self.expect(Token.comma, "',' after offsetof type")
        ft: usize = self.expect_member("field name in offsetof")
        path: u32 = self.ident_node(Kind.ident, ft)
        for self.eat(Token.dot) {
            part: usize = self.expect_member("field name after '.' in offsetof")
            field: u32 = self.ident_node(Kind.selector, part)
            self.nodes[field].a = path
            path = field
        }
        self.push(path)
        self.expect(Token.rparen, "')' after offsetof field path")
        self.close(call, mark)
        return
    }
    if !self.at(Token.rparen) {
        for {
            self.push(self.expr(0))
            if !self.eat(Token.comma) || self.at(Token.rparen) { break }
        }
    }
    self.expect(Token.rparen, "')' to close call arguments")
    self.close(call, mark)
}

Parser.postfix(self, ctx: int, start: u32): u32 {
    base: u32 = start
    for {
        switch self.kth(0) {
            Token.lparen {
                call: u32 = self.nd(Kind.call)
                self.nodes[call].a = base
                self.i += 1
                self.call_args(call, base)
                base = call
            }
            Token.lbrack { // index, slice, or generic instantiation
                self.i += 1
                ix: u32 = self.nd(Kind.index)
                self.nodes[ix].a = base
                lo: u32 = 0
                hi: u32 = 0
                is_slice: bool = false
                multi: bool = false
                if self.at(Token.dot_dot) {
                    is_slice = true
                    self.i += 1
                    if !self.at(Token.rbrack) { hi = self.expr(0) }
                } else {
                    lo = self.bracket_arg()
                    if self.at(Token.dot_dot) {
                        is_slice = true
                        self.i += 1
                        if !self.at(Token.rbrack) { hi = self.expr(0) }
                    } else if self.at(Token.comma) { // f[int, f64]
                        mark: usize = self.nstack
                        self.push(lo)
                        for self.eat(Token.comma) {
                            if self.at(Token.rbrack) { break }
                            self.push(self.bracket_arg())
                        }
                        self.expect(Token.rbrack, "']' after index/type arguments")
                        self.close(ix, mark)
                        multi = true
                    }
                }
                if multi {
                    base = ix
                } else {
                    self.expect(Token.rbrack, "']' after index/slice")
                    if is_slice {
                        sl: u32 = self.nd(Kind.slice)
                        self.nodes[sl].line = self.nodes[ix].line
                        self.nodes[sl].col = self.nodes[ix].col
                        self.nodes[sl].a = base
                        self.nodes[sl].b = lo
                        self.nodes[sl].c = hi
                        base = sl
                    } else {
                        self.nodes[ix].b = lo
                        base = ix
                    }
                }
            }
            Token.dot {
                self.i += 1
                f: usize = self.expect_member("field name after '.'")
                fa: u32 = self.ident_node(Kind.selector, f)
                self.nodes[fa].a = base
                base = fa
            }
            Token.lbrace { // typed struct literal, suppressed at statement heads
                if (ctx & NOSLIT) != 0 { return base }
                base = self.structlit(base)
            }
            default { return base }
        }
    }
}

Parser.leaf(self, kind: Kind): u32 {
    x: u32 = self.nd(kind)
    self.i += 1
    return x
}

Parser.primary(self, ctx: int): u32 {
    t: usize = self.i
    switch self.kth(0) {
        Token.int, Token.char {
            kind: Kind = self.kinds[t] == Token.char ? Kind.char_lit : Kind.int_lit
            x: u32 = self.leaf(kind)
            self.nodes[x].ival = self.toks[t].ival
            return x
        }
        Token.float {
            x: u32 = self.leaf(Kind.float_lit)
            self.nodes[x].fval = self.toks[t].fval
            return x
        }
        Token.string {
            x: u32 = self.leaf(Kind.str_lit)
            self.named(x, self.toks[t].text)
            return x
        }
        Token.at { // @file / @line
            if self.ident_at(1, "line") {
                x: u32 = self.nd(Kind.int_lit)
                self.nodes[x].ival = u64(self.toks[t].line)
                self.i += 2
                return x
            }
            if self.ident_at(1, "file") {
                x: u32 = self.nd(Kind.str_lit)
                self.named(x, self.file)
                self.i += 2
                return x
            }
            self.fail("expected 'file' or 'line' after '@' in an expression")
            return self.nd(Kind.int_lit)
        }
        Token.null {
            self.i += 1
            return self.nd(Kind.null) // at the next token, as in C
        }
        Token.true, Token.false {
            x: u32 = self.leaf(Kind.bool)
            if self.kinds[t] == Token.true { self.nodes[x].ival = 1 }
            return x
        }
        Token.ident, Token.self { // the receiver reads as an ordinary local
            x: u32 = self.ident_node(Kind.ident, t)
            self.i += 1
            return x
        }
        Token.lparen { // grouping or tuple
            self.i += 1
            mark: usize = self.nstack
            self.push(self.expr(0))
            for self.eat(Token.comma) {
                if self.at(Token.rparen) { break }
                self.push(self.expr(0))
            }
            self.expect(Token.rparen, "')' to close expression")
            if self.nstack - mark == 1 {
                x: u32 = self.stack[mark]
                self.nstack = mark
                if x != 0 && self.nodes[x].kind == Kind.selector { self.nodes[x].flags |= F_GROUPED }
                return x
            }
            tu: u32 = self.make(Kind.tuple, t)
            self.close(tu, mark)
            return tu
        }
        Token.lbrack { // array literal, or a slice type called as a conversion
            self.i += 1
            if self.at(Token.rbrack) && slice_type_start(self.kth(1)) {
                ty: u32 = self.nd(Kind.slice_t)
                self.i += 1
                self.nodes[ty].a = self.parse_type()
                return ty
            }
            al: u32 = self.nd(Kind.arraylit)
            mark: usize = self.nstack
            if !self.at(Token.rbrack) {
                first: u32 = self.expr(0)
                if self.eat(Token.colon) {
                    self.nodes[al].a = first
                    self.nodes[al].b = self.expr(0) // repetition count
                } else {
                    keyed: bool = self.at(Token.assign) // [E.a = x, E.b = y]
                    el: u32 = first
                    for {
                        if keyed {
                            en: u32 = self.nd(Kind.mapentry)
                            self.nodes[en].a = el
                            self.expect(Token.assign, "'=' after a keyed array literal's member")
                            self.nodes[en].b = self.expr(0)
                            el = en
                        } else if self.at(Token.assign) {
                            self.fail("a keyed array literal keys every element, the first included")
                        }
                        self.push(el)
                        if !self.eat(Token.comma) || self.at(Token.rbrack) { break }
                        el = self.expr(0)
                    }
                }
            }
            self.expect(Token.rbrack, "']' to close array literal")
            if self.nstack - mark == 1 && self.nodes[al].a == 0 && self.nodes[self.stack[mark]].kind != Kind.mapentry &&
                self.array_cast_ahead() {
                // [N]T(value): an array type called as a cast, admitted only as a callee
                ty: u32 = self.make(Kind.array_t, t)
                self.nodes[ty].b = self.stack[mark]
                self.nstack = mark
                self.nodes[ty].a = self.parse_type()
                return ty
            }
            self.close(al, mark)
            return al
        }
        Token.lbrace { // bare struct literal
            if (ctx & NOSLIT) != 0 { self.fail("unexpected '{' \u{2014} struct literals need a type or parentheses here") }
            return self.structlit(0)
        }
        default {
            self.fail_got("expected expression, got ")
            return 0
        }
    }
}

/* The index just past the bracket run opening at `k` ahead; 0 at eof. */
Parser.past_brackets(self, k: usize): usize {
    j: usize = k
    depth: int = 0
    for {
        t: Token = self.kth(j)
        if t == Token.eof { return 0 }
        if t == Token.lbrack {
            depth += 1
        } else if t == Token.rbrack {
            depth -= 1
            if depth == 0 { return j + 1 }
        }
        j += 1
    }
}

/* The tokens ahead spell an element type called as a cast, `T(`, `*T(`,
 * `[2]T(`, or `m.T[A](`: after a one-element array literal they make it the
 * length of an array type called as a cast ([N]T(value)).
 */
Parser.array_cast_ahead(self): bool {
    k: usize = 0
    for {
        t: Token = self.kth(k)
        if t == Token.star || t == Token.const {
            k += 1
        } else if t == Token.lbrack {
            k = self.past_brackets(k)
            if k == 0 { return false }
        } else {
            break
        }
    }
    if self.kth(k) != Token.ident { return false }
    k += 1
    for self.kth(k) == Token.dot && self.kth(k + 1) == Token.ident { k += 2 }
    if self.kth(k) == Token.lbrack {
        k = self.past_brackets(k)
        if k == 0 { return false }
    }
    return self.kth(k) == Token.lparen
}

/* Tokens that may start a slice conversion's element type after `[]`. */
slice_type_start(k: Token): bool {
    return k == Token.ident || k == Token.star || k == Token.lbrack ||
        k == Token.lparen || k == Token.const
}

// --- statements ---------------------------------------------------------------

/* The current token's line (the last token's once past the end). */
Parser.line(self): u32 {
    t: usize = self.i >= self.ntok ? self.ntok - 1 : self.i
    return self.toks[t].line
}

Parser.skipnl(self) {
    for self.at(Token.newline) { self.i += 1 }
}

Parser.bare_list_line(self, line: u32) {
    if self.line() != line { self.fail("bare comma-separated lists must stay on one physical line") }
}

/* One expression, or a bare comma list of them as a tuple. */
Parser.expr_list(self, ctx: int): u32 {
    first: usize = self.i
    line: u32 = self.line()
    mark: usize = self.nstack
    self.push(self.expr(ctx))
    for self.at(Token.comma) {
        self.bare_list_line(line)
        self.i += 1
        self.bare_list_line(line)
        self.push(self.expr(0))
    }
    if self.nstack - mark == 1 {
        x: u32 = self.stack[mark]
        self.nstack = mark
        return x
    }
    tu: u32 = self.make(Kind.tuple, first)
    self.close(tu, mark)
    return tu
}

Parser.stmt_end(self) {
    if !self.eat(Token.newline) && !self.at(Token.rbrace) && !self.at(Token.eof) {
        self.fail_got("expected newline or '}' after statement, got ")
    }
}

Parser.parse_if(self): u32 {
    n: u32 = self.nd(Kind.if)
    self.expect(Token.if, "'if'")
    self.nodes[n].a = self.expr(NOSLIT)
    self.nodes[n].b = self.block()
    if self.at(Token.else) { // must be on the '}' line (the lexer emits a newline otherwise)
        self.i += 1
        self.nodes[n].c = self.at(Token.if) ? self.parse_if() : self.block()
    }
    return n
}

/* Scans an `ident ':'` for-head: a depth-0 `in` selects typed binders; a
 * depth-0 `=` or `;` selects a declaration init. Bounded, never backtracking.
 */
Parser.for_head_typed_at(self): bool {
    j: usize = self.i + 2 // past the binder name and ':'
    depth: int = 0
    for j < self.ntok {
        k: Token = self.kinds[j]
        if depth == 0 {
            if k == Token.in { return true }
            if k == Token.assign || k == Token.semi || k == Token.lbrace || k == Token.newline || k == Token.eof { return false }
        }
        if k == Token.lbrack || k == Token.lparen || k == Token.lbrace {
            depth += 1
        } else if k == Token.rbrack || k == Token.rparen || k == Token.rbrace {
            if depth == 0 { return false }
            depth -= 1
        }
        j += 1
    }
    return false
}

Parser.for_semi(self, hline: u32, what: string) {
    if self.line() != hline { self.fail("for-head clauses must stay on one physical line") }
    self.expect(Token.semi, what)
}

/* The three-clause tail after the init: [cond] ';' [post] block. */
Parser.for_tail(self, n: u32, hline: u32) {
    if !self.at(Token.semi) && !self.at(Token.lbrace) {
        self.nodes[n].b = self.expr(NOSLIT)
    }
    self.for_semi(hline, "';' after the for-head condition")
    if !self.at(Token.lbrace) {
        self.nodes[n].c = self.expr_stmt(NOSLIT)
    }
    if self.line() != hline { self.fail("for-head clauses must stay on one physical line") }
    self.nodes[n].d = self.block()
}

/* The head after `for`, told apart by bounded lookahead: `{` infinite, `;`
 * three-clause with no init, `ident ':'` typed binders or a declaration init,
 * otherwise a condition or an assignment/expression-statement init.
 */
// The range tail `.. b [step c]` of a for-head whose first endpoint is `a`.
Parser.for_range(self, a: u32): u32 {
    r: u32 = self.nd(Kind.range) // at '..', like a binary node
    self.i += 1
    self.nodes[r].a = a
    self.nodes[r].b = self.expr(NOSLIT)
    if self.ident_at(0, "step") {
        self.i += 1
        self.nodes[r].c = self.expr(NOSLIT)
    }
    return r
}

Parser.for_head(self, n: u32): u32 {
    hline: u32 = self.line()
    if self.at(Token.lbrace) { // infinite: exits only via break/return
        self.nodes[n].flags |= F_FORGEN
        self.nodes[n].d = self.block()
        return n
    }
    if self.at(Token.semi) { // three-clause with an empty init
        self.nodes[n].flags |= F_FORGEN
        self.i += 1
        self.for_tail(n, hline)
        return n
    }
    if self.at(Token.ident) && self.kth(1) == Token.colon && self.for_head_typed_at() {
        line: u32 = self.line()
        mark: usize = self.nstack
        for {
            v: usize = self.expect(Token.ident, "loop variable name")
            binder: u32 = self.ident_node(Kind.param, v)
            self.expect(Token.colon, "':' after loop variable")
            self.nodes[binder].a = self.parse_type()
            self.push(binder)
            if !self.at(Token.comma) { break }
            self.bare_list_line(line)
            self.i += 1
            self.bare_list_line(line)
            if self.nstack - mark == 2 { self.fail("for-in accepts at most index and value binders") }
            if self.failed { break }
        }
        self.close(n, mark)
        self.expect(Token.in, "'in'")
        it: u32 = self.expr(NOSLIT)
        if self.at(Token.dot_dot) { it = self.for_range(it) }
        self.nodes[n].b = it
        self.nodes[n].c = self.block()
        return n
    }
    self.nodes[n].flags |= F_FORGEN
    if self.at(Token.ident) && self.kth(1) == Token.colon { // declaration init
        name: usize = self.i
        self.i += 1 // ident; decl_stmt consumes ':'
        self.nodes[n].a = self.decl_stmt(name)
    } else {
        start: usize = self.i
        e: u32 = self.expr(NOSLIT)
        if self.at(Token.dot_dot) { // binder-less range: `for 0 .. n`
            self.nodes[n].flags &= ~F_FORGEN
            self.nodes[n].b = self.for_range(e)
            self.nodes[n].c = self.block()
            return n
        }
        a: u32 = self.expr_stmt_from(NOSLIT, start, e)
        self.nodes[n].a = a
        if self.at(Token.lbrace) { // condition only: the expression is the condition
            self.nodes[n].b = self.nodes[a].a
            self.nodes[n].a = 0
            self.nodes[n].d = self.block()
            return n
        }
    }
    self.for_semi(hline, "';' after the for-head initializer")
    self.for_tail(n, hline)
    return n
}

/* At a union-variant case pattern `Type.variant(binder: T)`, qualified and
 * generic bases included: a bounded scan for the `(` opening the binder.
 */
Parser.variant_binder_at(self): bool {
    j: usize = self.i
    if self.kind_at(j) != Token.ident { return false }
    j += 1
    segments: int = 1
    for {
        for self.kind_at(j) == Token.lbrack { // generic arguments
            depth: int = 0
            for j < self.ntok {
                k: Token = self.kinds[j]
                j += 1
                if k == Token.lbrack {
                    depth += 1
                } else if k == Token.rbrack {
                    depth -= 1
                    if depth == 0 { break }
                }
            }
        }
        if self.kind_at(j) == Token.dot && member_kind(self.kind_at(j + 1)) {
            j += 2
            segments += 1
            continue
        }
        break
    }
    if segments < 2 { return false }
    if j + 2 >= self.ntok { return false }
    return self.kinds[j] == Token.lparen && self.kinds[j + 1] == Token.ident &&
        (self.kinds[j + 2] == Token.colon || self.kinds[j + 2] == Token.rparen)
}

/* `Type.variant(binder: T)`: the variant reference keeps the field shape
 * sema resolves for construction; the binder rides in b.
 */
Parser.variant_pattern(self): u32 {
    base: u32 = 0 // qualified chain of the segments before the variant
    seg: usize = 0
    for {
        first: bool = base == 0 && !self.at(Token.dot)
        if self.at(Token.dot) { self.i += 1 } // separator before the next segment
        seg = first ? self.expect(Token.ident, "type or variant name") :
            self.expect_member("type or variant name")
        if self.at(Token.lparen) || self.failed { break } // the variant name
        node: u32 = self.ident_node(Kind.ident, seg)
        if base != 0 {
            q: u32 = self.ident_node(Kind.selector, seg)
            self.nodes[q].a = base
            base = q
        } else {
            base = node
        }
        if self.at(Token.lbrack) { // generic arguments on this segment
            self.i += 1
            ix: u32 = self.nd(Kind.index)
            self.nodes[ix].a = base
            mark: usize = self.nstack
            for {
                self.push(self.parse_type())
                if !self.eat(Token.comma) || self.at(Token.rbrack) { break }
            }
            self.expect(Token.rbrack, "']' to close type arguments")
            self.close(ix, mark)
            base = ix
        }
    }
    vp: u32 = self.make(Kind.varpat, seg)
    ref: u32 = self.ident_node(Kind.selector, seg)
    self.nodes[ref].a = base
    self.nodes[vp].a = ref
    self.i += 1 // '('
    bname: usize = self.expect(Token.ident, "binder name")
    binder: u32 = self.ident_node(Kind.param, bname)
    if self.eat(Token.colon) { // `Variant(k)` is a typeless binder; sema diagnoses it
        self.nodes[binder].a = self.parse_type()
    }
    self.nodes[vp].b = binder
    self.expect(Token.rparen, "')' to close variant pattern")
    return vp
}

/* A case opening with `(` whose matching `)` encloses a top-level comma is a
 * parenthesized case list, never a tuple: no switch value is a tuple.
 */
Parser.case_list_at(self): bool {
    if !self.at(Token.lparen) { return false }
    depth: int = 0
    for j: usize in self.i..self.ntok {
        k: Token = self.kinds[j]
        if k == Token.lparen || k == Token.lbrack || k == Token.lbrace {
            depth += 1
        } else if k == Token.rparen || k == Token.rbrack || k == Token.rbrace {
            depth -= 1
            if depth == 0 { return false }
        } else if k == Token.comma && depth == 1 {
            return true
        } else if k == Token.eof {
            return false
        }
    }
    return false
}

Parser.parse_switch(self): u32 {
    n: u32 = self.nd(Kind.switch)
    self.expect(Token.switch, "'switch'")
    self.nodes[n].a = self.expr(NOSLIT)
    self.expect(Token.lbrace, "'{' to open switch body")
    cases: usize = self.nstack
    self.skipnl()
    for !self.at(Token.rbrace) {
        if self.at(Token.eof) {
            self.fail("unexpected end of file in switch body")
            break
        }
        c: u32 = self.nd(Kind.case)
        if self.at(Token.default) {
            self.i += 1
            self.nodes[c].flags |= F_DEFAULT
        } else if self.at(Token.else) {
            self.fail("'else' is not a switch case; use 'default'")
        } else {
            mark: usize = self.nstack
            line: u32 = self.line()
            multi: bool = self.case_list_at() // `(` patterns across lines `)`
            if multi { self.i += 1 }
            for {
                if self.variant_binder_at() {
                    self.push(self.variant_pattern())
                } else {
                    v: u32 = self.expr(NOSLIT)
                    if self.at(Token.dot_dot) { // `lo .. hi`: the half-open values between
                        r: u32 = self.nd(Kind.range) // at '..', like a loop range
                        self.i += 1
                        self.nodes[r].a = v
                        self.nodes[r].b = self.expr(NOSLIT)
                        v = r
                    }
                    self.push(v)
                }
                if !self.at(Token.comma) { break }
                if !multi { self.bare_list_line(line) }
                self.i += 1
                if multi && self.at(Token.rparen) { break }
                if !multi { self.bare_list_line(line) }
                if self.failed { break }
            }
            if multi {
                if self.line() == line { self.fail("parentheses around case values are only for multiline lists") }
                self.expect(Token.rparen, "')' to close case values")
            }
            self.close(c, mark)
        }
        b: u32 = self.block()
        self.nodes[c].b = b
        // `fallthrough` is contextual only as a bare statement directly in a
        // case block; any other use is an identifier. Sema checks position.
        x: Node = self.nodes[b]
        for k: u32 in 0..x.nkids {
            st: u32 = self.kids[x.kids + k]
            if self.nodes[st].kind != Kind.exprstmt || !self.is_ident(self.nodes[st].a, "fallthrough") { continue }
            id: u32 = self.nodes[st].a
            self.nodes[st].kind = Kind.fallthrough
            self.nodes[st].a = 0
            self.named(st, self.nodes[id].text)
        }
        self.push(c)
        self.skipnl()
    }
    self.i += 1 // '}'
    self.close(n, cases)
    return n
}

Parser.parse_asm(self): u32 {
    n: u32 = self.nd(Kind.asm)
    self.expect(Token.asm, "'asm'")
    s: usize = self.expect(Token.string, "instruction string after 'asm'")
    self.named(n, self.toks[s].text)
    self.expect(Token.lbrace, "'{' to open asm bindings")
    binds: usize = self.nstack
    self.skipnl()
    for !self.at(Token.rbrace) {
        if self.at(Token.eof) {
            self.fail("unexpected end of file in asm block")
            break
        }
        kind: string = ""
        regs: bool = false // in/out bind registers to values
        if self.at(Token.in) { // `in` is a keyword; accept it as the binding kind
            kind = "in"
            regs = true
            self.i += 1
        } else if self.at(Token.ident) {
            kind = self.toks[self.i].text
            regs = mem.equal(kind, "out")
            if !regs && !mem.equal(kind, "clobbers") {
                self.fail_at(self.i, ["expected in/out/clobbers binding, got '", kind, "'"])
            }
            self.i += 1
        } else {
            self.fail_got("expected in/out/clobbers binding, got ")
        }
        bnd: u32 = self.nd(Kind.asmbind)
        self.named(bnd, kind)
        self.expect(Token.colon, "':' after binding kind")
        mark: usize = self.nstack
        for {
            reg: usize = self.expect(Token.ident, "register name")
            self.push(self.ident_node(Kind.ident, reg))
            if regs {
                self.expect(Token.assign, "'=' in register binding")
                if self.at(Token.int) { // x16 = 3: an immediate operand
                    imm: u32 = self.leaf(Kind.int_lit)
                    self.nodes[imm].ival = self.toks[self.i - 1].ival
                    self.push(imm)
                } else {
                    v: usize = self.expect(Token.ident, "value name")
                    self.push(self.ident_node(Kind.ident, v))
                }
            }
            if !self.eat(Token.comma) || self.at(Token.rbrace) || self.at(Token.newline) { break }
        }
        self.close(bnd, mark)
        self.push(bnd)
        if !self.eat(Token.newline) && !self.at(Token.rbrace) { self.fail("expected newline or '}' after asm binding") }
        self.skipnl()
    }
    self.i += 1 // '}'
    self.close(n, binds)
    return n
}

/* x: T = e | x: const T = e | n: T, m: U = f() (typed destructuring), after
 * the first name (token `first`).
 */
Parser.decl_stmt(self, first: usize): u32 {
    n: u32 = self.make(Kind.var, first)
    mark: usize = self.nstack
    is_const: bool = false
    name: usize = first
    for {
        if self.at(Token.colon) {
            self.i += 1
            if self.at(Token.const) {
                is_const = true
                self.i += 1
            }
            binder: u32 = self.ident_node(Kind.param, name)
            self.nodes[binder].a = self.parse_type()
            self.push(binder)
        } else {
            self.push(self.ident_node(Kind.ident, name))
            self.nodes[n].flags |= F_MIXED
        }
        if !self.at(Token.comma) || self.failed { break }
        self.bare_list_line(self.toks[first].line)
        self.i += 1
        self.bare_list_line(self.toks[first].line)
        name = self.expect(Token.ident, "binder name after ','")
    }
    if is_const { self.nodes[n].flags |= F_CONST }
    count: usize = self.nstack - mark
    staticmap: bool = count == 1 && self.nodes[self.stack[mark]].a != 0 &&
        self.nodes[self.nodes[self.stack[mark]].a].kind == Kind.staticmap_t
    self.close(n, mark)
    if self.eat(Token.assign) {
        if count > 1 { self.nodes[n].flags |= F_MIXED }
        self.nodes[n].b = staticmap && self.at(Token.lbrace) ? self.staticmaplit() : self.expr_list(0)
    } else if count > 1 || (self.nodes[n].flags & F_MIXED) != 0 {
        self.fail("destructuring declaration requires an initializer")
    }
    return n
}

/* A `break`/`continue` with its optional label. */
Parser.jump(self, kind: Kind): u32 {
    n: u32 = self.leaf(kind)
    if self.at(Token.ident) {
        self.named(n, self.toks[self.i].text)
        self.i += 1
    }
    return n
}

Parser.stmt(self): u32 {
    switch self.kth(0) {
        Token.if { return self.parse_if() }
        Token.for {
            n: u32 = self.nd(Kind.for)
            self.expect(Token.for, "'for'")
            return self.for_head(n)
        }
        Token.switch { return self.parse_switch() }
        Token.asm { return self.parse_asm() }
        Token.threadlocal {
            self.fail("'threadlocal' applies only to module variables")
            return self.make(Kind.exprstmt, self.i)
        }
        Token.return {
            n: u32 = self.leaf(Kind.return)
            if !self.at(Token.newline) && !self.at(Token.rbrace) && !self.at(Token.eof) {
                self.nodes[n].a = self.expr_list(0)
            }
            return n
        }
        Token.break { return self.jump(Kind.break) }
        Token.continue { return self.jump(Kind.continue) }
        Token.defer {
            n: u32 = self.leaf(Kind.defer)
            self.nodes[n].a = self.expr(NOSLIT)
            return n
        }
        Token.ident {
            if self.kth(1) != Token.colon { return self.expr_stmt(0) }
            if self.kth(2) == Token.lbrace { // labeled block
                n: u32 = self.ident_node(Kind.label, self.i)
                self.i += 2
                self.nodes[n].a = self.block()
                return n
            }
            if self.kth(2) == Token.for { // labeled for: block-label namespace
                n: u32 = self.ident_node(Kind.for, self.i)
                self.i += 3 // label, ':', 'for'
                return self.for_head(n)
            }
            name: usize = self.i
            self.i += 1 // ident; decl_stmt consumes ':'
            return self.decl_stmt(name)
        }
        default { return self.expr_stmt(0) }
    }
}

is_assign_op(k: Token): bool {
    switch k {
        (
            Token.assign, Token.add_eq, Token.sub_eq, Token.mul_eq, Token.div_eq, Token.mod_eq,
            Token.and_eq, Token.or_eq, Token.xor_eq, Token.shl_eq, Token.shr_eq,
        ) { return true }
        default { return false }
    }
}

/* An expression-led statement: an assignment (single or destructuring) or a
 * bare expression. Shared with for-head clauses, which rely on it never
 * producing a declaration; they pass NOSLIT, as the body's '{' follows.
 */
Parser.expr_stmt(self, ctx: int): u32 {
    start: usize = self.i
    return self.expr_stmt_from(ctx, start, self.expr(ctx))
}

/* expr_stmt after its leading expression `head`, which began at token `start`. */
Parser.expr_stmt_from(self, ctx: int, start: usize, head: u32): u32 {
    line: u32 = self.toks[start].line
    e: u32 = head
    if self.at(Token.comma) { // destructuring assignment, possibly mixed under `=`
        a: u32 = self.nd(Kind.assign)
        mark: usize = self.nstack
        self.push(e)
        for self.at(Token.comma) {
            self.bare_list_line(line)
            self.i += 1
            self.bare_list_line(line)
            if self.at(Token.ident) && self.kth(1) == Token.colon {
                binder: u32 = self.ident_node(Kind.param, self.i)
                self.i += 2
                self.nodes[binder].a = self.parse_type()
                self.push(binder)
                self.nodes[a].flags |= F_MIXED
            } else {
                self.push(self.expr(ctx))
            }
            if self.failed { break }
        }
        if (self.nodes[a].flags & F_MIXED) != 0 {
            for j: usize in mark..self.nstack {
                k: Kind = self.stack[j] != 0 ? self.nodes[self.stack[j]].kind : Kind.ident
                if k != Kind.ident && k != Kind.param { self.fail("mixed '=' left side accepts names only") }
            }
            self.nodes[a].kind = Kind.var
        }
        op: usize = self.expect(Token.assign, "'=' in assignment")
        self.nodes[a].op = self.kind_at(op)
        self.close(a, mark)
        r: u32 = self.expr_list(ctx)
        if self.nodes[a].kind == Kind.var {
            self.nodes[a].b = r
        } else {
            self.nodes[a].a = r
        }
        return a
    }
    if is_assign_op(self.kth(0)) { // single-target assignment, compound included
        a: u32 = self.nd(Kind.assign)
        self.nodes[a].op = self.kinds[self.i]
        if e != 0 && self.nodes[e].kind == Kind.unary && self.nodes[e].op == Token.volatile {
            if self.nodes[a].op != Token.assign { self.fail("volatile access supports only simple '=' assignment") }
            self.nodes[a].flags |= F_VOLATILE
            e = self.nodes[e].a
        }
        self.i += 1
        mark: usize = self.nstack
        self.push(e)
        self.close(a, mark)
        self.nodes[a].a = self.expr(ctx)
        return a
    }
    n: u32 = self.make(Kind.exprstmt, start)
    self.nodes[n].a = e
    return n
}

pub Parser.block(self): u32 {
    b: u32 = self.nd(Kind.block)
    self.expect(Token.lbrace, "'{'")
    mark: usize = self.nstack
    self.skipnl()
    for !self.at(Token.rbrace) {
        if self.at(Token.eof) {
            self.fail("unexpected end of file, expected '}'")
            break
        }
        start: usize = self.i
        held: usize = self.nstack
        s: u32 = self.stmt()
        self.stmt_end()
        if self.failed {
            self.resume(start, held, false)
        } else {
            self.push(s)
        }
        self.skipnl()
    }
    self.i += 1 // '}'
    self.close(b, mark)
    return b
}

// --- declarations -------------------------------------------------------------

/* Token `ti`'s text, clamped to the last token. */
Parser.text(self, ti: usize): string {
    t: usize = ti >= self.ntok ? self.ntok - 1 : ti
    return self.toks[t].text
}

/* The line of the token before the current one. */
Parser.prev_line(self): u32 {
    t: usize = self.i - 1 >= self.ntok ? self.ntok - 1 : self.i - 1
    return self.toks[t].line
}

/* Pushes a parameter list through its closing ')'. An explicit receiver
 * `self` is an untyped first parameter (a == 0); only a method
 * or contract method accepts one.
 */
Parser.params(self, closer: string, self_ok: bool) {
    mark: usize = self.nstack
    if !self.at(Token.rparen) {
        for {
            pa: u32 = self.nd(Kind.param)
            if self.eat(Token.noalias) { self.nodes[pa].flags |= F_NOALIAS }
            if self.at(Token.const) && self.kth(1) == Token.self {
                self.nodes[pa].flags |= F_CONST // a receiver the method does not write
                self.i += 1
            }
            if self.at(Token.self) {
                if !self_ok { self.fail("'self' is only the receiver of a method declaration") }
                if self.nstack != mark { self.fail("'self' must be the first parameter") }
                if (self.nodes[pa].flags & F_NOALIAS) != 0 { self.fail("'noalias' does not apply to the receiver 'self'") }
                self.nodes[pa].flags |= F_BYADDR // every receiver is the caller's storage, by address
                self.i += 1
                if self.at(Token.colon) { self.fail("'self' takes no type; its type is the method's owner") }
                self.named(pa, "self")
                self.push(pa)
                if !self.eat(Token.comma) || self.at(Token.rparen) { break }
                continue
            }
            name: usize = self.expect(Token.ident, "parameter name")
            self.named(pa, self.text(name))
            self.expect(Token.colon, "':' after parameter name")
            self.nodes[pa].a = self.parse_type()
            if self.nodes[self.nodes[pa].a].kind == Kind.const_t { // a parameter the function does not write
                self.nodes[pa].flags |= F_CONST
                self.nodes[pa].a = self.nodes[self.nodes[pa].a].a
            }
            self.push(pa)
            if !self.eat(Token.comma) || self.at(Token.rparen) { break } // trailing comma
        }
    }
    self.expect(Token.rparen, closer)
}

Parser.ret(self): u32 {
    if !self.eat(Token.colon) { return 0 }
    if self.at_void() {
        self.fail("a function with no return value omits its return clause; 'void' is only a function type's return")
        return 0
    }
    return self.parse_type()
}

/* At `@name`. */
Parser.named_attr_at(self, name: string): bool {
    return self.at(Token.at) && self.ident_at(1, name)
}

/* @align(expr) or @offset(expr), with its required terminating line. */
Parser.layout_attr(self, name: string): u32 {
    self.expect(Token.at, "'@' before a layout attribute")
    if !self.ident_at(0, name) { self.fail_at(self.i, ["expected @", name, " attribute"]) }
    self.i += 1
    self.expect(Token.lparen, "'(' after a layout attribute")
    value: u32 = self.expr(0)
    self.expect(Token.rparen, "')' after a layout attribute expression")
    line: u32 = self.prev_line()
    self.skipnl()
    if self.line() == line { self.fail_at(self.i, ["@", name, " must occupy its own line before a declaration or field"]) }
    return value
}

/* A type-parameter list `[T, U]` (identifiers only), when one starts here. */
Parser.tparams(self): u32 {
    if !self.at(Token.lbrack) || self.kth(1) != Token.ident { return 0 }
    j: usize = self.i + 1
    ok: bool = false
    for self.kind_at(j) == Token.ident {
        j += 1
        if self.kind_at(j) == Token.comma {
            j += 1
            continue
        }
        ok = self.kind_at(j) == Token.rbrack
        break
    }
    if !ok || self.failed { return 0 }
    tp: u32 = self.nd(Kind.tparams)
    mark: usize = self.nstack
    self.i += 1 // '['
    for {
        self.push(self.ident_node(Kind.ident, self.expect(Token.ident, "type parameter")))
        if !self.eat(Token.comma) || self.at(Token.rbrack) { break }
    }
    self.i += 1 // ']'
    self.close(tp, mark)
    return tp
}

/* `as "name"` after a C-boundary signature or type: the linker symbol when
 * it differs from the Ace-side name; "" when absent.
 */
Parser.link_name(self): string {
    if !self.ident_at(0, "as") { return "" } // an identifier fits: IDENT_MAX < 510
    self.i += 1
    link: string = self.text(self.expect(Token.string, "link name string after 'as'"))
    if link.len == 0 { self.fail("extern link name cannot be empty") }
    nul: usize, found: bool = str.find(link, '\0')
    if found { self.fail("extern link name cannot contain NUL") }
    // The emitter prefixes the Mach-O underscore in a 512-byte buffer.
    if link.len > 510 { self.fail("extern link name cannot exceed 510 bytes") }
    return link
}

Parser.func_rest(self, name: usize, tp: u32, pub_: bool, expo: bool, self_ok: bool): u32 {
    f: u32 = self.ident_node(Kind.func, name)
    if pub_ { self.nodes[f].flags |= F_PUB }
    if expo { self.nodes[f].flags |= F_EXPO }
    self.nodes[f].c = tp
    self.expect(Token.lparen, "'(' after function name")
    mark: usize = self.nstack
    self.params("')' to close parameters", self_ok)
    self.close(f, mark)
    self.nodes[f].a = self.ret()
    if expo { self.nodes[f].cname = self.link_name() } // an export's C symbol
    if self.eat(Token.specialized) {
        self.nodes[f].flags |= F_SPECIALIZED // no-default template: no body follows
        return f
    }
    if self.eat(Token.intrinsic) {
        self.nodes[f].flags |= F_INTRINSIC // compiler-owned implementation; no source body
        return f
    }
    self.nodes[f].b = self.block()
    return f
}

/* The owner `Name[T, ...]` as a type, its arguments the type parameters. */
Parser.owner_type(self, name: usize, tp: u32): u32 {
    t: u32 = self.ident_node(Kind.named, name)
    if tp != 0 {
        mark: usize = self.nstack
        for k: u32 in 0..self.nodes[tp].nkids {
            a: u32 = self.nd(Kind.named)
            self.named(a, self.nodes[self.kid(tp, k)].text)
            self.push(a)
        }
        self.close(t, mark)
    }
    return t
}

/* Type.name(...): a method when its first parameter is the receiver `self`
 * (typed here as the owner), otherwise an associated function.
 */
Parser.type_func_rest(self, owner: usize, tp: u32, pub_: bool): u32 {
    self.expect(Token.dot, "'.' after function owner")
    name: usize = self.expect_member("function name after '.'")
    f: u32 = self.func_rest(name, tp, pub_, false, true)
    d: u32 = self.owner_type(owner, tp)
    self.nodes[f].d = d
    if self.nodes[f].nkids != 0 && self.nodes[self.kid(f, 0)].a == 0 {
        recv: u32 = self.kid(f, 0)
        self.nodes[f].flags |= F_METHOD
        self.nodes[recv].a = d
    } else {
        self.nodes[f].flags |= F_ASSOC
    }
    return f
}

Parser.signing_list_line(self, line: u32) {
    if self.line() != line { self.fail("bare signed-contract lists must stay on one line; use parentheses for a multiline list") }
}

Parser.signing(self, owner: usize, tp: u32, pub_: bool): u32 {
    n: u32 = self.make(Kind.signing, owner)
    self.nodes[n].a = self.owner_type(owner, tp)
    self.nodes[n].c = tp
    if pub_ { self.nodes[n].flags |= F_PUB }
    sline: u32 = self.line()
    self.expect(Token.signs, "'signs'")
    mark: usize = self.nstack
    if self.eat(Token.lparen) {
        if self.at(Token.rparen) { self.fail("a signing needs at least one contract") }
        for {
            c: u32 = self.nd(Kind.conformance)
            self.nodes[c].a = self.parse_type()
            self.push(c)
            if !self.eat(Token.comma) || self.at(Token.rparen) { break }
        }
        if self.line() == sline { self.fail("parentheses after 'signs' are only for multiline contract lists") }
        self.expect(Token.rparen, "')' to close signed contracts")
    } else {
        if self.at(Token.newline) || self.at(Token.eof) { self.fail("a signing needs at least one contract") }
        for {
            self.signing_list_line(sline)
            c: u32 = self.nd(Kind.conformance)
            self.nodes[c].a = self.parse_type()
            self.push(c)
            if self.prev_line() != sline {
                self.fail("bare signed-contract lists must stay on one line; use parentheses for a multiline list")
            }
            if !self.at(Token.comma) { break }
            self.signing_list_line(sline)
            self.i += 1
            self.signing_list_line(sline)
        }
    }
    self.close(n, mark)
    return n
}

Parser.bits_decl(self, name: usize, tp: u32, pub_: bool): u32 {
    if tp != 0 { self.fail("bits types are not generic") }
    self.i += 1
    n: u32 = self.ident_node(Kind.bits, name)
    if pub_ { self.nodes[n].flags |= F_PUB }
    self.nodes[n].a = self.parse_type()
    self.expect(Token.lbrace, "'{' after bits backing type")
    mark: usize = self.nstack
    if !self.at(Token.rbrace) {
        for {
            fl: u32 = self.ident_node(Kind.field, self.expect_member("bit-field name or '_'"))
            self.expect(Token.colon, "':' after bit-field name")
            if self.ident_at(0, "signed") {
                self.nodes[fl].flags |= F_CONST
                self.i += 1
            }
            width: usize = self.expect(Token.int, "positive bit-field width")
            if !self.failed { self.nodes[fl].ival = self.toks[width].ival }
            self.push(fl)
            if !self.eat(Token.comma) || self.at(Token.rbrace) { break }
        }
    }
    self.expect(Token.rbrace, "'}' to close bits type")
    self.close(n, mark)
    return n
}

Parser.struct_decl(self, name: usize, tp: u32, pub_: bool): u32 {
    self.i += 1
    n: u32 = self.ident_node(Kind.struct, name)
    self.nodes[n].c = tp
    if pub_ { self.nodes[n].flags |= F_PUB }
    self.expect(Token.lbrace, "'{' after 'struct'")
    mark: usize = self.nstack
    if !self.at(Token.rbrace) {
        for {
            offset: u32 = 0
            align: u32 = 0
            if self.named_attr_at("offset") {
                offset = self.layout_attr("offset")
                if self.named_attr_at("offset") { self.fail("a field accepts at most one @offset attribute") }
            }
            if self.named_attr_at("align") {
                align = self.layout_attr("align")
                if self.named_attr_at("align") { self.fail("a field accepts at most one @align attribute") }
                if self.named_attr_at("offset") { self.fail("@offset precedes @align on a field") }
            } else if self.at(Token.at) {
                self.fail("only @offset and @align may modify a struct field")
            }
            field_pub: bool = self.at(Token.pub) && self.kth(1) != Token.colon && self.eat(Token.pub) // `pub: T` names a field
            embedded: bool = self.at(Token.embed) && self.kth(1) != Token.colon && self.eat(Token.embed) // `embed: T` names a field
            fl: u32 = self.ident_node(Kind.field, self.expect_member("field name"))
            if embedded { self.nodes[fl].flags |= F_EMBED }
            if field_pub { self.nodes[fl].flags |= F_PUB }
            self.nodes[fl].b = align
            self.nodes[fl].d = offset
            self.expect(Token.colon, "':' after field name")
            self.nodes[fl].a = self.parse_type()
            if self.eat(Token.assign) { self.nodes[fl].c = self.expr(0) }
            self.push(fl)
            if !self.eat(Token.comma) || self.at(Token.rbrace) { break } // trailing comma
        }
    }
    self.expect(Token.rbrace, "'}' to close struct")
    self.close(n, mark)
    return n
}

Parser.contract_decl(self, name: usize, tp: u32, pub_: bool): u32 {
    self.i += 1
    n: u32 = self.ident_node(Kind.contract, name)
    self.nodes[n].c = tp
    if pub_ { self.nodes[n].flags |= F_PUB }
    self.expect(Token.lbrace, "'{' after 'contract'")
    methods: usize = self.nstack
    self.skipnl()
    for !self.at(Token.rbrace) {
        if self.at(Token.eof) {
            self.fail("unexpected end of file in contract")
            break
        }
        m: u32 = self.nd(Kind.method)
        mname: usize = self.expect_member("method name")
        self.named(m, self.text(mname))
        self.expect(Token.lparen, "'(' after method name")
        mark: usize = self.nstack
        self.params("')' to close method parameters", true)
        if self.nstack == mark || self.nodes[self.stack[mark]].a != 0 {
            self.fail_at(mname, ["a contract method's first parameter is its receiver 'self'"])
        }
        if self.failed { break }
        // the receiver stays implied in the contract's method node
        self.close(m, mark + 1)
        self.nstack = mark
        self.nodes[m].a = self.ret()
        self.push(m)
        if !self.eat(Token.newline) && !self.at(Token.rbrace) { self.fail("expected newline or '}' after method") }
        self.skipnl()
    }
    self.i += 1 // '}'
    self.close(n, methods)
    return n
}

Parser.enum_decl(self, name: usize, pub_: bool): u32 {
    self.i += 1
    n: u32 = self.ident_node(Kind.enum, name)
    if pub_ { self.nodes[n].flags |= F_PUB }
    if !self.at(Token.lbrace) { self.nodes[n].a = self.parse_type() }
    self.expect(Token.lbrace, "'{' after 'enum'")
    mark: usize = self.nstack
    if !self.at(Token.rbrace) {
        for {
            if self.at(Token.ident) && mem.equal(self.text(self.i), "_") {
                self.i += 1
                self.nodes[n].flags |= F_OPEN
                self.eat(Token.comma)
                if !self.at(Token.rbrace) { self.fail("'_' must be the last enum member") }
                break
            }
            m: u32 = self.ident_node(Kind.ident, self.expect_member("enum member"))
            if self.eat(Token.assign) { self.nodes[m].a = self.expr(0) }
            self.push(m)
            if !self.eat(Token.comma) || self.at(Token.rbrace) { break } // trailing comma
        }
    }
    self.expect(Token.rbrace, "'}' to close enum")
    self.close(n, mark)
    return n
}

Parser.union_decl(self, name: usize, tp: u32, pub_: bool): u32 {
    self.i += 1
    n: u32 = self.ident_node(Kind.union, name)
    self.nodes[n].c = tp
    if pub_ { self.nodes[n].flags |= F_PUB }
    self.expect(Token.lbrace, "'{' after 'union'")
    mark: usize = self.nstack
    if !self.at(Token.rbrace) {
        for {
            v: u32 = self.ident_node(Kind.variant, self.expect_member("variant name"))
            if self.eat(Token.colon) { self.nodes[v].a = self.parse_type() } // payload: exactly one explicit type
            self.push(v)
            if !self.eat(Token.comma) || self.at(Token.rbrace) { break } // trailing comma
        }
    }
    self.expect(Token.rbrace, "'}' to close union")
    self.close(n, mark)
    return n
}

Parser.error_decl(self, name: usize, pub_: bool): u32 {
    self.i += 1
    n: u32 = self.ident_node(Kind.error, name)
    if pub_ { self.nodes[n].flags |= F_PUB }
    if !self.eat(Token.lbrace) { return n }
    mark: usize = self.nstack
    self.skipnl()
    for !self.at(Token.rbrace) {
        if self.at(Token.eof) {
            self.fail("unexpected end of file in error domain")
            break
        }
        entry: u32 = self.nd(Kind.field)
        self.nodes[entry].a = self.expr(0)
        self.expect(Token.colon, "':' after error code")
        self.named(entry, self.text(self.expect_member("error entry name")))
        self.expect(Token.assign, "'=' after error entry name")
        self.nodes[entry].b = self.expr(0)
        self.push(entry)
        self.skipnl()
        if !self.eat(Token.comma) {
            if !self.at(Token.rbrace) { self.fail("expected ',' after error entry") }
            break
        }
        self.skipnl()
    }
    self.i += 1 // '}'
    self.close(n, mark)
    return n
}

/* A global `Name: [const] T [= value]`. */
Parser.global_decl(self, name: usize, pub_: bool): u32 {
    n: u32 = self.make(Kind.var, name)
    if pub_ { self.nodes[n].flags |= F_PUB }
    is_const: bool = self.eat(Token.const)
    if self.at(Token.ident) && self.kth(1) == Token.lbrace {
        self.fail_at(self.i, ["unknown declaration type '", self.text(self.i), "'"])
    }
    binder: u32 = self.ident_node(Kind.param, name)
    self.nodes[binder].a = self.parse_type()
    mark: usize = self.nstack
    self.push(binder)
    if is_const { self.nodes[n].flags |= F_CONST }
    self.close(n, mark)
    if self.eat(Token.assign) {
        a: u32 = self.nodes[binder].a
        staticmap: bool = a != 0 && self.nodes[a].kind == Kind.staticmap_t && self.at(Token.lbrace)
        self.nodes[n].b = staticmap ? self.staticmaplit() : self.expr_list(0)
    } else if is_const {
        self.fail("const declaration requires an initializer")
    }
    return n
}

/* After `Name:`, the kind word decides; otherwise a global var or const. */
Parser.colon_decl(self, name: usize, tp: u32, pub_: bool): u32 {
    self.i += 1 // ':'
    if self.ident_at(0, "bits") { return self.bits_decl(name, tp, pub_) }
    switch self.kth(0) {
        Token.struct { return self.struct_decl(name, tp, pub_) }
        Token.contract { return self.contract_decl(name, tp, pub_) }
        Token.enum { return self.enum_decl(name, pub_) }
        Token.union { return self.union_decl(name, tp, pub_) }
        Token.distinct {
            self.i += 1
            n: u32 = self.ident_node(Kind.distinct, name)
            if pub_ { self.nodes[n].flags |= F_PUB }
            self.nodes[n].a = self.parse_type()
            return n
        }
        Token.type { // alias: Name: type = Existing
            self.i += 1
            n: u32 = self.ident_node(Kind.alias, name)
            self.nodes[n].c = tp
            if pub_ { self.nodes[n].flags |= F_PUB }
            self.expect(Token.assign, "'=' after 'type'")
            self.nodes[n].a = self.parse_type()
            return n
        }
        default {
            if self.ident_at(0, "error") { return self.error_decl(name, pub_) }
            return self.global_decl(name, pub_)
        }
    }
}

/* A C-ABI definition `name(params): R { body }` from token `start`; the body
 * makes it an export rather than an import.
 */
Parser.extern_def(self, start: usize, pub_: bool): u32 {
    self.i = start
    self.i += 1
    tp: u32 = self.tparams() // sema rejects generics
    return self.func_rest(start, tp, pub_, true, false)
}

/* An exported C global after `name: T`: an ordinary global with C linkage. */
Parser.extern_global(self, name: usize, ty: u32, cname: string, pub_: bool): u32 {
    n: u32 = self.make(Kind.var, name)
    binder: u32 = self.ident_node(Kind.param, name)
    self.nodes[binder].a = ty
    mark: usize = self.nstack
    self.push(binder)
    self.close(n, mark)
    flags: u32 = F_EXPO
    self.nodes[binder].flags |= flags
    if pub_ { flags |= F_PUB }
    self.nodes[n].flags |= flags
    self.nodes[n].cname = cname
    self.nodes[binder].cname = cname
    self.expect(Token.assign, "'=' and an initializer: a C global defined in Ace")
    self.nodes[n].b = self.expr_list(0)
    return n
}

Parser.export(self, x: u32) {
    if self.nexport == self.exports.len { self.exports = grow[u32](self.exports) }
    self.exports[self.nexport] = x
    self.nexport += 1
}

Parser.extern_end(self) {
    if !self.eat(Token.newline) && !self.at(Token.rbrace) { self.fail("expected newline or '}' after extern declaration") }
    self.skipnl()
}

Parser.extern_block(self): u32 {
    n: u32 = self.nd(Kind.extern)
    self.expect(Token.extern, "'extern'")
    self.named(n, self.text(self.expect(Token.string, "ABI string after 'extern'")))
    self.expect(Token.lbrace, "'{' to open extern block")
    fns: usize = self.nstack
    self.nexport = 0
    self.skipnl()
    for !self.at(Token.rbrace) {
        if self.at(Token.eof) {
            self.fail("unexpected end of file in extern block")
            break
        }
        f: u32 = self.nd(Kind.externfn)
        start: usize = self.i
        def: bool = false // a body follows: an Ace definition with C linkage
        if self.at(Token.threadlocal) {
            self.fail("thread-local C variables are not supported; bind the C library's accessor function")
            break
        }
        name: usize = self.expect(Token.ident, "name in extern block")
        self.named(f, self.text(name))
        if self.eat(Token.colon) { // a C global variable
            self.nodes[f].kind = Kind.externvar
            self.nodes[f].a = self.parse_type()
            self.nodes[f].cname = self.link_name()
            if self.at(Token.assign) {
                self.export(self.extern_global(name, self.nodes[f].a, self.nodes[f].cname, false))
                self.extern_end()
                continue
            }
        } else {
            if self.at(Token.lbrack) {
                def = true // generic: reparsed as a definition for sema to reject
            } else {
                self.expect(Token.lparen, "'(' after extern function name")
            }
            if !def && !self.at(Token.rparen) {
                mark: usize = self.nstack
                for {
                    pa: u32 = self.nd(Kind.param)
                    self.named(pa, self.text(self.expect(Token.ident, "parameter name")))
                    self.expect(Token.colon, "':' after parameter name")
                    self.nodes[pa].a = self.parse_type()
                    self.push(pa)
                    if !self.eat(Token.comma) { break }
                    if self.at(Token.dot_dot_dot) {
                        self.i += 1
                        self.nodes[f].flags |= F_VARARGS
                        break
                    }
                    if self.at(Token.rparen) { break } // trailing comma
                }
                self.close(f, mark)
            }
            if !def {
                self.expect(Token.rparen, "')' to close extern parameters")
                self.nodes[f].a = self.ret()
                self.nodes[f].cname = self.link_name()
                def = self.at(Token.lbrace)
            }
            if def {
                if (self.nodes[f].flags & F_VARARGS) != 0 { self.fail("variadic functions cannot be defined in Ace") }
                self.export(self.extern_def(start, false))
                self.extern_end()
                continue
            }
        }
        self.push(f)
        self.extern_end()
    }
    self.i += 1 // '}'
    self.close(n, fns)
    return n
}

/* `@name`, a compiler-reserved module, as a string node marked with '@'. */
Parser.internal_import(self): u32 {
    self.expect(Token.at, "'@'")
    name: usize = self.expect(Token.ident, "reserved module name after '@'")
    if self.at(Token.dot) { self.fail("reserved module imports omit the .ace suffix") }
    path: u32 = self.nd(Kind.str_lit)
    self.named(path, self.text(name))
    self.nodes[path].op = Token.at
    return path
}

/* A module path `a/b/c` from its consumed first segment: the chain head to
 * leaf, linked through each segment's `a`, and the leaf.
 */
Parser.import_path(self, first: usize): (u32, u32) {
    head: u32 = self.ident_node(Kind.ident, first)
    tail: u32 = head
    for self.at(Token.slash) {
        self.i += 1
        next: u32 = self.ident_node(Kind.ident, self.expect(Token.ident, "module path segment after '/'"))
        self.nodes[tail].a = next
        tail = next
    }
    return head, tail
}

/* An import's target after 'from' or ':': a module name, a path, or an
 * internal module; false when none is there.
 */
Parser.import_target(self, n: u32): bool {
    if self.at(Token.ident) {
        target: usize = self.i
        self.i += 1
        head: u32, leaf: u32 = self.import_path(target)
        self.nodes[n].c = head
        self.nodes[n].b = leaf
    } else if self.at(Token.string) {
        s: u32 = self.leaf(Kind.str_lit)
        self.named(s, self.text(self.i - 1))
        self.nodes[n].a = s
    } else if self.at(Token.at) {
        self.nodes[n].a = self.internal_import()
    } else {
        return false
    }
    return true
}

Parser.import(self): u32 {
    n: u32 = self.nd(Kind.import)
    self.expect(Token.import, "'import'")
    paren: bool = self.eat(Token.lparen)
    what: string = paren ? "imported member name" : "module or member name after 'import'"
    first: usize = self.expect(Token.ident, what)
    if paren || self.at(Token.comma) || self.ident_at(0, "from") {
        self.nodes[n].flags |= F_SELECT
        mark: usize = self.nstack
        self.push(self.ident_node(Kind.ident, first))
        if paren {
            for {
                if !self.eat(Token.comma) || self.at(Token.rparen) { break }
                self.push(self.ident_node(Kind.ident, self.expect(Token.ident, "imported member name")))
            }
            self.expect(Token.rparen, "')' after imported member list")
            if self.prev_line() == self.nodes[n].line {
                self.fail("parentheses in a selective import are only for a multiline member list")
            }
        } else {
            line: u32 = self.toks[first].line
            for self.at(Token.comma) {
                self.bare_list_line(line)
                self.i += 1
                self.bare_list_line(line)
                self.push(self.ident_node(Kind.ident, self.expect(Token.ident, "imported member name")))
            }
        }
        self.close(n, mark)
        if !self.ident_at(0, "from") { self.fail_got("expected 'from' after imported member list, got ") }
        self.i += 1
        if !self.import_target(n) { self.fail("expected module name, path, or internal module after 'from'") }
    } else {
        head: u32, leaf: u32 = self.import_path(first)
        self.nodes[n].c = head
        self.named(n, self.nodes[leaf].text)
    }
    if self.eat(Token.colon) {
        if (self.nodes[n].flags & F_SELECT) != 0 { self.fail("selective imports use 'from', not ':'") }
        // `m: math` alias, `util: "./util.ace"` path, `big: @bigint` reserved
        if !self.import_target(n) { self.fail("expected module name, path, or internal module after ':' in import") }
    }
    if !self.eat(Token.newline) && !self.at(Token.eof) { self.fail("expected newline after import") }
    return n
}

/* @when's deliberately closed evaluator: _PLATFORM_/string comparisons,
 * booleans, and/or/not, and parentheses. Inactive declarations are still
 * parsed for syntax, then omitted from the file.
 */
Parser.when_primary(self): bool {
    if self.eat(Token.true) { return true }
    if self.eat(Token.false) { return false }
    if self.eat(Token.lparen) {
        value: bool = self.when_or()
        self.expect(Token.rparen, "')' after @when expression")
        return value
    }
    if self.ident_at(0, "_PLATFORM_") {
        self.i += 1
        op: Token = self.kth(0)
        if op != Token.eq_eq && op != Token.bang_eq { self.fail("expected '==' or '!=' after _PLATFORM_ in @when expression") }
        self.i += 1
        value: string = self.text(self.expect(Token.string, "target string after comparison"))
        return mem.equal(self.target, value) == (op == Token.eq_eq)
    }
    if self.at(Token.ident) { self.fail_at(self.i, ["unknown @when compile-time name '", self.text(self.i), "'"]) }
    self.fail("expected target comparison, boolean, or parenthesized @when expression")
    return false
}

Parser.when_not(self): bool {
    if self.ident_at(0, "not") {
        self.i += 1
        return !self.when_not()
    }
    return self.when_primary()
}

Parser.when_and(self): bool {
    value: bool = self.when_not()
    for self.ident_at(0, "and") {
        self.i += 1
        rhs: bool = self.when_not() // parse even when the value is already false
        value = value && rhs
    }
    return value
}

Parser.when_or(self): bool {
    value: bool = self.when_and()
    for self.ident_at(0, "or") {
        self.i += 1
        rhs: bool = self.when_and() // parse even when the value is already true
        value = value || rhs
    }
    return value
}

Parser.when(self): bool {
    self.expect(Token.at, "'@'")
    if !self.ident_at(0, "when") { self.fail("only the @when attribute is supported") }
    self.i += 1
    self.expect(Token.lparen, "'(' after @when")
    active: bool = self.when_or()
    self.expect(Token.rparen, "')' after @when expression")
    line: u32 = self.prev_line()
    self.skipnl()
    if self.line() == line { self.fail("@when must occupy its own line before a declaration") }
    if self.at(Token.eof) { self.fail("@when must be followed by a top-level declaration") }
    return active
}

/* A bare attribute `@name` on its own line. */
Parser.own_line_attr(self, message: string) {
    self.i += 2
    line: u32 = self.prev_line()
    self.skipnl()
    if self.line() == line { self.fail(message) }
}

/* @cold, @packed, and @align(n) before a declaration: (packed, align, cold). */
Parser.layout_attrs(self): (bool, u32, bool) {
    packed: bool = false
    align: u32 = 0
    cold: bool = false
    for self.at(Token.at) {
        if self.named_attr_at("cold") {
            if cold { self.fail("a declaration accepts at most one @cold attribute") }
            self.own_line_attr("@cold must occupy its own line before a declaration")
            cold = true
            continue
        }
        if self.named_attr_at("packed") {
            if packed { self.fail("a declaration accepts at most one @packed attribute") }
            if align != 0 { self.fail("@packed must precede @align") }
            self.own_line_attr("@packed must occupy its own line before a declaration")
            packed = true
            continue
        }
        if self.named_attr_at("align") {
            if align != 0 { self.fail("a declaration accepts at most one @align attribute") }
            align = self.layout_attr("align")
            continue
        }
        if self.named_attr_at("when") { self.fail("@when must precede layout attributes") }
        self.fail("unknown top-level attribute")
    }
    return packed, align, cold
}

Parser.top(self): u32 {
    if self.at(Token.import) { self.fail("imports must precede declarations") }
    pub_: bool = false
    inl: bool = false
    tls: bool = false
    for {
        if self.at(Token.pub) {
            if inl { self.fail("visibility must come before 'inline'") }
            if tls { self.fail("visibility must come before 'threadlocal'") }
            if pub_ { self.fail("duplicate 'pub' modifier") }
            self.i += 1
            pub_ = true
        } else if self.at(Token.inline) {
            if inl { self.fail("duplicate 'inline' modifier") }
            self.i += 1
            inl = true
        } else if self.at(Token.threadlocal) {
            if tls { self.fail("duplicate 'threadlocal' modifier") }
            self.i += 1
            tls = true
        } else {
            break
        }
    }
    if tls && self.at(Token.extern) { self.fail("'threadlocal' applies only to module variables") }
    if self.at(Token.extern) && self.kth(1) == Token.string && self.kth(2) == Token.ident {
        // `extern "c" name(...) { body }` or `extern "c" name: T = value`
        self.i += 2
        if self.kth(1) == Token.colon {
            if inl { self.fail("'inline' applies only to function declarations") }
            name: usize = self.expect(Token.ident, "C global name")
            self.expect(Token.colon, "':' after C global name")
            ty: u32 = self.parse_type()
            cname: string = self.link_name()
            return self.extern_global(name, ty, cname, pub_)
        }
        if self.kth(1) == Token.dot { self.fail("methods and associated functions cannot use the C ABI") }
        f: u32 = self.extern_def(self.i, pub_)
        if inl { self.nodes[f].flags |= F_INLINE }
        return f
    }
    if self.at(Token.extern) {
        if pub_ || inl { self.fail("'extern' blocks take no pub/inline") }
        return self.extern_block()
    }
    if !self.at(Token.ident) { self.fail_got("expected declaration, got ") }
    start: usize = self.i
    d: u32 = self.top_named(pub_)
    if inl && !self.failed {
        if self.nodes[d].kind != Kind.func {
            self.fail_at(start, ["'inline' applies only to function declarations"]) // at the declaration's name
        }
        self.nodes[d].flags |= F_INLINE
    }
    if tls && !self.failed {
        if self.nodes[d].kind != Kind.var || (self.nodes[d].flags & F_CONST) != 0 {
            self.fail_at(start, ["'threadlocal' applies only to module variables"])
        }
        self.nodes[d].flags |= F_THREADLOCAL
    }
    return d
}

Parser.top_named(self, pub_: bool): u32 {
    name: usize = self.i
    self.i += 1
    if mem.equal(self.text(name), "static_assert") && self.at(Token.lparen) {
        self.i -= 1
        n: u32 = self.make(Kind.exprstmt, name)
        self.nodes[n].a = self.expr(0)
        return n
    }
    tp: u32 = self.tparams()
    if self.at(Token.signs) { return self.signing(name, tp, pub_) }
    if self.at(Token.dot) { return self.type_func_rest(name, tp, pub_) }
    if self.at(Token.lparen) { return self.func_rest(name, tp, pub_, false, false) }
    if self.at(Token.colon) { return self.colon_decl(name, tp, pub_) }
    self.fail_at(self.i, ["expected '(' or ':' after top-level name '", self.text(name), "'"])
    return 0
}

/* Parses the whole file for `target` (what @when compares against) and
 * returns its file node; on a syntax error, see `error`.
 */
pub Parser.parse(self, target: string): u32 {
    self.target = target
    file: u32 = self.make(Kind.file, 0)
    self.nodes[file].line = 1
    self.nodes[file].col = 1
    decls: usize = self.nstack
    self.skipnl()
    saw_declaration: bool = false
    for !self.at(Token.eof) {
        item: usize = self.i
        held: usize = self.nstack
        active: bool = true
        if self.named_attr_at("when") { active = self.when() }
        packed: bool, align: u32, cold: bool = self.layout_attrs()
        if self.at(Token.import) {
            if packed || align != 0 { self.fail("layout attributes do not apply to imports") }
            if cold { self.fail("@cold applies only to function declarations") }
            imp: u32 = self.import()
            if active {
                if saw_declaration { self.fail("imports must precede declarations") }
                self.push(imp)
            }
        } else {
            start: usize = self.i
            self.nexport = 0
            decl: u32 = self.top()
            x: Node = self.nodes[decl]
            if cold {
                if x.kind != Kind.func || (x.flags & F_EXPO) != 0 {
                    self.fail_at(start, ["@cold applies only to Ace function declarations"])
                }
                self.nodes[decl].flags |= F_COLD
            }
            if (packed || align != 0) && x.kind != Kind.struct {
                self.fail("layout attributes apply only to struct declarations")
            }
            if x.kind == Kind.struct {
                if packed { self.nodes[decl].flags |= F_PACKED }
                self.nodes[decl].b = align
            }
            if !self.eat(Token.newline) && !self.at(Token.eof) { self.fail_got("expected newline after declaration, got ") }
            if active && !self.failed {
                self.push(decl)
                if x.kind == Kind.extern {
                    for j: usize in 0..self.nexport { self.push(self.exports[j]) }
                }
                saw_declaration = true
            }
            self.nexport = 0
        }
        if self.failed {
            self.resume(item, held, true)
            self.nexport = 0
        }
        self.skipnl()
    }
    if self.errs.view().len > 0 {
        self.nstack = decls // C returns the file with no declarations
    }
    self.close(file, decls)
    return file
}

// --- dump ---------------------------------------------------------------------

/* Prints the tree at `n` as `ace --ast` does. */
pub Parser.dump(self, out: *Out, n: u32, ind: usize) {
    self.dump_tree(out, n, ind, false)
}

/* The same, with each link name and builtin mark shown, as `ace --resolved`
 * prints.
 */
pub Parser.dump_resolved(self, out: *Out, n: u32) {
    self.dump_tree(out, n, 0, true)
}

Parser.dump_tree(self, out: *Out, n: u32, ind: usize, cnames: bool) {
    for 0..ind { out.printf(" ") }
    if n == 0 {
        out.printf("nil\n")
        return
    }
    x: Node = self.nodes[n]
    out.printf("(%s", x.kind.name)
    if (x.flags & F_TEXT) != 0 {
        // C prints with "%.*s", which stops at an embedded NUL.
        nul: usize, found: bool = str.find(x.text, '\0')
        text: string = found ? x.text[..nul] : x.text
        out.printf(" '%s'", text)
    }
    switch x.kind {
        Kind.int_lit, Kind.char_lit, Kind.bool { out.printf(" %u", uint(x.ival)) }
        Kind.float_lit { out.printf(" %g", x.fval) }
        Kind.binary, Kind.unary, Kind.assign, Kind.op { out.printf(" op='%s'", lexer.disp(x.op)) }
        default {}
    }
    for j: usize in 0..FLAG_BITS.len {
        if (x.flags & FLAG_BITS[j]) != 0 { out.printf("%s", FLAG_NAMES[j]) }
    }
    if cnames && x.cname.len > 0 { out.printf(" cname='%s'", x.cname) }
    if cnames && x.kind == Kind.func && x.ival != 0 { out.printf(" builtin=%u", uint(x.ival)) }
    out.printf(" @%d:%d", int(x.line), int(x.col))
    // C tests the kids pointer: a contract method's points past its receiver,
    // and a merged file always owns a (possibly empty) kids array.
    if x.a == 0 && x.b == 0 && x.c == 0 && x.d == 0 && x.nkids == 0 && x.kind != Kind.method && !(cnames && x.kind == Kind.file) {
        out.printf(")\n")
        return
    }
    out.printf("\n")
    if x.a != 0 { self.dump_tree(out, x.a, ind + 1, cnames) }
    if x.b != 0 { self.dump_tree(out, x.b, ind + 1, cnames) }
    if x.c != 0 { self.dump_tree(out, x.c, ind + 1, cnames) }
    if x.d != 0 { self.dump_tree(out, x.d, ind + 1, cnames) }
    for k: u32 in 0..x.nkids { self.dump_tree(out, self.kids[x.kids + k], ind + 1, cnames) }
    for 0..ind { out.printf(" ") }
    out.printf(")\n")
}
