/* package — ace.pkg manifest parsing and dependency-graph resolution, as
 * src/package.c does it. A manifest is line-based `key: value` fields plus
 * [dependency] and [link] sections, each optionally qualified by a target.
 * Every dependency name in a graph is found from the root package's
 * directory as the nearest <dir>/pkg/<name>; a package's own pkg/ is not
 * part of it.
 */

import array
import crypto
import exec
import file
import fmt
import mem
import str
import sys

import path: "./path.ace"
import fail from "./failure.ace"

/* A direct dependency: its name, which is also its import alias, and the
 * package's index in the graph.
 */
pub Dep: struct {
    pub name: string,
    pub package: usize,
}

/* A [link] input: a canonical path when relative in the manifest, else as
 * written; a URL with the hash it is fetched to; or a framework name.
 */
pub Link: struct {
    pub value: string,
    pub framework: bool,
    pub line: int,
    pub sha256: string = "",
}

pub Package: struct {
    pub dir: string,                        // canonical package root directory
    pub name: string,
    pub ver_major: int,
    pub ver_minor: int,
    pub ver_patch: int,
    pub ace_major: int,
    pub ace_minor: int,
    pub is_exe: bool,
    pub is_archive: bool = false,           // a lib declaring `output: archive`
    pub is_shared: bool = false,            // a lib declaring `output: shared`
    pub root_file: string,                  // canonical path to the root .ace file
    pub test_dir: string,                   // canonical test directory, "" if absent
    pub test_rel: string,                   // the manifest's spelling of it, "" if absent
    pub description: string = "",           // "" when absent
    pub author: string = "",
    pub license: string = "",
    pub repository: string = "",
    pub deps: array.Array[Dep],
    pub links: array.Array[Link],
    pub link_unmet: bool = false,           // has [link] sections, none active for the target
}

/* A manifest field's value and line; line 0 when absent. */
Field: struct {
    value: string = "",
    line: int = 0,
}

/* A dependency entry; a negative line marks an inactive section's entry. */
RawDep: struct {
    alias: string,
    version: string,
    line: int,
}

/* One manifest's fields and entries, unvalidated. */
Raw: struct {
    name: Field,
    version: Field,
    ace: Field,
    type: Field,
    root: Field,
    test: Field,
    output: Field,
    description: Field,
    author: Field,
    license: Field,
    repository: Field,
    deps: array.Array[RawDep],
    links: array.Array[Link],
    link_any: bool = false,                 // a [link] section exists
    link_active: bool = false,              // one is active for the target
}

Raw.wipe(self) {
    self.deps.wipe()
    self.links.wipe()
}

/* A declared package name and its canonical directory. */
Name: struct {
    name: string,
    dir: string,
}

pub Graph: struct {
    pub errors: int = 0,
    target: string = "",                    // selects qualified sections
    std_dir: string = "",                   // the compiler's std/, for name collisions
    pool: path.Pool,
    pub pkgs: array.Array[Package],
    pub order: array.Array[usize],          // completed, dependencies first
    loading: array.Array[usize],            // in progress, for cycles
    names: array.Array[Name],
    root_dir: string = "",                  // every dependency resolves from here
    have_ace: bool = false,
    ace_major: int = 0,                     // the root's, shared by the whole graph
    ace_minor: int = 0,
}

/* An empty graph for `target`, checking names against `std_dir`. */
pub Graph.init(target: string, std_dir: string): Graph {
    return Graph { target = target, std_dir = std_dir, pool = blank(path.Pool), pkgs = array.Array[Package] {}, order = array.Array[usize] {}, loading = array.Array[usize] {}, names = array.Array[Name] {} }
}

pub Graph.wipe(self) {
    for i: usize in 0..self.pkgs.len {
        p: Package = self.pkgs.get(i)
        p.deps.wipe()
        p.links.wipe()
    }
    self.pkgs.wipe()
    self.order.wipe()
    self.loading.wipe()
    self.names.wipe()
    self.pool.wipe()
}

/* Opens a diagnostic at `manifest`'s `line`; the caller prints the message. */
Graph.at(self, manifest: string, line: int) {
    fmt.printf(sys.stderr, "%s:%d: error: ", manifest, line)
    self.errors += 1
}

// --- lexical shapes -----------------------------------------------------------

/* `text` without leading blanks and tabs, or trailing blanks, tabs, and CRs. */
trim(text: string): string {
    a: usize = 0
    b: usize = text.len
    for a < b && (text[a] == ' ' || text[a] == '\t') { a += 1 }
    for b > a && (text[b - 1] == ' ' || text[b - 1] == '\t' || text[b - 1] == '\r') { b -= 1 }
    return text[a..b]
}

alpha(c: u8): bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

digit(c: u8): bool {
    return c >= '0' && c <= '9'
}

is_ident(s: string): bool {
    if s.len == 0 { return false }
    if !(alpha(s[0]) || s[0] == '_') { return false }
    for c: u8 in s { if !(alpha(c) || digit(c) || c == '_') { return false } }
    return true
}

/* A lowercase identifier: the shape of a package name. */
pub valid_name(s: string): bool {
    if !is_ident(s) { return false }
    for c: u8 in s { if c >= 'A' && c <= 'Z' { return false } }
    return true
}

/* A nonempty run of decimal digits no larger than i32's maximum. */
uint_component(s: string): (int, bool) {
    if s.len == 0 { return 0, false }
    v: i64 = 0
    for c: u8 in s {
        if !digit(c) { return 0, false }
        v = v * 10 + i64(c - '0')
        if v > 0x7fffffff { return 0, false }
    }
    return int(v), true
}

/* Exactly "major.minor.patch": three nonnegative integers, two dots. */
parse_version(s: string): (int, int, int, bool) {
    parts: [4]string
    n: usize, fit: bool = str.split(s, '.', parts[0..4])
    if !fit || n != 3 { return 0, 0, 0, false }
    a: int, oka: bool = uint_component(parts[0])
    b: int, okb: bool = uint_component(parts[1])
    c: int, okc: bool = uint_component(parts[2])
    return a, b, c, oka && okb && okc
}

/* Exactly "major.minor": two nonnegative integers, one dot. */
parse_ace_version(s: string): (int, int, bool) {
    parts: [3]string
    n: usize, fit: bool = str.split(s, '.', parts[0..3])
    if !fit || n != 2 { return 0, 0, false }
    a: int, oka: bool = uint_component(parts[0])
    b: int, okb: bool = uint_component(parts[1])
    return a, b, oka && okb
}

/* A relative path with no ".." component: it stays within the package
 * directory that declares it.
 */
contained(s: string): bool {
    if s.len == 0 || s[0] == '/' { return false }
    for i: usize in 0..s.len {
        if s[i] == '.' && i + 1 < s.len && s[i + 1] == '.' &&
            (i == 0 || s[i - 1] == '/') && (i + 2 == s.len || s[i + 2] == '/') {
            return false
        }
    }
    return true
}

/* A contained path ending in ".ace": the shape of a package's root file. */
local_ace(s: string): bool {
    return s.len >= 4 && mem.equal(s[s.len - 4..], ".ace") && contained(s)
}

/* Whether canonical `canon` lies in `package_dir`, outside its reserved pkg/. */
pub contains(package_dir: string, canon: string): bool {
    if !mem.equal(canon, package_dir) && !path.beneath(canon, package_dir) { return false }
    rest: string = canon[package_dir.len..]
    return !(rest.len >= 4 && mem.equal(rest[..4], "/pkg") && (rest.len == 4 || rest[4] == '/'))
}

/* A section qualifier names a full target or an OS alone. */
qualifier_valid(q: string): bool {
    for name: string in ["darwin", "linux", "darwin-arm64", "darwin-x64", "linux-arm64", "linux-x64"] {
        if mem.equal(q, name) { return true }
    }
    return false
}

/* Whether qualifier `q` selects `target`: the target itself or its OS. */
qualifier_matches(q: string, target: string): bool {
    os: usize, dash: bool = str.find(target, '-')
    if !dash { os = target.len }
    return (q.len == target.len || q.len == os) && q.len <= target.len && mem.equal(q, target[..q.len])
}

// --- manifests ----------------------------------------------------------------

/* The nearest existing <dir>/pkg/<name>, checking `start` and then each
 * ancestor directory; false if none exists.
 */
Graph.find_in_pkg(self, start: string, name: string): (string, bool) {
    dir: string = start
    for {
        base: string = dir
        if mem.equal(dir, "/") { base = "" }
        candidate: string = self.pool.join([base, "/pkg/", name])
        if path.is_dir(candidate) { return candidate, true }
        if mem.equal(dir, "/") { return "", false }
        at: usize = dir.len
        for at > 0 && dir[at - 1] != '/' { at -= 1 }
        if at == 0 { return "", false }
        if at == 1 { dir = dir[..1] } else { dir = dir[..at - 1] }
    }
}

/* Stores `value` at `line` in `f`; a duplicate field is an error. */
Graph.field(self, manifest: string, line: int, f: *Field, key: string, value: string): bool {
    if f.line != 0 {
        self.at(manifest, line)
        fmt.printf(sys.stderr, "duplicate field '%s'\n", key)
        return false
    }
    f.value = self.pool.copy(value)
    f.line = line
    return true
}

/* One ace.pkg's text into its raw fields and entries. Diagnoses malformed
 * lines but keeps scanning, so one pass reports every problem in the file.
 */
Graph.parse_manifest(self, manifest: string, rm: *Raw): bool {
    src: []u8, rerr: Error = file.read(manifest)
    defer mem.release[u8](&src)
    if rerr != null {
        fmt.printf(sys.stderr, "ace: cannot open '%s'\n", manifest)
        self.errors += 1
        return false
    }
    line: int = 0
    in_deps: bool = false
    in_link: bool = false
    active: bool = true
    url_line: int = 0                       // a url awaiting its sha256
    framework_seen: bool = false            // this section's framework field
    ok: bool = true
    section: int = 0
    dep_first: usize = 0                    // the current section's first entry
    seen: [32]string    // headers so far, as "kind:qualifier"
    nseen: usize = 0
    rest: string = src
    for rest.len > 0 {
        line += 1
        at: usize, nl: bool = str.find(rest, '\n')
        raw: string = rest
        if nl {
            raw = rest[..at]
            rest = rest[at + 1..]
        } else {
            rest = rest[rest.len..]
        }
        t: string = trim(raw)
        if t.len == 0 { continue }
        if t.len >= 2 && t[0] == '/' && t[1] == '/' { continue } // comment
        if t[0] == '[' {
            if url_line != 0 {
                self.at(manifest, url_line)
                fmt.printf(sys.stderr, "[link] url must be followed immediately by sha256\n")
                ok = false
                url_line = 0
            }
            framework_seen = false
            in_deps = false
            in_link = false
            active = false // fields of a bad header are dropped
            section += 1
            dep_first = rm.deps.len
            closed: bool = t[t.len - 1] == ']'
            inner_end: usize = t.len
            if closed { inner_end = t.len - 1 }
            inner: string = trim(t[1..inner_end])
            q: usize = 0
            qcolon: bool = false
            if closed { q, qcolon = str.find(inner, ':') }
            kind: string = inner
            qual: string = ""
            if qcolon {
                kind = trim(inner[..q])
                qual = trim(inner[q + 1..])
            }
            is_dep: bool = closed && mem.equal(kind, "dependency")
            is_link: bool = closed && mem.equal(kind, "link")
            if !is_dep && !is_link {
                self.at(manifest, line)
                fmt.printf(sys.stderr, "unknown section '%s'\n", t)
                ok = false
                continue
            }
            if qcolon && !qualifier_valid(qual) {
                self.at(manifest, line)
                fmt.printf(sys.stderr, "unknown target qualifier '%s'\n", qual)
                ok = false
                continue
            }
            name: string = "link"
            if is_dep { name = "dependency" }
            key: string = self.pool.join([name, ":", qual])
            repeat: bool = false
            for i: usize in 0..nseen { if mem.equal(seen[i], key) { repeat = true } }
            if repeat {
                self.at(manifest, line)
                fmt.printf(sys.stderr, "repeated section '%s'\n", t)
                ok = false
                continue
            }
            if nseen < 32 {
                seen[nseen] = key
                nseen += 1
            }
            in_deps = is_dep
            in_link = is_link
            active = !qcolon || qualifier_matches(qual, self.target)
            if is_link {
                rm.link_any = true
                if active { rm.link_active = true }
            }
            continue
        }
        if !in_deps && !in_link && section > 0 { continue } // inside a rejected header
        c: usize, colon: bool = str.find(t, ':')
        if !colon {
            self.at(manifest, line)
            fmt.printf(sys.stderr, "expected 'key: value'\n")
            ok = false
            continue
        }
        key: string = trim(t[..c])
        val: string = trim(t[c + 1..])
        if key.len == 0 {
            self.at(manifest, line)
            fmt.printf(sys.stderr, "expected 'key: value'\n")
            ok = false
            continue
        }
        if val.len == 0 {
            // Optional single-line metadata with nothing after the colon, as
            // `ace pkg init` writes it, means absent rather than an error.
            if !in_deps && (mem.equal(key, "description") || mem.equal(key, "author") ||
                mem.equal(key, "license") || mem.equal(key, "repository")) {
                continue
            }
            self.at(manifest, line)
            fmt.printf(sys.stderr, "expected 'key: value'\n")
            ok = false
            continue
        }
        if in_link {
            if mem.equal(key, "sha256") {
                if url_line == 0 {
                    self.at(manifest, line)
                    fmt.printf(sys.stderr, "[link] sha256 must follow a url\n")
                    ok = false
                    continue
                }
                url_line = 0
                if active {
                    l: Link = rm.links.get(rm.links.len - 1)
                    l.sha256 = self.pool.copy(val)
                    rm.links.set(rm.links.len - 1, l)
                }
                continue
            }
            if url_line != 0 {
                self.at(manifest, url_line)
                fmt.printf(sys.stderr, "[link] url must be followed immediately by sha256\n")
                ok = false
                url_line = 0
            }
            framework: bool = mem.equal(key, "framework")
            url: bool = mem.equal(key, "url")
            if !framework && !url && !mem.equal(key, "path") {
                self.at(manifest, line)
                fmt.printf(sys.stderr, "unknown [link] field '%s'\n", key)
                ok = false
                continue
            }
            if url { url_line = line }
            if !framework {
                if active { fail(rm.links.push(Link { value = self.pool.copy(val), framework = false, line = line })) }
                continue
            }
            if framework_seen {
                self.at(manifest, line)
                fmt.printf(sys.stderr, "repeated [link] field 'framework'\n")
                ok = false
                continue
            }
            framework_seen = true
            list: string = val
            for {
                comma: usize, more: bool = str.find(list, ',')
                item: string = list
                if more { item = list[..comma] }
                item = trim(item)
                if item.len == 0 {
                    self.at(manifest, line)
                    fmt.printf(sys.stderr, "[link] framework list has an empty item\n")
                    ok = false
                } else if active {
                    fail(rm.links.push(Link { value = self.pool.copy(item), framework = true, line = line }))
                }
                if !more { break }
                list = list[comma + 1..]
            }
            continue
        }
        if in_deps {
            // A repeat within one section is always an error; across sections
            // only when both are active for this target. An inactive
            // section's entries are kept just for its own check.
            for i: usize in 0..rm.deps.len {
                d: RawDep = rm.deps.get(i)
                if (i >= dep_first || (active && d.line > 0)) && mem.equal(d.alias, key) {
                    self.at(manifest, line)
                    fmt.printf(sys.stderr, "duplicate dependency '%s'\n", key)
                    ok = false
                }
            }
            dl: int = line
            if !active { dl = -line }
            fail(rm.deps.push(RawDep { alias = self.pool.copy(key), version = self.pool.copy(val), line = dl }))
            continue
        }
        stored: bool = true
        if mem.equal(key, "name") { stored = self.field(manifest, line, &rm.name, key, val) } else if mem.equal(key, "version") { stored = self.field(manifest, line, &rm.version, key, val) } else if mem.equal(key, "ace") { stored = self.field(manifest, line, &rm.ace, key, val) } else if mem.equal(key, "type") { stored = self.field(manifest, line, &rm.type, key, val) } else if mem.equal(key, "root") { stored = self.field(manifest, line, &rm.root, key, val) } else if mem.equal(key, "test") { stored = self.field(manifest, line, &rm.test, key, val) } else if mem.equal(key, "output") { stored = self.field(manifest, line, &rm.output, key, val) } else if mem.equal(key, "description") { stored = self.field(manifest, line, &rm.description, key, val) } else if mem.equal(key, "author") { stored = self.field(manifest, line, &rm.author, key, val) } else if mem.equal(key, "license") { stored = self.field(manifest, line, &rm.license, key, val) } else if mem.equal(key, "repository") { stored = self.field(manifest, line, &rm.repository, key, val) } else {
            self.at(manifest, line)
            fmt.printf(sys.stderr, "unknown field '%s'\n", key)
            stored = false
        }
        if !stored { ok = false }
    }
    // Drop inactive sections' entries (marked by a negated line).
    if url_line != 0 {
        self.at(manifest, url_line)
        fmt.printf(sys.stderr, "[link] url must be followed immediately by sha256\n")
        ok = false
    }
    kept: usize = 0
    for i: usize in 0..rm.deps.len {
        d: RawDep = rm.deps.get(i)
        if d.line > 0 {
            rm.deps.set(kept, d)
            kept += 1
        }
    }
    rm.deps.truncate(kept)
    return ok
}

// --- graph --------------------------------------------------------------------

Graph.on_stack(self, canon: string): bool {
    for i: usize in self.loading.view() { if mem.equal(self.pkgs.get(i).dir, canon) { return true } }
    return false
}

Graph.loaded(self, canon: string): (usize, bool) {
    for i: usize in self.order.view() { if mem.equal(self.pkgs.get(i).dir, canon) { return i, true } }
    return 0, false
}

/* The chain from `canon` down the loading stack, newest first. */
Graph.report_cycle(self, manifest: string, line: int, canon: string) {
    chain: string = canon
    i: usize = self.loading.len
    for i > 0 {
        i -= 1
        chain = self.pool.join([chain, " -> ", self.pkgs.get(self.loading.get(i)).dir])
    }
    self.at(manifest, line)
    fmt.printf(sys.stderr, "package dependency cycle: %s\n", chain)
}

Graph.is_std_module_name(self, name: string): bool {
    flat: string, has_flat: bool = path.canonical(&self.pool, self.pool.join([self.std_dir, "/", name, ".ace"]))
    dir: string, has_dir: bool = path.canonical(&self.pool, self.pool.join([self.std_dir, "/", name, "/mod.ace"]))
    return has_flat || has_dir
}

/* `manifest` when set, else `fallback`: where a dependency's errors point. */
pick(manifest: string, fallback: string): string {
    if manifest.len > 0 { return manifest }
    return fallback
}

/* The package at `dir_arg` and, recursively, its dependencies; its index, or
 * false after reporting why not. `dep_manifest` and `dep_line` name the entry
 * that asked for it ("" and 0 for the root).
 */
Graph.load(self, dir_arg: string, is_root: bool, dep_manifest: string, dep_line: int): (usize, bool) {
    canon: string, found: bool = path.canonical(&self.pool, dir_arg)
    if found && is_root { self.root_dir = canon }
    if !found {
        self.at(pick(dep_manifest, dir_arg), dep_line)
        fmt.printf(sys.stderr, "cannot find package directory '%s'\n", dir_arg)
        return 0, false
    }
    if !path.is_dir(canon) {
        self.at(pick(dep_manifest, dir_arg), dep_line)
        fmt.printf(sys.stderr, "'%s' is not a directory\n", canon)
        return 0, false
    }
    if self.on_stack(canon) {
        self.report_cycle(pick(dep_manifest, canon), dep_line, canon)
        return 0, false
    }
    existing: usize, done: bool = self.loaded(canon)
    if done { return existing, true }

    manifest: string = self.pool.join([canon, "/ace.pkg"])
    _, merr: Error = sys.stat(manifest)
    if merr != null {
        self.at(pick(dep_manifest, canon), dep_line)
        fmt.printf(sys.stderr, "no ace.pkg at '%s'\n", canon)
        return 0, false
    }

    rm: Raw = blank(Raw)
    defer rm.wipe()
    if !self.parse_manifest(manifest, &rm) { return 0, false }

    ok: bool = true
    if rm.name.line == 0 {
        self.at(manifest, 1)
        fmt.printf(sys.stderr, "missing required field 'name'\n")
        ok = false
    }
    if rm.version.line == 0 {
        self.at(manifest, 1)
        fmt.printf(sys.stderr, "missing required field 'version'\n")
        ok = false
    }
    if rm.ace.line == 0 {
        self.at(manifest, 1)
        fmt.printf(sys.stderr, "missing required field 'ace'\n")
        ok = false
    }
    if rm.type.line == 0 {
        self.at(manifest, 1)
        fmt.printf(sys.stderr, "missing required field 'type'\n")
        ok = false
    }
    if rm.root.line == 0 {
        self.at(manifest, 1)
        fmt.printf(sys.stderr, "missing required field 'root'\n")
        ok = false
    }
    if !ok { return 0, false }

    if !valid_name(rm.name.value) {
        self.at(manifest, rm.name.line)
        fmt.printf(sys.stderr, "package name '%s' must be a lowercase identifier\n", rm.name.value)
        ok = false
    }
    vmaj: int, vmin: int, vpat: int, vok: bool = parse_version(rm.version.value)
    if !vok {
        self.at(manifest, rm.version.line)
        fmt.printf(sys.stderr, "version '%s' must be exactly major.minor.patch\n", rm.version.value)
        ok = false
    }
    amaj: int, amin: int, aok: bool = parse_ace_version(rm.ace.value)
    if !aok {
        self.at(manifest, rm.ace.line)
        fmt.printf(sys.stderr, "ace version '%s' must be exactly major.minor\n", rm.ace.value)
        ok = false
    } else if !self.have_ace {
        self.have_ace = true
        self.ace_major = amaj
        self.ace_minor = amin
    } else if amaj != self.ace_major || amin != self.ace_minor {
        self.at(manifest, rm.ace.line)
        fmt.printf(sys.stderr, "ace version %d.%d does not match the graph's %d.%d\n", amaj, amin, self.ace_major, self.ace_minor)
        ok = false
    }
    is_exe: bool = false
    if mem.equal(rm.type.value, "exe") {
        is_exe = true
    } else if !mem.equal(rm.type.value, "lib") {
        self.at(manifest, rm.type.line)
        fmt.printf(sys.stderr, "type '%s' must be 'exe' or 'lib'\n", rm.type.value)
        ok = false
    }
    is_archive: bool = false
    is_shared: bool = false
    if rm.output.line != 0 {
        is_archive = mem.equal(rm.output.value, "archive")
        is_shared = mem.equal(rm.output.value, "shared")
        if !is_archive && !is_shared {
            self.at(manifest, rm.output.line)
            fmt.printf(sys.stderr, "output '%s' must be 'archive' or 'shared'\n", rm.output.value)
            ok = false
        } else if is_exe {
            self.at(manifest, rm.output.line)
            fmt.printf(sys.stderr, "output '%s' requires type 'lib'\n", rm.output.value)
            ok = false
        }
    }
    if !is_root && is_exe {
        self.at(manifest, rm.type.line)
        fmt.printf(sys.stderr, "dependency '%s' is type 'exe'; only a lib package can be a dependency\n", rm.name.value)
        ok = false
    }
    if !local_ace(rm.root.value) {
        self.at(manifest, rm.root.line)
        fmt.printf(sys.stderr, "root '%s' must be a relative path within the package, ending in '.ace'\n", rm.root.value)
        ok = false
    }
    root_canon: string = ""
    if ok {
        rc: string, exists: bool = path.canonical(&self.pool, self.pool.join([canon, "/", rm.root.value]))
        root_canon = rc
        if !exists || !(path.beneath(rc, canon) || mem.equal(rc, canon)) {
            self.at(manifest, rm.root.line)
            fmt.printf(sys.stderr, "root '%s' does not exist\n", rm.root.value)
            ok = false
        } else if !contains(canon, rc) {
            self.at(manifest, rm.root.line)
            fmt.printf(sys.stderr, "root '%s' is inside the reserved pkg/ directory\n", rm.root.value)
            ok = false
        }
    }
    test_canon: string = ""
    if ok && rm.test.line != 0 {
        tc: string, exists: bool = path.canonical(&self.pool, self.pool.join([canon, "/", rm.test.value]))
        test_canon = tc
        if !exists || !path.beneath(tc, canon) || !path.is_dir(tc) {
            self.at(manifest, rm.test.line)
            fmt.printf(sys.stderr, "test directory '%s' does not exist within the package\n", rm.test.value)
            ok = false
        } else if !contains(canon, tc) {
            self.at(manifest, rm.test.line)
            fmt.printf(sys.stderr, "test directory '%s' is inside the reserved pkg/ directory\n", rm.test.value)
            ok = false
        }
    }
    if ok && self.is_std_module_name(rm.name.value) {
        self.at(manifest, rm.name.line)
        fmt.printf(sys.stderr, "package name '%s' collides with a standard-library module name\n", rm.name.value)
        ok = false
    }
    if ok {
        seen: bool = false
        for e: Name in self.names.view() {
            if mem.equal(e.name, rm.name.value) {
                seen = true
                if !mem.equal(e.dir, canon) {
                    self.at(manifest, rm.name.line)
                    fmt.printf(sys.stderr, "package name '%s' resolves to two different sources: %s and %s\n", rm.name.value, e.dir, canon)
                    ok = false
                }
                break
            }
        }
        if !seen { fail(self.names.push(Name { name = rm.name.value, dir = canon })) }
    }
    for d: RawDep in rm.deps.view() {
        if !is_ident(d.alias) {
            self.at(manifest, d.line)
            fmt.printf(sys.stderr, "dependency alias '%s' must be an identifier\n", d.alias)
            ok = false
        }
        a: int, b: int, c: int, dok: bool = parse_version(d.version)
        if !dok {
            self.at(manifest, d.line)
            fmt.printf(sys.stderr, "dependency '%s' version '%s' must be exactly major.minor.patch\n", d.alias, d.version)
            ok = false
        }
    }
    for i: usize in 0..rm.links.len {
        l: Link = rm.links.get(i)
        if l.framework {
            at: usize, slash: bool = str.find(l.value, '/')
            if slash {
                self.at(manifest, l.line)
                fmt.printf(sys.stderr, "[link] framework '%s' must be a bare name\n", l.value)
                ok = false
            }
            for j: usize in 0..i {
                o: Link = rm.links.get(j)
                if o.framework && o.line == l.line && mem.equal(o.value, l.value) {
                    self.at(manifest, l.line)
                    fmt.printf(sys.stderr, "[link] framework '%s' is repeated\n", l.value)
                    ok = false
                    break
                }
            }
        } else if l.sha256.len != 0 {
            if !url_valid(l.value) {
                self.at(manifest, l.line)
                fmt.printf(sys.stderr, "[link] url '%s' must be http or https and end in a file name\n", l.value)
                ok = false
            }
            if !sha256_valid(l.sha256) {
                self.at(manifest, l.line)
                fmt.printf(sys.stderr, "[link] sha256 '%s' must be 64 lowercase hex digits\n", l.sha256)
                ok = false
            }
        } else if l.value[0] != '/' && !contained(l.value) {
            self.at(manifest, l.line)
            fmt.printf(sys.stderr, "[link] path '%s' must be absolute or a relative path within the package\n", l.value)
            ok = false
        }
    }
    if !ok { return 0, false }

    pi: usize = self.pkgs.len
    fail(self.pkgs.push(Package {
        dir = canon, name = rm.name.value, ver_major = vmaj, ver_minor = vmin, ver_patch = vpat,
        ace_major = amaj, ace_minor = amin, is_exe = is_exe, is_archive = is_archive, is_shared = is_shared, root_file = root_canon, test_dir = test_canon, test_rel = rm.test.value,
        description = rm.description.value, author = rm.author.value,
        license = rm.license.value, repository = rm.repository.value,
        deps = array.Array[Dep] {}, links = array.Array[Link] {},
    }))
    fail(self.loading.push(pi))

    deps: array.Array[Dep] = array.Array[Dep] {}
    for d: RawDep in rm.deps.view() {
        target: string, there: bool = self.find_in_pkg(self.root_dir, d.alias)
        if !there {
            self.at(manifest, d.line)
            fmt.printf(sys.stderr, "dependency '%s' %s not found: no pkg/%s in '%s' or any parent directory\n", d.alias, d.version, d.alias, self.root_dir)
            continue
        }
        di: usize, loaded: bool = self.load(target, false, manifest, d.line)
        if !loaded { continue }
        dep: Package = self.pkgs.get(di)
        if !mem.equal(dep.name, d.alias) {
            self.at(manifest, d.line)
            fmt.printf(sys.stderr, "dependency alias '%s' does not match package name '%s' declared at '%s'\n", d.alias, dep.name, dep.dir)
            continue
        }
        a: int, b: int, c: int, dok: bool = parse_version(d.version)
        if dep.ver_major != a || dep.ver_minor != b || dep.ver_patch != c {
            self.at(manifest, d.line)
            fmt.printf(sys.stderr, "dependency '%s' requires version %s, but '%s' declares %d.%d.%d\n", d.alias, d.version, dep.dir, dep.ver_major, dep.ver_minor, dep.ver_patch)
            continue
        }
        fail(deps.push(Dep { name = d.alias, package = di }))
    }

    links: array.Array[Link] = array.Array[Link] {}
    for l: Link in rm.links.view() {
        value: string = l.value
        // A relative path must exist now; an absolute one is checked only if
        // it is the one linked, since the root may override it.
        if !l.framework && l.sha256.len == 0 && value[0] != '/' {
            resolved: string, exists: bool = path.canonical(&self.pool, self.pool.join([canon, "/", value]))
            if !exists || !(path.beneath(resolved, canon) || mem.equal(resolved, canon)) {
                self.at(manifest, l.line)
                fmt.printf(sys.stderr, "[link] path '%s' does not exist\n", value)
                continue
            }
            if !contains(canon, resolved) {
                self.at(manifest, l.line)
                fmt.printf(sys.stderr, "[link] path '%s' is inside the reserved pkg/ directory\n", value)
                continue
            }
            value = resolved
        }
        fail(links.push(Link { value = value, framework = l.framework, line = l.line, sha256 = l.sha256 }))
    }

    p: Package = self.pkgs.get(pi)
    p.deps = deps
    p.links = links
    p.link_unmet = rm.link_any && !rm.link_active
    self.pkgs.set(pi, p)
    self.loading.truncate(self.loading.len - 1)
    fail(self.order.push(pi)) // completed: its dependencies already precede it
    return pi, true
}

/* The graph rooted at the package in `dir`: the root's index, false on any
 * error, each reported on stderr as C reports it. `order` then lists every
 * package dependencies first, the root last.
 */
pub Graph.resolve(self, dir: string): (usize, bool) {
    root: usize, ok: bool = self.load(dir, true, "", 0)
    return root, ok && self.errors == 0
}

/* A fetched input's URL: http or https, with a plain file name at its end. */
url_valid(url: string): bool {
    scheme: usize = 0
    if str.has(url, "https://", false) { scheme = 8 } else if str.has(url, "http://", false) { scheme = 7 }
    if scheme == 0 { return false }
    for c: u8 in url {
        if c <= ' ' || c == 0x7f || c == '?' || c == '#' || c == '\\' { return false }
    }
    rest: string = url[scheme..]
    name: string = link_identity(rest)
    return name.len != 0 && name.len != rest.len && !mem.equal(name, ".") && !mem.equal(name, "..")
}

sha256_valid(hash: string): bool {
    if hash.len != 64 { return false }
    for c: u8 in hash {
        if !(c >= '0' && c <= '9') && !(c >= 'a' && c <= 'f') { return false }
    }
    return true
}

/* mkdir -p: an existing directory is fine. */
pub make_dirs(dir: string): Error {
    if path.is_dir(dir) { return null }
    parent: string = path.dir(dir)
    if !mem.equal(parent, dir) && !mem.equal(parent, ".") {
        err: Error = make_dirs(parent)
        if err != null { return err }
    }
    err: Error = sys.mkdir(dir)
    if err != null && !path.is_dir(dir) { return err }
    return null
}

/* Runs a host tool, whose success is its exit status. */
run_tool(argv: []string): bool {
    child: sys.Process, err: Error = exec.spawn(argv)
    if err != null { return false }
    status: sys.ProcessStatus, werr: Error = sys.wait(child)
    for werr != null && werr.code == sys.EINTR { status, werr = sys.wait(child) }
    return werr == null && status.exited && status.code == 0
}

/* Whether `name`'s SHA-256 is the hex `hash`. */
has_sha256(name: string, hash: string): bool {
    data: []u8, err: Error = file.read(name)
    defer mem.release[u8](&data)
    if err != null { return false }
    digest: [32]u8 = crypto.sha256(data)
    digits: string = "0123456789abcdef"
    for i: usize in 0..32 {
        if hash[i * 2] != digits[digest[i] >> 4] || hash[i * 2 + 1] != digits[digest[i] & 15] { return false }
    }
    return true
}

/* The verified cache file of a fetched input, downloading it when absent or
 * damaged (Package System #14). False after reporting why not.
 */
Graph.fetch_link(self, link: Link, dir: string): (string, bool) {
    home: string = ""
    for i: usize in 0 .. sys.envc() {
        e: string = sys.env(i)
        if home.len == 0 && e.len > 5 && str.has(e, "HOME=", false) { home = e[5..] }
    }
    if home.len == 0 {
        fmt.printf(sys.stderr, "%s/ace.pkg:%d: error: [link] url '%s' needs HOME for the cache\n", dir, link.line, link.value)
        return "", false
    }
    cache: string = self.pool.join([home, "/.ace/cache/", link.sha256])
    name: string = self.pool.join([cache, "/", link_identity(link.value)])
    info: sys.FileInfo, serr: Error = sys.stat(name)
    if serr == null && info.file_type == sys.FileType.regular && has_sha256(name, link.sha256) { return name, true }
    if make_dirs(cache) != null {
        fmt.printf(sys.stderr, "%s/ace.pkg:%d: error: [link] url '%s' cannot be cached in '%s'\n", dir, link.line, link.value, cache)
        return "", false
    }
    part: string = self.pool.join([name, ".part"])
    if !run_tool(["/usr/bin/curl", "-fsSL", "--globoff", "--proto", "=http,https", "--proto-redir", "=http,https", "-o", part, "--url", link.value]) {
        sys.unlink(part)
        fmt.printf(sys.stderr, "%s/ace.pkg:%d: error: [link] url '%s' could not be fetched\n", dir, link.line, link.value)
        return "", false
    }
    if !has_sha256(part, link.sha256) {
        sys.unlink(part)
        fmt.printf(sys.stderr, "%s/ace.pkg:%d: error: [link] url '%s' does not match its sha256\n", dir, link.line, link.value)
        return "", false
    }
    if sys.rename(part, name) != null {
        sys.unlink(part)
        fmt.printf(sys.stderr, "%s/ace.pkg:%d: error: [link] url '%s' cannot be cached in '%s'\n", dir, link.line, link.value, cache)
        return "", false
    }
    return name, true
}

/* One input, as a conflict sees it: a fetched file is its hash. */
links_agree(a: Link, b: Link): bool {
    if a.sha256.len != 0 && b.sha256.len != 0 { return mem.equal(a.sha256, b.sha256) }
    return a.sha256.len == 0 && b.sha256.len == 0 && mem.equal(a.value, b.value)
}

link_identity(value: string): string {
    i: usize = value.len
    for i > 0 && value[i - 1] != '/' { i -= 1 }
    return value[i..]
}

/* The transitive union of every package's [link] inputs for `cc`, dependencies
 * first: a framework once, and a file name once at its first position, at the
 * root's path when it declares one, else the dependencies' one agreed path.
 * False after reporting a conflict or a missing file.
 */
pub Graph.collect_links(self, args: *array.Array[string]): bool {
    seen: array.Array[string] = array.Array[string] {}
    defer seen.wipe()
    frameworks: array.Array[string] = array.Array[string] {}
    defer frameworks.wipe()
    failed: bool = false
    order: []usize = self.order.view()
    if order.len == 0 { return true }
    root: Package = self.pkgs.get(order[order.len - 1])
    for pi: usize in order[..order.len - 1] {
        dep: Package = self.pkgs.get(pi)
        if dep.link_unmet {
            fmt.printf(sys.stderr, "%s/ace.pkg: error: package '%s' has no [link] section for this target\n", dep.dir, dep.name)
            self.errors += 1
            failed = true
        }
    }
    for pi: usize in order {
        for link: Link in self.pkgs.get(pi).links.view() {
            if link.framework {
                if listed(frameworks.view(), link.value) { continue }
                fail(frameworks.push(link.value))
                fail(args.push("-framework"))
                fail(args.push(link.value))
                continue
            }
            identity: string = link_identity(link.value)
            if listed(seen.view(), identity) { continue }
            fail(seen.push(identity))

            chosen: Link = link
            chosen_dir: string = root.dir
            by_root: bool = false
            for r: Link in root.links.view() {
                if !by_root && !r.framework && mem.equal(link_identity(r.value), identity) {
                    chosen = r
                    by_root = true
                }
            }
            conflict: bool = false
            if !by_root {
                have: bool = false
                for j: usize in 0..order.len - 1 {
                    dep: Package = self.pkgs.get(order[j])
                    for q: Link in dep.links.view() {
                        if q.framework || !mem.equal(link_identity(q.value), identity) { continue }
                        if !have {
                            have = true
                            chosen = q
                            chosen_dir = dep.dir
                        } else if !links_agree(chosen, q) {
                            fmt.printf(sys.stderr, "%s/ace.pkg:%d: error: [link] path '%s' conflicts with %s/ace.pkg:%d's '%s'; the root package can choose one with its own path\n", dep.dir, q.line, q.value, chosen_dir, chosen.line, chosen.value)
                            self.errors += 1
                            conflict = true
                            failed = true
                        }
                    }
                }
            }
            if conflict { continue }
            input: string = chosen.value
            if chosen.sha256.len != 0 {
                cached: string, fetched: bool = self.fetch_link(chosen, chosen_dir)
                if !fetched {
                    self.errors += 1
                    failed = true
                    continue
                }
                input = cached
            } else {
                info: sys.FileInfo, err: Error = sys.stat(input)
                if err != null || info.file_type != sys.FileType.regular {
                    fmt.printf(sys.stderr, "%s/ace.pkg:%d: error: [link] path '%s' is not a file\n", chosen_dir, chosen.line, input)
                    self.errors += 1
                    failed = true
                    continue
                }
            }
            fail(args.push(input))
        }
    }
    return !failed
}

listed(items: []string, text: string): bool {
    for item: string in items {
        if mem.equal(item, text) { return true }
    }
    return false
}

/* The offset after the line starting at `at`, and where its text ends. */
line_end(text: string, at: usize): (usize, usize) {
    n: usize, found: bool = str.find(text[at..], '\n')
    if found { return at + n + 1, at + n }
    return text.len, text.len
}

/* The manifest `text` with `name: version` first in its [dependency] section,
 * one appended when absent, in `pool`. One blank line precedes an appended
 * section, so add and remove round trip.
 */
pub added_dep(pool: *path.Pool, text: string, name: string, version: string): string {
    entry: string = pool.join([name, ": ", version, "\n"])
    at: usize = 0
    for at < text.len {
        next: usize, eol: usize = line_end(text, at)
        if mem.equal(trim(text[at..eol]), "[dependency]") {
            return pool.join([text[..next], entry, text[next..]])
        }
        at = next
    }
    content: usize = text.len
    for content > 0 && text[content - 1] == '\n' { content -= 1 }
    sep: string = ""
    if content > 0 { sep = "\n\n" }
    return pool.join([text[..content], sep, "[dependency]\n", entry])
}

/* The manifest `text` without dependency `name`, and whether it was there; a
 * section left empty goes too, with the blank line `added_dep` put before it.
 */
pub removed_dep(pool: *path.Pool, text: string, name: string): (string, bool) {
    in_deps: bool = false
    has_header: bool = false
    header: usize = 0
    header_end: usize = 0
    has_entry: bool = false
    entry: usize = 0
    entry_end: usize = 0
    others: bool = false
    at: usize = 0
    for at < text.len {
        start: usize = at
        next: usize, eol: usize = line_end(text, at)
        at = next
        t: string = trim(text[start..eol])
        if t.len == 0 || (t.len >= 2 && t[0] == '/' && t[1] == '/') { continue }
        if mem.equal(t, "[dependency]") {
            in_deps = true
            has_header = true
            header = start
            header_end = next
            continue
        }
        if t[0] == '[' {
            in_deps = false
            continue
        }
        if !in_deps { continue }
        colon: usize, found: bool = str.find(t, ':')
        if !found { continue }
        if !has_entry && mem.equal(trim(t[..colon]), name) {
            has_entry = true
            entry = start
            entry_end = next
        } else {
            others = true
        }
    }
    if !has_entry { return "", false }
    if has_header && !others {
        cut: usize = header
        if cut >= 2 && text[cut - 1] == '\n' && text[cut - 2] == '\n' { cut -= 1 }
        return pool.join([text[..cut], text[header_end..entry], text[entry_end..]]), true
    }
    return pool.join([text[..entry], text[entry_end..]]), true
}
