/* lexer — the Ace lexer written in Ace, mirroring src/lexer.c token for token.
 *
 * `Lexer.next` streams one token per call; the lexer holds that token's
 * position and value (`pos`, `lit`, `int`, `float`) until the next call.
 * Identifier text is a view into the source; a string literal's decoded bytes
 * live in the lexer's scratch buffer.
 */

import array
import fmt
import mem
import str
import sys

pub Token: enum u8 {
    eof, newline, ident,
    import, pub, const, noalias, if, else, for,
    in, switch, default, return, break, continue, defer,
    asm, extern, contract, struct, embed, signs, distinct,
    type, enum, union, specialized, intrinsic, inline,
    volatile, self, threadlocal, null, true, false,
    int, float, string, char,
    assign, add_eq, sub_eq, mul_eq, div_eq, mod_eq, and_eq, or_eq, xor_eq,
    shl_eq, shr_eq,
    plus, minus, star, slash, percent, eq_eq, bang_eq, lt, le, gt, ge,
    and_and, or_or, amp, pipe, caret, shl, shr, tilde, bang,
    lparen, rparen, lbrack, rbrack, lbrace, rbrace, comma, colon, semi, at, question,
    dot, dot_dot, dot_dot_dot,
}

/* Display names of the punctuation tokens; every other Token displays as its own name. */
PUNCT: StaticMap[Token]string = {
    Token.assign: "=", Token.add_eq: "+=", Token.sub_eq: "-=", Token.mul_eq: "*=", Token.div_eq: "/=",
    Token.mod_eq: "%=", Token.and_eq: "&=", Token.or_eq: "|=", Token.xor_eq: "^=", Token.shl_eq: "<<=",
    Token.shr_eq: ">>=", Token.plus: "+", Token.minus: "-", Token.star: "*", Token.slash: "/",
    Token.percent: "%", Token.eq_eq: "==", Token.bang_eq: "!=", Token.lt: "<", Token.le: "<=",
    Token.gt: ">", Token.ge: ">=", Token.and_and: "&&", Token.or_or: "||", Token.amp: "&",
    Token.pipe: "|", Token.caret: "^", Token.shl: "<<", Token.shr: ">>", Token.tilde: "~",
    Token.bang: "!", Token.lparen: "(", Token.rparen: ")", Token.lbrack: "[", Token.rbrack: "]",
    Token.lbrace: "{", Token.rbrace: "}", Token.comma: ",", Token.colon: ":", Token.semi: ";",
    Token.at: "@", Token.dot: ".", Token.dot_dot: "..", Token.dot_dot_dot: "...", Token.question: "?",
}

pub disp(kind: Token): string {
    p: string = PUNCT[kind]
    if p.len != 0 { return p }
    return kind.name
}

pub LexErr: error {
    1: allocation = "out of memory",
    2: escape_end = "unterminated escape sequence",
    3: escape_hex = "\\x escape needs two hex digits",
    4: escape = "unknown escape sequence",
    5: string = "unterminated string literal",
    6: char_end = "unterminated char literal",
    7: char_empty = "empty char literal",
    8: char_size = "char literal must hold exactly one character",
    9: exponent = "malformed float exponent",
    10: exponent_dot = "float exponent requires a '.' \u{2014} write 1.0e5, not 1e5",
    11: separator = "malformed '_' separator (must sit between digits)",
    12: digits = "missing digits after base prefix",
    13: binary = "invalid binary digit",
    24: octal = "invalid octal digit",
    14: range = "integer literal out of range",
    15: colons = "'::' is not an operator; a type's functions are reached with '.'",
    16: non_ascii = "non-ASCII byte (identifiers are ASCII in v1)",
    17: unexpected = "unexpected character",
    18: comment = "unterminated block comment",
    19: byte = "unexpected byte",
    20: ident = "identifier exceeds 128 characters",
    21: escape_unicode = "\\u escape needs 1-6 hex digits in braces",
    22: scalar = "\\u escape is not a Unicode scalar value",
    23: char_unicode = "\\u escape is not allowed in a char literal",
}

/* A lexing error at the start of the token it was found in. `byte` is the
 * offending byte for the errors whose message shows it.
 */
pub Diag: struct {
    err: Error,
    line: u32,
    col: u32,
    byte: u8,
}

/* Writes `d` to stderr as the C lexer words it. */
pub report(path: string, d: Diag) {
    if d.err == LexErr.non_ascii {
        fmt.printf(sys.stderr, "%s:%d:%d: error: non-ASCII byte 0x%02X (identifiers are ASCII in v1)\n", path, int(d.line), int(d.col), uint(d.byte))
    } else if d.err == LexErr.unexpected || d.err == LexErr.binary || d.err == LexErr.octal {
        fmt.printf(sys.stderr, "%s:%d:%d: error: %s '%c'\n", path, int(d.line), int(d.col), d.err.message, d.byte)
    } else if d.err == LexErr.escape {
        fmt.printf(sys.stderr, "%s:%d:%d: error: %s '\\%c'\n", path, int(d.line), int(d.col), d.err.message, d.byte)
    } else if d.err == LexErr.byte {
        fmt.printf(sys.stderr, "%s:%d:%d: error: unexpected byte 0x%02X\n", path, int(d.line), int(d.col), uint(d.byte))
    } else {
        fmt.printf(sys.stderr, "%s:%d:%d: error: %s\n", path, int(d.line), int(d.col), d.err.message)
    }
}

pub Lexer: struct {
    src: string,
    off: usize,
    line: u32,
    lstart: usize,  // offset of the current line's first byte (columns count from it)
    tline: u32,     // start of the token being scanned
    tcol: u32,
    prev: Token,    // last returned token; newline = none or already emitted
    count: usize,   // tokens returned so far
    scratch: []u8 = null,
    used: usize,
    text: string,   // ident: source view; string: decoded bytes (scratch)
    ival: u64,      // int value, char byte
    fval: f64,      // float value
    errs: array.Array[Diag], // every error so far, in source order
}

/* A lexer over `src`, which must outlive it. Call `wipe` when done. */
pub Lexer.new(src: string): Lexer {
    lx: Lexer = Lexer {
        src = src, off = 0, line = 1, lstart = 0, tline = 1, tcol = 1,
        prev = Token.newline, count = 0, used = 0, text = "", ival = 0, fval = 0.0,
        errs = array.Array[Diag] {},
    }
    if src.len >= 3 && src[0] == 0xEF && src[1] == 0xBB && src[2] == 0xBF {
        lx.off = 3 // UTF-8 BOM
        lx.lstart = 3
    }
    return lx
}

pub Lexer.wipe(self) {
    mem.release[u8](&self.scratch)
    self.errs.wipe()
    self.used = 0
}

/* The current token's position. */
pub Lexer.pos(self): (u32, u32) {
    return self.tline, self.tcol
}

/* The current token's text: an ident's source view, or a string literal's
 * decoded bytes (valid until the next `next`).
 */
pub Lexer.lit(self): string {
    return self.text
}

/* The current int token's value, or a char token's byte. */
pub Lexer.int(self): u64 {
    return self.ival
}

/* The current float token's value. */
pub Lexer.float(self): f64 {
    return self.fval
}

/* Every error found so far, in source order. */
pub Lexer.errors(self): []Diag {
    return self.errs.view()
}

inline Lexer.cur(self): u8 {
    if self.off < self.src.len { return self.src[self.off] }
    return 0
}

inline Lexer.peek(self, k: usize): u8 {
    p: usize = self.off + k
    if p < self.src.len { return self.src[p] }
    return 0
}

inline Lexer.adv(self): u8 {
    if self.off >= self.src.len { return 0 }
    c: u8 = self.src[self.off]
    self.off += 1
    if c == '\n' {
        self.line += 1
        self.lstart = self.off
    }
    return c
}

/* Starts a token (or block comment) at the current byte. */
inline Lexer.mark(self) {
    self.tline = self.line
    self.tcol = u32(self.off - self.lstart + 1)
}

Lexer.fail(self, e: Error) {
    self.fail(e, u8(0))
}

/* Records `e` at the current token's start; aborts when out of memory, as
 * the C compiler's arena does.
 */
Lexer.fail(self, e: Error, byte: u8) {
    if self.errs.push(Diag { err = e, line = self.tline, col = self.tcol, byte = byte }) != null {
        fmt.printf(sys.stderr, "ace: out of memory\n")
        sys.exit(1)
    }
}

Lexer.push(self, c: u8) {
    if self.used == self.scratch.len {
        grown: []u8, ok: bool = mem.grow[u8](self.scratch, self.used + 1)
        if !ok {
            self.fail(LexErr.allocation)
            return
        }
        self.scratch = grown
    }
    self.scratch[self.used] = c
    self.used += 1
}

/* Can a token of this kind end an expression? (the newline rule) */
ends_expr(k: Token): bool {
    switch k {
        (Token.ident, Token.int, Token.float, Token.string, Token.char,
         Token.null, Token.true, Token.false, Token.self,
         Token.rparen, Token.rbrack, Token.rbrace,
         Token.return, Token.break, Token.continue,
         Token.specialized, Token.intrinsic) { return true }
        default {}
    }
    return false
}

inline ident_start(c: u8): bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

inline ident_char(c: u8): bool {
    return ident_start(c) || (c >= '0' && c <= '9')
}

/* The digit's value in `base`, or -1. */
digval(c: u8, base: int): int {
    v: int = -1
    if c >= '0' && c <= '9' {
        v = int(c - '0')
    } else if c >= 'a' && c <= 'f' {
        v = int(c - 'a') + 10
    } else if c >= 'A' && c <= 'F' {
        v = int(c - 'A') + 10
    }
    if v >= base { v = -1 }
    return v
}

/* Every '_' must sit between two digits of the given base. */
seps_ok(p: []char, base: int): bool {
    for i: usize in 0 .. p.len {
        if p[i] != '_' { continue }
        if i == 0 || i == p.len - 1 { return false }
        if digval(p[i - 1], base) < 0 || digval(p[i + 1], base) < 0 { return false }
    }
    return true
}

keyword(t: []char): Token {
    k: Token = Token.ident
    switch t[0] {
        'a' { if mem.equal(t, "asm") { k = Token.asm } }
        'b' { if mem.equal(t, "break") { k = Token.break } }
        'c' {
            if mem.equal(t, "const") {
                k = Token.const
            } else if mem.equal(t, "continue") {
                k = Token.continue
            } else if mem.equal(t, "contract") {
                k = Token.contract
            }
        }
        'd' {
            if mem.equal(t, "default") {
                k = Token.default
            } else if mem.equal(t, "defer") {
                k = Token.defer
            } else if mem.equal(t, "distinct") {
                k = Token.distinct
            }
        }
        'e' {
            if mem.equal(t, "else") {
                k = Token.else
            } else if mem.equal(t, "extern") {
                k = Token.extern
            } else if mem.equal(t, "embed") {
                k = Token.embed
            } else if mem.equal(t, "enum") {
                k = Token.enum
            }
        }
        'f' {
            if mem.equal(t, "for") {
                k = Token.for
            } else if mem.equal(t, "false") {
                k = Token.false
            }
        }
        'i' {
            if mem.equal(t, "if") {
                k = Token.if
            } else if mem.equal(t, "in") {
                k = Token.in
            } else if mem.equal(t, "import") {
                k = Token.import
            } else if mem.equal(t, "intrinsic") {
                k = Token.intrinsic
            } else if mem.equal(t, "inline") {
                k = Token.inline
            }
        }
        'n' {
            if mem.equal(t, "noalias") {
                k = Token.noalias
            } else if mem.equal(t, "null") {
                k = Token.null
            }
        }
        'p' { if mem.equal(t, "pub") { k = Token.pub } }
        'r' { if mem.equal(t, "return") { k = Token.return } }
        's' {
            if mem.equal(t, "switch") {
                k = Token.switch
            } else if mem.equal(t, "struct") {
                k = Token.struct
            } else if mem.equal(t, "signs") {
                k = Token.signs
            } else if mem.equal(t, "specialized") {
                k = Token.specialized
            } else if mem.equal(t, "self") {
                k = Token.self
            }
        }
        't' {
            if mem.equal(t, "type") {
                k = Token.type
            } else if mem.equal(t, "true") {
                k = Token.true
            } else if mem.equal(t, "threadlocal") {
                k = Token.threadlocal
            }
        }
        'u' { if mem.equal(t, "union") { k = Token.union } }
        'v' { if mem.equal(t, "volatile") { k = Token.volatile } }
        default {}
    }
    return k
}

/* The longest identifier, in characters (ASCII, so bytes). */
IDENT_MAX: const usize = 128

Lexer.scan_ident(self): Token {
    start: usize = self.off
    i: usize = self.off
    for i < self.src.len && ident_char(self.src[i]) { i += 1 }
    self.off = i
    text: string = self.src[start..self.off]
    if text.len > IDENT_MAX { self.fail(LexErr.ident) }
    self.text = text
    return keyword(text)
}

/* Skips a run of digits in `base` and '_' separators (no newlines). */
inline Lexer.digits(self, base: int) {
    i: usize = self.off
    for i < self.src.len && (self.src[i] == '_' || digval(self.src[i], base) >= 0) { i += 1 }
    self.off = i
}

Lexer.scan_number(self): Token {
    start: usize = self.off
    base: int = 10
    if self.cur() == '0' && (self.peek(1) == 'x' || self.peek(1) == 'X') {
        self.adv()
        self.adv()
        base = 16
    } else if self.cur() == '0' && (self.peek(1) == 'b' || self.peek(1) == 'B') {
        self.adv()
        self.adv()
        base = 2
    } else if self.cur() == '0' && (self.peek(1) == 'o' || self.peek(1) == 'O') {
        self.adv()
        self.adv()
        base = 8
    }

    dstart: usize = self.off
    self.digits(base)
    dend: usize = self.off

    is_float: bool = false
    if base == 10 && self.cur() == '.' && digval(self.peek(1), 10) >= 0 {
        is_float = true
        self.adv()
        self.digits(10)
        if self.cur() == 'e' || self.cur() == 'E' {
            self.adv()
            if self.cur() == '+' || self.cur() == '-' { self.adv() }
            if digval(self.cur(), 10) < 0 { self.fail(LexErr.exponent) }
            self.digits(10)
        }
    } else if base == 10 && (self.cur() == 'e' || self.cur() == 'E') {
        n1: u8 = self.peek(1)
        n2: u8 = self.peek(2)
        if digval(n1, 10) >= 0 || ((n1 == '+' || n1 == '-') && digval(n2, 10) >= 0) {
            self.fail(LexErr.exponent_dot)
        }
    }

    if !seps_ok(self.src[dstart..self.off], base) { self.fail(LexErr.separator) }
    if dend == dstart {
        self.fail(LexErr.digits)
    } else if base == 2 && digval(self.cur(), 10) >= 0 {
        self.fail(LexErr.binary, self.cur())
    } else if base == 8 && digval(self.cur(), 10) >= 0 {
        self.fail(LexErr.octal, self.cur())
    }

    if is_float {
        self.used = 0
        for i: usize in start .. self.off {
            if self.src[i] != '_' { self.push(self.src[i]) }
        }
        v: f64, ok: bool = str.parse[f64](self.scratch[..self.used])
        self.fval = v
        return Token.float
    }

    v: u64 = 0
    over: bool = false
    b: u64 = u64(base)
    for i: usize in dstart .. dend {
        c: u8 = self.src[i]
        if c == '_' { continue }
        dv: u64 = u64(digval(c, base))
        if v > (u64(0xFFFFFFFFFFFFFFFF) - dv) / b {
            over = true
            break
        }
        v = v * b + dv
    }
    self.ival = v // on overflow, the digits read so far (as the C lexer keeps them)
    if over { self.fail(LexErr.range) }
    return Token.int
}

/* Called with the backslash already consumed. */
Lexer.escape(self): u8 {
    c: u8 = self.cur()
    if c == 0 {
        self.fail(LexErr.escape_end)
        return '?'
    }
    self.adv()
    switch c {
        'n' { return '\n' }
        't' { return '\t' }
        'r' { return '\r' }
        '0' { return 0 }
        '\\', '"', '\'' { return c }
        'x' {
            h: int = digval(self.cur(), 16)
            if h < 0 {
                self.fail(LexErr.escape_hex)
                return '?'
            }
            self.adv()
            l: int = digval(self.cur(), 16)
            if l < 0 {
                self.fail(LexErr.escape_hex)
                return '?'
            }
            self.adv()
            return u8(h * 16 + l)
        }
        default {}
    }
    self.fail(LexErr.escape, c)
    return '?'
}

/* Called with `\\u` consumed. Pushes the UTF-8 encoding of a Unicode scalar
 * value written as 1-6 hex digits in braces.
 */
Lexer.unicode(self) {
    v: u32 = 0
    n: int = 0
    if self.cur() == '{' {
        self.adv()
        for {
            d: int = digval(self.cur(), 16)
            if d < 0 { break }
            if n < 6 { v = v * 16 + u32(d) }
            self.adv()
            n += 1
        }
    }
    if n < 1 || n > 6 || self.cur() != '}' {
        if self.cur() == '}' { self.adv() }
        self.fail(LexErr.escape_unicode)
        return
    }
    self.adv()
    if v > 0x10FFFF || (v >= 0xD800 && v <= 0xDFFF) {
        self.fail(LexErr.scalar)
        return
    }
    if v < 0x80 {
        self.push(u8(v))
    } else if v < 0x800 {
        self.push(u8(0xC0 | v >> 6))
        self.push(u8(0x80 | (v & 0x3F)))
    } else if v < 0x10000 {
        self.push(u8(0xE0 | v >> 12))
        self.push(u8(0x80 | (v >> 6 & 0x3F)))
        self.push(u8(0x80 | (v & 0x3F)))
    } else {
        self.push(u8(0xF0 | v >> 18))
        self.push(u8(0x80 | (v >> 12 & 0x3F)))
        self.push(u8(0x80 | (v >> 6 & 0x3F)))
        self.push(u8(0x80 | (v & 0x3F)))
    }
}

Lexer.scan_string(self): Token {
    self.adv() // opening quote
    self.used = 0
    for {
        c: u8 = self.cur()
        if c == '"' {
            self.adv()
            break
        }
        if c == 0 || c == '\n' {
            self.fail(LexErr.string)
            break
        }
        if c == '\\' {
            self.adv()
            if self.cur() == 'u' {
                self.adv()
                self.unicode()
            } else {
                e: u8 = self.escape()
                self.push(e)
            }
        } else {
            self.push(self.adv()) // UTF-8 bytes pass through
        }
    }
    self.text = self.scratch[..self.used]
    return Token.string
}

Lexer.scan_char(self): Token {
    self.adv() // opening quote
    val: u8 = 0
    ok: bool = true
    if self.cur() == 0 || self.cur() == '\n' {
        self.fail(LexErr.char_end)
        ok = false
    } else if self.cur() == '\'' {
        self.adv()
        self.fail(LexErr.char_empty)
        ok = false
    } else if self.cur() == '\\' {
        self.adv()
        if self.cur() == 'u' {
            self.adv()
            self.fail(LexErr.char_unicode)
            for self.cur() != 0 && self.cur() != '\'' && self.cur() != '\n' { self.adv() }
        } else {
            val = self.escape()
        }
    } else {
        val = self.adv()
    }
    if ok {
        if self.cur() != '\'' {
            self.fail(LexErr.char_size)
            for self.cur() != 0 && self.cur() != '\'' && self.cur() != '\n' { self.adv() }
            if self.cur() == '\'' { self.adv() }
        } else {
            self.adv()
        }
    }
    self.ival = u64(val)
    return Token.char
}

/* `plain`, or `with_eq` when an '=' follows (consumed). */
Lexer.eq(self, plain: Token, with_eq: Token): Token {
    if self.cur() == '=' {
        self.adv()
        return with_eq
    }
    return plain
}

/* A punctuation token, or false after an unexpected byte (reported). */
Lexer.scan_punct(self, c: u8): (Token, bool) {
    self.adv()
    k: Token = Token.eof
    switch c {
        '(' { k = Token.lparen }
        ')' { k = Token.rparen }
        '[' { k = Token.lbrack }
        ']' { k = Token.rbrack }
        '{' { k = Token.lbrace }
        '}' { k = Token.rbrace }
        ',' { k = Token.comma }
        ':' {
            if self.cur() == ':' { self.fail(LexErr.colons) }
            k = Token.colon
        }
        '~' { k = Token.tilde }
        '+' { k = self.eq(Token.plus, Token.add_eq) }
        '-' { k = self.eq(Token.minus, Token.sub_eq) }
        '*' { k = self.eq(Token.star, Token.mul_eq) }
        '%' { k = self.eq(Token.percent, Token.mod_eq) }
        '^' { k = self.eq(Token.caret, Token.xor_eq) }
        '=' { k = self.eq(Token.assign, Token.eq_eq) }
        '!' { k = self.eq(Token.bang, Token.bang_eq) }
        '/' { k = self.eq(Token.slash, Token.div_eq) }
        '&' {
            if self.cur() == '&' {
                self.adv()
                k = Token.and_and
            } else {
                k = self.eq(Token.amp, Token.and_eq)
            }
        }
        '|' {
            if self.cur() == '|' {
                self.adv()
                k = Token.or_or
            } else {
                k = self.eq(Token.pipe, Token.or_eq)
            }
        }
        '<' {
            if self.cur() == '<' {
                self.adv()
                k = self.eq(Token.shl, Token.shl_eq)
            } else {
                k = self.eq(Token.lt, Token.le)
            }
        }
        '>' {
            if self.cur() == '>' {
                self.adv()
                k = self.eq(Token.shr, Token.shr_eq)
            } else {
                k = self.eq(Token.gt, Token.ge)
            }
        }
        '.' {
            k = Token.dot
            if self.cur() == '.' {
                self.adv()
                k = Token.dot_dot
                if self.cur() == '.' {
                    self.adv()
                    k = Token.dot_dot_dot
                }
            }
        }
        ';' { k = Token.semi }
        '@' { k = Token.at }
        '?' { k = Token.question }
        default {
            if c >= 0x80 {
                self.fail(LexErr.non_ascii, c)
            } else if c > ' ' && c <= '~' {
                self.fail(LexErr.unexpected, c)
            } else {
                self.fail(LexErr.byte, c)
            }
            return k, false
        }
    }
    return k, true
}

/* Skips whitespace and comments; true when a newline was crossed. */
Lexer.trivia(self): bool {
    src: string = self.src
    i: usize = self.off
    nl: bool = false
    for i < src.len {
        c: u8 = src[i]
        if c == ' ' || c == '\t' || c == 0x0B || c == 0x0C {
            i += 1
        } else if c == '\n' {
            i += 1
            self.line += 1
            self.lstart = i
            nl = true
        } else if c == '\r' { // CRLF and lone CR both count once
            i += 1
            if i < src.len && src[i] == '\n' {
                i += 1
                self.line += 1
                self.lstart = i
            }
            nl = true
        } else if c == '/' && i + 1 < src.len && src[i + 1] == '/' {
            i += 2
            for i < src.len && src[i] != 0 && src[i] != '\n' { i += 1 }
        } else if c == '/' && i + 1 < src.len && src[i + 1] == '*' {
            self.off = i
            self.mark()
            i += 2
            for {
                if i >= src.len || src[i] == 0 {
                    self.fail(LexErr.comment)
                    break
                }
                b: u8 = src[i]
                if b == '*' && i + 1 < src.len && src[i + 1] == '/' {
                    i += 2
                    break
                }
                i += 1
                if b == '\n' {
                    self.line += 1
                    self.lstart = i
                    nl = true
                }
            }
        } else {
            break
        }
    }
    self.off = i
    return nl
}

Lexer.emit(self, t: Token): Token {
    // A keyword after '.' is a member name: it ends an expression as an ident does.
    if self.prev == Token.dot && u8(t) >= u8(Token.import) && u8(t) <= u8(Token.false) {
        self.prev = Token.ident
    } else {
        self.prev = t
    }
    self.count += 1
    return t
}

/* The next token; after eof, eof again. A token with an error is still a
 * token (as in the C lexer); `errors` holds the errors.
 */
pub Lexer.next(self): Token {
    for {
        nl: bool = self.trivia()
        self.mark()

        if self.cur() == 0 {
            if self.count > 0 && self.prev != Token.newline && self.prev != Token.eof {
                return self.emit(Token.newline)
            }
            return self.emit(Token.eof)
        }

        // No newline before ';' (for-head clauses stay joined).
        if nl && ends_expr(self.prev) && self.cur() != ';' { return self.emit(Token.newline) }

        c: u8 = self.cur()
        if ident_start(c) { return self.emit(self.scan_ident()) }
        if c >= '0' && c <= '9' { return self.emit(self.scan_number()) }
        if c == '"' { return self.emit(self.scan_string()) }
        if c == '\'' { return self.emit(self.scan_char()) }
        k: Token, ok: bool = self.scan_punct(c)
        if ok { return self.emit(k) }
        // An unexpected byte yields no token, only its error.
    }
}
