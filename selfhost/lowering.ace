/* lowering — a checked function to SSA IR, mirroring src/lower.c (pass 5).
 *
 * SSA is built during the one walk of the function (Braun et al., CC 2013):
 * every scalar local is a variable written and read per block; a read in a
 * block with several predecessors places a phi, an unsealed block's an
 * incomplete one filled in when it is sealed, and a trivial phi is replaced
 * by its one value. A local whose storage something needs lives in a stack
 * slot, read and written by load and store. A struct, tuple, or array is its
 * scalar leaves (ir.leaves).
 *
 * Ported so far, as a debug build lowers them: scalars and aggregates,
 * strings and slices, contracts, tagged unions, every loop form, switch,
 * static maps, and direct, indirect, and contract calls. Anything else stops
 * the function with a "selfhost does not yet support" reason.
 */

import array
import bits
import fmt
import map
import mem
import sys

import lexer: "./lexer.ace"
import ir: "./ir.ace"
import optimizer: "./optimizer.ace"
import parser: "./parser.ace"
import path: "./path.ace"
import sema: "./sema.ace"
import fail from "./failure.ace"

Kind: type = parser.Kind
Node: type = parser.Node
Token: type = lexer.Token
TypeKind: type = sema.TypeKind
SType: type = sema.SType
Out: type = fmt.Buffer
Func: type = ir.Func

/* The leaf values of an aggregate, or a scalar's one. */
Agg: struct {
    n: int,
    v: [ir.MAX_LEAVES]int,
}

/* An inline expansion in progress: its declaration, result type, the join
 * its returns reach, and where the result goes (C's Expansion).
 */
Expansion: struct {
    f: u32,
    rt: u32,
    join: int,
    res: int,              // the result's first variable, or -1
    dst: int,              // a result in memory: its address, or -1
}

/* A generic inline declaration's escape mask under one instantiation. */
GenEscape: struct {
    f: u32,
    args: u32,
    esc: u64,
}

ESC_ALL: const u64 = 0xffffffffffffffff
ESC_REST: const u64 = 0x8000000000000000 // parameter 63 onward: always set, so a mask is never 0

/* An unsealed block's pending phi. */
Incomplete: struct {
    var: int,
    phi: int,
    next: int,
}

/* A break/continue target. */
Target: struct {
    label: string,
    has_label: bool,
    brk: int,
    cont: int,       // -1 for a labeled block
    restart: int,    // a labeled block: its first block; else -1
    ndefers: usize,  // defers pending outside it: leaving it runs those above
}

/* A captured defer: its call, re-lowered at each exit, and the statement. */
Deferred: struct {
    call: u32,
    at: u32,
}

/* A deferred call's argument captured at the defer (C gives the call a fresh
 * name in its place): the variable holding its value or, when it is a place,
 * its storage's address; t is the type it is read at.
 */
Capture: struct {
    var: int,
    t: u32,
}

/* A place: an SSA variable, or memory at addr + off. */
Place: struct {
    var: int = -1,
    addr: int = -1,
    off: i32 = 0,
    flags: u8 = 0,   // IRF_CHECKED when addr came from a pointer value
    t: u32 = 0,
}

/* Arguments flattened to leaves, and how they group into parts. */
Args: struct {
    v: array.Array[int],
    parts: array.Array[ir.IrPart],
    agg: bool = false,
}

Args.init(): Args {
    return Args { v = array.Array[int] {}, parts = array.Array[ir.IrPart] {} }
}

Args.wipe(mut self) {
    mut self.v.wipe()
    mut self.parts.wipe()
}

Args.clear(mut self) {
    mut self.v.clear()
    mut self.parts.clear()
    self.agg = false
}

Args.scalar(mut self, v: int) {
    fail(mut self.parts.push(ir.IrPart { first = int(self.v.len), n = 1 }))
    fail(mut self.v.push(v))
}

/* home: -1 for an SSA value, else a slot's address value, or ADDR_VAR - v
 * when the address is SSA variable v.
 */
ADDR_VAR: const int = -2

Lw: struct {
    s: mut *sema.Sema,                  // the checker; not owned (inline expansion adds nodes and symbols)
    fn: Func,
    f: u32,
    debug: bool,
    why: string = "",
    gap: bool = false,                  // why names a construct selfhost does not port yet
    cur: int = -1,                      // the block receiving instructions, or -1 when unreachable
    at: u32 = 0,                        // the statement being lowered
    var_ix: map.Map[u32, int],          // binder symbol -> variable index + 1
    stored: map.Map[u32, bool],         // symbols whose storage something needs
    vtype: array.Array[u8],
    home: array.Array[int],
    defs: map.Map[u64, int],            // (block, variable) -> current definition
    inc: array.Array[Incomplete],
    inc_head: array.Array[int],         // block -> first pending phi + 1
    repl: array.Array[int],             // value -> replacement + 1 (removed trivial phis)
    tgt: array.Array[Target],
    is_main: bool = false,
    rtype: u32 = 0,                     // the result type, or 0
    result: int = -1,                   // a result in memory: the RESULT address
    defers: array.Array[Deferred],      // captured defers, source order
    captured: map.Map[u32, Capture],    // deferred-call argument node -> its capture
    inl: array.Array[Expansion],        // the inline expansions in progress, innermost last
    escapes: map.Map[u32, u64],         // inline declaration -> its escape mask
    gesc: array.Array[GenEscape],       // the same for a generic one, per instantiation
    want: u32 = 0,                      // the scan's parameter, or 0 for every local
    hit: bool = false,                  // whether the scan found `want` needing storage
    in_defer: bool = false,             // scanning under a defer, whose call is never expanded
    scan_auto: bool = false,            // the scan: release auto-inline calls expand (no self tail loop can stop them)
    self_head: int = -1,                // release self tail recursion: the loop head block, or -1
}

Lw.wipe(mut self) {
    mut self.var_ix.wipe()
    mut self.stored.wipe()
    mut self.vtype.wipe()
    mut self.home.wipe()
    mut self.defs.wipe()
    mut self.inc.wipe()
    mut self.inc_head.wipe()
    mut self.repl.wipe()
    mut self.tgt.wipe()
    mut self.defers.wipe()
    mut self.captured.wipe()
    mut self.inl.wipe()
    mut self.escapes.wipe()
    mut self.gesc.wipe()
}

/* Stops the function: C's unsupported(), for a reason C reports itself. Ace
 * has no non-local exit, so lowering continues on dummy values after it and
 * the result is discarded.
 */
Lw.unsupported(mut self, why: string) {
    if self.why.len == 0 { self.why = why }
}

/* Stops the function at a construct C lowers but selfhost does not yet. */
Lw.unported(mut self, what: string) {
    if self.why.len == 0 {
        self.why = what
        self.gap = true
    }
}

Lw.failed(self): bool {
    return self.why.len > 0
}

Lw.node(self, n: u32): Node {
    return self.s.node(n)
}

Lw.kid(self, n: u32, k: u32): u32 {
    return self.s.kid(n, k)
}

Lw.ty(self, t: u32): SType {
    return self.s.ty(t)
}

Lw.nty(self, n: u32): u32 {
    return self.s.node_ty(n)
}

Lw.nsym(self, n: u32): u32 {
    return self.s.node_sym(n)
}

// --- types ------------------------------------------------------------------

Lw.unwrap(self, t: u32): u32 {
    return ir.unwrap(*self.s, t)
}

Lw.kind(self, t: u32): TypeKind {
    return self.ty(self.unwrap(t)).kind
}

Lw.type_why(self, t: u32): string {
    u: u32 = self.unwrap(t)
    if u == 0 { return "untyped value" }
    x: SType = self.ty(u)
    switch x.kind {
        TypeKind.prim {
            if x.prim == sema.P_STRING { return "string" }
            return "unsupported primitive"
        }
        TypeKind.ptr { return "pointer" }
        TypeKind.slice { return "slice" }
        TypeKind.array { return "array" }
        TypeKind.tuple { return "tuple" }
        TypeKind.func { return "function value" }
        TypeKind.struct { return "struct" }
        TypeKind.enum { return "enum" }
        TypeKind.contract { return "contract value" }
        TypeKind.error, TypeKind.error_domain { return "Error value" }
        TypeKind.union { return "union" }
        TypeKind.bits { return "bits type" }
        TypeKind.staticmap { return "static map" }
        default { return "unsupported type" }
    }
}

Lw.need_type(mut self, t: u32): u8 {
    it: int = ir.type_of(*self.s, t)
    if it < 0 {
        mut self.unsupported(self.type_why(t))
        return ir.IT_I64
    }
    return u8(it)
}

Lw.is_untyped(self, t: u32): bool {
    return t == 0 || self.ty(t).kind == TypeKind.ut
}

/* A string or slice: a ptr and a u64 length (Types #19). */
Lw.is_view(self, t: u32): bool {
    u: u32 = self.unwrap(t)
    if u == 0 { return false }
    x: SType = self.ty(u)
    return x.kind == TypeKind.slice || (x.kind == TypeKind.prim && x.prim == sema.P_STRING)
}

Lw.is_contract(self, t: u32): bool {
    u: u32 = self.unwrap(t)
    return u != 0 && self.ty(u).kind == TypeKind.contract
}

Lw.is_union(self, t: u32): bool {
    u: u32 = self.unwrap(t)
    return u != 0 && self.ty(u).kind == TypeKind.union
}

Lw.is_agg(self, t: u32): bool {
    u: u32 = self.unwrap(t)
    if u == 0 { return false }
    k: TypeKind = self.ty(u).kind
    return k == TypeKind.struct || k == TypeKind.tuple || k == TypeKind.array || self.is_union(u) || self.is_view(u) || self.is_contract(u)
}

/* Whether `t` holds an array or a union member: a variable of it lives in memory. */
Lw.has_array(self, t: u32): bool {
    u: u32 = self.unwrap(t)
    if u == 0 { return false }
    x: SType = self.ty(u)
    if x.kind == TypeKind.array { return true }
    if x.kind != TypeKind.struct && x.kind != TypeKind.tuple { return false }
    for i: u32 in 0..x.nfields {
        f: sema.SField = self.s.field(x, i)
        if self.has_array(f.ty) || ir.is_overlay(*self.s, f.ty) { return true }
    }
    return false
}

Lw.has_union(self, t: u32): bool {
    return ir.holds_union(*self.s, t)
}

/* An aggregate of over MAX_LEAVES leaves, or one holding a union over 16
 * bytes that is no floating aggregate: it stays in memory.
 */
Lw.is_big(self, t: u32): bool {
    if self.is_union(t) || self.has_union(t) {
        n: int, _ = ir.hfa(*self.s, t)
        return self.ty(self.unwrap(t)).size > 16 && n == 0
    }
    return self.is_agg(t) && ir.leaf_count(*self.s, t) > int(ir.MAX_LEAVES)
}

Lw.in_memory(self, t: u32): bool {
    return ir.is_overlay(*self.s, t) || (self.is_agg(t) && (self.has_array(t) || self.is_big(t)))
}

/* A parameter in memory that AAPCS64 passes by address. */
Lw.param_by_address(self, t: u32): bool {
    if !self.in_memory(t) { return false }
    if self.is_big(t) { return true }
    lv: ir.Leaves = blank(ir.Leaves)
    n: int, _ = ir.leaves(*self.s, t, mut lv)
    h: int, _ = ir.hfa(*self.s, t)
    return n >= 0 && self.ty(t).size > 16 && h == 0
}

/* The leaves of `t`, which the IR must cover. */
Lw.leaves(mut self, t: u32, mut out: ir.Leaves): int {
    n: int, bad: u32 = ir.leaves(*self.s, t, mut out)
    if n < 0 {
        if bad != 0 && (ir.type_of(*self.s, bad) >= 0 || self.is_view(bad)) {
            mut self.unsupported("aggregate of over 32 leaves")
        } else {
            mut self.unsupported(self.type_why(bad))
        }
        out.n = 0
        return 0
    }
    return n
}

Lw.leaf_count(mut self, t: u32): int {
    lv: ir.Leaves = blank(ir.Leaves)
    return mut self.leaves(t, mut lv)
}

/* Refuses `t` unless the IR covers each of its leaves, however many. */
Lw.covered(mut self, t: u32) {
    if ir.leaf_count(*self.s, t) < 0 { _ = mut self.leaf_count(t) }
}

/* The index of field `fi`'s first leaf among its struct's. */
Lw.leaf_index(mut self, t: u32, fi: u32): int {
    x: SType = self.ty(self.unwrap(t))
    k: int = 0
    for i: u32 in 0..fi { k += mut self.leaf_count(self.s.field(x, i).ty) }
    return k
}

/* The index of the field named `name` in struct `t`, or -1. */
Lw.find_field(self, t: u32, name: string): int {
    x: SType = self.ty(t)
    for i: u32 in 0..x.nfields {
        if mem.equal(self.s.field(x, i).name, name) { return int(i) }
    }
    return -1
}

// --- instructions -----------------------------------------------------------

Lw.emit(mut self, op: u8, ty: u8): int {
    if self.cur < 0 { // only after a failure: a dummy at the entry
        return mut self.at_entry(op, ty)
    }
    id: int = mut self.fn.new_ins(self.cur, op, ty)
    mut self.fn.at(id).at = self.at
    return id
}

Lw.emit2(mut self, op: u8, ty: u8, a: int, b: int): int {
    id: int = mut self.emit(op, ty)
    mut self.fn.arg_add(id, a)
    if b >= 0 { mut self.fn.arg_add(id, b) }
    return id
}

Lw.konst(mut self, ty: u8, v: u64): int {
    id: int = mut self.emit(ir.IR_CONST, ty)
    mut self.fn.at(id).imm = ir.wrap(ty, v)
    return id
}

/* A float constant: `d` rounded to `ty`'s precision, as its bit pattern. */
Lw.fconst(mut self, ty: u8, d: f64): int {
    if ty == ir.IT_F32 { return mut self.konst(ty, u64(bitcast(u32, f32(d)))) }
    return mut self.konst(ty, bitcast(u64, d))
}

/* A literal (or its negation) at `ty`: an integer literal meeting a float
 * converts exactly.
 */
Lw.literal(mut self, ty: u8, x: u32, neg: bool): int {
    n: Node = self.node(x)
    if ir.type_float(ty) {
        d: f64 = n.fval
        if n.kind != Kind.float_lit { d = f64(n.ival) }
        if neg { d = -d }
        return mut self.fconst(ty, d)
    }
    if n.kind == Kind.float_lit {
        mut self.unsupported("float literal at an integer type")
        return mut self.dummy()
    }
    if neg { return mut self.konst(ty, bits.wrsub(u64(0), n.ival)) }
    return mut self.konst(ty, n.ival)
}

/* A placeholder value after a failure. */
Lw.dummy(mut self): int {
    return mut self.at_entry(ir.IR_CONST, ir.IT_I64)
}

/* A zero at the top of the entry block: the value of a read no definition
 * reaches, which definite initialization confines to dead paths.
 */
Lw.zero_at_entry(mut self, ty: u8): int {
    return mut self.at_entry(ir.IR_CONST, ty)
}

Lw.terminate(mut self, op: u8, arg: int, s0: int, s1: int) {
    if self.cur < 0 { return }
    id: int = mut self.emit(op, ir.IT_VOID)
    if arg >= 0 { mut self.fn.arg_add(id, arg) }
    from: int = self.cur
    if s0 >= 0 { mut self.fn.edge_add(from, s0) }
    if s1 >= 0 { mut self.fn.edge_add(from, s1) }
    self.cur = -1
}

Lw.jump(mut self, to: int) {
    if self.cur >= 0 { mut self.terminate(ir.IR_JMP, -1, to, -1) }
}

Lw.enter(mut self, b: int) {
    if self.fn.block(b).preds.len > 0 { self.cur = b } else { self.cur = -1 }
}

// --- SSA variables ----------------------------------------------------------

def_key(b: int, var: int): u64 {
    return (u64(u32(b)) << 32) | u64(u32(var))
}

Lw.find(mut self, v: int): int {
    r: int = v
    for usize(r) < self.repl.len && self.repl.get(usize(r)) != 0 { r = self.repl.get(usize(r)) - 1 }
    x: int = v
    for x != r { // path compression
        next: int = self.repl.get(usize(x)) - 1
        mut self.repl.set(usize(x), r + 1)
        x = next
    }
    return r
}

Lw.replace(mut self, v: int, by: int) {
    for self.repl.len < self.fn.ins.len { fail(mut self.repl.push(0)) }
    mut self.repl.set(usize(v), by + 1)
    mut self.fn.at(v).block = -1
}

/* A new variable for symbol `s` (0 for one of lowering's own). */
Lw.var_new(mut self, s: u32, ty: u8, home: int): int {
    fail(mut self.vtype.push(ty))
    fail(mut self.home.push(home))
    v: int = int(self.vtype.len) - 1
    if s != 0 { fail(mut self.var_ix.set(s, v + 1)) }
    return v
}

/* The address of memory variable `var`. */
Lw.var_addr(mut self, var: int): int {
    h: int = self.home.get(usize(var))
    if h >= 0 { return h }
    return mut self.read_var(ADDR_VAR - h, self.cur)
}

/* An instruction at the top of the entry block, which dominates every use. */
Lw.at_entry(mut self, op: u8, ty: u8): int {
    id: int = mut self.fn.new_phi(0, ty) // after the entry's (absent) phis
    x: mut *ir.IrIns = mut self.fn.at(id)
    x.op = op
    x.at = self.f
    return id
}

/* The variable of local `s`, made on first sight: in a slot when something
 * needs its storage, else SSA values.
 */
Lw.var_of(mut self, s: u32): int {
    ix: int, found: bool = self.var_ix.get(s)
    if found { return ix - 1 }
    return mut self.var_make(s, self.s.sym(s).ty, self.stored.has(s))
}

/* A new variable of type t, for local `s` (0 for none): in a slot when
 * stored or in memory, else SSA values.
 */
Lw.var_make(mut self, s: u32, t: u32, stored: bool): int {
    if stored || self.in_memory(t) {
        if self.is_agg(t) { mut self.covered(t) }
        slot: int = mut self.at_entry(ir.IR_SLOT, ir.IT_PTR)
        x: mut *ir.IrIns = mut self.fn.at(slot)
        x.imm = u64(self.ty(t).size)
        x.aux = i32(self.ty(t).align)
        return mut self.var_new(s, ir.IT_VOID, slot)
    }
    if !self.is_agg(t) { return mut self.var_new(s, mut self.need_type(t), -1) }
    lv: ir.Leaves = blank(ir.Leaves)
    n: int = mut self.leaves(t, mut lv)
    first: int = int(self.vtype.len)
    if n == 0 { _ = mut self.var_new(0, ir.IT_VOID, -1) } // an empty aggregate's placeholder, never read
    for k: int in 0..n { _ = mut self.var_new(0, lv.v[k].ty, -1) }
    if s != 0 { fail(mut self.var_ix.set(s, first + 1)) }
    return first
}

Lw.write_var(mut self, var: int, b: int, v: int) {
    if b < 0 { return }
    fail(mut self.defs.set(def_key(b, var), v))
}

/* A phi whose operands are one value, apart from itself, is that value. */
Lw.try_remove_trivial(mut self, phi: int): int {
    same: int = -1
    n: u32 = self.fn.at(phi).nargs
    for i: u32 in 0..n {
        op: int = mut self.find(self.fn.arg(phi, i))
        if op == same || op == phi { continue }
        if same >= 0 { return phi }
        same = op
    }
    if same < 0 { same = mut self.zero_at_entry(self.fn.at(phi).ty) }
    mut self.replace(phi, same)
    return same
}

Lw.add_phi_operands(mut self, var: int, phi: int): int {
    b: int = self.fn.at(phi).block
    np: usize = self.fn.block(b).preds.len
    for i: usize in 0..np {
        v: int = mut self.read_var(var, self.fn.block(b).preds.get(i))
        mut self.fn.arg_add(phi, v)
    }
    return mut self.try_remove_trivial(phi)
}

Lw.read_var(mut self, var: int, b: int): int {
    if b < 0 { return mut self.dummy() }
    d: int, found: bool = self.defs.get(def_key(b, var))
    if found { return mut self.find(d) }
    bb: ir.IrBlock = self.fn.block(b)
    v: int = 0
    if !bb.sealed {
        v = mut self.fn.new_phi(b, self.vtype.get(usize(var)))
        fail(mut self.inc.push(Incomplete { var = var, phi = v, next = self.inc_head.get(usize(b)) - 1 }))
        mut self.inc_head.set(usize(b), int(self.inc.len))
    } else if bb.preds.len == 0 {
        v = mut self.zero_at_entry(self.vtype.get(usize(var)))
    } else if bb.preds.len == 1 {
        v = mut self.read_var(var, bb.preds.get(0))
    } else {
        v = mut self.fn.new_phi(b, self.vtype.get(usize(var)))
        mut self.write_var(var, b, v) // breaks cycles through this block
        v = mut self.add_phi_operands(var, v)
    }
    mut self.write_var(var, b, v)
    return v
}

Lw.seal(mut self, b: int) {
    if usize(b) < self.inc_head.len {
        i: int = self.inc_head.get(usize(b)) - 1
        for i >= 0 {
            p: Incomplete = self.inc.get(usize(i))
            _ = mut self.add_phi_operands(p.var, p.phi)
            i = p.next
        }
        mut self.inc_head.set(usize(b), 0)
    }
    mut self.fn.block(b).sealed = true
}

Lw.new_block(mut self): int {
    b: int = mut self.fn.new_block()
    for self.inc_head.len < self.fn.blocks.len { fail(mut self.inc_head.push(0)) }
    return b
}

// --- storage ----------------------------------------------------------------

/* The local whose storage a place expression names, or 0: through fields of
 * a struct value and elements of an array value, never through a pointer.
 */
Lw.root_local(self, at: u32): u32 {
    x: u32 = at
    for x != 0 && (self.node(x).kind == Kind.selector || self.node(x).kind == Kind.index) {
        bt: u32 = self.unwrap(self.nty(self.node(x).a))
        if bt == 0 || self.ty(bt).kind == TypeKind.ptr || (self.node(x).kind == Kind.index && self.ty(bt).kind != TypeKind.array) { return 0 }
        x = self.node(x).a
    }
    if x == 0 || self.node(x).kind != Kind.ident { return 0 }
    s: u32 = self.nsym(x)
    if s == 0 || self.s.sym(s).kind != sema.SymKind.var || self.s.sym(s).is_global { return 0 }
    return s
}

/* Records that local `x` names needs storage: for every local, or whether it
 * is the scanned parameter.
 */
Lw.need_storage(mut self, x: u32) {
    s: u32 = self.root_local(x)
    if s == 0 { return }
    if self.want == 0 { fail(mut self.stored.set(s, true)) } else if s == self.want { self.hit = true }
}

/* The inline declaration call `x` expands, as lowering will decide, with the
 * type arguments its body is stamped under; 0 when none.
 */
Lw.scan_target(mut self, x: u32): (u32, u32, u32) {
    if self.in_defer { return 0, 0, 0 }
    f: u32, args: u32, nargs: u32 = self.inline_target(x)
    if f == 0 || self.node(f).b == 0 || ((self.node(f).flags & parser.F_INLINE) == 0 && !self.scan_auto) { return 0, 0, 0 }
    return f, args, nargs
}

/* Which parameters of inline declaration `f` need the storage their argument
 * names (bit i for parameter i): an expansion binds the others to the
 * argument's own variables. A generic body, whose calls resolve only once
 * stamped, is stamped under `args` and scanned per instantiation; a
 * specialization and a cycle count as needing it.
 */
Lw.scan_escapes(mut self, f: u32, args: u32, nargs: u32): u64 {
    fs: u32 = self.nsym(f)
    if fs != 0 && self.s.sym(fs).spec_args != 0 { return ESC_ALL }
    gen: int = -1 // f's entry in gesc, when generic
    tp: u32 = self.node(f).c
    if tp != 0 {
        if nargs == 0 || self.node(tp).nkids != nargs { return ESC_ALL }
        for i: usize in 0..self.gesc.len {
            g: GenEscape = self.gesc.get(i)
            if g.f == f && g.args == args { return g.esc }
        }
        fail(mut self.gesc.push(GenEscape { f = f, args = args, esc = ESC_ALL })) // a cycle meets all
        gen = int(self.gesc.len) - 1
        mut self.s.stamp_body(f, args, nargs) // inline_call stamps it again before each expansion
    } else {
        seen: u64, found: bool = self.escapes.get(f)
        if found { return seen }
        fail(mut self.escapes.set(f, ESC_ALL)) // a cycle meets all
        if fs != 0 && self.s.sym(fs).is_generic { return ESC_ALL }
    }
    esc: u64 = ESC_REST
    want: u32 = self.want
    hit: bool = self.hit
    in_defer: bool = self.in_defer
    self.in_defer = false
    for i: u32 = 0; i < self.node(f).nkids && i < 63; i += 1 {
        self.want = self.nsym(self.kid(f, i))
        if self.want == 0 { continue }
        self.hit = false
        mut self.scan_walk(self.node(f).b)
        if self.hit { esc |= u64(1) << u64(i) }
    }
    self.want = want
    self.hit = hit
    self.in_defer = in_defer
    if gen >= 0 { mut self.gesc.view()[gen].esc = esc } else { fail(mut self.escapes.set(f, esc)) }
    return esc
}

/* Marks each local whose storage the body needs, before any is read. Follows
 * a/b/c/kids, and d only as a general for's body.
 */
Lw.scan_walk(mut self, at: u32) {
    if at == 0 { return }
    n: Node = self.node(at)
    if n.kind == Kind.func { return }
    if n.kind == Kind.unary && (n.op == Token.amp || n.op == Token.volatile) { mut self.need_storage(n.a) }
    if n.kind == Kind.assign && (n.flags & parser.F_VOLATILE) != 0 {
        for i: u32 in 0..n.nkids { mut self.need_storage(self.kid(at, i)) }
    }
    if n.kind == Kind.param && self.want == 0 {
        ps: u32 = self.nsym(at)
        if ps != 0 && self.in_memory(self.s.sym(ps).ty) { fail(mut self.stored.set(ps, true)) } // a binder in memory
    }
    if n.kind == Kind.defer {
        in_defer: bool = self.in_defer
        self.in_defer = true
        mut self.scan_walk(n.a)
        mut self.scan_walk(n.b)
        mut self.scan_walk(n.c)
        for i: u32 in 0..n.nkids { mut self.scan_walk(self.kid(at, i)) }
        self.in_defer = in_defer
        return
    }
    if n.kind == Kind.call { // a receiver or mut argument: storage unless an expansion binds it in place
        f: u32, args: u32, nargs: u32 = mut self.scan_target(at)
        esc: u64 = ESC_ALL
        if f != 0 { esc = mut self.scan_escapes(f, args, nargs) }
        recv: bool = n.a != 0 && self.node(n.a).kind == Kind.selector && !self.assoc_call(at) && !self.field_call(at)
        if recv && (esc & 1) != 0 && !self.is_pointer(self.node(n.a).a) { mut self.need_storage(self.node(n.a).a) } // p.m() is (*p).m()
        for i: u32 in 0..n.nkids {
            k: u32 = self.kid(at, i)
            p: u64 = u64(i)
            if recv { p += 1 }
            if p > 63 { p = 63 }
            if self.node(k).kind == Kind.mutarg && ((esc >> p) & 1) != 0 { mut self.need_storage(self.node(k).a) }
        }
        mut self.scan_walk(n.a)
        mut self.scan_walk(n.b)
        mut self.scan_walk(n.c)
        for i: u32 in 0..n.nkids {
            k: u32 = self.kid(at, i)
            if self.node(k).kind == Kind.mutarg { mut self.scan_walk(self.node(k).a) } else { mut self.scan_walk(k) }
        }
        return
    }
    if n.kind == Kind.mutarg { mut self.need_storage(n.a) }
    mut self.scan_walk(n.a)
    mut self.scan_walk(n.b)
    mut self.scan_walk(n.c)
    if n.kind == Kind.for && (n.flags & parser.F_FORGEN) != 0 { mut self.scan_walk(n.d) }
    for i: u32 in 0..n.nkids { mut self.scan_walk(self.kid(at, i)) }
}

/* Whether `call` names an associated function through its owner (C's F_ASSOC on the call). */
Lw.assoc_call(self, call: u32): bool {
    s: u32 = self.nsym(call)
    if s == 0 || self.s.sym(s).kind != sema.SymKind.func || self.s.sym(s).decl == 0 { return false }
    return (self.node(self.s.sym(s).decl).flags & parser.F_ASSOC) != 0
}

/* Whether `call` goes through a function value in a struct field (C's F_FIELDCALL). */
Lw.field_call(self, call: u32): bool {
    c: Node = self.node(call)
    if c.a == 0 || self.node(c.a).kind != Kind.selector || self.nsym(call) != 0 { return false }
    return self.kind(self.nty(c.a)) == TypeKind.func && self.kind(self.nty(self.node(c.a).a)) != TypeKind.contract
}

Lw.load(mut self, t: u8, addr: int, off: i32, flags: u8): int {
    id: int = mut self.emit2(ir.IR_LOAD, t, addr, -1)
    x: mut *ir.IrIns = mut self.fn.at(id)
    x.aux = off
    x.flags = flags
    return id
}

Lw.store(mut self, addr: int, off: i32, v: int, flags: u8) {
    id: int = mut self.emit2(ir.IR_STORE, ir.IT_VOID, addr, v)
    x: mut *ir.IrIns = mut self.fn.at(id)
    x.aux = off
    x.flags = flags
}

/* A debug null check on an address that came from a pointer value. */
Lw.null_checked(self): u8 {
    if self.debug { return ir.IRF_CHECKED }
    return 0
}

/* The check for an access through address `addr`: none for a slot or a global. */
Lw.access_check(self, addr: int): u8 {
    op: u8 = self.fn.at(addr).op
    if op == ir.IR_SLOT || op == ir.IR_GLOBAL { return 0 }
    return self.null_checked()
}

/* The address of global variable or function `s`: a function or C global
 * binds its link name, an Ace global its __ace$g$ name.
 */
Lw.global_addr(mut self, s: u32): int {
    sy: sema.Sym = self.s.sym(s)
    name: string = ""
    if sy.kind == sema.SymKind.func || self.c_named(s) {
        name = mut self.link_name(s, sy.ty)
    } else {
        name = mut self.fn.names.join(["__ace$g$", sy.name])
    }
    id: int = mut self.emit(ir.IR_GLOBAL, ir.IT_PTR)
    x: mut *ir.IrIns = mut self.fn.at(id)
    x.sym = s
    x.name = name
    return id
}

/* The address of generic function `s` as value `x` names it: its instance. */
Lw.fn_value_addr(mut self, s: u32, x: u32): int {
    name: string = mut self.fn_value_mangle(s, x)
    id: int = mut self.global_addr(s)
    mut self.fn.at(id).name = name
    return id
}

/* The type *x names, through every level of dereference. */
Lw.deref_type(self, x: u32): u32 {
    a: u32 = self.node(x).a
    t: u32 = 0
    if self.node(a).kind == Kind.unary && self.node(a).op == Token.star { t = self.deref_type(a) } else { t = self.nty(a) }
    u: u32 = self.unwrap(t)
    if u != 0 && self.ty(u).kind == TypeKind.ptr { return self.ty(u).base }
    return 0
}

/* The place field `x` is read from: x.a, or what it points to through every
 * level; the second result its type.
 */
Lw.field_base(mut self, x: u32): (Place, u32) {
    a: u32 = self.node(x).a
    t: u32 = self.unwrap(self.nty(a))
    if t == 0 || self.ty(t).kind != TypeKind.ptr { return mut self.place(a), t }
    p: Place = Place { addr = mut self.expr(a, int(ir.IT_PTR)) }
    p.flags = self.access_check(p.addr)
    t = self.unwrap(self.ty(t).base)
    for t != 0 && self.ty(t).kind == TypeKind.ptr {
        p.addr = mut self.load(ir.IT_PTR, p.addr, 0, p.flags)
        p.flags = self.access_check(p.addr)
        t = self.unwrap(self.ty(t).base)
    }
    p.t = t
    return p, t
}

Lw.place(mut self, x: u32): Place {
    n: Node = self.node(x)
    p: Place = Place { t = self.nty(x) }
    c: Capture, captured: bool = self.captured.get(x)
    if captured {
        p.t = c.t
        if self.home.get(usize(c.var)) == -1 { p.var = c.var } else { p.addr = mut self.var_addr(c.var) }
        return p
    }
    switch n.kind {
        Kind.ident {
            s: u32 = self.nsym(x)
            if s == 0 || self.s.sym(s).kind != sema.SymKind.var {
                mut self.unsupported("non-variable name")
                p.addr = mut self.dummy()
                return p
            }
            p.t = self.s.sym(s).ty
            if self.s.sym(s).is_global {
                p.addr = mut self.global_addr(s)
                return p
            }
            var: int = mut self.var_of(s)
            if self.home.get(usize(var)) == -1 { p.var = var } else { p.addr = mut self.var_addr(var) }
            return p
        }
        Kind.unary {
            if n.op == Token.star {
                p.addr = mut self.expr(n.a, int(ir.IT_PTR))
                p.flags = self.access_check(p.addr)
                p.t = self.deref_type(x)
                if p.t == 0 { mut self.unsupported("pointer") }
                return p
            }
        }
        Kind.selector {
            q: Place, bt: u32 = mut self.field_base(x)
            if bt == 0 || self.ty(bt).kind != TypeKind.struct {
                if bt != 0 { mut self.unsupported(self.type_why(bt)) } else { mut self.unsupported("field access") }
                q.var = -1
                q.addr = mut self.dummy()
                return q
            }
            fi: int = self.find_field(bt, n.text)
            if fi < 0 {
                mut self.unsupported("field access")
                q.addr = mut self.dummy()
                return q
            }
            f: sema.SField = self.s.field(self.ty(bt), u32(fi))
            if q.var >= 0 { q.var += mut self.leaf_index(bt, u32(fi)) } // its leaves' variables
            q.off += i32(f.offset)
            q.t = f.ty
            return q
        }
        Kind.index { return mut self.element(x) }
        default {}
    }
    mut self.unsupported("assignment target")
    p.addr = mut self.dummy()
    return p
}

/* Assigns variable `var`, in SSA or at its home. */
Lw.set_var(mut self, var: int, v: int) {
    if self.home.get(usize(var)) == -1 {
        mut self.write_var(var, self.cur, v)
    } else {
        mut self.store(mut self.var_addr(var), 0, v, 0)
    }
}

Lw.place_read(mut self, p: Place, flags: u8): int {
    if p.var >= 0 { return mut self.read_var(p.var, self.cur) }
    return mut self.load(mut self.need_type(p.t), p.addr, p.off, p.flags | flags)
}

Lw.place_write(mut self, p: Place, v: int, flags: u8) {
    if p.var >= 0 {
        mut self.write_var(p.var, self.cur, v)
    } else {
        mut self.store(p.addr, p.off, v, p.flags | flags)
    }
}

/* Every leaf of a place, a scalar's included. */
Lw.place_get(mut self, p: Place, flags: u8, mut out: Agg) {
    lv: ir.Leaves = blank(ir.Leaves)
    out.n = mut self.leaves(p.t, mut lv)
    for k: int in 0..out.n {
        if p.var >= 0 {
            out.v[k] = mut self.read_var(p.var + k, self.cur)
        } else {
            out.v[k] = mut self.load(lv.v[k].ty, p.addr, p.off + i32(lv.v[k].off), p.flags | flags)
        }
    }
}

Lw.place_put(mut self, p: Place, a: Agg, flags: u8) {
    lv: ir.Leaves = blank(ir.Leaves)
    _ = mut self.leaves(p.t, mut lv)
    for k: int in 0..a.n {
        if p.var >= 0 {
            mut self.write_var(p.var + k, self.cur, a.v[k])
        } else {
            mut self.store(p.addr, p.off + i32(lv.v[k].off), a.v[k], p.flags | flags)
        }
    }
}

/* The address of a memory place; a pointer-derived one is null-checked here. */
Lw.place_address(mut self, p: Place): int {
    if p.var >= 0 {
        mut self.unsupported("address of a register value")
        return mut self.dummy()
    }
    if p.off == 0 && p.flags == 0 { return p.addr }
    k: int = mut self.konst(ir.IT_U64, u64(p.off))
    id: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, p.addr, k)
    x: mut *ir.IrIns = mut self.fn.at(id)
    x.imm = 1
    x.flags = p.flags
    return id
}

// --- memory -----------------------------------------------------------------

Lw.size(self, t: u32): u32 {
    return self.ty(self.unwrap(t)).size
}

/* An aggregate of over MAX_LEAVES leaves, or one holding a union: built and
 * copied by its parts in memory.
 */
Lw.by_parts(self, t: u32): bool {
    return self.is_big(t) || self.has_union(t)
}

/* A new stack object of type `t`. */
Lw.new_slot(mut self, t: u32): int {
    slot: int = mut self.at_entry(ir.IR_SLOT, ir.IT_PTR)
    x: mut *ir.IrIns = mut self.fn.at(slot)
    x.imm = u64(self.size(t))
    x.aux = i32(self.ty(self.unwrap(t)).align)
    return slot
}

/* Continues in a new block when bool `c` holds; guard_end joins the path
 * where it did not. A variable written between them meets its earlier value
 * there.
 */
Lw.guard(mut self, c: int): int {
    yes: int = mut self.new_block()
    join: int = mut self.new_block()
    mut self.terminate(ir.IR_BR, c, yes, join)
    mut self.seal(yes)
    mut self.enter(yes)
    return join
}

Lw.guard_end(mut self, join: int) {
    mut self.jump(join)
    mut self.seal(join)
    mut self.enter(join)
}

Lw.widen(mut self, v: int, from: u8, to: u8): int {
    if from == to { return v }
    return mut self.emit2(ir.IR_CAST, to, v, -1)
}

/* A copy or fill of up to this many words is straight-line. */
UNROLL: const u32 = 16

/* A counted loop over u64 i in [0, n): loop_begin enters the body and
 * returns i; loop_end steps i and leaves through the exit.
 */
Loop: struct {
    var: int = 0,
    head: int = 0,
    exit: int = 0,
}

Lw.loop_begin(mut self, mut lp: Loop, n: u64): int {
    lp.var = mut self.var_new(0, ir.IT_U64, -1)
    mut self.write_var(lp.var, self.cur, mut self.konst(ir.IT_U64, 0))
    lp.head = mut self.new_block()
    lp.exit = mut self.new_block()
    body: int = mut self.new_block()
    mut self.jump(lp.head)
    mut self.enter(lp.head)
    i: int = mut self.read_var(lp.var, lp.head)
    mut self.terminate(ir.IR_BR, mut self.emit2(ir.IR_LT, ir.IT_BOOL, i, mut self.konst(ir.IT_U64, n)), body, lp.exit)
    mut self.seal(body)
    mut self.enter(body)
    return i
}

Lw.loop_end(mut self, lp: Loop, i: int) {
    mut self.write_var(lp.var, self.cur, mut self.emit2(ir.IR_ADD, ir.IT_U64, i, mut self.konst(ir.IT_U64, 1)))
    mut self.jump(lp.head)
    mut self.seal(lp.head)
    mut self.seal(lp.exit)
    mut self.enter(lp.exit)
}

/* The address addr + off. */
Lw.offset_addr(mut self, addr: int, off: i32): int {
    if off == 0 { return addr }
    id: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, addr, mut self.konst(ir.IT_U64, u64(off)))
    mut self.fn.at(id).imm = 1
    return id
}

/* The unsigned IR type of a `w`-byte word. */
word_type(w: u32): u8 {
    if w == 8 { return ir.IT_U64 }
    if w == 4 { return ir.IT_U32 }
    if w == 2 { return ir.IT_U16 }
    return ir.IT_U8
}

/* Copies `size` bytes from src + soff (loads flagged `sflags`) to dst +
 * doff: words, then a narrower tail; a long run of words loops.
 */
Lw.copy_mem(mut self, dst: int, doff: i32, src: int, soff: i32, sflags: u8, size: u32) {
    words: u32 = size / 8
    done: u32 = 0
    if words > UNROLL {
        d: int = mut self.offset_addr(dst, doff)
        s: int = mut self.offset_addr(src, soff)
        lp: Loop = Loop {}
        i: int = mut self.loop_begin(mut lp, u64(words))
        sa: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, s, i)
        da: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, d, i)
        mut self.fn.at(sa).imm = 8
        mut self.fn.at(da).imm = 8
        mut self.store(da, 0, mut self.load(ir.IT_U64, sa, 0, sflags), 0)
        mut self.loop_end(lp, i)
        done = words * 8
    }
    w: u32 = 8
    for w > 0 {
        t: u8 = word_type(w)
        for size - done >= w {
            mut self.store(dst, doff + i32(done), mut self.load(t, src, soff + i32(done), sflags), 0)
            done += w
        }
        w /= 2
    }
}

/* Fills `size` bytes at dst + off with u64 pattern `pat` (one repeating unit). */
Lw.fill_mem(mut self, dst: int, off: i32, pat: int, size: u32) {
    words: u32 = size / 8
    done: u32 = 0
    if words > UNROLL {
        d: int = mut self.offset_addr(dst, off)
        lp: Loop = Loop {}
        i: int = mut self.loop_begin(mut lp, u64(words))
        da: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, d, i)
        mut self.fn.at(da).imm = 8
        mut self.store(da, 0, pat, 0)
        mut self.loop_end(lp, i)
        done = words * 8
    }
    w: u32 = 8
    for w > 0 {
        if size - done >= w {
            v: int = pat
            if w != 8 { v = mut self.emit2(ir.IR_CAST, word_type(w), pat, -1) }
            for size - done >= w {
                mut self.store(dst, off + i32(done), v, 0)
                done += w
            }
        }
        w /= 2
    }
}

/* The u64 repeating element value `v` of type `t`, or -1 when its bytes do
 * not repeat in a word (a float's, or a width that does not divide 8).
 */
Lw.fill_pattern(mut self, v: int, t: u32): int {
    it: int = ir.type_of(*self.s, t)
    w: u32 = self.size(t)
    if it < 0 || ir.type_float(u8(it)) || u8(it) == ir.IT_PTR || (w != 1 && w != 2 && w != 4 && w != 8) { return -1 }
    rep: u64 = 1
    if w == 1 { rep = 0x0101010101010101 } else if w == 2 { rep = 0x0001000100010001 } else if w == 4 { rep = 0x0000000100000001 }
    k: ir.IrIns = self.fn.at(v)
    if k.op == ir.IR_CONST {
        b: u64 = k.imm
        if w != 8 { b = k.imm & ((u64(1) << u64(w * 8)) - 1) }
        return mut self.konst(ir.IT_U64, b * rep)
    }
    ut: u8 = word_type(w)
    if u8(it) == ir.IT_BOOL { ut = ir.IT_BOOL }
    x: int = v
    if ut != u8(it) { x = mut self.emit2(ir.IR_CAST, ut, x, -1) } // its bits, zero-extended
    if ut != ir.IT_U64 { x = mut self.emit2(ir.IR_CAST, ir.IT_U64, x, -1) }
    if w == 8 { return x }
    return mut self.emit2(ir.IR_MUL, ir.IT_U64, x, mut self.konst(ir.IT_U64, rep))
}

/* `x` past any array conversions [N]T(...), which keep its bytes. */
Lw.array_cast_arg(self, at: u32): u32 {
    x: u32 = at
    for self.node(x).kind == Kind.call && self.node(x).a != 0 && self.node(self.node(x).a).kind == Kind.array_t { x = self.kid(x, 0) }
    return x
}

/* An array literal entry's value, past a `key: ` (Syntax & Parsing #16). */
Lw.lit_elem(self, k: u32): u32 {
    if self.node(k).kind == Kind.mapentry { return self.node(k).b }
    return k
}

/* An array literal entry's element index: its key member's, else its position. */
Lw.lit_slot(self, k: u32, i: u32): u64 {
    if self.node(k).kind == Kind.mapentry { return self.s.node_ival(self.node(k).a) }
    return u64(i)
}

/* Whether call `x` is the layout builtin `name` (no function of that name). */
Lw.is_layout_builtin(self, x: u32, name: string): bool {
    n: Node = self.node(x)
    return n.kind == Kind.call && n.a != 0 && self.node(n.a).kind == Kind.ident && self.nsym(x) == 0 && mem.equal(self.node(n.a).text, name)
}

/* The default sema leaves to struct literal `x` for field `i` it omits, or 0. */
Lw.lit_default(self, x: u32, u: u32, i: u32): u32 {
    f: sema.SField = self.s.field(self.ty(u), i)
    if f.default_value == 0 { return 0 }
    for j: u32 in 0..self.node(x).nkids {
        if mem.equal(self.node(self.kid(x, j)).text, f.name) { return 0 }
    }
    return f.default_value
}

/* Stores `x`, of type `t`, to memory at dst + off: an aggregate literal
 * member by member, a place's bytes copied, a call's result written there.
 */
Lw.store_value(mut self, at: u32, t: u32, dst: int, off: i32) {
    if self.failed() { return }
    x: u32 = at
    if !self.captured.has(at) { x = self.array_cast_arg(at) }
    n: Node = self.node(x)
    if self.captured.has(x) { n.kind = Kind.ident } // read as the name C gives it
    if n.kind == Kind.cond && self.is_big(t) { // each branch writes dst + off itself
        then: int, els: int, join: int = mut self.cond_split(x)
        mut self.enter(then)
        if self.cur >= 0 { mut self.store_value(n.b, t, dst, off) }
        mut self.jump(join)
        mut self.enter(els)
        if self.cur >= 0 { mut self.store_value(n.c, t, dst, off) }
        mut self.jump(join)
        mut self.seal(join)
        mut self.enter(join)
        return
    }
    u: u32 = self.unwrap(t)
    if n.kind == Kind.arraylit && u != 0 && self.ty(u).kind == TypeKind.array {
        ut: SType = self.ty(u)
        es: u32 = self.size(ut.base)
        if n.a == 0 {
            for i: u32 in 0..n.nkids { // written order; a keyed entry at its member's slot
                k: u32 = self.kid(x, i)
                mut self.store_value(self.lit_elem(k), ut.base, dst, off + i32(self.lit_slot(k, i) * u64(es)))
            }
            return
        }
        if ut.count == 0 { return }
        if !self.is_agg(ut.base) { // [v : n]: v once, as a repeating word when its bytes allow
            v: int = mut self.expr(n.a, int(mut self.need_type(ut.base)))
            pat: int = mut self.fill_pattern(v, ut.base)
            if pat >= 0 {
                mut self.fill_mem(dst, off, pat, u32(ut.count) * es)
                return
            }
        }
        mut self.store_value(n.a, ut.base, dst, off) // the first element, then copies of it
        if ut.count - 1 <= u64(UNROLL) {
            for i: u64 in 1..ut.count { mut self.copy_mem(dst, off + i32(i * u64(es)), dst, off, 0, es) }
            return
        }
        d: int = mut self.offset_addr(dst, off)
        lp: Loop = Loop {}
        i: int = mut self.loop_begin(mut lp, ut.count - 1)
        one: int = mut self.konst(ir.IT_U64, 1)
        ea: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, d, mut self.emit2(ir.IR_ADD, ir.IT_U64, i, one))
        mut self.fn.at(ea).imm = u64(es)
        mut self.copy_mem(ea, 0, d, 0, 0, es)
        mut self.loop_end(lp, i)
        return
    }
    if u != 0 && self.ty(u).kind == TypeKind.union {
        ctor: bool, _, _ = self.union_ctor(x)
        if ctor {
            mut self.union_store(x, t, dst, off)
            return
        }
    }
    if ((n.kind == Kind.structlit && u != 0 && self.ty(u).kind == TypeKind.struct) || (n.kind == Kind.tuple && u != 0 && self.ty(u).kind == TypeKind.tuple)) && self.by_parts(t) {
        ut: SType = self.ty(u)
        tuple: bool = n.kind == Kind.tuple
        positional: bool = tuple || (n.nkids > 0 && self.node(self.kid(x, 0)).text.len == 0)
        given: u32 = n.nkids
        if !positional {
            for i: u32 in 0..ut.nfields {
                if self.lit_default(x, u, i) != 0 { given += 1 }
            }
        }
        if given != ut.nfields { // sema supplies every field
            mut self.unsupported("field initializer")
            return
        }
        for i: u32 in 0..n.nkids {
            fi: u32 = self.kid(x, i)
            fidx: int = int(i)
            if !positional { fidx = self.find_field(u, self.node(fi).text) }
            if fidx < 0 {
                mut self.unsupported("field initializer")
                return
            }
            f: sema.SField = self.s.field(ut, u32(fidx))
            e: u32 = fi
            if !tuple { e = self.node(fi).a }
            mut self.store_value(e, f.ty, dst, off + i32(f.offset))
        }
        if !positional { // the declaration's defaults, in field order
            for i: u32 in 0..ut.nfields {
                dv: u32 = self.lit_default(x, u, i)
                if dv != 0 { mut self.store_value(dv, self.s.field(ut, i).ty, dst, off + i32(self.s.field(ut, i).offset)) }
            }
        }
        return
    }
    if self.is_agg(t) && !self.is_view(t) && self.is_place(x) {
        p: Place = mut self.place(x)
        if p.var < 0 {
            mut self.copy_mem(dst, off, p.addr, p.off, p.flags, self.size(t))
            return
        }
    }
    if self.is_big(t) && self.is_layout_builtin(x, "blank") {
        mut self.fill_mem(dst, off, mut self.konst(ir.IT_U64, 0), self.size(t))
        return
    }
    if self.is_big(t) && n.kind == Kind.call { // its result goes straight to dst + off
        none: Agg = blank(Agg)
        _ = mut self.call(x, -1, mut none, false, mut self.offset_addr(dst, off))
        return
    }
    if self.is_big(t) {
        mut self.unsupported("aggregate of over 32 leaves")
        return
    }
    a: Agg = blank(Agg)
    mut self.value(x, t, mut a)
    lv: ir.Leaves = blank(ir.Leaves)
    _ = mut self.leaves(t, mut lv)
    for k: int in 0..a.n { mut self.store(dst, off + i32(lv.v[k].off), a.v[k], 0) }
}

/* Array `x` as a place in memory: its own, or a new stack object holding it. */
Lw.array_place(mut self, at: u32): Place {
    x: u32 = self.array_cast_arg(at)
    if self.is_place(x) {
        p: Place = mut self.place(x)
        if p.var < 0 { return p }
    }
    t: u32 = self.nty(x)
    mut self.covered(t)
    slot: int = mut self.new_slot(t)
    mut self.store_value(x, t, slot, 0)
    return Place { addr = slot, t = t }
}

/* The storage of `x`, a value that is no place (a call's result, or a field
 * of one): a new stack object holding it, or the field's offset within that.
 */
Lw.temp_place(mut self, x: u32): Place {
    n: Node = self.node(x)
    bt: u32 = 0
    if n.kind == Kind.selector { bt = self.unwrap(self.nty(n.a)) }
    fi: int = -1
    if bt != 0 && self.ty(bt).kind == TypeKind.struct { fi = self.find_field(bt, n.text) }
    if fi >= 0 && !self.is_place(n.a) {
        p: Place = mut self.temp_place(n.a)
        f: sema.SField = self.s.field(self.ty(bt), u32(fi))
        p.off += i32(f.offset)
        p.t = f.ty
        return p
    }
    t: u32 = self.nty(x)
    mut self.covered(t)
    slot: int = mut self.new_slot(t)
    mut self.store_value(x, t, slot, 0)
    return Place { addr = slot, t = t }
}

/* Debug: traps through the bounds failure at `site` unless `c` holds. */
Lw.bounds_check(mut self, c: int, site: u32) {
    id: int = mut self.emit2(ir.IR_CHECK, ir.IT_VOID, c, -1)
    x: mut *ir.IrIns = mut self.fn.at(id)
    x.name = "bounds violation"
    x.has_name = true
    x.at = site
}

/* Index `x` of `site` as a u64; a signed one is first checked nonnegative
 * (Sequences #12) when `nonneg`.
 */
Lw.bound(mut self, x: u32, site: u32, nonneg: bool): int {
    t: u8 = mut self.type_in(x, int(ir.IT_U64))
    v: int = mut self.expr(x, int(t))
    if nonneg && ir.type_signed(t) { mut self.bounds_check(mut self.emit2(ir.IR_GE, ir.IT_BOOL, v, mut self.konst(t, 0)), site) }
    if t == ir.IT_U64 { return v }
    return mut self.emit2(ir.IR_CAST, ir.IT_U64, v, -1)
}

/* The place of element x = a[i]: at a fixed offset from an array's place,
 * checked in debug unless its index is an [E]T's enum (Safety #2).
 */
Lw.element(mut self, x: u32): Place {
    n: Node = self.node(x)
    st: u32 = self.unwrap(self.nty(n.a))
    if st != 0 && self.ty(st).kind == TypeKind.array {
        ut: SType = self.ty(st)
        chk: bool = self.debug && (self.s.node_proof(x) & sema.PROOF_BOUNDS) == 0
        p: Place = mut self.array_place(n.a)
        es: u32 = self.size(ut.base)
        p.t = ut.base
        b: Node = self.node(n.b)
        if b.kind == Kind.int_lit && b.ival < ut.count { // a constant index (sema rejects one out of range)
            p.off += i32(b.ival * u64(es))
            return p
        }
        i: int = mut self.bound(n.b, x, chk)
        if chk { mut self.bounds_check(mut self.emit2(ir.IR_LT, ir.IT_BOOL, i, mut self.konst(ir.IT_U64, ut.count)), x) }
        id: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, p.addr, i) // the place's offset stays on the access
        e: mut *ir.IrIns = mut self.fn.at(id)
        e.imm = u64(es)
        e.flags = p.flags // a null base traps here
        return Place { addr = id, off = p.off, t = ut.base }
    }
    if st != 0 && self.ty(st).kind == TypeKind.staticmap { return mut self.staticmap_place(x, st) }
    if !self.is_view(st) {
        mut self.unsupported(self.type_why(st))
        return Place { addr = mut self.dummy(), t = self.nty(x) }
    }
    chk: bool = self.debug && (self.s.node_proof(x) & sema.PROOF_BOUNDS) == 0
    ptr: int, len: int = mut self.view_parts(n.a, chk)
    i: int = mut self.bound(n.b, x, chk)
    if chk { mut self.bounds_check(mut self.emit2(ir.IR_LT, ir.IT_BOOL, i, len), x) }
    et: u32 = self.view_elem(st)
    id: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, ptr, i)
    mut self.fn.at(id).imm = u64(self.size(et))
    return Place { addr = id, t = et }
}

/* Copies memory place `src` to place `dst` of its type: bytes between
 * memory, else leaves.
 */
Lw.move_place(mut self, dst: Place, src: Place) {
    if dst.var < 0 && (self.is_big(src.t) || self.has_array(src.t)) {
        d: int = dst.addr // a pointer-derived one is checked once
        doff: i32 = dst.off
        if dst.flags != 0 {
            d = mut self.place_address(dst)
            doff = 0
        }
        mut self.copy_mem(d, doff, src.addr, src.off, src.flags, self.size(src.t))
        return
    }
    a: Agg = blank(Agg)
    mut self.place_get(src, 0, mut a)
    mut self.place_put(dst, a, 0)
}

// --- bits -------------------------------------------------------------------

/* The bits type whose named field `x` projects (Scalar-backed Bit Fields #3)
 * and the field's index, or 0 when `x` is no such field.
 */
Lw.bits_field(self, x: u32): (u32, u32) {
    n: Node = self.node(x)
    if n.kind != Kind.selector { return 0, 0 }
    t: u32 = self.unwrap(self.nty(n.a))
    for t != 0 && self.ty(t).kind == TypeKind.ptr { t = self.unwrap(self.ty(t).base) }
    if t == 0 || self.ty(t).kind != TypeKind.bits { return 0, 0 }
    fi: int = self.find_field(t, n.text)
    if fi < 0 || self.s.field(self.ty(t), u32(fi)).bit_anonymous { return 0, 0 }
    return t, u32(fi)
}

/* Field `f` of bits type `b`'s backing value `w`, zero- or sign-extended to
 * the field's type (#2).
 */
Lw.bits_get(mut self, b: u32, f: sema.SField, w: int): int {
    bt: u8 = mut self.need_type(b)
    ft: u8 = mut self.need_type(f.ty)
    n: u32 = u32(ir.type_bits(bt))
    width: u32 = f.bit_width
    v: int = w
    if !f.bit_signed {
        if f.bit_offset != 0 { v = mut self.emit2(ir.IR_SHR, bt, v, mut self.konst(bt, u64(f.bit_offset))) }
        if width + f.bit_offset < n { v = mut self.emit2(ir.IR_AND, bt, v, mut self.konst(bt, (u64(1) << u64(width)) - 1)) }
        return v
    }
    up: u32 = n - f.bit_offset - width // its top bit to the sign bit, then back down
    if up != 0 { v = mut self.emit2(ir.IR_SHL, bt, v, mut self.konst(bt, u64(up))) }
    v = mut self.emit2(ir.IR_CAST, ft, v, -1)
    if width < n { v = mut self.emit2(ir.IR_SHR, ft, v, mut self.konst(ft, u64(n - width))) }
    return v
}

/* Bits type `b`'s backing value `w` with field `f` replaced by `v`, of the
 * field's type, where f's bits of w are zero unless `clear`; debug first
 * checks v fits the field's width (#4).
 */
Lw.bits_set(mut self, b: u32, f: sema.SField, w: int, v: int, clear: bool): int {
    bt: u8 = mut self.need_type(b)
    ft: u8 = mut self.need_type(f.ty)
    n: u32 = u32(ir.type_bits(bt))
    width: u32 = f.bit_width
    low: u64 = 0xffffffffffffffff
    if width != 64 { low = (u64(1) << u64(width)) - 1 }
    if width == n { return mut self.widen(v, ft, bt) }
    if self.debug {
        c: int = 0
        if f.bit_signed { // out of range: sign-extending its low bits changes it
            k: int = mut self.konst(ft, u64(n - width))
            c = mut self.emit2(ir.IR_NE, ir.IT_BOOL, mut self.emit2(ir.IR_SHR, ft, mut self.emit2(ir.IR_SHL, ft, v, k), k), v)
        } else {
            c = mut self.emit2(ir.IR_GT, ir.IT_BOOL, v, mut self.konst(ft, low))
        }
        bad: int = mut self.guard(c)
        _ = mut self.call_routine("__ace$arithmetic_fail", false, ir.IT_VOID, null)
        mut self.guard_end(bad)
    }
    wv: int = mut self.widen(v, ft, bt)
    u: int = mut self.emit2(ir.IR_AND, bt, wv, mut self.konst(bt, low))
    if f.bit_offset != 0 { u = mut self.emit2(ir.IR_SHL, bt, u, mut self.konst(bt, u64(f.bit_offset))) }
    x: int = w
    if clear { x = mut self.emit2(ir.IR_AND, bt, x, mut self.konst(bt, ~(low << u64(f.bit_offset)))) }
    return mut self.emit2(ir.IR_OR, bt, x, u)
}

/* Bits field `x` assigned, or with a compound op, the value of `rhs`, or `v`
 * when rhs is 0: one read-modify-write of the whole backing value (#3), read
 * before rhs is evaluated.
 */
Lw.bits_assign(mut self, x: u32, op: Token, rhs: u32, v0: int) {
    b: u32, fi: u32 = self.bits_field(x)
    f: sema.SField = self.s.field(self.ty(b), fi)
    ft: u8 = mut self.need_type(f.ty)
    v: int = v0
    if rhs != 0 { v = mut self.expr(rhs, int(ft)) } // the right side before the target (Memory #9)
    p: Place, _ = mut self.field_base(x)
    w: int = mut self.place_read(p, 0)
    if op != Token.assign {
        bop: int = binop_of(op)
        if bop < 0 {
            mut self.unsupported("compound assignment")
            return
        }
        v = mut self.arith(u8(bop), ft, mut self.bits_get(b, f, w), v)
    }
    mut self.place_write(p, mut self.bits_set(b, f, w, v, true), 0)
}

// --- aggregate values -------------------------------------------------------

/* The leaves of field `x` of a value that is no place: a call's result or a
 * literal. One of over MAX_LEAVES leaves, like one with a union, is stored to a new
 * stack object and the field read from it.
 */
Lw.field_leaves(mut self, x: u32, mut out: Agg) {
    n: Node = self.node(x)
    bt: u32 = self.unwrap(self.nty(n.a))
    out.n = 0
    if bt == 0 || self.ty(bt).kind != TypeKind.struct {
        if bt != 0 { mut self.unsupported(self.type_why(bt)) } else { mut self.unsupported("field access") }
        return
    }
    fi: int = self.find_field(bt, n.text)
    if fi < 0 {
        mut self.unsupported("field access")
        return
    }
    f: sema.SField = self.s.field(self.ty(bt), u32(fi))
    if self.has_union(bt) || self.is_big(bt) { // its words, not its members': stored, then the field read
        mut self.covered(bt)
        slot: int = mut self.new_slot(bt)
        mut self.store_value(n.a, bt, slot, 0)
        mut self.place_get(Place { addr = slot, off = i32(f.offset), t = f.ty }, 0, mut out)
        return
    }
    b: Agg = blank(Agg)
    mut self.value(n.a, self.nty(n.a), mut b)
    at: int = mut self.leaf_index(bt, u32(fi))
    cnt: int = mut self.leaf_count(f.ty)
    if self.failed() { return }
    out.n = cnt
    for k: int in 0..cnt { out.v[k] = b.v[at + k] }
}

/* The leaves of struct or tuple literal `x` of type `t`, in field order; its
 * fields are evaluated in source order, then the declaration's defaults.
 */
Lw.literal_agg(mut self, x: u32, t: u32, mut out: Agg) {
    u: u32 = self.unwrap(t)
    lv: ir.Leaves = blank(ir.Leaves)
    out.n = mut self.leaves(t, mut lv)
    for k: int in 0..out.n { out.v[k] = -1 }
    n: Node = self.node(x)
    tuple: bool = n.kind == Kind.tuple
    positional: bool = tuple || (n.nkids > 0 && self.node(self.kid(x, 0)).text.len == 0)
    if u == 0 || (tuple && (self.ty(u).kind != TypeKind.tuple || n.nkids != self.ty(u).nfields)) || (!tuple && self.ty(u).kind != TypeKind.struct) {
        mut self.unsupported(self.type_why(t))
        out.n = 0
        return
    }
    ut: SType = self.ty(u)
    for i: u32 in 0..n.nkids {
        fi: u32 = self.kid(x, i)
        fidx: int = int(i)
        if !positional { fidx = self.find_field(u, self.node(fi).text) }
        if fidx < 0 || fidx >= int(ut.nfields) {
            mut self.unsupported("field initializer")
            out.n = 0
            return
        }
        e: u32 = fi
        if !tuple { e = self.node(fi).a }
        mut self.literal_field(u, u32(fidx), e, mut out)
    }
    if !positional {
        for i: u32 in 0..ut.nfields {
            dv: u32 = self.lit_default(x, u, i)
            if dv != 0 { mut self.literal_field(u, i, dv, mut out) }
        }
    }
    if self.failed() {
        out.n = 0
        return
    }
    for k: int in 0..out.n { // sema supplies every field, defaults included
        if out.v[k] < 0 { out.v[k] = mut self.konst(lv.v[k].ty, 0) }
    }
}

/* Field `fi` of struct or tuple `u` from `e`, into its leaves of `out`. */
Lw.literal_field(mut self, u: u32, fi: u32, e: u32, mut out: Agg) {
    f: Agg = blank(Agg)
    mut self.value(e, self.s.field(self.ty(u), fi).ty, mut f)
    at: int = mut self.leaf_index(u, fi)
    if self.failed() { return }
    for k: int in 0..f.n { out.v[at + k] = f.v[k] }
}

/* The leaves of array literal `x` of type `t`, element by element; [v : n]
 * evaluates v once.
 */
Lw.literal_array(mut self, x: u32, t: u32, mut out: Agg) {
    u: u32 = self.unwrap(t)
    out.n = 0
    if u == 0 || self.ty(u).kind != TypeKind.array {
        mut self.unsupported(self.type_why(t))
        return
    }
    ut: SType = self.ty(u)
    nb: int = mut self.leaf_count(ut.base)
    cnt: int = mut self.leaf_count(t)
    if self.failed() { return }
    out.n = cnt
    n: Node = self.node(x)
    if n.a != 0 {
        e: Agg = blank(Agg)
        if ut.count != 0 { mut self.value(n.a, ut.base, mut e) }
        if self.failed() { return }
        for i: int in 0..int(ut.count) {
            for k: int in 0..nb { out.v[i * nb + k] = e.v[k] }
        }
        return
    }
    if u64(n.nkids) != ut.count {
        mut self.unsupported("array literal")
        return
    }
    for i: u32 in 0..n.nkids { // written order; a keyed entry at its member's slot
        k: u32 = self.kid(x, i)
        e: Agg = blank(Agg)
        mut self.value(self.lit_elem(k), ut.base, mut e)
        if self.failed() { return }
        s: int = int(self.lit_slot(k, i))
        for j: int in 0..nb { out.v[s * nb + j] = e.v[j] }
    }
}

// --- sequences --------------------------------------------------------------

/* A static array literal's link symbol is numbered program-wide, as C's
 * literal_name numbers it.
 */
lit_next: u32 = 0

/* A fresh name for a constant array literal's data, __ace$lit$N, in `names`
 * (shared by lowering and the data a global's initializer nests).
 */
pub literal_name(mut names: path.Pool): string {
    buf: [32]u8
    b: Out = Out.init(mut buf[0..32])
    _ = mut b.printf("__ace$lit$%u", uint(lit_next))
    lit_next += 1
    return mut names.copy(b.text())
}

/* A variable of lowering's own, first holding `v`. */
Lw.temp_var(mut self, t: u8, v: int): int {
    var: int = mut self.var_new(0, t, -1)
    mut self.write_var(var, self.cur, v)
    return var
}

Lw.cmp(mut self, op: u8, a: int, b: int): int {
    return mut self.emit2(op, ir.IT_BOOL, a, b)
}

/* The literal a module-level string constant names, or 0. */
Lw.const_string(self, x: u32): u32 {
    if self.node(x).kind != Kind.ident { return 0 }
    s: u32 = self.nsym(x)
    if s == 0 { return 0 }
    sy: sema.Sym = self.s.sym(s)
    if sy.kind != sema.SymKind.var || !sy.is_global || !sy.is_const { return 0 }
    init: u32 = self.s.sym_init(s)
    if init == 0 || self.node(init).kind != Kind.str_lit { return 0 }
    return init
}

/* The string literal `x`, or a constant naming one, or 0. */
Lw.string_of(self, x: u32): u32 {
    if self.node(x).kind == Kind.str_lit { return x }
    return self.const_string(x)
}

/* The leaves of a string of bytes `text`: their address and length. */
Lw.string_bytes(mut self, text: string, mut out: Agg) {
    p: int = mut self.emit(ir.IR_STR, ir.IT_PTR)
    x: mut *ir.IrIns = mut self.fn.at(p)
    x.name = text
    x.imm = u64(text.len)
    out.n = 2
    out.v[0] = p
    out.v[1] = mut self.konst(ir.IT_U64, u64(text.len))
}

/* Leaf `k` of string or slice `x`, a place's read alone: 0 its ptr, 1 its length. */
Lw.view_leaf(mut self, x: u32, k: int): int {
    lit: u32 = self.string_of(x)
    if lit != 0 && k != 0 { return mut self.konst(ir.IT_U64, u64(self.node(lit).text.len)) }
    if lit != 0 {
        v: Agg = blank(Agg)
        mut self.string_bytes(self.node(lit).text, mut v)
        return v.v[0]
    }
    if self.is_place(x) {
        p: Place = mut self.place(x)
        if p.var >= 0 { return mut self.read_var(p.var + k, self.cur) }
        t: u8 = ir.IT_PTR
        if k != 0 { t = ir.IT_U64 }
        return mut self.load(t, p.addr, p.off + i32(8 * k), p.flags)
    }
    v: Agg = blank(Agg)
    mut self.value(x, self.nty(x), mut v)
    if self.failed() { return mut self.dummy() }
    return v.v[k]
}

/* The ptr of string or slice `x`, and its length when `want_len` (else -1):
 * the descriptor read once, a place's through one address.
 */
Lw.view_parts(mut self, x: u32, want_len: bool): (int, int) {
    lit: u32 = self.string_of(x)
    if lit == 0 && self.is_place(x) {
        p: Place = mut self.place(x)
        if p.var >= 0 {
            ptr: int = mut self.read_var(p.var, self.cur)
            if !want_len { return ptr, -1 }
            return ptr, mut self.read_var(p.var + 1, self.cur)
        }
        ptr: int = mut self.load(ir.IT_PTR, p.addr, p.off, p.flags)
        if !want_len { return ptr, -1 }
        return ptr, mut self.load(ir.IT_U64, p.addr, p.off + 8, p.flags)
    }
    v: Agg = blank(Agg)
    if lit != 0 { mut self.string_bytes(self.node(lit).text, mut v) } else { mut self.value(x, self.nty(x), mut v) }
    if self.failed() { return mut self.dummy(), mut self.dummy() }
    if !want_len { return v.v[0], -1 }
    return v.v[0], v.v[1]
}

/* The value an Error or enum field reads, as type `it`: x itself, or what its
 * pointers lead to, each dereference null-checked.
 */
Lw.deref_value(mut self, x: u32, it: u8): int {
    t: u32 = self.unwrap(self.nty(x))
    if t == 0 || self.ty(t).kind != TypeKind.ptr { return mut self.expr(x, int(it)) }
    v: int = mut self.expr(x, int(ir.IT_PTR))
    t = self.unwrap(self.ty(t).base)
    for t != 0 && self.ty(t).kind == TypeKind.ptr {
        v = mut self.load(ir.IT_PTR, v, 0, self.access_check(v))
        t = self.unwrap(self.ty(t).base)
    }
    return mut self.load(it, v, 0, self.access_check(v))
}

/* The element type of string or slice type `st` (unwrapped). */
Lw.view_elem(self, st: u32): u32 {
    if self.ty(st).kind == TypeKind.slice { return self.ty(st).base }
    return self.s.prim(sema.P_U8)
}

/* The leaves of x = s[lo..hi] (Sequences #1-2): s's descriptor, then lo,
 * then hi; debug checks each signed bound nonnegative as it is evaluated,
 * then lo <= hi, then hi <= s.len, skipping what sema proved.
 */
Lw.slice_leaves(mut self, x: u32, mut out: Agg) {
    n: Node = self.node(x)
    st: u32 = self.unwrap(self.nty(n.a))
    pr: u8 = self.s.node_proof(x)
    chk: bool = self.debug && (pr & sema.PROOF_BOUNDS) == 0
    ptr: int = -1
    len: int = -1
    es: u64 = 1
    if st != 0 && self.ty(st).kind == TypeKind.array { // its place's address and its fixed length
        ptr = mut self.place_address(mut self.array_place(n.a))
        len = mut self.konst(ir.IT_U64, self.ty(st).count)
        es = u64(self.size(self.ty(st).base))
    } else {
        if !self.is_view(st) {
            mut self.unsupported(self.type_why(st))
            out.n = 0
            return
        }
        if self.ty(st).kind == TypeKind.slice { es = u64(self.size(self.ty(st).base)) }
        ptr, len = mut self.view_parts(n.a, n.c == 0 || (chk && (pr & sema.PROOF_SOURCE) == 0))
    }
    lo: int = -1
    if n.b != 0 { lo = mut self.bound(n.b, x, chk && (pr & sema.PROOF_LO_NONNEG) == 0) }
    hi: int = len
    if n.c != 0 { hi = mut self.bound(n.c, x, chk && (pr & sema.PROOF_HI_NONNEG) == 0) }
    if chk && (pr & sema.PROOF_ORDER) == 0 && lo >= 0 { mut self.bounds_check(mut self.cmp(ir.IR_LE, lo, hi), x) }
    if chk && (pr & sema.PROOF_SOURCE) == 0 && n.c != 0 { mut self.bounds_check(mut self.cmp(ir.IR_LE, hi, len), x) }
    out.n = 2
    out.v[0] = ptr
    out.v[1] = hi
    if lo < 0 { return }
    out.v[0] = mut self.emit2(ir.IR_PADD, ir.IT_PTR, ptr, lo)
    mut self.fn.at(out.v[0]).imm = es
    out.v[1] = mut self.emit2(ir.IR_SUB, ir.IT_U64, hi, lo)
}

/* Array literal `x` viewed as []T: its [N]T as static data when its elements
 * are constant, else built in a stack object; empty, the null view.
 */
Lw.literal_view(mut self, x: u32, mut out: Agg) {
    at: u32 = self.s.node_view(x)
    out.n = 2
    out.v[1] = mut self.konst(ir.IT_U64, self.ty(at).count)
    if self.ty(at).count == 0 {
        out.v[0] = mut self.konst(ir.IT_PTR, 0)
        return
    }
    if (self.s.node_proof(x) & sema.PROOF_STATIC) != 0 {
        id: int = mut self.emit(ir.IR_GLOBAL, ir.IT_PTR)
        nm: string = literal_name(mut self.fn.names)
        mut self.fn.at(id).name = nm
        fail(mut self.fn.lits.push(ir.IrLiteral { name = nm, lit = x }))
        out.v[0] = id
        return
    }
    slot: int = mut self.new_slot(at)
    mut self.store_value(x, at, slot, 0)
    out.v[0] = slot
}

/* The name or message of an Error (Errors #9), when `x` reads one: the
 * string of the first domain (name) or entry (message) the Error's packed
 * value matches, else the empty string; the program's domains, searched in
 * declaration order.
 */
Lw.error_description(mut self, x: u32, mut out: Agg): bool {
    n: Node = self.node(x)
    bt: u32 = self.unwrap(self.nty(n.a))
    for bt != 0 && self.ty(bt).kind == TypeKind.ptr { bt = self.unwrap(self.ty(bt).base) }
    message: bool = mem.equal(n.text, "message")
    if bt == 0 || self.ty(bt).kind != TypeKind.error || (!message && !mem.equal(n.text, "name")) { return false }
    v: int = mut self.deref_value(n.a, ir.IT_U64)
    pv: int = mut self.temp_var(ir.IT_PTR, mut self.konst(ir.IT_PTR, 0))
    nv: int = mut self.temp_var(ir.IT_U64, mut self.konst(ir.IT_U64, 0))
    done: int = mut self.new_block()
    domain: int = -1
    if !message { domain = mut self.emit2(ir.IR_SHR, ir.IT_U64, v, mut self.konst(ir.IT_U64, 32)) }
    file: u32 = self.s.file
    for i: u32 in 0..self.node(file).nkids {
        d: u32 = self.kid(file, i)
        dn: Node = self.node(d)
        if dn.kind != Kind.error { continue }
        dt: u32 = self.s.domain_type(d)
        id: u32 = 0
        if dt != 0 { id = self.s.identity(dt) }
        if id == 0 { continue }
        nk: u32 = 1
        if message { nk = dn.nkids }
        for j: u32 in 0..nk {
            text: string = ""
            match: int = 0
            if message {
                packed: u64 = (u64(id) << 32) | u64(u32(self.s.field(self.ty(dt), j).value))
                match = mut self.cmp(ir.IR_EQ, v, mut self.konst(ir.IT_U64, packed))
                text = self.node(self.node(self.kid(d, j)).b).text
            } else {
                text = dn.text
                if dn.cname.len > 0 { text = dn.cname }
                match = mut self.cmp(ir.IR_EQ, domain, mut self.konst(ir.IT_U64, u64(id)))
            }
            yes: int = mut self.new_block()
            next: int = mut self.new_block()
            mut self.terminate(ir.IR_BR, match, yes, next)
            mut self.seal(yes)
            mut self.enter(yes)
            sv: Agg = blank(Agg)
            mut self.string_bytes(text, mut sv)
            mut self.write_var(pv, self.cur, sv.v[0])
            mut self.write_var(nv, self.cur, sv.v[1])
            mut self.jump(done)
            mut self.seal(next)
            mut self.enter(next)
        }
    }
    mut self.jump(done)
    mut self.seal(done)
    mut self.enter(done)
    out.n = 2
    out.v[0] = mut self.read_var(pv, self.cur)
    out.v[1] = mut self.read_var(nv, self.cur)
    return true
}

/* The name of an enum value (Type System #14), when `x` reads one: the source
 * spelling of the member whose discriminant it equals; an open enum's
 * non-member is "".
 */
Lw.enum_name(mut self, x: u32, mut out: Agg): bool {
    n: Node = self.node(x)
    bt: u32 = self.unwrap(self.nty(n.a))
    for bt != 0 && self.ty(bt).kind == TypeKind.ptr { bt = self.unwrap(self.ty(bt).base) }
    if bt == 0 || self.ty(bt).kind != TypeKind.enum || self.ty(bt).decl == 0 || !mem.equal(n.text, "name") { return false }
    et: SType = self.ty(bt)
    nm: u32 = et.nfields
    open: u32 = 0
    if (self.node(et.decl).flags & parser.F_OPEN) != 0 { open = 1 }
    if nm == 0 && open == 0 { return false }
    it: u8 = mut self.need_type(bt)
    v: int = mut self.deref_value(n.a, it)
    pv: int = mut self.temp_var(ir.IT_PTR, mut self.konst(ir.IT_PTR, 0))
    nv: int = mut self.temp_var(ir.IT_U64, mut self.konst(ir.IT_U64, 0))
    done: int = mut self.new_block()
    for j: u32 in 0..nm + open {
        text: string = ""
        if j < nm { text = self.s.field(et, j).name }
        next: int = -1
        if j + 1 < nm + open {
            yes: int = mut self.new_block()
            next = mut self.new_block()
            mut self.terminate(ir.IR_BR, mut self.cmp(ir.IR_EQ, v, mut self.konst(it, u64(self.s.field(et, j).value))), yes, next)
            mut self.seal(yes)
            mut self.enter(yes)
        }
        s: Agg = blank(Agg)
        mut self.string_bytes(text, mut s)
        mut self.write_var(pv, self.cur, s.v[0])
        mut self.write_var(nv, self.cur, s.v[1])
        mut self.jump(done)
        if next >= 0 {
            mut self.seal(next)
            mut self.enter(next)
        }
    }
    mut self.seal(done)
    mut self.enter(done)
    out.n = 2
    out.v[0] = mut self.read_var(pv, self.cur)
    out.v[1] = mut self.read_var(nv, self.cur)
    return true
}

/* Type `t`'s link-symbol spelling, as emit.c's mangle_type writes it. */
pub mangle_type(s: sema.Sema, mut b: Out, t: u32) {
    if t == 0 {
        _ = mut b.printf("?")
        return
    }
    x: SType = s.ty(t)
    switch x.kind {
        TypeKind.prim {
            _ = mut b.printf("%s", PRIM_NAMES[x.prim])
        }
        TypeKind.ptr {
            _ = mut b.printf("p")
            mangle_type(s, mut b, x.base)
        }
        TypeKind.slice {
            _ = mut b.printf("s")
            mangle_type(s, mut b, x.base)
        }
        TypeKind.array {
            _ = mut b.printf("a%u_", x.count)
            if x.key != 0 { // [E]T
                _ = mut b.printf("k")
                mangle_type(s, mut b, x.key)
            }
            mangle_type(s, mut b, x.base)
        }
        TypeKind.error { _ = mut b.printf("Error") }
        TypeKind.struct, TypeKind.enum, TypeKind.bits, TypeKind.contract, TypeKind.union {
            tag: string = "I"
            if x.kind == TypeKind.struct { tag = "S" } else if x.kind == TypeKind.enum { tag = "E" } else if x.kind == TypeKind.bits { tag = "B" } else if x.kind == TypeKind.union { tag = "U" }
            _ = mut b.printf("%s%u_%s", tag, uint(x.name.len), x.name)
            if x.nargs > 0 {
                _ = mut b.printf("g")
                for i: u32 in 0..x.nargs {
                    _ = mut b.printf("$")
                    mangle_type(s, mut b, s.type_arg(x, i))
                }
            }
        }
        TypeKind.distinct { _ = mut b.printf("D%u_%s", uint(x.name.len), x.name) }
        TypeKind.tuple {
            _ = mut b.printf("t")
            for i: u32 in 0..x.nfields { mangle_type(s, mut b, s.field(x, i).ty) }
            _ = mut b.printf("_")
        }
        TypeKind.func {
            _ = mut b.printf("f")
            for i: u32 in 0..x.nparams { mangle_type(s, mut b, s.param(x, i)) }
            _ = mut b.printf("r")
            mangle_type(s, mut b, x.ret)
            _ = mut b.printf("_")
        }
        default { _ = mut b.printf("?") }
    }
}

/* Whether `s` binds a C name: an extern or an export. */
Lw.c_named(self, s: u32): bool {
    sy: sema.Sym = self.s.sym(s)
    return sy.is_extern || (sy.decl != 0 && (self.node(sy.decl).flags & parser.F_EXPO) != 0)
}

/* The link symbol of function or C global `s` under type `ft` (emit.c's
 * link_name): a C name with its leading underscore, else the mangled Ace name.
 */
Lw.link_name(mut self, s: u32, ft: u32): string {
    sy: sema.Sym = self.s.sym(s)
    if !self.c_named(s) { return mut self.fn_mangle(s, ft, 0, 0, false) }
    if sy.decl != 0 && self.node(sy.decl).cname.len > 0 { return mut self.fn.names.join(["_", self.node(sy.decl).cname]) }
    return mut self.fn.names.join(["_", sy.name])
}

/* The internal symbol of Ace function `sym` under type `ft` with the `nt`
 * type arguments of run `targs` (emit.c's fn_mangle, its 511-byte limit
 * kept), in `names`; `spec` tags a specialization's.
 */
pub fn_mangle(s: sema.Sema, mut names: path.Pool, sym: u32, ft: u32, targs: u32, nt: u32, spec: bool): string {
    sy: sema.Sym = s.sym(sym)
    buf: [511]u8
    b: Out = Out.init(mut buf[0..511])
    _ = mut b.printf("__ace$fn$%s$p", sy.name)
    if ft != 0 && s.ty(ft).kind == TypeKind.func {
        f: SType = s.ty(ft)
        for i: u32 in 0..f.nparams {
            if sy.decl != 0 && i < s.node(sy.decl).nkids && (s.node(s.kid(sy.decl, i)).flags & parser.F_MUT) != 0 { _ = mut b.printf("m") } else { _ = mut b.printf("r") }
            mangle_type(s, mut b, s.param(f, i))
            _ = mut b.printf("$")
        }
    }
    if nt > 0 {
        if spec { _ = mut b.printf("s") } else { _ = mut b.printf("g") }
    }
    for i: u32 in 0..nt {
        _ = mut b.printf("$")
        mangle_type(s, mut b, s.run_arg(targs, i))
    }
    return mut names.copy(b.text())
}

Lw.fn_mangle(mut self, s: u32, ft: u32, targs: u32, nt: u32, spec: bool): string {
    return fn_mangle(*self.s, mut self.fn.names, s, ft, targs, nt, spec)
}

/* Generic function `s` as value `x` names it (larger[int]): the written
 * specialization's symbol, or the stamp's whose signature is x's type.
 */
Lw.fn_value_mangle(mut self, s: u32, x: u32): string {
    sy: sema.Sym = self.s.sym(s)
    if sy.spec_args != 0 { return mut self.fn_mangle(s, sy.ty, sy.spec_args, sy.spec_nargs, true) }
    nt: u32 = 0
    if self.node(sy.decl).c != 0 { nt = self.node(self.node(sy.decl).c).nkids }
    args: u32, _ = self.s.inst_args(sy.decl, self.nty(x))
    return mut self.fn_mangle(s, self.nty(x), args, nt, false)
}

/* The internal symbol direct call `call` to Ace function `s` targets: a
 * method of a generic type under its owner's or receiver's type arguments.
 */
Lw.fn_call_mangle(mut self, s: u32, call: u32): string {
    sy: sema.Sym = self.s.sym(s)
    callee: u32 = self.node(call).a
    cft: u32 = self.nty(callee)
    if cft == 0 || self.ty(cft).kind != TypeKind.func { cft = sy.ty }
    targs: u32 = 0
    nt: u32 = 0
    if sy.is_generic && self.assoc_call(call) { // no receiver: the owner expression's type carries them
        if self.node(callee).kind == Kind.selector {
            owner: SType = self.ty(self.nty(self.node(callee).a))
            targs = owner.args
            nt = owner.nargs
        }
    } else if sy.is_generic && cft != 0 && self.ty(cft).nparams > 0 {
        recv: SType = self.ty(self.s.param(self.ty(cft), 0))
        targs = recv.args
        nt = recv.nargs
    } else if sy.spec_args != 0 {
        targs = sy.spec_args
        nt = sy.spec_nargs
    }
    return mut self.fn_mangle(s, cft, targs, nt, sy.spec_args != 0)
}

PRIM_NAMES: [14]string = ["bool", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64", "string", "usize", "typeid"]

/* Whether call `x` builds a contract value: `Shape(&value)` (Carved #5). */
Lw.contract_ctor(self, x: u32): bool {
    n: Node = self.node(x)
    return n.kind == Kind.call && self.nsym(x) == 0 && n.nkids == 1 && n.a != 0 && (self.node(n.a).kind == Kind.ident || (self.node(n.a).kind == Kind.index && self.nsym(n.a) == 0)) && self.is_contract(self.nty(x)) && self.is_pointer(self.kid(x, 0))
}

/* Contract construction `x`: the vtable of the pointee's signing, then the pointer. */
Lw.contract_value(mut self, x: u32, mut out: Agg) {
    conc: u32 = self.ty(self.unwrap(self.nty(self.kid(x, 0)))).base
    buf: [512]u8
    b: Out = Out.init(mut buf[0..512])
    if self.ty(conc).nargs > 0 { fail(mut self.fn.vtables.push(ir.IrVtable { conc = conc, contract = self.nty(x) })) } // a generic signing's pair comes with this function
    _ = mut b.printf("__ace$vt$")
    mangle_type(*self.s, mut b, conc)
    _ = mut b.printf("$")
    mangle_type(*self.s, mut b, self.nty(x))
    if b.dropped() != 0 {
        mut self.unsupported("contract construction")
        out.n = 0
        return
    }
    vt: int = mut self.emit(ir.IR_GLOBAL, ir.IT_PTR)
    mut self.fn.at(vt).name = mut self.fn.names.copy(b.text())
    data: int = mut self.expr(self.kid(x, 0), int(ir.IT_PTR))
    out.n = 2
    out.v[0] = vt
    out.v[1] = data
}

/* Contract dispatch `x`: s.area() through the method's vtable slot, the data
 * pointer as its receiver; -2 when `x` is no such call.
 */
Lw.contract_call(mut self, x: u32, mut res: Agg, want_res: bool, dst: int): int {
    cn: Node = self.node(x)
    callee: u32 = cn.a
    if self.nsym(x) != 0 || callee == 0 || self.node(callee).kind != Kind.selector { return -2 }
    ct: u32 = self.nty(self.node(callee).a)
    if ct == 0 || self.ty(ct).kind != TypeKind.contract { return -2 }
    d: u32 = self.ty(ct).decl
    midx: int = -1
    for i: u32 in 0..self.node(d).nkids {
        if mem.equal(self.node(self.kid(d, i)).text, self.node(callee).text) {
            midx = int(i)
            break
        }
    }
    if midx < 0 {
        mut self.unsupported("contract method")
        return mut self.dummy()
    }
    c: Agg = blank(Agg)
    mut self.value(self.node(callee).a, ct, mut c)
    if self.failed() { return mut self.dummy() }
    f: int = mut self.load(ir.IT_PTR, c.v[0], i32(midx * 8), self.access_check(c.v[0])) // fn slot: vtable checked here
    g: Args = Args.init()
    defer mut g.wipe()
    mut g.scalar(c.v[1]) // the receiver: always by address
    for i: u32 in 0..cn.nkids { mut self.call_arg(mut g, self.kid(x, i), self.nty(self.kid(x, i)), false, false) }
    rt: u32 = self.nty(x)
    id: int = mut self.emit(ir.IR_CALLI, mut self.result_type(rt))
    mut self.fn.at(id).flags = self.null_checked() // fn itself, at the call
    mut self.fn.arg_add(id, f)
    return mut self.call_finish(id, g, rt, mut res, want_res, dst)
}

// --- static maps ------------------------------------------------------------

map_hash_int(x: u64, seed: u64): u64 {
    z: u64 = bits.wradd(bits.wradd(x, seed), u64(0x9e3779b97f4a7c15))
    z = bits.wrmul(z ^ (z >> 30), u64(0xbf58476d1ce4e5b9))
    z = bits.wrmul(z ^ (z >> 27), u64(0x94d049bb133111eb))
    return z ^ (z >> 31)
}

map_hash_string(p: string, seed: u64): u64 {
    h: u64 = 1469598103934665603 ^ seed
    for c: u8 in p {
        h ^= u64(c)
        h = bits.wrmul(h, u64(1099511628211))
    }
    return h
}

/* Static map `ms`'s perfect hash, as emit.c's map_plan finds it: the seed,
 * the slot mask, and in `slots` each slot's entry index plus one (0 when
 * empty), or false when there is none.
 */
pub map_plan(s: sema.Sema, ms: u32, strings: bool, mut slots: array.Array[u32]): (u64, u32, bool) {
    lit: u32 = s.sym_init(ms)
    count: u32 = 0
    if lit != 0 { count = s.node(lit).nkids }
    keys: array.Array[u64] = array.Array[u64] {}
    defer mut keys.wipe()
    texts: array.Array[string] = array.Array[string] {}
    defer mut texts.wipe()
    for i: u32 in 0..count {
        a: u32 = s.node(s.kid(lit, i)).a
        if strings {
            t: u32 = s.static_key_string(a)
            if t == 0 { return 0, 0, false }
            fail(mut texts.push(s.node(t).text))
        } else {
            k: u64, ok: bool = s.static_key_int(a)
            if !ok { return 0, 0, false }
            fail(mut keys.push(k))
        }
    }
    size: u32 = 1
    want: u32 = 1
    if count != 0 { want = count * 2 }
    for size < want { size <<= 1 }
    for {
        mut slots.truncate(0)
        for 0..size { fail(mut slots.push(0)) }
        for seed: u64 in 0..1000000 {
            for j: u32 in 0..size { mut slots.set(usize(j), 0) }
            collision: bool = false
            for i: u32 in 0..count {
                h: u64 = 0
                if strings { h = map_hash_string(texts.get(usize(i)), seed) } else { h = map_hash_int(keys.get(usize(i)), seed) }
                at: u32 = u32(h) & (size - 1)
                if slots.get(usize(at)) != 0 {
                    collision = true
                    break
                }
                mut slots.set(usize(at), i + 1)
            }
            if !collision { return seed, size - 1, true }
        }
        if size >= u32(1) << 30 {
            mut slots.truncate(0)
            return 0, 0, false
        }
        size <<= 1
    }
    return 0, 0, false
}

/* The link symbol of one table (keys, values, or slots) of static map `ms`. */
Lw.map_table(mut self, ms: u32, table: string): int {
    id: int = mut self.emit(ir.IR_GLOBAL, ir.IT_PTR)
    mut self.fn.at(id).sym = ms
    mut self.fn.at(id).name = mut self.fn.names.join(["__ace$map$", self.s.sym(ms).name, "$", table])
    return id
}

/* A call to runtime routine `name` (a, b, n): mem_compare's i64, else none. */
Lw.rtcall(mut self, name: string, a: int, b: int, n: int): int {
    t: u8 = ir.IT_VOID
    if mem.equal(name, "__ace$mem_compare") { t = ir.IT_I64 }
    id: int = mut self.emit(ir.IR_RTCALL, t)
    mut self.fn.at(id).name = name
    mut self.fn.arg_add(id, a)
    mut self.fn.arg_add(id, b)
    mut self.fn.arg_add(id, n)
    return id
}

/* Static map lookup x = table[key] (Carved: compile-time static lookup
 * maps): hash the key as emit.c laid the table out (integers by splitmix64,
 * strings by FNV-1a, both seeded), load the slot, and confirm the key
 * exactly. The entry index is count, the table's zero entry, unless the key
 * is found; the place is that entry's value.
 */
Lw.staticmap_place(mut self, x: u32, mp: u32): Place {
    n: Node = self.node(x)
    m: SType = self.ty(mp)
    ms: u32 = self.nsym(n.a)
    rawkey: u32 = self.unwrap(m.base)
    strings: bool = rawkey != 0 && self.ty(rawkey).kind == TypeKind.prim && self.ty(rawkey).prim == sema.P_STRING
    seed: u64 = 0
    mask: u32 = 0
    ok: bool = false
    if ms != 0 && self.s.sym(ms).kind == sema.SymKind.var && self.s.sym(ms).is_global && self.s.sym_init(ms) != 0 {
        slots: array.Array[u32] = array.Array[u32] {}
        defer mut slots.wipe()
        seed, mask, ok = map_plan(*self.s, ms, strings, mut slots)
    }
    if !ok {
        mut self.unsupported("static map")
        return Place { addr = mut self.dummy(), t = m.ret }
    }
    count: u64 = u64(self.node(self.s.sym_init(ms)).nkids)
    kv: Agg = blank(Agg)
    kt: u8 = ir.IT_U64
    k: int = -1
    h: int = 0
    if strings {
        mut self.value(n.b, m.base, mut kv)
    } else {
        kt = mut self.need_type(m.base)
        if kt == ir.IT_PTR || ir.type_float(kt) {
            mut self.unsupported("static map")
            return Place { addr = mut self.dummy(), t = m.ret }
        }
        k = mut self.expr(n.b, int(kt))
    }
    if self.failed() { return Place { addr = mut self.dummy(), t = m.ret } }
    idx: int = mut self.temp_var(ir.IT_U64, mut self.konst(ir.IT_U64, count))
    if !strings {
        h = k
        if kt != ir.IT_U64 && kt != ir.IT_I64 { h = mut self.emit2(ir.IR_CAST, ir.IT_U64, k, -1) }
        h = mut self.emit2(ir.IR_ADD, ir.IT_U64, h, mut self.konst(ir.IT_U64, seed + 0x9e3779b97f4a7c15))
        h = mut self.emit2(ir.IR_XOR, ir.IT_U64, h, mut self.emit2(ir.IR_SHR, ir.IT_U64, h, mut self.konst(ir.IT_U64, 30)))
        h = mut self.emit2(ir.IR_MUL, ir.IT_U64, h, mut self.konst(ir.IT_U64, u64(0xbf58476d1ce4e5b9)))
        h = mut self.emit2(ir.IR_XOR, ir.IT_U64, h, mut self.emit2(ir.IR_SHR, ir.IT_U64, h, mut self.konst(ir.IT_U64, 27)))
        h = mut self.emit2(ir.IR_MUL, ir.IT_U64, h, mut self.konst(ir.IT_U64, u64(0x94d049bb133111eb)))
        h = mut self.emit2(ir.IR_XOR, ir.IT_U64, h, mut self.emit2(ir.IR_SHR, ir.IT_U64, h, mut self.konst(ir.IT_U64, 31)))
    } else {
        hv: int = mut self.temp_var(ir.IT_U64, mut self.konst(ir.IT_U64, 1469598103934665603 ^ seed))
        iv: int = mut self.temp_var(ir.IT_U64, mut self.konst(ir.IT_U64, 0))
        head: int = mut self.new_block()
        body: int = mut self.new_block()
        exit: int = mut self.new_block()
        mut self.jump(head)
        mut self.enter(head)
        i: int = mut self.read_var(iv, head)
        h = mut self.read_var(hv, head)
        mut self.terminate(ir.IR_BR, mut self.cmp(ir.IR_LT, i, kv.v[1]), body, exit)
        mut self.seal(body)
        mut self.enter(body)
        at: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, kv.v[0], i)
        mut self.fn.at(at).imm = 1
        b: int = mut self.emit2(ir.IR_CAST, ir.IT_U64, mut self.load(ir.IT_U8, at, 0, 0), -1)
        mix: int = mut self.emit2(ir.IR_XOR, ir.IT_U64, h, b)
        mut self.write_var(hv, self.cur, mut self.emit2(ir.IR_MUL, ir.IT_U64, mix, mut self.konst(ir.IT_U64, 1099511628211)))
        mut self.write_var(iv, self.cur, mut self.emit2(ir.IR_ADD, ir.IT_U64, i, mut self.konst(ir.IT_U64, 1)))
        mut self.jump(head)
        mut self.seal(head)
        mut self.seal(exit)
        mut self.enter(exit)
    }
    h = mut self.emit2(ir.IR_AND, ir.IT_U64, h, mut self.konst(ir.IT_U64, u64(mask)))
    sp: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, mut self.map_table(ms, "slots"), h)
    mut self.fn.at(sp).imm = 4
    slot: int = mut self.load(ir.IT_U32, sp, 0, 0)
    found: int = mut self.guard(mut self.cmp(ir.IR_NE, slot, mut self.konst(ir.IT_U32, 0)))
    wide: int = mut self.emit2(ir.IR_CAST, ir.IT_U64, slot, -1)
    ei: int = mut self.emit2(ir.IR_SUB, ir.IT_U64, wide, mut self.konst(ir.IT_U64, 1))
    ksz: u32 = 16
    if !strings { ksz = self.size(m.base) }
    keys: int = mut self.map_table(ms, "keys")
    ep: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, keys, ei)
    mut self.fn.at(ep).imm = u64(ksz)
    if strings {
        lenok: int = mut self.guard(mut self.cmp(ir.IR_EQ, mut self.load(ir.IT_U64, ep, 8, 0), kv.v[1]))
        r: int = mut self.rtcall("__ace$mem_compare", mut self.load(ir.IT_PTR, ep, 0, 0), kv.v[0], kv.v[1])
        same: int = mut self.guard(mut self.cmp(ir.IR_EQ, r, mut self.konst(ir.IT_I64, 0)))
        mut self.write_var(idx, self.cur, ei)
        mut self.guard_end(same)
        mut self.guard_end(lenok)
    } else {
        same: int = mut self.guard(mut self.cmp(ir.IR_EQ, mut self.load(kt, ep, 0, 0), k))
        mut self.write_var(idx, self.cur, ei)
        mut self.guard_end(same)
    }
    mut self.guard_end(found)
    values: int = mut self.map_table(ms, "values")
    vp: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, values, mut self.read_var(idx, self.cur))
    mut self.fn.at(vp).imm = u64(self.size(m.ret))
    return Place { addr = vp, t = m.ret }
}

// --- tagged unions ----------------------------------------------------------

/* The union a construction's or pattern's base names: a type, or a generic
 * union's stamp; else 0.
 */
Lw.union_of_base(self, base: u32): u32 {
    if base == 0 { return 0 }
    b: Node = self.node(base)
    if b.kind == Kind.ident {
        ts: u32 = self.nsym(base)
        if ts != 0 && self.s.sym(ts).kind == sema.SymKind.type && self.is_union(self.s.sym(ts).ty) { return self.unwrap(self.s.sym(ts).ty) }
        return 0
    }
    if b.kind == Kind.index && self.is_union(self.nty(base)) { return self.unwrap(self.nty(base)) }
    return 0
}

/* Whether `x` builds a variant: `Event.quit`, or `Event.key(42)`; the
 * variant and its payload expression (0 for none).
 */
Lw.union_ctor(self, x: u32): (bool, int, u32) {
    n: Node = self.node(x)
    if n.kind == Kind.selector && self.union_of_base(n.a) != 0 { return true, int(self.s.node_ival(x)), 0 }
    if n.kind != Kind.call || self.nsym(x) != 0 || n.a == 0 || self.node(n.a).kind != Kind.selector || self.union_of_base(self.node(n.a).a) == 0 { return false, 0, 0 }
    pay: u32 = 0
    if n.nkids == 1 {
        pay = self.kid(x, 0)
        if self.node(pay).kind == Kind.mutarg { pay = self.node(pay).a }
    }
    return true, int(self.s.node_ival(n.a)), pay
}

/* The byte offset of union `u`'s payload: past the i32 tag, at the largest
 * payload alignment.
 */
Lw.payload_off(self, u: u32): u32 {
    x: SType = self.ty(self.unwrap(u))
    maxa: u32 = 1
    for i: u32 in 0..x.nfields {
        ft: u32 = self.s.field(x, i).ty
        if ft != 0 && maxa < self.ty(self.unwrap(ft)).align { maxa = self.ty(self.unwrap(ft)).align }
    }
    return (4 + maxa - 1) / maxa * maxa
}

/* Variant construction into memory at dst + off: the payload where it lives,
 * then the tag. The inactive bytes are left as they are.
 */
Lw.union_store(mut self, x: u32, t: u32, dst: int, off: i32) {
    ut: SType = self.ty(self.unwrap(t))
    _, vi: int, pay: u32 = self.union_ctor(x)
    if vi < 0 || vi >= int(ut.nfields) || (pay != 0) != (self.s.field(ut, u32(vi)).ty != 0) {
        mut self.unsupported("union variant")
        return
    }
    if pay != 0 { mut self.store_value(pay, self.s.field(ut, u32(vi)).ty, dst, off + i32(self.payload_off(t))) }
    mut self.store(dst, off, mut self.konst(ir.IT_I32, u64(vi)), 0)
}

/* The address of the union `x` names or builds. */
Lw.union_addr(mut self, x: u32, t: u32): int {
    ctor: bool, _, _ = self.union_ctor(x)
    if !ctor && self.is_place(x) {
        p: Place = mut self.place(x)
        if p.var < 0 { return mut self.place_address(p) }
    }
    mut self.covered(t)
    slot: int = mut self.new_slot(t)
    mut self.store_value(x, t, slot, 0)
    return slot
}

/* Whether the bytes of payload type `pt` at a + off and b + off are equal: a
 * nested union by its own rule, a float by value, the rest word by word.
 */
Lw.payload_equal(mut self, pt: u32, a: int, b: int, off: i32): int {
    u: u32 = self.unwrap(pt)
    x: SType = self.ty(u)
    if x.kind == TypeKind.union {
        ua: int = mut self.offset_addr(a, off)
        return mut self.union_equal_at(u, ua, mut self.offset_addr(b, off))
    }
    if x.kind == TypeKind.prim && (x.prim == sema.P_F32 || x.prim == sema.P_F64) {
        ft: u8 = ir.IT_F64
        if x.prim == sema.P_F32 { ft = ir.IT_F32 }
        fa: int = mut self.load(ft, a, off, 0)
        return mut self.cmp(ir.IR_EQ, fa, mut self.load(ft, b, off, 0))
    }
    size: u32 = self.size(pt)
    acc: int = mut self.konst(ir.IT_BOOL, 1)
    at: u32 = 0
    for at < size {
        rem: u32 = size - at
        w: u32 = 1
        if rem >= 8 { w = 8 } else if rem >= 4 { w = 4 } else if rem >= 2 { w = 2 }
        wt: u8 = word_type(w)
        wa: int = mut self.load(wt, a, off + i32(at), 0)
        c: int = mut self.cmp(ir.IR_EQ, wa, mut self.load(wt, b, off + i32(at), 0))
        acc = mut self.emit2(ir.IR_AND, ir.IT_BOOL, acc, c)
        at += w
    }
    return acc
}

/* Whether the unions at a and b are equal: the tags, and when they match the
 * active payload (inactive bytes and padding are never compared).
 */
Lw.union_equal_at(mut self, ut: u32, a: int, b: int): int {
    res: int = mut self.temp_var(ir.IT_BOOL, mut self.konst(ir.IT_BOOL, 0))
    join: int = mut self.new_block()
    same: int = mut self.new_block()
    ta: int = mut self.load(ir.IT_I32, a, 0, 0)
    tb: int = mut self.load(ir.IT_I32, b, 0, 0)
    mut self.terminate(ir.IR_BR, mut self.cmp(ir.IR_EQ, ta, tb), same, join)
    mut self.seal(same)
    mut self.enter(same)
    poff: i32 = i32(self.payload_off(ut))
    x: SType = self.ty(ut)
    for k: u32 in 0..x.nfields {
        ft: u32 = self.s.field(x, k).ty
        if ft == 0 { continue }
        yes: int = mut self.new_block()
        next: int = mut self.new_block()
        mut self.terminate(ir.IR_BR, mut self.cmp(ir.IR_EQ, ta, mut self.konst(ir.IT_I32, u64(k))), yes, next)
        mut self.seal(yes)
        mut self.enter(yes)
        mut self.write_var(res, self.cur, mut self.payload_equal(ft, a, b, poff))
        mut self.jump(join)
        mut self.seal(next)
        mut self.enter(next)
    }
    mut self.write_var(res, self.cur, mut self.konst(ir.IT_BOOL, 1)) // a payloadless variant
    mut self.jump(join)
    mut self.seal(join)
    mut self.enter(join)
    return mut self.read_var(res, join)
}

/* x.a == x.b or x.a != x.b on unions. */
Lw.union_equal(mut self, x: u32, negate: bool): int {
    n: Node = self.node(x)
    t: u32 = self.nty(n.a)
    if !self.is_union(t) { t = self.nty(n.b) }
    a: int = mut self.union_addr(n.a, t)
    b: int = mut self.union_addr(n.b, t)
    r: int = mut self.union_equal_at(self.unwrap(t), a, b)
    if negate { return mut self.emit2(ir.IR_NOT, ir.IT_BOOL, r, -1) }
    return r
}

// --- expressions ------------------------------------------------------------

/* The IR type of `x`, taking an untyped constant's type from its context. */
Lw.type_in(mut self, x: u32, want: int): u8 {
    t: u32 = self.nty(x)
    if self.is_untyped(t) {
        if want < 0 {
            mut self.unsupported("untyped constant")
            return ir.IT_I64
        }
        return u8(want)
    }
    return mut self.need_type(t)
}

binop_of(op: Token): int {
    switch op {
        Token.plus, Token.add_eq { return int(ir.IR_ADD) }
        Token.minus, Token.sub_eq { return int(ir.IR_SUB) }
        Token.star, Token.mul_eq { return int(ir.IR_MUL) }
        Token.slash, Token.div_eq { return int(ir.IR_DIV) }
        Token.percent, Token.mod_eq { return int(ir.IR_REM) }
        Token.amp, Token.and_eq { return int(ir.IR_AND) }
        Token.pipe, Token.or_eq { return int(ir.IR_OR) }
        Token.caret, Token.xor_eq { return int(ir.IR_XOR) }
        Token.shl, Token.shl_eq { return int(ir.IR_SHL) }
        Token.shr, Token.shr_eq { return int(ir.IR_SHR) }
        Token.eq_eq { return int(ir.IR_EQ) }
        Token.bang_eq { return int(ir.IR_NE) }
        Token.lt { return int(ir.IR_LT) }
        Token.le { return int(ir.IR_LE) }
        Token.gt { return int(ir.IR_GT) }
        Token.ge { return int(ir.IR_GE) }
        default { return -1 }
    }
}

is_compare(op: int): bool {
    return op >= int(ir.IR_EQ) && op <= int(ir.IR_GE)
}

/* Arithmetic that a debug build checks (Safety & Debug Builds #6). */
Lw.checked_op(self, op: u8, t: u8): bool {
    if !self.debug || t == ir.IT_BOOL || ir.type_float(t) { return false }
    return op == ir.IR_ADD || op == ir.IR_SUB || op == ir.IR_MUL || op == ir.IR_DIV || op == ir.IR_REM || op == ir.IR_SHL || op == ir.IR_SHR || op == ir.IR_NEG
}

Lw.arith(mut self, op: u8, t: u8, a: int, b: int): int {
    if ir.type_float(t) && op != ir.IR_ADD && op != ir.IR_SUB && op != ir.IR_MUL && op != ir.IR_DIV && op != ir.IR_NEG {
        mut self.unsupported("float operator")
        return mut self.dummy()
    }
    id: int = mut self.emit2(op, t, a, b)
    if self.checked_op(op, t) { mut self.fn.at(id).flags |= ir.IRF_CHECKED }
    return id
}

/* Operands of a binary node: an untyped side takes the other side's type. */
Lw.operand_type(mut self, x: u32, want: int): u8 {
    n: Node = self.node(x)
    if !self.is_untyped(self.nty(n.a)) { return mut self.need_type(self.nty(n.a)) }
    if !self.is_untyped(self.nty(n.b)) { return mut self.need_type(self.nty(n.b)) }
    if want < 0 {
        mut self.unsupported("untyped constant")
        return ir.IT_I64
    }
    return u8(want)
}

/* a && b or a || b as a value: branch on a, then b's own value where it
 * decides, joined with the constant a decided.
 */
Lw.bool_value(mut self, x: u32): int {
    n: Node = self.node(x)
    and: bool = n.op == Token.and_and
    rhs: int = mut self.new_block()
    done: int = mut self.new_block()
    join: int = mut self.new_block()
    if and { mut self.cond(n.a, rhs, done) } else { mut self.cond(n.a, done, rhs) }
    mut self.seal(rhs)
    mut self.seal(done)
    mut self.enter(rhs)
    b: int = -1
    if self.cur >= 0 { b = mut self.expr(n.b, int(ir.IT_BOOL)) }
    from_b: int = self.cur
    mut self.jump(join)
    mut self.enter(done)
    k: int = -1
    if self.cur >= 0 {
        kv: u64 = 1
        if and { kv = 0 }
        k = mut self.konst(ir.IT_BOOL, kv)
    }
    mut self.jump(join)
    mut self.seal(join)
    mut self.enter(join)
    if self.cur < 0 { return mut self.dummy() }
    preds: []int = self.fn.block(join).preds.view()
    if preds.len == 1 {
        if preds[0] == from_b { return b }
        return k
    }
    phi: int = mut self.fn.new_phi(join, ir.IT_BOOL)
    for i: usize in 0..self.fn.block(join).preds.len {
        if self.fn.block(join).preds.get(i) == from_b { mut self.fn.arg_add(phi, b) } else { mut self.fn.arg_add(phi, k) }
    }
    return phi
}

/* Branches on conditional `x`'s condition into `then` and `els`, both
 * sealed, and returns them with the join block both branches jump to.
 */
Lw.cond_split(mut self, x: u32): (int, int, int) {
    then: int = mut self.new_block()
    els: int = mut self.new_block()
    join: int = mut self.new_block()
    mut self.cond(self.node(x).a, then, els)
    mut self.seal(then)
    mut self.seal(els)
    return then, els, join
}

/* Joins leaf `a` of the branch from block `fa` with leaf `b` of the other. */
Lw.cond_join(mut self, join: int, fa: int, a: int, b: int): int {
    preds: []int = self.fn.block(join).preds.view()
    if preds.len == 1 {
        if preds[0] == fa { return a }
        return b
    }
    phi: int = mut self.fn.new_phi(join, self.fn.at(a).ty)
    for i: usize in 0..self.fn.block(join).preds.len {
        if self.fn.block(join).preds.get(i) == fa { mut self.fn.arg_add(phi, a) } else { mut self.fn.arg_add(phi, b) }
    }
    return phi
}

/* Conditional `x`'s value: only the selected branch is evaluated. Scalar
 * when `agg` is false (the result is returned), else its leaves at type `t`.
 */
Lw.cond_value(mut self, x: u32, want: int, t: u32, agg: bool, mut out: Agg): int {
    n: Node = self.node(x)
    then: int, els: int, join: int = mut self.cond_split(x)
    a: Agg = blank(Agg)
    a.n = 1
    a.v[0] = -1
    b: Agg = blank(Agg)
    b.n = 1
    b.v[0] = -1
    mut self.enter(then)
    if self.cur >= 0 {
        if agg { mut self.value(n.b, t, mut a) } else { a.v[0] = mut self.expr(n.b, want) }
    }
    fa: int = self.cur
    mut self.jump(join)
    mut self.enter(els)
    if self.cur >= 0 {
        if agg { mut self.value(n.c, t, mut b) } else { b.v[0] = mut self.expr(n.c, want) }
    }
    mut self.jump(join)
    mut self.seal(join)
    mut self.enter(join)
    if self.cur < 0 { return -1 }
    if !agg { return mut self.cond_join(join, fa, a.v[0], b.v[0]) }
    if fa >= 0 { out.n = a.n } else { out.n = b.n } // the reached branch's leaf count
    for i: int in 0..out.n { out.v[i] = mut self.cond_join(join, fa, a.v[i], b.v[i]) }
    return 0
}

/* Whether `x` names storage: a variable, a dereference, or a field of one. */
Lw.is_place(self, x: u32): bool {
    if self.captured.has(x) { return true }
    n: Node = self.node(x)
    switch n.kind {
        Kind.ident, Kind.index { return true }
        Kind.unary { return n.op == Token.star }
        Kind.selector {
            bt: u32 = self.unwrap(self.nty(n.a))
            vt: u32 = bt
            for vt != 0 && self.ty(vt).kind == TypeKind.ptr { vt = self.unwrap(self.ty(vt).base) }
            if vt != 0 && (self.ty(vt).kind == TypeKind.error || self.ty(vt).kind == TypeKind.enum) { return false }
            return (bt != 0 && self.ty(bt).kind == TypeKind.ptr) || self.is_place(n.a)
        }
        default { return false }
    }
}

/* Whether `x` is a place rooted in a variable or a pointer, not in a name
 * that is no storage (a type's union variant, a constant).
 */
Lw.is_var_place(self, x: u32): bool {
    if !self.is_place(x) { return false }
    y: u32 = x
    for {
        if self.captured.has(y) { return true }
        n: Node = self.node(y)
        if n.kind == Kind.ident {
            s: u32 = self.nsym(y)
            return s != 0 && self.s.sym(s).kind == sema.SymKind.var
        }
        if n.kind == Kind.unary { return true }
        bt: u32 = self.unwrap(self.nty(n.a))
        if bt != 0 && (self.ty(bt).kind == TypeKind.ptr || self.ty(bt).kind == TypeKind.slice) { return true }
        y = n.a
    }
    return false
}

Lw.result_type(mut self, rt: u32): u8 {
    if rt == 0 || self.kind(rt) == TypeKind.void || self.is_agg(rt) { return ir.IT_VOID }
    return mut self.need_type(rt)
}

/* A call to routine `name` with scalar arguments: a C function when `c`,
 * else one of the object's own runtime routines.
 */
Lw.call_routine(mut self, name: string, c: bool, t: u8, args: []int): int {
    id: int = mut self.emit(ir.IR_CALL, t)
    x: mut *ir.IrIns = mut self.fn.at(id)
    x.name = name
    x.routine = c
    for a: int in args { mut self.fn.arg_add(id, a) }
    return id
}

/* A call argument: the address of its place for a mut parameter or method
 * receiver, else its leaves at the parameter's type. A big one is passed by
 * address: of its own place when `ace` is set (an Ace callee, Values &
 * Passing #2), else of a copy, as C's ABI requires.
 */
Lw.call_arg(mut self, mut g: Args, at: u32, pt: u32, by_address: bool, ace: bool) {
    a: u32 = at
    if self.node(a).kind == Kind.mutarg { a = self.node(a).a }
    if by_address && !self.is_place(a) {
        mut g.scalar(mut self.place_address(mut self.temp_place(a)))
        return
    }
    if by_address {
        mut g.scalar(mut self.place_address(mut self.place(a)))
        return
    }
    if !self.is_agg(pt) {
        mut g.scalar(mut self.expr(a, int(mut self.need_type(pt))))
        return
    }
    if self.is_big(pt) {
        slot: int = 0
        if ace && self.is_var_place(a) && self.unwrap(self.nty(a)) == self.unwrap(pt) {
            slot = mut self.place_address(mut self.place(a))
        } else { // the address of a copy
            mut self.covered(pt)
            slot = mut self.new_slot(pt)
            mut self.store_value(a, pt, slot, 0)
        }
        fail(mut g.parts.push(ir.IrPart { agg = pt, first = int(g.v.len), n = 1, addr = true }))
        fail(mut g.v.push(slot))
        g.agg = true
        return
    }
    v: Agg = blank(Agg)
    mut self.value(a, pt, mut v)
    fail(mut g.parts.push(ir.IrPart { agg = pt, first = int(g.v.len), n = v.n }))
    for k: int in 0..v.n { fail(mut g.v.push(v.v[k])) }
    g.agg = true
}

/* Arguments of a direct call to `s`: an instance method's receiver first.
 * Returns the leaf index of the first variadic argument, or -1.
 */
Lw.call_args(mut self, call: u32, s: u32, mut g: Args): int {
    cn: Node = self.node(call)
    callee: u32 = cn.a
    sy: sema.Sym = self.s.sym(s)
    d: u32 = sy.decl
    ft: u32 = self.nty(callee)
    if ft == 0 || self.ty(ft).kind != TypeKind.func { ft = sy.ty }
    recv: u32 = 0
    if self.node(callee).kind == Kind.selector && !sy.is_extern && !self.assoc_call(call) { recv = 1 }
    n: u32 = recv + cn.nkids
    named: u32 = n
    if ft != 0 { named = self.ty(ft).nparams }
    varargs: bool = sy.is_extern && d != 0 && (self.node(d).flags & parser.F_VARARGS) != 0
    if (varargs && n < named) || (!varargs && n != named) {
        mut self.unsupported("default argument")
        return -1
    }
    aliasing: bool = false
    if self.debug && d != 0 {
        dn: Node = self.node(d)
        for i: u32 in 0..dn.nkids {
            if i >= n { break }
            if (self.node(self.kid(d, i)).flags & parser.F_NOALIAS) != 0 { aliasing = true }
        }
    }
    rng: array.Array[Range] = array.Array[Range] {}
    defer mut rng.wipe()
    first_var: int = -1
    for i: u32 in 0..n {
        fail(mut rng.push(Range {}))
        a: u32 = 0
        if recv == 1 && i == 0 { a = self.node(callee).a } else { a = self.kid(call, i - recv) }
        if i >= named { // variadic: promoted to 64 bits (an f32 to f64)
            at: u32 = self.nty(a)
            if self.is_agg(at) {
                mut self.unsupported("variadic aggregate")
                continue
            }
            t: u8 = ir.IT_I64
            if self.is_untyped(at) {
                if self.node(a).kind == Kind.float_lit { t = ir.IT_F64 }
            } else {
                t = mut self.need_type(at)
            }
            v: int = mut self.expr(a, int(t))
            if t == ir.IT_F32 {
                v = mut self.emit2(ir.IR_CAST, ir.IT_F64, v, -1)
            } else if t != ir.IT_PTR && ir.type_bits(t) < 64 {
                wide: u8 = ir.IT_U64
                if ir.type_signed(t) { wide = ir.IT_I64 }
                v = mut self.emit2(ir.IR_CAST, wide, v, -1)
            }
            if first_var < 0 { first_var = int(g.v.len) }
            mut g.scalar(v)
            continue
        }
        by_address: bool = false
        if d != 0 {
            dn: Node = self.node(d)
            by_address = (i < dn.nkids && (self.node(self.kid(d, i)).flags & parser.F_MUT) != 0) || ((dn.flags & parser.F_METHOD) != 0 && i == 0)
        }
        pt: u32 = self.s.param(self.ty(ft), i)
        ef: int = -1
        if recv == 1 && i == 0 { ef = self.promoting_field(a, pt) }
        if ef >= 0 { // a method promoted from embedded field ef: its receiver is that field (C's sema rewrites it so)
            rp: Place = blank(Place)
            if self.is_pointer(a) {
                rp, _ = mut self.field_base(callee)
            } else if self.is_place(a) {
                rp = mut self.place(a)
            } else {
                rp = mut self.temp_place(a)
            }
            bt: u32 = self.unwrap(rp.t)
            if self.is_pointer(a) { bt = self.recv_struct(a) }
            f: sema.SField = self.s.field(self.ty(bt), u32(ef))
            rp.off += i32(f.offset)
            rp.t = f.ty
            mut g.scalar(mut self.place_address(rp))
            continue
        }
        if recv == 1 && i == 0 && by_address && self.is_pointer(a) { // p.m() is (*p).m(), once per pointer level
            rp: Place, _ = mut self.field_base(callee)
            mut g.scalar(mut self.place_address(rp))
            continue
        }
        mut self.call_arg(mut g, a, pt, by_address, !sy.is_extern)
        pu: u32 = self.unwrap(pt)
        if !aliasing || pu == 0 || self.ty(pu).kind != TypeKind.slice { continue }
        pp: ir.IrPart = g.parts.get(g.parts.len - 1)
        esz: u64 = u64(self.size(self.ty(pu).base))
        if by_address { // a descriptor in memory: read it at the address just passed
            addr: int = g.v.get(usize(pp.first))
            ptr: int = mut self.load(ir.IT_PTR, addr, 0, 0)
            len: int = mut self.load(ir.IT_U64, addr, 8, 0)
            mut rng.set(usize(i), Range { ptr = ptr, len = len, esz = esz })
            continue
        }
        mut rng.set(usize(i), Range { ptr = g.v.get(usize(pp.first)), len = g.v.get(usize(pp.first + 1)), esz = esz })
    }
    if aliasing { mut self.noalias_check(d, rng.view()) }
    return first_var
}

/* The struct receiver `a` names, through every pointer level. */
Lw.recv_struct(self, a: u32): u32 {
    t: u32 = self.unwrap(self.nty(a))
    for t != 0 && self.ty(t).kind == TypeKind.ptr { t = self.unwrap(self.ty(t).base) }
    return t
}

/* The embedded field of receiver `a`'s struct that a method on `pt` is
 * promoted from, or -1 when the method is the struct's own.
 */
Lw.promoting_field(self, a: u32, pt: u32): int {
    bt: u32 = self.recv_struct(a)
    if bt == 0 || self.ty(bt).kind != TypeKind.struct || self.s.same_type(bt, self.unwrap(pt)) || self.ty(bt).decl == 0 { return -1 }
    x: SType = self.ty(bt)
    for i: u32 in 0..x.nfields {
        if (self.node(self.kid(x.decl, i)).flags & parser.F_EMBED) == 0 { continue }
        if self.s.same_type(self.unwrap(self.s.field(x, i).ty), self.unwrap(pt)) { return int(i) }
    }
    return -1
}

/* Emits call `id`'s arguments, and its signature when a part or the result
 * `rt` is an aggregate; an aggregate result's leaves follow as projections.
 * One of over MAX_LEAVES leaves goes to memory at `dst` (a new stack object when
 * dst < 0), passed last.
 */
Lw.call_finish(mut self, id: int, g: Args, rt: u32, mut res: Agg, want_res: bool, dst: int): int {
    for v: int in g.v.view() { mut self.fn.arg_add(id, v) }
    if self.is_big(rt) {
        mut self.covered(rt)
        d: int = dst
        if d < 0 { d = mut self.new_slot(rt) }
        mut self.fn.arg_add(id, d)
        mut self.fn.at(id).flags |= ir.IRF_SRET
    }
    if !g.agg && !self.is_agg(rt) { return id }
    ret: ir.IrPart = blank(ir.IrPart)
    if self.is_big(rt) {
        mut self.fn.at(id).sig = mut self.fn.new_sig(g.parts.view(), ret)
        return id
    }
    if !self.is_agg(rt) {
        if rt != 0 && self.kind(rt) != TypeKind.void { ret.n = 1 }
        mut self.fn.at(id).sig = mut self.fn.new_sig(g.parts.view(), ret)
        return id
    }
    lv: ir.Leaves = blank(ir.Leaves)
    n: int = mut self.leaves(rt, mut lv)
    ret = ir.IrPart { agg = rt, n = n }
    mut self.fn.at(id).sig = mut self.fn.new_sig(g.parts.view(), ret)
    if want_res {
        res.n = n
        for k: int in 0..n {
            res.v[k] = mut self.emit2(ir.IR_PROJ, lv.v[k].ty, id, -1)
            mut self.fn.at(res.v[k]).imm = u64(k)
        }
    }
    return id
}

// --- compiler-backed calls ------------------------------------------------------

/* Debug: traps through the call contract failure unless `c` holds. */
Lw.contract_check(mut self, c: int) {
    id: int = mut self.emit2(ir.IR_CHECK, ir.IT_VOID, c, -1)
    mut self.fn.at(id).at = self.at
}

/* A slice argument's descriptor and element size; ptr < 0 for another. */
Range: struct {
    ptr: int = -1,
    len: int = -1,
    esz: u64 = 0,
}

/* Debug, at a call boundary (Safety #7) to declaration `d`: the byte range
 * of each slice argument must be representable, and two whose parameters
 * include a noalias one must be disjoint unless one is empty.
 */
Lw.noalias_check(mut self, d: u32, r: []Range) {
    nk: usize = usize(self.node(d).nkids)
    end: array.Array[int] = array.Array[int] {}
    defer mut end.wipe()
    for i: usize in 0..r.len {
        fail(mut end.push(-1))
        if i >= nk || r[i].ptr < 0 { continue }
        bytes: int = r[i].len
        if r[i].esz != 1 {
            mut self.contract_check(mut self.cmp(ir.IR_LE, bytes, mut self.konst(ir.IT_U64, ~u64(0) / r[i].esz)))
            bytes = mut self.emit2(ir.IR_MUL, ir.IT_U64, bytes, mut self.konst(ir.IT_U64, r[i].esz))
        }
        e: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, r[i].ptr, bytes)
        mut self.fn.at(e).imm = 1
        mut end.set(i, e)
        mut self.contract_check(mut self.cmp(ir.IR_GE, e, r[i].ptr))
    }
    for i: usize in 0..r.len {
        if i >= nk || r[i].ptr < 0 { continue }
        for j: usize = i + 1; j < r.len && j < nk; j += 1 {
            if r[j].ptr < 0 || ((self.node(self.kid(d, u32(i))).flags | self.node(self.kid(d, u32(j))).flags) & parser.F_NOALIAS) == 0 { continue }
            ki: int = mut self.konst(ir.IT_U64, 0)
            ni: int = mut self.cmp(ir.IR_NE, r[i].len, ki)
            kj: int = mut self.konst(ir.IT_U64, 0)
            nj: int = mut self.cmp(ir.IR_NE, r[j].len, kj)
            some: int = mut self.guard(mut self.emit2(ir.IR_AND, ir.IT_BOOL, ni, nj))
            after: int = mut self.cmp(ir.IR_GE, r[j].ptr, end.get(i))
            before: int = mut self.cmp(ir.IR_GE, r[i].ptr, end.get(j))
            mut self.contract_check(mut self.emit2(ir.IR_OR, ir.IT_BOOL, after, before))
            mut self.guard_end(some)
        }
    }
}

/* Debug allocator tracking (Safety & Debug Builds #9): the registry routines. */
Lw.registry_add(mut self, ptr: int, size: int, align: int) {
    if !self.debug { return }
    a: [3]int = [ptr, size, align]
    _ = mut self.call_routine("__ace$registry_add", false, ir.IT_VOID, a[..])
}

/* The record of a live allocation. */
Lw.registry_find(mut self, ptr: int, size: int): int {
    a: [2]int = [ptr, size]
    return mut self.call_routine("__ace$registry_find", false, ir.IT_PTR, a[..])
}

/* A slice result's leaves from variables `pv` and `nv`, into res when wanted. */
Lw.slice_out(mut self, mut res: Agg, want_res: bool, pv: int, nv: int): int {
    if want_res {
        res.n = 2
        res.v[0] = mut self.read_var(pv, self.cur)
        res.v[1] = mut self.read_var(nv, self.cur)
    }
    return -1
}

/* mem.alloc(size, align): the null slice unless size > 0 and align is a
 * power of two up to 16 and the allocator succeeds.
 */
Lw.mem_alloc(mut self, x: u32, mut res: Agg, want_res: bool): int {
    size: int = mut self.expr(self.kid(x, 0), int(ir.IT_I64))
    align: int = mut self.expr(self.kid(x, 1), int(ir.IT_I64))
    pv: int = mut self.temp_var(ir.IT_PTR, mut self.konst(ir.IT_PTR, 0))
    nv: int = mut self.temp_var(ir.IT_U64, mut self.konst(ir.IT_U64, 0))
    low: int = mut self.emit2(ir.IR_AND, ir.IT_I64, align, mut self.emit2(ir.IR_SUB, ir.IT_I64, align, mut self.konst(ir.IT_I64, 1)))
    pow2: int = mut self.cmp(ir.IR_EQ, low, mut self.konst(ir.IT_I64, 0))
    sized: int = mut self.cmp(ir.IR_GT, size, mut self.konst(ir.IT_I64, 0))
    aligned: int = mut self.cmp(ir.IR_GT, align, mut self.konst(ir.IT_I64, 0))
    small: int = mut self.cmp(ir.IR_LE, align, mut self.konst(ir.IT_I64, 16))
    ok: int = mut self.emit2(ir.IR_AND, ir.IT_BOOL, sized, mut self.emit2(ir.IR_AND, ir.IT_BOOL, aligned, mut self.emit2(ir.IR_AND, ir.IT_BOOL, small, pow2)))
    valid: int = mut self.guard(ok)
    a: [1]int = [size]
    p: int = mut self.call_routine("_malloc", true, ir.IT_PTR, a[..])
    got: int = mut self.guard(mut self.cmp(ir.IR_NE, p, mut self.konst(ir.IT_PTR, 0)))
    mut self.registry_add(p, size, align)
    mut self.write_var(pv, self.cur, p)
    mut self.write_var(nv, self.cur, mut self.emit2(ir.IR_CAST, ir.IT_U64, size, -1))
    mut self.guard_end(got)
    mut self.guard_end(valid)
    return mut self.slice_out(mut res, want_res, pv, nv)
}

/* mem.realloc(data, size): data unchanged and the null slice unless size > 0
 * and the allocator succeeds; debug moves data's registry record.
 */
Lw.mem_realloc(mut self, x: u32, mut res: Agg, want_res: bool): int {
    old: int, oldn: int = mut self.view_parts(self.kid(x, 0), true)
    size: int = mut self.expr(self.kid(x, 1), int(ir.IT_I64))
    pv: int = mut self.temp_var(ir.IT_PTR, mut self.konst(ir.IT_PTR, 0))
    nv: int = mut self.temp_var(ir.IT_U64, mut self.konst(ir.IT_U64, 0))
    valid: int = mut self.guard(mut self.cmp(ir.IR_GT, size, mut self.konst(ir.IT_I64, 0)))
    rec: int = -1
    if self.debug { rec = mut self.registry_find(old, oldn) }
    a: [2]int = [old, size]
    p: int = mut self.call_routine("_realloc", true, ir.IT_PTR, a[..])
    got: int = mut self.guard(mut self.cmp(ir.IR_NE, p, mut self.konst(ir.IT_PTR, 0)))
    n: int = mut self.emit2(ir.IR_CAST, ir.IT_U64, size, -1)
    if rec >= 0 {
        mut self.store(rec, 0, p, 0)
        mut self.store(rec, 8, n, 0)
    }
    mut self.write_var(pv, self.cur, p)
    mut self.write_var(nv, self.cur, n)
    mut self.guard_end(got)
    mut self.guard_end(valid)
    return mut self.slice_out(mut res, want_res, pv, nv)
}

/* mem.alloc[T](count), mem.zalloc[T](count), mem.realloc[T](data, count):
 * count elements of T; a zero byte size, an alignment over 16, an
 * overflowing byte count, or an allocator failure is the null slice (data
 * unchanged).
 */
Lw.mem_alloc_typed(mut self, x: u32, bi: u64, mut res: Agg, want_res: bool): int {
    elem: u32 = self.ty(self.unwrap(self.nty(x))).base
    esz: u64 = u64(self.size(elem))
    eal: u64 = u64(self.ty(elem).align)
    old: int = -1
    oldn: int = -1
    if bi == sema.BI_MEM_REALLOC_T { old, oldn = mut self.view_parts(self.kid(x, 0), true) }
    ci: u32 = 0
    if bi == sema.BI_MEM_REALLOC_T { ci = 1 }
    cn: u32 = self.kid(x, ci)
    ct: u8 = mut self.type_in(cn, int(ir.IT_U64))
    count: int = mut self.widen(mut self.expr(cn, int(ct)), ct, ir.IT_U64)
    pv: int = mut self.temp_var(ir.IT_PTR, mut self.konst(ir.IT_PTR, 0))
    nv: int = mut self.temp_var(ir.IT_U64, mut self.konst(ir.IT_U64, 0))
    if esz == 0 || eal > 16 { return mut self.slice_out(mut res, want_res, pv, nv) }
    some: int = mut self.cmp(ir.IR_NE, count, mut self.konst(ir.IT_U64, 0))
    ok: int = mut self.emit2(ir.IR_AND, ir.IT_BOOL, some, mut self.cmp(ir.IR_LE, count, mut self.konst(ir.IT_U64, ~u64(0) / esz)))
    valid: int = mut self.guard(ok)
    bytes: int = mut self.emit2(ir.IR_MUL, ir.IT_U64, count, mut self.konst(ir.IT_U64, esz))
    p: int = -1
    rec: int = -1
    if bi == sema.BI_MEM_REALLOC_T {
        old_bytes: int = mut self.emit2(ir.IR_MUL, ir.IT_U64, oldn, mut self.konst(ir.IT_U64, esz))
        if self.debug { rec = mut self.registry_find(old, old_bytes) }
        a: [2]int = [old, bytes]
        p = mut self.call_routine("_realloc", true, ir.IT_PTR, a[..])
    } else if bi == sema.BI_MEM_ZALLOC_T { // the platform zero-fills
        a: [2]int = [bytes, mut self.konst(ir.IT_U64, 1)]
        p = mut self.call_routine("_calloc", true, ir.IT_PTR, a[..])
    } else {
        a: [1]int = [bytes]
        p = mut self.call_routine("_malloc", true, ir.IT_PTR, a[..])
    }
    got: int = mut self.guard(mut self.cmp(ir.IR_NE, p, mut self.konst(ir.IT_PTR, 0)))
    if rec >= 0 {
        mut self.store(rec, 0, p, 0)
        mut self.store(rec, 8, bytes, 0)
    } else if bi != sema.BI_MEM_REALLOC_T {
        mut self.registry_add(p, bytes, mut self.konst(ir.IT_U64, eal))
    }
    mut self.write_var(pv, self.cur, p)
    mut self.write_var(nv, self.cur, count)
    mut self.guard_end(got)
    mut self.guard_end(valid)
    return mut self.slice_out(mut res, want_res, pv, nv)
}

/* mem.release(mut data), mem.release[T](mut data): free a non-null data
 * (debug first drops its registry record), then data becomes null.
 */
Lw.mem_release(mut self, x: u32): int {
    raw: u32 = self.kid(x, 0)
    if self.node(raw).kind == Kind.mutarg { raw = self.node(raw).a }
    p: Place = mut self.place(raw)
    st: u32 = self.unwrap(p.t)
    esz: u64 = 1
    if st != 0 && self.ty(st).kind == TypeKind.slice { esz = u64(self.size(self.ty(st).base)) }
    ptr: int = -1
    if p.var >= 0 { ptr = mut self.read_var(p.var, self.cur) } else { ptr = mut self.load(ir.IT_PTR, p.addr, p.off, p.flags) }
    live: int = mut self.guard(mut self.cmp(ir.IR_NE, ptr, mut self.konst(ir.IT_PTR, 0)))
    n: int = -1
    if p.var >= 0 { n = mut self.read_var(p.var + 1, self.cur) } else { n = mut self.load(ir.IT_U64, p.addr, p.off + 8, p.flags) }
    if self.debug {
        bytes: int = n
        if esz != 1 { bytes = mut self.emit2(ir.IR_MUL, ir.IT_U64, n, mut self.konst(ir.IT_U64, esz)) }
        a: [2]int = [ptr, bytes]
        _ = mut self.call_routine("__ace$registry_remove", false, ir.IT_VOID, a[..])
    }
    f: [1]int = [ptr]
    _ = mut self.call_routine("_free", true, ir.IT_VOID, f[..])
    mut self.guard_end(live)
    z: Agg = blank(Agg)
    z.n = 2
    z.v[0] = mut self.konst(ir.IT_PTR, 0)
    z.v[1] = mut self.konst(ir.IT_U64, 0)
    mut self.place_put(p, z, 0)
    return -1
}

/* mem.copy, mem.move, mem.fill, mem.zero (Values & Passing: byte
 * operations): debug checks equal lengths, and for copy that nonempty ranges
 * neither wrap nor overlap (noalias), before the routine. The typed copy and
 * move compare element counts, then work on count * sizeof(T) bytes.
 */
Lw.mem_write(mut self, x: u32, bi: u64): int {
    esz: u64 = 1
    b: u64 = bi
    if bi == sema.BI_MEM_COPY_T || bi == sema.BI_MEM_MOVE_T {
        esz = u64(self.size(self.ty(self.unwrap(self.nty(self.node(x).a))).base))
        if bi == sema.BI_MEM_COPY_T { b = sema.BI_MEM_COPY } else { b = sema.BI_MEM_MOVE }
    }
    d: u32 = self.kid(x, 0)
    if self.node(d).kind == Kind.mutarg { d = self.node(d).a }
    dst: int, dlen: int = mut self.view_parts(d, true)
    if b == sema.BI_MEM_FILL || b == sema.BI_MEM_ZERO {
        v: int = -1
        if b == sema.BI_MEM_FILL { v = mut self.expr(self.kid(x, 1), int(ir.IT_U8)) } else { v = mut self.konst(ir.IT_U8, 0) }
        _ = mut self.rtcall("__ace$mem_fill", dst, v, dlen)
        return -1
    }
    src: int, slen: int = mut self.view_parts(self.kid(x, 1), true)
    count: int = slen
    if esz != 1 { slen = mut self.emit2(ir.IR_MUL, ir.IT_U64, slen, mut self.konst(ir.IT_U64, esz)) }
    if self.debug {
        mut self.contract_check(mut self.cmp(ir.IR_EQ, count, dlen))
        if b == sema.BI_MEM_COPY {
            some: int = mut self.guard(mut self.cmp(ir.IR_NE, slen, mut self.konst(ir.IT_U64, 0)))
            dend: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, dst, slen)
            send: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, src, slen)
            mut self.fn.at(dend).imm = 1
            mut self.fn.at(send).imm = 1
            mut self.contract_check(mut self.cmp(ir.IR_GE, dend, dst))
            mut self.contract_check(mut self.cmp(ir.IR_GE, send, src))
            after: int = mut self.cmp(ir.IR_GE, dst, send)
            before: int = mut self.cmp(ir.IR_GE, src, dend)
            mut self.contract_check(mut self.emit2(ir.IR_OR, ir.IT_BOOL, after, before))
            mut self.guard_end(some)
        }
    }
    name: string = "__ace$mem_copy"
    if b == sema.BI_MEM_MOVE { name = "__ace$mem_move" }
    _ = mut self.rtcall(name, dst, src, slen)
    return -1
}

/* The bytes of [N]u8, []u8, or string `at`: its address and length. */
Lw.bytes_parts(mut self, at: u32): (int, int) {
    x: u32 = at
    if self.node(x).kind == Kind.mutarg { x = self.node(x).a }
    t: u32 = self.unwrap(self.nty(x))
    if t != 0 && self.ty(t).kind == TypeKind.array {
        p: int = mut self.place_address(mut self.array_place(x))
        return p, mut self.konst(ir.IT_U64, self.ty(t).count)
    }
    return mut self.view_parts(x, true)
}

/* mem.compare(a, b): the common prefix's order, then the shorter first. */
Lw.mem_compare(mut self, x: u32): int {
    ap: int, an: int = mut self.bytes_parts(self.kid(x, 0))
    bp: int, bn: int = mut self.bytes_parts(self.kid(x, 1))
    count: int = mut self.temp_var(ir.IT_U64, an)
    shorter: int = mut self.guard(mut self.cmp(ir.IR_LT, bn, an))
    mut self.write_var(count, self.cur, bn)
    mut self.guard_end(shorter)
    r: int = mut self.rtcall("__ace$mem_compare", ap, bp, mut self.read_var(count, self.cur))
    out: int = mut self.temp_var(ir.IT_I64, r)
    same: int = mut self.guard(mut self.cmp(ir.IR_EQ, r, mut self.konst(ir.IT_I64, 0)))
    gt: int = mut self.emit2(ir.IR_CAST, ir.IT_I64, mut self.cmp(ir.IR_GT, an, bn), -1)
    lt: int = mut self.emit2(ir.IR_CAST, ir.IT_I64, mut self.cmp(ir.IR_LT, an, bn), -1)
    mut self.write_var(out, self.cur, mut self.emit2(ir.IR_SUB, ir.IT_I64, gt, lt))
    mut self.guard_end(same)
    return mut self.read_var(out, self.cur)
}

/* mem.equal(a, b): equal lengths, then equal bytes. */
Lw.mem_equal(mut self, x: u32): int {
    ap: int, an: int = mut self.bytes_parts(self.kid(x, 0))
    bp: int, bn: int = mut self.bytes_parts(self.kid(x, 1))
    out: int = mut self.temp_var(ir.IT_BOOL, mut self.konst(ir.IT_BOOL, 0))
    same: int = mut self.guard(mut self.cmp(ir.IR_EQ, an, bn))
    r: int = mut self.rtcall("__ace$mem_compare", ap, bp, an)
    mut self.write_var(out, self.cur, mut self.cmp(ir.IR_EQ, r, mut self.konst(ir.IT_I64, 0)))
    mut self.guard_end(same)
    return mut self.read_var(out, self.cur)
}

/* A direct call to format helper `h` with the arguments in `g`, `ret` its result. */
Lw.format_helper_call(mut self, h: u32, g: Args, ret: u8): int {
    sy: sema.Sym = self.s.sym(h)
    name: string = mut self.fn_mangle(h, sy.ty, sy.spec_args, sy.spec_nargs, sy.spec_args != 0)
    id: int = mut self.emit(ir.IR_CALL, ret)
    x: mut *ir.IrIns = mut self.fn.at(id)
    x.sym = h
    x.name = name
    none: Agg = blank(Agg)
    return mut self.call_finish(id, g, self.ty(self.s.sym(h).ty).ret, mut none, false, -1)
}

/* Storage in the caller's frame for fmt.printf's sink: a call's output
 * normally drains in one write.
 */
PRINTF_STORAGE: const u64 = 1024

/* fmt.printf and str.format (Standard Library: fmt, str): the destination
 * (str.format) and every argument once, in order; then a sink opened over
 * the storage, sema's plan written through it one piece writer per part, and
 * the sink closed. `fi` is the format's argument index: 1 when a destination
 * comes first. A printf descriptor (`to_fd` 1) is passed to the opener;
 * Buffer.printf's receiver (`to_fd` 2) keeps its sink across calls.
 */
Lw.format_call(mut self, x: u32, fi: u32, to_fd: int, mut res: Agg, want_res: bool): int {
    plan: sema.FormatPlan, _ = self.s.format_plan(x)
    open_t: SType = self.ty(self.s.sym(plan.open).ty)
    text: string = self.node(plan.format).text
    dp: int = -1
    dn: int = -1
    fd: int = -1
    sink: int = -1
    dest: u32 = 0
    if to_fd == 2 {
        dest = self.node(self.node(x).a).a // the Buffer.printf receiver
    } else if fi != 0 {
        dest = self.kid(x, 0)
        if self.node(dest).kind == Kind.mutarg { dest = self.node(dest).a }
    }
    if to_fd == 2 {
        p: Place = mut self.place(dest)
        bt: u32 = self.unwrap(p.t)
        f: sema.SField = self.s.field(self.ty(bt), u32(self.find_field(bt, "sink")))
        fd = mut self.place_address(p)
        p.off += i32(f.offset)
        p.t = f.ty
        sink = mut self.place_address(p)
    } else if to_fd != 0 {
        v: Agg = blank(Agg)
        mut self.value(dest, self.nty(dest), mut v)
        fd = mut self.widen(v.v[0], mut self.need_type(self.nty(dest)), mut self.need_type(self.s.param(open_t, 2)))
    } else if fi != 0 {
        dp, dn = mut self.view_parts(dest, true)
    }
    nargs: u32 = self.node(x).nkids - fi - 1
    cap: array.Array[Agg] = array.Array[Agg] {}
    defer mut cap.wipe()
    capt: array.Array[u32] = array.Array[u32] {}
    defer mut capt.wipe()
    for i: u32 in 0..nargs {
        a: u32 = self.kid(x, i + fi + 1)
        if self.node(a).kind == Kind.mutarg { a = self.node(a).a }
        t: u32 = self.nty(a)
        for k: u32 in 0..plan.nparts { // an untyped constant takes its writer's type
            if !self.is_untyped(t) { break }
            part: sema.FormatPart = self.s.format_part(plan.parts + k)
            if part.arg == i + fi + 1 && part.helper != 0 { t = self.s.param(self.ty(self.s.sym(part.helper).ty), 1) }
        }
        v: Agg = blank(Agg)
        mut self.value(a, t, mut v)
        fail(mut cap.push(v))
        fail(mut capt.push(t))
    }
    if (fi == 0 && to_fd != 2) || to_fd == 1 {
        dp = mut self.at_entry(ir.IR_SLOT, ir.IT_PTR)
        s: mut *ir.IrIns = mut self.fn.at(dp)
        s.imm = PRINTF_STORAGE
        s.aux = 8
        dn = mut self.konst(ir.IT_U64, PRINTF_STORAGE)
    }
    g: Args = Args.init()
    defer mut g.wipe()
    if to_fd == 2 {
        mut g.scalar(fd)
    } else {
        sink = mut self.new_slot(self.s.param(open_t, 0))
        mut g.scalar(sink)
        fail(mut g.parts.push(ir.IrPart { agg = self.s.param(open_t, 1), first = int(g.v.len), n = 2 }))
        fail(mut g.v.push(dp))
        fail(mut g.v.push(dn))
        g.agg = true
    }
    if to_fd == 1 { mut g.scalar(fd) }
    _ = mut self.format_helper_call(plan.open, g, ir.IT_VOID)
    for i: u32 in 0..plan.nparts {
        part: sema.FormatPart = self.s.format_part(plan.parts + i)
        ft: SType = self.ty(self.s.sym(part.helper).ty)
        mut g.clear()
        mut g.scalar(sink)
        v: Agg = blank(Agg)
        vt: u32 = self.s.param(ft, 1)
        if part.kind == sema.PF_TEXT {
            v.n = 2
            v.v[0] = mut self.emit(ir.IR_STR, ir.IT_PTR)
            si: mut *ir.IrIns = mut self.fn.at(v.v[0])
            si.name = text[part.off..part.off + part.len]
            si.imm = u64(part.len)
            v.v[1] = mut self.konst(ir.IT_U64, u64(part.len))
        } else if part.kind == sema.PF_LITERAL_BYTE {
            v.n = 1
            v.v[0] = mut self.konst(mut self.need_type(vt), u64(text[part.off])) // '%' for %%
        } else {
            v = cap.get(usize(part.arg - fi - 1))
            if !self.is_agg(vt) { v.v[0] = mut self.widen(v.v[0], mut self.need_type(capt.get(usize(part.arg - fi - 1))), mut self.need_type(vt)) }
        }
        if self.is_agg(vt) {
            fail(mut g.parts.push(ir.IrPart { agg = vt, first = int(g.v.len), n = v.n }))
            for k: int in 0..v.n { fail(mut g.v.push(v.v[k])) }
            g.agg = true
        } else {
            mut g.scalar(v.v[0])
        }
        p: u32 = 2
        if part.kind == sema.PF_BINARY || part.kind == sema.PF_OCTAL || part.kind == sema.PF_HEX_LOWER || part.kind == sema.PF_HEX_UPPER {
            base: u64 = 16
            if part.kind == sema.PF_BINARY { base = 2 } else if part.kind == sema.PF_OCTAL { base = 8 }
            mut g.scalar(mut self.konst(mut self.need_type(self.s.param(ft, p)), base))
            upper: u64 = 0
            if part.kind == sema.PF_HEX_UPPER { upper = 1 }
            mut g.scalar(mut self.konst(mut self.need_type(self.s.param(ft, p + 1)), upper))
            p += 2
        } else if part.kind == sema.PF_FIXED || part.kind == sema.PF_SCIENTIFIC || part.kind == sema.PF_GENERAL {
            mut g.scalar(mut self.konst(mut self.need_type(self.s.param(ft, p)), u64(part.precision)))
            p += 1
        }
        mut g.scalar(mut self.konst(mut self.need_type(self.s.param(ft, p)), u64(part.width)))
        zero: u64 = 0
        if part.zero { zero = 1 }
        mut g.scalar(mut self.konst(mut self.need_type(self.s.param(ft, p + 1)), zero))
        _ = mut self.format_helper_call(part.helper, g, ir.IT_VOID)
    }
    mut g.clear()
    if to_fd == 2 { mut g.scalar(fd) } else { mut g.scalar(sink) }
    n: int = mut self.format_helper_call(plan.close, g, ir.IT_I64)
    if fi == 0 || to_fd != 0 { return n } // printf's int; str.format's (count, ok) follows
    count: int = mut self.temp_var(ir.IT_U64, mut self.konst(ir.IT_U64, 0))
    fit: int = mut self.temp_var(ir.IT_BOOL, mut self.konst(ir.IT_BOOL, 0))
    wrote: int = mut self.guard(mut self.cmp(ir.IR_GE, n, mut self.konst(ir.IT_I64, 0)))
    mut self.write_var(count, self.cur, mut self.emit2(ir.IR_CAST, ir.IT_U64, n, -1))
    mut self.write_var(fit, self.cur, mut self.konst(ir.IT_BOOL, 1))
    mut self.guard_end(wrote)
    if want_res {
        res.n = 2
        res.v[0] = mut self.read_var(count, self.cur)
        res.v[1] = mut self.read_var(fit, self.cur)
    }
    return n
}

/* The address of an external symbol with no Ace symbol of its own. */
Lw.global_named(mut self, name: string): int {
    id: int = mut self.emit(ir.IR_GLOBAL, ir.IT_PTR)
    mut self.fn.at(id).name = name
    return id
}

/* The address of builtin `bi`'s process-start word: Darwin's accessor
 * results; on linux-x64, the argc and argv words main stored at entry and
 * glibc's environ, read at each use so it follows setenv.
 */
Lw.process_word(mut self, bi: u64): int {
    if !mem.equal(self.s.target(), "linux-x64") {
        name: string = "__NSGetEnviron"
        if bi == sema.BI_SYS_ARGC { name = "__NSGetArgc" } else if bi == sema.BI_SYS_ARG { name = "__NSGetArgv" }
        return mut self.call_routine(name, true, ir.IT_PTR, null)
    }
    if bi == sema.BI_SYS_ARGC { return mut self.global_named("__ace$argc") }
    if bi == sema.BI_SYS_ARG { return mut self.global_named("__ace$argv") }
    return mut self.global_named("_environ")
}

/* A u64 counted up from 0 while `step` (given the count) is nonzero: the
 * shared loop of sys.envc and a C string's length. `stride` scales the
 * count into a byte offset from `p`, and `t` is the word read there.
 */
Lw.count_until_zero(mut self, p: int, stride: u64, t: u8): int {
    n: int = mut self.var_new(0, ir.IT_U64, -1)
    mut self.write_var(n, self.cur, mut self.konst(ir.IT_U64, 0))
    head: int = mut self.new_block()
    body: int = mut self.new_block()
    exit: int = mut self.new_block()
    mut self.jump(head)
    mut self.enter(head)
    i: int = mut self.read_var(n, head)
    at: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, p, i)
    mut self.fn.at(at).imm = stride
    e: int = mut self.load(t, at, 0, 0)
    mut self.terminate(ir.IR_BR, mut self.emit2(ir.IR_NE, ir.IT_BOOL, e, mut self.konst(t, 0)), body, exit)
    mut self.seal(body)
    mut self.enter(body)
    mut self.write_var(n, self.cur, mut self.emit2(ir.IR_ADD, ir.IT_U64, i, mut self.konst(ir.IT_U64, 1)))
    mut self.jump(head)
    mut self.seal(head)
    mut self.seal(exit)
    mut self.enter(exit)
    return i
}

/* A compiler-backed call the IR covers: its value (a slice's or string's
 * leaves into res), or -2 for one it does not.
 */
Lw.builtin(mut self, x: u32, bi: u64, mut res: Agg, want_res: bool): int {
    if bi == sema.BI_BITS_POP_COUNT || bi == sema.BI_BITS_LEAD_ZEROS || bi == sema.BI_BITS_TRAIL_ZEROS || bi == sema.BI_BITS_BYTE_SWAP {
        t: u8 = mut self.need_type(self.nty(self.kid(x, 0)))
        op: u8 = ir.IR_BSWAP
        if bi == sema.BI_BITS_POP_COUNT { op = ir.IR_POPCNT } else if bi == sema.BI_BITS_LEAD_ZEROS { op = ir.IR_CLZ } else if bi == sema.BI_BITS_TRAIL_ZEROS { op = ir.IR_CTZ }
        v: int = mut self.emit2(op, t, mut self.expr(self.kid(x, 0), int(t)), -1)
        return mut self.widen(v, t, mut self.need_type(self.nty(x)))
    }
    if bi == sema.BI_BITS_ROTATE_LEFT || bi == sema.BI_BITS_ROTATE_RIGHT {
        t: u8 = mut self.need_type(self.nty(self.kid(x, 0)))
        v: int = mut self.expr(self.kid(x, 0), int(t))
        ct: u8 = mut self.type_in(self.kid(x, 1), int(ir.IT_U64))
        c: int = mut self.widen(mut self.expr(self.kid(x, 1), int(ct)), ct, ir.IT_U64)
        op: u8 = ir.IR_ROTR
        if bi == sema.BI_BITS_ROTATE_LEFT { op = ir.IR_ROTL }
        return mut self.emit2(op, t, v, c)
    }
    if bi == sema.BI_BITS_WRAP_ADD || bi == sema.BI_BITS_WRAP_SUB || bi == sema.BI_BITS_WRAP_MUL { // never checked
        t: u8 = mut self.need_type(self.nty(x))
        a: int = mut self.expr(self.kid(x, 0), int(t))
        op: u8 = ir.IR_MUL
        if bi == sema.BI_BITS_WRAP_ADD { op = ir.IR_ADD } else if bi == sema.BI_BITS_WRAP_SUB { op = ir.IR_SUB }
        return mut self.emit2(op, t, a, mut self.expr(self.kid(x, 1), int(t)))
    }
    if bi == sema.BI_MATH_SQRT || bi == sema.BI_MATH_FLOOR || bi == sema.BI_MATH_CEIL {
        t: u8 = mut self.need_type(self.nty(x))
        op: u8 = ir.IR_CEIL
        if bi == sema.BI_MATH_SQRT { op = ir.IR_SQRT } else if bi == sema.BI_MATH_FLOOR { op = ir.IR_FLOOR }
        return mut self.emit2(op, t, mut self.expr(self.kid(x, 0), int(t)), -1)
    }
    if bi == sema.BI_MATH_FMA {
        t: u8 = mut self.need_type(self.nty(x))
        a: int = mut self.expr(self.kid(x, 0), int(t))
        b: int = mut self.expr(self.kid(x, 1), int(t))
        c: int = mut self.expr(self.kid(x, 2), int(t))
        id: int = mut self.emit2(ir.IR_FMA, t, a, b)
        mut self.fn.arg_add(id, c)
        return id
    }
    if bi == sema.BI_INTERNAL_LOAD_U64 { // the native-endian word at text[index], unchecked
        p: int, _ = mut self.view_parts(self.kid(x, 0), false)
        it: u8 = mut self.type_in(self.kid(x, 1), int(ir.IT_U64))
        at: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, p, mut self.widen(mut self.expr(self.kid(x, 1), int(it)), it, ir.IT_U64))
        mut self.fn.at(at).imm = 1
        return mut self.load(ir.IT_U64, at, 0, 0)
    }
    if bi == sema.BI_SYS_ARGC { // an int, then char** arrays: see process_word
        return mut self.widen(mut self.load(ir.IT_I32, mut self.process_word(bi), 0, 0), ir.IT_I32, mut self.need_type(self.nty(x)))
    }
    if bi == sema.BI_SYS_ENVC {
        env: int = mut self.load(ir.IT_PTR, mut self.process_word(bi), 0, 0)
        return mut self.widen(mut self.count_until_zero(env, 8, ir.IT_PTR), ir.IT_U64, mut self.need_type(self.nty(x)))
    }
    if bi == sema.BI_SYS_ARG || bi == sema.BI_SYS_ENV { // entry i's bytes up to its NUL
        it: u8 = mut self.type_in(self.kid(x, 0), int(ir.IT_U64))
        i: int = mut self.widen(mut self.expr(self.kid(x, 0), int(it)), it, ir.IT_U64)
        base: int = mut self.load(ir.IT_PTR, mut self.process_word(bi), 0, 0)
        at: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, base, i)
        mut self.fn.at(at).imm = 8
        p: int = mut self.load(ir.IT_PTR, at, 0, 0)
        n: int = mut self.count_until_zero(p, 1, ir.IT_U8)
        if !want_res { return -1 }
        res.n = 2
        res.v[0] = p
        res.v[1] = n
        return -1
    }
    if bi != sema.BI_MEM_ALLOC && bi != sema.BI_MEM_REALLOC && bi != sema.BI_MEM_RELEASE && bi != sema.BI_MEM_ALLOC_T && bi != sema.BI_MEM_ZALLOC_T && bi != sema.BI_MEM_REALLOC_T && bi != sema.BI_MEM_RELEASE_T && bi != sema.BI_MEM_ALLOC_SIZE && bi != sema.BI_MEM_COPY && bi != sema.BI_MEM_MOVE && bi != sema.BI_MEM_COPY_T && bi != sema.BI_MEM_MOVE_T && bi != sema.BI_MEM_FILL && bi != sema.BI_MEM_ZERO && bi != sema.BI_MEM_COMPARE && bi != sema.BI_MEM_EQUAL && bi != sema.BI_FMT_PRINTF && bi != sema.BI_FMT_PRINTF_FD && bi != sema.BI_FMT_PRINTF_BUF && bi != sema.BI_STR_FORMAT {
        return -2
    }
    if self.s.node_ival(x) != bi { return -2 } // sema checked it as the builtin
    if bi == sema.BI_MEM_ALLOC { return mut self.mem_alloc(x, mut res, want_res) }
    if bi == sema.BI_MEM_REALLOC { return mut self.mem_realloc(x, mut res, want_res) }
    if bi == sema.BI_MEM_RELEASE || bi == sema.BI_MEM_RELEASE_T { return mut self.mem_release(x) }
    if bi == sema.BI_MEM_ALLOC_SIZE { // the allocator's usable size of data's allocation
        p: int, _ = mut self.view_parts(self.kid(x, 0), false)
        name: string = "_malloc_size"
        if mem.equal(self.s.target(), "linux-x64") { name = "_malloc_usable_size" }
        a: [1]int = [p]
        return mut self.widen(mut self.call_routine(name, true, ir.IT_U64, a[..]), ir.IT_U64, mut self.need_type(self.nty(x)))
    }
    if bi == sema.BI_MEM_COMPARE { return mut self.mem_compare(x) }
    if bi == sema.BI_MEM_EQUAL { return mut self.mem_equal(x) }
    if bi == sema.BI_FMT_PRINTF || bi == sema.BI_FMT_PRINTF_FD || bi == sema.BI_FMT_PRINTF_BUF || bi == sema.BI_STR_FORMAT {
        _, planned: bool = self.s.format_plan(x)
        if !planned { return -2 }
        if bi == sema.BI_FMT_PRINTF { return mut self.format_call(x, 0, 0, mut res, want_res) }
        if bi == sema.BI_FMT_PRINTF_FD { return mut self.format_call(x, 1, 1, mut res, want_res) }
        if bi == sema.BI_FMT_PRINTF_BUF { return mut self.format_call(x, 0, 2, mut res, want_res) }
        return mut self.format_call(x, 1, 0, mut res, want_res)
    }
    if bi == sema.BI_MEM_COPY || bi == sema.BI_MEM_MOVE || bi == sema.BI_MEM_COPY_T || bi == sema.BI_MEM_MOVE_T || bi == sema.BI_MEM_FILL || bi == sema.BI_MEM_ZERO {
        return mut self.mem_write(x, bi)
    }
    return mut self.mem_alloc_typed(x, bi, mut res, want_res)
}

/* Debug (Safety #2): E(v) traps unless v is a member's discriminant, checked
 * before narrowing to E's backing type. A dense enum (0..n-1) needs one
 * unsigned compare; a sparse one compares each member.
 */
Lw.enum_check(mut self, v: int, from: u8, e: u32, site: u32) {
    w: int = v
    if from != ir.IT_U64 { w = mut self.emit2(ir.IR_CAST, ir.IT_U64, v, -1) } // sign- or zero-extended
    et: SType = self.ty(e)
    n: u32 = et.nfields
    dense: bool = true
    for i: u32 in 0..n {
        if u64(self.s.field(et, i).value) >= u64(n) { dense = false }
    }
    c: int = -1
    if dense {
        c = mut self.emit2(ir.IR_LT, ir.IT_BOOL, w, mut self.konst(ir.IT_U64, u64(n)))
    } else {
        c = mut self.konst(ir.IT_BOOL, 0)
        for i: u32 in 0..n {
            c = mut self.emit2(ir.IR_OR, ir.IT_BOOL, c, mut self.emit2(ir.IR_EQ, ir.IT_BOOL, w, mut self.konst(ir.IT_U64, u64(self.s.field(et, i).value))))
        }
    }
    id: int = mut self.emit2(ir.IR_CHECK, ir.IT_VOID, c, -1)
    x: mut *ir.IrIns = mut self.fn.at(id)
    x.name = "enum value is not a member"
    x.has_name = true
    x.at = site
}

/* The call forms sema leaves without a symbol: bitcast(T, v), panic(m),
 * assert(c), *T(address), and []T(pointer, count). Returns -2 for another.
 */
Lw.special_call(mut self, x: u32, mut res: Agg, want_res: bool, dst: int): int {
    cn: Node = self.node(x)
    callee: u32 = cn.a
    if self.is_layout_builtin(x, "bitcast") { // the same bits as another plain-bits type
        to: u32 = self.nty(x)
        from: u32 = self.nty(self.kid(x, 1))
        if dst >= 0 { // equal sizes: the source's bits stored are the result's
            mut self.store_value(self.kid(x, 1), from, dst, 0)
            return -1
        }
        if !self.is_agg(to) && !self.is_agg(from) {
            tt: u8 = mut self.need_type(to)
            ft: u8 = mut self.need_type(from)
            v: int = mut self.expr(self.kid(x, 1), int(ft))
            if tt == ft { return v }
            if ir.type_float(tt) != ir.type_float(ft) { return mut self.emit2(ir.IR_BITCAST, tt, v, -1) }
        }
        // otherwise through a stack object aligned for both
        st: u32 = from
        if self.ty(to).align > self.ty(from).align { st = to }
        slot: int = mut self.new_slot(st)
        mut self.store_value(self.kid(x, 1), from, slot, 0)
        out: Agg = blank(Agg)
        mut self.place_get(Place { addr = slot, t = to }, 0, mut out)
        if want_res { res = out }
        if self.is_agg(to) { return -1 }
        return out.v[0]
    }
    if self.nsym(x) != 0 || callee == 0 { return -2 }
    ck: Kind = self.node(callee).kind
    if self.s.node_ival(x) != 0 && ck == Kind.ident && mem.equal(self.node(callee).text, "panic") && cn.nkids == 1 {
        // panic(message): the bytes to stderr, best effort, then abort (Errors #15)
        ptr: int, len: int = mut self.view_parts(self.kid(x, 0), true)
        w: [3]int = [mut self.konst(ir.IT_I32, 2), ptr, len]
        _ = mut self.call_routine("_write", true, ir.IT_I64, w[..])
        _ = mut self.call_routine("_abort", true, ir.IT_VOID, null)
        return -1
    }
    iv: u64 = self.s.node_ival(x)
    if (iv == 2 || iv == 3) && ck == Kind.ident && mem.equal(self.node(callee).text, "assert") && cn.nkids == 1 {
        // assert(condition): debug evaluates it once, and a false one writes
        // "path:line:col: assertion failed" to stderr and aborts; release
        // removes the whole condition, side effects included
        if !self.debug || iv == 3 { return -1 }
        ok: int = mut self.new_block()
        bad: int = mut self.new_block()
        mut self.cond(self.kid(x, 0), ok, bad)
        mut self.seal(ok)
        mut self.seal(bad)
        mut self.enter(bad)
        if self.cur >= 0 {
            buf: [48]u8
            b: Out = Out.init(mut buf[..])
            _ = mut b.printf(":%u:%u: assertion failed\n", uint(cn.line), uint(cn.col))
            text: string = mut self.fn.names.join([self.s.file_name(x), b.text()])
            p: int = mut self.emit(ir.IR_STR, ir.IT_PTR)
            si: mut *ir.IrIns = mut self.fn.at(p)
            si.name = text
            si.imm = u64(text.len)
            w: [3]int = [mut self.konst(ir.IT_I32, 2), p, mut self.konst(ir.IT_U64, u64(text.len))]
            _ = mut self.call_routine("_write", true, ir.IT_I64, w[..])
            _ = mut self.call_routine("_abort", true, ir.IT_VOID, null)
            mut self.jump(ok) // never taken: abort does not return
        }
        mut self.enter(ok)
        return -1
    }
    proven: bool = (self.s.node_proof(x) & sema.PROOF_BOUNDS) != 0
    if ck == Kind.ptr && cn.nkids == 1 {
        // *T(address) or *T(pointer): the same bits; debug checks the address
        // is aligned for T unless sema proved it
        ft: u32 = self.unwrap(self.nty(self.kid(x, 0)))
        from_ptr: bool = ft != 0 && self.ty(ft).kind == TypeKind.ptr
        at: u8 = ir.IT_PTR
        if !from_ptr { at = mut self.type_in(self.kid(x, 0), int(ir.IT_U64)) }
        v: int = mut self.expr(self.kid(x, 0), int(at))
        if from_ptr && proven { return v }
        if from_ptr { v = mut self.emit2(ir.IR_CAST, ir.IT_U64, v, -1) } else { v = mut self.widen(v, at, ir.IT_U64) }
        pt: u32 = self.unwrap(self.nty(x))
        align: u64 = 1
        if pt != 0 && self.ty(pt).base != 0 { align = u64(self.ty(self.ty(pt).base).align) }
        if self.debug && align > 1 && !proven {
            low: int = mut self.emit2(ir.IR_AND, ir.IT_U64, v, mut self.konst(ir.IT_U64, align - 1))
            bad: int = mut self.guard(mut self.cmp(ir.IR_NE, low, mut self.konst(ir.IT_U64, 0)))
            _ = mut self.call_routine("__ace$arithmetic_fail", false, ir.IT_VOID, null)
            mut self.guard_end(bad)
        }
        return mut self.emit2(ir.IR_CAST, ir.IT_PTR, v, -1)
    }
    if ck == Kind.slice_t && cn.nkids == 2 {
        // []T(pointer, count): debug checks a nonempty one has a nonnull start
        // and an end, count elements on, that the address space holds
        p: int = mut self.expr(self.kid(x, 0), int(ir.IT_PTR))
        ct: u8 = mut self.type_in(self.kid(x, 1), int(ir.IT_U64))
        n: int = mut self.widen(mut self.expr(self.kid(x, 1), int(ct)), ct, ir.IT_U64)
        if self.debug && !proven {
            some: int = mut self.guard(mut self.cmp(ir.IR_NE, n, mut self.konst(ir.IT_U64, 0)))
            null_p: int = mut self.guard(mut self.cmp(ir.IR_EQ, p, mut self.konst(ir.IT_PTR, 0)))
            _ = mut self.call_routine("__ace$null_fail", false, ir.IT_VOID, null)
            mut self.guard_end(null_p)
            end: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, p, n) // the rest: its own checks
            e: mut *ir.IrIns = mut self.fn.at(end)
            e.imm = u64(self.size(self.ty(self.unwrap(self.nty(x))).base))
            e.flags = ir.IRF_CHECKED
            mut self.guard_end(some)
        }
        if want_res {
            res.n = 2
            res.v[0] = p
            res.v[1] = n
        }
        return p
    }
    return -2
}

/* A call `x`; an aggregate result's leaves go to `res` when `want_res`, one
 * of over MAX_LEAVES leaves to memory at `dst`, or a new stack object when dst < 0.
 */
Lw.call(mut self, x: u32, want: int, mut res: Agg, want_res: bool, dst: int): int {
    cn: Node = self.node(x)
    callee: u32 = cn.a
    if callee != 0 && self.node(callee).kind == Kind.ident {
        nm: string = self.node(callee).text
        if self.nsym(x) == 0 && (mem.equal(nm, "sizeof") || mem.equal(nm, "alignof") || mem.equal(nm, "offsetof")) {
            return mut self.konst(mut self.type_in(x, want), self.s.node_ival(x)) // folded by sema
        }
    }
    if self.is_layout_builtin(x, "static_assert") { return -1 }
    if self.contract_ctor(x) {
        mut self.contract_value(x, mut res)
        return -1
    }
    if self.is_layout_builtin(x, "blank") { // the zero of its type
        t: u32 = self.nty(x)
        if !self.is_agg(t) { return mut self.konst(mut self.type_in(x, want), 0) }
        lv: ir.Leaves = blank(ir.Leaves)
        n: int = mut self.leaves(t, mut lv)
        if want_res {
            res.n = n
            for k: int in 0..n { res.v[k] = mut self.konst(lv.v[k].ty, 0) }
        }
        return -1
    }
    sc: int = mut self.special_call(x, mut res, want_res, dst)
    if sc != -2 { return sc }
    inst: bool = callee != 0 && self.node(callee).kind == Kind.index && self.nsym(callee) != 0 // larger[int](a, b)
    s: u32 = self.nsym(x)
    if inst { s = self.nsym(callee) }
    if s == 0 && callee != 0 && self.node(callee).kind == Kind.ident && mem.equal(self.node(callee).text, "typeid") {
        return mut self.konst(ir.IT_U64, self.s.node_ival(x)) // typeid(T): the type's identity word
    }
    if s == 0 && callee != 0 && self.node(callee).kind == Kind.ident && self.nty(callee) != 0 && self.ty(self.nty(callee)).kind == TypeKind.error_domain {
        id: int = mut self.konst(ir.IT_U64, self.s.node_ival(x) << 32) // Domain(code) (Errors #5, #7)
        if cn.nkids != 1 { return id }
        code: int = mut self.emit2(ir.IR_CAST, ir.IT_U32, mut self.expr(self.kid(x, 0), int(ir.IT_I32)), -1) // its raw bits
        return mut self.emit2(ir.IR_OR, ir.IT_U64, id, mut self.emit2(ir.IR_CAST, ir.IT_U64, code, -1))
    }
    if s == 0 && callee != 0 && self.node(callee).kind == Kind.ident && self.nty(callee) != 0 && cn.nkids == 1 && self.ty(self.nty(callee)).kind != TypeKind.func {
        // a conversion
        to: u8 = mut self.type_in(x, want)
        a: u32 = self.kid(x, 0)
        if self.is_untyped(self.nty(a)) { return mut self.expr(a, int(to)) }
        from: u8 = mut self.need_type(self.nty(a))
        if to == ir.IT_BOOL && from != ir.IT_BOOL {
            mut self.unsupported("conversion to bool")
            return mut self.dummy()
        }
        v: int = mut self.expr(a, int(from))
        et: u32 = self.unwrap(self.nty(x))
        if self.debug && et != 0 && self.ty(et).kind == TypeKind.enum && (self.node(self.ty(et).decl).flags & parser.F_OPEN) == 0 {
            mut self.enum_check(v, from, et, x)
        }
        if from == to { return v }
        return mut self.emit2(ir.IR_CAST, to, v, -1)
    }
    cc: int = mut self.contract_call(x, mut res, want_res, dst)
    if cc != -2 { return cc }
    if s == 0 || self.s.sym(s).kind != sema.SymKind.func || callee == 0 {
        if s != 0 && self.s.sym(s).kind == sema.SymKind.var {
            return mut self.indirect_call(x, s, mut res, want_res, dst)
        }
        if self.field_call(x) { return mut self.indirect_call(x, 0, mut res, want_res, dst) }
        mut self.unported("this call form")
        return mut self.dummy()
    }
    sy: sema.Sym = self.s.sym(s)
    d: u32 = sy.decl
    if d == 0 {
        mut self.unsupported("extern call")
        return mut self.dummy()
    }
    dn: Node = self.node(d)
    if dn.kind == Kind.func && dn.ival != 0 {
        v: int = mut self.builtin(x, dn.ival, mut res, want_res)
        if v != -2 { return v }
    }
    if (dn.kind == Kind.func && dn.ival != 0) || (dn.flags & parser.F_INTRINSIC) != 0 {
        mut self.unsupported("compiler-backed call")
        return mut self.dummy()
    }
    if (dn.flags & parser.F_INLINE) != 0 || self.auto_inline(s) { return mut self.inline_call(x, mut res, want_res, dst) }
    g: Args = Args.init()
    defer mut g.wipe()
    first_var: int = mut self.call_args(x, s, mut g)
    ft: u32 = self.nty(callee)
    if ft == 0 || self.ty(ft).kind != TypeKind.func { ft = sy.ty }
    rt: u32 = 0
    if ft != 0 { rt = self.ty(ft).ret }
    id: int = mut self.emit(ir.IR_CALL, mut self.result_type(rt))
    if inst && !self.fn_value_named(s, callee) { mut self.unsupported("generic call") }
    name: string = ""
    if inst && self.fn_value_named(s, callee) {
        name = mut self.fn_value_mangle(s, callee)
    } else if self.c_named(s) {
        name = mut self.link_name(s, ft)
    } else if !inst {
        name = mut self.fn_call_mangle(s, x)
    }
    c: mut *ir.IrIns = mut self.fn.at(id)
    c.sym = s
    c.name = name
    if (dn.flags & parser.F_COLD) != 0 { c.flags |= ir.IRF_COLD }
    if sy.is_extern && (dn.flags & parser.F_VARARGS) != 0 {
        c.flags |= ir.IRF_VARARGS
        if first_var >= 0 { c.aux = i32(first_var) } else { c.aux = i32(g.v.len) }
    }
    return mut self.call_finish(id, g, rt, mut res, want_res, dst)
}

// --- inline functions -----------------------------------------------------------

/* The inline function direct call `x` names, with the type arguments its body
 * is stamped under (a run of sema's params), or 0.
 */
Lw.inline_target(self, x: u32): (u32, u32, u32) {
    callee: u32 = self.node(x).a
    if callee == 0 { return 0, 0, 0 }
    if self.node(callee).kind == Kind.index && self.nsym(callee) != 0 {
        d: u32 = self.s.sym(self.nsym(callee)).decl
        if d == 0 || (self.node(d).flags & parser.F_INLINE) == 0 { return 0, 0, 0 }
        args: u32, found: bool = self.s.inst_args(d, self.nty(callee))
        if !found { return 0, 0, 0 }
        return d, args, self.node(self.node(d).c).nkids
    }
    s: u32 = self.nsym(x)
    if s == 0 { return 0, 0, 0 }
    sy: sema.Sym = self.s.sym(s)
    if sy.kind != sema.SymKind.func || sy.is_extern || sy.decl == 0 { return 0, 0, 0 }
    if (self.node(sy.decl).flags & parser.F_INLINE) == 0 && !self.auto_inline(s) { return 0, 0, 0 }
    if sy.is_generic { // a method of a generic type: its owner's arguments
        cft: u32 = self.nty(callee)
        if cft == 0 || self.ty(cft).kind != TypeKind.func { cft = sy.ty }
        owner: u32 = 0
        if self.assoc_call(x) {
            if self.node(callee).kind == Kind.selector { owner = self.nty(self.node(callee).a) }
        } else if cft != 0 && self.ty(cft).nparams > 0 {
            owner = self.s.param(self.ty(cft), 0)
        }
        if owner == 0 { return 0, 0, 0 }
        return sy.decl, self.ty(owner).args, self.ty(owner).nargs
    }
    return sy.decl, 0, 0
}

/* Release builds also expand a small leaf function no source marks inline:
 * its body at most AUTO_INLINE_NODES nodes, with no call other than a
 * conversion, a compiler-backed operation, or an `inline` function, and inline's other limits
 * (Functions & ABI #8).
 */
AUTO_INLINE_NODES: const int = 24
INLINE_CHAIN: const usize = 26 // declarations one auto_inline_decl chain can hold within budget

/* The node count of `at` added to `size`, or AUTO_INLINE_NODES + 1 once over
 * it or on any node that rules expansion out.
 */
Lw.auto_inline_size(self, at: u32, size: int, mut chain: [INLINE_CHAIN]u32, depth: usize): int {
    if at == 0 || size > AUTO_INLINE_NODES { return size }
    n: Node = self.node(at)
    if n.kind == Kind.defer || n.kind == Kind.asm { return AUTO_INLINE_NODES + 1 }
    grown: int = 0
    if n.kind == Kind.call {
        s: u32 = self.nsym(at)
        if n.a != 0 && self.node(n.a).kind == Kind.index && self.nsym(n.a) != 0 { s = self.nsym(n.a) }
        backed: bool = false
        if s != 0 && self.s.sym(s).kind == sema.SymKind.func && self.s.sym(s).decl != 0 {
            d: Node = self.node(self.s.sym(s).decl)
            backed = d.kind == Kind.func && (d.ival != 0 || (d.flags & parser.F_INTRINSIC) != 0)
        }
        conversion: bool = s == 0 && n.a != 0 && self.node(n.a).kind == Kind.ident
        expands: bool = s != 0 && self.s.sym(s).kind == sema.SymKind.func && self.s.sym(s).decl != 0 &&
            (self.node(self.s.sym(s).decl).flags & parser.F_INLINE) != 0 // expanded in turn
        if !backed && !conversion && !expands {
            callee: int = 0 // expands in turn, its nodes counted here
            if s != 0 && self.s.sym(s).kind == sema.SymKind.func && self.s.sym(s).decl != 0 { callee = self.auto_inline_decl(s, mut chain, depth) }
            if callee == 0 { return AUTO_INLINE_NODES + 1 }
            grown = callee - 1
        }
    }
    r: int = size + grown + 1
    r = self.auto_inline_size(n.a, r, mut chain, depth)
    r = self.auto_inline_size(n.b, r, mut chain, depth)
    r = self.auto_inline_size(n.c, r, mut chain, depth)
    if n.kind == Kind.for && (n.flags & parser.F_FORGEN) != 0 { r = self.auto_inline_size(n.d, r, mut chain, depth) }
    for i: u32 in 0..n.nkids { r = self.auto_inline_size(self.kid(at, i), r, mut chain, depth) }
    if n.kind == Kind.structlit && !(n.nkids > 0 && self.node(self.kid(at, 0)).text.len == 0) { // C's sema adds the omitted defaults as fields
        u: u32 = self.unwrap(self.nty(at))
        if u != 0 && self.ty(u).kind == TypeKind.struct {
            for i: u32 in 0..self.ty(u).nfields {
                dv: u32 = self.lit_default(at, u, i)
                if dv != 0 { r = self.auto_inline_size(dv, r + 1, mut chain, depth) }
            }
        }
    }
    return r
}

/* Whether a call to function `s` expands though not marked inline. */
/* The expanded node count of symbol `s`'s function + 1 when its declaration
 * may auto-inline wherever it is called, else 0. `chain` holds the
 * declarations being measured: a call cycle back into one stays a call, as
 * C's provisional verdict does.
 */
Lw.auto_inline_decl(self, s: u32, mut chain: [INLINE_CHAIN]u32, depth: usize): int {
    sy: sema.Sym = self.s.sym(s)
    f: u32 = sy.decl
    for i: usize in 0..depth {
        if chain[i] == f { return 0 }
    }
    if depth == chain.len { return 0 } // deeper than any chain within budget
    n: Node = self.node(f)
    if n.kind != Kind.func || n.b == 0 || n.c != 0 || sy.is_extern || sy.is_generic || sy.spec_args != 0 { return 0 }
    if (n.flags & (parser.F_INTRINSIC | parser.F_SPECIALIZED | parser.F_COLD)) != 0 || n.nkids > 64 { return 0 }
    if (n.flags & (parser.F_METHOD | parser.F_ASSOC)) == 0 && mem.equal(n.text, "main") { return 0 }
    for i: u32 in 0..n.nkids {
        if (self.node(self.kid(f, i)).flags & parser.F_NOALIAS) != 0 { return 0 }
    }
    chain[depth] = f
    size: int = self.auto_inline_size(n.b, 0, mut chain, depth + 1)
    if size > AUTO_INLINE_NODES { return 0 }
    return size + 1
}

Lw.auto_inline(self, s: u32): bool {
    if self.debug || self.self_head >= 0 { return false }
    f: u32 = self.s.sym(s).decl
    if f == self.f { return false }
    for e: Expansion in self.inl.view() {
        if e.f == f { return false }
    }
    chain: [INLINE_CHAIN]u32 = blank([INLINE_CHAIN]u32)
    return self.auto_inline_decl(s, mut chain, 0) != 0
}

/* Whether `x` is a direct call of the function being lowered. */
Lw.is_self_call(self, x: u32): bool {
    if x == 0 || self.node(x).kind != Kind.call { return false }
    a: u32 = self.node(x).a
    if a == 0 || (self.node(a).kind != Kind.ident && self.node(a).kind != Kind.selector) { return false }
    s: u32 = self.nsym(x)
    return s != 0 && self.s.sym(s).kind == sema.SymKind.func && self.s.sym(s).decl == self.f
}

/* Whether `at` holds a return of a self call. */
Lw.has_self_tail(self, at: u32): bool {
    if at == 0 { return false }
    n: Node = self.node(at)
    if n.kind == Kind.return { return self.is_self_call(n.a) }
    if n.kind == Kind.func { return false }
    if self.has_self_tail(n.a) || self.has_self_tail(n.b) || self.has_self_tail(n.c) { return true }
    if n.kind == Kind.for && self.has_self_tail(n.d) { return true }
    for i: u32 in 0..n.nkids {
        if self.has_self_tail(self.kid(at, i)) { return true }
    }
    return false
}

/* Whether `at` holds a direct call to an inline function, as C's sema marks
 * a body F_INLCALLS.
 */
Lw.has_inline_call(self, at: u32): bool {
    if at == 0 { return false }
    n: Node = self.node(at)
    if n.kind == Kind.call {
        s: u32 = self.nsym(at)
        if n.a != 0 && self.node(n.a).kind == Kind.index && self.nsym(n.a) != 0 { s = self.nsym(n.a) }
        if s != 0 && self.s.sym(s).kind == sema.SymKind.func && self.s.sym(s).decl != 0 &&
            (self.node(self.s.sym(s).decl).flags & parser.F_INLINE) != 0 { return true }
    }
    if self.has_inline_call(n.a) || self.has_inline_call(n.b) || self.has_inline_call(n.c) || self.has_inline_call(n.d) { return true }
    for i: u32 in 0..n.nkids {
        if self.has_inline_call(self.kid(at, i)) { return true }
    }
    return false
}

/* Whether a local or parameter lives in this frame (a slot): the levels of a
 * self tail recursion could then observe each other's.
 */
Lw.frame_storage(self): bool {
    params: usize = 0 // the stored by-address parameters
    for i: u32 in 0..self.node(self.f).nkids {
        ps: u32 = self.nsym(self.kid(self.f, i))
        if self.by_address(self.f, i) && ps != 0 && self.stored.has(ps) { params += 1 }
    }
    return self.stored.len > params
}

/* A return inside an expansion: the result to the expansion's variable, then
 * the join.
 */
Lw.inline_return(mut self, at: u32) {
    a: u32 = self.node(at).a
    e: Expansion = self.inl.get(self.inl.len - 1)
    if a != 0 && e.dst >= 0 {
        mut self.store_value(a, e.rt, e.dst, 0)
    } else if a != 0 && e.res >= 0 && self.is_agg(e.rt) {
        v: Agg = blank(Agg)
        mut self.value(a, e.rt, mut v)
        for k: int in 0..v.n { mut self.write_var(e.res + k, self.cur, v.v[k]) }
    } else if a != 0 && e.res >= 0 {
        v: int = mut self.expr(a, int(mut self.need_type(e.rt)))
        mut self.write_var(e.res, self.cur, v)
    } else if a != 0 { // `return f()` of a call with no value
        mut self.drop(a)
    }
    mut self.jump(e.join)
}

/* A call to an inline function: its body copied in place. Each argument is
 * evaluated in order and bound to its parameter, a mut parameter or receiver
 * to the argument's own storage and any other to a copy. Each return jumps to
 * a join block, where the result is a variable read: an aggregate's leaves
 * into res, or one of over MAX_LEAVES leaves stored at dst (a new stack object when
 * dst < 0), as a call's.
 */
Lw.inline_call(mut self, x: u32, mut out: Agg, want_out: bool, dst: int): int {
    f: u32, targs: u32, ntargs: u32 = self.inline_target(x)
    if f == 0 || self.node(f).b == 0 {
        mut self.unsupported("inline call")
        return mut self.dummy()
    }
    recursive: bool = f == self.f
    for i: usize in 0..self.inl.len {
        if self.inl.get(i).f == f { recursive = true }
    }
    if recursive {
        mut self.unsupported("recursive inline call")
        return mut self.dummy()
    }
    cn: Node = self.node(x)
    args: array.Array[u32] = array.Array[u32] {} // the receiver included
    defer mut args.wipe()
    recv: bool = self.node(cn.a).kind == Kind.selector && !self.assoc_call(x)
    if recv { fail(mut args.push(self.node(cn.a).a)) } // receiver
    if u32(args.len) + cn.nkids != self.node(f).nkids || self.node(f).nkids > 64 {
        mut self.unsupported("inline call")
        return mut self.dummy()
    }
    for i: u32 in 0..cn.nkids { fail(mut args.push(self.kid(x, i))) }
    rt: u32 = 0
    if self.node(f).a != 0 { rt = self.nty(x) } // the call of a generic method with no result is not typed void
    if rt != 0 && self.kind(rt) == TypeKind.void { rt = 0 }

    fs: u32 = self.nsym(f)
    if self.node(f).c != 0 && !(fs != 0 && self.s.sym(fs).spec_args != 0) { mut self.s.stamp_body(f, targs, ntargs) }
    bind: array.Array[u32] = array.Array[u32] {}
    defer mut bind.wipe()
    body: u32 = mut self.s.copy_body(f, mut bind)
    mut self.scan_walk(body)
    for i: usize in 0..args.len {
        ps: u32 = self.nsym(bind.get(i))
        if ps == 0 {
            mut self.unsupported("unresolved parameter")
            return mut self.dummy()
        }
        a: u32 = args.get(i)
        if self.node(a).kind == Kind.mutarg { a = self.node(a).a }
        if i == 0 && recv {
            // C's sema rewrites a receiver to the place the method takes:
            // *p for a pointer, its embedded field for a promoted method
            ef: int = self.promoting_field(a, self.s.sym(ps).ty)
            if ef >= 0 || self.is_pointer(a) {
                rp: Place = blank(Place)
                if self.is_pointer(a) {
                    rp, _ = mut self.field_base(cn.a)
                } else if self.is_place(a) {
                    rp = mut self.place(a)
                } else {
                    rp = mut self.temp_place(a)
                }
                if ef >= 0 {
                    fd: sema.SField = self.s.field(self.ty(self.recv_struct(a)), u32(ef))
                    rp.off += i32(fd.offset)
                    rp.t = fd.ty
                }
                if rp.var >= 0 && self.unwrap(rp.t) == self.unwrap(self.s.sym(ps).ty) {
                    fail(mut self.var_ix.set(ps, rp.var + 1))
                    continue
                }
                _ = mut self.var_new(ps, ir.IT_VOID, mut self.place_address(rp))
                continue
            }
        }
        if self.by_address(f, u32(i)) && !self.is_place(a) { // a call's result, or a field of one: a new stack object
            _ = mut self.var_new(ps, ir.IT_VOID, mut self.place_address(mut self.temp_place(a)))
            continue
        }
        if self.by_address(f, u32(i)) {
            p: Place = mut self.place(a)
            if p.var >= 0 && self.unwrap(p.t) == self.unwrap(self.s.sym(ps).ty) { // the argument's own variables
                fail(mut self.var_ix.set(ps, p.var + 1))
                continue
            }
            _ = mut self.var_new(ps, ir.IT_VOID, mut self.place_address(p))
            continue
        }
        mut self.init_var(mut self.var_of(ps), ps, a)
    }
    join: int = mut self.new_block()
    res: int = -1
    nres: int = 0
    d: int = dst
    if self.is_big(rt) {
        mut self.covered(rt)
        if d < 0 { d = mut self.new_slot(rt) }
    } else if self.is_agg(rt) {
        d = -1
        lv: ir.Leaves = blank(ir.Leaves)
        nres = mut self.leaves(rt, mut lv)
        for k: int in 0..nres {
            v: int = mut self.var_new(0, lv.v[k].ty, -1)
            if k == 0 { res = v }
        }
    } else {
        d = -1
        if rt != 0 {
            res = mut self.var_new(0, mut self.need_type(rt), -1)
            nres = 1
        }
    }
    fail(mut self.inl.push(Expansion { f = f, rt = rt, join = join, res = res, dst = d }))
    mut self.block(body)
    if self.cur >= 0 { // falling off the end: zero
        for k: int in 0..nres { mut self.write_var(res + k, self.cur, mut self.konst(self.vtype.get(usize(res + k)), 0)) }
        mut self.jump(join)
    }
    mut self.inl.truncate(self.inl.len - 1)
    mut self.seal(join)
    mut self.enter(join)
    if self.cur < 0 || res < 0 { return -1 }
    if !self.is_agg(rt) { return mut self.read_var(res, join) }
    if want_out {
        out.n = nres
        for k: int in 0..nres { out.v[k] = mut self.read_var(res + k, join) }
    }
    return -1
}

/* Whether generic function `s`, named by `x`, has a stamp to link: a written
 * specialization, or the instance whose signature sema recorded on `x` (C's
 * fn_value_mangle succeeding). --ir prints the symbol, not the stamp's name.
 */
Lw.fn_value_named(self, s: u32, x: u32): bool {
    if self.s.sym(s).spec_args != 0 { return true }
    _, found: bool = self.s.inst_args(self.s.sym(s).decl, self.nty(x))
    return found
}

/* A call through a function value: variable `s`, or a struct field when 0. */
Lw.indirect_call(mut self, x: u32, s: u32, mut res: Agg, want_res: bool, dst: int): int {
    cn: Node = self.node(x)
    ft: u32 = 0
    if s != 0 { ft = self.unwrap(self.s.sym(s).ty) } else { ft = self.unwrap(self.nty(cn.a)) }
    if ft == 0 || self.ty(ft).kind != TypeKind.func || cn.nkids != self.ty(ft).nparams {
        mut self.unsupported("indirect call")
        return mut self.dummy()
    }
    f: int = mut self.expr(cn.a, int(ir.IT_PTR))
    g: Args = Args.init()
    defer mut g.wipe()
    for i: u32 in 0..cn.nkids { mut self.call_arg(mut g, self.kid(x, i), self.s.param(self.ty(ft), i), false, false) }
    id: int = mut self.emit(ir.IR_CALLI, mut self.result_type(self.ty(ft).ret))
    mut self.fn.at(id).flags = self.null_checked()
    mut self.fn.arg_add(id, f) // the target, then the arguments
    return mut self.call_finish(id, g, self.ty(ft).ret, mut res, want_res, dst)
}

/* ptr `pv` (of pointer type `pt`) +/- u64 `n` elements of its pointee. */
Lw.pointer_offset(mut self, op: u8, pt: u32, pv: int, n: int): int {
    id: int = mut self.emit2(op, ir.IT_PTR, pv, n)
    x: mut *ir.IrIns = mut self.fn.at(id)
    x.imm = u64(self.ty(self.ty(self.unwrap(pt)).base).size)
    x.flags = self.null_checked()
    return id
}

Lw.is_pointer(self, x: u32): bool {
    u: u32 = self.unwrap(self.nty(x))
    return u != 0 && self.ty(u).kind == TypeKind.ptr
}

Lw.expr(mut self, x: u32, want: int): int {
    if self.failed() { return mut self.dummy() }
    if self.captured.has(x) { return mut self.place_read(mut self.place(x), 0) }
    n: Node = self.node(x)
    switch n.kind {
        Kind.int_lit, Kind.char_lit, Kind.float_lit { return mut self.literal(mut self.type_in(x, want), x, false) }
        Kind.bool { return mut self.konst(mut self.type_in(x, want), n.ival) }
        Kind.ident {
            s: u32 = self.nsym(x)
            if s != 0 {
                sy: sema.Sym = self.s.sym(s)
                init: u32 = self.s.sym_init(s)
                if sy.kind == sema.SymKind.var && sy.is_global && sy.is_const && init != 0 {
                    t: u8 = mut self.type_in(x, want)
                    neg: bool = false
                    if self.node(init).kind == Kind.unary && self.node(init).op == Token.minus {
                        neg = true
                        init = self.node(init).a
                    }
                    k: Kind = self.node(init).kind
                    if k != Kind.int_lit && k != Kind.char_lit && k != Kind.bool && k != Kind.float_lit {
                        return mut self.place_read(mut self.place(x), 0) // a computed one is read from its storage
                    }
                    return mut self.literal(t, init, neg)
                }
                if sy.kind == sema.SymKind.func { // a function value
                    if sy.is_generic || sy.spec_args != 0 || (sy.decl != 0 && self.node(sy.decl).kind == Kind.func && self.node(sy.decl).c != 0) {
                        if !self.fn_value_named(s, x) { // larger[int]
                            mut self.unsupported("generic function value")
                            return mut self.dummy()
                        }
                        return mut self.fn_value_addr(s, x)
                    }
                    return mut self.global_addr(s)
                }
            }
            return mut self.place_read(mut self.place(x), 0)
        }
        Kind.null { // a null pointer or Error
            if want != int(ir.IT_PTR) && want != int(ir.IT_U64) {
                mut self.unsupported(self.type_why(self.nty(x)))
                return mut self.dummy()
            }
            return mut self.konst(u8(want), 0)
        }
        Kind.selector {
            ts: u32 = self.nsym(n.a)
            if ts != 0 && self.s.sym(ts).kind == sema.SymKind.type {
                tt: u32 = self.s.sym(ts).ty
                if tt != 0 && self.kind(tt) == TypeKind.enum { return mut self.konst(mut self.type_in(x, want), self.s.node_ival(x)) } // Color.red
                if tt != 0 && self.ty(tt).kind == TypeKind.error_domain { return mut self.konst(ir.IT_U64, self.s.node_ival(x)) }
                mut self.unsupported(self.type_why(tt))
                return mut self.dummy()
            }
            bt: u32 = self.unwrap(self.nty(n.a))
            et: u32 = bt
            for et != 0 && self.ty(et).kind == TypeKind.ptr { et = self.unwrap(self.ty(et).base) }
            if et != 0 && self.ty(et).kind == TypeKind.error { // Errors #9: the domain above the raw i32 code
                v: int = mut self.deref_value(n.a, ir.IT_U64)
                if mem.equal(n.text, "domain") { return mut self.emit2(ir.IR_SHR, ir.IT_U64, v, mut self.konst(ir.IT_U64, 32)) }
                if mem.equal(n.text, "code") { return mut self.emit2(ir.IR_CAST, ir.IT_I32, v, -1) }
                mut self.unsupported("Error description")
                return mut self.dummy()
            }
            if self.is_view(bt) && mem.equal(n.text, "len") { return mut self.view_leaf(n.a, 1) }
            if bt != 0 && self.ty(bt).kind == TypeKind.array && mem.equal(n.text, "len") {
                if !self.is_place(n.a) { // side effects only: the length is static
                    discard: Agg = blank(Agg)
                    mut self.value(n.a, self.nty(n.a), mut discard)
                }
                return mut self.konst(mut self.type_in(x, want), self.ty(bt).count)
            }
            bits: u32, bfi: u32 = self.bits_field(x)
            if bits != 0 { // a projection of the whole backing value
                bf: sema.SField = self.s.field(self.ty(bits), bfi)
                if (bt != 0 && self.ty(bt).kind == TypeKind.ptr) || self.is_place(n.a) {
                    bp: Place, _ = mut self.field_base(x)
                    return mut self.bits_get(bits, bf, mut self.place_read(bp, 0))
                }
                return mut self.bits_get(bits, bf, mut self.expr(n.a, int(mut self.need_type(bits))))
            }
            if bt == 0 || (self.ty(bt).kind != TypeKind.ptr && self.ty(bt).kind != TypeKind.struct) {
                if bt != 0 { mut self.unsupported(self.type_why(bt)) } else { mut self.unsupported("field access") }
                return mut self.dummy()
            }
            if !self.is_place(x) {
                a: Agg = blank(Agg)
                mut self.field_leaves(x, mut a)
                if a.n == 0 { return mut self.dummy() }
                return a.v[0]
            }
            return mut self.place_read(mut self.place(x), 0)
        }
        Kind.unary {
            t: u8 = mut self.type_in(x, want)
            if n.op == Token.minus {
                k: Kind = self.node(n.a).kind
                if k == Kind.int_lit || k == Kind.float_lit { return mut self.literal(t, n.a, true) }
                return mut self.arith(ir.IR_NEG, t, mut self.expr(n.a, int(t)), -1)
            }
            if n.op == Token.bang || n.op == Token.tilde { return mut self.emit2(ir.IR_NOT, t, mut self.expr(n.a, int(t)), -1) }
            if n.op == Token.amp { return mut self.place_address(mut self.place(n.a)) }
            if n.op == Token.star { return mut self.place_read(mut self.place(x), 0) }
            if n.op == Token.volatile {
                p: Place = mut self.place(n.a)
                if p.var >= 0 {
                    mut self.unsupported("volatile access")
                    return mut self.dummy()
                }
                return mut self.place_read(p, ir.IRF_VOLATILE)
            }
            mut self.unsupported("operator")
            return mut self.dummy()
        }
        Kind.cond {
            none: Agg = blank(Agg)
            return mut self.cond_value(x, want, 0, false, mut none)
        }
        Kind.binary {
            if n.op == Token.and_and || n.op == Token.or_or { return mut self.bool_value(x) }
            op: int = binop_of(n.op)
            if op < 0 {
                mut self.unsupported("operator")
                return mut self.dummy()
            }
            if (op == int(ir.IR_ADD) || op == int(ir.IR_SUB)) && self.is_pointer(n.a) { // p + n, p - n
                pv: int = mut self.expr(n.a, int(ir.IT_PTR))
                pop: u8 = ir.IR_PSUB
                if op == int(ir.IR_ADD) { pop = ir.IR_PADD }
                return mut self.pointer_offset(pop, self.nty(n.a), pv, mut self.expr(n.b, int(ir.IT_U64)))
            }
            if op == int(ir.IR_EQ) || op == int(ir.IR_NE) {
                an: bool = self.node(n.a).kind == Kind.null
                bn: bool = self.node(n.b).kind == Kind.null
                if an != bn {
                    o: u32 = n.a
                    if an { o = n.b }
                    if self.is_view(self.nty(o)) { // Sequences #8: a null view has a null ptr
                        ptr: int = mut self.view_leaf(o, 0)
                        return mut self.emit2(u8(op), ir.IT_BOOL, ptr, mut self.konst(ir.IT_PTR, 0))
                    }
                    if self.is_contract(self.nty(o)) { // Carved #5: a null contract has a null vtable
                        a: Agg = blank(Agg)
                        mut self.value(o, self.nty(o), mut a)
                        if self.failed() { return mut self.dummy() }
                        return mut self.emit2(u8(op), ir.IT_BOOL, a.v[0], mut self.konst(ir.IT_PTR, 0))
                    }
                }
                if self.is_union(self.nty(n.a)) || self.is_union(self.nty(n.b)) { return mut self.union_equal(x, op == int(ir.IR_NE)) }
            }
            if is_compare(op) {
                ot: u8 = mut self.operand_type(x, -1)
                a: int = mut self.expr(n.a, int(ot))
                return mut self.emit2(u8(op), ir.IT_BOOL, a, mut self.expr(n.b, int(ot)))
            }
            t: u8 = mut self.type_in(x, want)
            a: int = mut self.expr(n.a, int(t))
            return mut self.arith(u8(op), t, a, mut self.expr(n.b, int(t)))
        }
        Kind.cmpchain { // every operand once, left to right; the comparisons ANDed
            ot: int = -1
            for i: u32 in 0..n.nkids {
                if ot >= 0 { break }
                kt: u32 = self.nty(self.kid(x, i))
                if !self.is_untyped(kt) { ot = int(mut self.need_type(kt)) }
            }
            if ot < 0 {
                mut self.unsupported("untyped constant")
                return mut self.dummy()
            }
            prev: int = mut self.expr(self.kid(x, 0), ot)
            acc: int = -1
            for i: u32 in 1..n.nkids {
                v: int = mut self.expr(self.kid(x, i), ot)
                cop: int = binop_of(self.node(self.kid(n.a, i - 1)).op)
                c: int = mut self.emit2(u8(cop), ir.IT_BOOL, prev, v)
                if acc < 0 { acc = c } else { acc = mut self.emit2(ir.IR_AND, ir.IT_BOOL, acc, c) }
                prev = v
            }
            return acc
        }
        Kind.call {
            res: Agg = blank(Agg)
            return mut self.call(x, want, mut res, false, -1)
        }
        Kind.index {
            if self.nsym(x) != 0 { // larger[int] as a value
                if !self.fn_value_named(self.nsym(x), x) {
                    mut self.unsupported("generic function value")
                    return mut self.dummy()
                }
                return mut self.fn_value_addr(self.nsym(x), x)
            }
            return mut self.place_read(mut self.place(x), 0)
        }
        Kind.slice {
            mut self.unsupported(self.type_why(self.nty(x)))
            return mut self.dummy()
        }
        Kind.structlit { // a bits value (#5): all bits zero, then each field in source order
            b: u32 = self.unwrap(self.nty(x))
            if b == 0 || self.ty(b).kind != TypeKind.bits {
                mut self.unsupported(self.type_why(b))
                return mut self.dummy()
            }
            w: int = mut self.konst(mut self.need_type(b), 0)
            for i: u32 in 0..n.nkids {
                k: Node = self.node(self.kid(x, i))
                fi: int = self.find_field(b, k.text)
                if fi < 0 {
                    mut self.unsupported("field initializer")
                    return mut self.dummy()
                }
                f: sema.SField = self.s.field(self.ty(b), u32(fi))
                w = mut self.bits_set(b, f, w, mut self.expr(k.a, int(mut self.need_type(f.ty))), false) // each field once (#5)
            }
            return w
        }
        default {
            if self.is_untyped(self.nty(x)) { mut self.unsupported("expression form") } else { mut self.unsupported(self.type_why(self.nty(x))) }
            return mut self.dummy()
        }
    }
}

/* The leaves of `x` at type `t` into `out`. */
Lw.value(mut self, at: u32, t: u32, mut out: Agg) {
    if self.captured.has(at) && self.is_agg(t) {
        mut self.place_get(mut self.place(at), 0, mut out)
        return
    }
    x: u32 = self.array_cast_arg(at)
    if !self.is_agg(t) {
        out.n = 1
        out.v[0] = mut self.expr(x, int(mut self.need_type(t)))
        return
    }
    n: Node = self.node(x)
    if self.is_view(t) {
        lit: u32 = self.string_of(x)
        if lit != 0 {
            mut self.string_bytes(self.node(lit).text, mut out)
            return
        }
        if n.kind == Kind.arraylit && self.s.node_view(x) != 0 { // an array literal viewed as []T
            mut self.literal_view(x, mut out)
            return
        }
        if n.kind == Kind.null { // Sequences #8: the null view
            out.n = 2
            out.v[0] = mut self.konst(ir.IT_PTR, 0)
            out.v[1] = mut self.konst(ir.IT_U64, 0)
            return
        }
        if n.kind == Kind.call && self.nsym(x) == 0 && n.a != 0 && (self.node(n.a).kind == Kind.ident || self.node(n.a).kind == Kind.slice_t) && n.nkids == 1 && self.is_view(self.nty(self.kid(x, 0))) {
            mut self.value(self.kid(x, 0), t, mut out) // string(b), []u8(s): one type (Types #19)
            return
        }
        at: u32 = self.unwrap(self.nty(x))
        if at != 0 && self.ty(at).kind == TypeKind.array { // an array viewed whole
            out.n = 2
            out.v[0] = mut self.place_address(mut self.array_place(x))
            out.v[1] = mut self.konst(ir.IT_U64, self.ty(at).count)
            return
        }
    }
    if n.kind == Kind.cond {
        _ = mut self.cond_value(x, 0, t, true, mut out)
        return
    }
    if self.is_contract(t) && n.kind == Kind.null { // Carved #5: the null contract, all bits zero
        out.n = 2
        out.v[0] = mut self.konst(ir.IT_PTR, 0)
        out.v[1] = out.v[0]
        return
    }
    if n.kind == Kind.selector && self.is_view(t) {
        if mut self.error_description(x, mut out) { return }
        if mut self.enum_name(x, mut out) { return }
    }
    if self.is_union(t) {
        ctor: bool, _, _ = self.union_ctor(x)
        if ctor { // built in a stack object, then read as leaves
            mut self.covered(t)
            slot: int = mut self.new_slot(t)
            mut self.union_store(x, t, slot, 0)
            mut self.place_get(Place { addr = slot, t = t }, 0, mut out)
            return
        }
    }
    if self.has_union(t) && (n.kind == Kind.structlit || n.kind == Kind.tuple || n.kind == Kind.arraylit) {
        mut self.covered(t) // built in a stack object, then read as leaves
        slot: int = mut self.new_slot(t)
        mut self.store_value(x, t, slot, 0)
        mut self.place_get(Place { addr = slot, t = t }, 0, mut out)
        return
    }
    switch n.kind {
        Kind.structlit, Kind.tuple {
            mut self.literal_agg(x, t, mut out)
            return
        }
        Kind.arraylit {
            mut self.literal_array(x, t, mut out)
            return
        }
        Kind.slice {
            mut self.slice_leaves(x, mut out)
            return
        }
        Kind.call {
            _ = mut self.call(x, -1, mut out, true, -1)
            if out.n != mut self.leaf_count(t) { mut self.unsupported("conversion") }
            return
        }
        Kind.selector {
            if !self.is_place(x) {
                mut self.field_leaves(x, mut out)
                return
            }
        }
        Kind.ident, Kind.unary, Kind.index {}
        default {
            mut self.unsupported(self.type_why(t))
            out.n = 0
            return
        }
    }
    if !self.is_place(x) {
        mut self.unsupported(self.type_why(t))
        out.n = 0
        return
    }
    mut self.place_get(mut self.place(x), 0, mut out)
}

/* Branches on `x` to block `t` when true, `f` when false. */
Lw.cond(mut self, x: u32, t: int, f: int) {
    if self.cur < 0 { return }
    n: Node = self.node(x)
    if n.kind == Kind.unary && n.op == Token.bang {
        mut self.cond(n.a, f, t)
        return
    }
    if n.kind == Kind.binary && (n.op == Token.and_and || n.op == Token.or_or) {
        mid: int = mut self.new_block()
        if n.op == Token.and_and { mut self.cond(n.a, mid, f) } else { mut self.cond(n.a, t, mid) }
        mut self.seal(mid)
        mut self.enter(mid)
        mut self.cond(n.b, t, f)
        return
    }
    if n.kind == Kind.cond { // each branch tests itself: no bool is materialized
        then: int, els: int, _ = mut self.cond_split(x)
        mut self.enter(then)
        mut self.cond(n.b, t, f)
        mut self.enter(els)
        mut self.cond(n.c, t, f)
        return
    }
    if n.kind == Kind.bool {
        if n.ival != 0 { mut self.jump(t) } else { mut self.jump(f) }
        return
    }
    v: int = mut self.expr(x, int(ir.IT_BOOL))
    mut self.terminate(ir.IR_BR, v, t, f)
}

// --- statements -------------------------------------------------------------

/* Leaving the block by its end runs the defers it captured (Deferred calls #2). */
Lw.block(mut self, b: u32) {
    floor: usize = self.defers.len
    n: Node = self.node(b)
    for i: u32 in 0..n.nkids {
        if self.cur < 0 { break }
        mut self.stmt(self.kid(b, i))
    }
    if self.cur >= 0 { mut self.run_defers(floor) }
    mut self.defers.truncate(floor)
}

/* main's allocator leak report (Safety & Debug Builds #9). */
Lw.leaks_check(mut self) {
    if !self.is_main || !self.debug { return }
    id: int = mut self.emit(ir.IR_CALL, ir.IT_VOID)
    mut self.fn.at(id).name = "__ace$registry_leaks"
}

Lw.ret(mut self, a: Agg) {
    mut self.run_defers(0)
    mut self.leaks_check()
    id: int = mut self.emit(ir.IR_RET, ir.IT_VOID)
    for k: int in 0..a.n { mut self.fn.arg_add(id, a.v[k]) }
    self.cur = -1
}

/* A variable's leaves: its SSA variables, or stored at its home. */
Lw.set_leaves(mut self, var: int, t: u32, a: Agg) {
    if self.home.get(usize(var)) == -1 {
        for k: int in 0..a.n { mut self.write_var(var + k, self.cur, a.v[k]) }
        return
    }
    lv: ir.Leaves = blank(ir.Leaves)
    _ = mut self.leaves(t, mut lv)
    addr: int = mut self.var_addr(var)
    for k: int in 0..a.n { mut self.store(addr, i32(lv.v[k].off), a.v[k], 0) }
}

Lw.target(mut self, s: u32, is_continue: bool): int {
    n: Node = self.node(s)
    labeled: bool = (n.flags & parser.F_TEXT) != 0
    i: int = int(self.tgt.len) - 1
    for i >= 0 {
        t: Target = self.tgt.get(usize(i))
        if labeled {
            if t.has_label && mem.equal(t.label, n.text) { return i }
        } else if t.cont >= 0 {
            return i
        }
        i -= 1
    }
    if is_continue { mut self.unsupported("continue target") } else { mut self.unsupported("break target") }
    return -1
}

Lw.push_target(mut self, s: u32, brk: int, cont: int, restart: int) {
    n: Node = self.node(s)
    fail(mut self.tgt.push(Target { label = n.text, has_label = (n.flags & parser.F_TEXT) != 0, brk = brk, cont = cont, restart = restart, ndefers = self.defers.len }))
}

/* `e` evaluated for its effects, its value dropped. */
Lw.drop(mut self, e: u32) {
    t: u32 = self.nty(e)
    if self.is_agg(t) {
        discard: Agg = blank(Agg)
        mut self.value(e, t, mut discard)
    } else {
        _ = mut self.expr(e, -1)
    }
}

Lw.is_discard(self, x: u32): bool {
    n: Node = self.node(x)
    return n.kind == Kind.ident && mem.equal(n.text, "_")
}

/* Whether `x` contains a call, which could change storage the rest reads. */
Lw.has_call(self, x: u32): bool {
    if x == 0 { return false }
    n: Node = self.node(x)
    if n.kind == Kind.call { return true }
    if self.has_call(n.a) || self.has_call(n.b) || self.has_call(n.c) { return true }
    for i: u32 in 0..n.nkids {
        if self.has_call(self.kid(x, i)) { return true }
    }
    return false
}

/* The place of new binder (a param node) `b`: its SSA variable, or its memory. */
Lw.binder_place(mut self, b: u32): Place {
    bs: u32 = self.nsym(b)
    if bs == 0 {
        mut self.unsupported("unresolved binder")
        return Place { addr = mut self.dummy() }
    }
    t: u32 = self.s.sym(bs).ty
    var: int = mut self.var_of(bs)
    if self.home.get(usize(var)) == -1 { return Place { var = var, t = t } }
    return Place { addr = mut self.var_addr(var), t = t }
}

/* Member `m` into `x`, an existing place or a bits field. */
Lw.member_put(mut self, x: u32, m: Agg) {
    bits: u32, _ = self.bits_field(x)
    if bits != 0 {
        mut self.bits_assign(x, Token.assign, 0, m.v[0])
        return
    }
    p: Place = mut self.place(x)
    if mut self.leaf_count(p.t) != m.n { mut self.unsupported("destructuring") }
    mut self.place_put(p, m, 0)
}

/* Tuple destructuring (Errors #12): the right side once, then each member
 * into a new binder or an existing place, the first `n` kids of `owner`, in
 * order; a `_` member is dropped. A tuple of over MAX_LEAVES leaves is stored whole
 * first, then its members copied out.
 */
Lw.destructure(mut self, owner: u32, n: u32, rhs: u32) {
    tt: u32 = self.nty(rhs)
    u: u32 = self.unwrap(tt)
    if u == 0 || self.ty(u).kind != TypeKind.tuple || self.ty(u).nfields != n {
        mut self.unsupported("destructuring")
        return
    }
    ut: SType = self.ty(u)
    rn: Node = self.node(rhs)
    if rn.kind == Kind.tuple && rn.nkids == n && ir.leaf_count(*self.s, tt) < 0 {
        // `a: int, b: string = 1, "x"`: untyped elements take their targets'
        // types; every element is evaluated before any target is written
        m: array.Array[Agg] = array.Array[Agg] {}
        defer mut m.wipe()
        for i: u32 in 0..n {
            k: u32 = self.kid(owner, i)
            kt: u32 = 0
            if self.node(k).kind == Kind.param {
                if self.nsym(k) != 0 { kt = self.s.sym(self.nsym(k)).ty }
            } else if self.is_discard(k) {
                kt = self.nty(self.kid(rhs, i))
            } else {
                kt = self.nty(k)
            }
            if kt == 0 || self.by_parts(kt) {
                mut self.unsupported("destructuring")
                return
            }
            a: Agg = blank(Agg)
            mut self.value(self.kid(rhs, i), kt, mut a)
            fail(mut m.push(a))
        }
        for i: u32 in 0..n {
            k: u32 = self.kid(owner, i)
            if self.is_discard(k) { continue }
            if self.node(k).kind == Kind.param {
                bs: u32 = self.nsym(k)
                mut self.set_leaves(mut self.var_of(bs), self.s.sym(bs).ty, m.get(usize(i)))
                continue
            }
            mut self.member_put(k, m.get(usize(i)))
        }
        return
    }
    if self.by_parts(tt) {
        mut self.covered(tt)
        slot: int = mut self.new_slot(tt)
        mut self.store_value(rhs, tt, slot, 0)
        for i: u32 in 0..n {
            k: u32 = self.kid(owner, i)
            if self.is_discard(k) { continue }
            f: sema.SField = self.s.field(ut, i)
            src: Place = Place { addr = slot, off = i32(f.offset), t = f.ty }
            bits: u32, _ = self.bits_field(k)
            if bits != 0 {
                mut self.bits_assign(k, Token.assign, 0, mut self.place_read(src, 0))
                continue
            }
            dst: Place = blank(Place)
            if self.node(k).kind == Kind.param { dst = mut self.binder_place(k) } else { dst = mut self.place(k) }
            mut self.move_place(dst, src)
        }
        return
    }
    all: Agg = blank(Agg)
    mut self.value(rhs, tt, mut all)
    for i: u32 in 0..n {
        if self.failed() { return }
        m: Agg = blank(Agg)
        at: int = mut self.leaf_index(u, i)
        m.n = mut self.leaf_count(self.s.field(ut, i).ty)
        if self.failed() { return }
        for k: int in 0..m.n { m.v[k] = all.v[at + k] }
        kid: u32 = self.kid(owner, i)
        if self.is_discard(kid) { continue }
        if self.node(kid).kind == Kind.param {
            bs: u32 = self.nsym(kid)
            if bs == 0 {
                mut self.unsupported("unresolved binder")
                return
            }
            if mut self.leaf_count(self.s.sym(bs).ty) != m.n {
                mut self.unsupported("destructuring")
                return
            }
            mut self.set_leaves(mut self.var_of(bs), self.s.sym(bs).ty, m)
            continue
        }
        mut self.member_put(kid, m)
    }
}

Lw.assign(mut self, at: u32) {
    s: Node = self.node(at)
    x: u32 = self.kid(at, 0)
    if s.nkids == 1 && self.is_discard(x) { // `_ = f()`: evaluated, dropped
        mut self.drop(s.a)
        return
    }
    if s.nkids > 1 {
        if s.op != Token.assign || (s.flags & parser.F_VOLATILE) != 0 {
            mut self.unsupported("assignment target")
            return
        }
        mut self.destructure(at, s.nkids, s.a)
        return
    }
    bits: u32, _ = self.bits_field(x)
    if bits != 0 { // a read-modify-write of its backing value
        mut self.bits_assign(x, s.op, s.a, -1)
        return
    }
    // the right side whole, then the target (Memory #9): a right side that
    // moves the target's storage cannot leave its address stale
    vol: u8 = 0
    if (s.flags & parser.F_VOLATILE) != 0 { vol = ir.IRF_VOLATILE }
    xt: u32 = self.nty(x)
    if self.node(x).kind == Kind.ident && self.nsym(x) != 0 { xt = self.s.sym(self.nsym(x)).ty }
    if self.is_agg(xt) {
        if s.op != Token.assign {
            mut self.unsupported("compound assignment")
            return
        }
        direct: bool = vol == 0 && (self.is_big(xt) || (self.has_array(xt) && self.is_place(s.a)))
        if direct && self.is_place(s.a) && (self.node(x).kind == Kind.ident || !self.has_call(x)) {
            // a place's bytes: equal or disjoint, and finding the target
            // cannot change them
            p: Place = mut self.place(x)
            if p.var < 0 {
                mut self.store_value(s.a, p.t, p.addr, p.off)
                return
            }
            a: Agg = blank(Agg)
            mut self.value(s.a, p.t, mut a)
            mut self.place_put(p, a, vol)
            return
        }
        if direct && self.is_big(xt) { // whole, before any byte is written
            mut self.covered(xt)
            src: int = mut self.new_slot(xt)
            mut self.store_value(s.a, xt, src, 0)
            p: Place = mut self.place(x)
            if p.var < 0 {
                mut self.copy_mem(p.addr, p.off, src, 0, 0, self.size(xt))
            } else {
                mut self.move_place(p, Place { addr = src, t = xt })
            }
            return
        }
        a: Agg = blank(Agg)
        mut self.value(s.a, xt, mut a) // whole, before any leaf is written
        p: Place = mut self.place(x)
        if vol != 0 && p.var >= 0 {
            mut self.unsupported("volatile access")
            return
        }
        mut self.place_put(p, a, vol)
        return
    }
    t: u8 = mut self.need_type(xt)
    v: int = 0
    if s.op == Token.assign || t != ir.IT_PTR { v = mut self.expr(s.a, int(t)) } else { v = mut self.expr(s.a, int(ir.IT_U64)) }
    p: Place = mut self.place(x)
    if vol != 0 && p.var >= 0 {
        mut self.unsupported("volatile access")
        return
    }
    if s.op != Token.assign {
        op: int = binop_of(s.op)
        if op < 0 {
            mut self.unsupported("compound assignment")
            return
        }
        old: int = mut self.place_read(p, vol)
        if t == ir.IT_PTR && (op == int(ir.IR_ADD) || op == int(ir.IR_SUB)) { // p += n, p -= n
            pop: u8 = ir.IR_PSUB
            if op == int(ir.IR_ADD) { pop = ir.IR_PADD }
            v = mut self.pointer_offset(pop, p.t, old, v)
        } else {
            v = mut self.arith(u8(op), t, old, v)
        }
    }
    mut self.place_write(p, v, vol)
}

/* Local `sym`'s variable `var`, initialized to `x`. */
Lw.init_var(mut self, var: int, sym: u32, x: u32) {
    t: u32 = self.s.sym(sym).ty
    if self.home.get(usize(var)) != -1 && self.in_memory(t) { // into its memory, which the value cannot name
        mut self.store_value(x, t, mut self.var_addr(var), 0)
        return
    }
    a: Agg = blank(Agg)
    mut self.value(x, t, mut a)
    mut self.set_leaves(var, t, a)
}

Lw.var_decl(mut self, at: u32) {
    s: Node = self.node(at)
    if s.nkids != 1 || self.node(self.kid(at, 0)).kind != Kind.param || (s.flags & parser.F_MIXED) != 0 {
        if s.b == 0 {
            mut self.unsupported("multiple binders")
            return
        }
        for i: u32 in 0..s.nkids { // make each new binder's variable
            k: u32 = self.kid(at, i)
            if self.node(k).kind == Kind.param && self.nsym(k) != 0 { _ = mut self.var_of(self.nsym(k)) }
        }
        mut self.destructure(at, s.nkids, s.b)
        return
    }
    sym: u32 = self.nsym(self.kid(at, 0))
    if sym == 0 {
        mut self.unsupported("unresolved binder")
        return
    }
    var: int = mut self.var_of(sym)
    if s.b == 0 { return } // assigned before any read (definite initialization)
    mut self.init_var(var, sym, s.b)
}

/* The body of a loop; continue reaches the block current on return, which
 * the caller finishes with the step back to the head.
 */
Lw.loop_body(mut self, at: u32, exit: int, stmts: u32) {
    post: int = mut self.new_block()
    mut self.push_target(at, exit, post, -1)
    if self.cur >= 0 { mut self.block(stmts) }
    mut self.tgt.truncate(self.tgt.len - 1)
    mut self.jump(post)
    mut self.seal(post)
    mut self.enter(post)
}

/* for i: T in a .. b [step c] (Iterations #4-5): the endpoints once, in
 * order, then the step; every selected value in order from a toward b.
 * Ascending by one from a constant start to a constant not below it, or from
 * zero to an unsigned end, runs the cursor up to the end; any other range
 * counts (|b - a| - 1) / step + 1 values from its first, stepping down when
 * a > b from the last value the lower endpoint's stepping selects.
 */
Lw.range_loop(mut self, at: u32) {
    s: Node = self.node(at)
    r: u32 = s.b
    rn: Node = self.node(r)
    bs: u32 = 0 // `for 0 .. n` has no binder
    if s.nkids > 0 { bs = self.nsym(self.kid(at, 0)) }
    if s.nkids > 1 || (s.nkids > 0 && bs == 0) {
        mut self.unsupported("range binders")
        return
    }
    var: int = -1
    if bs != 0 { var = mut self.var_of(bs) }
    rt: u8 = 0
    if bs != 0 && self.is_untyped(self.nty(r)) { rt = mut self.need_type(self.s.sym(bs).ty) } else { rt = mut self.need_type(self.nty(r)) } // endpoints at the binder's type
    bt: u8 = rt
    if bs != 0 { bt = mut self.need_type(self.s.sym(bs).ty) }
    sig: bool = ir.type_signed(rt)
    lo: int = mut self.expr(rn.a, int(rt))
    hi: int = mut self.expr(rn.b, int(rt))
    if self.failed() { return }
    lk: ir.IrIns = self.fn.at(lo)
    hk: ir.IrIns = self.fn.at(hi)
    step_one: bool = rn.c == 0 || (self.node(rn.c).kind == Kind.int_lit && self.node(rn.c).ival == 1)
    up: bool = false
    if step_one && lk.op == ir.IR_CONST {
        if hk.op == ir.IR_CONST {
            if sig { up = i64(lk.imm) <= i64(hk.imm) } else { up = lk.imm <= hk.imm }
        } else {
            up = !sig && lk.imm == 0
        }
    }
    cur: int = mut self.var_new(0, rt, -1)
    cnt: int = -1
    stp: int = -1
    if !up {
        cnt = mut self.var_new(0, ir.IT_U64, -1)
        stp = mut self.var_new(0, ir.IT_U64, -1)
    }
    head: int = mut self.new_block()
    body: int = mut self.new_block()
    exit: int = mut self.new_block()
    if up {
        mut self.write_var(cur, self.cur, lo)
    } else {
        wt: u8 = ir.IT_U64 // 64-bit endpoints, then u64 arithmetic
        if sig { wt = ir.IT_I64 }
        step: int = 0
        if rn.c != 0 { step = mut self.expr(rn.c, int(rt)) } else { step = mut self.konst(rt, 1) }
        if rn.c != 0 && self.node(rn.c).kind != Kind.int_lit && self.debug {
            // sema rejects a non-positive constant step; only a runtime-computed
            // step needs checking here
            ok: int = 0
            if sig { ok = mut self.emit2(ir.IR_GT, ir.IT_BOOL, step, mut self.konst(rt, 0)) } else { ok = mut self.emit2(ir.IR_NE, ir.IT_BOOL, step, mut self.konst(rt, 0)) }
            id: int = mut self.emit2(ir.IR_CHECK, ir.IT_VOID, ok, -1)
            c: mut *ir.IrIns = mut self.fn.at(id)
            c.name = "range step violation"
            c.has_name = true
            c.at = rn.c
        }
        a: int = mut self.widen(lo, rt, wt)
        b: int = mut self.widen(hi, rt, wt)
        ua: int = mut self.widen(a, wt, ir.IT_U64)
        ub: int = mut self.widen(b, wt, ir.IT_U64)
        st: int = mut self.widen(mut self.widen(step, rt, wt), wt, ir.IT_U64)
        nonempty: int = mut self.new_block()
        empty: int = mut self.new_block()
        asc: int = mut self.new_block()
        desc: int = mut self.new_block()
        setup: int = mut self.new_block()
        mut self.terminate(ir.IR_BR, mut self.emit2(ir.IR_EQ, ir.IT_BOOL, a, b), empty, nonempty)
        mut self.seal(empty)
        mut self.seal(nonempty)
        mut self.enter(empty)
        mut self.write_var(cnt, self.cur, mut self.konst(ir.IT_U64, 0))
        mut self.write_var(cur, self.cur, mut self.konst(rt, 0))
        mut self.write_var(stp, self.cur, mut self.konst(ir.IT_U64, 0))
        mut self.jump(setup)
        mut self.enter(nonempty)
        mut self.terminate(ir.IR_BR, mut self.emit2(ir.IR_GT, ir.IT_BOOL, a, b), desc, asc)
        mut self.seal(asc)
        mut self.seal(desc)
        mut self.enter(asc)
        one: int = mut self.konst(ir.IT_U64, 1)
        q: int = mut self.emit2(ir.IR_DIV, ir.IT_U64, mut self.emit2(ir.IR_SUB, ir.IT_U64, mut self.emit2(ir.IR_SUB, ir.IT_U64, ub, ua), one), st)
        mut self.write_var(cnt, self.cur, mut self.emit2(ir.IR_ADD, ir.IT_U64, q, one))
        mut self.write_var(cur, self.cur, lo)
        mut self.write_var(stp, self.cur, st)
        mut self.jump(setup)
        mut self.enter(desc)
        one = mut self.konst(ir.IT_U64, 1)
        q = mut self.emit2(ir.IR_DIV, ir.IT_U64, mut self.emit2(ir.IR_SUB, ir.IT_U64, mut self.emit2(ir.IR_SUB, ir.IT_U64, ua, ub), one), st)
        first: int = mut self.emit2(ir.IR_ADD, ir.IT_U64, ub, mut self.emit2(ir.IR_MUL, ir.IT_U64, q, st))
        mut self.write_var(cnt, self.cur, mut self.emit2(ir.IR_ADD, ir.IT_U64, q, one))
        mut self.write_var(cur, self.cur, mut self.widen(first, ir.IT_U64, rt))
        mut self.write_var(stp, self.cur, mut self.emit2(ir.IR_NEG, ir.IT_U64, st, -1))
        mut self.jump(setup)
        mut self.seal(setup)
        mut self.enter(setup)
    }
    mut self.jump(head)
    mut self.enter(head)
    more: int = 0
    if up {
        more = mut self.emit2(ir.IR_LT, ir.IT_BOOL, mut self.read_var(cur, head), hi)
    } else {
        c: int = mut self.read_var(cnt, head)
        more = mut self.emit2(ir.IR_NE, ir.IT_BOOL, c, mut self.konst(ir.IT_U64, 0))
    }
    mut self.terminate(ir.IR_BR, more, body, exit)
    mut self.seal(body)
    mut self.enter(body)
    if bs != 0 { mut self.set_var(var, mut self.widen(mut self.read_var(cur, body), rt, bt)) }
    mut self.loop_body(at, exit, s.c)
    if self.cur >= 0 { // the cursor wraps past the last value, which no iteration reads
        v: int = mut self.read_var(cur, self.cur)
        if up {
            v = mut self.emit2(ir.IR_ADD, rt, v, mut self.konst(rt, 1))
        } else {
            v = mut self.widen(v, rt, ir.IT_U64)
            v = mut self.emit2(ir.IR_ADD, ir.IT_U64, v, mut self.read_var(stp, self.cur))
            v = mut self.widen(v, ir.IT_U64, rt)
            left: int = mut self.read_var(cnt, self.cur)
            mut self.write_var(cnt, self.cur, mut self.emit2(ir.IR_SUB, ir.IT_U64, left, mut self.konst(ir.IT_U64, 1)))
        }
        mut self.write_var(cur, self.cur, v)
        mut self.jump(head)
    }
    mut self.seal(head)
    mut self.seal(exit)
    mut self.enter(exit)
}

/* for v: T in seq, for i: usize, v: T in seq, and either under `in mut`
 * (Iterations #7-10): the sequence's pointer and length fixed at entry, a
 * pointer running from the start to the end, bumped by the element size. The
 * value binder is a copy of the element at the pointer, or under `in mut` an
 * alias of it; the index binder counts from zero. No bounds checks.
 */
Lw.seq_loop(mut self, at: u32) {
    s: Node = self.node(at)
    if s.nkids < 1 || s.nkids > 2 {
        mut self.unsupported("sequence binders")
        return
    }
    vb: u32 = self.kid(at, s.nkids - 1)
    ib: u32 = 0
    if s.nkids == 2 { ib = self.kid(at, 0) }
    vs: u32 = self.nsym(vb)
    is: u32 = 0
    if ib != 0 { is = self.nsym(ib) }
    if vs == 0 || (ib != 0 && is == 0) {
        mut self.unsupported("unresolved binder")
        return
    }
    is_mut: bool = (s.flags & parser.F_MUT) != 0
    st: u32 = self.unwrap(self.nty(s.b))
    et: u32 = 0
    ptr: int = -1
    len: int = -1
    if st != 0 && self.ty(st).kind == TypeKind.array { // its place's address and its fixed length
        et = self.ty(st).base
        ptr = mut self.place_address(mut self.array_place(s.b))
        len = mut self.konst(ir.IT_U64, self.ty(st).count)
    } else {
        if !self.is_view(st) {
            mut self.unsupported(self.type_why(st))
            return
        }
        et = self.view_elem(st)
        ptr, len = mut self.view_parts(s.b, true)
    }
    if self.failed() { return }
    esz: u32 = self.size(et)
    end: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, ptr, len)
    mut self.fn.at(end).imm = u64(esz)
    cur: int = mut self.var_new(0, ir.IT_PTR, -1)
    ix: int = -1
    if is != 0 { ix = mut self.var_new(0, ir.IT_U64, -1) }
    alias: int = -1
    if is_mut { // the binder lives at the element's address, which changes each iteration
        alias = mut self.var_new(0, ir.IT_PTR, -1)
        _ = mut self.var_new(vs, ir.IT_VOID, ADDR_VAR - alias)
    }
    mut self.write_var(cur, self.cur, ptr)
    if is != 0 { mut self.write_var(ix, self.cur, mut self.konst(ir.IT_U64, 0)) }
    head: int = mut self.new_block()
    body: int = mut self.new_block()
    exit: int = mut self.new_block()
    mut self.jump(head)
    mut self.enter(head)
    mut self.terminate(ir.IR_BR, mut self.emit2(ir.IR_LT, ir.IT_BOOL, mut self.read_var(cur, head), end), body, exit)
    mut self.seal(body)
    mut self.enter(body)
    p: int = mut self.read_var(cur, body)
    if is_mut {
        mut self.write_var(alias, self.cur, p)
    } else {
        mut self.move_place(mut self.binder_place(vb), Place { addr = p, t = et })
    }
    if is != 0 {
        g: Agg = blank(Agg)
        g.n = 1
        g.v[0] = mut self.read_var(ix, self.cur)
        bt: u8 = mut self.need_type(self.s.sym(is).ty) // an [E]T index binds as E
        if bt != ir.IT_U64 { g.v[0] = mut self.emit2(ir.IR_CAST, bt, g.v[0], -1) }
        mut self.set_leaves(mut self.var_of(is), self.s.sym(is).ty, g)
    }
    mut self.loop_body(at, exit, s.c)
    if self.cur >= 0 {
        a: int = mut self.read_var(cur, self.cur)
        next: int = mut self.emit2(ir.IR_PADD, ir.IT_PTR, a, mut self.konst(ir.IT_U64, 1))
        mut self.fn.at(next).imm = u64(esz)
        mut self.write_var(cur, self.cur, next)
        if is != 0 {
            i: int = mut self.read_var(ix, self.cur)
            mut self.write_var(ix, self.cur, mut self.emit2(ir.IR_ADD, ir.IT_U64, i, mut self.konst(ir.IT_U64, 1)))
        }
        mut self.jump(head)
    }
    mut self.seal(head)
    mut self.seal(exit)
    mut self.enter(exit)
}

/* The payload binders of a union switch's case `c`, each a copy of its
 * variant's payload at `addr`.
 */
Lw.union_binders(mut self, c: u32, ut: u32, addr: int) {
    x: SType = self.ty(ut)
    for j: u32 in 0..self.node(c).nkids {
        pat: u32 = self.kid(c, j)
        if self.node(pat).kind != Kind.varpat || self.node(pat).b == 0 { continue }
        vi: u64 = self.s.node_ival(pat)
        if vi >= u64(x.nfields) { continue }
        pt: u32 = self.s.field(x, u32(vi)).ty
        if pt == 0 { continue }
        mut self.move_place(mut self.binder_place(self.node(pat).b), Place { addr = addr, off = i32(self.payload_off(ut)), t = pt })
    }
}

/* switch on a scalar (Conditions #2): the scrutinee once, then each pattern
 * in source order against it, a chain of branches to the first matching
 * case, else to the default or past the switch. A case ends past the switch,
 * or, when its last statement is `fallthrough`, in the next case. On a union
 * the scrutinee is its tag, loaded once from the union's address, and an
 * arm's binder is a copy of the payload made where the arm is entered.
 */
Lw.switch_stmt(mut self, at: u32) {
    s: Node = self.node(at)
    st: u32 = self.nty(s.a)
    un: bool = self.is_union(st)
    addr: int = -1
    t: u8 = ir.IT_I32
    v: int = 0
    if un {
        addr = mut self.union_addr(s.a, st)
        v = mut self.load(ir.IT_I32, addr, 0, 0)
    } else {
        t = mut self.need_type(st)
        v = mut self.expr(s.a, int(t))
    }
    if self.failed() { return }
    n: u32 = s.nkids
    ntests: u32 = 0
    dflt: int = -1
    for i: u32 in 0..n {
        c: Node = self.node(self.kid(at, i))
        if (c.flags & parser.F_DEFAULT) != 0 { dflt = int(i) } else { ntests += c.nkids }
    }
    end: int = mut self.new_block()
    body: array.Array[int] = array.Array[int] {}
    defer mut body.wipe()
    for 0..n { fail(mut body.push(mut self.new_block())) }
    miss: int = end
    if dflt >= 0 { miss = body.get(usize(dflt)) }
    if ntests == 0 { mut self.jump(miss) }
    k: u32 = 0
    for i: u32 in 0..n {
        c: u32 = self.kid(at, i)
        if (self.node(c).flags & parser.F_DEFAULT) != 0 { continue }
        for j: u32 in 0..self.node(c).nkids {
            k += 1
            last: bool = k == ntests
            next: int = miss
            if !last { next = mut self.new_block() }
            pat: u32 = self.kid(c, j)
            if self.node(pat).kind == Kind.range { // lo <= v < hi as one unsigned compare: v - lo < hi - lo
                r: Node = self.node(pat)
                ra: u32 = r.a
                rb: u32 = r.b
                if self.s.node_ival(pat) != 0 { // a descending range, its bounds swapped by sema
                    ra = r.b
                    rb = r.a
                }
                lo: int = mut self.expr(ra, int(t))
                hi: int = mut self.expr(rb, int(t))
                ut: u8 = t
                if ir.type_signed(t) { ut = t + 4 } // the same width, unsigned
                d: int = mut self.emit2(ir.IR_SUB, t, v, lo)
                w: int = mut self.emit2(ir.IR_SUB, t, hi, lo)
                if ut != t {
                    d = mut self.emit2(ir.IR_CAST, ut, d, -1)
                    w = mut self.emit2(ir.IR_CAST, ut, w, -1)
                }
                mut self.terminate(ir.IR_BR, mut self.emit2(ir.IR_LT, ir.IT_BOOL, d, w), body.get(usize(i)), next)
            } else {
                p: int = 0
                if un { p = mut self.konst(ir.IT_I32, self.s.node_ival(pat)) } else { p = mut self.expr(pat, int(t)) }
                mut self.terminate(ir.IR_BR, mut self.emit2(ir.IR_NE, ir.IT_BOOL, v, p), next, body.get(usize(i)))
            }
            if !last {
                mut self.seal(next)
                mut self.enter(next)
            }
        }
    }
    for i: u32 in 0..n {
        c: u32 = self.kid(at, i)
        b: u32 = self.node(c).b
        bi: int = body.get(usize(i))
        mut self.seal(bi) // its tests, and the case before it if that falls through, have branched here
        mut self.enter(bi)
        if un && self.cur >= 0 && (self.node(c).flags & parser.F_DEFAULT) == 0 { mut self.union_binders(c, self.unwrap(st), addr) }
        if self.cur >= 0 { mut self.block(b) }
        bn: Node = self.node(b)
        falls: bool = i + 1 < n && bn.nkids > 0 && self.node(self.kid(b, bn.nkids - 1)).kind == Kind.fallthrough
        if falls { mut self.jump(body.get(usize(i + 1))) } else { mut self.jump(end) }
    }
    mut self.seal(end)
    mut self.enter(end)
}

Lw.for_loop(mut self, at: u32) {
    s: Node = self.node(at)
    if (s.flags & parser.F_FORGEN) == 0 {
        if s.b == 0 {
            mut self.unsupported("for head")
            return
        }
        if self.node(s.b).kind == Kind.range { mut self.range_loop(at) } else { mut self.seq_loop(at) }
        return
    }
    if s.a != 0 { mut self.stmt(s.a) }
    if self.cur < 0 { return }
    head: int = mut self.new_block()
    body: int = mut self.new_block()
    exit: int = mut self.new_block()
    post: int = head
    if s.c != 0 { post = mut self.new_block() }
    mut self.jump(head)
    mut self.enter(head)
    if s.b != 0 { mut self.cond(s.b, body, exit) } else { mut self.jump(body) }
    mut self.seal(body)
    mut self.enter(body)
    mut self.push_target(at, exit, post, -1)
    if self.cur >= 0 { mut self.block(s.d) }
    mut self.tgt.truncate(self.tgt.len - 1)
    mut self.jump(post)
    if post != head {
        mut self.seal(post)
        mut self.enter(post)
        if self.cur >= 0 { mut self.stmt(s.c) }
        mut self.jump(head)
    }
    mut self.seal(head)
    mut self.seal(exit)
    mut self.enter(exit)
}

// --- defer --------------------------------------------------------------------

/* A `defer` captures its call: each read-only argument is evaluated there into
 * a fresh variable, and a `mut` argument or receiver keeps its storage's
 * address, so the call re-lowered at every exit from its block (the block's
 * end, a return, or a break/continue past it), last defer first, reads the
 * captures and the final storage.
 */
Lw.is_literal(self, x: u32): bool {
    k: Kind = self.node(x).kind
    if k == Kind.int_lit || k == Kind.float_lit || k == Kind.str_lit || k == Kind.char_lit || k == Kind.bool || k == Kind.null { return true }
    if k != Kind.ident { return false }
    s: u32 = self.nsym(x)
    return s != 0 && self.s.sym(s).kind == sema.SymKind.var && self.s.sym(s).is_global && self.s.sym(s).is_const // never changes
}

/* Captures argument `a` of a deferred call: its storage's address when
 * by_address, else its value, in a slot when a receiver reads it by address.
 */
Lw.defer_arg(mut self, a: u32, by_address: bool, in_slot: bool) {
    inner: u32 = a
    if self.node(a).kind == Kind.mutarg { inner = self.node(a).a }
    _ = mut self.captured.unset(inner) // a defer lowered again captures afresh
    t: u32 = self.nty(inner)
    if by_address {
        p: Place = mut self.place(inner)
        addr: int = mut self.place_address(p)
        fail(mut self.captured.set(inner, Capture { var = mut self.var_new(0, ir.IT_VOID, addr), t = p.t }))
        return
    }
    if self.is_untyped(t) || self.is_literal(inner) { return } // nothing to capture
    var: int = mut self.var_make(0, t, in_slot)
    if self.home.get(usize(var)) != -1 && self.in_memory(t) {
        mut self.store_value(inner, t, mut self.var_addr(var), 0)
    } else {
        v: Agg = blank(Agg)
        mut self.value(inner, t, mut v)
        mut self.set_leaves(var, t, v)
    }
    fail(mut self.captured.set(inner, Capture { var = var, t = t }))
}

Lw.defer_capture(mut self, at: u32) {
    if self.inl.len != 0 { mut self.unsupported("defer placement") } // inline bodies hold no defer (Functions)
    call: u32 = self.node(at).a
    cn: Node = self.node(call)
    if cn.kind != Kind.call {
        mut self.unsupported("defer operand")
        return
    }
    callee: u32 = cn.a
    tgt: u32 = self.nsym(call)
    sel: bool = self.node(callee).kind == Kind.selector
    instance: bool = sel && tgt != 0 && self.s.sym(tgt).kind == sema.SymKind.func && !self.s.sym(tgt).is_extern && !self.assoc_call(call)
    via_contract: bool = sel && tgt == 0 && self.is_contract(self.nty(self.node(callee).a))
    if instance || via_contract {
        mut self.defer_arg(self.node(callee).a, (cn.flags & parser.F_MUT) != 0, true)
    } else if tgt != 0 && self.s.sym(tgt).kind == sema.SymKind.var { // the function value is captured too
        mut self.defer_arg(callee, false, false)
    }
    for i: u32 in 0..cn.nkids {
        k: u32 = self.kid(call, i)
        mut self.defer_arg(k, self.node(k).kind == Kind.mutarg, false)
    }
    fail(mut self.defers.push(Deferred { call = call, at = at }))
}

/* The pending defers above floor, last first; they stay pending for the code after. */
Lw.run_defers(mut self, floor: usize) {
    at: u32 = self.at
    i: usize = self.defers.len
    for i > floor {
        i -= 1
        d: Deferred = self.defers.get(i)
        self.at = d.at // exit-time code cites the defer's line
        _ = mut self.expr(d.call, -1)
    }
    self.at = at
}

// --- inline assembly ------------------------------------------------------------

/* The variable of the scalar local or parameter an asm binding names (sema
 * refused any other), and its type.
 */
Lw.asm_local(mut self, val: u32): (int, u8) {
    vs: u32 = 0
    if self.node(val).kind == Kind.ident { vs = self.nsym(val) }
    if vs == 0 || self.s.sym(vs).kind != sema.SymKind.var || self.s.sym(vs).is_global || self.is_agg(self.s.sym(vs).ty) {
        mut self.unsupported("asm binding")
        return 0, ir.IT_I64
    }
    t: u8 = mut self.need_type(self.s.sym(vs).ty)
    return mut self.var_of(vs), t
}

/* A binding's register number: sema accepted only the target's names. */
Lw.asm_reg(mut self, r: u32): int {
    n: int = -1
    if self.node(r).kind == Kind.ident { n = ir.asm_register(self.s.target(), self.node(r).text) }
    if n < 0 { mut self.unsupported("asm register") }
    return n
}

/* asm "instruction text" { bindings } (Inline Assembly #1-3), as sema checked
 * it: a bound local living at a home is loaded before the instruction and
 * stored after it.
 */
Lw.asm_stmt(mut self, at: u32) {
    s: Node = self.node(at)
    inreg: array.Array[int] = array.Array[int] {}
    defer mut inreg.wipe()
    invals: array.Array[int] = array.Array[int] {}
    defer mut invals.wipe()
    outreg: array.Array[int] = array.Array[int] {}
    defer mut outreg.wipe()
    outvars: array.Array[int] = array.Array[int] {}
    defer mut outvars.wipe()
    outtypes: array.Array[u8] = array.Array[u8] {}
    defer mut outtypes.wipe()
    reserved: u32 = 0
    for i: u32 in 0..s.nkids {
        b: u32 = self.kid(at, i)
        bnd: Node = self.node(b)
        is_in: bool = mem.equal(bnd.text, "in")
        is_out: bool = mem.equal(bnd.text, "out")
        if !is_in && !is_out { // clobbers: register names only
            for j: u32 in 0..bnd.nkids {
                r: int = mut self.asm_reg(self.kid(b, j))
                if r >= 0 { reserved |= u32(1) << u32(r) }
            }
            continue
        }
        j: u32 = 0
        for j + 1 < bnd.nkids {
            r: int = mut self.asm_reg(self.kid(b, j))
            if self.failed() { return }
            reserved |= u32(1) << u32(r)
            val: u32 = self.kid(b, j + 1)
            if is_in {
                v: int = -1
                if self.node(val).kind == Kind.int_lit { v = mut self.konst(ir.IT_I64, self.node(val).ival) }
                if v < 0 {
                    var: int, vt: u8 = mut self.asm_local(val)
                    if self.home.get(usize(var)) == -1 { v = mut self.read_var(var, self.cur) } else { v = mut self.load(vt, mut self.var_addr(var), 0, 0) }
                }
                fail(mut inreg.push(r))
                fail(mut invals.push(v))
            } else {
                var: int, vt: u8 = mut self.asm_local(val)
                fail(mut outreg.push(r))
                fail(mut outvars.push(var))
                fail(mut outtypes.push(vt))
            }
            j += 2
        }
    }
    if self.failed() { return }
    id: int = mut self.emit(ir.IR_ASM, ir.IT_VOID)
    for v: int in invals.view() { mut self.fn.arg_add(id, v) }
    regs: u32 = u32(self.fn.asm_regs.len)
    for r: int in inreg.view() { fail(mut self.fn.asm_regs.push(r)) }
    for r: int in outreg.view() { fail(mut self.fn.asm_regs.push(r)) }
    fail(mut self.fn.asms.push(ir.IrAsm { regs = regs, nout = u32(outreg.len), reserved = reserved }))
    x: mut *ir.IrIns = mut self.fn.at(id)
    x.asm = int(self.fn.asms.len) - 1
    x.name = s.text
    x.has_name = true
    projs: array.Array[int] = array.Array[int] {}
    defer mut projs.wipe()
    for k: usize in 0..outreg.len { // every projection directly after the asm
        pj: int = mut self.emit(ir.IR_PROJ, outtypes.get(k))
        mut self.fn.arg_add(pj, id)
        mut self.fn.at(pj).imm = u64(k)
        fail(mut projs.push(pj))
    }
    for k: usize in 0..outreg.len { mut self.set_var(outvars.get(k), projs.get(k)) }
}

Lw.stmt(mut self, at: u32) {
    if self.cur < 0 || self.failed() { return }
    if self.inl.len == 0 { self.at = at } // inlined code keeps its call site's line
    s: Node = self.node(at)
    switch s.kind {
        Kind.block { mut self.block(at) }
        Kind.var { mut self.var_decl(at) }
        Kind.assign { mut self.assign(at) }
        Kind.exprstmt { mut self.drop(s.a) }
        Kind.if {
            t: int = mut self.new_block()
            join: int = mut self.new_block()
            f: int = join
            if s.c != 0 { f = mut self.new_block() }
            mut self.cond(s.a, t, f)
            mut self.seal(t)
            mut self.enter(t)
            if self.cur >= 0 { mut self.block(s.b) }
            mut self.jump(join)
            if s.c != 0 {
                mut self.seal(f)
                mut self.enter(f)
                if self.cur >= 0 { mut self.stmt(s.c) }
                mut self.jump(join)
            }
            mut self.seal(join)
            mut self.enter(join)
        }
        Kind.for { mut self.for_loop(at) }
        Kind.label { // `continue label` restarts the block, a loop head whose back edges come from inside
            exit: int = mut self.new_block()
            head: int = mut self.new_block()
            mut self.jump(head)
            mut self.enter(head)
            mut self.push_target(at, exit, -1, head)
            mut self.block(s.a)
            mut self.tgt.truncate(self.tgt.len - 1)
            mut self.jump(exit)
            mut self.seal(head)
            mut self.seal(exit)
            mut self.enter(exit)
        }
        Kind.break {
            t: int = mut self.target(at, false)
            if t >= 0 {
                mut self.run_defers(self.tgt.get(usize(t)).ndefers)
                mut self.jump(self.tgt.get(usize(t)).brk)
            }
        }
        Kind.continue {
            t: int = mut self.target(at, true)
            if t >= 0 {
                tg: Target = self.tgt.get(usize(t))
                mut self.run_defers(tg.ndefers)
                if tg.cont >= 0 { mut self.jump(tg.cont) } else { mut self.jump(tg.restart) }
            }
        }
        Kind.return {
            if self.inl.len != 0 {
                mut self.inline_return(at)
                return
            }
            if self.self_head >= 0 && self.defers.len == 0 && self.is_self_call(s.a) { // release: a branch back to the head
                g: Args = Args.init()
                defer mut g.wipe()
                if mut self.call_args(s.a, self.nsym(s.a), mut g) >= 0 || g.v.len != self.fn.params.len { mut self.unsupported("self call") }
                fnode: Node = self.node(self.f)
                k: usize = 0
                for i: u32 in 0..fnode.nkids { // each parameter's leaves, in order
                    if self.failed() { break }
                    ps: u32 = self.nsym(self.kid(self.f, i))
                    var: int = mut self.var_of(ps)
                    if self.home.get(usize(var)) <= ADDR_VAR {
                        mut self.write_var(ADDR_VAR - self.home.get(usize(var)), self.cur, g.v.get(k))
                        k += 1
                        continue
                    }
                    pt: u32 = self.s.sym(ps).ty
                    n: int = 1
                    if self.is_agg(pt) { n = mut self.leaf_count(pt) }
                    for j: int in 0..n {
                        mut self.write_var(var + j, self.cur, g.v.get(k))
                        k += 1
                    }
                }
                mut self.jump(self.self_head)
                return
            }
            none: Agg = blank(Agg)
            if s.a == 0 {
                mut self.ret(none)
                return
            }
            if self.rtype == 0 || self.kind(self.rtype) == TypeKind.void { // `return f()` of a call with no value
                mut self.drop(s.a)
                mut self.ret(none)
                return
            }
            if self.result >= 0 { // into the caller's memory
                mut self.store_value(s.a, self.rtype, self.result, 0)
                mut self.ret(none)
                return
            }
            a: Agg = blank(Agg)
            mut self.value(s.a, self.rtype, mut a)
            mut self.ret(a)
        }
        Kind.switch { mut self.switch_stmt(at) }
        Kind.fallthrough {}
        Kind.defer { mut self.defer_capture(at) }
        Kind.asm { mut self.asm_stmt(at) }
        default { mut self.unsupported("statement form") }
    }
}

// --- functions --------------------------------------------------------------

Lw.by_address(self, f: u32, i: u32): bool {
    return (self.node(self.kid(f, i)).flags & parser.F_MUT) != 0 || ((self.node(f).flags & parser.F_METHOD) != 0 && i == 0)
}

/* Drops removed phis and pred-less blocks, resolves replaced values, and
 * numbers the remaining blocks densely.
 */
Lw.finish(mut self) {
    changed: bool = true
    for changed { // phis made trivial by later replacements
        changed = false
        for v: int in 0..int(self.fn.ins.len) {
            p: ir.IrIns = self.fn.at(v)
            if p.op != ir.IR_PHI || p.block < 0 { continue }
            for i: u32 in 0..p.nargs { mut self.fn.set_arg(v, i, mut self.find(self.fn.arg(v, i))) }
            before: int = self.fn.at(v).block
            _ = mut self.try_remove_trivial(v)
            if self.fn.at(v).block != before { changed = true }
        }
    }
    for v: int in 0..int(self.fn.ins.len) {
        for i: u32 in 0..self.fn.at(v).nargs { mut self.fn.set_arg(v, i, mut self.find(self.fn.arg(v, i))) }
    }
    nb: usize = self.fn.blocks.len
    bmap: array.Array[int] = array.Array[int] {}
    defer mut bmap.wipe()
    n: int = 0
    for b: usize in 0..nb {
        bb: ir.IrBlock = self.fn.blocks.get(b)
        if b == 0 || bb.preds.len > 0 || bb.ins.len > 0 {
            fail(mut bmap.push(n))
            n += 1
        } else {
            fail(mut bmap.push(-1))
        }
    }
    for b: usize in 0..nb {
        bb: ir.IrBlock = self.fn.blocks.get(b)
        if bmap.get(b) < 0 {
            mut bb.ins.wipe()
            mut bb.preds.wipe()
            continue
        }
        list: mut []int = mut bb.ins.view()
        k: usize = 0
        for i: usize in 0..list.len {
            if self.fn.at(list[i]).block >= 0 {
                list[k] = list[i]
                k += 1
            }
        }
        mut bb.ins.truncate(k)
        preds: mut []int = mut bb.preds.view()
        for i: usize in 0..preds.len { preds[i] = bmap.get(usize(preds[i])) }
        if bb.succ0 >= 0 { bb.succ0 = bmap.get(usize(bb.succ0)) }
        if bb.succ1 >= 0 { bb.succ1 = bmap.get(usize(bb.succ1)) }
        for id: int in bb.ins.view() { mut self.fn.at(id).block = bmap.get(b) }
        mut self.fn.blocks.set(usize(bmap.get(b)), bb)
    }
    mut self.fn.blocks.truncate(usize(n))
}

/* Lowers checked function `f`: the IR, or a reason it was not lowered and
 * whether that reason is only selfhost's (a construct not yet ported).
 */
pub lower(mut s: sema.Sema, f: u32, debug: bool, targs: u32, nt: u32, ft: u32): (Func, string, bool) {
    fs: u32 = s.node_sym(f)
    fnode: Node = s.node(f)
    rt: u32 = 0
    if fs != 0 && s.sym(fs).ty != 0 { rt = s.ty(s.sym(fs).ty).ret }
    if fnode.b == 0 && fnode.ival == 0 && (fnode.flags & parser.F_INTRINSIC) == 0 { return Func.new(f, fs), "no body", false }
    if fnode.c != 0 && !(fs != 0 && s.sym(fs).spec_args != 0) {
        if nt == 0 || s.node(fnode.c).nkids != nt { return Func.new(f, fs), "generic", false }
        mut s.stamp_body(f, targs, nt) // as an inlined generic call does
        rt = s.ty(ft).ret
    }
    body: u32 = fnode.b
    if body == 0 { body = mut s.intrinsic_body(f, rt) }
    l: Lw = Lw { s = mut &s, fn = Func.new(f, fs), f = f, debug = debug, var_ix = map.Map[u32, int] {}, stored = map.Map[u32, bool] {}, vtype = array.Array[u8] {}, home = array.Array[int] {}, defs = map.Map[u64, int] {}, inc = array.Array[Incomplete] {}, inc_head = array.Array[int] {}, repl = array.Array[int] {}, tgt = array.Array[Target] {}, defers = array.Array[Deferred] {}, captured = map.Map[u32, Capture] {}, inl = array.Array[Expansion] {}, escapes = map.Map[u32, u64] {}, gesc = array.Array[GenEscape] {} }
    defer mut l.wipe()
    l.is_main = (fnode.flags & (parser.F_METHOD | parser.F_ASSOC)) == 0 && mem.equal(fnode.text, "main")
    if rt != 0 && l.kind(rt) == TypeKind.void { rt = 0 }
    l.rtype = rt
    l.cur = mut l.new_block()
    mut l.seal(l.cur)
    l.at = f
    if l.is_big(rt) { // stored through the address the caller passes
        mut l.covered(rt)
        l.fn.ret_mem = rt
        l.result = mut l.emit(ir.IR_RESULT, ir.IT_PTR)
    }
    lv: ir.Leaves = blank(ir.Leaves)
    if rt != 0 && l.fn.ret_mem == 0 {
        nr: int = mut l.leaves(rt, mut lv)
        for k: int in 0..nr { fail(mut l.fn.rets.push(lv.v[k].ty)) }
    }
    g: Args = Args.init() // the parameters' leaves, as a call's arguments group
    defer mut g.wipe()
    for i: u32 in 0..fnode.nkids { // in this frame's memory
        ps: u32 = s.node_sym(s.kid(f, i))
        if ps != 0 && !l.by_address(f, i) && l.in_memory(s.sym(ps).ty) { fail(mut l.stored.set(ps, true)) }
    }
    // an auto-inline call expands unless a self tail loop turns auto-inlining off
    inl_calls: bool = (fnode.flags & parser.F_EXPO) != 0 || l.has_inline_call(fnode.b)
    l.scan_auto = !debug && (l.is_main || inl_calls || !l.has_self_tail(fnode.b))
    mut l.scan_walk(fnode.b)
    for i: u32 in 0..fnode.nkids {
        p: u32 = s.kid(f, i)
        ps: u32 = s.node_sym(p)
        if ps == 0 {
            mut l.unsupported("unresolved parameter")
            break
        }
        pt: u32 = s.sym(ps).ty
        if l.by_address(f, i) || l.param_by_address(pt) { // at the caller's address (or copy), held in an SSA variable
            if !l.by_address(f, i) { mut l.covered(pt) }
            v: int = mut l.emit(ir.IR_PARAM, ir.IT_PTR)
            mut l.fn.at(v).imm = u64(g.v.len)
            if l.by_address(f, i) {
                mut g.scalar(v)
            } else { // an aggregate passed by value
                fail(mut g.parts.push(ir.IrPart { agg = pt, first = int(g.v.len), n = 1, addr = true }))
                fail(mut g.v.push(v))
                g.agg = true
            }
            a: int = mut l.var_new(0, ir.IT_PTR, -1)
            mut l.set_var(a, v)
            _ = mut l.var_new(ps, ir.IT_VOID, ADDR_VAR - a)
            continue
        }
        a: Agg = blank(Agg)
        a.n = mut l.leaves(pt, mut lv)
        if l.is_agg(pt) {
            fail(mut g.parts.push(ir.IrPart { agg = pt, first = int(g.v.len), n = a.n }))
            g.agg = true
        }
        for k: int in 0..a.n {
            a.v[k] = mut l.emit(ir.IR_PARAM, lv.v[k].ty)
            mut l.fn.at(a.v[k]).imm = u64(g.v.len)
            if l.is_agg(pt) { fail(mut g.v.push(a.v[k])) } else { mut g.scalar(a.v[k]) }
        }
        mut l.set_leaves(mut l.var_of(ps), pt, a)
    }
    for v: int in g.v.view() { fail(mut l.fn.params.push(l.fn.at(v).ty)) }
    if g.agg || (l.is_agg(rt) && l.fn.ret_mem == 0) {
        ret: ir.IrPart = ir.IrPart { n = int(l.fn.rets.len) }
        if l.is_agg(rt) && l.fn.ret_mem == 0 { ret.agg = rt }
        l.fn.sig = mut l.fn.new_sig(g.parts.view(), ret)
    }
    if !debug && !l.is_main && !inl_calls && !l.frame_storage() && l.has_self_tail(fnode.b) {
        l.self_head = mut l.new_block()
        mut l.jump(l.self_head)
        l.cur = l.self_head
    }
    if fnode.b == 0 { mut l.stmt(body) } else { mut l.block(body) }
    if l.cur >= 0 && !l.failed() { // falling off the end: zero
        z: Agg = blank(Agg)
        z.n = int(l.fn.rets.len)
        for k: int in 0..z.n { z.v[k] = mut l.konst(l.fn.rets.get(usize(k)), 0) }
        mut l.ret(z)
    }
    if l.self_head >= 0 { mut l.seal(l.self_head) }
    if l.failed() { return l.fn, l.why, l.gap }
    mut l.finish()
    if !debug { optimizer.optimize(mut l.fn) }
    return l.fn, "", false
}

/* --ir: prints the IR of every function in the root file, or why it was not
 * lowered; false when one fails verification.
 */
pub dump_file(mut out: Out, mut s: sema.Sema, debug: bool): bool {
    file: Node = s.node(s.file)
    for i: u32 in 0..file.nkids {
        f: u32 = s.kid(s.file, i)
        n: Node = s.node(f)
        if n.kind != Kind.func || s.in_imported(f) { continue }
        fn: Func, why: string, unported: bool = lower(mut s, f, debug, 0, 0, 0)
        defer mut fn.wipe()
        if why.len > 0 {
            mut out.printf("; ")
            if n.d != 0 { mut out.printf("%s.", s.node(n.d).text) }
            if unported {
                mut out.printf("%s: not lowered (selfhost does not yet support %s)\n\n", n.text, why)
            } else {
                mut out.printf("%s: not lowered (%s)\n\n", n.text, why)
            }
            continue
        }
        if !ir.verify(s, fn) {
            mut out.flush()
            return false
        }
        ir.print(mut out, s, fn)
        mut out.printf("\n")
    }
    return true
}
